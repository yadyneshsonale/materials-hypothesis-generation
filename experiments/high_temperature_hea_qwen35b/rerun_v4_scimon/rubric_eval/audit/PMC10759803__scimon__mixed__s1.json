        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reported deformation conditions include ambient temperature and 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tensile deformation was examined up to 14% strain.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent interfaces of the nanoprecipitates are the structural mediator.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitate interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitates relieve stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stress-concentration relief and dislocation transmission help prevent premature cracking and preserve ductility while precipitates provide strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470",
        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
      "text": "A homogeneous intragranular distribution of precipitates helps avoid intergranular embrittlement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::003::9cea05c012"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCPs treatment improves strength and ductility concurrently without one property being compromised.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470",
        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
