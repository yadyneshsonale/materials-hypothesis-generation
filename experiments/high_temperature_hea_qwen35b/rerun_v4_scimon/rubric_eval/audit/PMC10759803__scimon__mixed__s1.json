        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant processing is stepwise thermo-mechanical processing.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470",
