      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The applicability of the hypothesis is bounded by the ambient-to-800 °C temperature range.",
      "field": "boundary",
