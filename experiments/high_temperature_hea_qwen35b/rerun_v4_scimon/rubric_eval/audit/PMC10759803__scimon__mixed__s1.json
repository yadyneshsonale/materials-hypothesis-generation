        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The material begins in an as-cast high-entropy-alloy state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::006::814cf2d31c"
      ],
      "same_system": "yes"
    },
    {
