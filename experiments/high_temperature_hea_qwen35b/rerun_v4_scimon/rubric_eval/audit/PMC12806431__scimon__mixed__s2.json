      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy has high ductility and strength.",
