        "PMC6197204::rubric_mechanisms::005::5b7cb736ff"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ferromagnetic regions are Fe-Co rich and the antiferromagnetic regions are Cr rich.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_mechanisms::005::5b7cb736ff"
      ],
      "same_system": "yes"
    },
