  "claims": [
    {
      "text": "High-entropy alloys can be used to produce a ductile–brittle–ductile transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-entropy alloys exhibit high strength, high hardness, and softening resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "yes"
    },
    {
      "text": "High strength, high hardness, and softening resistance are the reasons HEAs can undergo or enable a ductile–brittle–ductile transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed starting material is a eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The eutectic high-entropy alloy is subjected to high-pressure and high-temperature treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment uses extreme pressures and temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment forms a hierarchically patterned microstructure with coherent interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HPHT-induced microstructure promotes deformation by dislocations, stacking faults, microbands, and deformation twins.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "These deformation mechanisms operate at multiple length scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment improves the strength of the eutectic high-entropy alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment improves the ductility of the eutectic high-entropy alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment overcomes the conventional strength–ductility trade-off.",
