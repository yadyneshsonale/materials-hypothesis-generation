      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical testing is performed by uniaxial compression at room temperature and 600 °C using an initial strain rate of 0.001 s⁻¹.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
