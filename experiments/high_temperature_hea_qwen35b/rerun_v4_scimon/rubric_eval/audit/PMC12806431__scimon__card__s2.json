      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous disordered BCC matrix permits sufficient dislocation mobility to produce significant ductility.",
