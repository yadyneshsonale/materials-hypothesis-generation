      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-pressure and high-temperature treatment improves both strength and tensile ductility in the eutectic high-entropy alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment overcomes the conventional strength–ductility trade-off.",
