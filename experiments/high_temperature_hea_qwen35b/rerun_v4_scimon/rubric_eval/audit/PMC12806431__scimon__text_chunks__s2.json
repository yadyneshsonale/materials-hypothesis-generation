      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "yes"
    },
    {
      "text": "High strength, high hardness, and softening resistance enable a ductile–brittle–ductile transition in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting material is a eutectic high-entropy alloy.",
