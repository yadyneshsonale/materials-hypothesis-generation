      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial eutectic high-entropy alloy has a hierarchical microstructure consisting of dual-phase lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The eutectic high-entropy alloy is subjected to high-pressure and high-temperature treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment uses extreme pressure and temperature conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-pressure and high-temperature treatment forms a hierarchically patterned microstructure with coherent interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment-induced microstructure promotes dislocations, stacking faults, microbands, and deformation twins.",
