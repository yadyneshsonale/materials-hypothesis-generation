  "claims": [
    {
      "text": "The quinary W-Ta-Cr-V-Hf RHEA can be used for lattice heat conductivity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The suitability of W-Ta-Cr-V-Hf for lattice heat conductivity is due to its high thermal stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The suitability of W-Ta-Cr-V-Hf for lattice heat conductivity is due to its superior resistance to radiation damage.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thin film has composition W29.4Ta42Cr5.0V16.1Hf7.5.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The thick film has composition W31Ta34Cr5.0V27Hf3.0.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy films were deposited by magnetron sputtering from 99.99% pure metal targets at room temperature and 3 mTorr without bias voltage.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The material was annealed in situ in TEM at 1173 K for 30 minutes.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The material underwent 16 keV single-beam He implantation up to approximately 9% He.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The material underwent dual-beam irradiation with 1 MeV Kr+ and 16 keV He+ to 8.5 dpa and approximately 9% He at 1173 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain size is a structural mediator of the claimed performance.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary segregation of Hf is a structural mediator of the claimed performance.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dual-beam irradiation refines the grains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain refinement under dual-beam irradiation results from high-energy recoil cascades dividing grains into sub-cascades near the initial grain size.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Irradiation produces no precipitation and homogenizes the alloying elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ballistic mixing explains the absence of precipitation and elemental homogenization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy's order-disorder transition temperature is close to the irradiation temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Proximity of the order-disorder transition temperature to the irradiation temperature causes short-range-order parameters to approach zero.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quinary alloy has high thermal stability and superior radiation-damage resistance relative to existing quaternary W-based alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
