  "claims": [
    {
      "text": "Cryo-rolling followed by annealing can improve the strength–ductility balance of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 eutectic high-entropy alloy is an applicable alloy system for this treatment.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention consists of cryo-rolling followed by annealing.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy can be subjected to multi-pass cryo-rolling to approximately 90% thickness reduction.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The material is immersed in liquid nitrogen for 45 minutes before and after each rolling pass.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolling is followed by annealing at 800 °C for 1 hour and water quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment produces a hierarchical microstructure containing fine lamellar and coarse non-lamellar regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The fine lamellar regions contain ultrafine FCC grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coarse non-lamellar regions contain coarse unrecrystallized B2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cryo-rolling and annealing cause formation of the proposed hierarchical microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Orowan bowing contributes to the enhanced strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Back-stress hardening contributes to the enhanced strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment improves yield strength and ultimate tensile strength while maintaining or improving elongation to failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast alloy is the baseline for evaluating the treatment.",
