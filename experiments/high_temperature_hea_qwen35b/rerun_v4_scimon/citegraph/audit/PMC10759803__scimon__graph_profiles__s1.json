{
  "run_id": "PMC10759803__scimon__graph_profiles__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Cryo-rolling followed by annealing can concurrently improve strength and ductility in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 is a eutectic high-entropy alloy to which the proposed method applies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processing route uses multi-pass cryo-rolling to approximately 90% thickness reduction.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy is immersed in liquid nitrogen for 45 minutes before and after each rolling pass.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolling is followed by annealing at 800 °C for 1 hour and water quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolling and annealing produce a hierarchical microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hierarchical microstructure contains fine lamellar regions with ultrafine FCC grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hierarchical microstructure contains coarse non-lamellar regions with coarse unrecrystallized B2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hierarchical microstructure enhances strength through Orowan bowing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hierarchical microstructure enhances the strength–ductility combination through back-stress hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment improves yield strength relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment improves ultimate tensile strength relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment maintains or improves elongation to failure relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The effectiveness of cryo-rolling and annealing depends on alloy composition and processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanisms responsible for the strength–ductility improvement are not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
