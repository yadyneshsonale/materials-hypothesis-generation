  "claims": [
    {
      "text": "High-entropy alloys with a dendritic microstructure can be used to achieve concurrent strength and ductility improvement.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy composition is Al10Co25Cr8Fe15Ni36Ti6.",
