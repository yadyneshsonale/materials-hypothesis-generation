      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast Al10Co25Cr8Fe15Ni36Ti6 alloy has a dendritic microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Homogenization at 1220 °C for 20 h dissolves the dendrites.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Homogenization is followed by annealing at 900 °C for 50 h.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The heat-treatment sequence produces a three-phase microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The heat-treated alloy contains a face-centered-cubic matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The heat-treated alloy contains cuboidal L1_2-ordered precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The heat-treated alloy contains a Heusler-type phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::003::results_and_discussion::745175bfb4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The stated heat treatment improves strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stated heat treatment improves ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional casting and heat treatment provide the relevant baseline.",
