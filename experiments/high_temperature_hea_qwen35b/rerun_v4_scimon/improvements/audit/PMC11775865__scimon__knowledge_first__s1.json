  "claims": [
    {
      "text": "Molecular dynamics simulations can investigate the thermal behavior of AuCoCuNiPt nanoparticles at the atomic scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Molecular dynamics simulations can reveal thermodynamic contributions to the structural properties of AuCoCuNiPt nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is a nearly equiatomic, five-element AuCoCuNiPt nanoalloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::001::introduction::889f2a282a"
      ],
      "same_system": "no"
    },
    {
      "text": "The nanoparticles will be heated to high temperatures.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A vacuum or inert atmosphere prevents oxidation during heating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic arrangement and lattice structure mediate the thermal response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::001::introduction::889f2a282a",
        "PMC11355469::chunk::001::introduction::201bec5221"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating causes thermally activated diffusion and rearrangement of atoms in the nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::001::introduction::889f2a282a",
        "PMC11355469::chunk::001::introduction::201bec5221"
      ],
      "same_system": "no"
    },
    {
      "text": "AuCoCuNiPt nanoparticles will exhibit enhanced thermal stability because of the high-entropy effect.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::001::introduction::889f2a282a",
        "PMC11355469::chunk::001::introduction::201bec5221"
      ],
      "same_system": "no"
    },
    {
      "text": "Pure-metal nanoparticles provide the baseline for comparison.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed investigation covers temperatures from 300 to 1000 K.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The accuracy of molecular dynamics results depends on the chosen interatomic potential.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The complexity of the nanoalloy system may introduce uncertainty into molecular dynamics results.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mean squared displacement, radial distribution functions, and pair correlation functions can be used to evaluate thermal behavior.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy effect can be compared in simulations by modeling cases with and without that effect.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Finding no significant thermal-behavior difference between the nanoalloy and pure-metal nanoparticles would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
