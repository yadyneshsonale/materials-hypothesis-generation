  "claims": [
    {
      "text": "Compositionally complex or high-entropy alloys can be designed to exhibit a ductile–brittle–ductile transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing routes and alloying additions can control phase composition, microstructure, and mechanical properties in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a",
