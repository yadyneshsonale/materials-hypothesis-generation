      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial material is as-cast AlCoCrFeNi high-entropy alloy.",
