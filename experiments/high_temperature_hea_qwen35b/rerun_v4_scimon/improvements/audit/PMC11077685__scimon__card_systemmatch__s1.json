      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant baseline is as-cast AlCoCrFeNi without stationary friction processing.",
