      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mean squared displacement, radial distribution function, and energy fluctuations can be used to assess thermal behavior.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
