      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial medium-entropy alloy has a disordered FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processing intervention consists of cold rolling followed by heat treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Heat treatments are performed at 800, 850, and 900 °C for 1 hour.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processing produces semicoherent nanoprecipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Micro-shear bands promote precipitate dispersion by acting as heterogeneous nucleation sites for L21 precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intragranular L21 precipitates strengthen the alloy through Orowan bowing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention enhances both strength and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional processing has limited process windows.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Limited conventional process windows restrict grain refinement to grain sizes below approximately 2 μm.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8338972::card::0"
      ],
      "same_system": "yes"
