{
  "run_id": "PMC10759803__scimon__graph_profiles__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Cryo-rolling followed by annealing can provide concurrent strength–ductility improvement in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 is a eutectic high-entropy alloy to which the proposed method can be applied.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processing involves multi-pass cryo-rolling to approximately 90% thickness reduction.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The material is immersed in liquid nitrogen for 45 minutes before and after each rolling pass.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolling is followed by annealing at 800 °C for 1 hour and water quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolling and annealing produce a hierarchical or heterogeneous microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hierarchical microstructure contains fine lamellar regions with ultrafine FCC grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hierarchical microstructure contains coarse non-lamellar regions with coarse unrecrystallized B2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hierarchical microstructure enhances both strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2788103315",
        "node::W3015396998"
      ],
      "same_system": "yes"
    },
    {
      "text": "Orowan bowing contributes to the strength–ductility improvement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Back-stress hardening contributes to the strength–ductility improvement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment improves yield strength and ultimate tensile strength relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment maintains or improves elongation to failure relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2788103315"
      ],
      "same_system": "yes"
    },
    {
      "text": "The effectiveness of the treatment depends on alloy composition and processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanisms responsible for the strength–ductility improvement are not fully understood.",
      "field": "uncertainty",
