  "claims": [
    {
      "text": "AlCoCrFeNi2.1 exhibits a ductile-brittle-ductile transition when aged in the 550-750°C regime.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transition is driven by coupled evolution of L12 ordered domains and jagged B2/FCC phase boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging near 600°C produces excessive L12 ordering with local compositions near the stoichiometric Ni3Al ratio.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The APBE near 600°C is approximately 112 mJ/m².",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging near 600°C creates highly serrated B2/FCC interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing L12 chemical order increases APBE.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High APBE restricts cross-slip and promotes planar slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2936950287"
      ],
      "same_system": "no"
    },
    {
      "text": "Jagged phase-boundary serrations act as stress concentrators.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combination of planar slip and stress concentration at boundary serrations causes brittle fracture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging near 750°C reduces the degree of L12 order and lowers APBE.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging near 750°C forms ductile transition zones along phase boundaries, restoring ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical APBE threshold for planar-slip localization is approximately 100 mJ/m².",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittleness occurs when the L12 long-range order parameter S exceeds 0.8.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical transition occurs at an aging temperature of approximately 650°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial AlCoCrFeNi2.1 material has a nanolamellar microstructure containing ordered FCC L12 and ordered BCC B2 phases.",
      "field": "material_initial_state",
      "needs_support": true,
