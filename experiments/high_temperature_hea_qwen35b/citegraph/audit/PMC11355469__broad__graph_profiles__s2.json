{
  "run_id": "PMC11355469__broad__graph_profiles__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "HEA coating tribological performance improves as ambient temperature rises from 300 °C to approximately 400–450 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tribological performance degrades rapidly above approximately 450 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal activation between 300 and 450 °C enhances strain hardening of the ductile FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate temperatures promote formation of a continuous, adherent oxide tribofilm on the wear track.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribofilm reduces coefficient of friction and wear rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the critical temperature, the FCC phase undergoes dynamic recrystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2003802755"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dynamic recrystallization causes significant softening and a drop in yield strength above approximately 450 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, the oxide tribofilm may become unstable or spall.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Matrix softening and tribofilm failure produce a transition from mild wear to severe adhesive or oxidative wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FCC phase of CoCrFeNiMn HEA is readily deformed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2003802755"
      ],
      "same_system": "yes"
    },
    {
      "text": "An Al0.6TiCrFeCoNi coating has been deposited on ASTM A572 steel using HVOF thermal spraying.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2901734661"
      ],
      "same_system": "yes"
    },
    {
      "text": "The wear performance of HVOF-sprayed Al0.6TiCrFeCoNi on ASTM A572 steel has been evaluated from 300 to 500 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2901734661"
      ],
      "same_system": "yes"
    },
    {
      "text": "Atmospheric plasma spraying has been used to deposit AlCoCrFeNiTi on a 316 stainless-steel substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2532702076"
      ],
      "same_system": "yes"
    },
    {
      "text": "The example CoCrFeNiMo0.2 and Al0.6TiCrFeCoNi coatings possess mixed BCC and FCC microstructures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The example coatings may contain amorphous regions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In laser-cladded CoCrBFeNiSi, an amorphous layer has a lower wear rate than a crystalline layer.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2756342892"
      ],
      "same_system": "yes"
    },
    {
      "text": "Room-temperature wear typically has higher friction and wear rates than moderate-temperature wear because thermal strain hardening and oxide-film formation are absent.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical degradation temperature depends strongly on alloy composition and initial amorphous or crystalline microstructure.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2756342892"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Refractory additions such as W, Mo, or Nb can shift the critical degradation boundary.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating is to be tested under dry sliding in air from 300 to 600 °C while normal load and sliding velocity are held constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
