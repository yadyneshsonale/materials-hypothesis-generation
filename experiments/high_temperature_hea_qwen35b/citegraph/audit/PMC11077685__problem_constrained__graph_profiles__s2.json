      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2966768969"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled hydride decomposition in vacuum removes hydrogen without introducing oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preventing oxygen exposure suppresses brittle oxide layers and subsequent nucleation of alpha-HCP phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alpha-HCP precipitation raises the ductile-to-brittle transition temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum minimizes the thermodynamic driving force for oxygen uptake.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
