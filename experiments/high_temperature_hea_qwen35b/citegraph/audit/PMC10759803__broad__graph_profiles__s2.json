      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2321217820",
        "node::W2992155721"
      ],
      "same_system": "no"
    },
    {
      "text": "Back stress generated by the heterogeneous grain structure delays necking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse-grained regions of Hf-Mo-Ta-Ti-Zr will undergo deformation-induced twinning at room temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation-induced twinning will increase strain-hardening capacity and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultrafine-grained regions will raise yield strength through Hall-Petch strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Randomly distributed principal elements produce lattice distortion that contributes to strengthening.",
