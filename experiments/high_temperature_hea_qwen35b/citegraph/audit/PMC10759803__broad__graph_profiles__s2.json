      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic Hf-Mo-Ta-Ti-Zr forms a single-phase BCC solid solution in the as-cast or homogenized state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
