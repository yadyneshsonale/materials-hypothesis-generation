  "claims": [
    {
      "text": "AlxCoCrFeNi alloys with 1 ≤ x ≤ 2 are multiphase high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2898265080"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlxCoCrFeNi alloys with 1 ≤ x ≤ 2 undergo a ductile-brittle-ductile transition during aging at 700–1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sigma phase can form in AlxCoCrFeNi after hundreds of hours of aging at 700–1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::W2506186650"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy has a fine lamellar FCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2103109670"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2 phase is strongly ordered at room temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2898265080"
      ],
      "same_system": "yes"
    },
    {
      "text": "The unaged alloy contains short-range order around Al atoms.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unaged alloy is metastable before aging.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2506186650"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging produces nucleation, growth, and subsequent coarsening or dissolution of sigma phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2506186650"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sigma phase forms preferentially at FCC/B2 interfaces and within the B2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine sigma precipitates act as brittle intermetallic networks that pin dislocations and promote crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sigma-phase coarsening reduces brittle interfacial area and associated stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial B2 disordering lowers antiphase-boundary energy and makes dislocation bypass easier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relaxation of local chemical order restores dislocation mobility and contributes to ductility recovery.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2936950287"
      ],
      "same_system": "no"
    },
    {
      "text": "Elongation will fall from approximately 25% in the as-cast state to below 5% after 50–100 hours at 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elongation will recover to above 15% after 200–300 hours at 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Peak brittleness will coincide with the maximum volume fraction of fine sigma precipitates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "For x > 2, greater B2 stability suppresses or delays sigma formation and produces monotonic behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "For x < 1, the alloy may remain single-phase FCC and therefore lack the multiphase evolution needed for the transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below 700 °C the transformation kinetics are too slow, whereas above 1000 °C sigma dissolves too rapidly for the transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2506186650"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis can be falsified by finding either that ductility fails to recover after sigma coarsening or dissolution, or that sigma does not form under the predicted aging conditions.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
