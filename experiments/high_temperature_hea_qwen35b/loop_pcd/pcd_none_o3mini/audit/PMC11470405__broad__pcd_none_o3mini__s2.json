      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 800–1000 °C, the Y-modified alloy will exhibit a lower rate of elastic-modulus softening with temperature than the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
