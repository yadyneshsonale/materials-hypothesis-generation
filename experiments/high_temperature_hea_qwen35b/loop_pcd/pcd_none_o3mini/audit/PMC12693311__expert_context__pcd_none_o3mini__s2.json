      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Pd-substituted alloy will retain a higher amorphous-phase fraction after quenching than Cr16Mn16Fe16Co16Ni16P20.",
