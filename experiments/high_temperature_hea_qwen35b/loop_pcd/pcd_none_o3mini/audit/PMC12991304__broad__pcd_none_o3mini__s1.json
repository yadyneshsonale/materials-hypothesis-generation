      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased oxygen-vacancy concentration enhances metal-support interactions with Pt.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced metal-support interactions stabilize ultra-dispersed Pt nanoparticles.",
