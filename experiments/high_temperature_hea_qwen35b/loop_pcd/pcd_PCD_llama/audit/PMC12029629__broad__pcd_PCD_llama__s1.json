        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nanopillars have well-defined geometries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nanopillars are tested in tension in situ in a transmission electron microscope.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The tensile behavior occurs at room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-resolution microscopy is used to characterize the deformation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Deformation twinning and dislocation slip are both active during tensile deformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Deformation twinning and dislocation slip are spatially and synergistically coordinated.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coordinated twinning and slip promote deformation delocalization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coordinated twinning and slip delay necking failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "This mechanism produces ultrahigh uniform tensile ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Uniform tensile elongation can reach approximately 110%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The approximately 110% elongation is sustained at a flow stress of 0.6–1.0 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional metallic materials provide a baseline of limited tensile ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
