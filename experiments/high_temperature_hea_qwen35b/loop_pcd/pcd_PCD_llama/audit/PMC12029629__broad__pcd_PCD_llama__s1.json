  "claims": [
    {
      "text": "The tested material consists of single-crystalline, <110>-oriented CoCrFeNi high-entropy-alloy nanopillars.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
