  "claims": [
    {
      "text": "The unchanged (MnNiSi)0.62(FeCoGe)0.38 alloy exhibits caloric phase transformations under applied magnetic fields and pressure.",
      "field": "material_initial_state, baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has poor load-bearing integrity and is prone to cracking.",
      "field": "material_initial_state, baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is substitutional addition of 1–2 at.% Nb.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting, homogenization at approximately 1200°C for 1 hour, and aging at approximately 600°C for 4 hours will promote controlled Nb-rich precipitation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at.% Nb under the proposed processing conditions will form nanoscale coherent Nb-rich precipitates.",
      "field": "hypothesis, structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-rich precipitates will occur both within grains and at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-rich precipitates will impede crack initiation through dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-rich precipitates will impede crack propagation through crack deflection.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb intervention will improve fracture toughness relative to the unchanged alloy.",
      "field": "hypothesis, predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb intervention will improve resistance to cracking relative to the unchanged alloy.",
      "field": "hypothesis, predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will not significantly interfere with the martensitic phase transition responsible for the caloric response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will preserve caloric performance relative to the unchanged alloy.",
      "field": "hypothesis, predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed operating temperature window is approximately 250–350 K.",
      "field": "predicted_outcome, boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed magnetic-field boundary is up to several tesla.",
