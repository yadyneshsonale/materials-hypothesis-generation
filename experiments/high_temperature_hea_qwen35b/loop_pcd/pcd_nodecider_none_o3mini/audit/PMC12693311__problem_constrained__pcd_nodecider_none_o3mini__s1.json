      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing heterogeneous nucleation sites will suppress extensive primary crystallization during subsequent thermal processing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed route requires quenching rates exceeding 10^6 K/s.",
