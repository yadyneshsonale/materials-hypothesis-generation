      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultra-rapidly quenched state is prone to extensive primary crystallization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A brief isothermal hold just above Tg after ultra-rapid quenching will enhance structural relaxation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced structural relaxation will reduce the density of heterogeneous nucleation sites.",
