    {
      "text": "Pulsed laser nitriding forms fine TiN particles or a continuous TiN-rich layer in the melted surface region of TC4.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid laser melting in nitrogen promotes nitrogen dissolution into the TC4 surface.",
