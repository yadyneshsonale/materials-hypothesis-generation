      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The isolated Pt and Pd sites are uniformly and homogeneously distributed throughout the HEA nanoparticles.",
