      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract",
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
      "text": "Restricted precursor mobility favors kinetically trapped, single-phase HEA nanoparticle formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract",
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
