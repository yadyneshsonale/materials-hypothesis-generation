      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The colloidal synthesis is conducted under an inert atmosphere.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low synthesis temperatures reduce precursor or atomic mobility in the PtPdCoCuNi colloidal system.",
