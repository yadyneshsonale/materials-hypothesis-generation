      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
      "text": "Restricted mobility limits clustering and premature elemental segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract",
