  "claims": [
    {
      "text": "Unmodified TC4 has an α + β dual-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TC4 has established toughness and corrosion resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TC4 has limited hardness and high wear under extreme-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "(MoWNbTaV)0.2S2 nanoflakes can be applied as a thin film using spray coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main",
        "PMC12019924::web::004::characteristics_of_2d_hea"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed coating on TC4 will be less than 2 µm thick.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored low-temperature anneal can produce excellent coating adhesion without altering the bulk TC4 microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The complete coating and annealing process occurs at ambient temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will form a conformal, densely packed, dual-phase nanolayer on TC4.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HEA nanoflakes increase surface hardness through solid-solution reinforcement and impediment of dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "(MoWNbTaV)0.2S2 nanoflakes facilitate shear-induced energy dissipation and low-shear sliding behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::022::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under high contact pressure, the HEA nanoflakes exhibit tribocatalytic activity that contributes to formation of a lubricious tribolayer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main",
        "PMC12019924::web::022::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lubricious tribolayer and retained nanoflakes reduce friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main",
        "PMC12019924::web::022::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will increase TC4 surface hardness by 20–30% relative to untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will significantly reduce TC4's coefficient of friction and wear rate under high-contact-stress conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main",
        "PMC12019924::web::022::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will preserve TC4's bulk α + β microstructure, toughness, and corrosion resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable near 0.9–1.0 GPa contact pressure under ambient test conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12019924::web::000::abstract",
        "PMC12019924::web::003::main"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal-expansion and mechanical-property mismatch may cause long-term adhesion or durability problems under cyclic stress.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain at least a 20% hardness increase, reduced friction and wear, and adequate adhesion would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
