  "claims": [
    {
      "text": "The base alloy has nominal composition Cr16Mn16Fe16Co16Ni16P20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slow cooling of the arc-melted base alloy produces a complex microstructure containing multiple crystalline phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid melt-spinning produces a predominantly amorphous base alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is incorporation of approximately 1–2 at.% B into the base alloy during melting.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B incorporation creates local chemical inhomogeneity and atomic-size mismatch in the liquid.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B-induced inhomogeneity and size mismatch disrupt liquid short-range order.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Disruption of short-range order by B reduces the formation of critical nuclei for primary non-eutectic crystalline phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A small B addition perturbs bonding and nucleation kinetics and interferes with the alloy's multistep crystallization sequence.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B addition suppresses unwanted primary phases under both rapid and moderate cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During reheating, B kinetically stabilizes the amorphous matrix against premature crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed rapid-cooling boundary is melt-spinning at rates greater than 10^6 K/s.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed slower-cooling boundary spans 52–3018 K/s.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will be assessed during reheating up to approximately 1300 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the undoped alloy, B doping will increase the retained amorphous fraction after rapid cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the undoped alloy, B doping will increase the retained amorphous fraction after cooling at 52–3018 K/s.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B doping will delay and reduce the exothermic crystallization signal during reheating to approximately 1300 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified alloy exhibits earlier crystallization onset during reheating.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outside the stated cooling-rate and reheating boundaries, alternative crystallization mechanisms may dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B concentrations in the proposed range may form unwanted boride phases.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant amorphous-fraction increase or crystallization delay, or observation of borides, is designated as falsifying the hypothesis.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
