  "claims": [
    {
      "text": "The initial TiVNbTa alloy is an as-cast, dendritic, single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has a yield strength of about 800 MPa at lower temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a yield strength of approximately 330 MPa and approximately 30% compressive strain.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A solution anneal at approximately 1400 °C will homogenize the dendritic TiVNbTa structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging at 800–850 °C for 2–4 hours after solution annealing will induce precipitation hardening in TiVNbTa.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will produce uniformly dispersed nanoscale second-phase precipitates within a continuous BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::014::discussion",
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will be coherent and ordered B2, or a similar ordered phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::014::discussion",
        "PMC6478865::web::000::abstract",
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoscale ordered precipitates impede dislocation glide through shearing resistance, slip frustration, or Orowan bypass.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed precipitates will remain effective obstacles to dislocation climb at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate obstruction of dislocation motion will slow thermally activated softening and preserve elevated-temperature yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will increase TiVNbTa yield strength at 1273 K from approximately 330 MPa to more than 600 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strengthened TiVNbTa alloy will retain adequate ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
