        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "Sigma-phase precipitates will stabilize the B2 matrix against high-temperature coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
