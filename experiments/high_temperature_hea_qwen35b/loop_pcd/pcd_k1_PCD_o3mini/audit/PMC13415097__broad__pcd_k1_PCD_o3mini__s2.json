      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial heterogeneities and secondary features are nanoscale.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing heals defects in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Exchange homogenization produces fewer domain-wall pinning sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing and Pd addition act cooperatively rather than merely independently.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::003::body",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined treatment increases magnetic entropy change under applied fields below 1 T.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::003::body",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pd addition can improve refrigerant capacity by nearly 40%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined treatment significantly reduces magnetic hysteresis.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined treatment preserves or improves thermal conductivity and therefore rapid heat exchange.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined treatment preserves or improves mechanical stability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnetic transition temperature of the alloy family can be tuned over approximately 100–300 K.",
