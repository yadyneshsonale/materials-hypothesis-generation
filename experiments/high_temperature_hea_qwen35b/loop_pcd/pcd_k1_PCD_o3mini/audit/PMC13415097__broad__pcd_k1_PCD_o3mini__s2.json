  "claims": [
    {
      "text": "NiFeCoCr-Pd alloys are rare-earth-free high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing and minor Pd addition reduce the distribution of magnetic exchange energies and make NiFeCoCr-based alloys more magnetically homogeneous.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A Pd concentration of 1–3 at.% is sufficient to produce the proposed homogenization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Narrowing the exchange-energy distribution induces a predominantly second-order magnetic transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
