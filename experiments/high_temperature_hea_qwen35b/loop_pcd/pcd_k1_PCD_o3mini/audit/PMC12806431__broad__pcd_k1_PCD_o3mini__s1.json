  "claims": [
    {
      "text": "CrMnFeCoNi is a single-phase face-centered-cubic high-entropy alloy in the hypothesized regime.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate-temperature exposure promotes segregation and nanoclustering of Cr, Ni, and Mn at grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled isothermal annealing, rather than deformation at temperature, is sufficient to induce the proposed grain-boundary nanoclustering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary nanoclusters of Cr, Ni, and Mn reduce grain-boundary cohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced grain-boundary cohesion promotes intergranular crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "There is a critical nanocluster concentration above which intergranular cohesion deteriorates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoclustering-induced grain-boundary decohesion lowers fracture toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "The rapidly quenched, as-cast baseline is homogeneous and has minimal grain-boundary segregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The rapidly quenched baseline has high fracture toughness.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Samples will be annealed at 600, 700, and 800 °C for 1–10 hours under inert conditions and then rapidly quenched.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy remains a single-phase solid solution throughout the proposed heat treatments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Modest short-range order or segregation may initially strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregation of Cr, Ni, and Mn at grain boundaries can occur below 700 °C and is associated with ductility loss at intermediate temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Extended annealing, especially at 800 °C or for longer dwell times, will increase grain-boundary nanocluster formation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Atom probe tomography can detect the proposed Cr-, Ni-, and Mn-rich grain-boundary nanoclusters.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Extended annealing will produce lower fracture-toughness values or lower crack-initiation loads than the rapidly quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Short anneals at 600–700 °C may provide a strength benefit before embrittlement dominates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies only while secondary-phase precipitation is absent or has been ruled out.",
      "field": "boundary",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract"
      ],
      "same_system": "yes"
