      ],
      "same_system": "yes"
    },
    {
      "text": "Phosphorus, together with high mixing entropy, enhances the glass-forming ability of Cr16Mn16Fe16Co16Ni16P20 during rapid cooling.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
