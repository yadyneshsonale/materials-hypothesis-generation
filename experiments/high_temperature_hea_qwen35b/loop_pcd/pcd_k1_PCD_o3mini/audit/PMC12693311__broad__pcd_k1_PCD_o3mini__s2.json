      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anneal decreases free volume in the amorphous matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anneal enhances chemical short-range order in the amorphous matrix.",
