        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The low-temperature route will consistently produce a high proportion of isolated Pt/Pd sites.",
      "field": "predicted_outcome",
      "needs_support": true,
