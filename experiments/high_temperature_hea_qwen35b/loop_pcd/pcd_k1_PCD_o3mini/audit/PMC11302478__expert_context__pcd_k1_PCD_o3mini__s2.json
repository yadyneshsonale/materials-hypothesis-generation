  "claims": [
    {
      "text": "Subtle compositional modifications among equiatomic Cr-Mn-Fe-Co-Ni and its quaternary or ternary subsets alter chemical interactions and thereby change short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Variations in short-range order govern differences in deformation behavior among these alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::024::dislocation_motion_and_lco_induced_stren",
        "PMC10656519::web::003::introduction",
        "PMC10656519::web::015::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Variations in short-range order govern differences in failure behavior among these alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced short-range order creates spatially heterogeneous local environments that pin or impede dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::024::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order increases activation barriers for dislocation motion and makes dislocation lines more wavy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::024::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order raises critical resolved shear stress and yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::024::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order reduces ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced short-range order facilitates dislocation motion and lowers strength relative to a more ordered state.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::024::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced short-range order increases uniform elongation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The equiatomic Cr-Mn-Fe-Co-Ni baseline and selected subsets can be compared in single-phase FCC states.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4740901::web::003::body",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hot rolling followed by annealing can provide homogeneous, comparable microstructures across the investigated alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "All alloys will be processed identically and controlled to have identical grain structures.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Testing between room temperature and approximately 400 °C minimizes thermal-activation effects.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
