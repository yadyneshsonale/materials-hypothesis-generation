      "supporting_ids": [
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_"
      ],
      "same_system": "no"
    },
    {
      "text": "Aluminum selectively oxidizes at the alloy surface because of its high affinity for oxygen.",
