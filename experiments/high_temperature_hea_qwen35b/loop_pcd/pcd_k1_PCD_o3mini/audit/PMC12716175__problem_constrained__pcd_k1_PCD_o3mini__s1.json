  "claims": [
    {
      "text": "The initial material is an unmodified W–Cu composite with W particles or interconnected W ligaments in a Cu matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetron sputtering can be used to apply a Ti or Ti–Ni coating to the W phase before SPS consolidation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction",
        "PMC7514646::web::014::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The appropriate Ti or Ti–Ni coating thickness is 20–50 nm.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-to-Ni ratio should be controlled and optimized for interfacial performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated W–Cu composite can be consolidated by SPS at 900–1000 °C under an inert atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating is applicable during service up to approximately 550 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating remains effective under Ar+, He+, or D+ irradiation relevant to fusion plasma-facing components.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coating the W phase with Ti or Ti–Ni before SPS forms a graded W–Ti–Cu interfacial reaction zone.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction",
        "PMC7514646::web::014::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The titanium-based coating improves wetting between W and Cu during consolidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating promotes controlled interdiffusion at the W–Cu interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction",
        "PMC7514646::web::014::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting graded layer acts as a diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting graded layer relieves interfacial stresses caused by W–Cu mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating and graded layer suppress phase separation in the W–Cu composite.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating inhibits interfacial void formation during processing and subsequent thermal or irradiation service.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced voiding and phase separation lower the interfacial thermal resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated W–Cu composite will have higher overall thermal conductivity than the uncoated composite after thermal and irradiation exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improper coating thickness or composition may produce brittle intermetallic phases that degrade thermal performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated W–Cu develops interfacial voids and phase separation under high-temperature and irradiation conditions, degrading its thermal conductivity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
