  "claims": [
    {
      "text": "Mn in equiatomic Cr-Mn-Fe-Co-Ni produces greater magnetic frustration than in the Mn-deficient Cr-Fe-Co-Ni and Cr-Co-Ni subsets.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::007::effect_of_magnetism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Magnetic frustration associated with Mn promotes stress-induced evolution of chemical short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::007::effect_of_magnetism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Atomic-size mismatch involving Mn promotes stress-induced chemical short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applied tensile strain causes chemical short-range order to form or evolve in the quinary alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local chemical order raises the energy barrier for dislocation motion by generating restoring forces and nanoscale trapping heterogeneities.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Stronger local chemical order produces greater dislocation impediment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Chemical short-range order alters dislocation multiplication and cross-slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress-induced chemical short-range-order evolution is more pronounced in the Mn-containing quinary alloy than in the Mn-deficient quaternary and ternary alloys.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mn-deficient quaternary and ternary alloys experience diminished stress-induced chemical short-range-order evolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater chemical ordering is associated with increased mechanical strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10265979::web::004::body",
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The quinary alloy has higher yield strength than the Mn-deficient quaternary and ternary subsets because of its greater stress-induced chemical ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10265979::web::004::body",
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The quinary alloy has enhanced strain hardening relative to the Mn-deficient quaternary and ternary subsets.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the quinary baseline, the quaternary and ternary alloys will show lower yield strengths.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10265979::web::004::body",
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the quinary baseline, the quaternary and ternary alloys will show different strain-hardening rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mn-deficient alloys will exhibit fewer local-order-associated dislocation pinning sites during deformation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::023::dislocation_motion_and_lco_induced_stren"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The comparison is restricted to single-phase FCC alloys with matched thermomechanical histories, grain sizes, and defect densities, tested at room temperature and approximately 10^-4 s^-1.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
