      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing HVOF parameters such as spraying distance, particle temperature, or velocity can alter oxidation and phase development in this coating.",
