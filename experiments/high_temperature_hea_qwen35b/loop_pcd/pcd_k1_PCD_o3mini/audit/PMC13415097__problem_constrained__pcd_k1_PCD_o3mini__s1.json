      "support": "entailed",
      "supporting_ids": [
        "PMC9365696::web::014::magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reducing pinning centers facilitates more cooperative and reversible domain-wall motion.",
