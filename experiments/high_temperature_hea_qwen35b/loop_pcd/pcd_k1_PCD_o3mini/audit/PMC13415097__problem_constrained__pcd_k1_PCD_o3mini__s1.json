  "claims": [
    {
      "text": "As-deposited non-equiatomic FeMnNiGeSi thin films or nanoribbons possess significant chemical inhomogeneity and residual stress.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
