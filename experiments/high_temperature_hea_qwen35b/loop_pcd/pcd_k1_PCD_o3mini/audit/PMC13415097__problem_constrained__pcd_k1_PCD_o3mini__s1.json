      "supporting_ids": [
        "PMC11469235::web::004::introduction",
        "PMC9365696::web::014::magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Interfaces, dislocations, and their elastic distortion fields can pin magnetic domain walls.",
