      "supporting_ids": [
        "PMC11469235::web::004::introduction",
        "PMC9365696::web::014::magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Microstructural barriers that pin domain walls increase coercivity and magnetic hysteresis.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Domain-wall pinning broadens the magnetocaloric response of the FeMnNiGeSi films or nanoribbons.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
