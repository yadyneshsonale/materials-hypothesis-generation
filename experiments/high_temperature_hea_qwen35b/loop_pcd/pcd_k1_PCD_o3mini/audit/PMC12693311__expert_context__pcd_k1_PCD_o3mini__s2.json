  "claims": [
    {
      "text": "The baseline alloy has composition Cr16Mn16Fe16Co16Ni16P20 and is prepared by arc melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy retains an amorphous structure only under sufficiently rapid cooling, while slower cooling produces multiple crystalline phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy has a complex thermal response with multiple crystallization events.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is to replace 2–5 at.% Ni with Zr, producing Cr16Mn16Fe16Co16Ni(16-x)ZrxP20 for x = 2–5.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substituting 2–5 at.% Ni with Zr will enhance amorphous-phase formation and stability during solidification and reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Zr increases atomic-size mismatch and local chemical disorder in this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Greater atomic-size mismatch disrupts regular crystalline packing and impedes crystal nucleation and growth.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Zr has a larger atomic radius and favorable negative mixing enthalpy with the transition metals in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr substitution will increase melt viscosity and reduce atomic mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increased viscosity and reduced atomic mobility kinetically hinder crystallization during cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The same kinetic mechanism will hinder crystallization during reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the baseline, the Zr-modified alloy will form glass robustly over a broader range of cooling rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The Zr-modified alloy will show delayed or fewer crystallization exotherms and a simpler DSC profile during reheating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The improvement should occur from approximately 3000 K/s through 10^6 K/s.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may fail at cooling rates below 50 K/s.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr contents above the proposed optimal range may promote secondary intermetallic formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Zr concentration and its effects on ductility and intermetallic formation remain uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed test compares 0, 2, 3, and 5 at.% Zr alloys under approximately 3000 K/s cooling and 10^5–10^6 K/s melt spinning, followed by controlled DSC reheating.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD, DSC, and SEM/TEM will measure amorphous retention, crystallization behavior, and secondary-phase formation.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if Zr substitution produces no significant improvement in amorphous retention or crystallization delay, or produces more secondary intermetallic phases than the baseline.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
