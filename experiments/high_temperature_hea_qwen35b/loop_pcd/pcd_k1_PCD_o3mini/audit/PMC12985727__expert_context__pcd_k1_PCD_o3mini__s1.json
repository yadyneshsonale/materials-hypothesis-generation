      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD, SEM, mechanical testing, and thermal-conductivity measurements will be used to compare Mo-containing alloys across 5–20 at% Mo.",
      "field": "falsification_experiment.design",
