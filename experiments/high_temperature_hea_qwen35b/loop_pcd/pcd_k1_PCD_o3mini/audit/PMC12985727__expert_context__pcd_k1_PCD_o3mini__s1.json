  "claims": [
    {
      "text": "The baseline equiatomic TiVNbTa alloy has a single-phase BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a compressive strength of approximately 423 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is to add 10–15 at% Mo to equiatomic TiVNbTa.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Homogenization can help produce a homogeneous single-phase BCC refractory alloy without segregation or precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::000::abstract",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 10–15 at% Mo to TiVNbTa will increase its high-temperature mechanical stability through solid-solution strengthening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo addition to TiVNbTa will promote a transition from screw-dislocation-dominated to edge-dislocation-dominated plasticity at elevated temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::000::abstract",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified TiVNbTaMo alloy will retain sufficient ductility after Mo addition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified TiVNbTaMo alloy will retain sufficient thermal conductivity for efficient W-to-CuCrZr heat transfer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo has a high melting point relative to many other refractory-alloy constituent elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic-size and elastic mismatch of solute elements contributes to solid-solution strengthening in refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mo specifically has sufficient atomic-size or modulus mismatch with Ti, V, Nb, and Ta to create effective edge-dislocation pinning sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased barriers to dislocation motion from Mo will strengthen TiVNbTaMo at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st"
      ],
      "same_system": "no"
    },
    {
      "text": "A transition from screw to edge dislocations can produce a strength plateau over an elevated-temperature range in refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::000::abstract",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "TiVNbTaMo with 10–15 at% Mo will exceed 400 MPa yield strength at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::000::abstract",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "TiVNbTaMo with 10–15 at% Mo will retain at least 30% strain at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy is intended to operate over 800–1273 K under high mechanical load.",
