  "claims": [
    {
      "text": "Incremental Y and Hf additions to a NiCoCrAl-based MPEA increase lattice distortion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increased lattice distortion elevates vacancy formation energies in the Al-depletion zone.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increased lattice distortion raises Al migration barriers in the Al-depletion zone.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The elevated vacancy formation energies and Al migration barriers suppress sustained Al diffusion through the Al-depletion zone.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppression of sustained Al diffusion causes rapid initial formation of a continuous protective Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The rapid initial establishment of protective Al2O3 is promoted by a refined or lamellar eutectic microstructure.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "After a continuous Al2O3 scale forms, Al must diffuse through the Al-depletion zone to replenish Al consumed at the oxide-substrate interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al diffusion rate through the Al-depletion zone directly affects the subsequent Al2O3 growth rate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppressing Al replenishment at the oxide-substrate interface slows sustained Al2O3 scale growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::021::mechanism_of_retarded_al2o3_scale_growth",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice-distortion-induced diffusion suppression makes the Al2O3 scale more adherent and less prone to spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Y/Hf-containing MPEA has greater oxidation resistance than the typical NiCoCrAlY benchmark at 1200 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The doped alloys will exhibit up to about a 59% reduction in TGO layer thickness relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing the combined Y and Hf addition from 0 to 2, 5, and 10 wt% will produce a graded reduction in TGO growth.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y/Hf-containing alloys will exhibit improved scale adherence and reduced oxidation-induced spallation throughout 1100–1200 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Negligible TGO spallation can persist for 500 hours at 1200 °C in the reported Y/Hf co-doped MPEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxidation benefit is primarily attributable to lattice distortion rather than to secondary microstructural changes.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism holds across 1100–1200 °C for exposures up to 500 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Microstructural or phase-stability changes can independently affect oxidation behavior and confound attribution to lattice distortion.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC13067856::web::027::conclusion"
      ],
      "same_system": "yes"
    },
    {
