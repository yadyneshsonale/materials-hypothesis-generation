      "support": "partial",
      "supporting_ids": [
        "PMC10774414::web::006::gaussian_distribution_of_gh_on_ptfeconic"
      ],
      "same_system": "no"
    },
    {
      "text": "The annealed catalyst will have lower ethanol-oxidation current density than the unannealed catalyst.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing will alter the ethanol-oxidation product distribution relative to the unannealed baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing may decrease the formation rate of partial-oxidation intermediates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior should hold in 0.5 M H2SO4 with 1 M ethanol at room temperature between 0.4 and 0.8 V versus RHE.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
