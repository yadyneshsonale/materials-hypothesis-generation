      "supporting_ids": [
        "PMC10466320::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed treatment consists of oxidation at 300–400 °C for approximately two hours in an oxygen-rich atmosphere, followed by a rapid switch to a hydrogen-rich atmosphere.",
