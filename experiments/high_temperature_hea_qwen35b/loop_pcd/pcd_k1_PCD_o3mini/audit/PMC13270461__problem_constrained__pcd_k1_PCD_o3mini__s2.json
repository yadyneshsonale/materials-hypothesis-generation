  "claims": [
    {
      "text": "The additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::025::3_2_microstructure_of_selective_laser_me"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-built microstructure contains fine secondary precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9414008::web::025::3_2_microstructure_of_selective_laser_me"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-manufactured baseline has limited oxide content and intact grain boundaries.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure at about 800°C for 100 hours in an oxidizing gas causes Ti to segregate to and oxidize at grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-boundary oxidation product is nanoscale TiO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary TiO2 introduces local stresses and acts as a weak, embrittling interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiO2-induced grain-boundary weakening initiates microcracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coalescence of the grain-boundary microcracks causes catastrophic failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 5% H2 reducing atmosphere suppresses significant Ti oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing Ti oxidation preserves grain-boundary cohesion and improves high-temperature mechanical performance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 800°C for 100 hours is sufficient to activate oxidation, diffusion, and observable microstructural evolution while remaining below melting.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC9414008::web::025::3_2_microstructure_of_selective_laser_me"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Precipitates preferentially form at grain boundaries or grain-boundary junctions and may occur as discrete inclusions or a connected network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::025::3_2_microstructure_of_selective_laser_me"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidizing exposure will increase the density and grain-boundary localization of TiO2 relative to the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microcracks will be observed at or near grain-boundary TiO2 precipitates after oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will measurably reduce fracture toughness relative to the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure will produce less oxide and retain greater mechanical integrity than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies near 800°C when oxygen partial pressure is sufficient to drive oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Changes in temperature, duration, or gas composition outside the proposed exposure bounds may activate additional reactions or phase transformations.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC9414008::web::025::3_2_microstructure_of_selective_laser_me"
      ],
      "same_system": "unclear"
