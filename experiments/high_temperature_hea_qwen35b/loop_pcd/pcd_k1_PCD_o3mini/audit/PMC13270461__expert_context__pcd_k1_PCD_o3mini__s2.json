  "claims": [
    {
      "text": "The as-manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy is a single-phase FCC material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-manufactured alloy has a homogeneous elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has notable strength and fatigue performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Degradation in an oxidizing atmosphere is governed by selective oxidation of Al and Ti.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_",
        "PMC10820071::web::016::4_conclusions",
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_"
      ],
      "same_system": "no"
    },
    {
      "text": "Elevated temperature enhances diffusion of Al and Ti toward oxidation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC13208696::web::016::3_2_microstructural_morphology_of_the_ox"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure produces a nanoscale Al2O3/TiO2-type oxide layer associated with grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_",
        "PMC13208696::web::016::3_2_microstructural_morphology_of_the_ox"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al- and Ti-rich oxide layer is coherent, continuous, and passivating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_"
      ],
      "same_system": "no"
    },
    {
      "text": "A dense and continuous protective oxide scale limits inward oxygen transport and further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide layer suppresses microcrack initiation and preserves fatigue performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure prevents or disrupts formation of the protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure causes localized elemental depletion or compositional fluctuations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure promotes precipitate nucleation in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary precipitates and associated local stresses promote microcrack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842681::web::037::4_discussion",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Accelerated microcrack development diminishes fatigue performance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After oxidizing exposure, the alloy will have a more uniform and adherent oxide layer, fewer microcracks, and better-retained fatigue performance than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::016::3_2_microstructural_morphology_of_the_ox"
      ],
      "same_system": "no"
    },
    {
      "text": "After reducing exposure, the alloy will have a discontinuous oxide, more precipitates, higher grain-boundary stress, greater microcrack density, and poorer fatigue properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy contains no pre-existing detrimental oxide scales or precipitates.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale thickness, continuity, grain-boundary chemistry, and local stress act as mediators of mechanical degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::016::3_2_microstructural_morphology_of_the_ox",
        "PMC12842681::web::037::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr may also influence oxidation and degradation by contributing to protective-scale or subsurface chemistry.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_",
        "PMC10820071::web::016::4_conclusions",
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A paired comparison at 800 °C for 100 hours in air and 5% H2 in N2, with matched thermal histories and flow rates, is the proposed controlled test.",
