      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12508472::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified LPBF regime will induce partial recrystallization during solidification.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10616214::web::005::programmable_and_site_specific_recrystal",
        "PMC10616214::web::024::sample_production"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled SRO and partial recrystallization will relax residual stress and stabilize the AlCrFeNiSi microstructure.",
