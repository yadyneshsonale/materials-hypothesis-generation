  "claims": [
    {
      "text": "The starting material is untreated gas-atomized AlCrFeNiSi powder suitable for LPBF.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced laser power, increased scan speed, adaptive energy modulation, and calibrated layer dwell times will induce controlled nonequilibrium chemical short-range order in AlCrFeNiSi.",
