  "claims": [
    {
      "text": "The base Cr16Mn16Fe16Co16Ni16P20 alloy becomes amorphous under melt-spinning at cooling rates of approximately 10^5–10^6 K/s.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The base alloy has limited amorphous retention even under rapid quenching.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The base alloy exhibits a complex thermal response during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 5 at.% boron substituted for one or more transition metals will improve amorphous retention and thermal stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding boron to this alloy increases its atomic-size mismatch.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding boron introduces directional, covalent-like bonding into this alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic-size mismatch disrupts regular crystalline packing and impedes crystal nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "Atomic-size mismatch elevates melt viscosity and reduces the diffusion and rearrangement needed for crystal growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "Directional bonding from boron increases packing frustration and topological disorder.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-induced structural changes raise kinetic barriers to crystallization during rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-induced structural changes hinder crystallization during subsequent reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will retain an amorphous phase over a broader range of rapid cooling conditions than the base alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will show delayed crystallization exotherms during DSC reheating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will show fewer or simpler crystallization exotherms during DSC reheating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit of boron should be greatest at high cooling rates and may disappear under very slow cooling, where equilibrium crystalline phases form.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation of crystalline boride phases could prevent the proposed improvement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling of the base alloy produces a complex multiphase crystalline microstructure, while faster cooling reduces the number of crystalline phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phosphorus and high mixing entropy promote glass formation in the base alloy during very rapid cooling.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    }
