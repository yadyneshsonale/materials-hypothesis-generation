      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine L12 precipitates impede dislocation motion through an Orowan bowing and bypass mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Obstruction of dislocation motion by L12 precipitates increases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent L12/fcc interfaces preserve strain transfer and facilitate dislocation glide.",
