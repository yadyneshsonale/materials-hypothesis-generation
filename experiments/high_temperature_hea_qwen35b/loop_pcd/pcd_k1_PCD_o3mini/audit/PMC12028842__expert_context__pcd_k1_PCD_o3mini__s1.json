      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206818::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The transitional microstructure and secondary phases will ensure strong metallurgical bonding.",
      "field": "structural_mediator",
