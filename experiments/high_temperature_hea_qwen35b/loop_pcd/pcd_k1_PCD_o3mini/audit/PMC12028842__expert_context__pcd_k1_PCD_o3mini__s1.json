      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989606::web::009::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "An energy density of approximately 80 J/mm², a scanning speed near 3 m/min, and powder particles below 50 micrometers are suitable processing parameters for this coating system.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal simulations and adjustable layering can control heat input and minimize thermal mismatch in the Ti-Mo-Nb-Ta coating on TC4.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will develop a fine dendritic HEA microstructure.",
