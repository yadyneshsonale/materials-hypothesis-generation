  "claims": [
    {
      "text": "TC4 is an alpha-plus-beta dual-phase titanium alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
