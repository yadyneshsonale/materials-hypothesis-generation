    {
      "text": "Untreated TC4 has relatively low hardness and suboptimal friction and wear performance under high-contact-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A graded Ti-Mo-Nb-Ta HEA coating can be deposited on TC4 by laser cladding with fine pre-alloyed powder.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
