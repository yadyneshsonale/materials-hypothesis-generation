        "PMC11206818::web::028::4_conclusions",
        "PMC11989606::web::009::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "The graded composition will minimize thermal-expansion mismatch between the coating and TC4.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimized graded cladding process will refine the coating grains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10813983::web::012::3_1_the_interface_morphology_between_wta"
      ],
      "same_system": "no"
    },
    {
