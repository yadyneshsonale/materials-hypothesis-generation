  "claims": [
    {
      "text": "The initial Al-doped CoCrFeMnNi nanoparticles contain approximately 5 at.% Al distributed homogeneously.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing Al-doped CoCrFeMnNi nanoparticles at 800°C under low oxygen partial pressure promotes formation of an Al2O3 surface scale.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A suitable low oxygen partial pressure permits surface oxidation while preventing widespread bulk oxidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Al2O3 layer is nanoscale, continuous, uniform, and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aluminum oxidizes preferentially at the nanoparticle surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The surface Al2O3 layer passivates the nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 surface passivation reduces atomic diffusion during high-temperature treatment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic diffusion limits elemental segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic diffusion limits phase transformation or phase instability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under the proposed low-pO2 treatment, Al-doped nanoparticles will undergo less compositional change than undoped CoCrFeMnNi nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under the proposed low-pO2 treatment, Al-doped nanoparticles will retain the high-temperature disordered phase better than undoped nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped CoCrFeMnNi nanoparticles subjected to the same treatment are expected to show significant elemental segregation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped CoCrFeMnNi nanoparticles are expected to undergo phase evolution because high-temperature diffusion is not mitigated.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen partial pressure above a critical threshold may cause excessive scale growth or bulk oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive scale growth or bulk oxidation compromises structural and chemical stability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nonuniformity or spallation of the oxide scale may diminish the predicted stability improvement.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
