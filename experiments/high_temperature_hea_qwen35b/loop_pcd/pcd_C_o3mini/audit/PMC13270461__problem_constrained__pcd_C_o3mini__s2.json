  "claims": [
    {
      "text": "The as-built additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has a homogeneous fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 700°C, the alloy has a critical oxygen partial-pressure threshold separating protective and damaging oxidation regimes.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the critical oxygen partial pressure, oxide-scale growth accelerates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated oxide-scale formation overwhelms the alloy's self-passivating ability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of passivation permits oxygen to penetrate into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal oxygen penetration destabilizes the fcc matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal oxidation and fcc-matrix destabilization promote micro-crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Micro-cracks coalesce and cause catastrophic failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below the critical oxygen partial pressure, slower reaction kinetics preserve a uniform protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preservation of a protective oxide layer delays degradation below the threshold.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above-threshold exposures will produce thicker oxide scales than below-threshold exposures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above-threshold oxide scales will be less adherent than below-threshold oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above-threshold exposures will cause more pronounced internal oxidation and earlier micro-crack coalescence.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below-threshold exposures will yield thinner, more uniform oxide layers and greater structural stability over 100 hours.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anticipated transition lies between approximately 10^-3 and 10^-1 atm oxygen at 700°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural heterogeneity and competing kinetic processes may shift the threshold oxygen pressure.",
      "field": "uncertainty",
