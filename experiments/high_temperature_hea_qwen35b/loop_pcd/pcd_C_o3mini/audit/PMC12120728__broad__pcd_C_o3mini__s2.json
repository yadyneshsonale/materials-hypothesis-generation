  "claims": [
    {
      "text": "Adding 1–2 at.% Y to MoNbTaTiW can improve its radiation tolerance under plasma-facing irradiation conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid solidification followed by a controlled oxidizing anneal can produce uniformly dispersed, nanometer-scale Y2O3 particles in Y-modified MoNbTaTiW.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An anneal near 1200 °C for approximately 1 hour in a moderately oxygenated inert atmosphere will promote in situ formation of Y2O3 dispersoids.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Shorter annealing times or slightly lower annealing temperatures can limit Y2O3 nanoparticle growth.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed radiation-tolerance benefit should occur at approximately 700 °C and approximately 1 dpa under fusion-relevant plasma-facing irradiation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 nanoparticles act as sinks for radiation-induced vacancies and interstitials.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect capture at Y2O3 nanoparticles facilitates vacancy-interstitial recombination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced defect recombination reduces void formation and radiation-induced swelling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory MoNbTaTiW matrix will retain high mechanical strength and thermal stability after Y addition, oxidation processing, and irradiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will show more than approximately 30–50% lower radiation-induced defect density than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will show more than approximately 30–50% lower void swelling than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will maintain or slightly increase yield strength relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will maintain or slightly increase ductility relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit depends on obtaining a uniform and stable Y2O3 nanoparticle dispersion.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 particle coarsening or spatial inhomogeneity will reduce defect-sink efficiency.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 particle coarsening or spatial inhomogeneity may degrade mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
