      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast equimolar CoCrFeNiTi alloy is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti atoms create localized lattice distortions in CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-induced lattice distortions reduce the formation and stabilization of dislocation locks and barriers.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing barriers to dislocation motion can reduce strengthening.",
