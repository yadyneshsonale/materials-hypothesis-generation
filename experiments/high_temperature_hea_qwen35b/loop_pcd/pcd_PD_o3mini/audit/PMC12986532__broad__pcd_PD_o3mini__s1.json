      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "TEM should reveal smaller grains in the carbon-containing coating than in the carbon-free control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "TEM should reveal improved grain-boundary coherence in the carbon-containing coating relative to the carbon-free control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
