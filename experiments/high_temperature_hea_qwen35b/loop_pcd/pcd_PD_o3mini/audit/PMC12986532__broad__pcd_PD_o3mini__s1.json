  "claims": [
    {
      "text": "The investigated CrNbTaTiW coatings have a multilayer architecture.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incorporating approximately 8 at.% carbon during deposition produces a supersaturated solid solution in CrNbTaTiW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 8 at.% carbon can occupy octahedral interstitial sites in the BCC CrNbTaTiW structure without forming carbides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Carbon incorporation refines the column diameter from approximately 35 nm to approximately 10 nm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The carbon-free CrNbTaTiW coating has approximately 35 nm diameter columnar grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Carbon incorporation enhances or stabilizes coherent grain boundaries relative to the carbon-free coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The carbon-free coating has less coherent or weaker grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined grains and coherent boundaries inhibit dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined grains and coherent boundaries inhibit dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inhibiting dislocation nucleation and glide delays or reduces time-dependent plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under sustained load, the carbon-containing coating will have a lower creep-displacement rate than the carbon-free control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under sustained load, the carbon-containing coating will retain more hardness over time than the carbon-free control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6162281::web::000::abstract",
        "PMC6162281::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Carbon addition increases the coating hardness from 14.7 GPa to 19.1 GPa while leaving the reduced elastic modulus at 322 GPa.",
