  "claims": [
    {
      "text": "TC4 (Ti6Al4V) has a standard alpha-plus-beta dual-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated TC4 has low surface hardness and poor friction and wear performance under extreme-service conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction stir processing with fine HEA powder will create a nanostructured composite layer in the top approximately 500 micrometers of TC4.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::004::introduction",
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed layer will contain a homogeneous, uniformly dispersed HEA phase that is well integrated with the TC4 substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction stir processing will refine the grains in the surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::004::introduction",
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "Severe plastic deformation during friction stir processing initiates dynamic recrystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::004::introduction",
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "Friction stir processing initiates mechanical alloying between the HEA powder and TC4.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Embedded HEA particles act as hard, load-bearing reinforcing phases that increase hardness and wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "The HEA particles block dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HEA particles impede crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated TC4 surface will exhibit a microhardness increase of approximately 50 to 100 percent relative to untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated TC4 surface will have greater wear resistance than untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated TC4 surface will have a lower coefficient of friction than untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HEA-containing surface layer will maintain strong bonding to the TC4 substrate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-localized friction stir processing will preserve TC4's bulk ductility and other advantageous volumetric properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Performing FSP below TC4's alpha-beta transformation threshold will ensure minimal thermal impact on the substrate.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted enhancements will be concentrated predominantly within the top 500 micrometers.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the hardness, friction, and wear improvements depends on HEA dispersion and FSP process control.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::012::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
