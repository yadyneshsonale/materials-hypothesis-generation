      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation transmission across coherent interfaces relieves local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stress relief by the coherent precipitates delays plastic-strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress relief by the coherent interfaces retards premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "At approximately 800 °C, the nanoprecipitation-treated alloy will have greater plastic strain than the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 800 °C, the nanoprecipitation-treated alloy will have greater toughness than the untreated baseline.",
