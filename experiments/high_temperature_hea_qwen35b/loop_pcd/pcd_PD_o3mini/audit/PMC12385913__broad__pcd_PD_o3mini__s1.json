        "PMC10213035::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline is a homogeneous, largely unmodified BCC matrix produced by conventional spark plasma sintering without engineered nanoprecipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored spark-plasma-sintering heat treatment can induce stepwise controllable coherent nanoprecipitation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract",
        "PMC10213035::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The precipitates can include nanoscale δ-lamellae and γ″ particles within a BCC/FCC dual-phase matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coherent nanoprecipitates are uniformly distributed through the matrix.",
