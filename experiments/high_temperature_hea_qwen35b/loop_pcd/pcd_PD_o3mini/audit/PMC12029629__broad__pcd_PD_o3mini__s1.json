      "supporting_ids": [
        "PMC11606435::web::004::introduction",
        "PMC11606435::web::030::deformation_mechanisms_in_the_metastable"
      ],
      "same_system": "no"
    },
    {
      "text": "The altered slip behavior produces more uniform deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic LCO and the associated dislocation behavior increase work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11606435::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The increased work hardening delays necking.",
