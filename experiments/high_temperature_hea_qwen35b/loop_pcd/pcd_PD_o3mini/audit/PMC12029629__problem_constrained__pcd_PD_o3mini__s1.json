  "claims": [
    {
      "text": "The Co-free FeNiCrMn alloy is derived from equiatomic CoCrFeMnNi.",
      "field": "hypothesis/material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching produces a fully disordered FeNiCrMn solid solution with minimal chemical short-range order.",
      "field": "material_initial_state/baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant solidified FeNiCrMn alloy is a single-phase FCC solid solution.",
      "field": "material_initial_state/boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suitable heat treatments can promote chemical short-range order in an initially disordered solid solution.",
