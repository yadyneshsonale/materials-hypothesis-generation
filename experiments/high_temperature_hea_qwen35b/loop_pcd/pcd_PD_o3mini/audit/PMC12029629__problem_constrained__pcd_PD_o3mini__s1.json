      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9646780::web::000::abstract",
        "PMC9646780::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An annealing treatment can enhance SRO in FeNiCrMn without inducing secondary phases.",
