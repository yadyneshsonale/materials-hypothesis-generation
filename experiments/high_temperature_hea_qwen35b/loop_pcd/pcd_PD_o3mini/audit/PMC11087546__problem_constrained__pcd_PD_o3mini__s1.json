  "claims": [
    {
      "text": "The untreated starting material is an AlCoCrFeNi-family eutectic high-entropy alloy with a hierarchical dual-phase lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
