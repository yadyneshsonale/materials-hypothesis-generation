  "claims": [
    {
      "text": "Equiatomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbMoTaW has excellent high-temperature strength but poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–3 atomic % Zr to equiatomic NbMoTaW will increase its room-temperature ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::015::elastic_constants_local_displacements_an"
      ],
      "same_system": "no"
    },
    {
      "text": "The 2–3 atomic % Zr addition can retain a single-phase BCC NbMoTaW matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr is larger in atomic size than the constituent elements of NbMoTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr addition will enhance lattice distortion in the single-phase BCC NbMoTaW matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::015::elastic_constants_local_displacements_an"
      ],
      "same_system": "no"
    },
    {
      "text": "Zr-induced local lattice strain lowers dislocation core energies in NbMoTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-induced lattice changes promote easier activation of slip systems and dislocation motion at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::015::elastic_constants_local_displacements_an"
      ],
      "same_system": "no"
    },
    {
      "text": "Greater dislocation mobility will produce more room-temperature plastic strain before failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::015::elastic_constants_local_displacements_an"
      ],
      "same_system": "no"
    },
    {
      "text": "Retaining the single-phase BCC matrix will preserve the alloy's high-temperature load-bearing capability at 1600 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr addition will not significantly affect defect-recombination processes important to irradiation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-alloyed material will maintain yield strength and hardness similar to untreated NbMoTaW at 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-alloyed material will retain the irradiation resistance of untreated NbMoTaW if a single-phase solid solution is preserved.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "A homogeneous Zr distribution without second-phase precipitation is necessary for the proposed benefits.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Zr segregation or unwanted precipitation could degrade high-temperature properties or irradiation behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention is restricted to material that remains single-phase BCC at room temperature, at 1600 °C, and under irradiation.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
