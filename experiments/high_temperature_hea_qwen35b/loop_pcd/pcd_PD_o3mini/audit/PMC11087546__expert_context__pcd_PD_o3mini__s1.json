  "claims": [
    {
      "text": "AlCoCrFeNi2.1 is a dual-phase eutectic HEA containing lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal boundaries in the AlCoCrFeNi2.1 lamellar colonies serve as crack-initiation sites during tensile deformation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% Zr during melting and applying rapid annealing will induce Zr segregation to lamellar-colony or interphase boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid annealing at approximately 850 °C for 30–50 seconds will promote optimal Zr segregation in AlCoCrFeNi2.1.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr segregation will enhance the coherence of the lamellar interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced interfacial coherence from Zr segregation will reduce local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced stress concentrations at Zr-modified interfaces will inhibit or delay microcrack nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr has a large atomic radius.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9506522::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The large atomic radius of Zr causes preferential segregation to internal boundaries in the target eutectic HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr will provide solid-solution strengthening within the AlCoCrFeNi2.1 matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::000::abstract",
        "PMC9506522::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Zr-alloyed, rapidly annealed alloy will have higher yield strength than unmodified AlCoCrFeNi2.1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::000::abstract",
        "PMC9506522::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Zr-alloyed, rapidly annealed alloy will have greater room-temperature tensile ductility than unmodified AlCoCrFeNi2.1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will exhibit more homogeneous plastic deformation than the unmodified baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
