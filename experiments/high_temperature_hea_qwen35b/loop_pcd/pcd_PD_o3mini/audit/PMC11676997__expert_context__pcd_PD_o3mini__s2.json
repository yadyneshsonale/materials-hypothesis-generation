  "claims": [
    {
      "text": "Ti30Ni30Cr20Al10V10 contains titanium and nickel as its joint primary constituents.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The homogenized Ti30Ni30Cr20Al10V10 alloy is predominantly a solid solution before aging.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solution treatment near 1050 °C for 1 hour, rapid quenching, and aging near 600 °C for 4–8 hours will precipitate Ni3Ti in Ti30Ni30Cr20Al10V10.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The aging treatment will produce nanoscale, uniformly distributed precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ni3Ti precipitates produced by aging will be coherent with the Ti–Ni-rich matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlling precipitation-treatment parameters can regulate precipitate size and distribution.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Fine precipitates strengthen the alloy by impeding dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10532893::web::014::4_discussion",
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Fine Ni3Ti precipitates impede grain-boundary sliding at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitate dispersion will increase elevated-temperature yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10532893::web::014::4_discussion",
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "At 650–700 °C, aging will raise yield strength by approximately 20–30% relative to the solution-treated and quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitate dispersion will enhance creep resistance at elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 650–700 °C, the aged alloy will have a lower creep rate than the unaged, solution-treated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The solution-treated and quenched baseline lacks a reinforcing Ni3Ti precipitate network.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
