      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention is generally applicable to Ti- and Ni-primary high-entropy alloys whose constituent concentrations are each 5–35 at%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
