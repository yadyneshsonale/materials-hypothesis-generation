  "claims": [
    {
      "text": "Al0.7CoCrFeNi is a eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting Al0.7CoCrFeNi alloy has a dual-phase lamellar FCC+B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy consists of hierarchical lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated alloy has less than 10% room-temperature elongation and inherently brittle behavior.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pile-ups at internal boundaries cause local stress concentrations, microcracking, and brittle failure in the untreated alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature annealing or aging can introduce coherent nanoscale ordered L12 precipitates into Al0.7CoCrFeNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging at 600–650 °C for 10–30 minutes followed by rapid air cooling is sufficient to produce the proposed L12 precipitation state.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aging treatment can be applied directly as a post-cast treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will produce uniformly dispersed coherent L12 nanoprecipitates specifically localized along inter-lamellar interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent L12 nanoprecipitates obstruct or pin dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6170471::web::010::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Interface-localized L12 nanoprecipitates disrupt abrupt dislocation accumulation and promote a more homogeneous distribution of plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The more homogeneous deformation reduces local stress concentrations and suppresses microcrack nucleation and propagation at lamellar interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dual-phase lamellar structure provides intrinsic strength that can be retained after aging.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment will increase uniform elongation from below 10% to above 15% at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will maintain yield strength or increase it by approximately 10–20% relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Quasi-static uniaxial tensile testing is an applicable method for evaluating the treated alloy.",
