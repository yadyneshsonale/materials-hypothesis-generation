      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aging-induced embrittlement effect should be observable in room-temperature tensile tests.",
      "field": "conditions",
