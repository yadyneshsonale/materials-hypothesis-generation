        "PMC6897545::web::004::introduction",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "An aging window can produce grain-boundary nanoclusters without significant grain growth or bulk phase decomposition.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant grain-boundary nanoclusters involve Cr, Ni, and Mn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::004::introduction",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr-, Ni-, and Mn-related grain-boundary nanoclustering reduces local grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
