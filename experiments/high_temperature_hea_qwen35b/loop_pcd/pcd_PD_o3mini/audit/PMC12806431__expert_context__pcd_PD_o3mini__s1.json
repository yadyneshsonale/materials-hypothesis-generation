      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast initial alloy has a homogeneous composition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast initial alloy exhibits ductile behavior.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging CrMnFeCoNi at 250–350 °C will induce nanoscale solute clusters at grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
