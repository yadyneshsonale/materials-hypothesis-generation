        "PMC6897545::web::004::introduction",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced grain-boundary cohesion promotes intergranular crack initiation under mechanical loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary nanoclustering promotes brittle or intergranular failure rather than uniformly distributed plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed embrittlement route is mechanistically distinct from embrittlement caused by conventional grain-boundary precipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::004::introduction",
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aged specimens will have lower fracture strain than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aged specimens will have lower toughness than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aged specimens will exhibit premature intergranular cracking relative to the as-cast baseline.",
