  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The baseline is zirconium-alloy cladding with a homogeneous elemental Cr coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elemental Cr coatings can peel and crack during high-temperature steam oxidation.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Premature failure of the baseline Cr coating is caused by significant Cr–Zr interdiffusion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A co-sputtering process can produce a Cr coating graded from pure Cr at the outer surface to a 5–10 vol% Hf-enriched interfacial zone.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation of Hf in the interfacial zone will form HfO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidized Hf can form a dense HfO2 layer that protects underlying material from deeper oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The interfacial HfO2 layer will be refractory, chemically inert, and stable under the proposed reactor environments.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf at the Cr/Zr interface will oxidize preferentially during service.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfO2 layer will physically impede Cr–Zr atomic interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfO2 layer will reduce the local chemical-potential gradient driving Cr–Zr interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The graded Cr–Hf coating will reduce Cr–Zr interdiffusion under both normal PWR conditions and accident-relevant high-temperature steam.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to homogeneous Cr, the graded Cr–Hf coating will provide thinner or more stable oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to homogeneous Cr, the graded Cr–Hf coating will have improved mechanical integrity after exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed protection applies to PWR primary-water exposure at approximately 320 °C and 11.3 MPa for about 20–60 days.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed protection also applies to accident-relevant steam exposure at approximately 1200 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction",
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "unclear"
    }
