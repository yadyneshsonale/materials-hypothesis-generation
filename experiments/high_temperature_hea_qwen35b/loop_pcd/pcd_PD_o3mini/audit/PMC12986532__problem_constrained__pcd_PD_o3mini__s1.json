    {
      "text": "Dispersing strain and delaying localization lowers the steady-state creep rate under sustained high-temperature loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
