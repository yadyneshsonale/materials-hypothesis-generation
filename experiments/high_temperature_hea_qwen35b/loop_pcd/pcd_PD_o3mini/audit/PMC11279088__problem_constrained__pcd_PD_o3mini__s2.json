      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al-containing alloy will show slower oxidation and a thinner, more protective scale than the Al-free baseline.",
      "field": "predicted_outcome",
