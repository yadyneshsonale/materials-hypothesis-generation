        "PMC9975007::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Low temperature restricts dislocation motion in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::012::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "High strain rates restrict dislocation motion because there is insufficient time for thermally activated barrier crossing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Restricted dislocation motion at low temperature and high strain rate produces dislocation pile-ups.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low temperatures and high strain rates produce higher yield stresses in FeNiCrMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::012::4_1_the_constitutive_model_and_strain_ra",
        "PMC8608792::web::012::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "no"
    },
    {
      "text": "Low temperatures and high strain rates reduce the ductility of FeNiCrMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperatures or lower strain rates enhance thermally activated dislocation glide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_",
        "PMC7512474::web::012::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher temperatures or lower strain rates cause dynamic recovery in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced glide and recovery lower the yield strength of FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8608792::web::012::mechanical_behavior_at_quasi_static_and_",
        "PMC7512474::web::012::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced glide and recovery improve the ductility and sustain plastic flow in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed initial material is equiatomic FeNiCrMn.",
