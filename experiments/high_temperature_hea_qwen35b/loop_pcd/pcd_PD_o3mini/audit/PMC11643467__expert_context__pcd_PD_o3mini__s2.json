      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale L12 precipitates obstruct dislocation motion through Orowan bowing and bypass.",
