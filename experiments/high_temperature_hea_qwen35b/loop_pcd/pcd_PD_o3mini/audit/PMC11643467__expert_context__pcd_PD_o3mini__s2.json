      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The L12 precipitates will pin grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed L12 precipitation will increase the yield strength of AlCoCrFeNi2.1 relative to its as-cast state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will improve the room- and elevated-temperature creep resistance of AlCoCrFeNi2.1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will enhance stability during extreme or fluctuating temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength improvement will occur without substantially compromising ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated AlCoCrFeNi2.1 has an insufficient strength–ductility balance for aerospace fastener applications.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated AlCoCrFeNi2.1 has limited high-temperature performance.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
