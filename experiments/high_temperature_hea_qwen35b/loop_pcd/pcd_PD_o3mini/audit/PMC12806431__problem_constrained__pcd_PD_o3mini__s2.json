        "PMC5578249::web::000::abstract",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Samples with a higher HCP phase fraction will have lower tensile ductility and more brittle fracture than the single-phase BCC baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
