  "claims": [
    {
      "text": "The alloy studied is equiatomic Ta20Nb20Hf20Zr20Ti20.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Before HIP, the alloy has a single-phase BCC solid-solution microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A standardized casting process produces a uniform initial microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HIP causes the appearance of a secondary HCP phase in the preexisting BCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::009::3_discussion",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aggressive HIP induces nucleation and growth of the HCP phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::009::3_discussion",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Varying HIP conditions can systematically control the HCP phase volume fraction and dispersion.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The secondary HCP phase can be distributed evenly through the matrix or concentrated at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::web::009::3_discussion",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HCP phase creates local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HCP phase impedes dislocation mobility in a manner resembling precipitation hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::009::3_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elements in the alloy naturally favor HCP structures at lower temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HCP-containing heterogeneous microstructure reduces ductility and toughness and causes a transition to brittle fracture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::000::abstract",
        "PMC5578249::web::015::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "HIP-processed Ta20Nb20Hf20Zr20Ti20 is highly brittle in room-temperature tensile tests and in creep testing near 282 °C, with brittle fractography and no evident plastic deformation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
