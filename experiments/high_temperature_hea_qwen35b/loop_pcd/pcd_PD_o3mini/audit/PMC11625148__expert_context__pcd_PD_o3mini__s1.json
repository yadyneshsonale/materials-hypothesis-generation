      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will exhibit a reduced yield drop relative to untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will accumulate fewer stable irradiation-induced defect clusters than untreated NbMoTaW.",
