        "PMC5171798::web::016::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Altered defect-migration pathways can increase vacancy–interstitial recombination and reduce retained irradiation damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5171798::web::016::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-modified alloy will have greater room-temperature uniform elongation than untreated NbMoTaW.",
