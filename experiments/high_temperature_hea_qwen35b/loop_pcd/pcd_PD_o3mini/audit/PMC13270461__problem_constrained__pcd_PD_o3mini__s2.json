      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Limiting oxide formation in reducing or inert atmospheres delays or prevents catastrophic failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
