      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Catastrophic failure of this alloy is governed by formation of a brittle, poorly adherent oxide scale in oxidizing atmospheres.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing or inert atmospheres limit oxide formation relative to strongly oxidizing atmospheres.",
