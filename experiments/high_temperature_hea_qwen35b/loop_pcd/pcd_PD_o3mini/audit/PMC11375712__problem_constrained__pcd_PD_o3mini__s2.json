      "supporting_ids": [
        "PMC11426066::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ordering-associated lattice distortions enhance intrinsic magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanoscale ordered regions act as domain-wall pinning sites.",
