      "support": "partial",
      "supporting_ids": [
        "PMC11267332::web::025::long_range_ordering_process",
        "PMC11426066::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing will increase coercivity from below 100 Oe to several hundred Oe.",
