  "claims": [
    {
      "text": "Single-phase fcc FeCoNi or a closely related high-entropy derivative typically has coercivity below 100 Oe and high saturation magnetization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high saturation magnetization and low coercivity of the baseline alloy are associated with its high lattice symmetry.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature annealing can induce nanoscale short-range chemical ordering in an otherwise disordered fcc FeCoNi-based matrix.",
