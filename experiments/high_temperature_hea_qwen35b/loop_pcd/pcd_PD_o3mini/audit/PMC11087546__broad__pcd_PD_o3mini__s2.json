      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fine L12 precipitates strengthen Al0.7CoCrFeNi through an Orowan dislocation bowing and bypass mechanism.",
