  "claims": [
    {
      "text": "NbTaTiV is a body-centered-cubic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Ta content in NbTaTiV increases lattice misfit.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing lattice misfit promotes a transition from screw-dominated to edge-dominated dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The screw-to-edge transition enhances dislocation pinning and impedes dislocation mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater resistance from edge dislocations increases the strength of NbTaTiV.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract",
        "PMC11206460::web::025::characterization_of_mobile_dislocations_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Greater resistance from edge dislocations increases the hardness of NbTaTiV.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The balanced baseline NbTaTiV composition contains approximately 25 at.% Ta.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline NbTaTiV alloy has mixed or predominantly screw dislocation character.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing Ta from approximately 25 at.% to approximately 10 at.% modulates lattice misfit.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Ta destabilizes screw-dislocation cores and favors edge-dislocation cores.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Edge dislocations control plasticity in NbTaTiV at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract",
        "PMC11206460::web::025::characterization_of_mobile_dislocations_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ta-reduced NbTaTiV alloys will have a greater proportion of edge dislocations than the approximately 25 at.% Ta baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ta-reduced NbTaTiV alloys will have higher yield strength than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ta-reduced NbTaTiV alloys will have higher hardness than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The approximately 25 at.% Ta baseline has lower hardness and yield strength because it has mixed or predominantly screw dislocation behavior.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should hold while Ta is varied from approximately 25 at.% to 10 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outside the proposed Ta range, secondary-phase formation or alloy instability may obscure the lattice-misfit effect.",
      "field": "boundary",
      "needs_support": true,
