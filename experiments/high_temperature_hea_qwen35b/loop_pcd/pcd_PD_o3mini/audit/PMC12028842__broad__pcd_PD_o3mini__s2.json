  "claims": [
    {
      "text": "Ti-6Al-4V has comparatively low surface hardness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti-6Al-4V has comparatively low wear resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Plasma nitriding Ti-6Al-4V in a nitrogen/hydrogen plasma at approximately 500°C for several hours will form a uniform, thin surface compound layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nitrided surface layer will comprise TiN and a nitrogen-enriched alpha phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitrogen diffuses into the Ti-6Al-4V surface during plasma nitriding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diffused nitrogen forms hard, thermodynamically stable TiN precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiN precipitates impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation motion increases surface hardness and limits plastic deformation during wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma nitriding will increase Ti-6Al-4V surface hardness by approximately 50% relative to untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma nitriding will significantly reduce the wear rate of Ti-6Al-4V relative to untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear improvement will occur under sliding and abrasive conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced properties will hold under moderate-to-high-load dry sliding or cyclic wear at ambient temperature.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Over-nitriding can compromise the alloy's ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitriding depth and treatment duration must be optimized to avoid brittleness.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of hardness and wear improvement varies with plasma-nitriding processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extensive literature supports plasma nitriding as a means to improve the hardness and wear resistance of titanium alloys.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated Ti-6Al-4V has lower hardness and higher wear rates during cyclic and sliding wear tests than the proposed nitrided alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    }
