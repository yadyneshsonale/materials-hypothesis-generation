  "claims": [
    {
      "text": "As-received Q235 low-carbon steel typically has a ferrite-pearlite microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing Q235 at 650°C for 1 hour followed by rapid quenching will refine its grain size and increase grain-boundary density.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The specified annealing and quenching treatment will modify carbide precipitation in Q235 steel.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased grain-boundary density provides more nucleation sites for formation of an oxide passivation layer.",
