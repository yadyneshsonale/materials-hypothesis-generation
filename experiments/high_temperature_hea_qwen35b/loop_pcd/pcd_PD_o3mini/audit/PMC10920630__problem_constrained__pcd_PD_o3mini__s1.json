      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased grain-boundary density can facilitate faster diffusion of corrosive species and accelerate degradation when carbide dispersion is suboptimal.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed passivation film will protect Q235 steel in 3.5 wt.% NaCl during cyclic immersion at both 25°C and 70°C.",
      "field": "conditions",
      "needs_support": true,
