      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744552::web::015::3_3_1_potentiodynamic_polarization_test"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain refinement promotes formation of a thicker and less defective passivation film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744552::web::015::3_3_1_potentiodynamic_polarization_test"
      ],
      "same_system": "no"
    },
    {
      "text": "An optimal carbide dispersion promotes a coherent and uniform protective Fe-oxide film on Q235 steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
