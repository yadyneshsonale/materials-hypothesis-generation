      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniform, adherent oxide or corrosion-product film retards ingress or attack by aggressive chloride ions.",
