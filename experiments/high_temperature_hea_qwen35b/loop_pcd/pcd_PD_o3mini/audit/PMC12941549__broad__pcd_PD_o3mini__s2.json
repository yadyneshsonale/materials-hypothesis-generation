  "claims": [
    {
      "text": "Ti65(AlCrNbV)28Zr7 is a lightweight alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9506522::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast Ti65(AlCrNbV)28Zr7 alloy has a single BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9506522::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A relevant thermomechanical route consists of 50% hot rolling followed by 70% cold rolling and rapid annealing.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9506522::web::004::1_introduction",
        "PMC9506522::web::006::2_2_thermomechanical_treatment"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid annealing can be performed with a heating rate of approximately 15 K/s and durations of 30–50 seconds.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9506522::web::006::2_2_thermomechanical_treatment"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid annealing at approximately 850 °C is an appropriate condition for the proposed route.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precisely tuning the thermomechanical processing parameters produces an optimized bimodal grain-size distribution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed bimodal structure contains both fine-grained and coarse-grained fractions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The fine-grained fraction provides strength through enhanced dislocation activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coarse-grained fraction preserves ductility and avoids inverse Hall–Petch effects.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The bimodal structure stabilizes or beneficially controls grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stable grain boundaries reduce pathways for oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen ingress improves high-temperature oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed grain-boundary mechanism also improves corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed alloy should exceed 1200 MPa yield strength and improve upon the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::000::abstract",
        "PMC9506522::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy should exhibit ductility above 15% and enhanced ductility relative to the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy should exhibit lower oxidation weight gain or lower corrosion penetration than the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive grain refinement causes intergranular oxidation and a loss of oxidation resistance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal treatments that disturb phase stability cause the proposed performance relationship to cease to hold.",
      "field": "boundary",
