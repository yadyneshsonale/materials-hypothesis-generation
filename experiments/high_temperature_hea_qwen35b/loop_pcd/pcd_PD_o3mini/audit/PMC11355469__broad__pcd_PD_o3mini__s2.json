  "claims": [
    {
      "text": "Wear performance of equiatomic CoCrFeMnNi coatings is governed by formation of a continuous oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear-relevant oxide scale is nanocrystalline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An optimally developed oxide scale minimizes friction and material removal during wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing ambient oxygen partial pressure during sliding can tailor in situ oxide-scale formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::018::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equiatomic CoCrFeMnNi develops a compositionally layered oxide under oxygen exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::018::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Moderate oxygen partial pressure during room-temperature wear produces a continuous oxide layer with an optimal thickness and composition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Element-specific oxidation behavior in CoCrFeMnNi determines the compositionally differentiated oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::018::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide scale has self-healing characteristics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale spreads applied wear loads.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal oxide layer lowers interfacial shear and thereby reduces friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal oxide layer decreases the rate of material removal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert atmosphere produces insufficient protective oxidation relative to moderately oxidizing conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessively oxidizing conditions produce a brittle oxide that performs worse than an optimally developed oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderately oxidizing conditions will yield lower friction coefficients than the inert-atmosphere baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderately oxidizing conditions will yield lower wear rates than the inert-atmosphere baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimal protective oxide formation occurs during inert-atmosphere wear testing.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship applies to equiatomic CoCrFeMnNi coatings under room-temperature, moderate-load wear.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relationship may cease to apply at extreme temperatures, very high loads, or substantially different compositions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lack of correlation between oxide-scale properties and improved friction or wear would falsify the hypothesis.",
