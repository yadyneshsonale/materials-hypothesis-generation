  "claims": [
    {
      "text": "The starting material is nanocrystalline W38Ta36Cr15V11 produced by powder metallurgy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a high density of grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain boundaries in the starting alloy foster Cr/V segregation and radiation-induced precipitation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Approximately 1 at% Hf can be incorporated into W38Ta36Cr15V11 during alloy synthesis.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::025::fabrication_of_the_w_ta_cr_v_hf_alloy"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 1 at% Hf will produce Hf-enriched grain-boundary segregation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf has a strong affinity for grain boundaries in this alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary Hf will reduce the mobility and diffusion of Cr and V along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr/V mobility will suppress nucleation and growth of irradiation-induced Cr/V-rich precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf segregation will still permit grain boundaries to operate as effective irradiation-defect sinks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At approximately 8 dpa, Hf doping will reduce the volume fraction of irradiation-induced Cr/V precipitates by more than 70% relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-doped alloy will retain negligible irradiation hardening, with a hardness increase of only about 1–2 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Hf addition will improve processing scalability through conventional sintering.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified nanocrystalline W38Ta36Cr15V11 develops substantial Cr/V-rich precipitation under irradiation.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Unmodified nanocrystalline W38Ta36Cr15V11 exhibits only slight or near-negligible irradiation hardening.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Radiation-induced precipitation in the unmodified alloy limits its bulk-processing potential.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Hf effect applies between 500 and 700 °C and up to approximately 8 dpa.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sintering or annealing above 700 °C would cause detrimental grain coarsening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-rich secondary phases may form and compromise mechanical properties if Hf is not tightly controlled.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
