      ],
      "same_system": "unclear"
    },
    {
      "text": "A maintained Al2O3 scale will protect the alloy in both oxygen-rich and corrosive atmospheres.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Low-Al CrFeCoNi alloys or CrFeCoNi alloys in which Al is replaced by Mn or Si will not form a protective Al2O3 barrier.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
