      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al2O3 scale has a close thermal-expansion match with the CrFeCoNiAl metallic substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow scale growth and thermal-expansion compatibility minimize interfacial stress buildup.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms",
        "PMC6719109::web::055::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Minimizing interfacial stress prevents oxide-scale cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms",
        "PMC6719109::web::055::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "no"
    },
    {
      "text": "High Al content suppresses the formation of competing oxides in CrFeCoNiAl.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
