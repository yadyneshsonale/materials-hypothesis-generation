      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC6719109::web::055::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "unclear"
    },
    {
