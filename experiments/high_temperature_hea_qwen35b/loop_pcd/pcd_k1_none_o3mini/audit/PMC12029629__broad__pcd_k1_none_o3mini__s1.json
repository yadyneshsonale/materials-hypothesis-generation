      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO-promoted samples will have a higher dynamic strain-hardening rate than homogenized samples with minimal SRO.",
