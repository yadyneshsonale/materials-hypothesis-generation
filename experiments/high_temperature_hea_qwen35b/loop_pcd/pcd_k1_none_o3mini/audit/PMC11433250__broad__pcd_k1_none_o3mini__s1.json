  "claims": [
    {
      "text": "Adding 1–3 wt% lanthanum to TiB2 will promote formation of a LaAlO3 surface scale during molten-aluminum exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LaAlO3 scale formed on lanthanum-doped TiB2 will be continuous and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 700°C, lanthanum will diffuse to the TiB2 component surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface lanthanum will react with aluminum and ambient oxygen to form LaAlO3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting LaAlO3 oxide will be stable under the stated operating conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LaAlO3 scale will act as a barrier between TiB2 and molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LaAlO3 barrier will reduce wetting of the component by molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LaAlO3 barrier will reduce penetration of molten aluminum into the component.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LaAlO3 barrier will reduce corrosive attack relative to undoped TiB2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lanthanum-doped TiB2 will show more than a 50% decrease in corrosion penetration depth or mass loss relative to pure TiB2 under identical exposure conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduction in corrosion will improve component longevity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is expected to remain effective at approximately 700°C over standard industrial hot-dip aluminum-plating exposure times.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may be less effective when the oxide scale is discontinuous.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may be less effective outside the stated temperature and exposure-time range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
