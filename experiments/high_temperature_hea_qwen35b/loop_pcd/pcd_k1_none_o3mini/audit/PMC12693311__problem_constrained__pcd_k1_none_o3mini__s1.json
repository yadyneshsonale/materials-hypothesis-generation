      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess boron or an inhomogeneous boron distribution could introduce alternative crystallization pathways.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Departures from the specified cooling and reheating boundaries may reduce amorphous retention and alter crystallization behavior.",
