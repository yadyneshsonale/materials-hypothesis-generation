  "claims": [
    {
      "text": "The starting AlCoCrFeNi2.1 eutectic high-entropy alloy has a uniform, fine lamellar structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy is produced by vacuum induction melting and standard homogenization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy does not provide adequate high-temperature performance, long-term mechanical stability, creep resistance, and corrosion performance for demanding aerospace applications.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.5–1 at.% Y during melting and aging at 800–900°C will produce fine Y2O3 nanoprecipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Y2O3 nanoprecipitates will be uniformly distributed at grain boundaries and lamellar interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y introduced during melting will react in situ to form Y2O3.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Systematic control of aging time and temperature can maintain dispersoid fineness and prevent coarsening or aggregation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 dispersoids obstruct dislocation motion and thereby provide precipitation or dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 dispersoids obstruct grain-boundary migration and inhibit microstructural coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pinning of grain boundaries and lamellar interfaces by Y2O3 dispersoids will retard creep deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 dispersoids will disrupt localized corrosion pathways.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will increase yield strength relative to the starting alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will improve creep resistance at room and elevated temperatures relative to the starting alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will improve corrosion resistance relative to the starting alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will maintain or modestly improve ductility through microstructural refinement and controlled dispersoid distribution.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger reactive-element additions may cause dispersoid coarsening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersoid coarsening or aggregation may cause embrittlement and reduce ductility retention.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-dispersion strengthening is well supported in alloy systems similar to AlCoCrFeNi2.1.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
