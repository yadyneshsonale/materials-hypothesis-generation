      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated nickel-based superalloys undergo thermally induced microstructural degradation in aggressive environments.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A roughly 100 μm multilayer ceramic coating can be deposited on the superalloy by PVD.",
