      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating consists of an intermediate alumina bond layer and a top yttria-stabilized zirconia layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
