    {
      "text": "Greater curvature in smaller FeNiCrCoCu nanoparticles destabilizes the solid state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Smaller FeNiCrCoCu nanoparticles undergo premelting and melting earlier than larger particles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Smaller nanoparticles have a greater fraction of atoms at or near the surface.",
