  "claims": [
    {
      "text": "A sub-micron to micron-thick hafnium coating on zirconium-alloy nuclear-fuel cladding will improve resistance to high-temperature oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A sub-micron to micron coating thickness is sufficient to provide the proposed protection.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure at approximately 1600 °C for up to five hours will induce interdiffusion between the hafnium coating and zirconium-alloy cladding.",
      "field": "hypothesis; conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Zirconium will diffuse from the cladding into the hafnium coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Interdiffusion will form an Hf-Zr alloy transition layer at the coating/substrate interface.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-Zr transition layer will act as an effective barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen diffusion through the Hf-Zr transition layer will retard oxidation kinetics relative to bare zirconium-alloy cladding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hafnium-coated cladding will have significantly lower oxide weight gain than uncoated cladding under identical oxidation conditions.",
      "field": "hypothesis; predicted_outcome; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Uncoated zirconium-alloy cladding exhibits high oxidation rates at extreme temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hot-press sintering can be used to apply or prepare the proposed hafnium coating on zirconium-alloy cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Sputtering can be used to produce a coating with the proposed protective behavior.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated cladding will maintain the mechanical integrity required for nuclear-fuel cladding service.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hafnium coating and interdiffused layer will remain compatible with nuclear-fuel cladding service conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protection depends on formation of a uniform, well-adhered Hf-Zr transition layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective performance may depend on coating thickness, coating uniformity, and processing parameters.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term stability under thermal cycling and irradiation, and the effect on cladding integrity over a fuel cycle, remain unevaluated.",
      "field": "boundary; uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
