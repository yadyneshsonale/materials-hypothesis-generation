    {
      "text": "Suppressing Cr–Zr interdiffusion will minimize deleterious intermetallic-phase formation at the coating/substrate interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
