      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC3932478::web::019::3_packing_density"
      ],
      "same_system": "no"
    },
    {
      "text": "A roughly 100 nm CrN interlayer will act as an effective barrier to Cr–Zr interdiffusion.",
