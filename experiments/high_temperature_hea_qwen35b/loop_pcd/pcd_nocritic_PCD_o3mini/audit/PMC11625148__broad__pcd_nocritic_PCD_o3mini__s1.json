      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain irradiation resistance, indicated by minimal defect-cluster evolution comparable to the undoped alloy.",
