  "claims": [
    {
      "text": "The baseline alloy has the nominal composition Cr16Mn16Fe16Co16Ni16P20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::008::2_materials_and_methods"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr16Mn16Fe16Co16Ni16P20 has a complicated thermal response and limited amorphous retention under rapid cooling.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::020::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 2 at% Mn will be replaced by Zr, giving an approximate modified composition of Cr16Mn14Fe16Co16Ni16P20Zr2.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt spinning at cooling rates of approximately 10^5–10^6 K/s can produce an amorphous Cr16Mn16Fe16Co16Ni16P20 ribbon.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::010::2_materials_and_methods",
        "PMC11642357::web::018::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will be reheated by DSC at 20 K/min in an inert atmosphere.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::008::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing Mn with larger Zr atoms will increase atomic-size mismatch and local lattice strain in this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic-radius mismatch disrupts the regular atomic packing needed for crystalline-phase formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Zr substitution will increase local chemical disorder and disturb regular atomic packing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation",
        "PMC11642357::web::016::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The increased mismatch and packing disruption will elevate the nucleation barrier and impede crystal nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic-size mismatch can increase melt viscosity and impede the diffusion and atomic rearrangement required for crystal growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Zr-induced effects will hinder atomic rearrangement during both cooling and subsequent reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Zr-modified alloy will retain a more robust amorphous structure than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-modified alloy will have a lower critical cooling rate for amorphous formation than Cr16Mn16Fe16Co16Ni16P20.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-modified alloy will have a higher DSC crystallization-onset temperature than Cr16Mn16Fe16Co16Ni16P20.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling favors crystallization and may prevent the Zr intervention from producing an amorphous structure.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating substantially faster than 20 K/min may overwhelm the stabilizing effect attributed to Zr-induced lattice strain.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline Cr16Mn16Fe16Co16Ni16P20 alloy has an earlier crystallization onset during reheating than the proposed Zr-modified alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison using XRD, TEM, DSC, and critical-cooling-rate measurements can test amorphous retention and reheating stability in the baseline and modified alloys.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::018::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Failure to obtain a statistically significant increase in crystallization-onset temperature or a decrease in critical cooling rate will falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
