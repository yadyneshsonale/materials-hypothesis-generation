  "claims": [
    {
      "text": "Al0.7CoCrFeNi is an eutectic high-entropy alloy with a lamellar fcc+B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast Al0.7CoCrFeNi baseline lacks L12 precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging the as-cast alloy at 450–500 °C for 1 hour followed by water quenching will form L12 precipitates in the fcc phase.",
