      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The L12 precipitates produced by the proposed treatment will be nanoscale and coherent.",
