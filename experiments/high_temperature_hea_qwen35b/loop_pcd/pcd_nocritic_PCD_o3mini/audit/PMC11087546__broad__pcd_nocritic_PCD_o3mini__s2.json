  "claims": [
    {
      "text": "As-cast Al0.7CoCrFeNi has a lamellar dual-phase fcc + B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging Al0.7CoCrFeNi at approximately 500–600 °C for 1–2 hours will preserve its eutectic lamellar structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aging treatment should be applied immediately after casting.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature aging produces ordered L12 precipitates within the fcc lamellae of Al0.7CoCrFeNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting L12 precipitates are fine, coherent, and uniformly dispersed within the fcc phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::029::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "L12 precipitates strengthen the alloy by obstructing dislocation motion through Orowan bowing and bypass.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::029::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "L12 precipitation promotes enhanced dislocation storage at phase interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::029::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced interfacial dislocation storage improves strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::029::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The remaining fcc matrix sustains plasticity sufficiently to maintain or enhance tensile ductility after precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature L12 precipitation increases the tensile yield strength of Al0.7CoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the as-cast baseline, aging will increase yield strength by approximately 15–20%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aged alloy may have a higher ultimate tensile strength than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aged alloy will have ductility comparable to or slightly better than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior evidence indicates that L12 precipitation can reduce elongation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516913::web::011::3_2_1_quasi_static_tensile_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The expected simultaneous improvement is limited to room-temperature quasi-static tensile loading at approximately 10^-3 s^-1.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert atmosphere is needed during aging to avoid oxidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An aged group and an identically cast untreated control can test the intervention's causal effect.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain at least a 15% yield-strength increase, or a ductility loss greater than 10% without compensatory strain-hardening benefits, would reject the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
