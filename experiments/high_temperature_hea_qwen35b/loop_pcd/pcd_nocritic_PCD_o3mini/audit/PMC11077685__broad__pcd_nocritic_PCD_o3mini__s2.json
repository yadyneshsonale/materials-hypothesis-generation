      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::001::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "HfO2 has a high melting point and excellent oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A dense HfO2 barrier minimizes inward oxygen diffusion and oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::001::abstract",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HfO2 barrier preserves surface integrity and suppresses surface pulverization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::001::abstract",
        "PMC10488483::web::013::3_results_and_discussion",
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The barrier limits detrimental oxide-scale growth that can cause spallation and mechanical degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
