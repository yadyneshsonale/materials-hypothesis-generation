      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applying a thin sputtered HfO2 coating will improve the high-temperature oxygen resistance of refractory HEAs.",
      "field": "hypothesis",
