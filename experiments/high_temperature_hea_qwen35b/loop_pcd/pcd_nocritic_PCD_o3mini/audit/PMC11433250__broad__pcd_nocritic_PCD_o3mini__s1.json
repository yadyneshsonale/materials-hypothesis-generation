{
  "run_id": "PMC11433250__broad__pcd_nocritic_PCD_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The intervention is to add 0.5–2 at.% yttrium to (TiZrHfTaNb)B2-type high-entropy boride components.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The synthesis process will distribute the added yttrium uniformly throughout the boride.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium will segregate to the component surface during high-temperature exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-segregated yttrium will produce a continuous yttrium-aluminate layer during exposure to molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium will react with trace oxygen or residual aluminum oxide to form a Y–Al–O scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Y–Al–O scale will be thermodynamically stable and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous Y–Al–O scale will act as a diffusion barrier to molten-aluminum penetration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Yttrium-doped high-entropy borides will corrode more slowly in molten aluminum than otherwise identical undoped borides.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Yttrium-doped samples will exhibit less weight loss than undoped samples after molten-aluminum exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium-doped samples will exhibit shallower corrosion depths and more intact oxide scales than undoped samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped Ti-Zr-Hf-Ta-Nb high-entropy diborides can be chemically homogeneous and single-phase after mechanical alloying and spark plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10608203::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "An undoped high-entropy diboride closely related to the proposed composition can be fabricated by reactive spark plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10608203::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective effect will remain effective under molten-aluminum hot-dip plating conditions at approximately 700–750 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal yttrium concentration is within 0.5–2 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium concentrations outside 0.5–2 at.% may reduce protective-scale effectiveness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substantially different environmental oxygen levels may reduce Y–Al–O scale formation or effectiveness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reactive-element effects in high-temperature oxides provide prior support for the proposed mechanism.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A lack of statistically significant reduction in corrosion rate, weight loss, or corrosion depth relative to an undoped control would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
