  "claims": [
    {
      "text": "The starting material is an unoxidized NbTaTiAlV-based refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a multiphase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled pre-oxidation in a low-oxygen atmosphere will form a protective oxide layer on the alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed film will be thin, coherent, adherent, alumina-rich, and predominantly Al2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An Al2O3 scale can act as a barrier to oxygen penetration because of its low ionic diffusivity and slow growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidation step initiates nucleation and growth of a protective oxide scale that passivates the surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed oxide barrier will decrease inward oxygen diffusion during prolonged high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Decreasing inward oxygen diffusion will reduce oxidation kinetics and mass gain.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction",
        "PMC6513993::web::009::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation should produce lower overall weight gain than direct exposure of an untreated alloy at 1000°C for 100 hours in static air.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation should improve oxide-scale stability relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbTaTiAlV-based refractory alloy typically develops a less uniform and less protective oxide scale during direct high-temperature air exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::web::009::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed pre-oxidation treatment is 800°C for 30 minutes in 0.1 atm O2 balanced with inert gas.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The claimed operating window is approximately 1000°C in air.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Effectiveness at substantially higher temperatures or under cyclic thermal conditions is undetermined.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant reduction in weight gain and improved scale stability relative to untreated controls would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
