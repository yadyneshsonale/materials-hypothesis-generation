  "claims": [
    {
      "text": "The initial AlCoFeNi alloy has a homogeneous, Co-rich, single B2 phase as produced by conventional synthesis.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention replaces approximately half of the Co in AlCoFeNi with Cr, giving AlCo0.5Cr0.5FeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing half of the Co with Cr increases the tendency of the alloy to separate into B2 and disordered BCC phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing at approximately 700–900 °C will facilitate the proposed B2/BCC phase separation.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will contain nano- to microscale compositionally distinct regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compositionally distinct regions will specifically be Cr-rich and antiferromagnetic within a predominantly ferromagnetic matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::020::microhardness_and_magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cr promotes phase decomposition during annealing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-rich antiferromagnetic regions act as magnetic domain-wall pinning centers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed pinning centers hinder domain-wall motion and thereby increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "AlCo0.5Cr0.5FeNi will have a higher coercive field than identically processed AlCoFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::020::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing half of the Co with Cr may reduce saturation magnetization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::020::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The saturation magnetization reduction associated with this substitution can exceed 50%.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::020::microhardness_and_magnetic_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Extreme annealing temperatures or processing routes that suppress the desired decomposition may diminish or eliminate the coercivity increase.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::020::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The effect should extend to AlCoFeNi-based alloys with similar thermodynamic tendencies toward phase decomposition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant coercivity increase in matched Cr-substituted samples would falsify the directional prediction.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the Cr substitution to produce the anticipated phase separation would falsify the proposed intervention-to-microstructure link.",
      "field": "falsification_experiment.falsification_rule",
