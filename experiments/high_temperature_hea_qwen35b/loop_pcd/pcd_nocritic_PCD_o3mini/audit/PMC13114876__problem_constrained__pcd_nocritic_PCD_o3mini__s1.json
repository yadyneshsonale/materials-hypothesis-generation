  "claims": [
    {
      "text": "The proposed AlCoCrFeNiTi alloy variant is a eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An AlCoCrFeNiTi variant can possess a multiphase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::web::013::4_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy can form a continuous protective oxide film during high-temperature exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech",
        "PMC11173417::web::029::3_4_corrosion_resistance_of_investigated"
      ],
      "same_system": "no"
    },
    {
      "text": "The integrity of the thermally induced oxide film mediates coupled wear-corrosion degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech",
        "PMC11173417::web::029::3_4_corrosion_resistance_of_investigated"
      ],
      "same_system": "no"
    },
    {
      "text": "Cyclic oscillatory loading repeatedly ruptures and spalls the protective oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
      "text": "The disrupted oxide film repeatedly reforms between loading events.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-film disruption exposes fresh, initially unoxidized metallic substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
      "text": "Exposure of fresh substrate accelerates mechanical wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
      "text": "Exposure of fresh substrate accelerates corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mutually enhanced wear and corrosion create a positive feedback loop that accelerates total degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Steady sliding favors a more uniform and adherent oxide film than oscillatory loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison uses steady sliding and approximately 5 Hz oscillatory sliding at 600 °C while holding the normal load, alloy, and environment constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oscillatory loading will cause greater total degradation than the steady-sliding baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oscillatory loading will increase wear-debris generation and produce deeper, broader, and higher-volume wear tracks.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oscillatory loading will increase corrosion current density and localized corrosion at oxide-rupture sites.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed phenomenon is bounded to an oxidizing ambient-air environment at 600 °C with a controlled dilute-NaCl electrolyte exposure.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural heterogeneity and environmental variation may modulate oxide failure and the magnitude of degradation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::015::remarkable_wear_resistance_and_wear_mech",
        "PMC7515071::web::013::4_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Failure of cyclic loading to produce statistically significant increases in oxide disruption, wear-track damage, and corrosion rate relative to the baseline would reject the proposed mechanism.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
