      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The overlayer will be enriched in selective elements such as Cr and Mn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
