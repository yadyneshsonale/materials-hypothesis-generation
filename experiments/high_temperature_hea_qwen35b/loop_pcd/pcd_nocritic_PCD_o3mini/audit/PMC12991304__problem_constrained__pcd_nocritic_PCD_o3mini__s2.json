      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide overlayer will act as a barrier that limits dissolution of less noble elements.",
