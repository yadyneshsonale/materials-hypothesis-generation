      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12257736::web::029::conclusion",
        "PMC6908586::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide overlayer will limit catalyst sintering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide overlayer will facilitate dynamic oxygen exchange.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide overlayer will protect active sites from poisoning by H2O and NO.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will reduce degradation during thermal aging and preserve catalyst structural integrity.",
