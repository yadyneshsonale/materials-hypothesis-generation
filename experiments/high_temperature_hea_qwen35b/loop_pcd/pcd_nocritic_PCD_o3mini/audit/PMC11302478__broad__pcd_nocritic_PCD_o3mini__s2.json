      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::000::abstract",
        "PMC10041143::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing the degree of local chemical order necessarily increases the magnitude of spatial shear-fault-energy fluctuations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::000::abstract",
        "PMC10041143::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sites with high local shear-fault energy associated with hard atomic motifs pin gliding dislocations.",
