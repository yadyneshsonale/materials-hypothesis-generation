      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::028::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Successive local pinning causes dislocations to move along jumpy, wavy, and non-uniform paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC10041143::web::028::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local chemical order raises activation barriers governing dislocation activity through a nanoscale segment-detrapping mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fluctuations in local shear-fault energy constitute a major or prime source of strength in complex concentrated alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC10041143::web::028::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Higher local chemical order should increase the yield strength of annealed NiCoCr relative to a rapidly quenched random baseline.",
