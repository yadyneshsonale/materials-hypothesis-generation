  "claims": [
    {
      "text": "Adding approximately 0.3 wt.% Sc to CoCrFeMnNi nanoalloy promotes formation of an MgZn2-type intermetallic phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The Sc-induced MgZn2-type precipitates form preferentially along grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The intergranular precipitates pin grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate pinning inhibits atomic rearrangements in the nanoalloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc-induced precipitation delays high-temperature phase transitions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::021::3_results_and_discussions",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Treatment at 750–900 K under controlled cooling permits nucleation and growth of Sc-induced grain-boundary precipitates.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc addition causes heterogeneous nucleation of the intergranular precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc-induced intergranular precipitation refines the grain structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The grain-boundary precipitates act as barriers to atomic diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing diffusion and rearrangement retards phase transitions that would otherwise cause chemical and structural destabilization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc-doped CoCrFeMnNi nanoalloys will retain smaller grains than identically treated undoped controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Sc-doped samples will exhibit sharper phase interfaces than undoped samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc-doped samples will have a higher phase-transition onset temperature than undoped controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513013::web::000::abstract",
        "PMC7513013::web::021::3_results_and_discussions",
        "PMC7513013::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
