  "claims": [
    {
      "text": "The as-deposited FeNiCrCoCu coating has a homogeneous composition and microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-deposition thermal oxidation promotes copper segregation to the coating surface.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum"
      ],
      "same_system": "no"
    },
    {
      "text": "The controlled treatment consists of exposure at 600°C under low oxygen partial pressure for approximately one hour.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation treatment produces a thin Cu-rich oxide layer on the coating surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum",
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting Cu-rich oxide layer is adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperature and low oxygen partial pressure, copper selectively migrates toward the surface and oxidizes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cu-rich oxide is lubricious.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribolayer acts as a protective barrier at the sliding interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribolayer limits dislocation motion and microscopic deformation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribolayer governs the coating's overall wear resistance at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxidized coating will have a lower friction coefficient than the unoxidized coating during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxidized coating will have a lower wear rate than the unoxidized coating during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Surface analysis after treatment or sliding will reveal a Cu-rich oxide layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior is expected around 600°C under controlled low oxygen partial pressure.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction",
        "PMC10384371::web::024::4_2_oxidation_in_vacuum"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher oxygen partial pressure or lower temperature may alter oxidation kinetics and layer formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated and as-deposited coatings are to be tested under otherwise identical high-temperature sliding conditions.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction coefficient, wear rate, scar depth, mass loss, and surface oxide composition are measurable comparison variables.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to form a distinct Cu-rich oxide layer together with failure to reduce friction or wear relative to baseline would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
