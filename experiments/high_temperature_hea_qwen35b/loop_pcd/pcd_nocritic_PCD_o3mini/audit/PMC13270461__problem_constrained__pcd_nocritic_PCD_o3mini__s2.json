  "claims": [
    {
      "text": "The starting Al0.2Co1.5CrFeNi1.5Ti0.3 alloy is additively manufactured and has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting FCC matrix is nanocrystalline.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built alloy has an oxide film formed during additive processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidizing exposure produces a continuous surface oxide scale on the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::008::3_2_high_temperature_surface_oxidation_m",
        "PMC9026100::web::020::cross_section_observation_of_oxide_layer"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale contains Al2O3 together with Cr- and Co-rich oxides or spinels.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC9026100::web::020::cross_section_observation_of_oxide_layer"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The composition, compactness, adhesion, and growth behavior of the surface scale govern high-temperature oxidation degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal-expansion mismatch and internal growth stresses generate tensile stress in the oxide scale during prolonged exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The accumulated tensile stress causes oxide-scale cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::008::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "Cracking or spallation exposes underlying metal and accelerates subsequent oxidation degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC8346963::web::008::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxide-scale failure creates localized stress concentrations at the oxide-metal interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial stress concentrations initiate internal microcracks beneath the oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal microcrack formation causes loss of toughness and can culminate in catastrophic failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reducing atmosphere such as 10% H2 in an inert carrier suppresses oxide-scale growth relative to a high-oxygen atmosphere.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing oxide-scale growth delays microcracking and preserves mechanical integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will produce more scale cracking, spallation, subsurface microcracks, and toughness loss than reducing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::008::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing exposure will leave mechanical integrity closer to the as-built baseline than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale formation and failure are kinetically relevant over 900-1100 K and exposure times up to 50 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::008::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    }
  ],
