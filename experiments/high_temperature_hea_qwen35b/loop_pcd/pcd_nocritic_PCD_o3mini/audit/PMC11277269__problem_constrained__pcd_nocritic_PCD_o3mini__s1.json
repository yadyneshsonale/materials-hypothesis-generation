  "claims": [
    {
      "text": "The equiatomic nanoscale PtPdRhRuIrOs baseline is a solid-solution catalyst for ethanol oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8163215::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention reduces Ir by approximately 10% relative to the equiatomic composition while retaining equal proportions of the other five elements.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 10% relative reduction in Ir shifts the alloy d-band center.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Ir changes the local electronic structure of active surface sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8163215::web::002::introduction",
        "PMC8163215::web::012::catalytic_performance_of_her"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The shifted d-band center modifies the adsorption energies of ethanol-oxidation intermediates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changes in intermediate adsorption energies alter the ethanol-oxidation reaction pathway.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alteration of the reaction pathway changes the product distribution and selectivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8163215::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ir-lean catalyst will show a statistically significant product-distribution change relative to the equiatomic catalyst.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The product-distribution change will favor partially oxidized products or reduce over-oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Spectroscopy will detect a d-band-center shift in the Ir-lean catalyst relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HPLC or GC product analysis, together with electrochemical measurements, can determine the predicted selectivity change.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship holds in acidic electrolyte at ambient temperature from 0.3 to 0.9 V versus RHE.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-entropy-alloy surfaces contain heterogeneous active sites with diverse local electronic structures.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8163215::web::002::introduction",
        "PMC8163215::web::012::catalytic_performance_of_her"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A single d-band-center descriptor may be insufficient to explain catalytic behavior in high-entropy alloys.",
      "field": "uncertainty",
