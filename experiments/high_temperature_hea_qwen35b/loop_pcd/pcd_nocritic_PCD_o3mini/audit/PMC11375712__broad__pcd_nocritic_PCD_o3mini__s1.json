  "claims": [
    {
      "text": "AlCoFeNi can exhibit a compositionally homogeneous, single-phase ordered B2 structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co is ferromagnetic and Cr is antiferromagnetic in the context motivating the substitution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Half of the Co in AlCoFeNi can be replaced by Cr to form AlCo0.5Cr0.5FeNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Co with Cr enhances the tendency of AlCoFeNi to undergo phase separation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-substituted alloy forms a two-phase mixture of ordered B2 and disordered BCC phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing throughout 700–1000 °C will ensure emergence of the two-phase microstructure.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The decomposed microstructure contains features spanning fine length scales, including nanometer-scale features.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The fine clusters formed by phase separation are specifically Cr-rich.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-rich phase is antiferromagnetic.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-rich phase introduces exchange bias.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase boundaries and Cr-rich clusters act as domain-wall pinning centers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased domain-wall pinning impedes domain-wall motion and thereby raises the coercive field.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2+BCC decomposition in this alloy family is associated with an increase in coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCo0.5Cr0.5FeNi has a substantially higher coercivity than AlCoFeNi under the investigated conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Higher annealing temperatures can suppress phase decomposition.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive grain growth can diminish the coercivity enhancement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the coercivity increase depends on the degree and length scale of phase separation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnitude of the coercivity increase depends on the distribution of Cr-rich clusters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
