      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boundary-localized L12 precipitates impede the accumulation of dislocations at lamellar interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
