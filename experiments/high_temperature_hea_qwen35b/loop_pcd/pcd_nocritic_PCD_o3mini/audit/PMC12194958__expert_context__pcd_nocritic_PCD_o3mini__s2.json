      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838456::web::027::4_discussion",
        "PMC9329343::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "A change in electron-phonon coupling affects the superconducting gap and coherence length.",
