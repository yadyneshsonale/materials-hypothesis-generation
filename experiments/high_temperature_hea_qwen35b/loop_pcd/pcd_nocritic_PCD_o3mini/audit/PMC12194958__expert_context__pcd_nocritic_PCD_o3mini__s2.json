      ],
      "same_system": "no"
    },
    {
      "text": "Local chemical order governs or modulates the superconducting transition temperature of Ti-Nb-Hf-Zr-V.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Samples will be annealed at 800 °C and 1000 °C for 24 hours in an inert atmosphere.",
