      ],
      "same_system": "no"
    },
    {
      "text": "The ordering-induced change in electron-phonon coupling shifts the critical temperature relative to the disordered baseline.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed samples with moderate local order will exhibit a systematic, measurable change in critical temperature relative to the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical-temperature change will correlate with the measured degree of local chemical order.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
