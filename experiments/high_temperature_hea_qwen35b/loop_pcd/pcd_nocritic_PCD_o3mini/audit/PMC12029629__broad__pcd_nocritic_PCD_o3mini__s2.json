  "claims": [
    {
      "text": "The studied material consists of single-crystalline <110>-oriented CoCrFeNi high-entropy-alloy nanopillars.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Atomic-scale chemical compositional heterogeneity in CoCrFeNi produces wide local variations in generalized stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The stacking-fault-energy variations enable coordinated deformation twinning and dislocation slip.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coordination of deformation twinning and dislocation slip delocalizes plastic deformation and delays necking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Delayed necking from the slip–twinning synergy enables unusually high tensile ductility while retaining high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twinning and dislocation slip are activated simultaneously.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changing nanopillar orientation modulates the relative propensity for slip and twinning.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In situ TEM tensile testing can directly reveal the relevant dislocation and twinning behavior.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reported super-elongation occurs at room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior applies under high-strain-rate tensile loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies in an ultra-high-vacuum environment.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoCrFeNi nanopillars can exhibit uniform tensile elongation of approximately 110%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::000::abstract",
        "PMC10656519::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CoCrFeNi nanopillars can maintain flow stresses of approximately 0.6–1.0 GPa during super-elongation.",
