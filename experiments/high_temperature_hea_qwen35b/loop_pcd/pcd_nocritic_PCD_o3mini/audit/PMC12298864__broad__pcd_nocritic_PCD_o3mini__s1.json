      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The screw-to-edge transition increases yield strength through enhanced resistance to edge-dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11549039::web::000::abstract",
        "PMC11549039::web::019::conclusions"
      ],
      "same_system": "no"
    },
    {
