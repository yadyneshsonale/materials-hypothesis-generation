        "PMC11549039::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Large lattice misfit strengthens edge dislocations more strongly than screw dislocations in BCC concentrated alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11549039::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Edge-dislocation barriers provide enhanced substitutional solid-solution strengthening in refractory high-entropy alloys.",
