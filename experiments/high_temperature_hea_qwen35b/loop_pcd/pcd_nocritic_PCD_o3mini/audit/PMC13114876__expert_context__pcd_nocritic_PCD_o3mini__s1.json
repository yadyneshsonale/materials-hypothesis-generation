  "claims": [
    {
      "text": "Heat-treated CoCrFeMnNi can possess a stable, protective passive oxide film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112909::web::020::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "yes"
    },
    {
      "text": "The passive film on the heat-treated alloy is uniform.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::020::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "yes"
    },
    {
      "text": "The corrosion resistance of CoCrFeMnNi is associated with a Cr-rich passive layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112909::web::004::1_introduction",
        "PMC12112909::web::020::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coupled tribo-corrosion response is governed by mechanical disruption of the passive film during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding periodically removes the passive film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical disruption of the passive film exposes fresh underlying metal to the corrosive environment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure of fresh metal during sliding elevates the corrosion rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Repassivation cannot keep pace with wear-induced film removal under the proposed tribo-corrosion conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear-induced film disruption accelerates corrosion beyond the sum of independent wear and corrosion effects.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tribo-corrosion produces greater total degradation than static corrosion because corrosion loss is superimposed on wear loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhancement is greatest when repassivation is too slow to restore the film between wear cycles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced degradation should not occur if the passive film remains intact or repassivates extremely rapidly.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Static-corrosion specimens maintain an intact passive film.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::020::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed comparison holds electrochemical conditions and exposure duration constant while contrasting sliding in NaCl with static immersion.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted mechanism should hold at moderate sliding speeds and loads that cause partial film disruption.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction may fail at extremely high wear conditions where the passive film is completely removed.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction may fail in highly aggressive environments where passive-film formation is suppressed.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
