  "claims": [
    {
      "text": "The untreated (MnNiSi)0.62(FeCoGe)0.38 alloy is single-phase or nearly single-phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has a high caloric response under applied-field operation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has a high caloric response under pressure-field operation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has poor mechanical integrity and a high tendency to crack.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solutionizing at approximately 1000 °C followed by aging at 450–500 °C for several hours will produce controlled nanoscale precipitation in this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::017::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The heat treatment will produce uniformly distributed precipitates within the primary caloric-active matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::005::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The induced precipitates will constitute a ductile secondary phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale precipitates will act as localized crack arrestors.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale precipitates will redistribute stress in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation can impede dislocation motion and strengthen an alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11469235::web::005::introduction",
        "PMC6478865::web::017::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "no"
    },
    {
      "text": "Combining mechanically distinct phases can improve combinations of strength, ductility, and toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5458502::web::016::retention_of_the_hcp_phase_to_ambient_pr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitate-strengthened microstructure will increase compressive strength by approximately 15–20% relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::017::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment will improve fracture toughness and resistance to cracking.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5458502::web::016::retention_of_the_hcp_phase_to_ambient_pr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitates can be formed without disrupting the matrix magnetostructural transformation responsible for the caloric effect.",
