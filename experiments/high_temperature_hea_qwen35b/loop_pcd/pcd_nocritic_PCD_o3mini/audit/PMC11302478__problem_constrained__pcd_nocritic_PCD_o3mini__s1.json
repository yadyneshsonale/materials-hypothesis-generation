  "claims": [
    {
      "text": "Equiatomic Cr-Mn-Fe-Co-Ni, Cr-Fe-Co-Ni, and Cr-Co-Ni can be compared as single-phase FCC alloys after identical thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The presence of Mn gives equiatomic Cr-Mn-Fe-Co-Ni a distinct stacking-fault energy relative to the Cr-Fe-Co-Ni and Cr-Co-Ni subsets.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn alters electronic structure and interatomic bonding in the quinary alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changes in electronic structure and bonding caused by Mn produce a measurable change in stacking-fault energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault energy depends on composition, alloying elements, and temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stacking-fault energy affects the activation and propagation of partial dislocations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::006::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stacking-fault energy shifts the competition between deformation twinning and dislocation slip.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::006::1_introduction",
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "yes"
    },
    {
      "text": "Low stacking-fault energies can favor martensitic transformation, intermediate values can favor twinning, and high values can favor dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Intensive deformation twinning in equiatomic Co-Cr-Fe-Ni-Mn has been attributed to a stacking-fault energy of 20–30 mJ/m².",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The quinary alloy has an SFE that supports a balance between deformation twinning and dislocation motion.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::006::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-Fe-Co-Ni and Cr-Co-Ni subsets have higher stacking-fault energies than the quinary alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher stacking-fault energy in the quaternary and ternary alloys will reduce deformation twinning and favor conventional dislocation glide.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "no"
    },
    {
      "text": "The SFE-induced change in deformation mode alters work hardening and failure behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed SFE differences will correlate with differences in yield strength, strain-hardening rate, and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation dissociation widths measured by high-resolution TEM can be used to estimate stacking-fault energy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "First-principles calculations can provide generalized stacking-fault-energy curves for Co-Ni-Cr-Fe-Mn.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::021::3_4_role_of_stacking_fault_energy_in_the"
      ],
      "same_system": "yes"
    },
    {
