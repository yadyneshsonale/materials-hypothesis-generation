  "claims": [
    {
      "text": "Adding approximately 2–4 at.% Hf to nanocrystalline W38Ta36Cr15V11 will suppress irradiation-induced Cr/V-rich precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf suppresses precipitation by binding to solute atoms and irradiation-induced defect sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition will preserve the alloy's low irradiation hardening and radiation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A 2–4 at.% Hf addition will preserve practical bulk manufacturability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is nanocrystalline W38Ta36Cr15V11.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy has a uniform grain distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified alloy develops Cr/V-rich precipitates under irradiation near 8 dpa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Hf-modified alloy can be synthesized through powder metallurgy or mechanical alloying.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::006::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed operating boundary is irradiation to approximately 8 dpa at specimen temperatures below 600 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf preferentially diffuses to irradiation-induced defect sites and forms stable bonds with Cr and V.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf segregation reduces the diffusional mobility of Cr and V.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr and V mobility limits their clustering and precipitate nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified W-based alloy shows no irradiation-created dislocation loops after 8 dpa.",
      "field": "supporting_evidence",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The unmodified alloy has an as-deposited hardness of about 14 GPa and near-negligible irradiation hardening.",
      "field": "supporting_evidence",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr- and V-rich second-phase particles occur in the W-based alloy and are predicted by atomistic modeling.",
      "field": "supporting_evidence",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equal point-defect mobilities are the origin of the unmodified alloy's exceptional radiation tolerance.",
      "field": "supporting_evidence",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "After irradiation, the Hf-doped material will show a statistically significant reduction or complete suppression of Cr/V-rich precipitates relative to the undoped control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-doped material will retain hardness near its as-processed value and exhibit minimal irradiation-induced hardening.",
      "field": "predicted_outcome",
