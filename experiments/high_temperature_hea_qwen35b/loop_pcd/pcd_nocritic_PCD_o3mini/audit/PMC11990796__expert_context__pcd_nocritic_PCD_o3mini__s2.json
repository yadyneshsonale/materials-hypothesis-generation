      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will have a room-temperature compressive yield strength near 1700 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
