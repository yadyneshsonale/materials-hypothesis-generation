  "claims": [
    {
      "text": "The starting HfMoNbTaW alloy has a uniform high-entropy microstructure.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has no initial reactive-element segregation.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison uses HfMoNbTaW without Y and HfMoNbTaW with 0.5–2 wt% Y.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation at approximately 1600 °C in air will produce a steady-state oxide scale on these alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy ensures uniform element distribution in the bulk HfMoNbTaW alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "During high-temperature oxidation, kinetic and thermodynamic driving forces cause Y to migrate to the oxide/metal interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Y segregates at the oxide/metal interface during oxidation of HfMoNbTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Y lowers the oxide/metal interfacial energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower oxide/metal interfacial energy enhances oxide-scale adhesion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced interfacial stability reduces oxide-scale cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced spallation ultimately improves oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y-containing alloy will form a more uniform oxide scale than the Y-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-containing alloy will form a more adherent oxide scale than the Y-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-containing alloy will exhibit a lower oxide-scale spallation rate than the Y-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-containing alloy will exhibit slower weight gain during oxidation than the Y-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism is applicable around 1600 °C in air and may behave differently at lower temperatures or in other oxidizing environments.",
      "field": "boundary",
      "needs_support": true,
