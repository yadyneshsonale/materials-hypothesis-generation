  "claims": [
    {
      "text": "The starting nanoparticles have an equimolar CoCrFeMnNi composition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The CoCrFeMnNi nanoparticles are synthesized by ultrafast laser ablation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9064730::web::012::crystal_structure_of_the_laser_generated"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mild low-temperature annealing under an inert atmosphere promotes surface segregation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching retains a homogeneous surface composition.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced surface segregation produces local regions with a high density of atomic-scale defects.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high density of surface defects lowers the activation barrier for atomic mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced barrier increases atomic mobility and initiates premelting.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface segregation causes premelting significantly below the bulk melting point relative to nanoparticles with homogeneous surfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated surface regions contain locally concentrated constituent elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9064730::web::012::crystal_structure_of_the_laser_generated"
      ],
      "same_system": "yes"
    },
    {
      "text": "Element-enriched segregated regions are energetically favorable sites for initiating atomic disorder.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated surfaces undergo a gradual premelting process.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Homogeneously mixed surfaces resist disordering and delay melting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed nanoparticles will form a disordered or quasi-liquid surface layer at a lower temperature than rapidly quenched nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapidly quenched nanoparticles will melt more abruptly and closer to the bulk melting point.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship holds for particles between 3 and 10 nm.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship holds for equimolar compositions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Particle-size distribution, residual impurities, and local stress can modulate the premelting effect.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
