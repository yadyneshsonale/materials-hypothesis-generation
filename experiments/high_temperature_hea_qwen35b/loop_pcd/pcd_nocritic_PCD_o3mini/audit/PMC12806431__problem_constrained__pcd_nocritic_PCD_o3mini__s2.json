      ],
      "same_system": "yes"
    },
    {
      "text": "The initial TiVNbTa alloy contains only minimal or trace oxygen and nitrogen impurities.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "yes"
    },
    {
