        "PMC10708198::web::004::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial impurities encourage nanoscale precipitate formation during aging, including alpha-Ti precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::004::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The impurity-induced precipitates form preferentially along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging depletes strengthening interstitial solutes from the TiVNbTa matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Depletion of interstitial solutes reduces solid-solution strengthening and produces progressive softening with aging.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
