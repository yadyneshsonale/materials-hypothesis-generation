      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of the highly refined near-amorphous layer is linked to high wear resistance and low wear rate.",
