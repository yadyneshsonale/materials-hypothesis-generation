      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The highly refined near-surface structure exhibits inverse Hall–Petch behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
