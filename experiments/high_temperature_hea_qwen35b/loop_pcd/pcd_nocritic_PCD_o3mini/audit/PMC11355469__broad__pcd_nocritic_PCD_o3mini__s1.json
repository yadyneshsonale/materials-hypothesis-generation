        "PMC7311485::web::002::introduction",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Severe plastic deformation and transient heating jointly generate the amorphous surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
