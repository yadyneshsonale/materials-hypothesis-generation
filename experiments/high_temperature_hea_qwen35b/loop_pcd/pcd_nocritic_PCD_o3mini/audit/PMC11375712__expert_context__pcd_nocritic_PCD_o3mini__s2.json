      ],
      "same_system": "no"
    },
    {
      "text": "L10 ordering in the proposed FeCoNi-Pt alloy will enhance magnetocrystalline anisotropy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::003::introduction",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced magnetocrystalline anisotropy will increase coercivity relative to disordered FeCoNi.",
