      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::000::abstract",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The L10 phase has reduced lattice symmetry and chemically ordered sublattices.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::003::introduction",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Strong spin–orbit coupling from Pt, together with reduced L10 symmetry, enhances magnetocrystalline anisotropy.",
