  "claims": [
    {
      "text": "Rapid solidification under identical conditions can produce single-phase metallic solid solutions for all three CrFeCoNiX variants with X = Al, Mn, or Si.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract",
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "The identity of X governs the formation and persistence of the protective oxide on single-phase CrFeCoNiX alloys above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_",
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al has sufficiently high oxygen affinity to promote preferential alumina formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract",
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_",
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Alumina has small deviations from stoichiometry and low point-defect concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Alumina is a low-diffusivity oxygen barrier and grows more slowly than silica at temperatures up to approximately 1300 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An Al-bearing CrFeCoNiX alloy will form alumina during sustained exposure above 900 °C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract",
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina scale formed on the Al-bearing variant will be continuous, dense, coherent, and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-bearing CrFeCoNiX forms an oxide scale with a higher defect density than the Al-bearing variant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-bearing CrFeCoNiX forms an oxide scale with a higher defect density than the Al-bearing variant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxides on the Mn- and Si-bearing variants have thermal-expansion mismatches with their substrates that generate localized stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The localized stresses caused by thermal-expansion mismatch lead to oxide cracking or spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After exposure above 900 °C, the Al-bearing alloy will retain a uniform and stable protective scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_",
        "PMC6804173::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "After exposure above 900 °C, the Mn- and Si-bearing alloys will develop discontinuous, cracked, or spallation-prone scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Holding processing, surface preparation, and exposure conditions constant allows differences in oxide behavior to be attributed solely to X.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies in both oxidative and corrosive atmospheres above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::015::3_4_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "Multiphase material states or thermal cycling may produce behavior different from that predicted for sustained exposure of a single-phase state.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
