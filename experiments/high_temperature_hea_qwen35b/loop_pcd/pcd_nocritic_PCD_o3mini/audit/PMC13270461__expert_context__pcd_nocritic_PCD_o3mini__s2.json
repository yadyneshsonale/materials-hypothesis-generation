  "claims": [
    {
      "text": "Elevated-temperature degradation is primarily governed by formation and eventual breakdown of a transient Al/Ti-rich surface oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9609231::web::002::1_introduction",
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure rapidly forms a thin, protective Al/Ti-rich oxide film on the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial oxide film protects the fcc matrix and preserves its mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9609231::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Prolonged oxidizing exposure causes oxide growth and stress-induced defect formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c",
        "PMC6719109::web::054::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Internal stresses in a growing oxide scale can produce buckling, cracking, porosity, or cavities.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c",
        "PMC6719109::web::054::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Defect development in the oxide causes localized spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cracking or breakdown of the oxide barrier permits inward oxygen transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen ingress causes internal oxidation and loss of mechanical strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing environments inhibit robust formation of the protective oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In reducing gas, absent or incomplete protective-film formation leads to selective internal oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Degradation in reducing gas follows a pathway distinct from oxide-defect evolution in oxidizing gas.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has a homogeneous fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has notable strength and fatigue performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Early oxidizing exposure will produce a thin, well-adherent film accompanied by minimal mechanical-property loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extended oxidizing exposure will produce a thicker, porous or buckled oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c",
        "PMC6719109::web::054::5_2_2_oxidation_at_1200_and_1300_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The extent of oxide-scale defects will correlate with losses in strength and fatigue life.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::039::4_3_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies within 800–900 K and defined oxidizing or reducing gas compositions.",
      "field": "boundary",
