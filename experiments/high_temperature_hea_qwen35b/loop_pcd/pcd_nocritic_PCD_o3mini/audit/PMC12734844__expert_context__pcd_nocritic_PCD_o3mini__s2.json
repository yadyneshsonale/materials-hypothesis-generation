      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid LPBF processing of AlCrFeNiSi inherently promotes residual-stress development.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.5–1 wt% nanoscale Y2O3 by ultrasonic mixing or mechanical alloying can produce LPBF-suitable AlCrFeNiSi feedstock.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7296023::web::003::introduction"
      ],
      "same_system": "no"
    },
