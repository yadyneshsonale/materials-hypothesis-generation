      "support": "partial",
      "supporting_ids": [
        "PMC12114310::web::021::4_2_effect_of_nano_al2o3_on_wear_perform"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Y2O3 nanoparticles act as heterogeneous nucleation sites during solidification of AlCrFeNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 nanoparticles act as grain-boundary pinning centers in AlCrFeNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12114310::web::021::4_2_effect_of_nano_al2o3_on_wear_perform",
        "PMC7296023::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The dispersoids promote a fine, equiaxed AlCrFeNiSi microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12114310::web::021::4_2_effect_of_nano_al2o3_on_wear_perform",
        "PMC7296023::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The dispersoids inhibit excessive grain growth during rapid solidification.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12114310::web::021::4_2_effect_of_nano_al2o3_on_wear_perform"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Y2O3 particles interrupt long-range diffusion during solidification, thereby reducing elemental segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 particles locally impede dislocation motion in LPBF AlCrFeNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed Y2O3 distributes stress more evenly and consequently lowers residual thermal stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12114310::web::021::4_2_effect_of_nano_al2o3_on_wear_perform"
      ],
      "same_system": "unclear"
    },
    {
