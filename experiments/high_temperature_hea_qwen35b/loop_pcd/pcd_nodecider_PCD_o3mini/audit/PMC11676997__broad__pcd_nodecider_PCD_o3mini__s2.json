      "text": "Sigma precipitation improves the high-temperature creep resistance of Ni-modified Al0.8NbTiV.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
