  "claims": [
    {
      "text": "The baseline alloy is equimolar CoCrFeNiTi in an as-cast, single-phase solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add 3–5 at.% Nb while retaining an approximately equimolar CoCrFeNiTi host.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb has sufficient atomic-size mismatch with the host elements to enhance local lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "The Nb-induced lattice distortion produces local elastic strain fields.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb-induced lattice distortions increase solid-solution strengthening by creating barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed solute-induced barriers operate as forest-dislocation pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% Nb will increase the nanoindentation hardness of CoCrFeNiTi relative to the Nb-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% Nb will increase the micro-compression yield strength of CoCrFeNiTi relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "The hardness and yield-strength increases will occur at both room temperature and 600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will retain favorable plasticity if it remains a stable solid solution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "A Nb content of 3–5 at.% is low enough to avoid secondary-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb addition may instead induce secondary phases or ordering that alter deformation and reduce plasticity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC5216361::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis is limited to as-cast solid-solution material tested at temperatures no higher than 600 °C under quasi-static or otherwise controlled strain-rate loading.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An identically processed Nb-free control and Nb-modified alloy, with phase state checked by XRD and TEM, can distinguish the proposed strengthening explanation.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant hardness and yield-strength increase would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of secondary phases that compromises plasticity would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
