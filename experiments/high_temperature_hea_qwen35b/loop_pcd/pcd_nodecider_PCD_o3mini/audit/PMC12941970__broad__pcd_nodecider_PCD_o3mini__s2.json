  "claims": [
    {
      "text": "Untreated additive-manufactured CoCrFeMnNi HEA typically has a relatively coarse, homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-energy shot peening followed by low-temperature annealing can create a nanohierarchical surface layer on CoCrFeMnNi HEA.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered surface layer will be ultrananocrystalline and contain a distribution of nanograins and embedded nanoprecipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Shot peening refines the surface grain structure of CoCrFeMnNi HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing after shot peening induces composition modulation in the treated surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During high-temperature sliding, the engineered CoCrFeMnNi surface layer will evolve into a dense nanocrystalline glaze.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The dense nanocrystalline glaze minimizes adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The dense nanocrystalline glaze suppresses oxidative wear at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "At lower temperatures, the refined surface structure provides lower shear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will reduce coefficient of friction by approximately 30–50% relative to untreated CoCrFeMnNi HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will reduce wear rate by roughly one order of magnitude relative to untreated CoCrFeMnNi HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial tribological effect will remain effective from −100 °C to 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated CoCrFeMnNi HEA has higher friction and wear because its coarse microstructure lacks an adaptive surface layer.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
