  "claims": [
    {
      "text": "A hafnium coating on zirconium-alloy cladding will interdiffuse with the substrate to form an HfZr transition layer.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Physical vapor deposition of a thin hafnium layer will promote the required Hf-Zr interdiffusion.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfZr transition layer creates a chemically bonded or graded interface that improves coating adhesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The HfZr transition layer facilitates formation of a refractory HfO2 scale during oxidation.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::000::abstract",
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Hafnium has a high affinity for oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation of the hafnium coating forms a dense, protective HfO2 layer.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The HfO2 scale is stable and slowly growing at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfO2 scale limits oxygen ingress and deep oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-coated zirconium-alloy cladding will have significantly lower oxidation weight gain than uncoated cladding.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-coated cladding will develop a denser and more protective oxide scale than uncoated cladding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will retain the cladding's mechanical integrity and service performance.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Uncoated zirconium-alloy cladding has greater oxidation weight gain and poorer high-temperature oxidation resistance under comparable conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed benefit should hold after approximately five hours in air or steam at about 1600 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::012::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Hafnium has a relatively high neutron-absorption cross-section that may adversely affect reactor performance.",
      "field": "boundary; uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Careful control of coating thickness and interdiffusion can preserve overall cladding performance in a reactor environment.",
      "field": "boundary",
