      ],
      "same_system": "no"
    },
    {
      "text": "The annealed FeCoNi will contain twin boundaries associated with the nanoscale ordered regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brief high-temperature exposure permits incipient ordering without complete transformation or bulk phase separation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale ordered domains increase magnetocrystalline anisotropy.",
