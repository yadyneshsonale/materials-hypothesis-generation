      "supporting_ids": [
        "PMC11426066::web::000::abstract",
        "PMC11426066::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating equiatomic FeCoNi to approximately 650 °C for about 60 seconds is sufficient to induce the proposed nanoscale order.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
