      "supporting_ids": [
        "PMC11426066::web::000::abstract",
        "PMC11426066::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The nanoscale ordered domains and twin boundaries act as additional domain-wall pinning centers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased magnetocrystalline anisotropy and domain-wall pinning enhance coercivity.",
