      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7956699::web::022::4_2_the_coexistence_of_and_phases"
      ],
      "same_system": "no"
    },
    {
      "text": "The secondary phases may be fine FCC or intermetallic precipitates located at grain boundaries or within microstructural domains.",
