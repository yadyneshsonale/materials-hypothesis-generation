      "support": "partial",
      "supporting_ids": [
        "PMC10056590::web::019::3_3_slow_cooling_of_equiatomic_crmnfecon"
      ],
      "same_system": "no"
    },
    {
      "text": "Slow cooling enhances local elemental segregation, especially segregation involving Al and Cr.",
