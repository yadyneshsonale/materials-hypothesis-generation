      "supporting_ids": [
        "PMC10056590::web::019::3_3_slow_cooling_of_equiatomic_crmnfecon"
      ],
      "same_system": "no"
    },
    {
      "text": "The rapidly quenched baseline approximates a metastable, supersaturated, single-phase BCC structure with minimal diffusion-driven segregation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the rapidly quenched baseline, slowly cooled samples will contain fine secondary-phase precipitates.",
