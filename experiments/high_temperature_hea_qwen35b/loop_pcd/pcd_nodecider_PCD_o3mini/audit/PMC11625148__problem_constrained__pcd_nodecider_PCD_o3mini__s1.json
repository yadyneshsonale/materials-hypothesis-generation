  "claims": [
    {
      "text": "Equal-atomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbMoTaW has excellent high-temperature mechanical properties.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5171798::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbMoTaW exhibits approximately 2% room-temperature compressive plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of approximately 3–5 at% Ti to equal-atomic NbMoTaW.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti is an HCP-favoring, ductilizing element in the proposed NbMoTaW composition range.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at% Ti will create localized lattice distortions, slight chemical heterogeneity, modified dislocation cores, and incipient HCP-like local character.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5171798::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-induced local HCP-like regions and lattice distortions will reduce the Peierls barrier for dislocation motion at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing the Peierls barrier will facilitate room-temperature plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 3–5 at% Ti alloy will have greater room-temperature plastic strain and toughness than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 3–5 at% Ti addition will preserve overall BCC matrix stability at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1600 °C, the 3–5 at% Ti alloy will retain the high mechanical strength of untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5171798::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti addition will leave irradiation-induced defect dynamics and irradiation resistance largely unaffected relative to untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5171798::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Induction melting followed by annealing at about 850 °C for 30–60 seconds and quenching will produce a uniform BCC solid solution.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti concentrations above the proposed 3–5 at% range may produce unwanted HCP phases or precipitates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HCP phases or precipitates caused by higher Ti concentrations may degrade high-temperature mechanical performance and irradiation resistance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
