        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Irradiation of W38Ta36Cr15V11 to approximately 8 dpa results in Cr-V-rich precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The irradiation-associated Cr-V-rich precipitates are approximately 3–5 nm in size.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-V-rich precipitate density is approximately 0.03 nm−2.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W38Ta36Cr15V11 exhibits only slight irradiation-induced hardening at approximately 8 dpa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy has desirable radiation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Cr from 15 at% to 12 at% and adding 3 at% Hf produces W38Ta36Cr12Hf3V11.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3 at% Hf will stabilize the alloy's solid-solution matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Hf will occupy sites formerly occupied by Cr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf has a higher melting point than Cr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf has lower diffusivity than Cr under the relevant alloy and irradiation conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition will reduce the mobility of Cr and V atoms in W38Ta36Cr12Hf3V11.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr and V mobility will hinder their clustering and the nucleation of Cr-V-rich precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At doses up to 8 dpa and specimen temperatures up to 500 °C, W38Ta36Cr12Hf3V11 will have negligible or significantly fewer Cr-V-rich precipitates than W38Ta36Cr15V11.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will exhibit irradiation-induced hardening similar to or lower than that of the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain the radiation resistance of the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-to-Hf substitution will preserve practical bulk manufacturability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Maintaining the specimen below approximately 500 °C will limit thermally activated diffusion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At doses above 8 dpa or temperatures above 500 °C, enhanced diffusion may override the Hf-substitution effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
