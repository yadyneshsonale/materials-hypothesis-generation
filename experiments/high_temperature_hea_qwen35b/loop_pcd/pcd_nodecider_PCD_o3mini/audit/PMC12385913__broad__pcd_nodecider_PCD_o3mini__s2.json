      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation transmission through the coherent interfaces relieves stress concentrations.",
