  "claims": [
    {
      "text": "Diffusion governs processes such as precipitation and phase nucleation in compositionally complex materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11082203::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A refractory NbMoTa analog nanoalloy can be synthesized as a homogeneous, random solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant critical-temperature window is approximately 700°C ±50°C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11082203::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The NbMoTa system has a characteristic temperature at which B2 chemical order reaches a maximum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11082203::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Diffusion heterogeneity, or multiplicity, is highest near the characteristic ordering temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11082203::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Diffusion multiplicity can be represented by the breadth of path-dependent migration barriers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11082203::web::000::abstract",
        "PMC11082203::web::007::neural_network_kinetics_scheme",
        "PMC11082203::web::033::material_system_and_diffusion_barrier_ca"
      ],
      "same_system": "yes"
    },
    {
      "text": "The NNK framework can predict path-dependent migration barriers and individual atomic jumps.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11082203::web::000::abstract",
        "PMC11082203::web::007::neural_network_kinetics_scheme",
        "PMC11082203::web::033::material_system_and_diffusion_barrier_ca"
      ],
      "same_system": "yes"
    },
    {
      "text": "Greater diffusion-barrier heterogeneity produces a larger variety of atomic jump paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11082203::web::000::abstract",
        "PMC11082203::web::033::material_system_and_diffusion_barrier_ca"
      ],
      "same_system": "yes"
    },
    {
      "text": "A larger variety of atomic jump paths increases the probability of forming short-range chemically ordered regions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11082203::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Short-range chemically ordered domains stabilize the alloy and delay phase decomposition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 600°C, atomic mobility is too low for optimal chemical ordering.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 800°C, excessive mobility or disorder prevents optimal chemical ordering.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to 600°C and 800°C, treatment near 700°C will produce a significantly broader diffusion-barrier distribution and a peak in short-range chemical order.",
