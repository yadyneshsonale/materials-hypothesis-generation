  "claims": [
    {
      "text": "The baseline alloy has composition Cr16Mn16Fe16Co16Ni16P20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 2 at% boron to Cr16Mn16Fe16Co16Ni16P20 will improve its glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 2 at% boron will increase the thermal stability of the alloy's amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy can be prepared by controlled arc melting followed by rapid quenching through melt spinning.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A cooling rate of approximately 10^5 K/s is an appropriate processing condition for the proposed comparison.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Very rapid melt-spinning of undoped Cr16Mn16Fe16Co16Ni16P20 produces an amorphous structure.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phosphorus and high mixing entropy promote amorphous-phase formation in rapidly cooled Cr16Mn16Fe16Co16Ni16P20.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron doping will produce strong B-P bonding motifs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B-P bonding motifs will form an interconnected, rigid short-range-order network in the amorphous alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron atoms will preferentially bond with phosphorus and form stable local clusters.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed boron-phosphorus clusters will reduce atomic mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic mobility will increase the nucleation barrier and slow crystallization during rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower crystallization will enhance both glass formation and thermal stability of the amorphous phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-doped alloy will have a longer supercooled-liquid region than the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-doped alloy will have a crystallization onset temperature at least approximately 50 K above that of the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An insufficient cooling rate can prevent amorphous-phase formation in this alloy family.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron above its solubility limit may produce unwanted boride phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive boron may disrupt the alloy's high-entropy character and prevent the expected improvements.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD and TEM can be used to assess whether rapidly quenched ribbons are amorphous and whether crystalline phases are present.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions",
        "PMC8219663::web::025::x_rays_diffraction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is falsified if the doped samples fail to attain the specified thermal improvement or develop significant secondary boride phases under the matched comparison.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
