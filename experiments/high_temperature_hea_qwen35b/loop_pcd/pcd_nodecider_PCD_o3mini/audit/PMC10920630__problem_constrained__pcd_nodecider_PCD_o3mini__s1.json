  "claims": [
    {
      "text": "A pre-formed coherent Fe-oxide layer on Q235 steel suppresses corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299985::web::003::introduction",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer reduces chloride-ion ingress to the Q235 substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces oxygen transport to the metallic substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299985::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced chloride and oxygen transport delays localized corrosion on Q235 steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial Q235 specimens have clean metal surfaces before treatment or exposure.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heating Q235 steel in dry air at 150–200 °C for 2–4 hours will form a uniform, adherent passive oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed layer will likely contain a mixture of Fe3O4 and Fe2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A coherent, dense oxide layer acts as a physical diffusion barrier.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299985::web::003::introduction",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "Treated and untreated specimens will be compared in 3.5 wt.% NaCl at room temperature and 60 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limiting oxygen and aggressive-ion transport reduces iron dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299985::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Limiting transport through the film reduces initiation of pitting corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized Q235 samples will have lower corrosion current density than untreated samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299985::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized Q235 samples will have lower pit density than untreated samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized Q235 samples will lose mass more slowly than untreated samples.",
