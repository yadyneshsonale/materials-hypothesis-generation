  "claims": [
    {
      "text": "The starting AlCoCrFeNi2.1 alloy has a dual-phase FCC and B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy is in a uniform, fine lamellar state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::005::1_introduction",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed treatment is aging at approximately 650 °C for 4 hours in vacuum followed by controlled air cooling.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 650 °C for 4 hours will form coherent nanoscale ordered L12 precipitates in the FCC lamellae of AlCoCrFeNi2.1.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC7516913::web::005::1_introduction",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "The L12 precipitates will also form along phase boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The L12 precipitates strengthen the alloy through Orowan dislocation looping.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The L12 precipitates act as obstacles that pin dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::005::1_introduction",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitates stabilize the microstructure during long-term mechanical loading and thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will increase yield strength by approximately 15–20% relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::005::1_introduction",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment will improve creep resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will maintain or slightly improve ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment will not significantly compromise, and may slightly improve, corrosion resistance under moderate corrosive conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy has a yield strength of around 750 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy has insufficient strength and creep resistance for fasteners exposed to thermal fluctuations and corrosion.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effects should remain valid at operating temperatures below approximately 700 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effects should remain valid in environments comparable to 3.5 wt.% NaCl.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal aging parameters for L12 stability under cyclic thermal and mechanical loading remain uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
