      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% V to NbMoTaW will improve its room-temperature ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% Cr is an alternative intervention for improving the room-temperature ductility of NbMoTaW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% V or Cr will improve the irradiation tolerance of NbMoTaW.",
