      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The irradiated doped alloy will exhibit smaller, less-coalesced helium bubbles and less blistering than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
