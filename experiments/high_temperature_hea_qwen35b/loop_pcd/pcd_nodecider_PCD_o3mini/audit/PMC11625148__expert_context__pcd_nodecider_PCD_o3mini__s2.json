      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Repeated arc remelting and homogenization up to approximately 1200 °C will retain a single-phase BCC structure after doping.",
