      "supporting_ids": [
        "PMC7516508::web::006::3_1_density_of_the_as_cast_alloys",
        "PMC8746096::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The V-substituted alloy should achieve at least a 5% density reduction relative to HfMoTaTiZr.",
