      "support": "partial",
      "supporting_ids": [
        "PMC7514646::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ni interlayer promotes controlled interdiffusion between tungsten and copper during sintering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
