  "claims": [
    {
      "text": "The as-built Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "One sample group will receive a short pre-oxidation treatment at approximately 800 °C in a mildly oxidizing atmosphere.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will form a surface oxide scale enriched in Al and Cr.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_",
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized and as-built samples will be compared at 750–1000 °C in oxidizing and H2-containing reducing atmospheres.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A surface oxide scale can act as a diffusion barrier that slows oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Al and Cr act synergistically in the target alloy to promote a stable protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_",
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al/Cr-enriched scale limits oxygen ingress and slows degradation in oxidizing environments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_",
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Under reducing conditions, the protective scale is prone to reduction or thinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduction or thinning of the scale causes accelerated internal oxidation and microstructural degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In oxidizing atmospheres, pre-oxidized samples will gain less weight than the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6356250::web::007::2_design_and_selection_of_the_alloys_of_",
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "In oxidizing atmospheres, pre-oxidized samples will develop fewer surface cracks than the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In oxidizing atmospheres, pre-oxidized samples will exhibit less microstructural damage than the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In reducing atmospheres, oxide-scale breakdown or thinning will correlate with increased internal oxidation and degradation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298897::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
