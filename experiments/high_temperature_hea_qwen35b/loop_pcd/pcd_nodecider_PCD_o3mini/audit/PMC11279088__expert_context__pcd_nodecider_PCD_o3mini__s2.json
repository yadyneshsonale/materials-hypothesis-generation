  "claims": [
    {
      "text": "Using Al as X in single-phase CrFeCoNiX reduces outward metal-cation diffusion during high-temperature oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced cation diffusion in CrFeCoNiAl promotes formation of a continuous Cr/Al-rich protective oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide on CrFeCoNiAl is expected to be thinner, more uniform, and more adherent than oxides on the Mn- or Si-containing variants.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn oxidation can produce layered scales with a Cr-rich inner oxide and Mn-rich outer oxide through outward cation diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn has high mobility during oxidation of CrFeCoNiMn and can become depleted from the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn depletion can cause pore formation and accelerate oxide growth in CrFeCoNiMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiSi exhibits faster cation diffusion than CrFeCoNiAl.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn- and Si-containing variants form thicker and less structured oxide scales than the Al-containing variant.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher cation mobility causes excessive and non-uniform scale growth with void formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Void formation and non-uniform oxide growth cause cracking or spallation of Mn- or Si-containing scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-state species transport can govern high-temperature oxide-scale growth.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation of equimolar CrMnFeCoNi at 950 °C produces triplex scales containing Mn3O4, mixed Mn-Cr oxides, and an inner Cr2O3 layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8346963::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed comparison is restricted to single-phase CrFeCoNiAl, CrFeCoNiMn, and CrFeCoNiSi solid solutions.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloys will be compared under identical controlled-oxygen exposures above 900 °C for 100–300 hours.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tracer diffusion profiles, oxide thickness, uniformity, and interfacial adhesion are measurable comparison outcomes.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of CrFeCoNiAl to show both reduced cation diffusion and a thinner, more uniform, adherent scale relative to the Mn and Si variants would falsify the proposed governing mechanism.",
      "field": "falsification_experiment",
