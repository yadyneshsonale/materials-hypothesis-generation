  "claims": [
    {
      "text": "Conventionally sintered single-phase ZrB2 requires preparation temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally sintered ZrB2 typically contains residual porosity and microstructural defects.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–3 wt% elemental Si to ZrB2 induces a transient liquid phase through a eutectic reaction during sintering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si addition enables full densification at temperatures 300–400 °C below conventional ZrB2 sintering temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5126569::web::005::phase_evolution_and_formation_of_high_en"
      ],
      "same_system": "no"
    },
    {
      "text": "Si-modified ZrB2 can be densified at 1900–2000 °C in an inert atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5126569::web::005::phase_evolution_and_formation_of_high_en"
      ],
      "same_system": "no"
    },
    {
      "text": "The transient liquid phase wets ZrB2 particle interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si reacts with boron and potentially ZrB2 to form low-melting silicide or silicate species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed low-melting species enhance mass transport through capillary forces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Liquid-assisted mass transport fills voids and improves particle rearrangement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Liquid-assisted mass transport produces effective densification at lower temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-temperature liquid-assisted densification reduces defects that could propagate during liquid plating-bath exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-modified process will produce a fully densified, single-phase ZrB2 ceramic.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5126569::web::005::phase_evolution_and_formation_of_high_en"
      ],
      "same_system": "no"
    },
    {
      "text": "Si-modified ZrB2 will have fewer and smaller microstructural defects than ZrB2 conventionally sintered above 2300 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si modification will improve structural integrity during prolonged liquid plating-bath exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si modification will reduce hole formation during prolonged liquid plating-bath exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrB2 processed above 2300 °C without sintering aids has higher porosity and is more prone to defect growth under liquid plating conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Complete reaction or homogenization of the Si additive is sufficient to maintain single-phase ZrB2 purity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inadequate post-sintering treatment may leave residual silicide or silicate phases that compromise single-phase purity.",
