      ],
      "same_system": "yes"
    },
    {
      "text": "High-strain compressive deformation promotes a clustering-to-ordering transition in Al0.1CrCoFeNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC4976365::web::004::body",
        "PMC4976365::web::011::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Compression-induced atomistic rearrangement converts chemically clustered regions into a more ordered short-range configuration.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::004::body",
        "PMC4976365::web::011::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ordering transition under compression is associated with increased unlike-pair correlations and decreased like-pair correlations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::011::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Comparable tensile deformation does not induce the clustering-to-ordering transition and leaves clustering dominant.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::011::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compression-induced ordered domains increase local barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The clustering retained during tensile deformation permits easier dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compression-deformed specimens will have significantly higher hardness than tensile-deformed specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compression-deformed specimens will have significantly higher yield strength than tensile-deformed specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compression-deformed specimens will exhibit more short-range chemical ordering than tensile-deformed specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::004::body",
        "PMC4976365::web::011::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
