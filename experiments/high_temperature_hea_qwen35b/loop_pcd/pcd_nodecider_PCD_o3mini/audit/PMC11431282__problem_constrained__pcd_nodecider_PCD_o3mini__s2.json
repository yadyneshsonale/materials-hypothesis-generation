  "claims": [
    {
      "text": "The untreated (MnNiSi)0.62(FeCoGe)0.38 alloy has a large caloric response under applied magnetic and pressure fields.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has poor load-bearing integrity and high crack susceptibility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.3–0.5 at. % carbon during melting is an appropriate intervention for this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using an inert atmosphere during processing helps prevent oxidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11378924::web::009::hea_synthesis"
      ],
      "same_system": "no"
    },
    {
      "text": "A 200–300 °C homogenization treatment would remain below the alloy's caloric transformation temperature.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon added at 0.3–0.5 at. % will reside in interstitial lattice positions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon will increase the stacking-fault energy of this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon will introduce subtle lattice distortions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing stacking-fault energy will suppress premature twinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing stacking-fault energy will favor dislocation-mediated plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed change from twinning to dislocation-mediated plasticity will reduce crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon addition will not significantly interfere with the phase transformation responsible for the caloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon doping will increase fracture toughness and crack resistance relative to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-doped alloy will retain a caloric response comparable to that of the undoped alloy under both magnetic and pressure fields.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alloy is applicable near room temperature under magnetic-field and pressure-field operation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess carbon or inappropriate thermal treatment may cause carbide precipitation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbide precipitation may impair the caloric effect.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
