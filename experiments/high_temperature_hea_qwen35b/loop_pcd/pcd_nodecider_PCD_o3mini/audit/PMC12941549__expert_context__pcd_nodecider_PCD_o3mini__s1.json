  "claims": [
    {
      "text": "The as-cast, rapidly solidified alloy contains a metastable solid-solution matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has a limited distribution of relatively coarse intermetallic phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 350–450 °C for 1–2 hours partially decomposes the metastable solid solution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed annealing treatment produces nanoscale Mg-rich intermetallic precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine Mg-rich intermetallic precipitates promote formation of a protective surface film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::030::3_5_general_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Mg-rich precipitates act as preferential nucleation sites for MgO or Mg-containing spinel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::030::3_5_general_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mg-rich precipitates preferentially oxidize during subsequent corrosion or high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting MgO or Mg-containing spinel film is stable and adherent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::030::3_5_general_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide film acts as a diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::027::3_3_corrosion_behavior",
        "PMC12299034::web::030::3_5_general_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the as-cast baseline, annealing lowers corrosion current density and corrosion rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::027::3_3_corrosion_behavior",
        "PMC12299034::web::030::3_5_general_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the as-cast baseline, annealing produces a more adherent oxide scale with less high-temperature spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive annealing causes precipitate coarsening that diminishes the corrosion and oxidation benefits.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect is confined to annealing at 350–450 °C for 1–2 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 350–450 °C annealing range is below the alloy's transus.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert or low-oxygen annealing atmosphere avoids excessive oxidation during treatment.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
