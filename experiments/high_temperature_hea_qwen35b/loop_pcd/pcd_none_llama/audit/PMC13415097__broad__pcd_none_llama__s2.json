  "claims": [
    {
      "text": "The baseline alloy is equiatomic FeMnCoCr.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled intervention is addition of 5 at.% boron followed by annealing at 800°C for 2 hours.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition and annealing will produce a homogeneous, single-phase FCC solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron atoms will occupy interstitial lattice sites in the modified FeMnCoCr alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial boron reduces the magnetic anisotropy of FeMnCoCr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced magnetic anisotropy causes a stronger magnetocaloric response at low applied fields.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1 T, the boron-containing alloy will exhibit a 20% increase in magnetocaloric entropy change relative to boron-free FeMnCoCr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will not significantly change the mechanical stability of FeMnCoCr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will maintain rapid heat exchange.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will maintain low hysteresis.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect is expected over 250–350 K and at applied fields up to 1 T.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is expected to extend to rare-earth-free high-entropy alloys with composition and microstructure similar to FeMnCoCr.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A comparison of entropy change in boron-containing and boron-free FeMnCoCr can test the proposed magnetocaloric enhancement.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the boron-containing alloy to show a significantly higher entropy change than the baseline would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
