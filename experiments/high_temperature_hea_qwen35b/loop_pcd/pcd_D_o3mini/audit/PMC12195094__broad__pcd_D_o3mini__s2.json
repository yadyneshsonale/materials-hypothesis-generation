      ],
      "same_system": "no"
    },
    {
      "text": "An intermediate or graded interfacial region buffers stresses between a coating and its substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::015::3_3_hardness_and_wear_analysis"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti or Cr interlayer will reduce thermal-expansion mismatch and residual stresses.",
