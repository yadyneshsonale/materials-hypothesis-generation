      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::003::introduction",
        "PMC10213035::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An optimized, potentially faster, cooling rate will control Cu precipitation kinetics.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-rich precipitates will form a fine, interconnected network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will produce a dual-phase microstructure consisting of a high-strength refractory matrix and Cu-rich precipitates.",
