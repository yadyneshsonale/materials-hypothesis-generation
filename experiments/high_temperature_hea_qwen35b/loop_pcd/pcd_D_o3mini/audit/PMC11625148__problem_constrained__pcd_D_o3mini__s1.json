  "claims": [
    {
      "text": "Equal-atomic NbMoTaW contains approximately 25 at.% each of Nb, Mo, Ta, and W.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally produced equal-atomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cold rolling by more than 70% followed by annealing at 600–750 °C for 30 minutes will produce and retain a high density of nanoscale deformation twins in NbMoTaW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::013::discussion",
        "PMC9506522::web::006::2_2_thermomechanical_treatment"
      ],
      "same_system": "no"
    },
    {
      "text": "Heavy cold rolling introduces a high dislocation density.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderate annealing can reduce the cold-rolling-induced dislocation density while retaining deformation twins.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin boundaries act as barriers to mobile dislocations and thereby promote strengthening or strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5494191::web::013::discussion",
        "PMC5321736::web::017::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twinning can provide additional plastic-deformation pathways and improve ductility or toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::017::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed nanotwinned NbMoTaW will have significantly greater room-temperature strain capacity and toughness than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::017::discussion",
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The induced twin boundaries will remain stable in NbMoTaW at 1600 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin stability at 1600 °C will allow processed NbMoTaW to retain high-temperature strength and creep resistance comparable to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin boundaries in NbMoTaW will absorb or annihilate irradiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processed NbMoTaW will have irradiation resistance equal to or greater than that of untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equal-atomic NbMoTaW has poor room-temperature ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equal-atomic NbMoTaW has excellent mechanical performance at 1600 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The irradiation resistance of equal-atomic NbMoTaW has been predicted by first-principles calculations.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Full recrystallization or substantial grain growth during annealing would remove or diminish the desired retained-twin microstructure.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
