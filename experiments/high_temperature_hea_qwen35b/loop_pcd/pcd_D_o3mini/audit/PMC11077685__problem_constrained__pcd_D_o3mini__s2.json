  "claims": [
    {
      "text": "The initial material is cast equiatomic HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514597::web::022::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast HfNbTaTiZr has a coarse-grained microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr is sensitive to high-temperature oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514597::web::022::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pack cementation in an Al-rich powder pack for approximately 4 hours at about 1000 °C in argon is an optimized aluminizing treatment for this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminizing treatment will produce an Al-enriched near-surface layer by diffusion of Al from the pack.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled cooling in air will promote formation of an alumina scale on the aluminized surface.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting surface scale will be thin, continuous, uniform, and adherent α-Al2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The α-Al2O3 scale will act as a stable barrier that slows oxygen diffusion into the HfNbTaTiZr substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower oxygen diffusion will prevent rapid oxidation of the substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will markedly reduce oxygen uptake and oxidation damage during exposure in air at 1000 °C for up to 100 hours.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The surface treatment will leave the bulk microstructure unaffected.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will retain 8–16% room-temperature tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will retain a high-temperature yield strength of 163–530 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation protection and mechanical-property retention will apply under strain rates from 10^-4 to 10^-2 s^-1.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness may decline when processing parameters deviate significantly from the optimized range or under substantially different environmental conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive or nonuniform Al diffusion may produce a scale that is too thick or inhomogeneous.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The long-term cyclic thermal stability of the proposed alumina barrier is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
