      "supporting_ids": [
        "PMC5793551::web::003::1_introduction",
        "PMC9267696::web::002::1_introduction",
        "PMC8875034::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SFE-controlled balance between slip and twinning governs differences in strength and work-hardening behavior among the quinary, quaternary, and ternary alloys.",
