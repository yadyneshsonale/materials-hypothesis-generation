  "claims": [
    {
      "text": "Unmodified TC4 (Ti6Al4V) is an alpha-plus-beta dual-phase alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated TC4 has low surface hardness and inadequate wear resistance under extreme-service or high-contact-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma nitriding TC4 at 750 degrees C for 6 hours will form a thin, continuous, adherent surface layer primarily composed of TiN and Ti2N.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using 750 degrees C and a 6-hour duration will limit nitrogen diffusion primarily to the surface.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The selected nitriding parameters will preserve the underlying alpha-plus-beta bulk microstructure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During plasma nitriding, nitrogen diffuses into TC4 and reacts with titanium to form hard nitride compounds.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A hard nitride-containing surface layer increases resistance to plastic deformation and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::002::1_introduction",
        "PMC9959495::web::016::3_4_wear_and_corrosion_resistance_of_coc"
      ],
      "same_system": "no"
    },
    {
      "text": "The controlled nitriding parameters prevent thermal effects that would compromise bulk ductility, toughness, or fatigue resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nitrided TC4 will have approximately two to three times the surface hardness of untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::016::3_4_wear_and_corrosion_resistance_of_coc"
      ],
      "same_system": "no"
    },
    {
      "text": "The nitrided TC4 will exhibit markedly lower friction than untreated TC4 under high-contact-stress conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::016::3_4_wear_and_corrosion_resistance_of_coc"
      ],
      "same_system": "no"
    },
    {
      "text": "The nitrided TC4 will exhibit a markedly lower wear rate than untreated TC4 under high-contact-stress conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::002::1_introduction",
        "PMC9959495::web::016::3_4_wear_and_corrosion_resistance_of_coc"
      ],
      "same_system": "no"
    },
    {
      "text": "Nitrided TC4 will retain the beneficial bulk toughness and fatigue resistance of untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
