      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The room-temperature compressive yield strength of NbZrTiHfMo0.5V0.5 will remain within 5–10% of 1719 MPa.",
