  "claims": [
    {
      "text": "Conventionally cast and annealed eutectic AlCoCrFeNi has a dual-phase lamellar-colony microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6175879::web::010::the_role_of_phase_boundary_in_second_pha",
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lamellar microstructure contains numerous internal or phase boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::010::the_role_of_phase_boundary_in_second_pha"
      ],
      "same_system": "yes"
    },
    {
      "text": "Internal boundaries in the baseline alloy are preferential sites for microcrack initiation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6897545::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding approximately 0.5 at.% Y and annealing near 800 °C for 1 hour will cause Y to segregate preferentially to lamellar-colony interfaces.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated Y will form thin interfacial films at the internal boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Y-enriched interfacial films will be ductile.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled cooling can optimize Y segregation while avoiding excessive brittle intermetallic formation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-enriched interfacial films will accommodate local strain and reduce stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-enriched films will pin boundaries and hinder boundary migration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-enriched interfacial films will hinder dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6175879::web::010::the_role_of_phase_boundary_in_second_pha"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified interfaces will enhance work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6175879::web::010::the_role_of_phase_boundary_in_second_pha"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Y-enriched films will delay microcrack nucleation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 0.5 at.% Y-modified alloy will have higher room-temperature yield strength than the unmodified baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The 0.5 at.% Y-modified alloy will have greater room-temperature tensile ductility than the unmodified baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Simultaneous strength and ductility improvement requires Y concentration to remain near 0.5 at.% and the heat treatment to be tightly controlled.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess Y or unsuitable heat treatment may produce brittle Y-rich intermetallic compounds at boundaries.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Brittle boundary intermetallics can raise local stress or strain concentrations and promote crack initiation.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::003::introduction"
      ],
      "same_system": "no"
    }
  ],
