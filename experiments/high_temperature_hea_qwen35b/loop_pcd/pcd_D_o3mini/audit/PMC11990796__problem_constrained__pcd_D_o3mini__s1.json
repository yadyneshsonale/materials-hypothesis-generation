  "claims": [
    {
      "text": "The initial NbZrTiHfMo alloy is equiatomic.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbZrTiHfMo has a disordered BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The room-temperature compressive yield strength of equiatomic NbZrTiHfMo is approximately 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content of the baseline alloy increases electronegativity differences.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased electronegativity differences associated with high Mo content reduce the plasticity of NbZrTiHfMo.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to replace a minor amount of Mo with V.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt casting followed by homogenization at approximately 1200 °C for several hours will retain a single-phase disordered BCC structure in the V-modified alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vanadium has a lower electronegativity than molybdenum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor substitution of Mo by V will reduce the average local electronegativity difference in NbZrTiHfMo.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The V-modified alloy will retain significant lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::013::4_1_effect_of_v_addition_on_the_sfe_and_"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderating local electronegativity gradients will facilitate dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::013::4_1_effect_of_v_addition_on_the_sfe_and_"
      ],
      "same_system": "no"
    },
    {
      "text": "Facilitated dislocation motion will increase room-temperature plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preserved lattice distortion will continue to provide solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::013::4_1_effect_of_v_addition_on_the_sfe_and_",
        "PMC8708920::web::020::3_4_the_temperature_dependence_yield_str"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will maintain a room-temperature compressive yield strength near 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will exhibit greater room-temperature compressive plastic strain than equiatomic NbZrTiHfMo.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial range of V substitution is approximately 5% to 7%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive V substitution may reduce lattice distortion and compromise strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit requires the processed material to remain single-phase BCC.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
