      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10890668::web::015::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain refinement will increase hardness relative to the coarse-grained baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement will enhance work hardening.",
