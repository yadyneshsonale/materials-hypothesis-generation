      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::009::nanostructural_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain refinement will increase yield strength relative to the coarse-grained baseline.",
