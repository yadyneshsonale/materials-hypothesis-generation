      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing TC4 in air at 600–700 °C for 4–6 hours will form a 1–2 µm rutile TiO2 scale.",
      "field": "intervention",
