  "claims": [
    {
      "text": "The initial MoNbTaW alloy has a predominantly single-phase BCC matrix when produced by conventional melting or casting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying followed by hot consolidation can produce a homogeneous dispersion of nanoscale Y2O3 in the MoNbTaW BCC matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hot consolidation at approximately 1200°C under inert atmosphere will control grain growth in the proposed ODS alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "Dispersed Y2O3 nanoparticles obstruct dislocation motion and thereby strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::017::discussion",
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 nanoparticles serve as efficient sinks for irradiation-induced point defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 dispersion will increase the yield strength of MoNbTaW relative to an alloy without Y2O3.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y2O3 dispersion will improve toughness relative to the baseline MoNbTaW alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 dispersion will improve creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 defect sinks will suppress irradiation-induced defect coalescence.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed oxide particles will suppress grain-boundary migration and excessive grain growth at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "The ODS alloy will maintain greater microstructural stability at high temperature than unmodified MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "The ODS alloy will have greater irradiation resistance than unmodified MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "MoNbTaW without Y2O3 typically has lower mechanical strength than the proposed ODS material.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::026::4_2_characterization_of_the_rhea_bulks"
      ],
      "same_system": "no"
    },
    {
      "text": "Poor nanoparticle distribution or agglomeration will negate the strengthening benefit.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive processing temperatures or prolonged thermal exposure beyond the ODS stability range can cause nanoparticle agglomeration.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ODS strategies in related metallic materials and HEAs support oxide-mediated strengthening and high-temperature stability.",
      "field": "uncertainty",
