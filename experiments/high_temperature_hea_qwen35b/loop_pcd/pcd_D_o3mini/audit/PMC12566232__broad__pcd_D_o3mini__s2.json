  "claims": [
    {
      "text": "MoNbTaW is a refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated MoNbTaW alloy has a coarse-grained BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated MoNbTaW has high strength and impact-induced energy-release properties.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated coarse-grained MoNbTaW has limited ductility and deforms non-uniformly under stress.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is room-temperature HPT at approximately 6 GPa for 10–20 rotations followed by post-deformation annealing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HPT can refine an alloy to an ultrafine or nanocrystalline grain size.",
