  "claims": [
    {
      "text": "The Co-free FeNiCrMn alloy is a single-phase FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline equiatomic CoCrFeMnNi alloy is an FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing Co alters local atomic bonding in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing Co from equiatomic CoCrFeMnNi lowers the stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reduction in stacking-fault energy promotes deformation twinning in FCC high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::000::abstract",
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Co-free FeNiCrMn alloy predominantly deforms through increased twinning under the specified loading conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin boundaries strengthen these alloys by obstructing dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::000::abstract",
        "PMC5321736::web::009::nanostructural_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Interconnected twin boundaries can provide pathways for dislocation glide and thereby contribute to ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::000::abstract",
        "PMC5321736::web::009::nanostructural_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased nanotwinning increases work hardening in CoCrFeMnNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increased twinning postpones geometric instability or necking and can increase strength and ductility simultaneously.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced twinning delays dislocation accumulation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Co-free alloy will retain a favorable strength-ductility balance across cryogenic-to-400 °C testing and strain rates from approximately 10^-3 to 10^-1 s^-1 because of enhanced twinning.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::000::abstract",
        "PMC5321736::web::009::nanostructural_characterization",
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to CoCrFeMnNi, Co-free FeNiCrMn will begin twinning at a lower applied strain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to CoCrFeMnNi, Co-free FeNiCrMn will develop a higher deformation-twin density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted enhancement of twinning will be particularly pronounced at high strain rate and elevated temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline CoCrFeMnNi alloy has a relatively low intrinsic stacking-fault energy of approximately 19 mJ/m^2.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5575320::web::010::deformation_mechanism_upon_hydrogen_char"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline CoCrFeMnNi alloy has higher stacking-fault energy and lower twinning activity than Co-free FeNiCrMn under identical conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies throughout the single-phase FCC regime from cryogenic temperature to 400 °C and from 10^-3 to 10^-1 s^-1.",
