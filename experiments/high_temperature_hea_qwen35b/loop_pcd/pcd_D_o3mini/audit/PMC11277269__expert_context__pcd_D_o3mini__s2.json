  "claims": [
    {
      "text": "An intermediate or optimal Ru content in PtRu nanoparticles promotes formation of catalytically important Pt–Ru interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pt–Ru interfaces facilitate water activation and generation of reactive surface –OH species.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reactive –OH species oxidize adsorbed CO-like and other poisoning intermediates during ethanol oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed bifunctional mechanism increases activity, CO2 selectivity, and durability relative to pure Pt nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ru atoms at Pt–Ru interfaces alter local electronic properties.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4931244::web::013::mor_and_eor_performance"
      ],
      "same_system": "no"
    },
    {
      "text": "Ru sites in PtRu alloys dissociate water to produce –OH species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removal of strongly adsorbed intermediates from adjacent Pt sites maintains higher catalytic activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mitigation of surface poisoning enhances catalyst durability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An intermediate Ru content will produce a pronounced optimum in ethanol-oxidation current density, overpotential, CO2 selectivity, and durability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The performance optimum will correlate with increased –OH signals and reduced accumulation of poisoning intermediates in in situ IR measurements.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low Ru contents are less effective because they provide insufficient –OH production.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High Ru contents may be less effective because Ru blocks Pt active sites or causes unfavorable electronic effects.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Particle size can affect the operative mechanism of Ru-containing catalysts, so holding particle size constant is important when varying Ru content.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11082846::web::040::ru_metal_particles_role"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies under acidic ethanol oxidation at 50°C with controlled potential cycling.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism's influence may change under alkaline conditions, at other temperatures, or with altered potential sweep rates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electronic or structural effects other than the bifunctional –OH mechanism may influence catalytic performance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4931244::web::013::mor_and_eor_performance"
      ],
      "same_system": "no"
    },
    {
      "text": "The optimal Ru content and the exclusive causal role of –OH-assisted oxidation remain uncertain without direct spectroscopic evidence.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
