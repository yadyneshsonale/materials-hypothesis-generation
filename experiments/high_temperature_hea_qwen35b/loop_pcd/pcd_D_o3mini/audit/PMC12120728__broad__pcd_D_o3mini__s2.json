  "claims": [
    {
      "text": "The unmodified baseline is NbMoTaTi produced by melting and casting under an inert atmosphere without carbon addition.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.3–0.5 wt% carbon and heat treating at 1000–1100°C will induce TiC precipitation in NbMoTaTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed processing will produce nanoscale TiC precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC precipitates will be distributed homogeneously within the NbMoTaTi matrix and along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::018::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "TiC precipitates capture migrating irradiation-induced vacancies and interstitials.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Capture of irradiation-induced point defects by TiC mitigates void formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC dispersion strengthens the alloy and helps preserve its yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::018::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Uniformly distributed TiC can improve irradiation resistance in plasma-facing materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5434025::web::018::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon-doped NbMoTaTi will exhibit 15–25% lower void swelling than the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-doped NbMoTaTi will retain or improve its post-irradiation yield strength relative to the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::018::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The beneficial effect will hold during irradiation at approximately 450°C up to 100 dpa.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect depends on maintaining carbon at 0.3–0.5 wt% and heat treatment at 1000–1100°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing deviations or irradiation doses beyond the stated range may alter performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
