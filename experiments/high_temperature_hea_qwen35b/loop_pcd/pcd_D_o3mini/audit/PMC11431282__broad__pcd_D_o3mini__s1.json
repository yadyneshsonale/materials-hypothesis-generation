      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The V-rich precipitates will be fine and uniformly dispersed within the MnNiSi matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::011::3_results_and_discussion"
      ],
