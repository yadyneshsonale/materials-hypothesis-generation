  "claims": [
    {
      "text": "CoCrFeMnNi coatings form an oxide tribofilm during wear in an oxidizing atmosphere.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8448869::web::004::introduction",
        "PMC9571794::web::016::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribofilm formed on CoCrFeMnNi is self-healing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Frictional heating promotes the tribochemical oxidation that forms the tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9571794::web::016::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribofilm acts as a protective barrier that reduces material removal and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8448869::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing conditions produce significantly lower wear rates than an argon atmosphere.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8448869::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An argon atmosphere prevents formation of the protective oxide tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8448869::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "In argon, CoCrFeMnNi remains vulnerable to conventional abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial CoCrFeMnNi coatings have a homogeneous solid-solution structure and no pre-existing oxide layer.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant structural mediator is a thin, adherent oxide tribofilm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8448869::web::004::introduction",
        "PMC9571794::web::016::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A continuous oxide layer should be detected only after testing in the oxidizing atmosphere.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective protective-film formation has a threshold oxygen partial pressure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater load and sliding speed increase frictional heat when friction coefficient and contact area are fixed.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9571794::web::016::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective mechanism should operate over loads and sliding speeds that generate enough frictional heat to initiate oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9571794::web::016::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism ceases to apply when frictional heating causes thermal degradation or significant microstructural alteration.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atmosphere can be isolated as the controlled intervention by holding load, sliding speed, temperature, and contact geometry constant.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide-mediated explanation is falsified if oxidizing conditions do not lower wear significantly relative to argon or do not produce a distinct continuous oxide film.",
      "field": "falsification_experiment",
