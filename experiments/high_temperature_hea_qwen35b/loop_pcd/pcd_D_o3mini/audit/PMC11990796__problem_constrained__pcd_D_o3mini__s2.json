      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content in NbZrTiHfMo produces large local electronegativity differences.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
