  "claims": [
    {
      "text": "As-cast eutectic AlCoCrFeNi2.1 has dual-phase lamellar colonies containing weak internal boundaries prone to microcracking.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.1–0.5 wt% boron during melt processing and applying a post-casting heat treatment will cause boron to segregate to internal lamellar boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing under an inert atmosphere will help ensure uniform boron distribution.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An optimized heat treatment can control boron segregation at lamellar interfaces.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An optimized heat treatment can prevent the formation of coarse, brittle boride precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron has a strong tendency to segregate to destabilized interfaces in this alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron segregation at lamellar boundaries lowers their interfacial energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated boron increases the cohesive strength of internal lamellar boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater boundary cohesion suppresses or delays microcrack nucleation during room-temperature tensile deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater boundary cohesion delays microcrack propagation during room-temperature tensile deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron doping and heat treatment will increase tensile strength relative to the undoped lamellar alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron doping and heat treatment will increase room-temperature tensile ductility relative to the undoped lamellar alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanical benefit is sensitive to boron concentration and post-casting heat-treatment parameters.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing outside the suitable boron and heat-treatment window may produce brittle boride phases that negate the mechanical benefit.",
