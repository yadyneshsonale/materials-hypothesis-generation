  "claims": [
    {
      "text": "Increasing atomic size mismatch in high-entropy-alloy nanoparticles accelerates the onset of premelting.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 5–10 at.% Al to equiatomic CoCrFeMnNi increases its atomic size mismatch.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al is a smaller-radius element relative to the constituents of equiatomic CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased atomic size mismatch produces localized atomic strain fields in the doped nanoparticles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dopant-induced localized strain and internal stress reduce local cohesive energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced local cohesive energy facilitates earlier surface disordering or premelting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Premelting preferentially begins at nanoparticle surfaces or defect sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic strain is minimized in undoped equiatomic CoCrFeMnNi nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped equiatomic CoCrFeMnNi control has minimal atomic size mismatch.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultrafast laser ablation in liquid yields monodisperse, phase-pure equiatomic CoCrFeMnNi nanoparticles with diameters of 5–10 nm.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the equiatomic control, Al-doped nanoparticles will show surface disordering at a lower temperature in TEM.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the equiatomic control, Al-doped nanoparticles will show a lower-temperature premelting peak in DSC.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed size-mismatch effect should operate for nanoparticles approximately 5–10 nm in diameter under inert-atmosphere heating.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outside the 5–10 nm range or under different synthesis conditions, additional factors may govern premelting and melting behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electronic or phase effects introduced by doping may confound attribution of a melting-temperature change to atomic size mismatch.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison will keep synthesis, processing, particle-size distribution, heating protocol, and environment constant while varying Al content.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the Al-doped particles to show a statistically significant reduction in premelting onset relative to the control would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
