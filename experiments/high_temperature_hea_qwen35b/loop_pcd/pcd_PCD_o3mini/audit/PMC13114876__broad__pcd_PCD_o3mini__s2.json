        "PMC12565319::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The comparison varies boron at x = 0, 0.5, 1.0, and 1.5 wt%.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron addition promotes in situ formation of TiB2 in AlCoCrFeNiMoTi coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "An optimal boron level produces finely dispersed TiB2 precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron-induced TiB2 formation refines the HEA matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron addition can enhance the stability of the passive film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The passive oxide film promoted by the modified microstructure is self-healing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement and passive-film stabilization synergistically improve resistance to simultaneous wear and corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron reacts with titanium during solidification to form TiB2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "TiB2 precipitates increase the density of the passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined microstructure reduces crack initiation under mechanical loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified microstructure minimizes exposure of corrosion-susceptible sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing boron content increases the size and fraction of TiB2 particles.",
