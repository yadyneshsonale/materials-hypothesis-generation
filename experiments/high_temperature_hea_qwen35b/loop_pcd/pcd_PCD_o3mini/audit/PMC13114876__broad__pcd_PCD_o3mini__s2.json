      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive boron produces coarse TiB2 particles that disrupt passive-film continuity and degrade performance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The x = 1.0 coating has better wear resistance than the boron-free coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The x = 1.0 coating has a lower friction coefficient than the boron-free coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The x = 1.0 coating has greater corrosion resistance, higher charge-transfer resistance, and a thicker passive film than the boron-free coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
