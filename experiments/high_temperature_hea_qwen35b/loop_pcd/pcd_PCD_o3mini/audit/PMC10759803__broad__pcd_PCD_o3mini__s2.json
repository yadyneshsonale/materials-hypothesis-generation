  "claims": [
    {
      "text": "The proposed modified Al0.7CoCrFeNi-based alloy, containing lightweight refractory substitutions, is a refractory HEA suitable for the proposed intervention.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Before aging, the alloy has a predominantly fcc dual-phase microstructure with a minor B2 or bcc constituent.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging at 800–900 °C for an optimized duration will precipitate L12 particles in the fcc matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aging treatment will produce uniformly distributed, nanoscale, coherent L12 precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanoscale L12 precipitates impede dislocation motion through Orowan bowing and bypass.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Orowan strengthening by the L12 precipitates remains effective at approximately 900 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low volume fraction and coherent nature of the precipitates will preserve room-temperature ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The aging-induced precipitates will not significantly increase alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the untreated alloy, aging will increase yield strength by more than 20% under dynamic compressive loading at approximately 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The aged alloy will retain mechanical performance similar to the untreated alloy at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aged alloy will retain approximately the same density as the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated baseline has an fcc plus B2/bcc dual-phase microstructure.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive aging exposure will cause precipitate coarsening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarsened precipitates will deteriorate high-temperature mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarsened precipitates will deteriorate room-temperature ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior work on Al0.7CoCrFeNi found that a 580 °C, 24 h heat treatment introduced nanoscale L12 precipitates into fcc lamellae.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
