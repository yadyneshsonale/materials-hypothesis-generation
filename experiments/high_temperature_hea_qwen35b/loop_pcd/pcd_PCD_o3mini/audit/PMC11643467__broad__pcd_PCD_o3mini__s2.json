  "claims": [
    {
      "text": "Ti68Nb7Ta3Zr4Mo18 is a high-entropy alloy suitable for consideration as an aerospace-fastener material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 75% cold rolling followed by a controlled isothermal oxidation hold will improve the mechanical durability of Ti68Nb7Ta3Zr4Mo18 relative to an untreated cast or coarse-grained baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract",
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will improve the room-temperature creep resistance of Ti68Nb7Ta3Zr4Mo18.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment will improve the corrosion resistance of Ti68Nb7Ta3Zr4Mo18.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract",
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The untreated Ti68Nb7Ta3Zr4Mo18 baseline has an unoptimized or irregular native oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature cold rolling at approximately 75% thickness reduction will produce a refined, submicron-grained bulk microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A brief ambient or mildly elevated-temperature isothermal hold will produce a continuous and uniform passive oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The passive film on processed Ti68Nb7Ta3Zr4Mo18 will be predominantly composed of TiO2 and Nb2O5.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Cold-rolling-induced grain refinement will increase yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract",
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined microstructure increases strength by impeding dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined microstructure reduces room-temperature creep by impeding dislocation motion and grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniform passive oxide film acts as a barrier to corrosive species and thereby improves corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed alloy will have a higher yield strength than the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract",
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed alloy will exhibit improved passivation behavior in potentiodynamic corrosion tests.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::000::abstract",
        "PMC10744552::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The untreated cast or coarse-grained Ti68Nb7Ta3Zr4Mo18 baseline has inferior mechanical, creep, and corrosion properties.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
