  "claims": [
    {
      "text": "Carbon plasma ion implantation followed by low-temperature annealing will produce a uniform, amorphous-carbon-enriched nanostructured surface layer on CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The implanted and annealed surface layer will reduce the coefficient of friction of CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The implanted and annealed surface layer will reduce the wear rate of CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting CoCrFeMnNi alloy has a relatively coarse-grained microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeMnNi alloy is single-phase FCC.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated CoCrFeMnNi typically has a friction coefficient of approximately 0.3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon implantation should use ion energies in the range of 10–30 keV.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature post-implantation annealing relieves implantation-induced damage.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature post-implantation annealing promotes uniform amorphization of the modified layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-implantation annealing enhances adhesion and produces a more uniform, well-bonded surface layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting layer consists of amorphous-carbon-enriched material within a finely refined crystalline matrix bonded to the bulk alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Implanted carbon ions induce local amorphization and grain refinement in the CoCrFeMnNi near-surface region.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A highly refined, near-amorphous surface structure can lower interfacial shear strength and friction in CoCrFeMnNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The carbon-rich implanted layer acts as a solid lubricant during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined surface microstructure distributes and arrests stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will reduce friction coefficient by approximately 30–40% relative to untreated CoCrFeMnNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will significantly decrease wear rate relative to untreated CoCrFeMnNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The friction and wear benefits will persist from cryogenic temperatures to approximately 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated CoCrFeMnNi has especially high wear rates under cyclic loading and temperature variation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure above 800 °C may compromise the integrity of the lubricious layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
