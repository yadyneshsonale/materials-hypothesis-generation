  "claims": [
    {
      "text": "The baseline alloy is equiatomic, single-phase BCC NbMoTaW.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbMoTaW has excellent mechanical strength or stability at temperatures up to 1600 °C.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The irradiation response of untreated NbMoTaW has not been experimentally verified.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 7 at.% Ti will be added to NbMoTaW, followed by homogenization near 1400 °C and aging at 700–900 °C.",
      "field": "hypothesis; intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti addition and heat treatment will produce a dual-phase microstructure comprising a continuous BCC matrix and fine, coherent B2/Ti-rich precipitates.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Discrete B2 precipitates in a continuous BCC matrix can improve room-temperature compressive ductility while maintaining high yield strength.",
      "field": "structural_mediator; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The B2/Ti-rich precipitates will act as dislocation-nucleation sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will locally reduce the critical resolved shear stress and thereby improve room-temperature ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized softening or transformation-induced mechanisms will contribute to the ductility improvement.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Second-phase precipitates or interfaces can trap helium bubbles and mitigate helium accumulation effects in a metallic matrix.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9228246::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed B2/Ti-rich precipitates will trap or annihilate irradiation-induced point defects in Ti-modified NbMoTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9228246::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitate-mediated defect trapping will reduce helium-bubble growth and coalescence and delay blistering relative to untreated NbMoTaW.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9228246::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will retain BCC structural stability and high-temperature strength up to 1600 °C.",
      "field": "hypothesis; predicted_outcome; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale B2/Ti-rich precipitates can remain stable at temperatures up to 1600 °C if the heat treatment is optimized.",
      "field": "mechanism; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy is expected to improve room-temperature ductility by more than 20% without loss of high-temperature strength.",
      "field": "predicted_outcome; falsification_experiment.falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance boundary includes helium-ion irradiation energies from tens of keV to approximately 100 keV.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term thermal stability of the nanoscale B2/Ti-rich precipitates at extreme temperatures is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
