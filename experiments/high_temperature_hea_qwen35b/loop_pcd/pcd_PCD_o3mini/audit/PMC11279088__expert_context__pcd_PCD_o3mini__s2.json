  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The identity of X governs whether CrFeCoNiX forms a stable, coherent, slow-growing protective oxide above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al and Si have high oxygen affinity relative to the other relevant alloying elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "Al- or Si-containing CrFeCoNiX alloys form an Al2O3- or SiO2-enriched subscale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC6719109::web::049::5_2_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Al2O3 and SiO2 are protective oxide barriers for high-temperature alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 or SiO2 scales formed in these alloys are dense and slow-growing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 or SiO2 subscale is adherent to the CrFeCoNiX substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 and SiO2 have favorable lattice parameters that minimize metal-oxide lattice mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 and SiO2 develop low intrinsic growth stresses in these alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced lattice mismatch and growth stress promote a coherent, stable oxide barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxides formed on CrFeCoNiMn are less protective than the proposed Al- or Si-rich scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-containing oxide scales grow rapidly.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-containing oxides generate high internal stresses that cause cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn forms manganese-bearing oxides, including Mn3O4 and mixed Mn-Fe or Mn-Cr oxides, at high temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "The absence of a protective Cr2O3 barrier permits continued Mn outward diffusion and leaves the CrMnFeCoNi substrate unprotected.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al- or Si-containing alloys will retain a thin, coherent scale during prolonged exposure at 950 °C, whereas the Mn alloy will crack and eventually spall.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior applies both in air and in water-vapor-rich corrosive atmospheres.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism is valid generally at oxidation temperatures above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC10384371::web::030::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
