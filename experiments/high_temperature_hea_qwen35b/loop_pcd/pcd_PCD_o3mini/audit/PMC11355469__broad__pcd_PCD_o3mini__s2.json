  "claims": [
    {
      "text": "The investigated alloy is equiatomic CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Wear resistance in CoCrFeMnNi coatings is governed by shear-induced dynamic amorphization and formation of an ultra-nanocrystalline or partially amorphous near-surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The refined or near-amorphous surface layer resists further plastic deformation and abrasive wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Post-deposition annealing can produce controlled coarse- and fine-grained coating microstructures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower annealing temperatures produce finer grains, whereas higher annealing temperatures produce coarser grains.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding shear induces strong grain refinement and formation of a near-amorphous surface film in CoCrFeMnNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The shear-induced refined surface layer exhibits inverse Hall-Petch behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of the refined or near-amorphous surface layer is associated with low friction and high wear resistance in inert environments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Initial grain size affects the rate and extent of shear-induced surface refinement or amorphization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coatings with finer initial grains will form the ultra-nanocrystalline or amorphous wear layer more rapidly or extensively than coarse-grained coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine-grained coatings will have lower friction coefficients than coarse-grained coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine-grained coatings will have lower wear rates than coarse-grained coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse-grained as-deposited coatings do not readily form the protective ultra-nanocrystalline layer under shear.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing oxidation by testing in an inert or oxygen-free environment isolates the proposed shear-induced mechanism.",
