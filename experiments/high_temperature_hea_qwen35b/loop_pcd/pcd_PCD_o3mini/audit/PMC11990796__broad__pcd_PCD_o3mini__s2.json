      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::000::abstract",
        "PMC5494191::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed NbTaHfTiZrV0.5 alloy will have approximately 20–30% higher yield strength than the fully recrystallized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed NbTaHfTiZrV0.5 alloy will maintain or improve ductility through additional twin activation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
