  "claims": [
    {
      "text": "WTaMoNbV is a refractory high-entropy alloy suitable for use as a coating on tungsten particles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetron sputtering can produce a conformal HEA coating on tungsten particles.",
