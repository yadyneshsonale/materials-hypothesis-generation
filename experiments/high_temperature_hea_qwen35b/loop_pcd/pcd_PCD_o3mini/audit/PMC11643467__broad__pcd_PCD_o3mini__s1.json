      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultrafine grain refinement will increase yield strength through Hall–Petch strengthening and impeded dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10383748::web::000::abstract",
        "PMC10744552::web::001::1_introduction"
