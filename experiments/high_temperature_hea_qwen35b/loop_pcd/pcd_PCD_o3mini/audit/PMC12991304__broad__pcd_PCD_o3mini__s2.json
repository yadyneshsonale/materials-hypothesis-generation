      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A four-metal Cr-Mn-Fe-Co spinel is a lower-entropy comparator for the seven-metal spinel.",
