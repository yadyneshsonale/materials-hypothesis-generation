  "claims": [
    {
      "text": "Increasing the number of first-row transition metals from four to seven increases the configurational disorder of the spinel oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12005821::web::000::abstract",
        "PMC12005821::web::014::optimization_of_he_spinel_oxide"
      ],
      "same_system": "yes"
    },
    {
      "text": "Four-, five-, six-, and seven-metal spinel oxides can be prepared from metal dithiocarbamate precursors by solventless thermolysis.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12005821::web::007::introduction",
        "PMC12005821::web::014::optimization_of_he_spinel_oxide"
      ],
      "same_system": "yes"
    },
    {
      "text": "The seven-metal spinel is a high-entropy, highly disordered spinel structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12005821::web::000::abstract",
        "PMC12005821::web::014::optimization_of_he_spinel_oxide"
      ],
      "same_system": "yes"
    },
    {
      "text": "Optimized solventless thermolysis produces a uniform elemental distribution in the seven-metal spinel.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant solventless thermolysis synthesis temperature is approximately 500–800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater configurational disorder increases the density of oxidation-active sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater configurational disorder improves oxygen-ion mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased active-site density and oxygen mobility lower the activation barrier for CO oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased active-site density and oxygen mobility lower the activation barrier for NOx oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A seven-metal spinel has a substantially lower CO-oxidation T10 than a four-metal spinel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12005821::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The seven-metal spinel resists catalyst deactivation better than the four-metal variant during a 14-hour stability test.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12005821::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The activity and durability advantage will persist under simulated automotive-exhaust gas mixtures and 500–800 °C thermal cycling.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12005821::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Configurational disorder in the support inhibits sintering of ultra-thin PGM layers during thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The seven-metal support enables a significant reduction in PGM loading without sacrificing catalytic efficiency.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
