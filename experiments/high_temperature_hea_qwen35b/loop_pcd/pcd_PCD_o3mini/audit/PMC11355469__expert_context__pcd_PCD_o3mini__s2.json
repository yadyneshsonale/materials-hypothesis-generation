      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::015::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "Failure to form the oxide layer, or statistically indistinguishable friction and wear relative to the control, would falsify the hypothesis.",
