      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::000::abstract",
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sacrificial oxidation produces non-noble-metal oxide shells around Pd-rich nuclei.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide shells temporarily limit the exposure of noble-metal sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide shells inhibit diffusion of Pd atoms into CeO2.",
