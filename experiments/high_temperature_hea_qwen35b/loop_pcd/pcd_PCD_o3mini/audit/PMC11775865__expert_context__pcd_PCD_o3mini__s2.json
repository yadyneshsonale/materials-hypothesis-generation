      "support": "partial",
      "supporting_ids": [
        "PMC10466320::web::000::abstract",
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidative exposure sacrificially oxidizes Co, Ni, Cu, and Zn in the CoNiCuZnPd clusters.",
