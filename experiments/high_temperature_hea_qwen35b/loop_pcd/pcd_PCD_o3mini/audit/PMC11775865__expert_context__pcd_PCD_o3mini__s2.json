      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Exposure to H2 reduces the oxide species and enables atomic interdiffusion that realloys the elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10466320::web::000::abstract",
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation followed by realloying constitutes a self-healing mechanism that restores nanoparticle structure and dispersion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10466320::web::000::abstract",
        "PMC10466320::web::029::reversible_structural_change_of_hea_sub_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxygen spillover from unmodified CeO2 is required for adequate formation of the transient oxide shells.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
