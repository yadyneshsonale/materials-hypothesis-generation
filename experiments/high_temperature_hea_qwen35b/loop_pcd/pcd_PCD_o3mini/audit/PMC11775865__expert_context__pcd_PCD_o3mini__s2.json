      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hindering oxide-shell formation will cause irreversible phase segregation and sintering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Clusters on unmodified CeO2 will show reversible transformations with minimal sintering over redox cycles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
