  "claims": [
    {
      "text": "Increasing Al content in AlCoCrFeNiTi0.5 enhances high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al content promotes rapid segregation of Al to the alloy surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::012::3_3_observation_of_the_microstructure",
        "PMC10856430::web::014::4_discussions"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface enrichment of Al facilitates formation of a continuous protective Al2O3 layer.",
