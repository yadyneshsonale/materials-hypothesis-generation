      "text": "The protective scale will be adherent.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-Al AlCoCrFeNiTi0.5 variants will form mixed or discontinuous oxide scales that inhibit oxygen diffusion less effectively.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
