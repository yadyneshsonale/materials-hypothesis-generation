      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10104586::web::000::abstract",
        "PMC10104586::web::001::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Local chemical order will provide ordering strengthening in aged MoNbTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to as-built MoNbTaW, the aged alloy will exhibit statistically significant increases in yield strength and hardness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
