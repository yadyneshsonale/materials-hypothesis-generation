  "claims": [
    {
      "text": "The as-built additively manufactured MoNbTaW alloy is a chemically disordered refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A post-processing thermal aging treatment can induce local chemical order in a high- or medium-entropy alloy.",
