  "claims": [
    {
      "text": "The untreated bond coat is a CrMnFeCoNi-based high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention adds approximately 1 at.% Y to the CrMnFeCoNi-based bond coat.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y can be distributed uniformly through the bond coat during processing.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1 at.% Y modifies the TGO formed by a CrMnFeCoNi-based bond coat during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y addition produces a Y-enriched TGO at the coating–ceramic interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Y-enriched TGO has improved adhesion and reduced growth stress.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9028980::web::031::6_maps_for_bond_coat_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "During high-temperature oxidation, Y segregates to the metal–oxide interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Y alters oxide-growth kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Y reduces stresses at the metal–oxide interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced interfacial stress suppresses crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A more adherent and stable TGO reduces coating spallation and cracking.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9028980::web::031::6_maps_for_bond_coat_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "Y-doped bond coats will have significantly less TGO spallation than undoped CrMnFeCoNi-based bond coats under equivalent thermal cycling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-doped bond coats will have fewer interface cracks than undoped CrMnFeCoNi-based bond coats.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-doped bond coats will have longer service life than undoped CrMnFeCoNi-based bond coats.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit remains effective under cyclic oxidizing conditions from 1000°C to 1200°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An undoped CrMnFeCoNi-based bond coat typically develops a TGO prone to spallation and cracking after extended high-temperature cycling.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nonuniform Y distribution may limit the beneficial effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y concentrations above an optimum can produce detrimental phases and limit durability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reactive-element effect of Y on oxide adhesion is well documented.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
