  "claims": [
    {
      "text": "The initial WTaCrVHf refractory HEA is nanocrystalline.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial WTaCrVHf near-surface region is fully crystalline and has well-defined grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tribological loading can dynamically amorphize the HEA surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::002::introduction",
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting near-surface layer is amorphous or ultra-nanocrystalline.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The amorphous or ultra-nanocrystalline layer has a high density of defect sites and chemically active states.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled high-energy mechanical impacts and low-energy ion irradiation will induce near-surface amorphization in WTaCrVHf.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The induced amorphous layer can be made to mimic the naturally tribo-induced structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Amorphization increases surface energy and chemical reactivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The amorphized surface accelerates passive-film formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The same defect-rich amorphized structure promotes active dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding wear removes or disrupts the surface film and competes with repassivation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::019::3_4_worn_track_morphology_and_wear_mecha"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The balance between repassivation, active dissolution, and wear-driven film removal governs the coupled tribo-corrosion response.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the crystalline baseline, the amorphized WTaCrVHf surface will have a higher corrosion current density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the crystalline baseline, amorphization will produce a moderate change in wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::012::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Total degradation may increase when accelerated corrosion outweighs protection from faster passive-film formation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction should apply when tribological loading produces significant amorphization.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The prediction may fail when the alloy remains predominantly crystalline under the applied loading.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lack of significant differences in corrosion current, wear rate, and passive-film reformation between treated and untreated samples would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the induced layer to mimic the naturally tribo-induced structure would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
