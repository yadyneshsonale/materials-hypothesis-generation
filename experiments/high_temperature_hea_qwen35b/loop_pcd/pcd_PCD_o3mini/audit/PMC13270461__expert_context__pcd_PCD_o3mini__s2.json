{
  "run_id": "PMC13270461__expert_context__pcd_PCD_o3mini__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The starting material is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 with a retained FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has established baseline strength and fatigue performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature degradation is governed by the dynamic formation and evolution of the surface oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC6356250::web::065::5_3_oxidation"
      ],
      "same_system": "no"
    },
    {
      "text": "The governing surface scale consists primarily of mixed Cr2O3 and TiO2.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298897::web::019::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Under oxidizing conditions, Cr and Ti oxidize at different competing rates.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Competitive Cr and Ti oxidation produces a poorly adherent or non-protective oxide scale.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Loss of oxide-scale adhesion causes spallation and initiates microcracking.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6356250::web::065::5_3_oxidation"
      ],
      "same_system": "no"
    },
    {
      "text": "Under reducing conditions, incomplete or transient oxidation promotes elemental segregation.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduction-associated elemental segregation compromises interfacial integrity and causes embrittlement.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale composition, continuity, and adhesion are the principal structural mediators of degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC6356250::web::065::5_3_oxidation"
      ],
      "same_system": "no"
    },
    {
      "text": "A continuous, well-adherent oxide scale will largely preserve fatigue life and strength relative to the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC12298897::web::019::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A defective or spalled scale accompanied by microcracking will reduce fatigue life or strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC6356250::web::065::5_3_oxidation"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased elemental segregation will be associated with reduced mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison uses oxidizing and reducing atmospheres at 700–800 °C for 10, 50, and 100 hours.",
      "field": "conditions; falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scale composition, thickness, adhesion, microcrack density, fatigue life, and tensile strength will be measured against the as-built baseline.",
      "field": "intervention; falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interpretation is restricted to exposures for which the FCC matrix remains preserved and surface-scale dynamics remain the principal degradation process.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if oxide-scale quality has no statistically significant correlation with fatigue-life or strength degradation relative to baseline.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
