        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced grain-boundary cohesion promotes crack initiation along grain boundaries and intergranular cracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoclustering-induced grain-boundary decohesion is distinct from embrittlement caused by brittle secondary-phase precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
