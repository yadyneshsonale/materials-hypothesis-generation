        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy is produced by arc melting and homogenized to ensure uniform composition and microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling after aging at 400–600°C promotes grain-boundary nanoclustering of principal elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching after aging freezes a compositionally homogeneous state with minimal grain-boundary nanoclustering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr, Ni, and Mn form separate enriched nanoclusters or nanosegregated regions at grain boundaries in single-phase CrMnFeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
