  "claims": [
    {
      "text": "The target alloy is equiatomic, Co-free FeNiCrMn.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The target alloy is tested in the as-cast state without post-solidification heat treatment.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic FeNiCrMn has an inherent FCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dynamic mechanical response of as-cast FeNiCrMn across temperature and strain-rate regimes is governed by temperature-dependent dislocation drag.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "At high strain rates, deformation time is insufficient for thermal activation to help dislocations overcome barriers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Low temperature reduces thermal activation and increases barriers to dislocation motion in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combination of low temperature and high strain rate produces pronounced dislocation pile-ups.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Transient variations in dislocation density, pile-ups, and their stress fields mediate the dynamic response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High dislocation velocities at high strain rates enhance phonon or dislocation drag and impede deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced drag at high strain rates increases dynamic yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher temperatures facilitate dislocation glide and reduce yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yield strength and strain-rate sensitivity will vary systematically with temperature and strain rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "Yield strength will be highest at low temperature and high strain rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512474::web::013::4_1_the_constitutive_model_and_strain_ra"
      ],
      "same_system": "no"
    },
    {
      "text": "The study will compare tensile and compressive behavior at 77 K, 300 K, and 500 K over strain rates from 10^-3 to approximately 10^3 s^-1.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature quasi-static behavior provides a reference state with a known strength-ductility balance.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation drag is expected to dominate from 77 K to 500 K and from 10^-3 to approximately 10^3 s^-1.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outside the specified temperature and strain-rate ranges, twinning or phase transformations may become significant.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Invariant dislocation structures across the tested conditions, or no systematic relationship between those structures and mechanical response, would falsify the proposed mechanism.",
      "field": "falsification_rule",
      "needs_support": false,
      "support": "unsupported",
