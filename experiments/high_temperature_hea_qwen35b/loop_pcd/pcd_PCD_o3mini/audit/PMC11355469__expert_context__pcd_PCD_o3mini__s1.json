  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin film on a conventional steel substrate.",
      "field": "material_initial_state; baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is pre-oxidation annealing in air at 700 °C for 1 hour.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation annealing will form a dense, stable, and adherent oxide scale on the FeNiCrCoCu coating.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidation scale will be enriched in copper oxides.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper oxides become enriched in the scale because of their lower oxidation affinity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An oxide film can act as a lubricious layer that lowers interfacial shear strength and friction.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9960858::web::012::3_2_friction_coefficient",
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidized scale will increase the surface hardness of the FeNiCrCoCu coating.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lubricating and hardening effects of the scale will mitigate adhesive and oxidative wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::012::3_2_friction_coefficient",
        "PMC9960858::web::017::3_4_worn_track_morphology_and_wear_mecha",
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adhesive wear and oxidative wear are relevant high-temperature sliding-wear mechanisms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9960858::web::017::3_4_worn_track_morphology_and_wear_mecha"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidized coating will have a significantly lower wear rate than the as-deposited coating.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidized coating will have a lower friction coefficient than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::012::3_2_friction_coefficient",
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidized coating will exhibit smoother wear-track morphology than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will retain greater surface hardness than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
