        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy can be prepared with Ce additions by vacuum-arc melting.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9608590::web::000::abstract",
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid solidification will limit segregation in the Ce-doped alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ce-free baseline has a dendritic morphology.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9608590::web::000::abstract",
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Ce-free baseline contains coarse secondary-phase precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ce-free baseline has high compressive strength and marked impact-induced energy release.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ce-free baseline has limited ductility and localized, nonuniform deformation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ce doping produces Ce-rich FCC regions within an alloy whose matrix is BCC.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9608590::web::000::abstract",
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ce doping refines the secondary phases and makes their distribution more uniform.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ce doping alters dislocation mobility.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A finer dispersion of FCC precipitates modulates dislocation locking and motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed phase and dislocation changes reduce local stress concentrations and promote homogeneous plastic flow.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized Ce doping will increase fracture strain relative to the Ce-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Optimized Ce doping will produce more uniform deformation relative to the Ce-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized Ce doping will retain compressive strength within 5% of the Ce-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ce doping will retain or improve impact-induced energy-release performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9608590::web::000::abstract",
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvement will hold only for Ce contents in the proposed 15–20 at.% range under rapid-solidification conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ce contents above the proposed range may cause excessive softening.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9608590::web::000::abstract",
        "PMC9608590::web::013::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is falsified unless Ce doping gives a statistically significant ductility increase, exemplified by greater than 10%, while limiting compressive-strength and energy-release losses to less than 5% relative to a Ce-free control.",
