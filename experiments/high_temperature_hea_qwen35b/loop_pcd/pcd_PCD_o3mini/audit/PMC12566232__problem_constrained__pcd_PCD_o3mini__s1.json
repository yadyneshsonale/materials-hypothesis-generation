  "claims": [
    {
      "text": "The starting material is an as-cast HfZrTiTa0.53 refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a quasi-static yield strength of approximately 786 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a quasi-static compressive strength of approximately 1314 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a quasi-static fracture strain of approximately 13.5%.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is aging at about 1000°C for 2 hours followed by rapid quenching.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "This aging treatment will produce a uniform dispersion of nanoscale B2 or carbide precipitates in the alloy's BCC matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction",
        "PMC7516913::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoscale precipitates will obstruct dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11233735::web::001::introduction",
        "PMC7516913::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Obstruction of dislocation glide by the precipitates will increase strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction",
        "PMC7516913::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The increased strain hardening will improve uniform deformation by delaying strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitate-strengthened microstructure will suppress or delay adiabatic shear-band formation under dynamic loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging will increase yield strength by approximately 15–20% relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516913::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Aging will improve compressive strength relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction",
        "PMC7516913::web::025::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Aging will increase fracture strain from 13.5% to above 17%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Delayed adiabatic shear banding will produce more controlled impact-induced energy release.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction is restricted to adiabatic dynamic compression at strain rates from 1000 to 3000 s^-1.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Overaging or excessive precipitation could embrittle the alloy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis will be tested by comparing aged and as-cast specimens at 1000, 2000, and 3000 s^-1 using matched dynamic compression tests.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is rejected if aging fails to produce statistically significant increases of at least 15% in both yield strength and fracture strain, or if aging causes earlier or more pronounced adiabatic shear bands.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
