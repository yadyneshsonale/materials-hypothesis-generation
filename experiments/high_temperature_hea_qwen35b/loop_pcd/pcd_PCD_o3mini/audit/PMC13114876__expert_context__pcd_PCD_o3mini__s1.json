      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::009::3_1_microstructure_characterization_of_h",
        "PMC12565319::web::019::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron addition refines the BCC phase while retaining the coating's BCC and sigma base phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
