      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Appropriate boron addition stabilizes the passive film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::019::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fine TiB2 particles reduce wear by acting as load-bearing reinforcement.",
