      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::019::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The refined TiB2-containing microstructure improves passive-film adherence and limits defect formation, thereby slowing corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::019::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined wear-reinforcement and passive-film effects govern the coupled tribo-corrosion response.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A boron level around 1 wt% should provide the greatest wear resistance relative to the no-boron baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract",
        "PMC12565319::web::019::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A boron level around 1 wt% should decrease corrosion current density relative to the no-boron baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A boron level around 1 wt% should significantly reduce total coupled tribo-corrosion degradation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
