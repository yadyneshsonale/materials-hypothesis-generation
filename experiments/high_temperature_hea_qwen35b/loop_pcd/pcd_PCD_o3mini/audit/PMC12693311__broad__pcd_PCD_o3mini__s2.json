  "claims": [
    {
      "text": "Rapid melt-spinning under an inert atmosphere can produce an amorphous Cr16Mn16Fe16Co16Ni16P20 alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8219663::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing Cr16Mn16Fe16Co16Ni16P20 at 75–85% of its measured Tg for 10–20 minutes will promote controlled atomic relaxation.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8219663::web::002::introduction",
        "PMC9023469::web::008::the_glass_to_glass_transition_and_the_gl"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The sub-Tg annealing treatment will reduce high-energy free-volume defects in the amorphous alloy.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The sub-Tg annealing treatment will enhance short-range atomic ordering.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9023469::web::008::the_glass_to_glass_transition_and_the_gl"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heat treatment can transform a high-energy metallic glass into a lower-energy glass through structural rearrangement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9023469::web::008::the_glass_to_glass_transition_and_the_gl"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Sub-Tg annealing relieves structural stresses in Cr16Mn16Fe16Co16Ni16P20.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Healing free-volume defects lowers the density of potential crystallization-nucleation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed alloy will have greater thermal stability than the otherwise comparable as-quenched alloy.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9023469::web::008::the_glass_to_glass_transition_and_the_gl"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Post-quench annealing will improve the effective glass-forming ability of the alloy relative to the as-quenched state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed alloy will exhibit a higher DSC crystallization-onset temperature than the as-quenched control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed alloy will exhibit a more uniform amorphous structure detectable by XRD and TEM.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert annealing atmosphere is necessary to prevent oxidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing near but below Tg can permit structural relaxation without causing crystallization.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8219663::web::002::introduction",
        "PMC9023469::web::008::the_glass_to_glass_transition_and_the_gl"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Exceeding 85% of Tg or extending annealing beyond the proposed duration can trigger partial or complete crystallization.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Small deviations from the proposed annealing window may either eliminate the benefit or cause unwanted crystallization.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
