      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationships are expected to hold within 0–10 at.% Pd for material annealed at 800°C and measured near room temperature.",
