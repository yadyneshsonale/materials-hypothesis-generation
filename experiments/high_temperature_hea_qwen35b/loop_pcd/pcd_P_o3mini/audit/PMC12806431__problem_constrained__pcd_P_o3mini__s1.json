      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature mechanical loading in an oxygen-rich environment promotes preferential oxygen diffusion along grain boundaries in CoCrFeNiAl.",
