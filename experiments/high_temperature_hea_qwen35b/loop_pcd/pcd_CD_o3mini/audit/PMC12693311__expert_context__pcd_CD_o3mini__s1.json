    },
    {
      "text": "The base alloy was processed by melt-spinning.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "yes"
    },
    {
      "text": "The base alloy was produced by standard arc melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The base alloy exhibits limited amorphous retention under conventional cooling conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "yes"
    },
    {
      "text": "The base alloy exhibits a complex multiphase crystalline response during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt-spinning the base alloy at approximately 10^5–10^6 K/s produces an amorphous structure.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 2–4 at% boron to the base alloy will improve its glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–4 at% boron will improve the alloy's thermal stability during reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will enhance chemical disorder and stable short-range order in the alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron–phosphorus linkages may form in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-induced short-range order will disrupt nucleation and growth of crystalline phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron atoms have sufficiently small atomic size and strong bonding tendencies to interfere with long-range atomic ordering in this alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron-induced topological and chemical frustration will raise the kinetic barrier to crystallization during rapid cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-induced frustration will reduce recrystallization during reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the undoped alloy, the boron-modified alloy will retain a more robust amorphous structure under rapid cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the undoped alloy, the boron-modified alloy will have a delayed crystallization onset during reheating at about 10 K/min.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will exhibit reduced DSC exothermic peaks relative to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive boron may cause boride precipitation that compromises the amorphous state.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact boron solubility limit and precipitation threshold in this alloy are unknown and require experimental calibration.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed boron mechanism is supported by analogous alloy systems.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
