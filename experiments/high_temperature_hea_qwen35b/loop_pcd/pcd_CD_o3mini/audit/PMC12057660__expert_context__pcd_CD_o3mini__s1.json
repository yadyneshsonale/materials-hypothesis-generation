        "PMC10171813::web::004::one_pot_synthesis_of_phase_separated_mul",
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Early-forming nuclei produced during asynchronous reduction grow separately.",
