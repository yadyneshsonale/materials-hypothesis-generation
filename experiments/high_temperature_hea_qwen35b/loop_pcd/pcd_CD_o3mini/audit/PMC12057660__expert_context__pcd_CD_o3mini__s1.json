  "claims": [
    {
      "text": "Successful formation of homogeneous noble metal–based high-entropy alloy nanoparticles is governed by synchronization of nucleation events.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
