      ],
      "same_system": "yes"
    },
    {
      "text": "Precisely tuning the reducing environment can make the reduction kinetics of all metal precursors converge.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Near-simultaneous generation and incorporation of all metal atoms minimizes phase separation and elemental segregation.",
      "field": "hypothesis",
