      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Asynchronous reduction leads to phase-separated products because the different precursors generate atoms sequentially.",
