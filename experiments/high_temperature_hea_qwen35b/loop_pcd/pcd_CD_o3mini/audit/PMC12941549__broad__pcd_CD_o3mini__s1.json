      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion restricts dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted dislocation motion preserves or increases mechanical strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower diffusion of oxidizable species facilitates formation of a uniform, adherent oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stable protective oxide layer can improve corrosion and oxidation resistance in HEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12348563::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
