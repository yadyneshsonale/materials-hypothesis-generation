      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ALD at the stated conditions will produce atomically dispersed Pt sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "La doping increases the concentration of oxygen vacancies in CeO2-ZrO2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mild calcination anchors Pt atoms at oxygen-vacancy and defect sites.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacancy-anchored Pt develops a strong metal-support interaction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112814::web::000::abstract",
        "PMC12112814::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The strong metal-support interaction prevents Pt sintering during high-temperature redox cycling.",
