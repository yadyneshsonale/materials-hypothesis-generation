      ],
      "same_system": "no"
    },
    {
      "text": "The La-doped CeO2-ZrO2 support will contain abundant oxygen vacancies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
