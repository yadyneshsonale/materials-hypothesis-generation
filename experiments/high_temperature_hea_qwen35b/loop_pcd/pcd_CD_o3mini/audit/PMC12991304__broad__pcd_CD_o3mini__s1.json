      "supporting_ids": [
        "PMC12112814::web::015::3_2_physico_chemical_characterization_of"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventionally impregnated Pt on undoped CeO2-ZrO2 requires higher Pt loading to achieve similar performance.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
