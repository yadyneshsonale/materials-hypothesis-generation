      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112814::web::015::3_2_physico_chemical_characterization_of",
        "PMC12112814::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed catalyst will match or exceed the catalytic conversion rates of a conventionally impregnated Pt/undoped-CeO2-ZrO2 catalyst.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed catalyst will maintain higher turnover frequencies than the conventional baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed catalyst will show less Pt agglomeration during extended redox cycling than the conventional baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112814::web::015::3_2_physico_chemical_characterization_of",
        "PMC12112814::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed catalyst will achieve comparable or better performance with reduced Pt content.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally impregnated Pt on undoped CeO2-ZrO2 suffers from Pt sintering.",
