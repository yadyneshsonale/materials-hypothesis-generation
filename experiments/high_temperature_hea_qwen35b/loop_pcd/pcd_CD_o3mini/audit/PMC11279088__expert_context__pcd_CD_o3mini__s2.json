        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Mn-bearing oxides do not effectively limit continued oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
