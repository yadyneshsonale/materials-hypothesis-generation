  "claims": [
    {
      "text": "Standard thermal spraying of 15–45 μm FeCoNiCrAl feedstock produces inadequate coating thickness because of incomplete melting and limited splat cohesion.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inline preheating before plume injection will bring the 15–45 μm FeCoNiCrAl particles to a partially or semi-molten state.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A more molten particle state promotes improved splat flattening.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5849017::web::024::3_2_1_surface_morphology"
      ],
      "same_system": "no"
    },
    {
      "text": "Preheating improves intersplat bonding in the FeCoNiCrAl coating.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved splat flattening and intersplat bonding produce a denser and thicker coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Particle preheating reduces the thermal gradient upon impact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced impact thermal gradient enables more effective particle melting and flattening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature exposure to oxygen during spraying causes in-flight oxidation of HEA particles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10820071::web::005::1_introduction",
        "PMC10820071::web::010::3_2_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "An argon or other inert-gas shroud around the preheating stage minimizes particle oxidation.",
      "field": "hypothesis; intervention; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::010::3_2_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "Suppressing oxidation preserves the chemical integrity and microstructure of the bond coat.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::005::1_introduction",
        "PMC10820071::web::010::3_2_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "Inline preheating with an inert shroud increases effective coating thickness relative to the standard 15–45 μm-feedstock process.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified process produces a denser coating with improved cohesion and adhesion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified process maintains minimal as-sprayed oxidation compared with conventional deposition.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::005::1_introduction",
        "PMC10820071::web::010::3_2_oxidation_and_phase_transformations_"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention remains effective under conventional atmospheric plasma-spray conditions if the inert shroud is robust and preheating parameters are optimized.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Feedstock variability or deviations in spray parameters may reduce the intervention's effectiveness.",
      "field": "boundary",
