  "claims": [
    {
      "text": "Premelting and melting in CoCrFeNiCu nanoparticles are governed primarily by enhanced atomic mobility at free surfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract",
        "PMC7733500::web::020::in_situ_thermal_stability_analysis_on_jo"
      ],
      "same_system": "no"
    },
    {
      "text": "An inert conformal oxide or nitride coating raises the effective surface-energy barrier of CoCrFeNiCu nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Raising the surface-energy barrier delays the onset of premelting.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Raising the surface-energy barrier produces a sharper melting transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effective surface-energy barrier regulates the rate of atomic diffusion at the nanoparticle surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract",
        "PMC7733500::web::020::in_situ_thermal_stability_analysis_on_jo"
      ],
      "same_system": "no"
    },
    {
      "text": "Bare CoCrFeNiCu nanoparticles have enhanced atomic mobility at their free surfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7733500::web::020::in_situ_thermal_stability_analysis_on_jo"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced free-surface mobility causes bare nanoparticles to premelt at lower temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert coating restricts surface diffusion in CoCrFeNiCu nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting surface diffusion makes melting more spatially uniform.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated nanoparticles will have a higher premelting-onset temperature than otherwise comparable uncoated nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated nanoparticles will have a more abrupt melting transition than otherwise comparable uncoated nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface atomic diffusion is unimpeded in the uncoated CoCrFeNiCu baseline.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should hold for CoCrFeNiCu nanoparticles with sizes on the order of tens of nanometers.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should hold under inert conditions at temperatures up to 800 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating may introduce secondary changes in thermal conductivity or mechanical stress that could affect the observed thermal behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
