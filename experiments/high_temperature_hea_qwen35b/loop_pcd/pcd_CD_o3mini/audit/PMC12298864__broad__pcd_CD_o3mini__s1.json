  "claims": [
    {
      "text": "The studied alloy is equiatomic CoCrFeMnNi.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial CoCrFeMnNi alloy is a single-phase, uniform random solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 800°C for 10 hours followed by rapid quenching enhances SRO in CoCrFeMnNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching from 1200°C produces a maximally disordered CoCrFeMnNi baseline with lower SRO.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced SRO generates atomic-scale local compositional fluctuations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::015::dislocation_and_strengthening"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Chemical SRO creates obstacles to dislocation glide and strengthens local dislocation pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7921137::web::015::dislocation_and_strengthening"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SRO-induced obstacle landscape increases dislocation waviness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7921137::web::015::dislocation_and_strengthening"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Stronger dislocation pinning caused by SRO increases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::015::dislocation_and_strengthening",
        "PMC9645729::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Stronger dislocation pinning caused by SRO increases hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 800°C-treated samples will have significantly higher yield strength than the 1200°C-quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::015::dislocation_and_strengthening",
        "PMC9645729::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The 800°C-treated samples will have significantly higher hardness than the 1200°C-quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical strength correlates with the measured degree of SRO.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9645729::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The strengthening correlation persists only up to a critical SRO threshold.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Beyond the critical ordering threshold, long-range ordering or phase separation may emerge and change the strengthening mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies only while the alloy remains a single-phase solid solution without precipitation or long-range ordering.",
