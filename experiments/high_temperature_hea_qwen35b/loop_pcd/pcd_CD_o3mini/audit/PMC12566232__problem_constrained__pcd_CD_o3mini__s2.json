  "claims": [
    {
      "text": "Baseline HfZrTiTa0.53 has a quasi-static yield strength of 786 MPa, compressive strength of 1314 MPa, and fracture strain of 13.5%.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline HfZrTiTa0.53 has limited strain hardening, poor uniform deformability, and rapid failure at high strain rates.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is to add less than 0.5 at.% carbon during arc melting, homogenize at approximately 1200 °C for 1 hour, and rapidly quench.",
      "field": "intervention; conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A carbon addition below 0.5 at.% will produce a uniform nanoscale dispersion of TaC and/or HfC in HfZrTiTa0.53.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching after the stated homogenization treatment will retain a fine dispersion of incipient carbides.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale carbides will obstruct dislocation motion through the Orowan mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction",
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "Obstruction of dislocation motion by the carbides will enhance strain hardening in carbon-modified HfZrTiTa0.53.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The fine precipitate dispersion will delay the nucleation and propagation of adiabatic shear bands.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "Delayed shear-band development will promote more homogeneous plastic flow and improve uniform deformability.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitate dispersion will mitigate abrupt impact-induced energy release during dynamic deformation.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbon-modified alloy will have approximately 15–20% higher yield strength than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11233735::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbon-modified alloy will increase fracture strain from 13.5% to approximately 15–18%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified alloy will exhibit greater resistance to dynamic strain localization than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "The predicted benefits apply under nominally adiabatic dynamic compression at strain rates from 10^3 to 10^4 s^-1.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive carbide coarsening could cause embrittlement or earlier shear-band formation.",
      "field": "boundary; falsification_experiment",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::015::3_3_mechanical_properties_of_ti40zr40mo1"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed experiment compares identically processed baseline and carbon-modified specimens under matched dynamic-compression conditions.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
