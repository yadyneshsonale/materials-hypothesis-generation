      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has a room-temperature compressive yield strength of approximately 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy's reduced plasticity is associated with high Mo content and Mo-induced local electronegativity differences.",
