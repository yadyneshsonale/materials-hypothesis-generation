  "claims": [
    {
      "text": "Adding 2–3 at.% Ti to MoNbTaW will promote formation of Ti-based carbide and/or nitride precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ti-based precipitates will be fine, nanoscale, and uniformly dispersed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial MoNbTaW alloy is predominantly a single-phase BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::015::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Conventionally processed baseline MoNbTaW lacks deliberate secondary precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled heat treatment after Ti addition will promote nucleation of fine precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-based nanoprecipitates will reinforce the BCC matrix through dispersion strengthening and obstruction of dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ti-based nanoprecipitates will act as sinks that trap irradiation-induced point defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trapping point defects at the precipitates will limit irradiation damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed precipitate population will resist thermal coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::015::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ti-modified alloy will have greater hardness than unmodified MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::004::introduction",
        "PMC7517255::web::015::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ti-modified alloy will have greater yield strength than unmodified MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ti-modified alloy will have greater toughness than unmodified MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical improvements will persist at service temperatures above 1000°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::015::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical improvements will persist following irradiation representative of reactor conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti addition will preserve the alloy's thermal and irradiation stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::015::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The benefits occur specifically within a narrow Ti-addition window of 2–3 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess Ti may produce coarse precipitates or continuous secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse precipitates or continuous secondary phases caused by excess Ti may reduce ductility and stability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate size, distribution, and coherence depend sensitively on processing parameters and heat-treatment schedules.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
