  "claims": [
    {
      "text": "The conventional cast AlCoCrFeNi-based eutectic high-entropy alloy has a dual-phase microstructure containing numerous internal phase boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::010::the_role_of_phase_boundary_in_second_pha"
      ],
      "same_system": "yes"
    },
    {
      "text": "The internal boundaries are arranged as lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The internal lamellar-colony boundaries are prone to microcrack nucleation during room-temperature tensile deformation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.5 at.% boron during casting will form finely dispersed nanoprecipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-induced nanoprecipitates will preferentially form along lamellar-colony boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A controlled slow cooling rate will promote controlled boron segregation and a uniform distribution of nanoprecipitates along internal colony interfaces.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boundary nanoprecipitates will pin the internal interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron addition will improve cohesion at the internal lamellar-colony boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Improved interfacial cohesion will resist microcrack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-induced precipitates will obstruct dislocation motion and provide precipitation hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will have higher yield strength than the unmodified lamellar-colony baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will have improved room-temperature tensile ductility relative to the unmodified baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The simultaneous strength and ductility improvement is contingent on keeping the boron concentration near 0.5 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive boron segregation or brittle intermetallic formation can negate the intended mechanical-property improvements.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
