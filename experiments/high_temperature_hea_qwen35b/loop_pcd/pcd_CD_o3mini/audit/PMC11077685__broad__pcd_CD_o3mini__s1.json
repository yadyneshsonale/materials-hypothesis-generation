  "claims": [
    {
      "text": "Adding approximately 2 at.% Hf to a MoNbTaW-based refractory high-entropy alloy will enhance its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf addition will promote nucleation of an Hf-rich oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition will stabilize an Hf-rich oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will form a mixed protective scale containing Hf-rich oxide and alumina.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alumina in the proposed scale will originate from inherent or nearly added Al in the alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Hf acts as an oxygen scavenger.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf reduces oxygen diffusivity during oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced oxygen diffusivity promotes formation of a slow-growing oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf produces a more adherent oxide layer through a reactive-element effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide layer protects the substrate by impeding further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction",
        "PMC6804173::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-doped alloy will have a significantly lower oxidation rate than untreated MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-doped alloy will have better oxide-scale adherence than untreated MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-doped alloy will exhibit less oxidation-related weight gain than untreated MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction",
        "PMC6804173::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-doped alloy will preserve its mechanical properties better than untreated MoNbTaW after oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated MoNbTaW forms less stable or less adherent oxide scales under comparable conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxidation-resistance improvement should occur during exposure at 1150°C for 50 hours in flowing oxygen.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
