  "claims": [
    {
      "text": "The untreated NbMoTaW alloy has a predominantly uniform, coarse-grained microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hot forging at 0.5–0.6 Tm, rapid quenching, and subsequent cold working can produce a controlled bimodal grain-size distribution in NbMoTaW.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::004::1_introduction",
        "PMC9506522::web::013::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid quenching will lock in the desired microstructural features.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In situ process monitoring will enable sufficiently precise deformation control to obtain the targeted bimodal microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting microstructure will contain both coarse grains and ultrafine grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::000::abstract",
        "PMC9506522::web::013::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "no"
    },
    {
      "text": "Cold working will induce the ultrafine-grained regions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::013::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "no"
    },
    {
      "text": "The coarse-grained regions will preserve the alloy's load-bearing capacity and high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coarse-grained regions will prevent a loss of impact-induced energy release.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultrafine-grained regions will activate grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultrafine-grained regions will activate additional plastic-deformation mechanisms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Combining coarse and ultrafine regions will make plastic deformation more uniform.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed processing route will significantly increase tensile ductility relative to conventionally processed NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed processing route will improve uniform deformability relative to conventionally processed NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ductility improvement will occur without a significant reduction in yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The ductility improvement will occur without compromising impact-induced energy release.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniform coarse-grained NbMoTaW typically has high strength and energy release but low ductility and non-uniform deformation under dynamic loading.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Departures from the specified temperature regime or quench rate may produce an inconsistent bimodal structure or degraded mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Omitting in situ monitoring may produce an inconsistent bimodal structure or degraded mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
