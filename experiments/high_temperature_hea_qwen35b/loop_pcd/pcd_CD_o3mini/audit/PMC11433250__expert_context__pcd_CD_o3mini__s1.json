  "claims": [
    {
      "text": "The starting material is high-purity, single-phase ZrB2 powder with controlled particle size and minimal impurities.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 3 wt% Si is to be homogeneously dispersed in the ZrB2 starting powder.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 3 wt% Si enables ZrB2 densification at 1600–1700 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional single-phase ZrB2 requires sintering temperatures above 2300 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniformly distributed Si forms a Si-rich grain-boundary phase in ZrB2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-rich grain-boundary phase transforms in situ into a continuous SiO2 layer during high-temperature exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si enhances grain-boundary diffusion and thereby acts as a sintering aid for ZrB2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An added reactive element can diffuse toward a surface and form its oxide during high-temperature oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Si preferentially oxidizes during high-temperature service to form a protective SiO2 film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SiO2 film inhibits oxygen ingress into the ZrB2 substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SiO2 film prevents molten plating metal from reacting with the ZrB2 matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will achieve near-theoretical density after consolidation at 1600–1700 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will maintain superior mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will have better oxidation resistance than both ZrB2 conventionally sintered above 2300 °C and prior lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will have lower liquid-metal corrosion than both conventionally sintered ZrB2 and prior lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable to SPS or hot pressing at 1600–1700 °C under an inert atmosphere.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting material is applicable in oxidizing service environments up to 1400 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting material is applicable to prolonged exposure to molten plating metals such as aluminum.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
