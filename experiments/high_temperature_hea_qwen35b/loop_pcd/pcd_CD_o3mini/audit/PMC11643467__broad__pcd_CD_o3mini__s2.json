      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10744552::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitate obstruction of dislocations will improve mechanical durability.",
