      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating will increase the ductility of LPBF AlCrFeNiSi relative to a room-temperature-substrate control.",
