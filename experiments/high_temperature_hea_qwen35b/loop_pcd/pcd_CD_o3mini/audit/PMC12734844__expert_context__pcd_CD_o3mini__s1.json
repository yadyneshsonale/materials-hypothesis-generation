      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reduced cooling rates promote more uniform grain growth in AlCrFeNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower cooling enhances solute diffusion and reduces concentration gradients and microsegregation in AlCrFeNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal gradients and moderated cooling reduce thermally induced residual stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
