  "claims": [
    {
      "text": "A substrate temperature of 600–700 °C is an optimized preheating range for LPBF of cobalt-free AlCrFeNiSi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating the substrate decreases the temperature differential between the melt pool and underlying material.",
