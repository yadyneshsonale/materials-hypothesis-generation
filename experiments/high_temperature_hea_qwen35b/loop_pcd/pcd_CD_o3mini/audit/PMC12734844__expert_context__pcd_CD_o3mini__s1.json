      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Raising the build temperature reduces cooling rates and thermal gradients.",
