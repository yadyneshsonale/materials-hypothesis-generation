  "claims": [
    {
      "text": "Cold-spray deposition of a WC-Ni composite on a nickel-based superalloy will form a dense coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The cold-sprayed WC-Ni coating will adhere strongly to the nickel-based superalloy substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WC-Ni coating will mechanically reinforce the surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction",
        "PMC11433176::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The WC-Ni coating will significantly increase surface hardness relative to untreated Inconel 718 or another nickel-based superalloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction",
        "PMC11433176::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The WC-Ni coating will significantly reduce wear relative to the untreated substrate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction",
        "PMC11433176::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The WC-Ni coating will improve corrosion resistance relative to the untreated substrate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized particle velocities will provide mechanical interlocking while maintaining low thermal input during deposition.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will be a nanostructured composite layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC particles will be uniformly dispersed and mechanically embedded in a nickel matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High particle-impact kinetic energy will cause severe plastic deformation near the coating-substrate interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impact-induced plastic deformation will refine substrate grains near the interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impact-induced deformation will establish strong mechanical interlocking between the coating and substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Embedded WC particles impart hardness and act as mechanical reinforcements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction",
        "PMC11433176::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Hard WC particles can restrict grain growth and thereby promote matrix hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The nickel matrix will alleviate residual stresses in the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A post-deposition heat treatment below 600 degrees Celsius will reduce internal stresses without degrading the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hardness, wear, and corrosion improvements will persist under high-temperature and corrosive operating conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433176::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Severe thermal mismatch, excessive cyclic stress, or extreme thermal shock could compromise coating adhesion and performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the mechanical and corrosion improvements depends on particle velocity, coating thickness, and post-treatment conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term durability under cyclic thermal and mechanical loading is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
