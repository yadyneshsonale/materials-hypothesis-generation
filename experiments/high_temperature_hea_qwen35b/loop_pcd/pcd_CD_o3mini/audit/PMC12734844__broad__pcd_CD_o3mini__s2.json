  "claims": [
    {
      "text": "Standard SLM of AlCoCrFeNi commonly uses pre-alloyed powder on a cold or mildly preheated build plate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6385271::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cold or mildly preheated SLM processing of AlCoCrFeNi produces relatively high thermal gradients and associated defects.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr",
        "PMC6385271::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Maintaining the build plate at 250–300 °C during SLM of AlCoCrFeNi will reduce the temperature differential and thermal gradients relative to cold or 200 °C processing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elevated build-space or build-plate temperature lowers cooling rates during additive manufacturing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reduced thermal gradients from preheating will lower residual-stress accumulation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11807212::web::018::materials_fabrication",
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "no"
    },
    {
      "text": "A more uniform solidification thermal field will refine the AlCoCrFeNi grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396468::web::035::3_5_3_temperature_field_analysis"
      ],
      "same_system": "yes"
    },
    {
      "text": "Build-plate preheating at 250–300 °C will produce a more equiaxed AlCoCrFeNi grain structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated build temperature will reduce cracking by lowering cooling rates and thermal gradients.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr",
        "PMC6385271::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Build-plate preheating at 250–300 °C will reduce porosity in SLM AlCoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Build-plate preheating at 250–300 °C will reduce distortion in SLM AlCoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating at 250–300 °C will significantly improve the dimensional accuracy of SLM AlCoCrFeNi relative to cold or 200 °C builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating at 250–300 °C will improve interlayer bonding in SLM AlCoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating at 250–300 °C will improve the strength and ductility of SLM AlCoCrFeNi relative to the stated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An argon atmosphere with oxygen below 300 ppm minimizes oxidation during LPBF.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11807212::web::018::materials_fabrication"
      ],
      "same_system": "no"
    },
    {
      "text": "A 200 °C build-plate baseline typically has higher residual stress and more cracking and porosity than the proposed 250–300 °C process.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exceeding the proposed preheating window may cause microstructural coarsening or oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder characteristics and machine parameters may alter the optimal preheating temperature and resulting performance.",
      "field": "uncertainty",
