        "PMC5043342::web::013::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The high-temperature BCC phase of Cr39Co18Fe18Ni18Al7 is metastable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
