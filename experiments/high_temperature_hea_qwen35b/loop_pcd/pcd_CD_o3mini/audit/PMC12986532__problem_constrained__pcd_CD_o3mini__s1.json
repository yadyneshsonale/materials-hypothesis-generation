      "supporting_ids": [
        "PMC7512559::web::000::abstract",
        "PMC7512559::web::022::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitate formation will reduce the steady-state creep strain rate relative to the unaged baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::web::000::abstract",
        "PMC7512559::web::022::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Aged coatings will exhibit a delayed onset of tertiary creep relative to unaged coatings.",
