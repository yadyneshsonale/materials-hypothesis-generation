      "support": "partial",
      "supporting_ids": [
        "PMC7512559::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will act as pinning centers that obstruct dislocation nucleation and motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::web::000::abstract",
        "PMC7512559::web::022::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will restrict grain-boundary sliding.",
