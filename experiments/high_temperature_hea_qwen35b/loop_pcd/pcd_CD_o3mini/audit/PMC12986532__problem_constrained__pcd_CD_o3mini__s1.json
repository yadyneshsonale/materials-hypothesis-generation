      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Isothermal aging at approximately 600 °C for 1 hour in an inert atmosphere will produce uniform nanoscale precipitates.",
