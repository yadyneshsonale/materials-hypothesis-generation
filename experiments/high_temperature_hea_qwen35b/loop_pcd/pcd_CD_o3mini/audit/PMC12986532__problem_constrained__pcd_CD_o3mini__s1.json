      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::web::000::abstract",
        "PMC7512559::web::022::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Stress-assisted dislocation climb is relevant to creep deformation in high-entropy alloys.",
