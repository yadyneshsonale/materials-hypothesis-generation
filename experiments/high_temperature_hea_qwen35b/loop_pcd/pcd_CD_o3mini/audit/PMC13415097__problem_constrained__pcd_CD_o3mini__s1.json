  "claims": [
    {
      "text": "The experimental material is an as-deposited, non-equiatomic FeMnNiGeSi thin film.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Otherwise identical FeMnNiGeSi films will be deposited on sapphire and SiO2 substrates.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sapphire provides a higher-thermal-conductivity substrate than SiO2.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The substrate thermal boundary condition governs the film's local temperature evolution during magnetic-cooling cycles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing substrates can alter the structure of sputtered multicomponent films.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8999901::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "If strain is controlled, changing the substrate will minimally alter the film's intrinsic microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high-thermal-conductivity substrate will extract heat from the film more rapidly during cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More rapid heat extraction will reduce thermal lag in the film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal lag will lower the effective energy barrier for magnetic-domain reversal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower effective domain-reversal barriers will reduce magnetic hysteresis.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Films on sapphire will have narrower magnetic hysteresis than the low-conductivity-substrate baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Films on sapphire will exhibit a sharper and more immediate magnetocaloric temperature response than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The substrate-dependent difference will become more pronounced as cycling frequency increases because heat-transfer limitations become more important.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies at applied magnetic fields below 500 Oe.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies from quasi-static cycling through frequencies of a few hertz.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the substrate effect may vary with film thickness and unintentional strain.",
      "field": "uncertainty",
      "needs_support": true,
