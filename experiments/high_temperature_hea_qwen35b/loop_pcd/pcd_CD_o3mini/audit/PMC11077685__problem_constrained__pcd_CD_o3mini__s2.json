      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::web::020::4_3_corrosion_resistance"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina scale will act as a barrier against oxygen diffusion into HfNbTaTiZr at approximately 1000°C in air.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminization treatment will not alter the alloy's bulk microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will significantly improve oxidation resistance during prolonged high-temperature exposure relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will preserve the untreated alloy's room-temperature ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will preserve the untreated alloy's high-temperature yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The expected operating boundary is approximately 1000°C in air under loading at strain rates of 10^(-4)–10^(-2) s^(-1).",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
