      "supporting_ids": [
        "PMC11413244::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive substitution or heat-treatment deviations may cause a more pronounced loss of strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if the modified alloy retains less than approximately 95% of 1719 MPa yield strength or fails to improve uniform plastic strain by at least 30% relative to the x = 0 control.",
