  "claims": [
    {
      "text": "The solution-treated CoCrFeMnNi starting alloy has a single-phase FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Nb or Ti to CoCrFeMnNi and applying controlled aging will induce fine, coherent L12 precipitates in the FCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting L12 precipitate dispersion will be thermally stable.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at approximately 800 °C for three hours is suitable for producing the intended L12 dispersion in Nb- or Ti-modified CoCrFeMnNi.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimization of the aging process can prevent detrimental precipitate coarsening.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095688::web::036::4_3_precipitates_properties_and_evolutio"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine, coherent L12 precipitates impede dislocation motion in the FCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::030::conclusions_and_summary",
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed L12 precipitates strengthen the alloy through Orowan bypassing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8836748::web::018::4_1_elongation_behavior_of_the_alloys_at"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitate dispersion stabilizes the microstructure and thereby inhibits creep deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will notably increase elevated-temperature yield strength relative to the as-cast or solution-treated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will improve creep resistance relative to the as-cast or solution-treated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength and creep benefits will persist throughout 700–900 °C, including at temperatures up to 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated as-cast or solution-treated baseline has minimal precipitation-based strengthening.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate growth and coarsening can create mechanically weak regions, so suppressing this behavior should benefit mechanical properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10095688::web::036::4_3_precipitates_properties_and_evolutio"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Prior evidence supports precipitation strengthening by nanoscale L12 particles in an FCC-based high-entropy alloy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC6478865::web::030::conclusions_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact improvement and long-term thermal stability under service conditions remain unquantified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095688::web::036::4_3_precipitates_properties_and_evolutio"
