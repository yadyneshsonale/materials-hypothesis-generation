  "claims": [
    {
      "text": "The starting AlCoCrFeNi2.1 alloy has a uniform, fine lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy has insufficient strength and plasticity for demanding industrial fastener applications.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pulsed laser surface remelting should be applied to the top 10–20 µm of the alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The laser process should produce a cooling rate on the order of 10^5 K/s while minimally heating the bulk.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser remelting will create an ultrafine or nanograined duplex surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The remelted surface layer will contain compressive residual stresses.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The remelted layer will be seamlessly bonded to the underlying fine lamellar matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid, non-equilibrium solidification during laser remelting refines the grain size.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refinement into the nano- or ultrafine-grained regime increases strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Compressive residual stresses increase fatigue resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined surface microstructure promotes a more homogeneous passive film and thereby improves corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser treatment will improve surface hardness relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser treatment will increase yield strength relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser treatment will enhance fatigue life relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser treatment will reduce room-temperature creep relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser treatment will reduce corrosion rates in chloride-containing environments.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated AlCoCrFeNi2.1 has unsatisfactory corrosion resistance in chloride-containing sulfuric acid at elevated temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::web::014::3_2_electrochemical_analysis"
      ],
      "same_system": "yes"
    },
    {
      "text": "At elevated temperature, the alloy's passive film becomes relatively poorly protective and shows behavior associated with metastable pitting.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::web::014::3_2_electrochemical_analysis"
      ],
      "same_system": "yes"
    },
    {
      "text": "Because only the top 10–20 µm is treated, the bulk properties remain governed by the underlying lamellar structure.",
      "field": "boundary",
