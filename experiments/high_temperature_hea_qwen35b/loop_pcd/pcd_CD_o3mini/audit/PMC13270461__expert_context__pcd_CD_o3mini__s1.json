      "support": "partial",
      "supporting_ids": [
        "PMC12842681::web::036::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The as-built alloy contains grain-boundary compositional heterogeneities.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842681::web::036::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary enrichment or depletion of reactive elements causes uneven oxide-scale nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Non-uniform oxide formation caused by microsegregation accelerates high-temperature degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
