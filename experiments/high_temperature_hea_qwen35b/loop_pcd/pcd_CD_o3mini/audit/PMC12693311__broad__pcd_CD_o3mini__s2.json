  "claims": [
    {
      "text": "The target material is a phosphorus-containing high-entropy alloy with the Fe-Co-Ni-Cr-P alloy system.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally melt-spun Fe-Co-Ni-Cr-P has an amorphous baseline structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing the melt-spinning cooling rate by approximately 50% will improve glass-forming ability relative to the baseline rate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing the melt-spinning cooling rate by approximately 50% will raise the crystallization onset temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 50% increase in wheel speed will produce an approximately 50% increase in cooling rate while other processing parameters remain fixed.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated quenching will produce a more highly disordered atomic configuration.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "Accelerated quenching will suppress medium-range order.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A higher cooling rate reduces the time available for atomic diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced diffusion time traps the atoms in a disordered state.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The trapped disordered state delays nucleation of crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Kinetic hindrance from rapid cooling improves amorphization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::010::2_materials_and_methods"
      ],
      "same_system": "no"
    },
    {
      "text": "Kinetic hindrance from rapid cooling enhances the thermal stability of the amorphous state.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher-rate sample will have a more uniform amorphous structure than the baseline sample.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD and TEM can characterize structural changes associated with amorphization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "TEM can assess the degree of medium-range order in these samples.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
