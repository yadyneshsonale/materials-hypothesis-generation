  "claims": [
    {
      "text": "A thin, uniform chromium-rich coating can be applied to zirconium-alloy cladding by PVD.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A graded interlayer or adhesion promoter will improve bonding between the chromium-rich coating and zirconium-alloy cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The chromium-rich coating will form a continuous Cr2O3 layer during high-temperature exposure.",
