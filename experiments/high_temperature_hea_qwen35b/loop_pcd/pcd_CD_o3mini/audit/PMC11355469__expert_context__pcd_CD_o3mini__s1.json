  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin-film protective coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetron-sputtered FeNiCrCoCu coatings typically have a nanocrystalline microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4510962::web::011::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing at 600°C in a controlled oxygen atmosphere for 30 minutes will pre-oxidize the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8200011::web::019::3_2_aerated_testing"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled pre-oxidation will form a continuous nanocrystalline Cr-rich oxide network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8200011::web::019::3_2_aerated_testing"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-rich oxide network will form preferentially along coating grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation of Cr in FeNiCrCoCu promotes formation of an adherent oxide along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8200011::web::019::3_2_aerated_testing"
      ],
      "same_system": "no"
    },
    {
      "text": "The grain-boundary oxide network pins and stabilizes the coating microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4510962::web::011::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide network limits grain-boundary sliding during high-temperature wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide network mitigates microcrack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-rich oxide network acts as a self-healing barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural stabilization, reduced grain-boundary sliding, and reduced cracking enhance overall high-temperature wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will lower the coating's wear rate relative to the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will lower the friction coefficient relative to the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After wear, the pre-oxidized coating will retain a continuous Cr-rich oxide network along its grain boundaries.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies to sliding wear at 500–700°C under service-relevant coating loads.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aggressive oxidation can produce an excessively brittle oxide layer that may undermine protection.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8200011::web::019::3_2_aerated_testing"
      ],
      "same_system": "no"
