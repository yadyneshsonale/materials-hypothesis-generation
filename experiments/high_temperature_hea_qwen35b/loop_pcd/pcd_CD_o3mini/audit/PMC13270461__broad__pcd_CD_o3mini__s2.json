      "text": "Composition-induced reductions in simulated diffusion barriers will correlate with improved experimental oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
