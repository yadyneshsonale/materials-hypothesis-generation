      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will be coherent with the FCC matrix and uniformly distributed.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6170471::web::011::discussion",
        "PMC6170471::web::023::estimation_of_strengthening_by_various_m"
      ],
      "same_system": "no"
    },
