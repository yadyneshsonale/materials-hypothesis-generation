      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11550847::web::025::worn_surface_morphology"
      ],
      "same_system": "no"
    },
    {
      "text": "A dense oxide film can reduce direct contact between sliding counterparts.",
