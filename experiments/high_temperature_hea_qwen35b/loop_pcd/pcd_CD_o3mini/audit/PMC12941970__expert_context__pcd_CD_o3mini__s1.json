      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11550847::web::025::worn_surface_morphology"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention is expected to be effective specifically in oxidizing environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
