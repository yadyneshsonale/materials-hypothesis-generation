  "claims": [
    {
      "text": "FeMnCoCrNi is an FCC high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12898549::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast or homogenized baseline has a uniform FCC microstructure lacking a dense twin-boundary network.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An annealing temperature of 800–900°C is near, and can be placed just below, the order–disorder transition of FeMnCoCrNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing FeMnCoCrNi at 800–900°C for one hour induces a high density of nanoscale twin boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid water quenching preserves the anneal-induced nanoscale twin-boundary network.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled atmosphere during annealing avoids oxidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale twin boundaries divide the alloy into regions with slightly different crystallographic and magnetic order.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin boundaries locally alter magnetic exchange interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin boundaries locally alter magnetostructural coupling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-boundary-induced changes in exchange and magnetostructural coupling promote a steep, cooperative magnetization change at low applied fields.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::018::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The twin-boundary treatment enhances the low-field magnetocaloric response relative to untreated FeMnCoCrNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin boundaries facilitate efficient heat conduction and rapid heat exchange.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin boundaries mitigate magnetic hysteresis losses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The heat-treated alloy will have lower hysteresis than the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An engineered nanoscale twin-boundary distribution can preserve or improve mechanical stability in FeMnCoCrNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12898549::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated baseline contains a lower density of twin boundaries than the heat-treated material.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should apply generally to FCC high-entropy alloys processed near an order–disorder transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substantial deviation from an FCC structure limits the effectiveness of the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficiently controlled thermal treatment limits the effectiveness of the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-field VSM hysteresis loops can by themselves assess magnetocaloric response as well as hysteresis behavior.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
