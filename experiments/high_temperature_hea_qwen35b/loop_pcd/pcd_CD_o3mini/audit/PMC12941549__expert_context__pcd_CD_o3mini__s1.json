      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978221::web::026::2_1_oxidation"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled diffusion during oxidation drives nucleation and growth of fine intermetallic precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13045251::web::001::introduction",
        "PMC8840145::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
