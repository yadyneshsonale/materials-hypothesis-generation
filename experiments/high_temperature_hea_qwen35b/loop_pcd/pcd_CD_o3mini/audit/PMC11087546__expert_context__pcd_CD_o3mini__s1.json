      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-treated alloy will have greater room-temperature tensile ductility than the no-boron lamellar-colony control.",
