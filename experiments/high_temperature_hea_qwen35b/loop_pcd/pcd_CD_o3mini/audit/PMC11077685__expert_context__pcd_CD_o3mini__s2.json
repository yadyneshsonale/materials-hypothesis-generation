        "PMC6719109::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina scale formed on the treated alloy will remain externally adherent during oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
