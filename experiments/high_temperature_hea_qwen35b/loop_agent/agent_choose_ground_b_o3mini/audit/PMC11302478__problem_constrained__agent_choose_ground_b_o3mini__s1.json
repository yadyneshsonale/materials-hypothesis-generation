  "claims": [
    {
      "text": "Mechanical-property differences between equiatomic CrMnFeCoNi and CrCoNi arise from a magnetically tunable deformation-induced FCC-to-HCP transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
