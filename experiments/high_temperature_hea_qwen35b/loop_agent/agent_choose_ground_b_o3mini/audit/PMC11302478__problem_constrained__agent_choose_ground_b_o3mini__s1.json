      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppressed transformation in CrMnFeCoNi produces differences in both strength and failure mode.",
      "field": "predicted_outcome",
