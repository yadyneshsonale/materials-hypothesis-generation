  "claims": [
    {
      "text": "As-cast AlCoCrFeNi2.1 has a dual-phase eutectic lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast lamellar microstructure of AlCoCrFeNi2.1 is relatively coarse.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored thermomechanical processing can produce an ultrafine-grained duplex microstructure while inheriting the cast lamellar architecture of AlCoCrFeNi2.1.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cold-rolling followed by annealing can increase the strength of AlCoCrFeNi2.1.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed structure will contain spatially adjusted hard BCC/B2 and soft FCC lamellae.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC6353877::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Thermomechanical processing creates hierarchical structural heterogeneity in AlCoCrFeNi2.1.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The heterogeneous duplex lamellar structure induces a two-hierarchical constraint effect.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hard ultrafine regions increase the alloy's strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Preserved or modulated soft FCC lamellae accommodate strain and thereby enhance ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed hierarchical microstructure generates a microcrack-arresting mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast AlCoCrFeNi2.1 baseline has approximately 944 MPa strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast AlCoCrFeNi2.1 baseline has approximately 25% tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cold-rolling and annealing can raise the alloy's tensile strength by approximately 20–30% relative to the reported as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy will maintain or slightly increase ductility relative to the approximately 25% as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Simultaneous strengthening and maintained or improved ductility require preservation of the eutectic lamellar architecture.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive refinement or disruption of the lamellae could degrade the strength–ductility balance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit is expected primarily at room temperature under quasi-static tensile loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The exact improvement magnitude and optimal thermomechanical processing window remain uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
