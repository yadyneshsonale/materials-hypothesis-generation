      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting HEA has no existing protective oxide layer.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline alloys contain low or no amounts of the targeted Al, Cr, or Si additions.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al additions can produce Al2O3, and Cr additions can produce Cr2O3.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior applies during air exposure above 900 °C for durations up to 200 hours.",
