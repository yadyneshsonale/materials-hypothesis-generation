      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloying additions produce a dense oxide scale that acts as a barrier to oxygen ingress and elemental diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloying additions undergo selective oxidation at high temperature.",
