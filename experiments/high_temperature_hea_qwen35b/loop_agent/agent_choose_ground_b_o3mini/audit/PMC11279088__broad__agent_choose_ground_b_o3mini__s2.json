      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective oxide is slow-growing and thermodynamically stable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale reduces inward oxygen diffusion.",
