  "claims": [
    {
      "text": "CrCoNi has a superior strength–ductility balance relative to equiatomic CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has an intrinsically low, potentially negative stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The stacking-fault energy of CrCoNi is lower than that of CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi possesses favorable local magnetic ordering that contributes to its deformation behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low stacking-fault energy promotes deformation twinning in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi can undergo a dislocation-mediated fcc-to-hcp transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::014::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Mn causes magnetic frustration in the quinary alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-induced magnetic frustration stabilizes the fcc phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-induced magnetic frustration reduces twin nucleation and associated fcc-to-hcp transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced twinning in CrMnFeCoNi limits its simultaneous enhancement of strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic CrCoNi and CrMnFeCoNi are single-phase fcc alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The comparison will use CrCoNi and CrMnFeCoNi produced with identical thermomechanical processing and similar grain sizes.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator is a nanoscale deformation-twin network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Localized hcp regions form at dislocation slip or defect-interaction sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::014::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "no"
    },
    {
      "text": "Twinning and fcc-to-hcp transformation increase both strength and ductility by enhancing dislocation interactions and deformation accommodation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::014::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Under matched deformation conditions, CrCoNi will develop a higher deformation-twin density than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
