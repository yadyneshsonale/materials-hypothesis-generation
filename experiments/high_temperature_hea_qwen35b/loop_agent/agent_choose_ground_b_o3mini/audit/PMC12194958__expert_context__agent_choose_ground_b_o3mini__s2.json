  "claims": [
    {
      "text": "A d-electron-only [TaNb]1-x(TiZrHf)x high-entropy alloy is superconducting.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::016::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline [TaNb]1-x(TiZrHf)x alloy has a superconducting transition temperature between 3 and 8 K.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy is a homogeneous bcc solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An actinide such as U can replace a conventional constituent in the [TaNb](TiZrHf)-type alloy family.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7070041::web::016::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The substituted alloy can retain at least five elements, each above 5 atomic percent, in a solid solution.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Actinide or lanthanide substitution introduces delocalized f-electron states into a multicomponent bcc HEA.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The introduced f-electron states hybridize with d-electron conduction states.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "f-electron hybridization changes the electronic density of states at the Fermi level.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "f-electron hybridization modifies electron-phonon coupling strength.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting change in electron-phonon coupling controls or adjusts Tc relative to the d-electron-only baseline.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The actinide-containing alloy will show a measurable Tc shift relative to the conventional baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::016::discussion_and_conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Tc shift could be either positive or negative and should exceed experimental error.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced electron-phonon coupling could raise Tc.",
      "field": "predicted_outcome; uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scattering, localized f electrons, or magnetic pair breaking could suppress Tc.",
      "field": "predicted_outcome; uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::002::introduction",
        "PMC7070041::web::016::discussion_and_conclusion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism is limited to single-phase, fully disordered bcc HEAs.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetic ordering or phase separation may invalidate the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7070041::web::002::introduction",
        "PMC7070041::web::016::discussion_and_conclusion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Using identical synthesis, pressure, and temperature conditions isolates the effect of f-element substitution.",
      "field": "conditions; falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Specific-heat measurements can probe substitution-induced changes in the Fermi-level density of states.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reproducible absence of changes in Tc and related electronic properties would falsify the proposed f-electron-hybridization mechanism.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
