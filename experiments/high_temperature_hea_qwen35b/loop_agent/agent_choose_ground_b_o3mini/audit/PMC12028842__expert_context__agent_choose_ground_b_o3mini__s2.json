      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Ni-induced solid solution and eutectic structure refine the coating grains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
