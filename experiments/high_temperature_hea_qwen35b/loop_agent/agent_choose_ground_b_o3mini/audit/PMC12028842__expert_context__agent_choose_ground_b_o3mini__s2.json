      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The refined multiphase microstructure inhibits grain-boundary motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined multiphase microstructure inhibits crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser-cladded HEA coatings can improve the hardness of TC4 surfaces.",
