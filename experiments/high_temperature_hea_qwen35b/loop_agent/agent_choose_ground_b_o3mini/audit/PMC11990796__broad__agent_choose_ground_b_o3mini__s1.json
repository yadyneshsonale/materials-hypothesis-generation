  "claims": [
    {
      "text": "The baseline NbMoTaWV refractory HEA has high mechanical strength and hardness at elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline NbMoTaWV alloy is brittle and has limited ductility at room temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 5 at.% Ti to NbMoTaWV will improve its strength–ductility balance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition will tune the alloy's valence electron concentration away from a brittle regime.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition will enhance grain-boundary cohesion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-induced electronic-structure changes will suppress detrimental B2-like long-range ordering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Ti will modestly increase the overall valence electron concentration of the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A critical 'VEC valley' promotes brittle intermetallic ordering in this alloy system.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "VEC modification by Ti will reduce the formation of brittle phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved grain-boundary cohesion and fewer brittle phases will enable more uniform plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will retain much of the baseline alloy's high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will exhibit a roughly 10–20% improvement in room-temperature ductility or plastic strain relative to NbMoTaWV.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will maintain yield strength within a range comparable to that of NbMoTaWV.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvement should hold during room-temperature testing at moderate strain rates after conventional solid-solution processing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may also improve strength–plasticity combinations in refractory HEAs with similar elemental systems.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti contents above the optimum may produce secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess Ti or application to substantially different compositions may cause a loss of high-temperature strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
