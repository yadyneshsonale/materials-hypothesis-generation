  "claims": [
    {
      "text": "The baseline titanium- and nickel-primary high-entropy alloy is a single-phase solid solution under standard processing conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract",
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is to add 5–10 at% aluminum to the baseline alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding aluminum to the titanium- and nickel-primary alloy will induce fine, coherent γ′ precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The γ′ precipitates will be homogeneously distributed within the existing matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will be ordered Ni3Al-type γ′ or titanium-modified variants.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aluminum promotes a controlled precipitation reaction in the titanium- and nickel-rich matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The γ′ precipitates impede dislocation motion at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation motion will increase elevated-temperature yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract",
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitates will delay creep deformation and improve creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminum-added alloy will have greater elevated-temperature yield strength than the otherwise equivalent aluminum-free alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396108::web::000::abstract",
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The aluminum-added alloy will have better elevated-temperature creep resistance than the aluminum-free alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A finely distributed precipitate population could produce a yield-strength increase of tens of percent.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures from 700°C to 1000°C permit precipitation without dissolving the precipitates in the proposed alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed strengthening applies under both static and cyclic elevated-temperature loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
