      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The altered vacancy population and electronic structure lower the activation temperature for CO oxidation.",
      "field": "mechanism",
