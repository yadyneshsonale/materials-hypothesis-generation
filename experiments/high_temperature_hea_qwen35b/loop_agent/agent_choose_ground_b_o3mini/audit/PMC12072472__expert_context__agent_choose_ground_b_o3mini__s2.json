  "claims": [
    {
      "text": "Elemental Cr coatings on zirconium-alloy cladding can peel and crack during high-temperature steam oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elevated-temperature Cr–Zr interdiffusion causes premature failure of elemental Cr coatings.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A low concentration of Al should be alloyed into the Cr coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::001::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al or Si should be considered when designing accident-tolerant cladding materials for high-temperature steam oxidation.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Al to Cr will produce an in situ Al2O3 sublayer or dispersion within the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Al will preferentially oxidize.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preferential Al oxidation will form a stable, dense alumina barrier at or near the coating–substrate interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina barrier will limit Cr and Zr interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina barrier will improve the integrity of the Cr coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-alloyed Cr coating will retain oxidation resistance in both PWR primary water and accident-relevant high-temperature steam.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, Al-alloyed Cr will exhibit less Cr–Zr interdiffusion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, Al-alloyed Cr will retain structural integrity for longer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, Al-alloyed Cr will have improved oxidation resistance under both normal and accident conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable in simulated PWR primary water and high-temperature steam up to approximately 1000 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
