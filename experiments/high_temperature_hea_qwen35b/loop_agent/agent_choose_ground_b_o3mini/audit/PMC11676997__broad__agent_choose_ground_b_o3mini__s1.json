      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions",
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
