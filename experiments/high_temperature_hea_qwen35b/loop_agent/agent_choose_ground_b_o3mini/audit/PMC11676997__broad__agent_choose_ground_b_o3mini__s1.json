      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti and Zr have lower melting points than Mo, Nb, Ta, and W.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Ti or Zr with Hf, Mo, Nb, or Ta will shift the alloy toward a higher average melting point.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
