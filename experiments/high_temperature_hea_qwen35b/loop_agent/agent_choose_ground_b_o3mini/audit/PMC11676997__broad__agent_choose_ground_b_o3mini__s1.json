      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::004::introduction",
        "PMC9586648::web::012::strategy_to_optimize_refractory_alloy_st"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding higher-melting-point elements raises the overall melting temperature of the alloy.",
