  "claims": [
    {
      "text": "TC4 is Ti-6Al-4V titanium alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "TC4 has comparatively low surface hardness and wear resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser melting cladding can deposit a TiAl-based composite layer on TC4.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding WC or Y2O3 to the cladding feedstock can further promote hard-phase formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid melting and solidification during laser cladding produces a heterogeneous microstructure containing TiC and TiB2 in an α-Ti or TiAl matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction",
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding induces local alloying and formation of intermetallic or ceramic phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The cladding-generated hard phases increase surface hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hard phases act as barriers to abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding refines the grain structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting phases distribute stresses more uniformly across the surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating could increase microhardness by approximately 70% relative to untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating could reduce wear rate by approximately 45–70% relative to untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hardness and wear improvements should hold in typical laboratory friction and wear tests.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvements should hold under moderate service conditions associated with aerospace engine or offshore drilling components.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvements may be less pronounced under extreme thermal cycling or impact loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative improvement depends on laser parameters, powder composition, and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An improvement of less than 20% in microhardness or a reduction of less than 20% in wear rate relative to an untreated control would falsify the hypothesis.",
