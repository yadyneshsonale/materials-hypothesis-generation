    {
      "text": "The optimal chromium concentration for balancing oxidation resistance and mechanical properties is not established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::web::012::3_4_oxidation_resistance"
      ],
      "same_system": "yes"
