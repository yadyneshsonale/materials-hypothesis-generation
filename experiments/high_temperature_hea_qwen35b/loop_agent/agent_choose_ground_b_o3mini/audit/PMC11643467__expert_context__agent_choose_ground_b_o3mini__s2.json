  "claims": [
    {
      "text": "The starting AlCoCrFeNi2.1 eutectic high-entropy alloy has a fine lamellar duplex FCC/B2 structure produced by conventional casting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline AlCoCrFeNi2.1 alloy has a promising but industrially insufficient strength–ductility combination.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 2 at% oxygen can be deliberately incorporated into the alloy during melting or doping.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a",
        "PMC8399672::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The added oxygen will form ordered interstitial oxygen complexes within the lattice and at phase boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8399672::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ordered oxygen complexes will act as strong obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation obstruction by oxygen complexes will increase yield strength while retaining a favorable strength–ductility balance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC8399672::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen complexes will mitigate high-temperature creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen complexes will stabilize phase boundaries and improve long-term high-temperature stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen complexes will reduce sites for corrosion initiation and improve corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-modified alloy will outperform the undoped control in yield strength, ductility balance, creep resistance, and corrosion resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC8399672::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A beneficial oxygen-addition window exists at approximately 1–3 at%.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen concentrations above approximately 3 at% may cause embrittlement or undesirable second-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect of oxygen depends on processing conditions, cooling rate, and subsequent heat treatment.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "no"
    },
    {
      "text": "The long-term behavior of oxygen interstitial configurations during high-temperature aging is uncertain.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen-related phase segregation during aging could reduce strengthening and offset the proposed benefits.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::020::relevance_of_this_study_for_processing_a"
      ],
      "same_system": "no"
    }
