      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9267885::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The low-Ti baseline has lower wear resistance than Ti-enriched coatings.",
