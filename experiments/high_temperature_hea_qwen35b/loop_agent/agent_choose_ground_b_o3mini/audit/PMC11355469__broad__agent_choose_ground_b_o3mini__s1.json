      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267885::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti addition increases the hardness of CoCrFeMnNi-based coatings or alloys.",
