  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Co-doping laser-cladded AlCoCrFeNi2.1 coatings with Y and Hf refines and stabilizes their microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf co-doping inhibits grain growth during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf co-doping promotes well-distributed oxide or intermetallic precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-induced microstructural changes reduce the initiation and propagation of wear damage under high-temperature, high-load conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline is a laser-cladded AlCoCrFeNi2.1 eutectic HEA coating without Y or Hf additions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline coating has a mixed FCC and BCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC10488378::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "After high-temperature exposure, the undoped baseline has relatively larger grains than the Y/Hf-co-doped coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The undoped baseline has less-stabilized oxide or intermetallic features than the Y/Hf-co-doped coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled intervention is to laser-clad a Y/Hf-co-doped version of the baseline under otherwise identical processing parameters.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed comparison is conducted near 900 °C under controlled sliding or abrasive wear conditions.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y/Hf addition enhances formation of an Al-rich L12 phase or similar dispersoids.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y and Hf preferentially segregate to grain boundaries and phase interfaces during cladding and subsequent thermal exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y/Hf segregation delays grain coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf promote a more continuous and stable protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A stable, refined microstructure and protective scale reduce micro-cracking and material removal during wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-co-doped coating will have a lower wear rate than the undoped coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-co-doped coating will exhibit less surface micro-cracking than the undoped coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-co-doped coating will retain a finer and more stable microstructure after exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed wear benefit should hold in high-temperature applications up to approximately 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant reduction in wear rate and micro-crack density, or failure to observe the proposed microstructural mediator, would falsify the hypothesis.",
