  "claims": [
    {
      "text": "Mn in Q235 steel preferentially dissolves in molten fluoride salt and forms Mn fluoride species.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior",
        "PMC6908586::web::011::corrosion_behavior",
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn dissolution establishes an Mn/MnF2 redox buffer at the salt–steel interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mn/MnF2 redox buffer retards dissolution of Fe, the primary constituent of Q235 steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior",
        "PMC6908586::web::011::corrosion_behavior",
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Sacrificial Mn dissolution mitigates overall high-temperature molten-salt corrosion of Q235 steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "As-received Q235 steel has a nominally low Mn content and a typical carbon-steel microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed buffering mechanism operates at 700–900 °C because Mn diffusivity and reaction kinetics are sufficiently high.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "At room temperature or below 450 °C, restricted Mn mobility prevents the buffering mechanism from operating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn fluoride accumulates as a layer at the scale/salt interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The lower free energy of formation of MnF2 favors Mn dissolution relative to less reactive alloying constituents.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "A relatively high Mn diffusion rate supplies Mn to the surface and contributes to its preferential dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Stable Mn fluoride species lower the thermodynamic driving force for Fe dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The sacrificial Mn mechanism delays or minimizes attack on the residual Q235 metal matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::011::corrosion_behavior",
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn-enhanced Q235 should exhibit less Fe dissolution, penetration, or mass loss than otherwise comparable lower-Mn Q235.",
