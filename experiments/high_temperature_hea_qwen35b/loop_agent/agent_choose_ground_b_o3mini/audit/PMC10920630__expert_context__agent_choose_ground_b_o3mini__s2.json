      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::010::corrosion_behavior",
        "PMC6908586::web::012::corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Q235 undergoing effective Mn buffering should exhibit less corrosion than samples exposed at lower temperatures.",
