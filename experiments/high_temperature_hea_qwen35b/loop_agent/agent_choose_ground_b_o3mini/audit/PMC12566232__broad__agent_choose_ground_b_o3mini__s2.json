      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed ductility-strength benefit should hold at ambient temperature under quasi-static loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed combination of mechanical performance and energy release should hold during dynamic loading at approximately 3000 s^-1.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::000::abstract"
      ],
      "same_system": "yes"
