      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The controlled dual-phase structure enables a longer regime of uniform deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment will significantly improve uniform elongation relative to the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment will maintain yield and ultimate strength at levels comparable to the untreated baseline.",
