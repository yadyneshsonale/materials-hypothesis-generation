      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nano-precipitation can generate progressive multistage strain hardening that delays localized plastic instability.",
