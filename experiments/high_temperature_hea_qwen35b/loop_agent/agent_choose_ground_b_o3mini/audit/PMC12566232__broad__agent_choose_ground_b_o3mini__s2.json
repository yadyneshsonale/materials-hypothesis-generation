      "supporting_ids": [
        "PMC11767206::web::000::abstract",
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed precipitates are nanoscale and coherent, and the surrounding matrix is ductile.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates impede dislocation glide and provide precipitation strengthening.",
