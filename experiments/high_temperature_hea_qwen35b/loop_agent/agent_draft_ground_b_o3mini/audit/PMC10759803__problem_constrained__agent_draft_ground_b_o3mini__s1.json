      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V and Hf have sufficiently similar atomic sizes for the substitution to preserve lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Maintaining a high-entropy disordered structure will preserve solid-solution strengthening at room and elevated temperatures.",
