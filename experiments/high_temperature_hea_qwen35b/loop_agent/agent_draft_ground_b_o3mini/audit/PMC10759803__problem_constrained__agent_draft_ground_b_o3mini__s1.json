      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion and solid-solution strengthening in the retained BCC phase provide high strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::001::1_introduction",
        "PMC7516739::web::008::3_1_microstructures_of_the_tanbvtialx_rh"
      ],
      "same_system": "no"
    },
    {
      "text": "Vanadium has a significantly lower atomic mass than hafnium.",
