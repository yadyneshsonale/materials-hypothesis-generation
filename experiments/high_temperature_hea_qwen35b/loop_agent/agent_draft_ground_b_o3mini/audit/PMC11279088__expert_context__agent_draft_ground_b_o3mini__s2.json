      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-containing CrFeCoNiX forms oxides with poor lattice matching to the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-derived oxides develop high internal stress that causes cracking and spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
