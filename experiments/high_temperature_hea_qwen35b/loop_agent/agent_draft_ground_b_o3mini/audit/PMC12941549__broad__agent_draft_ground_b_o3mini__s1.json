      "supporting_ids": [
        "PMC12112909::web::025::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The processed alloy will show improved high-temperature oxidation resistance relative to the homogenized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
