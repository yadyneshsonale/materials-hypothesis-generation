        "PMC12112909::web::025::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanosized precipitates act as barriers to grain-boundary diffusion by corrosive agents.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanosized precipitates impede oxygen transport along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitate network improves high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined cold-work and aging treatment will increase yield strength and tensile properties relative to the homogenized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509674::web::014::3_1_3_scanning_electron_microscopy_sem_a"
      ],
      "same_system": "unclear"
