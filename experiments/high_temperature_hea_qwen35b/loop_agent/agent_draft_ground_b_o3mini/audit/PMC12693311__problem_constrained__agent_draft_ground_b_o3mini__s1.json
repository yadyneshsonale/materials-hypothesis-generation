      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::075::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron addition will suppress nucleation and growth of primary crystalline phases during solidification.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::075::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron addition will suppress nucleation and growth of crystalline phases during reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain a higher amorphous fraction than the boron-free alloy under rapid and moderate-to-slow cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::075::feature_interpretation",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have a higher crystallization-onset temperature during reheating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Very rapid melt-spinning can produce an amorphous structure in the boron-free alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant cooling-rate range is approximately 10^3 to 10^6 K/s.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "FCC phase A transforms at approximately 1700 K, while orthorhombic phase E transforms near 1300 K.",
