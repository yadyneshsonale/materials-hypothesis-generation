      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::075::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron will act as scattering centers and create local structural disruptions that hinder atomic rearrangement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron addition will thermodynamically stabilize the disordered state.",
