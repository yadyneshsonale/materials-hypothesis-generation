  "claims": [
    {
      "text": "The baseline TiVNbTa alloy is a single-phase BCC dendritic alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline TiVNbTa alloy has a room-temperature yield strength of approximately 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, baseline TiVNbTa has yield and compressive strengths of 330 MPa and 423 MPa, respectively.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline TiVNbTa alloy exhibits approximately 40% ductility or strain.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at.% W to TiVNbTa will increase its elevated-temperature yield and compressive strengths.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::024::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "Substitutional W in the BCC lattice will enhance lattice distortion in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::024::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "The increased atomic-size mismatch and local lattice strain will raise barriers to dislocation motion and strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::024::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "W addition will reduce atomic diffusivity in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced diffusivity from W addition will suppress thermal softening at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5 at.% W can be added without causing detrimental phase separation and while retaining a single-phase BCC structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Maintaining a single-phase BCC structure is required for effective integration and heat transfer between W and CuCrZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength improvement from 5 at.% W will involve only minor reductions in ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The W-modified alloy will provide better heat-transfer performance in a W-to-CuCrZr divertor environment.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effects are limited to controlled W additions near 5 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher W contents may promote unwanted secondary-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::024::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher W contents may specifically induce Laves-phase precipitation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Secondary-phase formation could impair ductility and overall mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::024::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "Testing the intermediate alloy up to 1273 K is compatible with the operating-temperature range of the adjacent CuCrZr heat sink.",
      "field": "conditions",
