      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::012::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heterogeneous deformation between microstructural regions generates back-stress strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
