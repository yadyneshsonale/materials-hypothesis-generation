      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent copper-rich precipitates will preserve strength and ductility under reactor operating stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Copper doping will improve thermal conductivity relative to the undoped intermediate layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The copper-doped alloy will retain mechanical integrity comparable to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The copper-doped alloy will provide stable performance under plasma exposure.",
