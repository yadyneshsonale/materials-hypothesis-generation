        "PMC10647333::web::018::4_conclusions",
        "PMC10708198::web::027::theoretical_analysis_of_precipitation_ha"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 1–3 vol% nanoscale Y2O3 will increase high-temperature ductility at 600–900 °C relative to the oxide-free baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The high-temperature benefit will apply under both tensile and creep loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 addition will not appreciably degrade room-temperature mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 addition will not substantially increase alloy density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying or in-situ precipitation can produce a controlled dispersion of 1–3 vol% nanoscale Y2O3 in the refractory alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will create a uniform dispersion of nanoscale Y2O3 precipitates within the alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale Y2O3 precipitates will be non-shearable obstacles to dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::027::theoretical_analysis_of_precipitation_ha"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocations will bypass the Y2O3 precipitates through Orowan looping.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::027::theoretical_analysis_of_precipitation_ha"
      ],
      "same_system": "no"
    },
    {
      "text": "Orowan obstruction by the oxide particles will enhance high-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::027::theoretical_analysis_of_precipitation_ha"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 particles will pin grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain-boundary pinning by Y2O3 will retard grain coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined dislocation-obstacle and grain-boundary-pinning effects will enhance high-temperature ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The beneficial effects are restricted to an oxide volume fraction of 1–3 vol%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exceeding 3 vol% Y2O3 may cause particle agglomeration.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exceeding 3 vol% Y2O3 may cause embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
