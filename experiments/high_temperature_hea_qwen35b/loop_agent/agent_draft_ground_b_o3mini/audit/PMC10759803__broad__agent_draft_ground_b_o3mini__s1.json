  "claims": [
    {
      "text": "Adding 1–3 vol% nanoscale Y2O3 will increase high-temperature yield strength at 600–900 °C relative to the oxide-free baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
