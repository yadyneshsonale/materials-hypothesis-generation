      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvement requires optimization of tool geometry, processing speed, force, and related parameters for the specific material composition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated component will retain the predicted benefits under aggressive wear, corrosion, and thermal-cycling conditions.",
      "field": "conditions",
