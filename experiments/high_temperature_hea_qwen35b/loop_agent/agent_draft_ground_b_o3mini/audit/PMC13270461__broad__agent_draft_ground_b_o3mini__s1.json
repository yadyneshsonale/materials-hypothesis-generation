      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion in the alloy increases vacancy-formation energies.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased vacancy-formation energy suppresses Al diffusion during prolonged exposure and slows thermally grown oxide growth.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The scale can include outer MnCr2O4 and Cr2O3 layers in addition to Al2O3.",
      "field": "structural_mediator",
