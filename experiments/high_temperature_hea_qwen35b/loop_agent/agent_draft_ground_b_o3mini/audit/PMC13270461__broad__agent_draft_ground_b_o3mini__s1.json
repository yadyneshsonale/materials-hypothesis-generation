        "PMC11169556::web::003::introduction",
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The tuned microstructure enhances early Al diffusion to the surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::020::protective_al2o3_scale_evolution_during_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reactive-element interfacial anchoring prevents or reduces scale spallation during thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
