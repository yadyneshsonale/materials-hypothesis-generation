      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An initially formed Al2O3 scale limits inward oxygen transport.",
