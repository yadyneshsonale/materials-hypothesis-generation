      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled annealing or modulation of deposition temperature promotes formation of a nanocrystalline grain structure in HEA coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanocrystalline HEA structures can remain stable against thermally driven grain coarsening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4510962::web::011::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The thermal stability of nanocrystalline HEA films can arise from low relative grain-boundary energy and a reduced driving force for grain-boundary migration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4510962::web::011::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A fine-grained HEA structure provides a high density of grain and phase boundaries.",
