        "PMC11378927::web::022::synergistic_effect_between_ce_and_corros",
        "PMC12565319::web::016::3_3_corrosion_behavior_of_hea_coating"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Wear-induced passive-film disruption exposes the underlying metal to aggressive chemical attack.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11378927::web::022::synergistic_effect_between_ce_and_corros",
        "PMC12565319::web::016::3_3_corrosion_behavior_of_hea_coating"
      ],
      "same_system": "unclear"
    },
