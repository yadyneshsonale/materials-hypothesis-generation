  "claims": [
    {
      "text": "HEA multilayer coatings have superior resistance to time-dependent plastic deformation because of coherent interfaces in the multilayer architecture.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent multilayer interfaces create localized lattice-misfit strain fields.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The interfacial strain fields hinder dislocation nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent interfaces hinder dislocation glide and motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent interfaces act as barriers to atomic diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Blocking dislocation motion and atomic diffusion impedes creep and plastic flow relative to homogeneous HEA coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Interfaces in the multilayer coatings function analogously to γ/γ′ interfaces in superalloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A moderate negative γ/γ′ lattice misfit enhances interfacial coherency and improves creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The multilayer interfaces increase the activation energy for dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multilayer interfaces reduce defect activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Repeated interfaces segment the coating into smaller regions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segmentation by repeated interfaces reduces the effective mean free path for dislocation propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical tests, multilayer coatings will have a lower creep rate than homogeneous HEA coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Under identical tests, multilayer coatings will have a lower dislocation density than homogeneous HEA coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical tests, multilayer coatings will exhibit less overall time-dependent plastic deformation than homogeneous HEA coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism is applicable when deformation is predominantly controlled by dislocation dynamics.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "At very high temperatures, thermal activation may overcome the interface barriers and eliminate the predicted advantage.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
