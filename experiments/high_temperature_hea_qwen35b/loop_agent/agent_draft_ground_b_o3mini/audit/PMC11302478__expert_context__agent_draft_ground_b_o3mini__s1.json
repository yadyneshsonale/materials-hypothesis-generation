  "claims": [
    {
      "text": "The equiatomic quinary alloy and the selected ternary and quaternary subsets can all be prepared as single-phase FCC alloys under identical thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local chemical ordering is the key driver of mechanical-property differences among the FCC Cr-Mn-Fe-Co-Ni-derived alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local chemical ordering changes planar-fault or stacking-fault energetics.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local chemical ordering affects the selection of dislocation slip, faulting, and twinning pathways.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn contributes to magnetic frustration in equiatomic CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::007::effect_of_magnetism",
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing or eliminating Mn makes local chemical ordering more uniform.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-induced frustration and irregular local chemical ordering give the quinary alloy a broader distribution of local stacking-fault energies.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quinary alloy's broader local stacking-fault-energy distribution causes irregular twin formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi has more uniform local chemical ordering than CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi possesses a lower-energy HCP state and can undergo a magnetically linked, deformation-induced FCC-to-HCP transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deformation-induced FCC-to-HCP transformation distinguishes CrCoNi from the quinary alloy and the other equiatomic ternary derivatives.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "More uniform local chemical ordering promotes a consistent, well-connected nanotwin network.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed nanotwin network raises strength by acting as a barrier to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed nanotwin network enhances ductility by providing a pathway for strain accommodation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi has a better combination of strength and plastic deformation than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Appropriate Mn-reduced quaternary alloys will also have a superior strength-ductility balance relative to the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-reduced alloys will exhibit a narrower stacking-fault-energy distribution than the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-reduced alloys will develop a higher density and connectivity of deformation-induced nanotwins than the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-reduced alloys will exhibit higher strain-hardening rates than the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing conditions can change local chemical ordering, and severe plastic deformation can reduce it toward a random solid solution.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::web::000::abstract"
      ],
      "same_system": "yes"
    }
