  "claims": [
    {
      "text": "The starting alloy is equimolar CoCrFeNiTi in an as-cast simple solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equimolar CoCrFeNiTi has relatively low hardness and strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relatively low hardness and strength are primarily caused by a lack of fine precipitates or short-range chemical order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate heat treatment can promote local nanostructural evolution or chemical ordering.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Heat treatment near 600 °C for 3–6 hours followed by quenching will form short-range-order clusters or fine precipitates in CoCrFeNiTi.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature mechanical pre-straining can promote short-range ordering or fine precipitation in CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range-order clusters or nanoscale chemical-complexity regions present energy barriers to gliding dislocations.",
