  "claims": [
    {
      "text": "The alloy is equimolar WTaTiVZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516662::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "W, Ta, Ti, V, and Zr are low-activation refractory elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, equimolar WTaTiVZr has greater plastic strain and toughness than pure tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mixing principal elements of different atomic sizes produces severe intrinsic lattice distortions in the HEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lattice distortion changes dislocation activity from long-distance glide by a few long dislocations to short-distance glide by a high density of fragmented dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic-size mismatch creates a complex energy landscape that confines dislocations into smaller local segments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The distorted lattice promotes simultaneous activity on multiple slip planes or slip systems.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fragmented dislocation motion promotes dynamic recovery during high-temperature loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic recrystallization may contribute to the deformation response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fragmented slip and dynamic recovery distribute plastic strain, arrest catastrophic strain localization, and thereby enhance toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Pure tungsten exhibits more localized and less distributed dislocation motion, more abrupt stress drops, and lower plastic strain and toughness under the same high-temperature loading.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to pure tungsten, the HEA will show more gradual stress-strain curves and smaller stress drops.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516662::web::003::1_introduction",
        "PMC9572892::web::013::3_4_micropillar_compression_and_deformat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to pure tungsten, the HEA will sustain greater plastic strain before failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Matching the initial grain sizes and baseline microstructures and applying identical loading provides a controlled HEA-versus-tungsten comparison.",
      "field": "material_initial_state; intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures above 1000 K are relevant to sustained plasma-facing-component service.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies at strain rates for which thermal activation promotes dynamic recovery.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism should be less pronounced at room temperature or at very high strain rates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior work evaluated elevated-temperature nanoindentation creep of TaTiVWZr and compared its creep parameters with pure tungsten.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516662::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
