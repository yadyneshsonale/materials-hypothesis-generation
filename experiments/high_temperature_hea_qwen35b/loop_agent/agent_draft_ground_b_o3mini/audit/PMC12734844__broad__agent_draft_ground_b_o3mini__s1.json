      "support": "partial",
      "supporting_ids": [
        "PMC11396468::web::032::3_5_3_temperature_field_analysis"
      ],
      "same_system": "yes"
    },
    {
      "text": "Substrate preheating will improve the mechanical integrity and mechanical properties of high-entropy-alloy components.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
