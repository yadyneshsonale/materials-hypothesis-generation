      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr",
        "PMC11807212::web::018::materials_fabrication"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reducing thermal gradients reduces thermal and residual stresses in the deposited material.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11396468::web::032::3_5_3_temperature_field_analysis",
        "PMC11807212::web::018::materials_fabrication"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Preheating minimizes the temperature differential between the melt pool and the substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lower cooling rates and thermal gradients produced by preheating suppress crack formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9698306::web::015::3_2_1_sample_appearance_defects_and_micr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reducing thermal stress through substrate preheating suppresses porosity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing thermal stress through substrate preheating suppresses lack-of-fusion defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More uniform heat flow and solidification improve microstructural uniformity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11396468::web::032::3_5_3_temperature_field_analysis",
        "PMC11396468::web::035::3_5_3_temperature_field_analysis"
      ],
      "same_system": "yes"
    },
    {
