      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12839976::web::023::3_3_passive_film_characteristics"
      ],
      "same_system": "no"
    },
    {
      "text": "Static immersion produces slower corrosion than immersion accompanied by cumulative surface damage.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11378927::web::018::electrochemical_behavior_of_cocrfenimocu"
      ],
      "same_system": "yes"
    },
    {
      "text": "Corrosion during static immersion is relatively uniform.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12839976::web::023::3_3_passive_film_characteristics"
      ],
      "same_system": "no"
    },
    {
