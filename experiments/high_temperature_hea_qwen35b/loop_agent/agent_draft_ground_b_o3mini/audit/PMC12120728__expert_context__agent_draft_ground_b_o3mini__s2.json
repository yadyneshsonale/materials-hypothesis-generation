  "claims": [
    {
      "text": "Nanocrystalline W38Ta36Cr15V11 forms Cr-V-rich precipitates when irradiated near 8 dpa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-V-rich precipitates in irradiated W38Ta36Cr15V11 may contribute to embrittlement.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing 2-5 at.% Cr with Hf will suppress irradiation-induced Cr-V-rich precipitate formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf substitution will preserve the alloy's low irradiation hardening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf substitution will preserve the alloy's radiation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf substitution will preserve practical bulk manufacturability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf substitution increases lattice distortion in W38Ta36Cr15V11.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456733::web::022::3_4_irradiation_hardening"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased lattice distortion restricts the formation and growth of irradiation-induced defect clusters.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456733::web::022::3_4_irradiation_hardening"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf substitution alters vacancy migration in the alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf substitution reduces nucleation sites for Cr-V-rich precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf has low diffusivity in the relevant alloy and irradiation-temperature regime.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf has a high melting point.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low diffusivity and high melting point of Hf modify the local chemical environment and vacancy-migration dynamics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Modified vacancy migration suppresses Cr and V clustering without significantly affecting dislocation-loop formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After irradiation to approximately 8 dpa, Hf-substituted samples will have statistically fewer and smaller Cr-V-rich precipitates than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After irradiation to approximately 8 dpa, Hf-substituted samples will retain hardening comparable to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit is limited to doses around 8 dpa and specimen temperatures from approximately room temperature to 600 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Significant thermal recovery effects can be avoided by keeping the irradiation temperature at or below approximately 600 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant precipitate reduction, or observation of increased hardening or processing problems, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
