  "claims": [
    {
      "text": "The baseline alloy has the composition Cr16Mn16Fe16Co16Ni16P20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy shows limited amorphous retention under current processing conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy has a complicated thermal response and crystallizes during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to substitute 2–5 at.% boron for an unspecified fraction of one or more transition-metal elements.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at.% boron will improve amorphous-phase formation and retention during rapid cooling.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding 2–5 at.% boron will improve thermal stability during subsequent reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Boron has a considerably smaller atomic radius than the transition metals in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing boron into this alloy will increase atomic-size mismatch and local packing frustration.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A significant mismatch in constituent atomic radii disrupts the regular atomic packing required to form crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Disrupted regular packing impedes crystal nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Variability in local atomic radii typically elevates melt viscosity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increased melt viscosity impedes the diffusion and atomic rearrangement needed for crystal growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The resulting kinetic hindrance will promote glass formation during rapid cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The same kinetic hindrance will delay crystallization during reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the baseline, the boron-modified alloy will have a higher crystallization-onset temperature or reduced crystallization kinetics during thermal analysis.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should work best under rapid-quenching conditions and moderate reheating rates.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit may diminish under very slow cooling or reheating beyond a critical temperature range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A failure to obtain a statistically significant increase in amorphous stability under identical processing conditions would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
