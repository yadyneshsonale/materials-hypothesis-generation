      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::026::4_conclusions",
        "PMC9787501::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A continuous alumina scale acts as a barrier to oxygen ingress and retards further oxidation.",
