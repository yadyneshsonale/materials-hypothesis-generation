      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::web::009::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding 2–3 at.% Al will improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::026::4_conclusions",
        "PMC9787501::web::003::1_introduction"
      ],
      "same_system": "no"
    },
