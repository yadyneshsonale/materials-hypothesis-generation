        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent γ/γ′ interfaces limit atomic diffusion or atomic transport.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
