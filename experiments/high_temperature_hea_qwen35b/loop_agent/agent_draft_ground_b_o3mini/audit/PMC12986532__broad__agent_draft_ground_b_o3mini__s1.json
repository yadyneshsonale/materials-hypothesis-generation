      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::019::3_3_difference_in_creep_resistance_betwe",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "γ/γ′ boundaries serve as pathways for atomic diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The phase boundaries act as dislocation-pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::019::3_3_difference_in_creep_resistance_betwe",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The phase boundaries block atomistic diffusion routes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Blocking dislocation motion and atomic transport retards creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
