      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::019::3_3_difference_in_creep_resistance_betwe",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Temperatures of 1000–1400 K and stresses of approximately 2.0–3.0 GPa promote creep deformation in the proposed samples.",
