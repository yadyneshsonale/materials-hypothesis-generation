  "claims": [
    {
      "text": "Conventional single-phase ZrB2 requires sintering temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase ZrB2 has limited resistance to oxidation and liquid-metal corrosion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution of 2–5 atomic % Hf for Zr will enable ZrB2 densification at approximately 1700–1800 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856243::web::020::3_2_2_the_hf0_2mo0_2ti0_2ta0_2zr0_2_b2_s"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf substitution will increase the hardness and structural integrity of ZrB2.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf substitution will improve the oxidation resistance of ZrB2.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf substitution will improve the resistance of ZrB2 to corrosion in liquid plating-metal baths.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf atoms can be incorporated substitutionally into a metal-diboride lattice containing Zr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856243::web::020::3_2_2_the_hf0_2mo0_2ti0_2ta0_2zr0_2_b2_s"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-modified ZrB2 will form HfO2 in situ during high-temperature service exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856243::web::020::3_2_2_the_hf0_2mo0_2ti0_2ta0_2zr0_2_b2_s"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf substitution improves diffusion and thereby accelerates lower-temperature densification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf sites preferentially oxidize during high-temperature oxidation or liquid-metal exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preferential oxidation of Hf produces a robust and adherent HfO2 protective layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HfO2 layer suppresses both further oxidation and liquid-metal corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HfO2 layer improves intergranular bonding and overall structural integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Previously reported lower-temperature ZrB2 specimens were generally prepared above 1700 °C and remained vulnerable to oxidation and liquid-metal corrosion.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefits apply within a sintering range of approximately 1700–1800 °C and during high-temperature oxidation and liquid plating-metal service.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At drastically lower sintering temperatures or under extremely aggressive corrosion conditions, the proposed improvements may not occur.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
