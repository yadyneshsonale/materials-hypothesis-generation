      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::004::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "FeNiCrMn has intrinsically low stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low stacking-fault energy facilitates deformation-twin formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::004::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twins impede mobile dislocations and increase dislocation storage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5314382::web::004::results_and_discussion",
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin-mediated obstruction of dislocations increases work hardening.",
