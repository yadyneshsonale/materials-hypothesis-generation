      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::004::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twinning dominates FeNiCrMn deformation at cryogenic temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twinning dominates FeNiCrMn deformation at high strain rates.",
