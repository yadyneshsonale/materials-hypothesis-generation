      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5314382::web::004::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twins enhance yield strength by acting as strong barriers to mobile dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5494191::web::013::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin-enhanced hardening preserves the strength-ductility balance of FeNiCrMn.",
