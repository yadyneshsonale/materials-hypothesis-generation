      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-deposited FeMnNiGeSi-type thin films and nanoribbons exhibit broad magnetocaloric response curves.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-deposited FeMnNiGeSi-type thin films and nanoribbons exhibit pronounced magnetic hysteresis during magnetic-cooling cycles.",
