  "claims": [
    {
      "text": "Equimolar or nearly equimolar CoCrFeNiTi can exist as a single-phase solid solution with a predominantly FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy has relatively low hardness and strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy has moderate or favorable ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relatively low hardness and strength of simple-solid-solution CoCrFeNiTi are governed by the absence of nanoscale precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.5 at.% Al to CoCrFeNiTi will nucleate uniformly distributed nanoscale precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored heat treatment of CoCrFeNiTi will induce homogeneous nanoscale precipitate formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale precipitates embedded in an FCC matrix obstruct dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "Uniformly dispersed precipitates provide precipitation strengthening and increase alloy strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed precipitates will increase lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC11203300::web::003::1_introduction",
        "PMC3598001::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Greater lattice distortion impedes dislocation motion and contributes to strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC11203300::web::003::1_introduction",
        "PMC3598001::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The FCC matrix contributes to retained ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC3598001::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified or heat-treated CoCrFeNiTi alloy will have higher yield strength than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified or heat-treated CoCrFeNiTi alloy will have higher hardness than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10785334::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Within the proposed processing limits, strengthening will occur without a severe loss of ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "An excessive amount of strengthening phase can impede dislocation motion and significantly reduce plasticity.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive alloying or prolonged heat treatment of CoCrFeNiTi may form coarse or brittle intermetallic phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::011::3_4_mechanical_properties_of_alloys",
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed precipitation-strengthening and ductility-retention behavior applies from 25 °C to 600 °C under quasi-static tensile and compressive loading.",
