    {
      "text": "The carbon-modified W–Cu composite will retain comparable or slightly improved irradiation tolerance relative to carbon-free W–Cu.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
