      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper becomes locally enriched at surfaces and grain boundaries during heating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper-rich regions have lower local effective melting temperatures than the surrounding alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9228246::web::016::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Copper-rich regions nucleate a liquid-like premelted phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized premelting occurs before the nanoparticle melts globally.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The premelted phase propagates and facilitates complete melting of the nanoparticle.",
