      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper-segregating particles will show surface fluidity, local loss of crystalline order, or liquid-like regions below the alloy's bulk-average melting temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniformly mixed baseline nanoparticle will melt in a manner consistent with averaged bulk melting characteristics.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert atmosphere prevents oxidation during heating.",
