      "supporting_ids": [
        "PMC5171798::web::001::body",
        "PMC11432989::web::014::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced defect accumulation will mitigate irradiation-induced hardening in the hafnium-modified RHEA.",
