      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sn-doped HfNbTaTiZr will have a markedly lower oxidation rate than undoped HfNbTaTiZr after 5 hours in air at 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
