      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's room-temperature yield strength will remain within ±15% of the as-cast HfMoTaTiZr baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's room-temperature ductility will remain within ±15% of the as-cast HfMoTaTiZr baseline.",
