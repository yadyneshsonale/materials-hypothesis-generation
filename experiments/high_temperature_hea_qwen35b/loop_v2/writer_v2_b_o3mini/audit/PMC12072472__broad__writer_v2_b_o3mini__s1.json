    {
      "text": "A thin chromium coating improves the high-temperature oxidation resistance of zirconium-alloy nuclear-fuel cladding relative to uncoated cladding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvement results from in situ formation of a chromium oxide scale.",
