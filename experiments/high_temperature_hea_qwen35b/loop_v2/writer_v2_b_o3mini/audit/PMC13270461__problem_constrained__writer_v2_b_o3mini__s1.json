    {
      "text": "Preferential oxidation causes localized Ti and Al depletion at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The porous oxide scale and elemental-depletion zones create local chemical and mechanical imbalances and act as stress concentrators.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These stress concentrations promote microcrack nucleation and propagation.",
