  "claims": [
    {
      "text": "(MnNiSi)0.62(FeCoGe)0.38 exhibits a large caloric response under applied magnetic and pressure fields.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has poor load-bearing integrity and tends to crack.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.5–1 at% Nb during synthesis will improve load-bearing integrity without degrading caloric response.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb addition will segregate to grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb addition will promote fine-scale or nanoscale precipitation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb segregation and nanoscale precipitates will hinder crack initiation and propagation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb will strengthen grain boundaries and reduce intergranular cracking under mechanical load.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping the Nb concentration low will leave the phase-transition features responsible for magnetocaloric and barocaloric performance essentially unaffected.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will have higher fracture toughness than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will have lower crack density than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will retain a caloric response comparable to that of the undoped alloy under identical magnetic and pressure fields.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Doped and control samples will be prepared under otherwise identical melting and casting conditions.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Doped and control samples will be tested under the same magnetic field, pressure, temperature, and mechanical-loading conditions.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb may alter phase-transition kinetics, transition entropy changes, or caloric performance, so the optimal concentration requires experimental confirmation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
