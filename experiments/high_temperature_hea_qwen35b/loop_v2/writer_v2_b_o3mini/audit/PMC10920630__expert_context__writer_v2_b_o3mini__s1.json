  "claims": [
    {
      "text": "As-received Q235 steel has a naturally formed native surface oxide.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The native oxide on as-received Q235 steel is coherent and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The native surface oxide acts as a protective barrier against salt-induced high-temperature corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled acid pickling selectively removes the native oxide layer from Q235 steel.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing the native oxide accelerates Q235 degradation during high-temperature salt exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed oxide limits ingress of salt into Q235 steel.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed oxide limits ingress of oxygen into Q235 steel.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limiting salt and oxygen ingress reduces the high-temperature oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removal of the native oxide exposes bare Q235 metal to the corrosive environment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure of bare Q235 metal leads to uncontrolled oxidation and increased hot-corrosion degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 700–900 °C in aggressive salt, Q235 with intact native oxide will show less mass change than oxide-removed Q235.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 700–900 °C in aggressive salt, Q235 with intact native oxide will show less microstructural degradation than oxide-removed Q235.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective mechanism applies when the native oxide is coherent and adherent.",
