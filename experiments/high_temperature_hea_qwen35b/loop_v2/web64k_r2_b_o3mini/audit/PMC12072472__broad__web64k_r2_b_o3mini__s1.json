      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The dense HfO2 scale impedes further oxygen ingress and thereby suppresses oxidation of the underlying material.",
