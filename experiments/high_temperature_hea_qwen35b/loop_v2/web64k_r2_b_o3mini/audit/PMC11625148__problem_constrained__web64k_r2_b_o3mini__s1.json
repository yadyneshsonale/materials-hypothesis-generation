      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment can produce an inverted microstructure consisting of discrete B2 precipitates in a continuous BCC matrix.",
