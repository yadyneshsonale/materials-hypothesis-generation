      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW has a yield strength of approximately 400 MPa or more at 1600 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The irradiation resistance of NbMoTaW has been computationally predicted by first-principles calculations.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solutionizing followed by controlled annealing can induce B2 precipitation in equiatomic NbMoTaW.",
