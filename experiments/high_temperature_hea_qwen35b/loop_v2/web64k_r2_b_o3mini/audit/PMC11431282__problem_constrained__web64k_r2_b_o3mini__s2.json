      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nitrogen-doped alloy will exhibit a statistically significant increase in fracture toughness and load-bearing strength relative to the undoped alloy.",
