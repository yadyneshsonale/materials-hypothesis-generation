  "claims": [
    {
      "text": "The as-rolled NiFeCoCr-based baseline has a broader distribution of magnetic exchange energies than Pd-added and heat-treated material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline has only a moderate magnetocaloric response.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-rolled baseline has relatively higher magnetic hysteresis.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-rolled baseline has less optimized heat transfer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pd addition and heat treatment reduce the distribution of exchange energies and make NiFeCoCr-based alloys more magnetically homogeneous.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "A narrow, uniform exchange-energy distribution is the key mediator of a strong, reversible low-field magnetocaloric response.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body",
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "FCC additives such as Cu or Ag should act analogously to the demonstrated Pd additive.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The additive and annealing reduce local compositional fluctuations and magnetic inhomogeneity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Narrowing the distribution of exchange interactions promotes a continuous second-order magnetic transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Exchange-interaction homogenization minimizes pinning sites responsible for magnetic hysteresis.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The homogenized microstructure permits rapid lattice heat exchange.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "The homogenized microstructure preserves mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy should exhibit a larger magnetic entropy change than the baseline under low applied fields.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body",
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy should exhibit a sharper but reversible magnetic transition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy should have lower hysteresis than the as-rolled baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy should retain or improve thermal conductivity and mechanical stability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body",
        "PMC4623812::web::012::magnetocaloric_effect"
      ],
      "same_system": "yes"
    },
    {
      "text": "The NiFeCoCrPdx system has a tunable second-order magnetic transition spanning low temperatures to above room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::003::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism should hold specifically for single-phase FCC alloys containing approximately 2–5 at.% additive under low-to-moderate fields.",
