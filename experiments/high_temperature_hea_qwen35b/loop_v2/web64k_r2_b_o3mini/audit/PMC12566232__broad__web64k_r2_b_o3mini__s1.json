      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract",
        "PMC10213035::web::010::results"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCP treatment leaves the overall reactive matrix unchanged.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Leaving the reactive matrix unchanged preserves the alloy's impact-induced energy-release capability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
