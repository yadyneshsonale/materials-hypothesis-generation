      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::010::results"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated refractory HEA deforms non-uniformly under dynamic loading.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SCCP treatment first precipitates delta lamellae and subsequently forms gamma-double-prime nanoprecipitates.",
