  "claims": [
    {
      "text": "Co, Cu, and Ni are inexpensive transition-metal alloying components relative to Pt and Pd.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Co, Cu, and Ni to PtPd/SiO2 produces a PtPdCoCuNi high-entropy-alloy catalyst.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co, Cu, and Ni can be added incrementally to PtPd-based catalysts for comparison with compositions containing fewer metal components.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::004::introduction",
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloying Co, Cu, and Ni transfers electronic charge to Pt and Pd.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloying Co, Cu, and Ni results in isolated Pt and Pd sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Charge transfer itself causes the geometric isolation of Pt and Pd sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Pt and Pd sites in the alloy are electron-rich and more nucleophilic.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The electronic and geometric changes strengthen the interaction or adsorption of nitrobenzene at Pt/Pd sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified sites activate nitrobenzene more effectively.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stronger nitrobenzene interaction at isolated, charge-modified Pt/Pd sites enhances hydrogenation activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional PtPd/SiO2 has more clustered Pt/Pd atoms and less electronic charge modulation than PtPdCoCuNi/SiO2.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 should give markedly higher nitrobenzene-hydrogenation activity than PtPd/SiO2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "At 80 °C, aniline yield increases from approximately 44% over PtPd/SiO2 to more than 90% over PtPdCoCuNi/SiO2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 remains active for nitrobenzene hydrogenation at room temperature.",
