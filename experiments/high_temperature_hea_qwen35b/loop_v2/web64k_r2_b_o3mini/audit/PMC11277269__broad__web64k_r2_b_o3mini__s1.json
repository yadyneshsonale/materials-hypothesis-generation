      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism is bounded to supported nanoparticulate catalysts used for nitrobenzene hydrogenation at moderate temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
