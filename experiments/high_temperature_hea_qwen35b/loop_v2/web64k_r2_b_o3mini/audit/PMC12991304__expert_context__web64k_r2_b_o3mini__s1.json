      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The overlayer retards sintering and structural degradation during prolonged operation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::021::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated catalyst will reach full conversion at temperatures below 150 °C.",
      "field": "predicted_outcome",
