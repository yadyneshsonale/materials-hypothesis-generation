{
  "run_id": "PMC11433250__broad__web64k_r2_b_o3mini__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Introducing a low concentration of yttrium at the surface of a boride-based component will improve its resistance to molten-aluminum corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface yttrium will promote rapid formation of an Al2O3-rich interfacial layer during hot-dip aluminum plating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y-promoted Al2O3-rich layer will be tightly adherent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-promoted interfacial barrier will be continuous and retained during exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium will segregate at oxide grain boundaries and at the metal-oxide interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium segregation at critical interfaces improves oxide adhesion and reduces oxide-scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium impedes inward and outward diffusion of species through the oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3-rich layer acts as a diffusion barrier against attack of the boride substrate by molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-treated boride surfaces will have lower corrosion rates than untreated boride surfaces.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The lower corrosion rate will be observable as reduced weight loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lower corrosion rate will be observable as decreased oxide spallation or corrosion-penetration depth.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective effect should remain effective near 660 degrees Celsius under a controlled atmosphere without high chloride levels or excessive oxidizers.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect exists only over a limited range of yttrium concentrations.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive yttrium concentrations may negate or reverse the protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Departures from typical hot-dip plating conditions may negate the protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
