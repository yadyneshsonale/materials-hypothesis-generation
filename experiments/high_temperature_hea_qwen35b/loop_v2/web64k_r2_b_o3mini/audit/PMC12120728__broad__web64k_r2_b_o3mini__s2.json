  "claims": [
    {
      "text": "Tungsten-based refractory alloys are candidates for plasma-facing components in fusion reactors.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5434025::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A W-based refractory high-entropy alloy containing in-situ TiC can be fabricated by elemental powder mixing followed by spark plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5434025::web::025::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Forming TiC in situ permits the use of a practical powder-metallurgy route.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::025::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adjusting alloy formulation and sintering parameters will produce a controlled TiC nanoprecipitate phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::025::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting TiC nanoprecipitates will be coherent with the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract",
        "PMC5434025::web::025::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiC nanoprecipitates will be uniformly distributed both along grain boundaries and within grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC nanoprecipitates will act as sinks for irradiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC nanoprecipitates will capture irradiation-induced vacancies and interstitials.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect capture by TiC nanoprecipitates will suppress helium-bubble growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC nanoprecipitates will provide dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract",
        "PMC5434025::web::025::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitation can increase strength while retaining appreciable tensile ductility in a tungsten refractory high-entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiC-modified alloy will have improved radiation tolerance relative to the unmodified alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC-modified alloy will show less irradiation-induced hardening than the unmodified control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC-modified alloy will show a lower density of helium-induced bubbles than the unmodified control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After irradiation, the TiC-modified alloy will maintain or improve yield strength and ductility relative to the unmodified control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Helium-ion irradiation near 1023 K and fluences of approximately 10^20–10^21 ions/m^2 are representative of plasma-facing fusion conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect depends on irradiation temperature, fluence, and TiC precipitate volume fraction remaining within an operational window.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive TiC formation and coarsening could embrittle the alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
