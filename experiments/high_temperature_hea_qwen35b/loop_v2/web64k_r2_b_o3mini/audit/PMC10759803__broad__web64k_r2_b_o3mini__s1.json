      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Room-temperature mechanical performance will remain within approximately 5% of the Hf-free baseline.",
