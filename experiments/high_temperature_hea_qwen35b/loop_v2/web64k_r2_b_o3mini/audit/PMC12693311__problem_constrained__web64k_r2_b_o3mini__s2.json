        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Melt spinning at 10^5–10^6 K/s yields an amorphous structure in this alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ultra-rapid cooling inhibits extensive nucleation and growth of primary non-eutectic crystalline phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Faster cooling increases undercooling and shifts crystallization temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::017::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ultra-rapid cooling minimizes the time available for diffusion, nucleation, and crystal growth.",
