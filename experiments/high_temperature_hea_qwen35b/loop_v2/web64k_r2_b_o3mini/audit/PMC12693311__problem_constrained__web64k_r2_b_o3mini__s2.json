      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to cooling at 52 or about 3018 K/s, ultra-rapid quenching will produce a larger amorphous fraction and fewer crystalline phases.",
      "field": "predicted_outcome",
