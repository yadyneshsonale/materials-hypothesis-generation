  "claims": [
    {
      "text": "The as-cast HfMoTaTiZr baseline has a density of approximately 10.21 g/cm3.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast HfMoTaTiZr baseline has a room-temperature yield strength of approximately 1600 MPa.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast HfMoTaTiZr baseline has an elevated-temperature yield strength of approximately 855 MPa.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing some Hf in HfMoTaTiZr with 5-10 at% Al will reduce alloy density.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing some Hf with Al can be implemented while retaining the high room-temperature yield strength of HfMoTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing some Hf with Al can preserve the elevated-temperature yield strength of HfMoTaTiZr at approximately 1000 °C.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified HfMoTaTiZr alloy will retain a homogeneous single-phase BCC solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition will cause only minor lattice-parameter adjustments.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al is a lightweight alloying element whose addition can lower the density of refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al has a moderate atomic-size mismatch relative to Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al substitution in HfMoTaTiZr will provide solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled Al addition will preserve the dislocation-mediated deformation mechanisms of the parent HfMoTaTiZr alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Al substitution will reduce density by approximately 10%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Room-temperature yield strength after Al substitution will remain within 15% of the approximately 1600 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yield strength near 1000 °C after Al substitution will remain within 15% of the approximately 855 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al0.4Hf0.6NbTaTiZr had a density of 9.05 g/cm3 compared with 9.94 g/cm3 for HfNbTaTiZr.",
      "field": "supporting evidence rationale",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Al to HfNbTaTiZr increased specific yield strength from 93.56 to 203.43 MPa·cm3/g.",
      "field": "supporting evidence rationale",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516739::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloys will be compared under quasi-static loading at room temperature and approximately 1000 °C using strain rates similar to the baseline tests.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The possibility that Al creates secondary phases or changes phase stability is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A yield-strength decrease greater than 15% at either test temperature is proposed as a rejection criterion.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
