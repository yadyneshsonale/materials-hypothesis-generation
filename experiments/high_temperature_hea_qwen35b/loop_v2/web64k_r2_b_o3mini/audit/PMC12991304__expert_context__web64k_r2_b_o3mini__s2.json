      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::019::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed surface structure will weaken CO or other intermediate binding and thereby reduce poisoning.",
