      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::021::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "The Pt-enriched surface layer will remain stable because of the high-entropy configuration of the underlying alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::021::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "The high-entropy substrate will mitigate Pt sintering and structural degradation during aging.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::021::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "Atomically dispersed surface Pt sites will act as favorable active centers for low-temperature oxidation.",
