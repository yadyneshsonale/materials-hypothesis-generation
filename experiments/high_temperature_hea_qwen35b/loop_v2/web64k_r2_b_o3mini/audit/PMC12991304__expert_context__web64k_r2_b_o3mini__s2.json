      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12246256::web::007::design_and_synthesis_of_heasa_pt"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Resistance to sintering will preserve activity through prolonged aging and improve catalyst lifetime.",
