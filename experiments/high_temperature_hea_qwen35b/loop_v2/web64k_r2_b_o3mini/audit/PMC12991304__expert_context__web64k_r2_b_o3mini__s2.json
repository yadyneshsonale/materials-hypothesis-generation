        "PMC12224923::web::019::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "The annealed catalyst will provide effective low-temperature oxidation below 150 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed catalyst will show lower T50 and T100 values than the unmodified catalyst.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12224923::web::019::catalytic_activity_and_stability_assessm"
      ],
      "same_system": "no"
    },
    {
      "text": "Pt surface enrichment will reduce deactivation caused by H2O and NO.",
