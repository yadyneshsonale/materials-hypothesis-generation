  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The identity of X governs whether CrFeCoNiX develops and maintains a protective oxide scale above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiAl forms an Al2O3-based or mixed Al–chromia scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al-containing scale is slow-growing and adherent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al-containing scale retards oxygen ingress and mitigates cation diffusion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn undergoes rapid outward diffusion during oxidation of CrFeCoNiMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn forms volatile or loosely bonded oxides that crack or spall.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si behaves similarly to Mn by producing unstable, cracking, or spalling oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide adhesion is influenced by thermal-expansion mismatch between the scale and substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 has sufficiently high thermodynamic stability to promote a protective barrier in the Al-containing alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fast Mn cation diffusion causes rapid, voluminous oxide growth and internal or subsurface porosity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid Mn-derived oxide growth produces high stresses that cause cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective quality is determined by the balance between outward cation diffusion and inward oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al-containing variant will have a thinner and more adherent oxide layer than the Mn-containing variant.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al-containing variant will exhibit parabolic oxide-growth kinetics.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-containing variant will have improved long-term oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Mn-containing variant will develop a thicker, porous, and non-uniform oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC9692591::web::023::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Si-containing variant will develop a thicker, non-uniform scale that cracks and spalls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unstable oxidation of the Mn- or Si-containing variants may degrade their mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed scope includes homogenized single- or multiphase solid solutions exposed at or above 900 °C for at least about 12 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
