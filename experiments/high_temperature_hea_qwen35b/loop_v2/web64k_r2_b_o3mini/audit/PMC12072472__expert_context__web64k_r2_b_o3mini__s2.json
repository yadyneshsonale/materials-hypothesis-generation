  "claims": [
    {
      "text": "The intervention is to replace a minor fraction of elemental Cr with Al to produce a Cr–Al alloy coating.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::001::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A representative modified coating contains approximately 5 at.% Al and 95 at.% Cr.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Al will promote formation of an alumina layer at the Cr/Zr interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interfacial alumina layer will be thin and continuous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperature, Al in the coating will preferentially oxidize to Al2O3 at the Cr/Zr interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting alumina scale will be thermodynamically stable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will act as a diffusion barrier that inhibits Cr–Zr interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An elemental Cr coating on zirconium-alloy cladding can peel or crack during high-temperature steam oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Premature failure of elemental Cr coatings at high temperature is caused by excessive Cr–Zr interdiffusion.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elemental Cr coatings provide good protection under normal subcritical-water conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to pure Cr, the Cr–Al coating will reduce Cr–Zr interdiffusion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to pure Cr, the Cr–Al coating will better retain structural integrity during high-temperature steam oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr–Al coating will preserve corrosion resistance during normal PWR-water service.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed accident-regime applicability extends to steam temperatures of approximately 800–1000 °C.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed normal-service applicability is limited to subcritical PWR primary-water conditions.",
      "field": "boundary",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Long-term behavior under neutron irradiation and complex thermal cycling remains unverified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Al concentration needed to produce an effective barrier without degrading other coating properties is undetermined.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
