  "claims": [
    {
      "text": "The as-cast AlCoCrFeNi2.1 alloy has a fine, uniform lamellar FCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::008::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting AlCoCrFeNi2.1 eutectic alloy has a favorable balance of strength and ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::008::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 eutectic alloy can be produced at industrial scale by conventional casting.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::008::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy has insufficient long-term creep and corrosion resistance for aerospace fastener applications.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.5–1 at% each of Y and Hf by melting and conventional casting can retain a similar fine lamellar phase structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC4145285::web::008::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf co-doping will improve the grain or interface stability of AlCoCrFeNi2.1.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf dopants preferentially segregate to grain boundaries and phase interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dopant segregation suppresses grain-boundary or interfacial diffusion paths.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppression of grain-boundary diffusion by Y and Hf will mitigate creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y and Hf co-doping promotes a more stable and adherent oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified oxide scale better resists spallation during corrosive exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified oxide scale will resist spallation during repeated thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Y/Hf-doped alloy will have a lower room-temperature creep strain rate than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-doped alloy will have improved elevated-temperature creep resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-doped alloy will have a longer creep rupture life than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y/Hf-doped alloy will exhibit reduced corrosion damage, including reduced oxide-scale spallation or mass loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y/Hf co-doping will preserve or slightly improve the starting alloy's strength–ductility balance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefits require dopant concentrations low enough to avoid detrimental phase segregation or embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
