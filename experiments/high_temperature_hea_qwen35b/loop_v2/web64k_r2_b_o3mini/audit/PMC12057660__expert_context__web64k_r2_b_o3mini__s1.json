      "supporting_ids": [
        "PMC7181682::web::009::effect_of_temperature_on_alloy_formation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Simultaneous precursor decomposition causes burst nucleation and a high nucleation density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
