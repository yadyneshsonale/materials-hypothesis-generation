  "claims": [
    {
      "text": "Unmodified TC4 has an alpha-plus-beta dual-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TC4 has comparatively low surface hardness and poor wear resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "TC4's low hardness and poor wear resistance impair its performance under high-contact-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is laser cladding a TiAl-based coating containing approximately 5–10 at.% Ni onto TC4.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction",
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ni induces lattice distortion in the TiAl matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni promotes the formation of fine intermetallic phases in the TiAl-based coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ni produces a refined coating microstructure with enhanced grain-boundary characteristics.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni-induced lattice distortion and fine intermetallic precipitation provide solid-solution and precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed strengthening mechanisms raise coating hardness and reduce abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Laser cladding provides a metallurgical bond between the coating and the TC4 substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The TiAl-based surface coating preserves TC4's lightweight character.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction",
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ni-doped TiAl-based coating preserves TC4's corrosion resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated surface will have approximately 30–40% greater hardness than untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coated surface will have approximately 25–30% lower wear rate than untreated TC4.",
