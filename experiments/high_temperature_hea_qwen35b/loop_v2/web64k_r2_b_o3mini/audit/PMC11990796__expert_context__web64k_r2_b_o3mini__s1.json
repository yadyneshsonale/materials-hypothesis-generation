      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo-to-Nb substitution will enhance dislocation mobility by lowering barriers to slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain substantial solid-solution strengthening.",
