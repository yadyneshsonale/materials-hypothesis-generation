      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::000::abstract",
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fracture strain may rise from approximately 12% toward approximately 27%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Yield strength will decrease by less than 10% relative to the 1719 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive removal of Mo may cause a substantial loss of strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
