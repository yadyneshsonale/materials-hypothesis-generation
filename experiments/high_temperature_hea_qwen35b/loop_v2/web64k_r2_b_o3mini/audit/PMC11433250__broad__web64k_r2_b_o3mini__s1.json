{
  "run_id": "PMC11433250__broad__web64k_r2_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Adding a small amount of yttrium to a boride-based component will promote formation of a compact, stable oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y-promoted oxide scale will resist attack by molten aluminum during hot-dip plating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention can be implemented by introducing low-level Y into either the surface or bulk through alloying or surface treatment.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit should occur during exposure to molten aluminum at temperatures around or above 660 °C under typical hot-dip-plating atmospheres.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y addition will produce a continuous and adherent Y-enhanced oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract",
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective scale will most likely be alumina or a Y-aluminate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Yttrium promotes nucleation of protective oxide films.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium promotes adhesion of protective oxide films.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Y facilitates formation of a self-healing oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-enhanced oxide layer limits diffusion and thereby slows dissolution of the underlying boride.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-doped boride components will have a lower molten-aluminum corrosion rate than undoped boride components.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::014::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Y-doped boride components will exhibit less weight loss than undoped components after molten-aluminum exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-doped boride components will retain better surface integrity than undoped components after molten-aluminum exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The appropriate baseline is an otherwise equivalent boride component without Y tested under identical conditions.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect exists only over an optimal Y-concentration range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Y may fail to provide further improvement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aggressive impurities in the molten-aluminum environment may negate or limit the improvement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-enhanced scale may have uncertain long-term stability under cyclic thermal or mechanical stress.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
