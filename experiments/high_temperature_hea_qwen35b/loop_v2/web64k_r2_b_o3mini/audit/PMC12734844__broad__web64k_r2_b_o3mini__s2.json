      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::032::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Substrate preheating reduces the thermal gradient between the melt pool and substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal gradients lower residual-stress accumulation in the build.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal gradients produce a more uniform solidification process.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower residual stress and more uniform solidification decrease porosity, cracking, and other fabrication defects.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::032::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Substrate preheating raises the base temperature and narrows the temperature differential during melting and solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Narrowing the temperature differential moderates thermal shock and diminishes rapid-cooling-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substrate preheating limits internal-stress development.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substrate preheating promotes a more homogeneous microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated SLM builds will have better dimensional accuracy than non-preheated builds.",
