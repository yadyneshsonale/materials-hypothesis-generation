      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated SLM builds will have fewer pores and cracks than non-preheated builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::032::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Preheated SLM builds will have higher yield strength and ductility than non-preheated builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::032::5_conclusions"
      ],
      "same_system": "no"
