      ],
      "same_system": "yes"
    },
    {
      "text": "As-built SLM HEAs such as CoCrFeNiMn typically contain internal pores, high dislocation densities, residual stresses, and geometric distortions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9736672::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A controlled substrate-preheating temperature of 200–400°C is an appropriate intervention for SLM HEAs.",
