      "supporting_ids": [
        "PMC9736672::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing the temperature differential between the molten pool and substrate moderates the cooling rate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing the molten-pool-to-substrate temperature differential lowers residual stress.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substrate pre-heating improves grain coalescence.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substrate pre-heating reduces porosity and hot cracking in additively manufactured HEAs.",
      "field": "structural_mediator",
      "needs_support": true,
