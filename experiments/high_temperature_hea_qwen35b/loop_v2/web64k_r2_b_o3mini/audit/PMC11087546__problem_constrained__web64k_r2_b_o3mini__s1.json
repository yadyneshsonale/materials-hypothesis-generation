  "claims": [
    {
      "text": "The starting eutectic high-entropy alloy has soft FCC lamellae and hard B2/BCC lamellae in a hierarchical dual-phase architecture.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::014::discussion",
        "PMC6353877::web::016::discussion",
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lamellar phases have strong semi-coherent phase boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::014::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A phase-selective recrystallization heat treatment can fully or preferentially recrystallize the soft phase while leaving it embedded in the hard-phase skeleton.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment can avoid coarsening or significant alteration of the hard-phase microstructure and lamellar architecture.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase-selective recrystallization produces FCC lamellae with reduced dislocation density.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization eliminates precursors for dislocation pile-ups at internal interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC6175879::web::014::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment retains intact strong semi-coherent phase boundaries associated with the hard phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6175879::web::014::discussion",
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The recrystallized soft phase accommodates subsequent strain more homogeneously.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Strong semi-coherent boundaries impede dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::014::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The retained internal boundaries promote dislocation storage and work hardening in the FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::014::discussion",
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing interfacial dislocation pile-ups reduces local stress concentrations and delays microcrack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6175879::web::014::discussion",
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Internal-stress accumulation and strain localization near lamellar phase boundaries can cause cracks to propagate and coalesce along the interfaces.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated eutectic alloys generally suffer from limited ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated starting alloy has approximately 25% uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The phase-selectively recrystallized alloy can reach approximately 35% uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phase-selectively recrystallized alloy can sustain true stress of approximately 2 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment will maintain or increase yield strength relative to the untreated starting material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed benefit applies under room-temperature, quasi-static tensile loading.",
