  "claims": [
    {
      "text": "The eutectic high-entropy alloy has a finely dispersed lamellar microstructure of alternating FCC and B2 phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FCC lamellae are relatively soft and the B2 lamellae are relatively hard.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy initially forms a thin protective oxide or passive film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC9319277::web::022::3_4_corrosion_observation",
        "PMC7515071::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elevated-temperature sliding mechanically disrupts and removes the protective oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide removal exposes interphase boundaries to the corrosive environment.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The constituent phases have distinct electrochemical potentials and therefore form local galvanic cells at their boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposed phase boundaries and B2 regions are preferential sites for localized corrosion and anodic dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing temperature enhances localized corrosion and selective dissolution in the eutectic high-entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Chloride ions attack passive films on Al-Ni-rich phases and promote localized corrosion.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Corrosion weakens interphase interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-induced interfacial weakening accelerates mechanical material removal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear-assisted corrosion and corrosion-assisted wear form a mutually reinforcing positive-feedback cycle.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined wear-corrosion produces super-additive total degradation relative to isolated wear and isolated corrosion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined exposure produces deeper and wider wear tracks than the isolated-exposure baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined exposure produces a higher density of corrosion pits localized at phase interfaces than the isolated-exposure baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Combined exposure causes greater overall mass loss than isolated wear or isolated corrosion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated temperature accelerates oxidation kinetics under the proposed boundary conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Identical specimens tested under wear-only, corrosion-only, and simultaneous wear-corrosion conditions provide a controlled comparison.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
