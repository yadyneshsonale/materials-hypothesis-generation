      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6687781::web::015::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hybrid process enhances phase-boundary integrity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heterogeneous regions and interfaces generate internal back-stress.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687781::web::015::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The ultrafine heterogeneous structure increases strength by enhancing dislocation storage and impeding dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
