  "claims": [
    {
      "text": "The baseline is a magnetron-sputtered FeNiCrCoCu coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited coating has a nanocrystalline microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited coating has a homogeneous elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::033::wear_testing_evaluation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-temperature wear resistance of FeNiCrCoCu is governed by an in situ protective oxide layer that is predominantly chromium oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide layer is coherent and adherent during high-temperature sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled pre-oxidation promotes early formation of a continuous chromium-rich oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Deposition at a moderately elevated substrate temperature can substitute for controlled pre-oxidation in promoting the protective oxide.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The principal surface mediator is Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "At high operating temperatures, chromium and other alloying elements oxidize to form a stable surface oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::033::wear_testing_evaluation",
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide acts as a diffusion barrier that limits further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::033::wear_testing_evaluation",
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide reduces direct metal-to-metal contact during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing direct metal-to-metal contact lowers friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A thermally formed protective oxide layer improves wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation enhances the uniformity and continuity of the protective oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pre-oxidized FeNiCrCoCu coating will have a lower high-temperature wear rate than a non-pre-oxidized coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "A pre-oxidized FeNiCrCoCu coating will have a lower high-temperature coefficient of friction than a non-pre-oxidized coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
