        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-pressure torsion will refine the selected steel's grain size.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The conventional stainless or duplex-steel baseline typically has a coarse-grained microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement increases the fraction of high-angle grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-angle grain boundaries act as fast diffusion paths for chromium atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced chromium transport in ultrafine-grained steel accelerates formation of a chromium-enriched passive film.",
      "field": "mechanism",
