      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater chromium enrichment of the passive film is associated with improved corrosion resistance in ultrafine-grained stainless steels.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stainless steels processed to form ultrafine-grained structures generally exhibit better corrosion resistance than coarse-grained counterparts.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
