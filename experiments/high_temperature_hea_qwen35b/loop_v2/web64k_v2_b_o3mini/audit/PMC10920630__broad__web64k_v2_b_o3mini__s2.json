      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultrafine-grained steel will have a lower corrosion current density than the coarse-grained baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed grain-refinement benefit applies in high-temperature, high-pressure chloride-containing aqueous or simulated primary-water environments.",
