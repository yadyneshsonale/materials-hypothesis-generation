      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Progressive strain hardening delays strain localization and premature plastic instability.",
