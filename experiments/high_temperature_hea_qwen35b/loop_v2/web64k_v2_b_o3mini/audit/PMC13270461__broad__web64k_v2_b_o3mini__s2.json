  "claims": [
    {
      "text": "Oxidation resistance in the NiCoCrAl-type alloy is governed by a two-stage mechanism consisting of initial protective-scale formation followed by diffusion suppression.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid selective oxidation of Al forms a protective Al2O3 scale during initial oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract",
        "PMC11169556::web::005::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf co-doping produces enhanced lattice distortion in the Al-depletion zone.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice distortion in the Al-depletion zone increases vacancy formation energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice distortion in the Al-depletion zone raises Al migration barriers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Higher vacancy formation energy and Al migration barriers suppress sustained Al diffusion toward the oxide interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppressed Al diffusion slows oxide-scale growth and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy is equiatomic or near-equiatomic NiCoCrAl.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has a uniform, lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled Y and Hf co-doping is the proposed intervention in a NiCoCrAl-type alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation behavior should be compared after exposure at approximately 1200°C for 500 hours.",
      "field": "conditions",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The comparison should use cyclic exposure in compressed dry air or another controlled oxidizing environment.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
