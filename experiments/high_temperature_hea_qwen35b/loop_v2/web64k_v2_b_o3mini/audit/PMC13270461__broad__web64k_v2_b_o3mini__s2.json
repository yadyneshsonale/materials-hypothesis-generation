      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13067856::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced TGO growth and spallation will indicate improved oxidation resistance and maintained material integrity.",
