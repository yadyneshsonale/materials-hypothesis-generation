  "claims": [
    {
      "text": "Some refractory BCC high-entropy alloys possess exceptional strength at high temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Edge dislocations govern the high strength and strength retention of NbTaTiV and CrMoNbV alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Edge-dislocation dominance generally governs hardness and strength throughout refractory BCC high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial NbTaTiV-based HEA is single-phase BCC.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract",
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial alloy is in an as-processed, undeformed state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled deformation parameters can be selected to favor edge-dislocation multiplication in the refractory HEA.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional BCC elemental metals and dilute alloys are generally controlled by screw dislocations during plastic flow.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The relative fraction of edge and screw dislocations is the structural mediator governing mechanical behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A higher density of mobile edge dislocations increases lattice friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mobile edge dislocations act as effective barriers to plastic flow.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed edge-dislocation mechanism raises hardness in refractory BCC HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed edge-dislocation mechanism raises yield strength in refractory BCC HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Edge-dislocation-controlled strength is less sensitive to temperature than screw-dislocation-controlled strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Edge-dislocation dominance produces a high-temperature strength plateau.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An edge-dislocation-dominated refractory HEA will have greater hardness and yield strength than a conventional BCC alloy or a screw-dominated HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The edge-dislocation-dominated refractory HEA will retain strength, potentially as a plateau, up to approximately 1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis applies from room temperature to approximately 1073 K under standardized nanoindentation and tensile-test conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of hardness and strength enhancement depends on alloy composition, processing history, and testing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TEM can be used to determine whether edge or screw dislocations predominate in these alloys.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
