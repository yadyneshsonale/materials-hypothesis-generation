      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical reinforcement and passive-film stabilization synergistically reduce wear and corrosion during simultaneous mechanically and chemically aggressive exposure.",
