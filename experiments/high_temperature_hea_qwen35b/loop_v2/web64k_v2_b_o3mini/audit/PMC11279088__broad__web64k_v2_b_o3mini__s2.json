        "PMC11169556::web::003::introduction",
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aluminum oxidizes preferentially at the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Al2O3 scale is dense, uniform, and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An Al2O3 layer provides resistance to high-temperature oxidation and corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 scales grow slowly and are stable relative to chromium oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The sluggish-diffusion effect retards outward diffusion of oxygen and other fast-diffusing species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 scale impedes further oxygen ingress into the alloy.",
      "field": "mechanism",
