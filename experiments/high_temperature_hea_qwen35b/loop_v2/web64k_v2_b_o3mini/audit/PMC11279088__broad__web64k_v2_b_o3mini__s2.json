      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing aluminum content will lower oxidation mass gain relative to an otherwise similar lower-aluminum HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing aluminum content will produce a more uniform, adherent, and protective Al2O3 scale than in the lower-aluminum control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
