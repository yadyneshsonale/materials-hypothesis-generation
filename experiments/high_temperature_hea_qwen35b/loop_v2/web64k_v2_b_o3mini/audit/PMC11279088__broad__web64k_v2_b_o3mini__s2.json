  "claims": [
    {
      "text": "High-entropy alloys intrinsically possess lattice distortion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intrinsic lattice distortion in HEAs causes sluggish elemental diffusion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sluggish diffusion enables selective, slow-growing oxidation of added aluminum.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aluminum in an HEA can oxidize to form an Al2O3 surface layer.",
