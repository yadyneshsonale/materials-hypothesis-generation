        "PMC5893566::web::007::effect_of_magnetism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-related magnetic frustration eliminates the FCC-HCP energy difference in CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
