      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting nanotwins impede dislocation motion and improve load transfer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi has greater strength than equiatomic CrMnFeCoNi.",
      "field": "predicted_outcome",
