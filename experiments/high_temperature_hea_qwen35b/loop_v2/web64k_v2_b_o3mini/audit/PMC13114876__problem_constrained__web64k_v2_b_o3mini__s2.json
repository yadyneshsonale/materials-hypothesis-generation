      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A protective oxide formed at elevated temperature can increase the wear resistance of a high-entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Wear and corrosion act synergistically so that total degradation is significantly greater than the sum of their individual effects.",
