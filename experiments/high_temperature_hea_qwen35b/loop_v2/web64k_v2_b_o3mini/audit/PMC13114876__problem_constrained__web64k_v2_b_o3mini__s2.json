      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy surface has a continuous protective oxide film at ambient conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Mechanical wear preferentially removes the oxide film from softer phase regions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical wear preferentially ruptures the oxide film at interfaces between dissimilar phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide removal exposes adjacent phases having mismatched electrochemical or corrosion potentials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exposed dissimilar phases form localized galvanic cells.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized galvanic cells accelerate anodic dissolution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized corrosion impedes or undermines protective oxide reformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2 regions or microstructural boundaries are preferential sites for metastable pitting in a eutectic high-entropy alloy.",
