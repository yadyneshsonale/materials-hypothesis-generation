      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9319277::web::022::3_4_corrosion_observation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher temperature increases selective dissolution of Al-Ni-rich phases in the cited eutectic high-entropy alloy.",
