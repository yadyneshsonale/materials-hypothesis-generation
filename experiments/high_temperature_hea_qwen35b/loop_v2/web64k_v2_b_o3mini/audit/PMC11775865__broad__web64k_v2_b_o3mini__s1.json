      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9032957::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The constituent metals are present in equimolar ratios within each high-entropy nanoalloy particle.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9032957::web::000::abstract",
        "PMC9032957::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ultrafast laser-induced reduction produces uniformly mixed high-entropy nanoalloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9032957::web::000::abstract",
        "PMC9032957::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The laser-produced particles initially have a single-phase disordered structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The kinetically trapped structure retards atomic diffusion at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow reaction kinetics in conventional synthesis methods lead to phase segregation during nanoalloy formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9032957::web::000::abstract",
        "PMC9032957::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Slower reduction permits enough local atomic mobility during particle formation to initiate segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9032957::web::000::abstract",
        "PMC9032957::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Slower reduction initiates chemical ordering during particle formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic diffusion is significant during aging above 600 K for the proposed nanoalloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
