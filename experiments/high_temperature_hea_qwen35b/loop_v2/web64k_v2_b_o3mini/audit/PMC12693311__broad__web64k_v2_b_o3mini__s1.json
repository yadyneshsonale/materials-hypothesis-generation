      ],
      "same_system": "yes"
    },
    {
      "text": "Arc melting followed by cooling at about 52 K/s produces a complex, multiphase crystalline microstructure in Cr16Mn16Fe16Co16Ni16P20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
