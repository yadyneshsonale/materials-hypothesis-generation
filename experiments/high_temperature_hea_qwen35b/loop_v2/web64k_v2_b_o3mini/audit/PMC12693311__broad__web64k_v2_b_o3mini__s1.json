        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The melt-spun sample will have a higher crystallization-onset temperature than the sample cooled at about 52 K/s.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effects require the cooling rate to exceed a critical threshold in the ultra-rapid-quenching regime.",
