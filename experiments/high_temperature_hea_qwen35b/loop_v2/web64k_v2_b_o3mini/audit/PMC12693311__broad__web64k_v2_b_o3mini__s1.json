        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changing from cooling at about 52 K/s to melt-spinning at 10^5–10^6 K/s improves the thermal stability of the resulting amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Very rapid melt-spinning produces an amorphous structure in Cr16Mn16Fe16Co16Ni16P20.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
