        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid quenching reduces crystalline nucleation by preventing sufficient atomic rearrangement.",
      "field": "structural_mediator",
      "needs_support": true,
