        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ultra-rapid cooling suppresses atomic diffusion in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultra-rapid cooling suppresses the nucleation of crystalline phases and freezes in a disordered state.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Kinetic hindrance introduced during quenching reduces the driving force for crystallization during subsequent heating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The melt-spun sample will be fully amorphous, as indicated by XRD and TEM.",
