      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6385271::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting dense, defect-lean microstructure will increase tensile strength.",
