      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6385271::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed microstructure will contain fewer high-angle grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-angle grain boundaries typically act as segregation sites and stress concentrators.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid isothermal SPS reduces the time available for thermally driven segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6385271::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid, pressure-assisted SPS limits the accumulation of residual thermal stress.",
