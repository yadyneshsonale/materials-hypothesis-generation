      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The compact HfO2 layer acts as a barrier to further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Restricting oxygen ingress reduces oxidation of the underlying zirconium alloy.",
