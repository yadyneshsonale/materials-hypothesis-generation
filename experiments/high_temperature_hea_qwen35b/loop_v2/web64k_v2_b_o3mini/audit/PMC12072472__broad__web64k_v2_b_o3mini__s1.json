      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A hafnium coating will maintain mechanical and chemical compatibility with reactor service conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hafnium-coated zirconium-alloy cladding will have lower oxidation weight gain per unit area than an uncoated control under the same steam exposure.",
      "field": "predicted_outcome",
