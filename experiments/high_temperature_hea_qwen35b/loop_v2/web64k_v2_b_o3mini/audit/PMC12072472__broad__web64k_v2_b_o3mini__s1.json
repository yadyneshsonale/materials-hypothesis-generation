      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The improvement will result from formation of a protective, dense HfO2 surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::016::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A hafnium coating approximately 120 μm thick can be produced by hot-press sintering.",
      "field": "intervention",
      "needs_support": true,
