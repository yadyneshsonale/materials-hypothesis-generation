  "claims": [
    {
      "text": "The initial AlCrFeNiSi feedstock is produced by conventional routes such as gas atomization and has typically spherical particles.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The feedstock should contain 1–2 wt% nanoscale Y2O3.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7296023::web::015::dispersion_strengthened_am_process"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 can be incorporated into the feedstock by acoustic mixing before laser powder bed fusion.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7296023::web::015::dispersion_strengthened_am_process"
      ],
      "same_system": "no"
    },
    {
      "text": "Acoustic mixing will distribute the Y2O3 uniformly throughout the AlCrFeNiSi powder.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The powder blend is mixed in 10-minute increments for a total of 60 minutes, with cooling between increments.",
      "field": "conditions",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7296023::web::015::dispersion_strengthened_am_process"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified powder is processed by LPBF on a preheated substrate.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC7296023::web::015::dispersion_strengthened_am_process"
      ],
      "same_system": "no"
    },
    {
      "text": "Substrate preheating locally reduces thermal gradients.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified powder can be processed using parameters similar to conventional high-thermal-load AM regimes.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 nanoparticles remain uniformly distributed in the printed material.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 nanoparticles act as heterogeneous nucleation sites during solidification.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additional nucleation sites refine the microstructure and produce a more homogeneous grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide dispersoids modify rapid-solidification dynamics by increasing the number of nucleation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Finer and more uniform grains reduce residual thermal stresses in printed AlCrFeNiSi components.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide dispersion impedes dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation motion increases the yield strength of the printed components.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersion strengthening also increases the ductility of the printed components.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3-modified components will have lower residual stress than otherwise comparable LPBF components made from unmodified AlCrFeNiSi powder.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3-modified components will exhibit higher yield strength and ductility than otherwise comparable components made from unmodified AlCrFeNiSi powder.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable to miniature powder-bed-fused components within a standard high-thermal-load AM process window.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7296023::web::015::dispersion_strengthened_am_process"
      ],
      "same_system": "no"
    }
  ],
