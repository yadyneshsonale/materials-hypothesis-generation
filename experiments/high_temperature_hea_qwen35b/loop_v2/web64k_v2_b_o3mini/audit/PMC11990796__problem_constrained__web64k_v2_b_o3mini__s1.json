  "claims": [
    {
      "text": "The initial NbZrTiHfMo alloy is equiatomic.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial equiatomic NbZrTiHfMo alloy has a disordered BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has a room-temperature compressive yield strength of 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content contributes to a large electronegativity difference.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High Mo content is associated with reduced room-temperature plasticity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results",
        "PMC7514121::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Part of the Mo should be replaced by Nb while retaining the other constituent elements.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-to-Nb substitution will reduce the alloy's overall electronegativity difference.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-to-Nb substitution will reduce lattice strain.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced electronegativity difference and lattice strain will enhance dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced dislocation mobility will allow greater accommodation of plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb has been observed in related refractory high-entropy alloys to improve ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb has only a minor adverse impact on yield strength in related refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will retain a compressive yield strength close to 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will exhibit greater room-temperature compressive plastic strain than the equiatomic baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The strength-plasticity benefit depends on retaining a single-phase disordered BCC structure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength-plasticity benefit requires enough Nb substitution to reduce the proposed electronegativity effect without a significant loss of solution strengthening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
