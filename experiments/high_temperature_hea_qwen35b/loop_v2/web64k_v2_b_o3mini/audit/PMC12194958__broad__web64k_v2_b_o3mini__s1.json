      "supporting_ids": [
        "PMC8838456::web::026::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "(TaNb)0.67(HfZrTi)0.33 is a superconducting alloy with a bcc structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
