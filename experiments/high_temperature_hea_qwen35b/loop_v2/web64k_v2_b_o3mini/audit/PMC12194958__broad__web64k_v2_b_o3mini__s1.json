      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838456::web::026::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The maintenance versus disruption of single-phase bcc structure mediates superconductivity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838456::web::026::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The stable bcc lattice sustains favorable electronic density of states for Cooper-pair formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stable bcc lattice sustains favorable electron-phonon interactions for Cooper-pair formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of an Sc-rich hcp phase disrupts the uniform electronic environment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sc-rich hcp phase is not superconducting, whereas the Sc-poor bcc phase is superconducting.",
