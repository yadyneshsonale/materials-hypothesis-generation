      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Electronically modulated, isolated Pt/Pd sites strengthen or optimize nitrobenzene chemisorption.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Modified nitrobenzene chemisorption at isolated Pt/Pd sites enhances nitrobenzene hydrogenation activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 has higher nitrobenzene-hydrogenation performance than PtPd/SiO2.",
