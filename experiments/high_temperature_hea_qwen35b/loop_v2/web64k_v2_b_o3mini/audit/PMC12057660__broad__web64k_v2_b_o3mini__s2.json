      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The metal precursors are initially uniformly mixed.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reliable HEA formation is controlled by stochastic, entropy-driven assembly during low-temperature solvothermal synthesis.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Low synthesis temperature limits precursor or atom mobility and thereby increases alloy randomness and noble-metal site isolation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy lowers the Gibbs free energy of a random solid-solution phase in PtPdCoCuNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloying Pt and Pd with Co, Cu, and Ni produces highly isolated Pt and Pd active sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Charge transfer to Pt and Pd makes the isolated sites electron-rich or nucleophilic.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::016::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The charge transferred to Pt and Pd originates specifically from neighboring Co, Cu, and Ni atoms.",
