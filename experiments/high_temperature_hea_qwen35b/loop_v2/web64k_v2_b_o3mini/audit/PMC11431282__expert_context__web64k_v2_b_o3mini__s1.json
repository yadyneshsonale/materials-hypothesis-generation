  "claims": [
    {
      "text": "The unmodified (MnNiSi)0.62(FeCoGe)0.38 alloy has a large caloric response under applied-field and pressure-field operation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified alloy has poor mechanical integrity and tends to crack.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of 2–4 at.% Nb during synthesis.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb addition will cause preferential segregation of Nb to grain boundaries during solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb addition will form a fine, discontinuous, ductile Nb-rich intergranular second phase in situ.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6212883::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Nb-rich phase will bridge or reinforce grain boundaries and impede crack initiation and propagation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb segregation will lower the local melting point and thereby promote precipitation of the ductile phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The primary caloric phase transition of the matrix will remain dominant after adding 2–4 at.% Nb.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will have greater compressive strength than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6212883::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Nb-modified alloy will exhibit less crack propagation under load than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compressive strength may improve from values near 150–220 MPa to significantly higher values.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Entropy change and other caloric-response metrics will remain largely unchanged after Nb addition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified and control samples will be processed and tested under identical casting or sintering, field, pressure, temperature-cycling, and compressive-loading conditions.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Nb-modified alloy remains rare-earth-free.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The caloric transition may be sensitive to Nb-induced microstructural or compositional changes.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if Nb addition fails to produce a statistically significant mechanical-integrity improvement or notably reduces caloric response relative to the control.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
