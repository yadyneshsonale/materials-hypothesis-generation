      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 scales grow more slowly and are more stable than chromium oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A continuous alumina scale limits oxygen ingress and cation diffusion.",
