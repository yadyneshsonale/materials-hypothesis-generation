      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::web::022::cross_section_observation_of_oxide_layer",
        "PMC9692591::web::022::3_3_thermal_stability_and_high_temperatu"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Limiting oxygen and cation transport suppresses continued oxidation and mechanical degradation.",
