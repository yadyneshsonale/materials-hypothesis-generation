  "claims": [
    {
      "text": "Controlled thermal pre-oxidation of FeNiCrCoCu thin films will improve their high-temperature wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation forms a coherent protective oxide layer on FeNiCrCoCu.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-formed oxide provides a hard diffusion-barrier interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-deposited films lacking the pre-formed oxide will have higher wear rates than pre-oxidized films.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline FeNiCrCoCu coating is produced by sputter deposition on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited coating has a typical columnar, homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::033::wear_testing_evaluation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-deposited coating has minimal oxide formation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal treatment in air can deliberately produce a continuous, adherent surface oxide enriched in Cr2O3 and related spinels.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant wear-testing range is 600–800 °C in air.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The structural mediator is a thin, coherent, adherent surface layer composed primarily of Cr2O3 and/or mixed spinel oxides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer limits direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer acts as a hard, lubricious interface that impedes abrasive and adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces dynamic interfacial shear under high-temperature loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced interfacial shear lowers material removal during wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized coatings will show a lower high-temperature wear rate than untreated coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::039::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized coatings will show a lower coefficient of friction than untreated coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is not asserted outside 600–800 °C or outside the applied loading regime.",
