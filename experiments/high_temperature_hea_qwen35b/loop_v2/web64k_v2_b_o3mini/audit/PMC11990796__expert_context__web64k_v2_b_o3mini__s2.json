  "claims": [
    {
      "text": "The baseline alloy is equiatomic NbZrTiHfMo.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equiatomic NbZrTiHfMo is a disordered BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy has a room-temperature compressive yield strength of 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy has low room-temperature compressive plasticity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy's low plasticity is caused by its high Mo content.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "A fraction of Mo should be replaced by additional Nb while Zr, Ti, and Hf are held constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of Mo by Nb will reduce the alloy's electronegativity difference.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of Mo by Nb will reduce lattice distortion in the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced lattice distortion and electronegativity difference will facilitate dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo provides substantial room-temperature strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo strengthens the alloy specifically through solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::003::1_introduction",
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mo increases lattice strain and electronegativity difference, thereby hindering dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb contributes less than Mo to the problematic lattice distortion and has been associated with improved ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain much of the baseline strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Partial Mo-to-Nb substitution will increase room-temperature compressive fracture strain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The increase in fracture strain will occur with only a minor reduction, if any, in yield strength relative to 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The benefit is limited to modest Mo reduction, because excessive Mo removal may compromise solid-solution strengthening.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Arc melting or similar processing will ensure a homogeneous single-phase BCC solid solution in the modified alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A substitution series replacing 20–40% of the original Mo content should be tested under room-temperature compression against the equiatomic baseline.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant fracture-strain improvement while maintaining yield strength close to 1719 MPa would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
