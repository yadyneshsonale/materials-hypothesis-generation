        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Separate nanoclustering of Cr, Ni, and Mn at grain boundaries reduces grain-boundary cohesion in CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr, Ni, and Mn nanoclustering at grain boundaries promotes intergranular crack initiation.",
