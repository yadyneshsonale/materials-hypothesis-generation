      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The demonstrated segregation-engineering example applies to a heat-treated equiatomic CrMnFeCoNi alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing grain-boundary segregation using Cr-rich secondary phases avoids ductility loss.",
