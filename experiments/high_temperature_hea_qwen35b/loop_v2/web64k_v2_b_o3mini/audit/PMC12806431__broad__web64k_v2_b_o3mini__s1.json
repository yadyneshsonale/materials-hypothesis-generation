      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial CrMnFeCoNi alloy is susceptible to deformation-induced grain-boundary nanosegregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A controlled heat treatment can form pre-existing Cr-rich secondary phases at or near grain boundaries in the same CrMnFeCoNi alloy.",
