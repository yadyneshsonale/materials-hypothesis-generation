      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate-temperature deformation of CrMnFeCoNi is associated with ductility loss and grain-boundary cracking.",
