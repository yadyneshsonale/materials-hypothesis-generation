      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::000::abstract",
        "PMC6897545::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Redirecting segregation into Cr-rich secondary phases suppresses harmful grain-boundary nanoclustering.",
