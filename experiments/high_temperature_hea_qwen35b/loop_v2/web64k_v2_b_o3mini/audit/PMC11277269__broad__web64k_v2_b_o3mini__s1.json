        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 will have a higher turnover frequency than the PtPd/SiO2 baseline.",
      "field": "predicted_outcome",
