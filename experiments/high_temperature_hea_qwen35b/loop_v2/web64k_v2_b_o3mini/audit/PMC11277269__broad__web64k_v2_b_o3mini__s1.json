      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 remains active for nitrobenzene hydrogenation at room temperature.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed effect should hold from room temperature through 80 °C on SiO2.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
