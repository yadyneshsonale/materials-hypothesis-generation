  "claims": [
    {
      "text": "Pt, Pd, Co, Cu, and Ni can be alloyed into PtPdCoCuNi nanoparticles supported on SiO2.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloying Co, Cu, and Ni into PtPd produces isolated Pt and Pd sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co, Cu, and Ni transfer charge to Pt and Pd in the PtPdCoCuNi alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Charge transfer from Co, Cu, and Ni shifts the d-band centers of Pt and Pd.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The electronic modification of Pt and Pd strengthens their interaction with nitrobenzene.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified Pt/Pd sites optimize, rather than merely strengthen, nitrobenzene adsorption.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The isolated Pt/Pd environment is nucleophilic.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved substrate interaction and isolated Pt/Pd sites enhance nitrobenzene hydrogenation activity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pt and Pd are the principal active species for nitrobenzene hydrogenation in this catalyst family.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline PtPd/SiO2 catalyst has contiguous and less-isolated noble-metal sites.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "PtPdCoCuNi/SiO2 gives a higher aniline yield than PtPd/SiO2 under nitrobenzene hydrogenation conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "At 80 °C, PtPdCoCuNi/SiO2 gives 93.9% aniline yield, compared with 44.4% for PtPd/SiO2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
