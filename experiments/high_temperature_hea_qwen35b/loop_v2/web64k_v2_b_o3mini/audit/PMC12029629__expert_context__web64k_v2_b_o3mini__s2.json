  "claims": [
    {
      "text": "Dynamic mechanical behavior in Co-free FeNiCrMn is governed by a shift in the dominant plastic-deformation mechanism across temperature and strain-rate regimes.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::002::1_introduction",
        "PMC11943535::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional dislocation glide is prevalent at lower strain rates and/or higher temperatures in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic recovery is prevalent at lower strain rates and/or higher temperatures in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher strain rates and/or lower temperatures enhance dislocation accumulation in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher strain rates and/or lower temperatures cause the onset of deformation twinning in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adiabatic heating at high strain rates limits dynamic recovery and promotes localized dislocation pile-up.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing Co lowers the stacking-fault energy of FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stacking-fault-energy effect associated with removing Co makes dynamic recovery less pronounced.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high dislocation density and deformation twins together sustain work hardening under dynamic loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::003::1_introduction",
        "PMC7512474::web::016::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism preserves ductility while sustaining dynamic work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting material has a uniform as-cast microstructure produced by conventional melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Identically prepared as-cast FeNiCrMn samples will be tested in controlled compression while strain rate and temperature are varied.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The study will compare quasi-static loading near 10^-4 s^-1 with SHPB loading at approximately 1300–2100 s^-1.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation density and deformation-twin fraction will be quantified using EBSD and TEM.",
      "field": "structural_mediator",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic yield strength will increase as strain rate increases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::003::1_introduction",
        "PMC7512474::web::016::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Yield strength will increase as testing temperature decreases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strain-hardening rate will increase with increasing strain rate or decreasing temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Dynamic loading will produce a higher deformation-twin density than quasi-static loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ductility under dynamic loading will remain comparable to the as-cast quasi-static baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
