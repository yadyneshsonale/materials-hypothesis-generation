      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fast cooling limits atomic rearrangement and traps a metastable single-phase high-entropy configuration.",
