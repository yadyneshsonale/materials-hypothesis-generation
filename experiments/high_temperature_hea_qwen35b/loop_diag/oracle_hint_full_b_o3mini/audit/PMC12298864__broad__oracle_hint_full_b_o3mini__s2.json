      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The final phase structure is approximately 83% FCC and 17% BCC.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sub-48 nm grains enhance hardness and strength through Hall–Petch grain-boundary strengthening.",
