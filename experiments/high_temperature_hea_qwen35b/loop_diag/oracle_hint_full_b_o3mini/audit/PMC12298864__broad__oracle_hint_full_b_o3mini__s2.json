      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The milling-generated dislocation density contributes to enhanced hardness and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multielement solid solution contributes to enhanced hardness and strength through solid-solution strengthening.",
