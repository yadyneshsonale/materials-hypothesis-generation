      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Superconductivity in the Tb-containing alloy disappears at a lower applied field than in the Tb-free alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local electronic-structure modifications or Tb-related magnetism may contribute to the suppression of superconductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effects of the Tb-containing phases undermine superconductivity rather than beneficially enhancing flux pinning.",
