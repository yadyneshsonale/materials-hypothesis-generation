      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The equilibrated equimolar alloy has a lattice constant of 3.403 Å.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 300 K and a strain rate of 1 × 10^8 s^-1, the equimolar alloy has an ultimate tensile strength of approximately 2.9 GPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 300 K, the equimolar alloy has an elastic modulus of approximately 117.7 GPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 300 K, the equimolar alloy has a linear thermal-expansion coefficient of approximately 1.96 × 10^-5 K^-1.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified embedded-atom-method potential used in the simulations is validated for the modeled system and responses.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Nb from 20 to 10 at.% while increasing Hf from 20 to 30 at.% increases ultimate tensile strength relative to the equimolar baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Ta from 20 to 10 at.% while increasing Hf from 20 to 30 at.% increases ultimate tensile strength relative to the equimolar baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Nb or Ta from 20 to 10 at.% increases elastic modulus relative to the equimolar baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate lattice disturbance produced by low Nb or Ta content impedes dislocation migration and strengthens the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Nb or Ta from 20 to 30 at.% produces excessive atomic-size mismatch.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mismatch caused by 30 at.% Nb or Ta disrupts formation of a homogeneous solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Nb or Ta from 20 to 30 at.% decreases ultimate tensile strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Nb or Ta from 20 to 30 at.% decreases elastic modulus.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Ti or Zr from 20 to 30 at.% introduces lattice strain and potential defects.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial increase in Ti or Zr weakens the alloy's mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Further Ti or Zr addition permits atomic rearrangement toward a more ordered state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reordering at higher Ti or Zr content partially restores mechanical performance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature enhances lattice vibrations and accelerates dislocation activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strength and elastic stiffness decrease monotonically as temperature increases from 300 to 1200 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
