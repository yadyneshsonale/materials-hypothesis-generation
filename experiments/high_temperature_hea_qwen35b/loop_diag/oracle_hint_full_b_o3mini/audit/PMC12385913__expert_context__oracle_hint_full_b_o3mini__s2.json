  "claims": [
    {
      "text": "The as-cast alloy is equimolar WTaTiVZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting with at least five remelting steps produces a solidification-segregated dendritic microstructure in WTaTiVZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WTaTiVZr microstructure contains two intermingled BCC phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dendrites are enriched in W and Ta.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interdendritic regions are enriched in Zr and Ti.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V is present in both the dendritic and interdendritic regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The W-Ta-rich dendrites are harder than the Zr-Ti-rich interdendritic regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The softer Zr-Ti-rich interdendritic regions accommodate localized plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase boundaries interrupt or deflect propagating cracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Multicomponent solid-solution strengthening and lattice distortion associated with W and Ta provide high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dual-phase dendritic microstructure lowers the brittle-to-ductile transition temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr will have higher room- and high-temperature strength than commercially used pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr will have greater plastic strain than pure tungsten, particularly above 200 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr will exhibit fewer and less severe cracks and higher scratch-based fracture toughness than pure tungsten under comparable loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pure-tungsten baseline has a single-phase BCC, coarse equiaxed-grain microstructure with a grain size of approximately 100 ± 20 µm.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The indentation yield strength of the pure-tungsten baseline is approximately 700 MPa at room temperature and 250 MPa at 500 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pure-tungsten baseline has negligible plasticity below 300 °C and becomes ductile near 400 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The scratch-based fracture toughness of the pure-tungsten baseline is approximately 25 ± 1 MPa√m.",
      "field": "baseline",
