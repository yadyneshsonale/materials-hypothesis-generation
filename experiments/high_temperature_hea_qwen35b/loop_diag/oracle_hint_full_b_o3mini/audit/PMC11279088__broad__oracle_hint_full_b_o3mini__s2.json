  "claims": [
    {
      "text": "High aluminum content in AlCrCoFeNi drives selective outward diffusion of Al during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atmospheric exposure produces an externally continuous Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Cr2O3 layer forms beneath the external Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The duplex Al2O3/Cr2O3 scale stabilizes oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective duplex scale does not fully develop under low-oxygen conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy contains approximately 17.26 at.% Al.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial structure consists of approximately 79% BCC and 21% ordered B2 phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy has a spinodally decomposed microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison heats the alloy to 1100 °C in ambient air and in vacuum while tracking phase and oxide evolution by HTXRD.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prescribed heating program is 10 °C/min with 50 °C increments and 5-minute holds.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low-oxygen comparison uses a pressure of about 4.2×10^-6 atm and an oxygen partial pressure of about 8.82×10^-7 atm.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heating the initial BCC/B2 substrate produces intermediate FCC and Cr-Fe-rich sigma phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The sigma phase dissolves at the highest temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al depletion and phase transformation beneath the scale mediate protective behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher oxygen partial pressure accelerates oxidation and the outward diffusion of Al and, to a lesser extent, Cr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Air exposure will produce a thicker and more continuous oxide scale than vacuum exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Air exposure will produce a pronounced Al-depleted, phase-transformed subsurface zone.",
