  "claims": [
    {
      "text": "The stability of equiatomic multi-metallic nanoparticles is governed by a balance between thermally activated atomic diffusion and entropic stabilization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 473–873 K, kinetic barriers to atomic motion preserve a uniform solid solution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 1273 K, enhanced surface diffusion overcomes the kinetic barriers that preserve homogeneity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 1273 K, enhanced bulk diffusion overcomes the kinetic barriers that preserve homogeneity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in metal bonding energies drive high-temperature phase segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial nanoparticles contain five or more metals in equal or near-equal atomic ratios.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial nanoparticles are uniform solid solutions at room temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high-vacuum environment minimizes extrinsic contamination during annealing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermally activated diffusion facilitates vacancy and interstitial dynamics.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacancy and interstitial dynamics lead to phase segregation at high temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
