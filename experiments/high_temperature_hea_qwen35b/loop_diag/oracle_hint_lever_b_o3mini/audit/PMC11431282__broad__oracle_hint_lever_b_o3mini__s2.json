  "claims": [
    {
      "text": "Replacing a portion of Ni with Co in MnNiSi-based alloys improves mechanical performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co-for-Ni substitution produces solid-solution strengthening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co-for-Ni substitution refines the alloy microstructure or grain size.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co incorporation enhances grain-boundary strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution strengthening and grain refinement enhance the mechanical robustness of MnNiSi-based alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co and Ni have sufficient electronic similarity to preserve the magnetostructural transition when Co partially replaces Ni.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co and Ni have sufficient crystallographic similarity to preserve the magnetostructural transition when Co partially replaces Ni.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnetostructural transition is critical to retaining a large magnetocaloric effect in the proposed alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co-substituted samples will have greater fracture toughness or ductility than identically processed undoped MnNiSi-based samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At Co substitution levels up to approximately 10–15% of the Ni sublattice, the magnetocaloric effect will remain at approximately 90–100% of the undoped baseline value.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co substitution beyond approximately 10–15% of the Ni sublattice may disrupt the magnetostructural transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Disruption of the magnetostructural transition by excessive Co substitution may degrade the magnetocaloric effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting, controlled annealing, and water quenching can produce a homogeneous Co distribution in the proposed alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniform Co distribution is required for the proposed mechanical improvement and magnetocaloric retention.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
