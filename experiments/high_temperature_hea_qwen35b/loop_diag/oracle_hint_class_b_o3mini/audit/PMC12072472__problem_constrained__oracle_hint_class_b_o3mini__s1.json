  "claims": [
    {
      "text": "The initial system is a zirconium-alloy fuel-cladding substrate coated with elemental Cr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co-depositing approximately 5–10 wt% Al with Cr forms a Cr-Al alloy coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al incorporation will promote an Al-enriched oxide or stable Cr-Al intermetallic phase at the coating interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-enriched interfacial phase will reduce the mobility of Cr and Zr atoms.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A dispersed Cr-Al intermetallic or passivating Al2O3 scale can act as a high-melting-point diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed barrier will impede migration of Zr from the substrate into the Cr-containing coating during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing Cr-Zr interdiffusion will postpone or prevent premature coating failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elemental Cr coatings undergo accelerated interdiffusion with Zr at elevated temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature Cr-Zr interdiffusion causes premature failure of the elemental Cr coating under accident conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, the Cr-Al coating will exhibit significantly less Cr-Zr interdiffusion during high-temperature steam exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, the Cr-Al coating will better maintain coating integrity during high-temperature steam exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-Al coating will retain corrosion protection under subcritical-water conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed normal-operation boundary is subcritical water at approximately 300–400°C for extended periods.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed accident boundary is steam at approximately 950–1050°C for seconds to minutes.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
