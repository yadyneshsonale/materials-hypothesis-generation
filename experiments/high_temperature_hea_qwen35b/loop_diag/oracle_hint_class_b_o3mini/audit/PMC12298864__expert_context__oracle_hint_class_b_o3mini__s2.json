  "claims": [
    {
      "text": "Equimolar CoCrFeNiTi has relatively low hardness and strength but favorable plasticity and machinability.",
      "field": "hypothesis; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deformation behavior, hardness, and strength of equimolar CoCrFeNiTi are primarily governed by its processing route.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional high-temperature casting of equimolar CoCrFeNiTi produces comparatively coarse grains.",
      "field": "hypothesis; material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally cast equimolar CoCrFeNiTi contains few nanoscale precipitates.",
      "field": "hypothesis; material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting conventionally cast alloy is in a simple solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder metallurgy with rapid sintering and controlled cooling can refine the microstructure of equimolar CoCrFeNiTi.",
      "field": "intervention; hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alternative processing route may promote nanoscale precipitate or secondary-phase formation in equimolar CoCrFeNiTi.",
      "field": "intervention; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement increases grain-boundary strengthening.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Secondary phases or nanoscale precipitates impede dislocation motion and thereby increase strength and hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alternatively processed CoCrFeNiTi will have higher hardness than conventionally cast CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alternatively processed CoCrFeNiTi will have higher compressive strength than conventionally cast CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increases in hardness and compressive strength will be accompanied by a moderate reduction in plasticity.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect applies at 25 °C under compressive and low-level tensile deformation.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The comparison keeps Co, Cr, Fe, Ni, and Ti strictly equimolar and changes only processing.",
      "field": "conditions; boundary; falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain size, precipitate fraction, phase constitution, and dislocation density can be compared using SEM, TEM, and XRD.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
