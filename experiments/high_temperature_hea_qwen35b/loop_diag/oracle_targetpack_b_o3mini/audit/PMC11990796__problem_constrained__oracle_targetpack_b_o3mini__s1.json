  "claims": [
    {
      "text": "Equiatomic NbZrTiHfMo is a disordered BCC refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbZrTiHfMo has a room-temperature compressive yield strength of 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content of equiatomic NbZrTiHfMo causes excessive electronegativity differences associated with limited plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 20% of the Mo content should be replaced by V while the Nb, Zr, Ti, and Hf contents are kept unchanged.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Mo-to-V substitution will improve room-temperature plasticity without significant loss of compressive yield strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V has an electronegativity closer than Mo to Nb, Zr, Ti, and Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Mo with V will reduce local electronegativity differences and local bonding heterogeneity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced local bonding heterogeneity will facilitate dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V substitution will moderately adjust lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "V substitution may alter short-range ordering in NbZrTiHfMo.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V will preserve solid-solution strengthening through lattice distortions similar to those produced by Mo.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::000::abstract",
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will retain compressive yield strength near 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will exhibit greater room-temperature compressive plastic strain than equiatomic NbZrTiHfMo.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial strength-plasticity effect requires a homogeneous microstructure without deleterious secondary phases.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The V substitution level likely must remain below approximately 30% of the original Mo content to preserve solid-solution strengthening.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-to-V substitution beyond approximately 30% could reduce strength or cause phase instability.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "A failure to increase plastic strain by at least 10% while retaining yield strength within 10% of 1719 MPa would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
