      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed interface-controlled mechanism may not apply at very low temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
