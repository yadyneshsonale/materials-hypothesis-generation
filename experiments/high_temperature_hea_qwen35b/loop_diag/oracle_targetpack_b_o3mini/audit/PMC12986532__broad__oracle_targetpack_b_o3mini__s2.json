  "claims": [
    {
      "text": "The proposed coating consists of alternating high-entropy-alloy layers.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multilayer coating has a random polycrystalline structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deposition establishes well-defined, coherent γ/γ′ interfaces between the layers.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent γ/γ′ interfaces are strong barriers to dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent γ/γ′ interfaces are strong barriers to grain-boundary sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Blocking dislocation motion and grain-boundary sliding at coherent interfaces retards creep in HEA multilayer coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::030::4_conclusions",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At 500–600 °C and 140–400 MPa, both dislocation-mediated plasticity and diffusion contribute to creep.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::030::4_conclusions",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent interfaces impede dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent interfaces impede dislocation glide and transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocations pile up at the interfaces rather than transmitting freely between layers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent interfaces limit atomic diffusion specifically along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Joint suppression of dislocation motion and atomic transport reduces time-dependent plastic deformation relative to structures lacking γ/γ′ interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12842692::web::030::4_conclusions",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Under identical conditions, the multilayer coating will exhibit lower creep strain than a monolithic HEA coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12842692::web::030::4_conclusions",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Creep-tested multilayer coatings will show dislocation accumulation at their interfaces.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Creep-tested multilayer coatings will show less grain-boundary sliding than monolithic coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Creep mechanisms progress from diffusion-dominated deformation at low stress to dislocation activity at intermediate conditions and stress-induced phase transformation at high stress and temperature.",
