      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will exhibit less pesting than untreated equiatomic HfNbTaTiZr.",
