      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C at strain rates of 10^-4–10^-2 s^-1.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has inadequate oxygen resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 3–5 at.% Al to equiatomic HfNbTaTiZr will improve its oxygen resistance.",
