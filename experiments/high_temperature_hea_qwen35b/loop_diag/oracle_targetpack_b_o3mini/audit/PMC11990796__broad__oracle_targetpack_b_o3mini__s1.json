  "claims": [
    {
      "text": "Controlled aging can induce nanoscale, coherent L12-type precipitates in a refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Such precipitation can improve yield strength relative to the unaged state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::012::4_1_the_influence_of_nano_sized_precipit",
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Such precipitation can maintain or improve ductility relative to the unaged state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Refractory high-entropy alloys are typically obtained as predominantly single-phase solid solutions by casting or standard thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Al and Ti additions favor the formation of coherent L12 precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Aging near 700 °C for a controlled duration can introduce the desired precipitation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The beneficial microstructure requires fine and coherent precipitates.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::012::4_1_the_influence_of_nano_sized_precipit",
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The L12 precipitates will be uniformly distributed within a refined grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent L12 precipitates strengthen the alloy specifically through the Orowan mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::012::4_1_the_influence_of_nano_sized_precipit"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent interfaces and a controlled precipitate volume fraction avoid deleterious stress concentrations and thereby preserve or enhance plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction",
        "PMC11989734::web::012::4_1_the_influence_of_nano_sized_precipit"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will increase yield strength by approximately 20–30% relative to the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will maintain or slightly improve ductility, as reflected in strain-hardening behavior.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7220923::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The unaged baseline alloy has lower yield strength but comparable ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
