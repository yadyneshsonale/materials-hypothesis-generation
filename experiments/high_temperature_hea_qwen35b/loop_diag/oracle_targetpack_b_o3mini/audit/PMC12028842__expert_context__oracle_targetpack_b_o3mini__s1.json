      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::010::3_1_phase_analysis",
        "PMC11509624::web::020::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Ni shifts the phase constitution from mainly Ti3Al and TiAl toward formation of Ti(Al,Cu)2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::010::3_1_phase_analysis",
        "PMC11509624::web::020::4_conclusions"
      ],
      "same_system": "yes"
    },
