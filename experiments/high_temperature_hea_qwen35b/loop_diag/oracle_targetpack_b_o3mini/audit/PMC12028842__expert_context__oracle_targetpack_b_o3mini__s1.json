      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::010::3_1_phase_analysis"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ni dissolves into the Ti(Al,Cu)2 phase and produces solid-solution hardening and lattice distortion.",
