      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ni-induced phase constitution and solid-solution hardening improve resistance to deformation and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::010::3_1_phase_analysis",
        "PMC11509624::web::020::4_conclusions"
      ],
      "same_system": "yes"
    },
