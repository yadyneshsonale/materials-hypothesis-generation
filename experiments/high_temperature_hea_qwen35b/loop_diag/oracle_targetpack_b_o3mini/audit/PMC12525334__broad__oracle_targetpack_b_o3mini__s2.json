      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::012::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Such conventionally produced HEAs are usually single-BCC or mixed-phase alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::012::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cold rolling introduces a high dislocation density.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe rolling deformation refines the grain structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9506522::web::012::3_2_performance_of_the_zr7_mea_after_tmt"
      ],
      "same_system": "unclear"
    },
    {
