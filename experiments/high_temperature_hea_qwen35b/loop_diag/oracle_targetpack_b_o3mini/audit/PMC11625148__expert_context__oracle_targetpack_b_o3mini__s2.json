      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vanadium is a ductile BCC element suitable for micro-alloying NbMoTaW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to replace 5–10 at% of Mo or Ta in NbMoTaW with vanadium.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vanadium substitution will enhance lattice-distortion heterogeneity in NbMoTaW.",
