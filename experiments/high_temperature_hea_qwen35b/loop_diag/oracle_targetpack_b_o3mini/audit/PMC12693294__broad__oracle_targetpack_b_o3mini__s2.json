  "claims": [
    {
      "text": "The initial Al–Co–Cr–Fe–Ni alloy has a mixed disordered FCC and partially ordered B2/BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9407404::web::009::3_2_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Al and Ni have a strong negative mixing enthalpy in Al–Co–Cr–Fe–Ni alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The negative Al–Ni mixing enthalpy drives local Al–Ni chemical ordering into a B2 phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9407404::web::009::3_2_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "A high degree of Al–Ni ordering promotes formation of ordered B2 or BCC regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9407404::web::009::3_2_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation of Al–Ni-enriched ordered regions depletes the FCC matrix of stabilizing elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Depletion caused by Al–Ni ordering lowers the stability of the FCC matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching from approximately 900°C suppresses Al–Ni ordering relative to slow cooling.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A slight reduction in Al content suppresses Al–Ni ordering.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling from approximately 900°C promotes Al–Ni ordering.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing Al–Ni ordering retains a higher fraction of disordered FCC phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A conventionally slow-cooled baseline has a significant Al–Ni-ordered B2/BCC fraction and a correspondingly lower FCC fraction.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9407404::web::009::3_2_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "Treatment near 900°C can produce BCC precipitation in a multicomponent Fe–Ni–Cr–Al-containing alloy.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9407404::web::009::3_2_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "The degree of Al–Ni ordering mediates the relationship between processing and FCC versus B2/BCC phase fractions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stabilizing the FCC phase enhances ductility and cryogenic toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stabilizing the FCC phase enhances radiation tolerance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing ordering incurs a high-temperature-strength tradeoff that is mitigated by retaining some ordered phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Samples processed to suppress Al–Ni ordering will have a higher FCC phase fraction, improved cryogenic toughness, and improved radiation tolerance while retaining acceptable high-temperature strength relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ordering-controlled mechanism is expected to apply only within a composition and processing regime where FCC and B2/BCC phases coexist.",
