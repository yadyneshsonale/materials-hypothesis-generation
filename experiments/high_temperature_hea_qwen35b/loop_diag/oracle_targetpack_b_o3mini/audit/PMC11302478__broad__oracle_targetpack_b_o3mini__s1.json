      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8368001::web::003::introduction",
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order modifies work-hardening behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
