        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Mn with Pd in CoCrFeNiMn to form CoCrFeNiPd enhances short-range ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8368001::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pd is a relatively larger or larger-misfit atom than the Mn it replaces.",
