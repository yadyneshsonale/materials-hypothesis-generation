      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8368001::web::003::introduction",
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice distortion arising from differences in constituent atomic sizes increases barriers to dislocation motion and the required flow stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion",
