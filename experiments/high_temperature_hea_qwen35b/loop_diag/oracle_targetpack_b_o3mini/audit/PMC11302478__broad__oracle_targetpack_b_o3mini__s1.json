      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8368001::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order creates greater resistance or pinning barriers to dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8368001::web::003::introduction",
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
