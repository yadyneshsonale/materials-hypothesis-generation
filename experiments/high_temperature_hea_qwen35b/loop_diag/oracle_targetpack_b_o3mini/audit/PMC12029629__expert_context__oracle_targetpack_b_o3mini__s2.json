  "claims": [
    {
      "text": "The target material is solidified, equiatomic, Co-free FeNiCrMn.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solidified equiatomic FeNiCrMn has a predominantly FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dynamic response of FeNiCrMn across temperature and strain-rate regimes is primarily controlled by dislocation nucleation at grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC7801446::web::013::mechanical_deformation_behavior",
        "PMC7801446::web::016::deformation_mechanisms",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain boundaries nucleate Shockley partial dislocations that propagate into grains and leave stacking faults.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC7801446::web::013::mechanical_deformation_behavior",
        "PMC7801446::web::016::deformation_mechanisms",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Stacking faults can be a principal carrier of plastic deformation under dynamic loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10490121::web::021::3_2_spallation_damage"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At moderate temperatures and strain rates, plasticity is governed by thermally activated dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At moderate temperatures and strain rates, stacking-fault formation maintains a balance between strength and ductility in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC10490121::web::021::3_2_spallation_damage"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At high strain rates, insufficient time for thermally activated barrier crossing and viscous phonon drag impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lower temperature produces the same phonon-drag-dominated regime proposed for high strain rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation entanglement inhibits dislocation motion and increases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC10058552::web::020::3_6_tension_compression_asymmetry_of_pol"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing strain rate into the 10^2–10^3 s^-1 regime causes a substantially greater strain-rate sensitivity than occurs at 10^-3–10^-1 s^-1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher strain rates or lower temperatures will markedly increase the yield strength of FeNiCrMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::016::3_3_microstructure_evolution",
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_",
        "PMC10058552::web::020::3_6_tension_compression_asymmetry_of_pol"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher strain rates or lower temperatures will reduce FeNiCrMn ductility because of phonon drag and dislocation entanglement.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine-grained material can exhibit greater strength because grain boundaries hinder motion and promote dislocation entanglement.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC10058552::web::018::3_6_tension_compression_asymmetry_of_pol",
        "PMC10058552::web::020::3_6_tension_compression_asymmetry_of_pol"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlling grain size and extrinsic defect density can isolate grain-boundary-mediated dislocation activity.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::006::results_and_discussion",
        "PMC10058552::web::018::3_6_tension_compression_asymmetry_of_pol",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional single-phase FCC HEAs generally lack pronounced strain-rate sensitivity when grain-boundary-mediated nucleation is not dominant.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8608792::web::014::mechanical_behavior_at_quasi_static_and_"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism is applicable only to equiatomic, fine-grained, Co-free FeNiCrMn and may change with grain size, defect density, or non-equiatomic composition.",
