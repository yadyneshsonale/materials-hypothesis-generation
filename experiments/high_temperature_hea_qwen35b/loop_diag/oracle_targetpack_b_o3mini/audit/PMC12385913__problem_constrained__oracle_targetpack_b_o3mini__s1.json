  "claims": [
    {
      "text": "Vacuum-arc-melted equimolar WTaTiVZr has a multiphase dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9600907::web::000::abstract",
        "PMC9600907::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy contains W/Ta-rich dendrites and Ti/V/Zr-enriched interdendritic regions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9600907::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "W and Ta are higher-melting-point constituents, whereas Ti, V, and Zr are lower-melting-point constituents.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9600907::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The interdendritic regions are softer than the W/Ta-rich dendrites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, the interdendritic regions act as strain-accommodating channels.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interdendritic regions facilitate dislocation nucleation and motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preferential deformation of the interdendritic regions increases the alloy's plastic strain.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W/Ta-rich dendrites provide solid-solution strengthening and maintain overall strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9600907::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The W/Ta-rich dendrites inhibit rapid crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Commercially pure tungsten lacks the dendritic/interdendritic heterogeneity proposed for the HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 1200–1500°C, thermal activation enables dislocation glide and phase-specific deformation in WTaTiVZr.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical high-temperature loading, WTaTiVZr will have greater plastic strain than commercially pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical high-temperature loading, WTaTiVZr will have a greater area under its stress-strain curve than commercially pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation and damage in WTaTiVZr will be preferentially distributed through the interdendritic regions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten will show more brittle and localized failure than WTaTiVZr during the proposed high-temperature tests.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::023::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism may diminish at lower temperatures where thermal activation is limited.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing changes that substantially alter phase distribution may diminish or eliminate the proposed effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An identical mechanical-test comparison between WTaTiVZr and pure tungsten can test the predicted performance difference.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact improvement and the relative contribution of segregation versus other strengthening mechanisms are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
