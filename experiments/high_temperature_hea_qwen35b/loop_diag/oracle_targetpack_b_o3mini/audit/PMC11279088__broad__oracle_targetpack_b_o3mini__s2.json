{
  "run_id": "PMC11279088__broad__oracle_targetpack_b_o3mini__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Protective oxide formation and retention are primarily governed by aluminum diffusion from a supersaturated BCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aluminum diffuses preferentially and rapidly from the supersaturated BCC matrix to the alloy surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Surface-directed aluminum transport results in the formation of Al2O3 at the surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aluminum oxide produced is a continuous, adherent alpha-Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess competing reactive elements such as Mn cause porous, non-protective oxides to dominate and accelerate oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "FeNiCoCrMo0.5Al1.3 can contain a supersaturated BCC solid solution that supplies aluminum during oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The supersaturated BCC matrix acts as an aluminum reservoir and diffusion channel.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The BCC-mediated aluminum supply is critical for producing a coherent and compact alpha-Al2O3 scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperature, a concentration gradient drives aluminum diffusion toward the surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting alumina layer is a diffusion barrier that limits subsequent oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower aluminum content promotes alternative non-protective oxide formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-rich alloys can form unstable oxide scales with pores, weak substrate attachment, and reduced oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A high-Al variant will form a more uniform, adherent alpha-Al2O3 scale with less porosity than a lower-Al or higher-Mn baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The high-Al variant will oxidize significantly more slowly than the lower-Al or higher-Mn baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline alloy will develop a thicker, non-uniform, porous oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism applies under oxygen-rich conditions at approximately 800–1100 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reduced oxygen partial pressure can alter oxide growth and scale thickness.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::024::4_2_oxidation_in_vacuum"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Processing-dependent changes in diffusion kinetics and phase distributions may limit the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A controlled comparison should oxidize a high-Al, reduced-Mn variant and a lower-Al or higher-Mn control at 900 degrees Celsius in air for 100 hours.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The governing-mechanism hypothesis is falsified if the high-Al variant does not produce a more uniform, thinner, adherent alpha-Al2O3 scale or if both variants have comparable oxidation rates and non-protective scales.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
