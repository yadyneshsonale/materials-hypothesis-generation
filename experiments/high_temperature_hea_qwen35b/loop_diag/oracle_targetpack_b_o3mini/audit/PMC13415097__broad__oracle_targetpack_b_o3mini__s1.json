  "claims": [
    {
      "text": "Equiatomic FeCoNiMnCu is a rare-earth-free high-entropy alloy candidate with magnetic order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed baseline is a homogenized, single-phase FeCoNiMnCu alloy with low grain-boundary density and minimal chemical short-range order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled annealing or rapid thermal annealing can tune grain size and grain-boundary density.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10162673::web::027::preprocessing_of_the_materials",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled annealing can induce beneficial chemical short-range order in FeCoNiMnCu.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13030938::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing-induced grain and ordering changes create a dual-length-scale hierarchical microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11267332::web::025::long_range_ordering_process"
      ],
      "same_system": "no"
    },
    {
      "text": "Engineered grain boundaries and chemically short-range-ordered regions induce local lattice distortions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local lattice distortions modify and strengthen exchange interactions among magnetic atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::006::magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The altered exchange interactions lower the field threshold for magnetic-domain reorientation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering the domain-reorientation threshold increases magnetic entropy change at low applied fields.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered microstructure reduces magnetic hysteresis.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A hierarchical microstructure supports rapid phonon-mediated heat transfer and enhanced thermal-exchange rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered microstructure can retain mechanical strength and integrity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9646780::web::009::mechanical_response"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to the homogenized baseline, optimized annealed samples will have a higher low-field magnetic entropy change.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior should apply near magnetic phase transitions in the approximate temperature range 100–300 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::006::magnetic_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior should apply at fields up to approximately 1 T.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extreme phase segregation lies outside the hypothesis because secondary regions can adversely affect magnetic reversibility or anisotropy.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13266977::web::018::discussion_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The magnitude of magnetocaloric enhancement and the optimum microstructure will vary with composition and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::006::magnetic_properties",
        "PMC11267332::web::025::long_range_ordering_process"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing grain-boundary density may compromise mechanical properties if it is not carefully calibrated.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
