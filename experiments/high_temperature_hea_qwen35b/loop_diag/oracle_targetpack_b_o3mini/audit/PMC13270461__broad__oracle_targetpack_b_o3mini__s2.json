  "claims": [
    {
      "text": "Relative constituent-element diffusion rates govern high-temperature oxide-scale development and oxidation resistance in CoCrFeNiMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative constituent-element diffusion rates govern the sustained material integrity of CoCrFeNiMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC10384371::web::031::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn diffuses faster than Cr in the Cantor alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fast outward Mn transport produces an Mn-rich outer oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Mn-rich outer oxide is porous and non-protective.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn mobility and depletion can cause pore formation and accelerate oxide growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr forms a Cr-rich inner oxide layer beneath an Mn-rich outer layer in oxidized CoCrFeNiMn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "At 900 °C, CoCrFeNiMn can form layered Cr2O3 and Mn2O3 oxides.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slower Cr diffusion promotes formation of a continuous and adherent Cr-rich inner oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC10384371::web::031::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A dense Cr-rich inner oxide impedes oxygen ingress and cation transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline equiatomic CoCrFeNiMn alloy has a homogeneous, single-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC11169556::web::018::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxidized baseline alloy forms a thick, multilayered scale with an outer Mn-rich layer and a less-continuous inner Cr-rich layer.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC10384371::web::031::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Mn content or effective Mn mobility while enhancing Cr retention will produce a thinner and more compact oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Mn content or effective Mn mobility will make the Cr-rich oxide layer more continuous.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Mn content or effective Mn mobility will lower the overall oxidation rate relative to equiatomic CoCrFeNiMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloying additions or microstructural processing can selectively slow Mn diffusion relative to Cr in this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed governing behavior applies around 900 °C in oxygen-rich environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The same behavior should persist for exposures as long as 120 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applicability at other temperatures or in other alloy systems may change because diffusion kinetics and oxide stability vary.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::026::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction",
        "PMC11169556::web::018::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A lack of statistically significant scale thinning, improved Cr-rich-layer continuity, and reduced oxidation rate in the modified alloy would falsify the proposed Mn-diffusion mechanism.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
