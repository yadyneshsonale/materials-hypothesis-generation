  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "In CrFeCoNiX alloys, the identity of X controls protective-oxide formation through element-specific diffusion kinetics and oxidation pathways.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC10384371::web::037::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al diffuses slowly in CrFeCoNiAl under the proposed service conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiAl forms a continuous, coherent alpha-Al2O3 surface layer above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6719109::web::047::5_2_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The alpha-Al2O3 layer on the Al-containing alloy grows slowly and adheres well.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6719109::web::047::5_2_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn has high mobility during high-temperature oxidation of CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn preferentially forms non-protective oxides and becomes depleted beneath the oxide layer in CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC10384371::web::037::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidation produces higher-volume, volumetrically inconsistent, non-coherent oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrMnFeCoNi develops a rapidly growing porous scale prone to cracking and spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC10384371::web::037::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Si gives oxidation behavior intermediate between the Al- and Mn-containing alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi can form a protective silicate or glassy oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide phase composition, coherency, and continuity mediate whether the scale remains protective.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC6719109::web::047::5_2_1_oxidation_at_800_c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Limited Al diffusion supports nucleation and lateral growth of a coherent alpha-Al2O3 scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A coherent alpha-Al2O3 scale acts as a barrier to further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6719109::web::047::5_2_1_oxidation_at_800_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Under identical conditions, CrFeCoNiAl will form a thinner, more coherent, and more adherent scale than CrFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical conditions, CrMnFeCoNi will form a thicker, more porous, and more spall-prone scale than CrFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNi without X has less effective oxide-scale formation because it lacks an additional passivating element.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies above 900 °C in oxygen-rich or corrosive atmospheres.",
      "field": "boundary",
      "needs_support": true,
