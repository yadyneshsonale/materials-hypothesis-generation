  "claims": [
    {
      "text": "The starting CoCrFeNi alloy has a primarily FCC solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is addition of approximately 1–1.5 at.% Mo to CoCrFeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1–1.5 at.% Mo will induce fine σ-phase precipitates in the FCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mo addition increases lattice distortion in the CoCrFeNi FCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mo-induced σ phases and lattice distortion stabilize the microstructure against high-temperature softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo provides solid-solution strengthening and σ-phase precipitation hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::005::1_introduction",
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sliding a CoCrFeNiMo material against Si3N4 in air can produce a protective oxide layer through frictional heating and reaction with atmospheric oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "The sliding-induced oxide layer can contain Fe3O4, Fe2O3, MoO3, NiO, Cr2O3, and Co3O4.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fe3O4 and Fe2O3 in the tribofilm reduce friction and improve frictional stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mo-induced structural refinement facilitates formation of a continuous protective oxide film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined strengthening and tribofilm mechanisms will lower coefficient of friction relative to undoped CoCrFeNi throughout approximately 25–800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined strengthening and tribofilm mechanisms will lower wear rate relative to undoped CoCrFeNi throughout approximately 25–800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-modified alloy will retain better mechanical integrity than undoped CoCrFeNi at elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is bounded to dry sliding in air against a Si3N4 counterface from approximately 25 °C to 800 °C under a constant load comparable to the baseline.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide film may lose integrity during prolonged or cyclic loading.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Once the oxide film fragments, σ-phase particles can spall brittlely and accelerate material loss.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::036::3_2_mechanical_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimal Mo concentration for balancing strength, ductility, and tribological behavior remains undetermined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis will be tested by comparing identically processed undoped and Mo-modified CoCrFeNi samples under identical sliding conditions.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to achieve a statistically significant reduction greater than 10% in both friction coefficient and wear rate will falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
