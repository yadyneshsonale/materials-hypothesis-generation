  "claims": [
    {
      "text": "As-received Q235 steel typically has a relatively coarse ferrite-pearlite microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A surface grain-refinement treatment increases near-surface grain-boundary density.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744552::web::015::3_3_1_potentiodynamic_polarization_test"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain refinement increases dislocation density at the surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744552::web::015::3_3_1_potentiodynamic_polarization_test"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher grain-boundary and dislocation densities reduce the surface work function.",
