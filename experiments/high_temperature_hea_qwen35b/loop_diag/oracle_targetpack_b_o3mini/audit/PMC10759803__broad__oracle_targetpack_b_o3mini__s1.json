  "claims": [
    {
      "text": "A minor Al addition to an FCC CoNiV matrix can promote nanoscale secondary-phase precipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8378815::web::002::introduction",
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al-induced secondary phase in CoNiV can have a B2 structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al-induced B2 or related precipitates will be coherent or semi-coherent with the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8378815::web::002::introduction",
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled B2 precipitation can sustain work hardening and ductility despite the intrinsically poor plasticity of bulk B2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitation caused by minor Al alloying improves elevated-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The low density of Al ensures that adding Al does not increase the alloy's overall density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8378815::web::002::introduction",
        "PMC8074761::web::008::3_results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Retention of a ductile matrix preserves room-temperature ductility after Al addition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Unmodified CoNiV is an FCC-structured alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8378815::web::002::introduction",
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al0.8NbTiV is an appropriate single-phase BCC initial state for a further minor Al addition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should use an Al addition on the order of a few atomic percent.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8378815::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have 20–30% greater high-temperature yield strength than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength benefit will hold at approximately 800–1150 °C.",
