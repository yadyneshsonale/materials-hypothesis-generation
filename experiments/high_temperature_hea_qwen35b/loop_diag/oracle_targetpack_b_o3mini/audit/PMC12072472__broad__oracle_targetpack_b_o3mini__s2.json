      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::017::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding provides strong metallurgical bonding between the coating and substrate.",
