      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9416578::web::014::3_3_microstructure_characterization"
      ],
      "same_system": "no"
    },
    {
      "text": "An approximately 10% Al coating has better oxidation or corrosion resistance than higher-Al AlNbTiZr coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::017::3_4_autoclave_test",
        "PMC8709257::web::018::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "An approximately 10% Al coating has better oxidation resistance than uncoated N36 zirconium alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::017::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide-scale thickness is approximately 0.84 micrometers on the Al10% coating versus approximately 3.36 micrometers on uncoated N36.",
