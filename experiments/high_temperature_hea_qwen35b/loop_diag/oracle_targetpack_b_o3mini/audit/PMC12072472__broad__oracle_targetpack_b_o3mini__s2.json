  "claims": [
    {
      "text": "The starting material is zirconium-alloy nuclear-fuel cladding with a native oxide layer and a surface prepared for laser cladding.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is laser cladding an AlNbTiZr-type multicomponent alloy coating with approximately 10 wt% Al onto zirconium-alloy cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::017::3_4_autoclave_test",
        "PMC8709257::web::018::3_4_autoclave_test",
        "PMC9416578::web::014::3_3_microstructure_characterization"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing the Al content to around 10% promotes a dense, continuous protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::017::3_4_autoclave_test",
        "PMC8709257::web::018::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale is dominated by Al2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The surface oxide contains ZrO2 and Nb2Zr6O17.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::018::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lowering the Al content limits excessive Al diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering the Al content reduces formation of boehmite.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::018::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combination of lower Al and higher Nb, Ti, and Zr content produces a denser oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::018::3_4_autoclave_test"
      ],
      "same_system": "yes"
    },
    {
      "text": "A coherent oxide scale inhibits oxygen diffusion into the zirconium-alloy substrate.",
