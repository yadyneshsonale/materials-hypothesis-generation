      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The shortened anneal prevents phase transformations that would otherwise occur.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The multiphase structure underpins the alloy's high-temperature strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
