      "text": "The bcc-type phase has high thermal conductivity relative to the other phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The phase structures remain stable after prolonged annealing for eight days at temperatures as high as 1500°C.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
