      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloys have already proven thermal resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11901246::web::003::1_introduction",
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloys have already proven irradiation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 1300°C, 24-hour post-sintering anneal will enhance connectivity and percolation of the bcc-type phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed anneal permits limited phase coarsening that improves alignment of the bcc-type phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::022::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Improved bcc-phase connectivity creates continuous thermal-conduction paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Continuous bcc-phase thermal paths increase the alloy's overall thermal diffusivity.",
      "field": "mechanism",
