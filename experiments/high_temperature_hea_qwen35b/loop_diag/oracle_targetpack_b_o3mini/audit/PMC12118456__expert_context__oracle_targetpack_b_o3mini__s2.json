  "claims": [
    {
      "text": "Premelting onset in Fe–Ni–Cr–Co–Cu nanoparticles is governed by thermally induced surface segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The progression from premelting to full melting is governed by differences in elemental surface energies and melting points.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12257736::web::029::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating produces a transient core–shell configuration in the nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12257736::web::020::stability_composition_space",
        "PMC12257736::web::029::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower-melting, lower-cohesive-energy elements accumulate at the nanoparticle surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface enrichment in lower-melting elements reduces the local melting temperature relative to the unsegregated core.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial Fe–Ni–Cr–Co–Cu nanoparticles are homogeneous and have a uniform elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial nanoparticles are single-phase FCC solids.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An oxygen-free atmosphere avoids oxidation during heating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu becomes enriched at the nanoparticle surface during heating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fe and Ni are preferentially retained in the nanoparticle core during heating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in elemental surface energy and melting point drive atomic diffusion during heating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12257736::web::029::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface-segregated low-melting elements induce local disorder before the core melts.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher-melting components maintain an ordered lattice until a higher temperature is reached.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Cu-enriched, disordered, locally premelted surface layer forms below the complete melting temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The core retains an ordered FCC structure while the surface layer premelts.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The segregation-mediated process produces a two-step calorimetric response.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The first calorimetric endotherm corresponds to surface premelting.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface disorder begins at approximately 0.8 times the bulk melting temperature of the alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extremely rapid heating can cause behavior to deviate from the proposed segregation-mediated mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Premelting thresholds and segregation magnitude depend on kinetic factors and precise interatomic interactions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
