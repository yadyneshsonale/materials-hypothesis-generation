      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::028::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The unreinforced HEA exhibits higher friction and wear than the proposed WC–HEA composite.",
