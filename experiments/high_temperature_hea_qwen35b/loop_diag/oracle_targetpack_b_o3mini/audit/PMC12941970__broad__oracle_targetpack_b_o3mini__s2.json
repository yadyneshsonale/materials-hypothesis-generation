      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::028::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "WC addition promotes formation of Cr-rich carbides and Co3W3C in the HEA matrix.",
