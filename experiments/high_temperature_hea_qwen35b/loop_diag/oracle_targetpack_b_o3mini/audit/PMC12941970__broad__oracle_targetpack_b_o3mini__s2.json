      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::027::3_3_the_effect_of_wc_content_on_properti",
        "PMC10706897::web::028::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "WC addition and the resulting second phases increase composite hardness.",
