  "claims": [
    {
      "text": "The initial TiVNbTa alloy is single-phase BCC at room and high temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain"
      ],
      "same_system": "yes"
    },
    {
      "text": "TiVNbTa has a room-temperature yield strength of approximately 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiVNbTa has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiVNbTa has a compressive strength of approximately 423 MPa at 1273 K.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add a few atomic percent Mo to TiVNbTa, producing a quinary TiVNbTaMo alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-modified TiVNbTa alloy will retain a single-phase BCC structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo incorporation will enhance lattice distortion in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo atoms will act as effective dislocation-pinning sites in TiVNbTa at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo atoms will retard atomic diffusion in TiVNbTa at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Related Mo-containing refractory alloys such as NbMoTaW, NbMoTaVW, MoNbTaTiW, and MoNbTaTiVW exhibit relatively strong elevated-temperature yield-strength retention.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Mo to TiVNbTa will increase its yield strength at 1273 K relative to unmodified TiVNbTa.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-modified alloy may achieve a yield strength above 400 MPa at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-modified alloy will preserve acceptable ductility.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-modified alloy will remain compatible with adjoining W and CuCrZr layers.",
      "field": "hypothesis; conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preserving acceptable ductility will help ensure mechanical stability and effective heat transfer in use.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance boundary extends to approximately 1273 K under loading conditions similar to the baseline tests.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Retaining a single-phase BCC structure will ensure compatibility with W and CuCrZr.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Secondary-phase formation caused by Mo could degrade ductility or thermal compatibility.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimum Mo concentration for balancing high-temperature strength retention and ductility is not yet defined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
