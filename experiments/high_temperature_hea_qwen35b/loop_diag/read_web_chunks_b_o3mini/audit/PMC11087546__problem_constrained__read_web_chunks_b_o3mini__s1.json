  "claims": [
    {
      "text": "The starting material is a eutectic high-entropy alloy with a hierarchical microstructure of dual-phase lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed intervention is cryogenic rolling followed by controlled annealing.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cryogenic rolling followed by annealing refines the lamellar interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment increases the number or density of lamellar interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cryogenic rolling and annealing produce spatially heterogeneous soft, intermediate, and hard domains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Strain gradients between domains of different hardness generate enhanced back-stress strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cryogenic rolling introduces high strains at low temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled annealing causes partial recrystallization and stabilizes the refined structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined and heterogeneous structure interrupts dislocation pile-ups at phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mitigating dislocation pile-ups reduces local stress concentrations and delays crack initiation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Back-stress strengthening delays tensile necking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated alloy has limited room-temperature tensile ductility and exhibits brittle failure.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In the untreated alloy, deformation near internal phase boundaries produces localized internal stresses, strain localization, and early microcracking.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation pile-ups are the cause of the untreated alloy's boundary stress concentrations and early microcracking.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated material will have significantly greater elongation to failure than the untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treated material will maintain or increase both yield strength and ultimate tensile strength relative to the untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The predicted benefits apply primarily to room-temperature, quasi-static tensile loading.",
