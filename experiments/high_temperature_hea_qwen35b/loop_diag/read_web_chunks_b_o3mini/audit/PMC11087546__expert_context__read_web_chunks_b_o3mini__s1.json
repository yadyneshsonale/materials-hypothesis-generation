      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Pinning by Hf-rich precipitates reduces boundary sliding.",
