      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trace Hf addition will increase yield strength at room temperature relative to the unmodified lamellar alloy.",
