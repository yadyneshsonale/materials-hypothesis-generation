      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Pinning by Hf-rich precipitates suppresses microcrack initiation and propagation at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-rich precipitates provide precipitation strengthening.",
