      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction",
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Trace Hf addition will increase ultimate tensile strength at room temperature relative to the unmodified lamellar alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
