  "claims": [
    {
      "text": "A defect-aware machine-learning model will predict temperature-dependent electrical conductivity of bulk HfNbTaTiZr more accurately than traditional analytical models.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7933338::web::011::results_and_discussions",
        "PMC9270422::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Binary-alloy datasets can be used to support predictions for high-entropy alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7933338::web::011::results_and_discussions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed model will be trained on binary-alloy and high-entropy-alloy data that include defect and oxygen-contamination information.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 1 wt.% oxygen in HfNbTaTiZr introduces point defects and local lattice distortions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9739258::web::029::3_1_contamination_of_nb_with_interstitia"
      ],
      "same_system": "no"
    },
    {
      "text": "Quantum effects and defect scattering are prominent in HfNbTaTiZr between 0 and 200 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal disorder and oxidation effects become significant in HfNbTaTiZr between 300 and 1200 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6212920::web::047::4_3_oxidation",
        "PMC7179019::web::052::5_4_2_oxidation_at_1200_c",
        "PMC7504593::web::057::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen-induced point defects and lattice distortions alter electron-scattering and phonon-transport mechanisms.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Real-sample defects and oxygen impurities modify conduction paths, including by increasing scattering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Explicitly representing defects and oxygen impurities will reduce the discrepancy between predictions and experimental conductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The model will more accurately capture a low-temperature conductivity drop caused by defect-induced scattering.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The model will more accurately capture complex high-temperature conductivity behavior arising from oxygen-related oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6212920::web::047::4_3_oxidation",
        "PMC7179019::web::052::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Existing analytical conductivity predictions assume a perfect, defect-free crystal structure.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Existing analytical predictions show notable deviations from conductivity measurements on oxygen-contaminated HfNbTaTiZr.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed model is applicable to bulk HfNbTaTiZr containing up to approximately 1 wt.% oxygen over 0–200 K and 300–1200 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Predictions outside the stated oxygen and temperature limits are unverified.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The accuracy obtainable by transferring binary-alloy and HEA training data depends on the representativeness and quality of those data.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7933338::web::011::results_and_discussions",
        "PMC9270422::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Electrical conductivity or resistivity can be measured across both specified temperature intervals using a four-probe method.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A consistent deviation greater than 20% in either temperature regime, or failure to reproduce the qualitative trend, is proposed as a falsifying result.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
