      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The experiment will replace 10%, 20%, and 30% of the equiatomic alloy's Mo content with Nb.",
      "field": "falsification_experiment.design",
