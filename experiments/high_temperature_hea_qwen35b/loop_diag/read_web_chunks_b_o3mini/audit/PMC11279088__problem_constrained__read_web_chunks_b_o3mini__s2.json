  "claims": [
    {
      "text": "The proposed scope is CrFeCoNiX alloys, with X equal to Al, Si, or Mn, in single- or multiphase metallic solid-solution states.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HVOF in-flight oxidation parameters can be controlled to direct selective oxidation of alloying elements.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled in-flight oxidation increases preferential oxidation of Al in an Al-containing HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Preferential Al oxidation during HVOF processing produces an Al2O3 surface scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting Al2O3 layer is homogeneous and coherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 scales grow slowly relative to chromium oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 scales have high adhesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 provides substantial resistance to high-temperature oxidation and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An Al2O3 scale formed by controlled in-flight oxidation can resist cracking and spallation above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10820071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing Al with Si or Mn produces less-adherent and less-stable oxide scales under otherwise equivalent conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si- or Mn-containing variants form their oxide scales more rapidly or heterogeneously than the Al-containing variant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid or heterogeneous scale formation creates porosity and cracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale porosity and cracks promote spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in oxide-formation kinetics and adhesion govern high-temperature scale stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlled-in-flight-oxidized Al-containing coatings will retain a stable Al2O3 scale during long exposures above 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10820071::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Si- and Mn-containing coatings will show faster scale growth, more defects, and eventual spallation than the Al-containing coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
