  "claims": [
    {
      "text": "The baseline material is as-cast HfMoTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A portion of Hf should be replaced by Al to form (Hf1-xAlx)MoTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed substitution range is x = 0.2–0.5, corresponding to approximately 4–10 at.% Al in the complete five-component formula.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial substitution of Hf by Al will lower the alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::014::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will retain high strength at room temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain high strength around 1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain a disordered BCC solid-solution structure with only limited additional-phase formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Retention of the BCC solid solution will preserve solid-solution strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Retention of the BCC solid solution will preserve dislocation-pinning mechanisms that govern high strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al has a much lower atomic weight than Hf, so replacing Hf with Al reduces alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::014::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderate Al additions can promote solid-solution strengthening in this alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate Al substitution will avoid detrimental phase transformations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The density will decrease by a few percent relative to 10.21 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::014::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Strength and ductility will remain comparable to those of as-cast HfMoTaTiZr at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strength and ductility will remain comparable to those of as-cast HfMoTaTiZr around 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is applicable from ambient temperature to approximately 1000 °C under typical tensile or compressive loading used for refractory high-entropy alloys.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing-dependent phase or precipitate formation could impair high-temperature strength.",
