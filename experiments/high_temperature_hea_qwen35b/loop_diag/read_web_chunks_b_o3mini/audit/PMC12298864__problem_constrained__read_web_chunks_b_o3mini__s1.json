  "claims": [
    {
      "text": "The applicable alloy is equimolar CoCrFeNiTi, corresponding to approximately 20 at.% of each element.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy is a single-phase simple solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy has coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy has few nanotwins.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse grains and a low density of internal dislocation barriers govern the relatively low hardness and strength of as-cast equimolar CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction stir processing or comparable severe plastic deformation will refine the grains of CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe plastic deformation will promote deformation-induced nanotwins in CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ultrafine-grain boundaries and nanotwin boundaries impede dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing grain-boundary and nanotwin-boundary density enhances work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy's relatively unobstructed dislocation motion causes its low hardness and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction-stir-processed samples will have higher hardness than untreated as-cast samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction-stir-processed samples will have higher yield strength than untreated as-cast samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increases in hardness and yield strength will correlate with reduced average grain size and increased nanotwin density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy combines favorable plasticity with relatively low hardness and strength.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed comparison holds composition approximately constant while comparing as-cast and friction-stir-processed states at room temperature.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is restricted to deformation dominated by dislocation slip without phase-transformation contributions.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain statistically significant hardness and yield-strength increases, or failure of nanotwin density to correlate with improved properties, would falsify the hypothesis.",
      "field": "falsification_experiment",
      "needs_support": false,
