  "claims": [
    {
      "text": "Adding a minor amount of Sn to a single-phase FCC FeCoNi-based alloy will induce an FCC+BCC duplex microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "FeCoNi(CuAl)0.8 is an example of a single-phase FCC FeCoNi-based initial alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Sn coefficient range is x = 0.02 to 0.10 in FeCoNi(CuAl)0.8Snx.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "FeCoNi(CuAl)0.8Snx alloys can be prepared by vacuum arc-melt casting.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing at approximately 673 K will promote the proposed phase transformation.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnetic comparison should be conducted at room temperature.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The BCC phase nucleates preferentially in regions influenced by Sn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A slight Sn addition destabilizes the single-phase FCC structure and promotes heterogeneous BCC nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interfaces between FCC and BCC regions act as domain-wall pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial domain-wall pinning hinders domain-wall motion and thereby increases coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sn addition will produce a significant coercivity increase relative to the matched single-phase FCC baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase FCC FeCoNi and its matched derivatives have coercive fields no greater than 100 Oe.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is bounded to processing conditions that yield an FCC+BCC mixture.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The upper Sn level x = 0.10 in FeCoNi(CuAl)0.8Snx corresponds to approximately 10 at% Sn.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Sn or processing deviations may produce unknown phases or inconsistent microstructures.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coercivity increase depends on achieving an appropriate balance and distribution of FCC and BCC phases.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled series with x = 0, 0.02, 0.05, and 0.10 should be processed using identical casting and heat-treatment conditions.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD should identify the phases, and room-temperature VSM or SQUID hysteresis loops should determine coercivity.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if Sn-doped samples show no statistically significant coercivity increase and remain at or below approximately 100 Oe.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is also deemed falsified if an FCC+BCC microstructure is not clearly observed.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
