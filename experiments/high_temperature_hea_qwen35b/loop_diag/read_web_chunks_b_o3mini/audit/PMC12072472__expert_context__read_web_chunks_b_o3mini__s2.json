  "claims": [
    {
      "text": "The initial material is zirconium-alloy fuel cladding coated with elemental chromium.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elemental Cr coatings can peel and crack during high-temperature steam oxidation.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Premature failure of the baseline Cr coating is caused by elevated-temperature Cr–Zr interdiffusion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified Cr coating performs adequately in one service regime before failing early in high-temperature steam.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is to add a few atomic percent aluminum to the Cr coating during deposition.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Aluminum is a strong oxide-forming element capable of contributing to a dense, corrosion-resistant oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al added to a Cr coating will preferentially oxidize to Al2O3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified coating will form a thin, continuous alumina layer at the surface or near the Cr/zirconium interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina layer will restrict Cr–Zr interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina barrier will improve high-temperature oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr+Al coating will retain structural integrity across both normal-operation water and accident steam regimes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, the Cr+Al coating will have lower Cr–Zr interdiffusion rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to elemental Cr, the Cr+Al coating will show lower oxide-scale thickness or weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to elemental Cr, the Cr+Al coating will have better adhesion and durability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating is applicable in PWR-like subcritical water at approximately 300°C for extended exposure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating is applicable in steam at approximately 900°C for accident exposures lasting minutes to hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A minor Al addition should not adversely affect neutron economy.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr+Al coating should remain stable under simultaneous irradiation and thermal cycling.",
      "field": "boundary",
      "needs_support": true,
