      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfaces associated with γ′ precipitates impede radiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
