  "claims": [
    {
      "text": "The equiatomic CrMnFeCoNi baseline and the equiatomic CrCoNi and CrMnCoNi subsets can be prepared as single-phase FCC alloys after thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has better cryogenic mechanical performance, including ductility, than the CrMnFeCoNi baseline and other equiatomic FCC derivatives.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The presence or absence of Mn changes magnetic frustration and the relative energetics of the FCC and HCP structures.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Variations in local magnetic and chemical environments caused by Mn modulate stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed change in stacking-fault energy controls the extent of deformation-induced FCC-to-HCP transformation.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed change in stacking-fault energy controls formation of the deformation-induced nanotwin network.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Differences in deformation-induced HCP phase and nanotwin-network development mediate mechanical-property differences among these alloys.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has less Mn-associated magnetic frustration than Mn-containing CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "The absence of Mn lowers the energy barrier for stacking-fault formation in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi undergoes more deformation-induced FCC-to-HCP transformation than the CrMnFeCoNi baseline.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi develops a denser and more interconnected nanotwin network than CrMnFeCoNi.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-associated magnetic interactions in CrMnFeCoNi hinder deformation-induced FCC-to-HCP transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppression of the transformation in CrMnFeCoNi produces a different dislocation-accommodation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed transformation and nanotwin differences alter work-hardening behavior.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to CrMnFeCoNi, CrCoNi should exhibit increased strain hardening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to CrMnFeCoNi, CrCoNi should exhibit improved ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equiatomic CrMnCoNi should show intermediate HCP transformation, nanotwin development, and mechanical behavior between CrCoNi and CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In CrCoNi, FCC-to-HCP transformation is triggered locally by dislocation slip and interactions with internal boundaries.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation favors stacking-fault activity and permits activation of FCC-to-HCP transformation and nanotwinning.",
      "field": "intervention; conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism applies only to single-phase FCC alloys in deformation regimes where transformation and nanotwinning are active, and not to alloys whose behavior is governed by second phases or precipitation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
