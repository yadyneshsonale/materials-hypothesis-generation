  "claims": [
    {
      "text": "As-cast high-entropy alloys inherently exhibit microsegregation and elemental partitioning.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An ultrahigh-temperature homogenization treatment around 2100°C for 2 hours is applicable to refractory high-entropy alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The homogenization treatment should be followed by rapid quenching.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultrahigh-temperature homogenization followed by rapid quenching minimizes microsegregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Minimizing microsegregation through this treatment improves elevated-temperature mechanical properties.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment enhances the homogeneous distribution of alloying elements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed treatment suppresses precipitate formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment produces a refined microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-temperature treatment dissolves segregated phases and impurities.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching prevents dissolved segregated phases and impurities from re-forming.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting microstructure improves dislocation-driven strengthening at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The resulting microstructure reduces high-temperature softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will have higher elevated-temperature yield strength than the as-cast or conventionally cooled alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will resist elevated-temperature softening better than the as-cast or conventionally cooled alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally cooled or as-cast high-entropy alloys exhibit noticeable microsegregation and related mechanical softening.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
