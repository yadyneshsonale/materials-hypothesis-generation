      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 0.7 mol Al triggers an FCC-to-BCC transformation in CoCrFeNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-induced lattice distortion favors formation of the BCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting BCC phase is inherently more resistant to dislocation creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition creates a thin, stable, passivating aluminum-oxide surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminum-oxide layer enhances the corrosion resistance of Al-modified CoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-modified CoCrFeNi will have a lower room-temperature creep rate than untreated CoCrFeNi.",
