  "claims": [
    {
      "text": "The as-produced additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
