      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The as-produced alloy contains minor nitride precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The σ-phase precipitates are especially concentrated at grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing above 1300 K dissolves the σ-phase precipitates.",
