      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing above 1300 K produces a more homogeneous, single-phase FCC microstructure.",
