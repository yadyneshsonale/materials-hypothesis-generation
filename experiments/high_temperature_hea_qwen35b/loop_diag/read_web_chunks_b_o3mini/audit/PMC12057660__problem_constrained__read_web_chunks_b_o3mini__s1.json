  "claims": [
    {
      "text": "Conventional rapid heating–cooling synthesis of noble-metal HEA nanoparticles typically reaches approximately 2000 K within milliseconds.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid high-temperature synthesis causes phase separation, elemental segregation, and uncontrolled nanoparticle morphology.",
      "field": "hypothesis; material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature synthesis promotes particle growth.",
      "field": "material_initial_state; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Moderate or low synthesis temperatures can inhibit precursor mobility in noble-metal HEA nanoparticle formation.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Inhibiting precursor mobility suppresses phase-separation pathways and favors formation of a single-phase HEA nanoparticle.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stochastic incorporation or mixing governs low-temperature formation of single-phase noble-metal HEA nanoparticles.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Extending processing beyond the usual millisecond regime permits stochastic mixing without triggering liquid-phase segregation.",
      "field": "intervention; conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The upper processing boundary for suppressing excessive diffusion is below 1200 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing times must be long relative to milliseconds for the proposed mechanism to operate.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HEAs contain five or more principal elements in equimolar or near-equimolar ratios.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The low-mobility mechanism is broadly applicable to noble-metal precursor systems containing five or more elements.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The synthesis temperature must remain high enough to decompose the precursors.",
      "field": "intervention; conditions; boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Moderate-temperature synthesis will increase single-phase purity relative to rapid high-temperature synthesis.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Moderate-temperature synthesis will produce a more uniform elemental distribution.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Moderate-temperature synthesis will yield more controlled nanoparticle morphology.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
