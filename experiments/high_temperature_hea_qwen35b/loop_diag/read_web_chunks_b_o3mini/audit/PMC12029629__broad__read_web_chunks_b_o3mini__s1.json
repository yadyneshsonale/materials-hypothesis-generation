  "claims": [
    {
      "text": "The initial material is a single-phase face-centered-cubic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has intrinsically low stacking-fault energy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled thermomechanical or alloying treatment can deliberately introduce a network of stacking faults.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dynamic loading, stacking-fault networks promote a stress-induced fcc-to-hcp transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stacking-fault networks act as nucleation sites for the fcc-to-hcp transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pre-existing stacking-fault networks lower the energy barrier for the fcc-to-hcp transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A continuous in situ fcc-to-hcp transformation makes a dominant contribution to strain hardening in a Cantor-like HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The transformation creates an fcc-hcp dual-phase microstructure that resists further deformation and strengthens the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion",
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The transformation-induced microstructure continues to accommodate plastic flow and therefore preserves or enhances ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The fcc-to-hcp TRIP effect can benefit both strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "An alloy with deliberately introduced stacking-fault networks will have a higher dynamic strain-hardening rate than an otherwise identical untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will exhibit increased yield strength under dynamic loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will retain or enhance ductility relative to the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Post-deformation characterization will reveal hcp regions spatially associated with stacking-fault networks.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The mechanism should operate in low-stacking-fault-energy fcc HEAs at moderate to high strain rates and from ambient to cryogenic temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the mechanical-property changes may depend on composition, stacking-fault density, and loading conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::web::000::abstract",
        "PMC7012927::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Failure to observe either increased dynamic hardening or an fcc-to-hcp transformation in the modified samples relative to the control would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
