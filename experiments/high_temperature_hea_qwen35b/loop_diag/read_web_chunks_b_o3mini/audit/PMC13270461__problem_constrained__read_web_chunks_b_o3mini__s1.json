  "claims": [
    {
      "text": "The additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy initially has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Non-equilibrium additive manufacturing produces fine dispersed precipitates in the initial alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial FCC matrix is supersaturated.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, an oxidizing gas accelerates the formation and coarsening of Cr-rich oxide precipitates at grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Titanium may enhance the grain-boundary oxide precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reducing atmosphere slows oxide precipitation and preserves mechanical integrity relative to an oxidizing atmosphere.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed atmosphere-dependent behavior applies over 950–1300 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen diffuses into the alloy and reacts preferentially at grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual stresses and defects are highest at grain boundaries in the additively manufactured alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Preferential grain-boundary oxidation causes Cr-rich oxides to grow and coalesce.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intergranular oxide precipitation weakens grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of grain-boundary cohesion facilitates crack initiation and propagation under mechanical load.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-induced intergranular cracking can produce catastrophic failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limited oxygen availability in a reducing atmosphere suppresses grain-boundary oxide evolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will produce larger and more continuous grain-boundary oxides than either the starting state or reducing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will reduce ductility relative to the starting state and reducing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will reduce fracture toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will cause catastrophic failure to begin earlier.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure will retain a more ductile mechanical response and produce minimal grain-boundary oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature coarsening and grain-boundary localization of an intermetallic sigma phase can degrade mechanical and chemical properties.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
