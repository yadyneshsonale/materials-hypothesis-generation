  "claims": [
    {
      "text": "Premelting and melting behavior of solid Fe–Ni–Cr–Co–Cu nanoparticles is governed jointly by defect-mediated atomic mobility and cooling rate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10621632::web::026::simulated_particle_formation_and_influen",
        "PMC10056590::web::033::4_summary_and_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid cooling preserves a single-phase, high-entropy nanoparticle structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10621632::web::027::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid cooling freezes in defect-induced lattice strains that hinder atomic segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower cooling provides sufficient atomic diffusion for phase separation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen",
        "PMC10056590::web::033::4_summary_and_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The initially solid nanoparticles have an equiatomic or near-equiatomic distribution of Fe, Ni, Cr, Co, and Cu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature cycling develops lattice defects and local strain fields in the nanoparticles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice defects and local strain fields mediate atomic mobility.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice defects and local strain fields nucleate phase segregation during cooling.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High temperature enhances defect formation and atomic mobility, allowing local atomic reordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid cooling suppresses atomic diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
      "text": "Slower cooling permits atoms to reorganize into lower-energy segregated phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen",
        "PMC10056590::web::033::4_summary_and_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapidly cooled particles will retain a predominantly single-phase HEA structure relative to slowly cooled particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10056590::web::033::4_summary_and_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapidly cooled particles will have a higher defect density than slowly cooled particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slowly cooled particles will show phase separation or elemental segregation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen",
        "PMC10056590::web::033::4_summary_and_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies in the nanoparticle size range where surface effects and defect dynamics dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism may not apply to bulk samples or to HEAs with drastically different elemental interactions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
