  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Increasing Al and Cr relative to Mn, or reducing Mn mobility, causes preferential outward diffusion of Al and Cr during exposure above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Preferential outward diffusion of Al and Cr produces a continuous, coherent, and adherent protective scale composed primarily of Al2O3 and Cr2O3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher Mn content or mobility produces predominantly Mn-rich oxides that are unstable and prone to cracking or spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::037::5_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed starting materials are CrFeCoNiX alloys, with X equal to Si, Mn, or Al, in single- or multiphase metallic solid-solution states.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline has a standard Mn level.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al and Cr relative to Mn favors transport of protective elements to the alloy surface.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior applies during prolonged exposure above 900 °C in oxidative or corrosive atmospheres.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale is duplex, with an inner Cr2O3-rich layer and an outer Al2O3-rich layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Cr2O3/Al2O3 duplex scale is coherent and adherent and acts as a barrier against further oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced Al and Cr contents promote their preferential surface diffusion and formation of slow-growing protective oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::016::4_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Suppressing Mn mobility minimizes fast-growing, unstable Mn oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::037::5_conclusions",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn mobility and low-energy oxide formation can deplete Mn, create pores, and accelerate oxide growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Principles from Ti-Al intermetallic systems can be applied to control diffusion kinetics and oxide formation in CrFeCoNiX alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the baseline, the modified alloy will form a thinner, more uniform, and more adherent oxide scale with less cracking and spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A higher-Mn, lower-Al/Cr baseline forms a thicker, more heterogeneous, unstable scale dominated by Mn-rich phases.",
