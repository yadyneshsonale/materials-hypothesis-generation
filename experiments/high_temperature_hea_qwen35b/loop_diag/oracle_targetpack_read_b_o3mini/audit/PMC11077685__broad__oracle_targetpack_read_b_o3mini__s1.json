  "claims": [
    {
      "text": "The intervention is to add minor amounts of Ge and B to a refractory high-entropy alloy, with Ge at approximately 6 at.%.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding Ge and B will promote formation of a continuous, dense SiO2 scale during high-temperature oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The continuous SiO2 scale formed after Ge and B addition will be protective.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated refractory HEA contains enough silicon to form SiO2.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated refractory HEA typically forms discontinuous or less-protective oxide scales at high temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge destabilizes competing silicide phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ge enhances adhesion of the oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B acts as a glass-network former in the SiO2 scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B improves sealing and densification of the SiO2 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge and B act synergistically to produce a continuous protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A continuous, dense SiO2 scale limits oxygen diffusion into the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ge- and B-modified alloy will have a markedly lower oxidation rate than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ge- and B-modified alloy will have better oxide-scale integrity than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ge- and B-modified alloy will have greater high-temperature oxygen resistance than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::010::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Discontinuous or less-protective scales on the untreated alloy cause higher oxidation rates and degradation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
