  "claims": [
    {
      "text": "Ti-Nb-Cr-V-Ni-Al can be produced by direct energy deposition as a refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9571103::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "DED-produced Ti-Nb-Cr-V-Ni-Al has a fine-grained microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9571103::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline Ti-Nb-Cr-V-Ni-Al composition contains no Hf or Y additions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9571103::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is to add 0.5–2 at% Hf, Y, or both to the powder mixture before DED.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "DED involves rapid solidification that produces the alloy's fine-grained microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9571103::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Trace Hf or Y will induce coherent precipitates in DED-produced Ti-Nb-Cr-V-Ni-Al.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf or Y promotes heterogeneous nucleation of coherent precipitates during DED rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coherent precipitates impede dislocation movement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coherent precipitates impede grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf/Y microalloying will enhance high-temperature strength relative to otherwise equivalent Ti-Nb-Cr-V-Ni-Al without Hf or Y.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf/Y microalloying may increase elevated-temperature yield strength and hardness by approximately 10–20%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted mechanical improvement should occur during service or testing around 900–1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement is bounded to DED processing conditions and may operate differently at substantially higher temperatures or under different service conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Variations in DED parameters can influence microstructure formation and resulting mechanical properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9571103::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y and Hf co-doping has previously been associated with improved thermal stability in a laser-cladded AlCoCrFeNi2.1 eutectic HEA at 900 °C.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
