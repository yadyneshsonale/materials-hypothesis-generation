  "claims": [
    {
      "text": "Increasing short-range order in FCC high-entropy alloys creates additional spatially varying local energy barriers.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The local energy barriers created by enhanced SRO impede dislocation glide during dynamic deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced SRO modestly increases yield strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced SRO promotes sustained strain hardening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced SRO does not fundamentally change the operative plasticity mechanism.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Local lattice distortion and chemical heterogeneity produce a heterogeneous energy landscape for dislocations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The heterogeneous energy landscape produces rugged dislocation lines and localized pinning or depinning.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "More irregular dislocation trajectories caused by enhanced SRO promote continued strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing SRO will raise yield strength by approximately 5–10% relative to the disordered baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing SRO will produce a more fluctuating stress-strain response than the disordered baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Samples with increased SRO will retain good ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 300 K under high-strain-rate tensile loading, dislocation-mediated plasticity dominates in the proposed FCC HEA.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed SRO effect applies to single-phase FCC high-entropy alloys at moderate temperature under dynamic deformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect may fail in non-FCC HEAs or under temperatures and strain rates where other deformation mechanisms prevail.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of strengthening and its ductility trade-off depend on alloy composition and the degree of SRO introduced.",
      "field": "uncertainty",
