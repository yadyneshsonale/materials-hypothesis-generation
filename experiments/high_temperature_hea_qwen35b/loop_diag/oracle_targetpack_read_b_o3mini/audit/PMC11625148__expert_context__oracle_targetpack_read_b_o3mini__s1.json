      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11477617::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed benefits will persist from ambient temperature to 1600 °C under irradiation regimes similar to helium implantation.",
