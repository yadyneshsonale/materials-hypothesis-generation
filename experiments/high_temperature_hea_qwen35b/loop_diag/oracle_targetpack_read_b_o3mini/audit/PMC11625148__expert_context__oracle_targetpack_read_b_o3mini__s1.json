      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11477617::web::015::3_1_composition_and_structure_of_initial",
        "PMC11477617::web::022::3_1_composition_and_structure_of_initial"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-modified alloy will have greater room-temperature ductility than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will exhibit less irradiation-induced damage than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11477617::web::015::3_1_composition_and_structure_of_initial",
        "PMC11477617::web::022::3_1_composition_and_structure_of_initial"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-modified alloy will retain the high-temperature strength of untreated NbMoTaW up to 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will retain structural stability under irradiation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11477617::web::022::3_1_composition_and_structure_of_initial"
      ],
      "same_system": "no"
    },
    {
      "text": "Heavy-ion and helium-ion irradiation can be used to simulate aspects of nuclear irradiation environments.",
