      "supporting_ids": [
        "PMC9969177::web::000::abstract",
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "yes"
    },
    {
      "text": "In vacuum, Shockley partial dislocations are generated from surfaces and grain boundaries during tensile deformation.",
