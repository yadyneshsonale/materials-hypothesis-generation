  "claims": [
    {
      "text": "The untreated refractory high-entropy alloy has a predominantly BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy exhibits conventional oxidation behavior during high-temperature exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An atomically thin high-entropy oxide layer can be deposited on the refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9413438::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The deposited layer will be coherent, dense, and continuous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy oxide layer will act as a protective barrier on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction",
        "PMC9413438::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will reduce oxygen solubility at the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will reduce oxygen diffusivity at the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced oxygen solubility and diffusivity will suppress oxygen penetration into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxygen-defect engineering in CeO2-based systems provides a precedent for stabilizing a protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will stabilize the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 800 °C in air for up to 27 hours, the coating will reduce oxidation-induced weight gain relative to an untreated control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 800 °C in air for up to 27 hours, the coating will reduce oxidation-induced microstructural degradation relative to an untreated control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxidation will improve the alloy's structural integrity and durability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated refractory high-entropy alloy develops significant, thick, and potentially spalling oxide scales under the specified 800 °C air exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated alloy undergoes near-surface elemental depletion under the specified exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's protective effect is expected primarily around 800 °C in air.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating may become insufficient at temperatures significantly above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating may become insufficient in oxygen-rich environments more aggressive than laboratory air.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
