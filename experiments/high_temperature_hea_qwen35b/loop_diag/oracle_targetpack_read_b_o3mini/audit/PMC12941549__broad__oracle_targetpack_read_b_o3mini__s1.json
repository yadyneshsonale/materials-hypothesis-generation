        "PMC12348563::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective scale has a specifically layered structure consisting of inner Al2O3 and outer Cr2O3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::021::3_4_microstructure_and_chemical_composit",
        "PMC12348563::web::031::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
