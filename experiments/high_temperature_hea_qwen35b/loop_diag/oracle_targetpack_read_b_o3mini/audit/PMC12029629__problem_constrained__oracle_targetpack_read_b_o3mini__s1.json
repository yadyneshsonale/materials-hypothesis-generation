  "claims": [
    {
      "text": "The initial material is equiatomic Co-free FeNiCrMn in an as-solidified, single-phase solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing cobalt modifies the local grain-boundary chemistry and structure of FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Σ3 and Σ111 grain boundaries in Co-free FeNiCrMn are especially efficient heterogeneous nucleation sites for partial dislocations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7801446::web::017::deformation_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain boundaries nucleate 1/6 <112> partial dislocations that propagate into the bulk and leave stacking faults.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7801446::web::013::mechanical_deformation_behavior",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified grain-boundary chemistry of the Co-free alloy lowers the nucleation barrier for partial dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary-mediated partial-dislocation nucleation causes stacking faults to form at lower applied strains than in a single crystal.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7801446::web::017::deformation_mechanisms",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Co-free FeNiCrMn forms stacking faults earlier than Co-containing counterparts.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking faults generated by partial dislocations contribute to strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature and strain rate modulate the activation energy for grain-boundary partial-dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower temperatures and higher strain rates promote earlier partial-dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperatures increase dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperatures, increased dislocation mobility produces a less serrated and smoother stress-strain response.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperature and high strain rate, Co-free bicrystals have lower partial-dislocation nucleation stress and strain than the stated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7801446::web::017::deformation_mechanisms",
        "PMC7801446::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism dominates at strains below approximately 20% over 300–1000 K and strain rates of 1×10^8–1×10^9 s^-1 when grain-boundary nucleation is the primary deformation mode.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Activation of twinning or phase transformation can cause deviations from the proposed mechanism.",
      "field": "boundary",
