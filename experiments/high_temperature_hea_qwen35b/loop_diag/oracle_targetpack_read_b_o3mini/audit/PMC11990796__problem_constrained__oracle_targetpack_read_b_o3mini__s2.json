  "claims": [
    {
      "text": "Equiatomic NbZrTiHfMo has a disordered BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbZrTiHfMo has a room-temperature compressive yield strength of 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content of equiatomic NbZrTiHfMo is associated with reduced plasticity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.1–0.5 at% interstitial carbon to equiatomic NbZrTiHfMo will improve its room-temperature compressive strength–plasticity balance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon atoms will occupy interstitial sites in NbZrTiHfMo and increase lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Interstitial carbon will promote local chemical ordering in NbZrTiHfMo.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-induced lattice distortion and local chemical ordering will reduce the effective stacking-fault energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced stacking-fault energy will enable deformation twinning and/or transformation-induced plasticity in the BCC NbZrTiHfMo alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon will provide additional solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbon addition will preserve the high yield strength attributed to Mo-induced solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Activation of TWIP and/or TRIP will provide additional strain-hardening capacity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Additional strain-hardening from TWIP and/or TRIP will improve room-temperature compressive plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbon-modified alloy will retain a compressive yield strength close to 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified alloy will have greater compressive strain to failure than the carbon-free equiatomic alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified alloy will exhibit improved work-hardening behavior at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::002::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The beneficial effect requires retention of a single-phase disordered BCC structure during synthesis and thermomechanical processing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect is expected only for carbon additions below 1 at%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher carbon contents may cause carbide precipitation or phase instability that degrades strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
