      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7376180::web::019::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "γ′ precipitates restrict grain-boundary or lattice diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted grain-boundary or lattice diffusion increases room-temperature creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent γ′ precipitates reduce pathways available to corrosive species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing pathways for corrosive species improves corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
