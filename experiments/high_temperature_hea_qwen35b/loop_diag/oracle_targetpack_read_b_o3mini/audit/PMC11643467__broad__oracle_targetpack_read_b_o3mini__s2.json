      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC5627260::web::004::results"
      ],
      "same_system": "yes"
    },
    {
      "text": "γ′ precipitates impede dislocation motion and thereby strengthen the alloy.",
