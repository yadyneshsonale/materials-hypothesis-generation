      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC5627260::web::004::results"
      ],
      "same_system": "yes"
    },
    {
      "text": "The γ′ phase is an L12 precipitate phase within an FCC γ matrix.",
