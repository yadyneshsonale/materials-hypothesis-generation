        "PMC7376180::web::019::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated HEA will show an approximately 10–20% increase in yield strength relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated HEA will show an approximately 10–20% increase in room-temperature creep resistance relative to the baseline.",
