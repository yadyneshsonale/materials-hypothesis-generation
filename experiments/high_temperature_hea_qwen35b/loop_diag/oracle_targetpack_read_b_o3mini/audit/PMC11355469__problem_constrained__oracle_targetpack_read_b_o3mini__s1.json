  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu high-entropy-alloy coating on a conventional metal substrate without intentional oxidation.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A calibrated thermal treatment can generate a controlled, thin, uniform surface oxide on the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pre-oxidized surface layer enhances wear resistance during high-temperature sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pre-oxidized surface layer moderates microscopic deformation during high-temperature sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant operating regime is sliding above approximately 500°C, where oxidation is sustained and wear is significant.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thermally produced oxide layer will be uniform and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer alters the local stress state in the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer acts as a barrier to dislocation nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation increases the dislocation-nucleation barrier during high-temperature sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation suppresses the FCC-to-HCP transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::013::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation suppresses the FCC-to-BCC transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing dislocation nucleation and phase transitions reduces subsurface shear-strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced subsurface shear localization limits the intensity of plastic deformation and thereby improves wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will have a lower wear rate than the untreated coating under otherwise identical high-temperature sliding conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will exhibit fewer dislocation pile-ups than the untreated coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will exhibit fewer deformation twins than the untreated coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
