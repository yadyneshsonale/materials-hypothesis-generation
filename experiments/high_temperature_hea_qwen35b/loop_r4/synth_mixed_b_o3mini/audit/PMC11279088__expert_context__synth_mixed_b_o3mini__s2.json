      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mn-containing alloy forms a thicker, nonuniform oxide that cracks and spalls.",
