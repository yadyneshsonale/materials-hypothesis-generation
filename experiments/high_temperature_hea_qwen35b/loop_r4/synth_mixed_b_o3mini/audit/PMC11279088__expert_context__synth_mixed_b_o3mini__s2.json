      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si minimizes lattice mismatch at the oxide/metal interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An Al-containing CrFeCoNiX alloy forms a thin, coherent, slowly growing, adherent oxide scale above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A Si-containing CrFeCoNiX alloy forms a thin, coherent, slowly growing, adherent oxide scale above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective alumina is the preferred oxide-scale mediator for the Al-containing alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
