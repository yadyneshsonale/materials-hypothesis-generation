  "claims": [
    {
      "text": "The initial HfNbTaTiZr alloy is a homogeneous, single-phase BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::013::elastic_constants_local_displacements_an",
        "PMC11206460::web::028::characterization_of_mobile_dislocations_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "HfNbTaTiZr has high inherent lattice distortion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::013::elastic_constants_local_displacements_an"
      ],
      "same_system": "yes"
    },
    {
      "text": "Deformation in HfNbTaTiZr at room temperature or below 673 K is dominated by screw dislocations.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating HfNbTaTiZr through approximately 673–1073 K causes a transition from screw-controlled slip to edge-dislocation-dominated slip.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The elevated-temperature edge-dislocation regime is enabled by thermal super-jog formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Intrinsic lattice distortion in the multi-principal-element BCC structure promotes activation and mobility of edge dislocations through super-jogs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results",
        "PMC10894205::web::013::elastic_constants_local_displacements_an"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermal energy between 673 K and 1073 K lowers the barrier for edge-dislocation motion through super-jog formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Screw-dislocation-controlled deformation normally produces pronounced thermal softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "A shift toward edge-dislocation-controlled deformation counterbalances thermal softening and produces a yield-strength plateau.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "HfNbTaTiZr will show a yield-strength plateau rather than a continuous decline over 673–1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy's elastic moduli will change only modestly over 673–1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::028::characterization_of_mobile_dislocations_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The edge-dislocation transition modulates or moderates the thermal-expansion response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Between 673 K and 1073 K, HfNbTaTiZr will have a thermal-expansion coefficient lower than that predicted by conventional thermal softening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature specimens will contain a significantly greater proportion of edge-dislocation markers relative to screw-dislocation markers.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies within 673–1073 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Below 673 K, screw-dislocation mechanisms prevail in HfNbTaTiZr.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Above 1073 K, phase instability or precipitation may alter the deformation behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion",
        "PMC11206460::web::028::characterization_of_mobile_dislocations_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A controlled comparison can use fixed-strain-rate tensile or creep tests in an inert atmosphere at 673–1073 K against specimens tested at room temperature or below 673 K.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
