      ],
      "same_system": "unclear"
    },
    {
      "text": "Cavitation and boundary decohesion reduce ductility and cause brittle failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-strain-rate loading will significantly reduce ductility relative to the coarse-grained baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-strain-rate loading will increase intergranular cracking relative to the baseline.",
