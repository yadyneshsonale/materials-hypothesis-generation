      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::011::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Room or moderately low temperatures minimize thermal diffusion so that mechanical loading dominates the microstructural change.",
