      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::011::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "TEM or STEM will reveal an ultra-fine or amorphous boundary layer after high-rate loading.",
