      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-strain-rate loading in an inert or ultra-high-vacuum environment induces dynamic grain refinement.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dynamically refined material forms an ultra-nanocrystalline or amorphous-like layer localized at high-angle grain boundaries.",
