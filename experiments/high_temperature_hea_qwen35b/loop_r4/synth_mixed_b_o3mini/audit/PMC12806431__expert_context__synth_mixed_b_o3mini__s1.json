      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::011::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-rate loading reduces the effective grain size below a critical threshold.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reducing grain size below the critical threshold suppresses conventional dislocation-mediated plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppression of dislocation-mediated plasticity promotes grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined high-angle boundaries are susceptible to cavitation and decohesion even without significant chemical segregation.",
