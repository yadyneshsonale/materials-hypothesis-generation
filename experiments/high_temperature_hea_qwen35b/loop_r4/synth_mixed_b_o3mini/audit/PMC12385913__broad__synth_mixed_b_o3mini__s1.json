      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coherent-interface mechanism maintains or enhances toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy is homogeneous, single-phase, and fine-grained in the as-cast or conventionally heat-treated state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
