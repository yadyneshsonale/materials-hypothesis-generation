      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation transmission through coherent interfaces relieves stress concentration and suppresses premature crack initiation.",
