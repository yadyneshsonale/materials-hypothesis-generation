    },
    {
      "text": "Atmosphere-dependent oxidation mechanisms govern degradation during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
