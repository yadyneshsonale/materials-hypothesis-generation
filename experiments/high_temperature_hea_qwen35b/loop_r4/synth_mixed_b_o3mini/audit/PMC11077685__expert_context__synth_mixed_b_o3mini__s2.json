  "claims": [
    {
      "text": "As-cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic HfNbTaTiZr has a high-temperature yield strength of 163–530 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1–5 at.% Sn to cast equiatomic HfNbTaTiZr will improve its oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction",
        "PMC7040784::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Sn additions can contribute to suppression of pest oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Sn preferentially segregates to the surface of Sn-modified HfNbTaTiZr during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-segregated Sn oxidizes to form a Sn-enriched oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn addition produces a dense and continuous oxide layer on HfNbTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-enriched oxide layer is adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-enriched oxide acts as a barrier to oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen ingress lowers the rate of pest oxidation in Sn-modified HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Sn addition maintains the underlying BCC microstructure of HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn addition does not degrade the alloy's room-temperature tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn addition does not degrade the alloy's high-temperature yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 5 hours in air at approximately 800 °C, the Sn-modified alloy will exhibit less oxidation and fewer signs of pesting than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::010::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated equiatomic cast HfNbTaTiZr undergoes pest oxidation under approximately 800 °C, 5-hour air-exposure conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protective effect is limited to as-cast material exposed in air near 800 °C for exposure times on the order of 5 hours.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance at substantially different temperatures, in other atmospheres, or after thermomechanical processing is unverified.",
