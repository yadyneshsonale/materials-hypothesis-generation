    },
    {
      "text": "Equiatomic cast HfNbTaTiZr exhibits 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr exhibits elevated-temperature yield strengths of 163–530 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic cast HfNbTaTiZr undergoes inadequate oxygen resistance or rapid pest oxidation in air.",
