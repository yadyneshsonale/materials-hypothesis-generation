        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitation hardening or phase transformations would reduce the relative influence of short-range order on mechanical behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extreme temperatures or strain rates would reduce the influence of the proposed short-range-order mechanism.",
      "field": "boundary",
