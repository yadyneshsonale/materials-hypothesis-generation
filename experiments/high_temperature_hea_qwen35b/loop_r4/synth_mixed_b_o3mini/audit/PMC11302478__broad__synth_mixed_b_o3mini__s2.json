  "claims": [
    {
      "text": "Mechanical strength in multi-component concentrated alloys is predominantly governed by the degree of short-range chemical ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Short-range chemical ordering induces spatial fluctuations in local planar or stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local fault-energy fluctuations produce hard atomic motifs that resist dislocation glide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC10041143::web::001::abstract",
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Short-range order and its associated fault-energy fluctuations promote deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching retains a near-random atomic arrangement with minimal short-range order.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled aging enhances short-range chemical order relative to rapid quenching.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changing short-range order through aging also changes the magnitude or spatial distribution of local fault-energy fluctuations.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced short-range order creates localized hard atomic motifs that act as barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fault-energy-fluctuation resistance persists over successive dislocation passes and can dominate macroscopic strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::001::abstract",
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhancing short-range order by aging will increase yield strength relative to the rapidly quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhancing short-range order by aging will increase critical resolved shear stress relative to the rapidly quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::019::analysis_of_alloy_strength"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhancing short-range order by aging will produce more deformation twinning than in the rapidly quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twinning can be a primary deformation mode in metastable FCC multi-component alloys.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::000::abstract",
        "PMC6006257::web::024::mechanism_of_metastable_twinning",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed short-range-order effect should dominate in metastable FCC multi-component concentrated alloys with low stacking-fault energies.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
