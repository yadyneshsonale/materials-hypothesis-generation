      ],
      "same_system": "no"
    },
    {
      "text": "The as-built alloy contains minimal secondary-phase precipitation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built alloy has intact grain boundaries and grain-boundary cohesion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated temperature increases atomic mobility and enables diffusion-driven precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9414008::web::006::1_introduction",
        "PMC9414008::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing environments enhance grain-boundary diffusion relative to reducing environments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced grain-boundary diffusion promotes nucleation and growth of intergranular precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::006::1_introduction",
        "PMC9414008::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr-rich sigma phase can preferentially occur at grain boundaries and increase in size with annealing temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction",
        "PMC9414008::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Mixed Cr-containing nitrides can nucleate at triple points or occur near boundaries in an additively manufactured FCC high-entropy alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9414008::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure promotes Cr-rich sigma phase and nitride precipitation more strongly than reducing exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Secondary-phase precipitation can embrittle an FCC high-entropy alloy or otherwise significantly alter its mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9414008::web::004::1_introduction",
        "PMC9414008::web::008::1_introduction",
        "PMC9414008::web::028::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Intergranular sigma phase and nitrides weaken grain-boundary cohesive strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Weakening of grain-boundary cohesion causes loss of ductility and catastrophic failure under stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing-atmosphere aging produces fewer intergranular precipitates and preserves grain-boundary integrity relative to oxidizing aging.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure can form nonuniform, poorly adherent oxide scales in this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidized samples will have a higher volume fraction and coarser intergranular precipitates than reducing-atmosphere samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidized samples will exhibit lower fracture toughness and ductility than the as-built and reducing-atmosphere samples.",
      "field": "predicted_outcome",
