      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 2D transition-metal-dichalcogenide HEA lubricant can be deposited by air-spray coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12019924::web::003::main"
      ],
      "same_system": "unclear"
