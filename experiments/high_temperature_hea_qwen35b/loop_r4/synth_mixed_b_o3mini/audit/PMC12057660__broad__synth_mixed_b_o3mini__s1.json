      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting material is a homogeneous, near-equimolar mixture of noble- and non-noble-metal precursors.",
