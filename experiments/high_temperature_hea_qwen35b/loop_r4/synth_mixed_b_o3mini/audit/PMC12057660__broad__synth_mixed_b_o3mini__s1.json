      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting material contains isolated noble-metal sites uniformly embedded in a disordered, single-phase HEA matrix.",
