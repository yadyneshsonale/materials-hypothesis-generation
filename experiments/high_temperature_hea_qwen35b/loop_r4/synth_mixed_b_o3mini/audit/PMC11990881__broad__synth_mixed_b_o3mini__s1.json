      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium can be introduced at low concentration into the HEA bond coat during deposition.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal cycling between room temperature and approximately 1050–1100°C in air represents conditions relevant to turbine or similar high-temperature applications.",
