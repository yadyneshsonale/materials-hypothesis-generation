      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy is in an as-cast state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy is a single-phase solid solution.",
