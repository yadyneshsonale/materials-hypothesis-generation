  "claims": [
    {
      "text": "Applying a silicide coating to a refractory high-entropy alloy can improve its high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The beneficial silicide coating is thin.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide coating can be prepared on a refractory high-entropy alloy by a fused slurry method.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvement should occur during exposure near 800°C for about 50 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::web::012::3_4_oxidation_resistance"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvement should occur in ambient air under static exposure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation transforms the coating into an outer oxide layer over a residual inner silicide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale produced from the silicide coating is continuous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale produced from the silicide coating is adherent and stable.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silicide coating oxidizes during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coating-derived oxide layer retards oxygen ingress by acting as an oxygen-diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide-coated alloy will have lower oxidation-induced weight gain than an uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A silicide-coated alloy will develop a thinner oxide scale than an uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide-coated alloy will retain its microstructural integrity better than an uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide-coated alloy will retain its mechanical properties better than an uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated refractory high-entropy alloys typically form rapidly growing, non-protective oxide scales under high-temperature oxidizing conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Discontinuity of the coating would diminish its protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal cycling may diminish the coating's protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloy compositions that do not support stable oxide-scale formation may show diminished protection.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
