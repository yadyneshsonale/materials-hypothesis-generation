      "supporting_ids": [
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding approximately 5 at% Cr to NbMoTaW will improve its irradiation tolerance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at% Cr will preserve NbMoTaW's high-temperature strength and structural stability.",
