      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr addition may enhance twin boundaries or produce distributed ductile regions in NbMoTaW.",
      "field": "structural_mediator",
