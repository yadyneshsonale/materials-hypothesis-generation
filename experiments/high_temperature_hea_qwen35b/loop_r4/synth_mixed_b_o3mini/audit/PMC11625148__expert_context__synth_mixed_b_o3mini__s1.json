      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-modified alloy will exhibit lower irradiation-induced defect density and blister density than untreated NbMoTaW.",
      "field": "predicted_outcome",
