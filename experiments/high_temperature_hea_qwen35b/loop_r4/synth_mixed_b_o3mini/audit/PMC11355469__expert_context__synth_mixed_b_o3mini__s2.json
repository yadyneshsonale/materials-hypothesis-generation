  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin-film coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited FeNiCrCoCu coating has no pre-formed protective oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation at 500°C selectively oxidizes Cr and Cu in FeNiCrCoCu.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation at 500°C forms a continuous, adherent, self-healing oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed oxide scale is primarily composed of Cr oxides with contributions from Cu oxides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Treatment at 500°C produces a refined nanocrystalline microstructure in the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr- and Cu-containing oxide layer is lubricious and protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces friction during high-temperature wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural refinement caused by the heat treatment increases coating hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher coating hardness reduces wear rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A 500°C heat treatment can yield better wear resistance than other coating conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will have lower wear rates than as-deposited coatings during wear at 500–600°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will have lower friction coefficients than as-deposited coatings during wear at 500–600°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
