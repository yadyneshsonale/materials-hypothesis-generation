      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additional twinning channel maintains or improves the strength–ductility balance of FeNiCrMn relative to CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical dynamic testing conditions, CoCrFeMnNi deforms predominantly by dislocation glide.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under the proposed dynamic conditions, FeNiCrMn will exhibit a higher deformation-twin density than CoCrFeMnNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
