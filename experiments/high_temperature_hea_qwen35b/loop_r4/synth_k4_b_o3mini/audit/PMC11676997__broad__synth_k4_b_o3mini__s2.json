  "claims": [
    {
      "text": "Introducing a minor microalloying addition improves the elevated-temperature yield strength of a high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing a minor microalloying addition improves the creep resistance of a high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed starting alloy has a predominantly single-phase microstructure with no significant secondary precipitates.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding a minor amount of a carbide- or oxide-forming element during processing can cause nanoscale precipitates to form in situ.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in situ precipitates will be uniformly dispersed within the alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale precipitates obstruct dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale precipitates obstruct grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstruction of dislocation motion by the precipitates increases elevated-temperature yield strength through precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstruction of grain-boundary sliding by the precipitates reduces the creep rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The microalloyed alloy will have significantly greater yield strength than an otherwise similar alloy without the microalloying addition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The microalloyed alloy will have a significantly lower creep rate than an otherwise similar alloy without the microalloying addition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvements apply at approximately 600–800 °C, including under thermal-cycling and oxidative conditions.",
      "field": "conditions",
      "needs_support": true,
