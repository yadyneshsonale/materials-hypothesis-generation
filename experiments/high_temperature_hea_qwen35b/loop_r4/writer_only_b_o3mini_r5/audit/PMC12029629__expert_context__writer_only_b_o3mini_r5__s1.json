  "claims": [
    {
      "text": "The target material is as-solidified, equiatomic, Co-free FeNiCrMn without subsequent homogenization or thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-solidified equiatomic FeNiCrMn is a single-phase high-entropy solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The material has conventional casting-defect densities.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local chemical heterogeneities are inherent to the alloy's high-entropy solid-solution state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local chemical heterogeneities act as pinning obstacles to dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature and strain rate modulate dislocation mobility in as-solidified FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, reduced thermal activation makes it more difficult for dislocations to overcome local chemical obstacles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At higher strain rates, dislocation motion is more restricted by local chemical obstacles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted dislocation mobility produces higher yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted dislocation mobility produces lower ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At higher temperatures, thermal activation enables dislocations to bypass local chemical obstacles more easily.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower strain rates, dislocations bypass local chemical obstacles more easily.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Easier dislocation motion reduces yield strength and enhances ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreasing temperature and/or increasing strain rate will increase yield strength and decrease ductility relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature and/or decreasing strain rate will decrease yield strength and increase ductility relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature properties measured at moderate strain rates provide the comparison baseline.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism is applicable specifically to minimally processed, as-solidified FeNiCrMn.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe deformation, long-term thermal aging, or secondary-phase formation may introduce additional mechanisms controlling dynamic behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation twinning or grain-boundary effects may contribute under some testing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
