  "claims": [
    {
      "text": "The starting material is nanocrystalline W38Ta36Cr15V11.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed single intervention is incorporation of 1–2 at% Re.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at% Re will suppress radiation-induced Cr-rich precipitation in nanocrystalline W38Ta36Cr15V11.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at% Re will preserve negligible irradiation hardening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at% Re will make the alloy more amenable to practical bulk fabrication.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Re will segregate to grain boundaries and interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Re segregation will stabilize grain boundaries and defect-sink interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Re will reduce the mobility and clustering tendency of Cr solutes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr mobility and clustering will impede the nucleation and growth of Cr-rich precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Re addition will not compromise the high irradiation-defect sink efficiency attributed to the nanocrystalline structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 8 dpa, the Re-modified alloy will have a significantly lower Cr-rich precipitate volume fraction than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 8 dpa, the Re-modified alloy will have irradiation-induced defect density no greater than, and possibly lower than, that of the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At approximately 8 dpa, irradiation hardening in the Re-modified alloy will be no greater than, and possibly lower than, that of the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified nanocrystalline W38Ta36Cr15V11 exhibits measurable Cr-rich precipitation after irradiation to approximately 8 dpa in the stated temperature regime.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified nanocrystalline W38Ta36Cr15V11 retains negligible irradiation hardening despite precipitation at approximately 8 dpa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit is expected for energetic-particle irradiation up to approximately 8 dpa at 300–600°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The behavior of the Re-modified alloy outside approximately 8 dpa and 300–600°C is uncertain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
