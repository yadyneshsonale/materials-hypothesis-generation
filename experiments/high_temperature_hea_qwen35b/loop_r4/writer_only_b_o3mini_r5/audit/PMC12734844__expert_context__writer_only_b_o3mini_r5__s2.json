  "claims": [
    {
      "text": "The feedstock is a cobalt-free AlCrFeNiSi high-entropy-alloy powder.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline process is laser powder-bed fusion performed without powder-bed preheating.",
      "field": "material_initial_state; baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is powder-bed preheating to approximately 300–500 °C during laser melting.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder-bed preheating will reduce thermal gradients during melting and solidification.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal gradients will slow the cooling rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A slower cooling rate will permit more uniform elemental diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More uniform elemental diffusion will reduce compositional segregation, including segregation at grain boundaries.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder-bed preheating will produce a more uniform grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower thermal gradients will mitigate residual-stress buildup.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder-bed preheating will reduce defect formation during rapid solidification.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature processing produces higher thermal gradients associated with segregation and residual stress.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated AlCrFeNiSi samples will have greater tensile strength than the room-temperature-process control.",
