  "claims": [
    {
      "text": "Adding a grain-refining element enhances the elevated-temperature mechanical properties of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron can serve as a grain-refining addition in the proposed high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-refining addition produces a refined grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-refining addition stabilizes grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-refining element segregates to grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-refining element may promote formation of nanoscale precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting nanoscale precipitates obstruct dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary segregation and/or nanoscale precipitates impede grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstructing dislocation motion and grain-boundary sliding enhances yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstructing dislocation motion and grain-boundary sliding enhances creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will exhibit an approximately 10–20% improvement in yield strength relative to an identically processed alloy without the grain-refining addition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will exhibit an approximately 10–20% improvement in creep resistance relative to an identically processed alloy without the grain-refining addition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement applies at 700–900°C under high mechanical stress representative of extreme environments.",
