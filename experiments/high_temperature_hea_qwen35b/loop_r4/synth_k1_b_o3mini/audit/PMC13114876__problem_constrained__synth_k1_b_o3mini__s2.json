  "claims": [
    {
      "text": "The initial eutectic high-entropy alloy is multiphase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intact protective oxide layers are present at well-defined phase boundaries before exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical wear preferentially erodes protective oxide films at phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removal of the oxide films exposes fresh, unoxidized alloy surfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The freshly exposed alloy surfaces corrode more rapidly than oxide-covered surfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized corrosion further degrades and weakens the phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-weakened phase boundaries become more susceptible to additional mechanical wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reciprocal enhancement of corrosion and wear creates a positive feedback loop.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed positive feedback loop accelerates overall degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under simultaneous wear and corrosion, total degradation will be significantly greater than the sum of degradation measured in wear-only and corrosion-only tests.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear rate under simultaneous exposure will exceed the wear response under isolated mechanical wear.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosion rate under simultaneous exposure will exceed the corrosion response under isolated corrosion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism is limited to conditions in which protective oxide films are initially intact and can be disrupted mechanically.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase boundaries are critical sites of degradation in the targeted eutectic high-entropy alloys.",
