  "claims": [
    {
      "text": "Phase-selective recrystallization can improve both strength and room-temperature tensile ductility in eutectic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial eutectic high-entropy alloy has a dual-phase lamellar structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis applies under room-temperature uniaxial tensile deformation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization produces a skeletal, non-recrystallized B2 phase together with a recrystallized FCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase-selective recrystallization eliminates weak boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Eliminating weak boundaries prevents premature crack nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Both phases contribute simultaneously to strain hardening through high-density dislocation multiplication.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A strain-induced B2-to-BCT phase transformation contributes to strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The phase-selectively recrystallized alloy can attain approximately 33% uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phase-selectively recrystallized alloy can attain an engineering ultimate tensile strength approaching 2.2 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant comparison baselines are the as-cast and fully recrystallized eutectic high-entropy alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization is effective for eutectic high-entropy alloys with dual-phase lamellar structures.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strategy may not apply to other alloy classes or microstructures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanisms responsible for the strength-ductility improvement are not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis can be tested by room-temperature tensile comparison of as-cast, fully recrystallized, and phase-selectively recrystallized specimens.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::card::0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Failure of the phase-selectively recrystallized alloy to improve both strength and ductility over the controls would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
