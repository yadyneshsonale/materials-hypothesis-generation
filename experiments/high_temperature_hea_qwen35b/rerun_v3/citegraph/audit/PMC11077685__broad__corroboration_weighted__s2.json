  "claims": [
    {
      "text": "Adding a small amount of yttrium to a refractory high-entropy alloy improves its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium addition causes formation of a thin, stable surface oxide layer.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The target starting materials are refractory high-entropy alloys in an as-cast or annealed state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::W2078492700",
        "node::W2049639367"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A small yttrium addition is the proposed single alloying intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should work during oxidizing exposure in air or oxygen between 600°C and 1600°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added yttrium reacts with oxygen to form yttrium oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium oxide layer is stable under the proposed high-temperature exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium oxide layer acts as a barrier to further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Barrier-layer formation improves resistance to high-temperature corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an untreated RHEA, the yttrium-containing alloy will exhibit reduced oxidation.",
