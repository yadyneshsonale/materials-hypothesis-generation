  "claims": [
    {
      "text": "Adding a small amount of yttrium can improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed yttrium addition is 0.5–1.0 at.%.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium alloying promotes formation of a protective surface oxide layer on the RHEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective surface oxide may be yttrium oxide (Y2O3).",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen diffusion reduces the oxidation rate of the RHEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium-modified alloy is predicted to have better high-temperature oxygen resistance than the untreated RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved oxidation resistance may enhance structural integrity and service life in high-temperature applications.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect is expected during exposure to air or oxygen at 800–1200 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness of yttrium alloying may depend on the specific RHEA composition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness of yttrium alloying may depend on processing history.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness of yttrium alloying may depend on exposure conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact oxide-formation mechanism and oxide stability under varying exposure conditions are not well understood.",
      "field": "uncertainty",
