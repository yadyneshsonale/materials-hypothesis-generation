      ],
      "same_system": "no"
    },
    {
      "text": "Titanium alloying causes or promotes formation of the stable protective oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Titanium's high atomic radius increases the hardness and strength of the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_mechanisms::007::8ffb3ce334"
      ],
      "same_system": "no"
    },
    {
      "text": "Titanium alloying increases alloy wear resistance through the associated increase in hardness and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_mechanisms::007::8ffb3ce334"
      ],
      "same_system": "no"
    },
    {
      "text": "The stable oxide film shields the metallic substrate from direct mechanical contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_mechanisms::000::0b8973d716"
      ],
      "same_system": "no"
    },
    {
      "text": "Shielding by the stable oxide film reduces wear depth.",
