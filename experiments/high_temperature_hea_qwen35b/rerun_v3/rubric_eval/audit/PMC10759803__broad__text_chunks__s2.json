      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed performance range extends from room temperature to 900 °C under tensile loading.",
