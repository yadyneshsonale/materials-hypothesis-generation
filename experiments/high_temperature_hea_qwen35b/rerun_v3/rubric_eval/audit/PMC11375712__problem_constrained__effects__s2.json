  "claims": [
    {
      "text": "The initial material is a single-phase FCC FeCoNi high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing secondary phases through annealing and alloying can increase the coercive field of single-phase FCC FeCoNi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_effects::007::05f06f2e1e",
        "PMC6197204::rubric_effects::002::09b8597a09"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention partially substitutes Co with Cr.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_effects::002::09b8597a09"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention anneals the alloy at 600 °C for 15 h.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_effects::007::05f06f2e1e"
      ],
      "same_system": "no"
    },
    {
      "text": "The 600 °C anneal is performed under an argon atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention forms sigma phase at grain boundaries.",
