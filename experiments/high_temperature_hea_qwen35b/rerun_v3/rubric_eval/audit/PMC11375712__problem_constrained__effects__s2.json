      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_effects::007::05f06f2e1e"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention produces a B2 matrix containing BCC precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_effects::007::05f06f2e1e",
        "PMC6197204::rubric_effects::002::09b8597a09"
      ],
      "same_system": "no"
    },
    {
      "text": "Hierarchical phase decomposition, including sigma-phase formation, contributes to increased hardness and coercivity.",
