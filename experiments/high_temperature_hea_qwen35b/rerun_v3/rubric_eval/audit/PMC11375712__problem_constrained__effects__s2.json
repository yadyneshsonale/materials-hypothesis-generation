      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_effects::007::05f06f2e1e"
      ],
      "same_system": "no"
    },
    {
      "text": "The coercive field of the single-phase FCC FeCoNi baseline is no greater than 100 Oe.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
