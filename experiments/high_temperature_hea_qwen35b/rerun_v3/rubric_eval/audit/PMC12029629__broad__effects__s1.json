  "claims": [
    {
      "text": "Adding Cr to high-entropy alloys improves dynamic strength–ductility performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial material is HfMoTaTiZr alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is addition of 4.2 at% Cr to HfMoTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy is processed by vacuum arc melting.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant performance is evaluated at room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr addition causes formation of a Laves phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Solid-solution hardening contributes to increased strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The presence of the Laves phase contributes to increased strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "A reticulated structure improves ductility by preventing brittle failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 4.2 at% Cr produces concurrent improvement in strength and ductility relative to untreated HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The concurrent improvement applies specifically to dynamic loading performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated HfMoTaTiZr is the comparison baseline.",
      "field": "baseline",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The effect should hold for other high-entropy alloys having similar compositions and processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism and strength–ductility effect may vary with alloy composition and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultimate tensile strength, ductility, and microstructure assessed by methods such as XRD and EDS are proposed as experimental measurements.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
