  "claims": [
    {
      "text": "Applying a chromium-rich coating to a refractory high-entropy alloy can improve its high-temperature oxygen resistance relative to the untreated alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_gaps::004::df1b4b71ac",
        "PMC7513042::rubric_gaps::004::77e4732f50"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The chromium-rich coating should be effective from 800–1200°C in an oxygen-rich atmosphere for exposures up to 100 hours.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The chromium-rich coating reacts with oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reaction of the coating with oxygen forms a Cr2O3 surface layer.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Cr2O3 layer is stable at the stated high-temperature exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr2O3 can act as a protective barrier oxide.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::rubric_gaps::004::df1b4b71ac"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective Cr2O3 layer reduces oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_gaps::004::df1b4b71ac"
      ],
      "same_system": "no"
    },
    {
      "text": "The coated alloy will have a lower oxidation rate and mass gain than the untreated refractory high-entropy alloy.",
      "field": "predicted_outcome; falsification_experiment",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_gaps::004::77e4732f50"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will increase the service lifespan of the alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's effectiveness may depend on the composition of the refractory high-entropy alloy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's effectiveness may depend on exposure conditions and timescale.",
