  "claims": [
    {
      "text": "Adding Cr to high-entropy alloys improves dynamic strength–ductility performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant untreated baseline alloy is HfMoTaTiZr.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is addition of 4.2 at% Cr.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy is processed by vacuum arc melting.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant testing condition is room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 4.2 at% Cr produces a Laves phase in HfMoTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Laves phase can be identified as (Cr, Mo)2(Hf, Ti, Zr).",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Solid-solution hardening contributes to the strength increase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The presence of the Laves phase contributes to the strength increase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "A reticulated structure suppresses brittle failure and thereby improves ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to untreated HfMoTaTiZr, Cr addition concurrently improves strength and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvement should extend to high-entropy alloys with similar compositions and processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_effects::005::7202885731",
        "PMC10759803::rubric_effects::009::8ddbbedd43"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism and property effect may vary with alloy composition and processing conditions.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis can be tested by comparing ultimate tensile strength and ductility in alloys with and without Cr addition.",
      "field": "falsification_experiment.design; falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
