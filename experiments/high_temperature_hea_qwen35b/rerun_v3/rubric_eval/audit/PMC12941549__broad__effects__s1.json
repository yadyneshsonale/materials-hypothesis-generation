  "claims": [
    {
      "text": "The initial substrate is a MoNbTaTiW refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace",
        "PMC7475834::rubric_effects::010::efc231f2f8"
      ],
      "same_system": "yes"
    },
    {
      "text": "A Si-20Cr-20Fe (wt.%) coating can be prepared on the MoNbTaTiW substrate by the fused slurry method.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating forms a double-layer structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "The outer coating layer is silicon-rich and mainly consists of MSi2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "The inner coating layer has lower silicon content and mainly consists of M5Si3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "Silicidation and diffusion reactions occur at the surface of the MoNbTaTiW substrate during coating formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "The disilicide phase has the greatest stability because of its enthalpy of formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::000::9e3f4fcace"
      ],
      "same_system": "yes"
    },
    {
      "text": "The silicide coating improves the high-temperature oxidation resistance of MoNbTaTiW relative to the unmodified substrate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_effects::010::efc231f2f8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxidation-resistance benefit should hold generally in oxidizing environments at temperatures up to 1300°C.",
