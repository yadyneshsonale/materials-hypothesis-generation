  "claims": [
    {
      "text": "The initial high-entropy alloy is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled thermal processing can produce the intended grain refinement.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applicable thermal-exposure regime includes approximately 700 °C for approximately 1000 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6908586::rubric_gaps::006::c954c99ee3"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical loading is applied after thermal exposure.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain size and grain-size distribution are structural mediators of toughness retention.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::rubric_gaps::001::66526fa72a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The presence of a single-phase solid solution rather than secondary phases is a structural mediator of toughness retention.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::rubric_gaps::006::c954c99ee3"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Long thermal exposure near 700 °C can produce phase instability or secondary-phase formation in the absence of an effective intervention.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::rubric_gaps::006::c954c99ee3"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain refinement enhances solid-solution stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement reduces the driving force for phase separation and precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing phase separation and precipitation preserves toughness after thermal exposure and loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-refined alloy will retain more toughness than the same alloy without grain refinement under identical exposure and loading conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The appropriate control is the same alloy without the grain-refinement intervention, subjected to identical thermal exposure and loading.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is bounded by exposure temperature and duration and by the magnitude and type of mechanical loading.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal grain size and grain-size distribution for toughness retention are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interactions between grain refinement, precipitates, and defects may affect toughness retention.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::rubric_gaps::001::66526fa72a",
        "PMC7514651::rubric_gaps::000::6cb11278eb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis can be tested by comparing grain-refined and unrefined specimens using phase and grain characterization together with mechanical toughness testing.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
