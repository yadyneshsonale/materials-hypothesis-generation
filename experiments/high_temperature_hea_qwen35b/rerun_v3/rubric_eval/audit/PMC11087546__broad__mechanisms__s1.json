  "claims": [
    {
      "text": "Introducing a fine lamellar FCC/B2 microstructure can simultaneously increase the strength and ductility of eutectic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634",
        "PMC4145285::rubric_mechanisms::004::c8d3e6cdd4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The fine lamellar FCC/B2 microstructure can be introduced through appropriate processing techniques.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material state is an as-cast eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634",
        "PMC4145285::rubric_mechanisms::004::c8d3e6cdd4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant microstructure consists of alternating soft FCC and hard B2 phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634",
        "PMC4145285::rubric_mechanisms::004::c8d3e6cdd4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Hard B2 phases, including nanoscale precipitates, pin dislocation motion associated with deformation of the soft FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation pinning by the B2 phase produces significant work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC/B2 composite structure permits high ductility despite high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634",
        "PMC4145285::rubric_mechanisms::004::c8d3e6cdd4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior should occur under tensile loading from room temperature to 700 degrees Celsius.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634",
        "PMC4145285::rubric_mechanisms::004::c8d3e6cdd4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At room temperature, the material should exhibit ultra-high strain hardening, beginning at a proof stress of 75 MPa and reaching a fracture stress near 1.2 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The material should maintain high strength and ductility up to 700 degrees Celsius.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Single-phase FCC high-entropy alloys are ductile but not strong.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_mechanisms::000::3906a5e634"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Single-phase BCC high-entropy alloys are strong but brittle.",
      "field": "baseline",
      "needs_support": true,
