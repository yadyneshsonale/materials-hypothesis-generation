  "claims": [
    {
      "text": "The initial material is a eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "Eutectic alloy design can produce a fine lamellar microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting microstructure consists of alternating FCC and B2 lamellae.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC phase is soft and the B2 phase is hard.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The fine, regular lamellar structure readily stores dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation storage in the lamellar structure produces unprecedented strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lamellar FCC/B2 microstructure simultaneously increases strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "Strength is increased relative to conventional high-entropy alloys without eutectic alloy design.",
      "field": "predicted_outcome; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ductility is increased relative to conventional high-entropy alloys without eutectic alloy design.",
      "field": "predicted_outcome; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed strength-ductility benefit holds from room temperature through 700°C.",
