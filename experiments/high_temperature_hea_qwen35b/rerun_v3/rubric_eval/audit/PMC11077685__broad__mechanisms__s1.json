  "claims": [
    {
      "text": "Adding Cr to a refractory high-entropy alloy improves its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated alloy contains no added Cr.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cr addition promotes formation of a dense, uniform oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide film contains Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide film contains TiO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide film contains CrTaO4.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dense oxide film inhibits oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Inhibiting oxygen diffusion through the film reduces oxidation and improves oxygen resistance relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvement should occur during oxidation at 800 °C for 50 h in air.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is applicable over the temperature range 700-1000 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidation weight gain can be used to compare the Cr-added and untreated alloys.",
