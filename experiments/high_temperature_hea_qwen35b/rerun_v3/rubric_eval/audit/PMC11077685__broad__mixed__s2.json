  "claims": [
    {
      "text": "WVTaTi is a refractory high-entropy alloy system.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Cr to refractory high-entropy alloys improves high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding Cr to the WVTaTi system produces a dense, uniform oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-modified oxide film contains Cr2O3, TiO2, and CrTaO4.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dense protective oxide layer inhibits oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Inhibiting oxygen diffusion through the oxide layer reduces oxidation and improves oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-added WVTaTi material should have better oxidation resistance than WVTaTi without Cr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed improvement applies during oxidation at 800 °C in air for 50 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of CrTaO4 and Cr2O3 is required for the proposed improvement in oxidation resistance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_mechanisms::003::feb3501d0c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The roles of the other alloying elements in the oxidation response are not fully understood.",
