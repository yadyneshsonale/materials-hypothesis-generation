  "claims": [
    {
      "text": "Introducing coherent nanoprecipitates into high-entropy alloys can improve resistance to thermally induced toughness loss.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial high-entropy alloy has a single-phase solid-solution microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stepwise controllable coherent nanoprecipitations introduce coherent nanoprecipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed effect applies at ambient temperature and elevated temperatures up to 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism operates during tensile deformation up to 14% strain.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitate interfaces are the structural mediator.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitate interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitate interfaces relieve stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An otherwise comparable high-entropy alloy without coherent nanoprecipitates is the baseline.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism may cease to hold beyond the stated temperature and strain ranges.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact effective temperature and strain ranges are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interactions with other microstructural features may affect the mechanism.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis can be tested by tensile testing and microstructural analysis of otherwise comparable alloys with and without coherent nanoprecipitates.",
