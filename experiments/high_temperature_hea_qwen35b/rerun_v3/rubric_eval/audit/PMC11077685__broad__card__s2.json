  "claims": [
    {
      "text": "Adding Al2O3 reinforcement particles can improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is the addition of Al2O3 reinforcement particles to an RHEA.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 reinforcement particles can be incorporated into an NbMoCrTiAl RHEA matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Al2O3 reinforcement particles causes formation of a protective Al2O3 oxide layer on the RHEA surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A surface Al2O3 layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion reduces oxidation of the RHEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3-reinforced RHEA will oxidize less than an untreated RHEA without Al2O3 particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should occur between 500°C and 1000°C in an oxygen-rich atmosphere.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should occur under either static or dynamic exposure conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The cited composite contains 7.0 vol.% Al2O3 particles in an NbMoCrTiAl-based matrix.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
