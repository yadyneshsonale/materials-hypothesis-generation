  "claims": [
    {
      "text": "Increasing Cr concentration in a magnetic high-entropy alloy will increase its coercive field.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
