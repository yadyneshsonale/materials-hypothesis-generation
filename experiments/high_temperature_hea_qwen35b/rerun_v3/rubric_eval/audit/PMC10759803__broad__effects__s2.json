  "claims": [
    {
      "text": "The proposed starting material is an as-cast or annealed high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC6427779::rubric_effects::003::833614c840",
        "PMC7514651::rubric_effects::001::6409024d32"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Refractory elements such as Mo, Nb, or W can be added to a high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::rubric_effects::001::6409024d32"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding Mo, Nb, or W improves the high-temperature mechanical capability of a high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should hold above 800 °C under loading relevant to jet-turbine applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory-element addition forms a stable solid-solution alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory-element addition refines the alloy microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427779::rubric_effects::003::833614c840"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mo, Nb, or W additions slow atomic diffusion in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower atomic diffusion reduces the formation of detrimental phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced formation of detrimental phases improves high-temperature stability and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to high-entropy alloys without refractory-element additions, the modified alloy will have greater high-temperature strength and resistance to deformation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory-element addition will maintain a relatively low alloy density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory-element addition will preserve room-temperature mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional high-entropy alloys without refractory-element additions constitute the proposed baseline.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis applies only within a specific composition range and under specific processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanism by which refractory additions affect high-temperature mechanical capability is not fully understood.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
