      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 4.2 at% Cr increases room-temperature Vickers hardness relative to HfMoTaTiZr.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 4.2 at% Cr increases room-temperature yield strength relative to HfMoTaTiZr.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hardness and strength improvements occur without sacrificing ductility.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
