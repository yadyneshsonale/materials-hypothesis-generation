      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_mechanisms::007::ae8766d1ff"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial material is equiatomic HfNbTaTiZr in the cast state.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr addition is the proposed intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is intended to operate during exposure in air at temperatures up to 1000 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_mechanisms::007::ae8766d1ff"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr addition to HfNbTaTiZr will produce Cr-rich oxide layers during high-temperature exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_mechanisms::007::ae8766d1ff"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr-rich oxide layers act as a protective barrier against further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_mechanisms::007::ae8766d1ff"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide barrier will reduce oxidation-induced degradation of the alloy's mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-added HfNbTaTiZr will have better oxidation resistance than untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_mechanisms::007::ae8766d1ff"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr-added HfNbTaTiZr will maintain its yield strength relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-added HfNbTaTiZr will maintain its ductility relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline is cast HfNbTaTiZr without Cr addition.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed exposure duration is several hours.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
