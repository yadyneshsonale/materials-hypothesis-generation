      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed simultaneous strength-and-ductility improvement should persist at elevated temperatures up to 700 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "unclear"
    },
    {
