      "support": "partial",
      "supporting_ids": [
        "PMC8510135::chunk::000::abstract::3437e8a43f"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon addition through powder metallurgy will improve the hardness of CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition through powder metallurgy will improve the mechanical performance of CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon modification will preserve the favorable plasticity of CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon modification will preserve the favorable machinability of CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
