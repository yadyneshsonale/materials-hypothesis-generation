{
  "run_id": "PMC11077685__broad__text_systemmatch__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Applying a silicide coating can improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is applicable to refractory high-entropy alloys in either an as-cast or processed state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Si-20Cr-20Fe silicide coating can be prepared on a MoNbTaTiW refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating should provide oxidation protection at approximately 1000°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating should provide oxidation protection in air or an oxygen-rich atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silicide coating acts as a barrier to oxygen diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silicide coating prevents oxidation of the underlying alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "During high-temperature oxidation, the silicide coating develops an outer oxide layer over an inner silicide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide layer formed on the coating is stable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide layer reduces oxygen permeability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon diffuses from the coating into the MoNbTaTiW substrate during oxidation, while the inner silicide layer grows inward.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to an untreated alloy, the coated alloy will exhibit reduced oxidation-related mass gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an untreated alloy, the coated alloy will retain or improve its mechanical properties after oxidation exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection should operate throughout the range from 800°C to 1200°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection should persist for exposures lasting several hours to days.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coating effectiveness may depend on alloy composition, coating thickness, and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
