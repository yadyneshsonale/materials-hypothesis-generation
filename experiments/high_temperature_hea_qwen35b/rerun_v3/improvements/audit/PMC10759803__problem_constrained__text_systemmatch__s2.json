      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention is to substitute part of the heavier-element content, exemplified by Ta, with lighter refractory elements such as Ti or Zr.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing high-density refractory elements with lower-density elements can lower the density of refractory high-entropy alloys.",
