      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed substitution will lower the density of HfMoTaTiZr.",
