      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The tested strain rates are relevant to structural applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should yield higher strength and ductility than conventional HEAs lacking a controlled eutectic composition and microstructure.",
