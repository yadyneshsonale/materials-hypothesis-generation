      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC lamellae are mechanically soft and the B2 lamellae are mechanically hard.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The fine, regular lamellar structure readily stores dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hard B2 lamellae pin dislocations moving through the soft FCC phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B2 phase is NiAl-rich.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation storage and pinning by the lamellar phases produce unusually high strain hardening and balanced strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior should hold at room temperature and at elevated temperatures up to 700°C.",
