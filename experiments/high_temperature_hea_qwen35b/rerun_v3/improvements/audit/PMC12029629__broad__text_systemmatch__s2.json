        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is applicable to HEAs in as-cast or wrought states.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stepwise controllable coherent nanoprecipitation is a process for introducing coherent nanoprecipitations.",
      "field": "intervention",
