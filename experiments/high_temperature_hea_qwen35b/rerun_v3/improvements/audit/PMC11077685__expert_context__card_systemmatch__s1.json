  "claims": [
    {
      "text": "The starting material is cast equiatomic HfNbTaTiZr.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 1–2 wt% Y2O3 to equiatomic HfNbTaTiZr will improve its oxygen resistance.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Y2O3 addition will form a Y2O3-based protective surface layer.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Y2O3 can react with oxygen to form a stable oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed surface oxide layer will reduce oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reactive-element effects provide a basis for the proposed oxidation-protection mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is expected to reduce the oxidation rate relative to untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may increase high-temperature strength and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection applies in air at 800–1000 °C for exposures of 5–10 hours without external loading.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact Y2O3 amount, optimal processing route, and effects on room- and elevated-temperature mechanical properties remain uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison at 900 °C in air for 5 hours can test the intervention by measuring oxidation rate, high-temperature strength, and microstructure.",
      "field": "falsification_experiment.design; falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the treated sample to show significant improvements in both oxidation rate and high-temperature strength relative to the untreated control would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
