  "claims": [
    {
      "text": "Adding a minor amount of zirconia or titania to multielement solid-solution nanoparticles will enhance their thermal stability at 773–1173 K.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial nanoparticles contain at least five metals in near-equiatomic proportions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6926650::chunk::001::introduction::7652f5f579"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial nanoparticles are crystalline solid solutions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6926650::chunk::001::introduction::7652f5f579"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Zirconia and titania are refractory metal oxides suitable for the proposed intervention.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added oxide will form a stabilizing shell or decorate the nanoparticle surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide shell or surface decoration will reduce surface diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced surface diffusion will prevent or suppress particle coarsening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide dopant will reduce nanoparticle surface energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower surface energy will reduce the driving force for Ostwald ripening and coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-treated nanoparticles will coarsen less than untreated nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-treated nanoparticles will retain better catalytic performance than untreated nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated nanoparticles will undergo significant coarsening at 773–1173 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated nanoparticles will suffer catalytic-performance degradation at 773–1173 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will be effective for compositions containing at least five metals.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will be effective when total noble-metal content is below 50%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention can be evaluated in high-temperature water-gas shift or methanol steam-reforming catalysis.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal oxide identity and loading, and their effects on catalytic activity and selectivity, are unknown.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
