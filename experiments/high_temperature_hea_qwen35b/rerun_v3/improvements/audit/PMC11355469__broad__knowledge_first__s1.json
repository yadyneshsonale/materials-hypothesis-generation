      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium oxide nanoparticles will be dispersed within the high-entropy-alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed yttrium oxide nanoparticles will act as pinning points for dislocations.",
