  "claims": [
    {
      "text": "The starting material is equiatomic HfNbTaTiZr in the cast state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A thin, continuous, and adherent Al2O3 surface coating can be applied to HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 coating will improve oxidation resistance at 1000 °C in air for exposures up to 100 hours.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 coating will not compromise the alloy's useful mechanical performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 coating acts as a barrier to oxygen diffusion into HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Blocking oxygen diffusion prevents the formation of harmful oxides in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing harmful oxidation reduces oxidation-induced mechanical degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
