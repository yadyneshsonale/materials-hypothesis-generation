      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified eutectic high-entropy alloy is expected to exhibit ultrahigh strength and good tensile ductility.",
