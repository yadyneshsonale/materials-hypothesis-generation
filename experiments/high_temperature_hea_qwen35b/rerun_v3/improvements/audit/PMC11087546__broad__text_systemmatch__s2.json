      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled heat treatment or processing can introduce coherent nanoprecipitations.",
