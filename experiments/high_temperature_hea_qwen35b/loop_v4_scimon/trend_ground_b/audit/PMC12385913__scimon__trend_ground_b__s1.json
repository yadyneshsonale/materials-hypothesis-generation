  "claims": [
    {
      "text": "Refractory high-entropy alloys can be used as structural materials for high-temperature plasma-facing components in fusion reactors.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd",
