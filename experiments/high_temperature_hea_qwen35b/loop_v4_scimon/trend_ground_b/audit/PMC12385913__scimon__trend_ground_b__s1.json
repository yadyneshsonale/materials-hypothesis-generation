        "PMC7513042::chunk::001::introduction::f13797f6f6",
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Refractory high-entropy alloys containing or modified with Cr, Ti, and Hf are low-activation materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Cr, Ti, and Hf to refractory high-entropy alloys enhances their irradiation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding refractory elements such as Cr, Ti, and Hf to HEAs can provide elevated-temperature strength, hardness, thermal stability, and softening resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "yes"
    },
    {
      "text": "Refractory high-entropy alloys possess high-temperature mechanical properties relevant to structural applications.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6",
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-entropy alloys can exhibit irradiation resistance or irradiation-induced phase stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant refractory high-entropy alloys are polycrystalline.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fusion plasma-facing materials operate under high temperature, particle and neutron irradiation, heat flux, and mechanical demands.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd",
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Microstructural evolution mediates the relationship between Cr, Ti, and Hf additions and the performance of refractory high-entropy alloys.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimizing refractory-HEA composition with Cr, Ti, and Hf improves low-activation performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimizing refractory-HEA composition with refractory alloying elements can improve high-temperature resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "yes"
    },
    {
      "text": "Traditional alloys have inadequate irradiation resistance for the proposed fusion application.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd",
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "unclear"
    },
    {
