      ],
      "same_system": "yes"
    },
    {
      "text": "The SPS-fabricated AlCoCrFeNiTi0.5 alloy has a dense microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy has a multiphase microstructure comprising dual BCC phases and minor intermetallics.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "AlCoCrFeNiTi0.5 can be subjected to reciprocating wear testing at 800–900 °C.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant reciprocating tests are conducted in a corrosive medium.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A NaCl-containing atmosphere is an applicable test environment for this alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature tribo-corrosion causes the alloy to form an in situ protective oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale is most likely a spinel-type oxide.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide scale adheres to the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tribo-oxidation at elevated temperature produces a dense oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dense oxide film acts as a barrier to mechanical wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dense oxide film inhibits penetration by corrosive ions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear depth decreases distinctly at 800 °C, and wear resistance is highest at 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy has lower wear depth than conventional alloys or as-cast HEAs under the same conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy has lower corrosion current or corrosion rate than conventional alloys or as-cast HEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
