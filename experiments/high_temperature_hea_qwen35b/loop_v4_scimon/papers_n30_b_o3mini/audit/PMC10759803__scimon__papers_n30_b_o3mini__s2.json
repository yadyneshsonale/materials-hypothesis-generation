  "claims": [
    {
      "text": "The base Ta0.5Nb0.5HfZrTi alloy is a disordered BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped Ta0.5Nb0.5HfZrTi alloy has a yield strength of approximately 810 MPa.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped Ta0.5Nb0.5HfZrTi alloy has an elongation of approximately 10.8%.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen or nitrogen can be introduced into the Ta0.5Nb0.5HfZrTi alloy through arc melting under a controlled atmosphere.",
      "field": "intervention; conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Multiple remelts can be used when processing oxygen- or nitrogen-doped Ta0.5Nb0.5HfZrTi alloys.",
      "field": "intervention; conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "A subsequent controlled heat treatment facilitates diffusion and ordering of the interstitial atoms.",
      "field": "intervention; conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding controlled oxygen or nitrogen promotes formation of ordered interstitial complexes in the BCC matrix.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ordered interstitial complexes impede dislocation motion.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ordered interstitial complexes promote beneficial strain hardening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial oxygen or nitrogen contributes to solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial atoms form ordered arrangements around substitutional atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ordered arrangements strengthen the alloy without causing excessive brittleness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen or nitrogen doping concurrently improves yield strength and ductility relative to the undoped alloy.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial doping can increase yield strength by approximately 200 MPa or more relative to the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial doping can increase elongation by several percentage points relative to the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical properties depend on whether oxygen or nitrogen is used as the interstitial dopant.",
      "field": "predicted_outcome; uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The beneficial effect exists only within an optimal range of interstitial content.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive interstitial doping may cause over-precipitation or embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Too little interstitial doping may fail to generate enough ordered interstitial complexes.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative strength and ductility changes depend on interstitial concentration, processing parameters, and alloy composition.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
