  "claims": [
    {
      "text": "Laser cladding can deposit a WVTaTiCr refractory high-entropy-alloy coating onto stainless steel.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr1 variant has the nominal composition WVTaTiCr with x = 1.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Unmodified stainless steel has only moderate corrosion resistance because its native oxide formation is non-ideal.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WVTaTiCr coatings can be produced by laser cladding using controlled laser power, scanning speed, and a protective atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Corrosion of laser-clad WVTaTiCr coatings can be tested in 3.5 wt% NaCl solution.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed Cr-containing coating develops a refined, fine-grained BCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr is homogeneously distributed within the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The homogeneous Cr distribution promotes continuous protective oxides such as Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Laves phases may form and retard crack propagation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr addition alters the coating surface chemistry during laser cladding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr addition enhances passive-film formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting passive film reduces ionic diffusivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser-clad WVTaTiCr with tailored Cr content improves the corrosion resistance of stainless steel through passive-film formation and microstructure refinement.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating shifts corrosion potential in the positive direction relative to unmodified stainless steel.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosion potential is expected to shift from approximately -0.78 V to approximately -0.32 V.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating is expected to reduce corrosion rate by more than one order of magnitude relative to uncoated stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified stainless steel has a higher corrosion rate and more negative corrosion potential in chloride environments because its native oxide is less protective.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvement applies under room-temperature, static 3.5 wt% NaCl exposure.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "no"
    },
    {
      "text": "Performance may differ under cyclic exposure, elevated temperature, or changes in coating composition and processing parameters.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term stability under cyclic stress, elevated temperature, and mechanical loading, as well as the optimum Cr content and processing conditions, remains unverified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
