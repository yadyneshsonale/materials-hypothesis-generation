      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Subsequent processing and heat treatment permit interstitial atoms to order within a distorted BCC matrix.",
