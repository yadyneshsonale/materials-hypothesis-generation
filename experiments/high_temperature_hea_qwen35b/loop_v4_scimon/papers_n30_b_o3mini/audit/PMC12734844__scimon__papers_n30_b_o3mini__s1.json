      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A temperature of 900–1000 °C is lower than the typical sintering temperature for the relevant conventional powders.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying produces a nanocrystalline grain structure with a high density of grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::rubric_card::000::346288b48f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The increased grain-boundary density enhances grain-boundary diffusion during sintering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced grain-boundary diffusion reduces the effective activation energy required for densification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced activation energy for densification enables SPS at lower temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanically alloyed nanocrystalline powders will densify at lower SPS temperatures than conventional coarse powders.",
