      ],
      "same_system": "yes"
    },
    {
      "text": "SPS enhances phase stability in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6926650::rubric_card::000::747f75bd64"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS refines the microstructure of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS improves the mechanical properties of high-entropy alloys relative to conventionally processed material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid heating and short dwell times are responsible for the phase, microstructure, and mechanical-property benefits attributed to SPS.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional processing of elemental or pre-alloyed high-entropy alloy powders typically produces coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional processing of these powders typically produces mixed or metastable phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS can process high-entropy alloy powders using a high heating rate, applied pressure, and a dwell time of minutes.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5978046::rubric_card::000::c87a8ff254",
