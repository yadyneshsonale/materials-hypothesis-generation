      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS will increase hardness and yield strength relative to slower conventional processing.",
      "field": "predicted_outcome",
      "needs_support": true,
