  "claims": [
    {
      "text": "The baseline HfMoTaTiZr alloy is a homogeneous single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline HfMoTaTiZr alloy has a room-temperature yield strength of approximately 1543 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline HfMoTaTiZr alloy has a fracture strain of approximately 11.6%.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline HfMoTaTiZr alloy has relatively high density.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 4 at% Cr can be incorporated into the HfMoTaTiZr alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-modified composition has increased Ti and Zr fractions relative to the baseline.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alloy can be synthesized by vacuum arc melting followed by homogenization.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding about 4.2 at% Cr causes a Laves phase to form in addition to the BCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-induced Laves phase is fine, dispersed, and reticulated within a continuous BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr substitution increases lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr drives limited phase separation and nucleation of the Laves phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Laves phase impedes dislocation motion and thereby increases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reticulated Laves-phase network deflects cracks and thereby improves ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing the Ti and Zr fractions reduces the alloy's overall density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-modified alloy has roughly 200 MPa greater yield strength than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-modified alloy has about 20% greater ductility than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-modified alloy has 3–5% lower density than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reported comparison is applicable to room-temperature compressive loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The mechanical effects may differ at elevated temperatures.",
      "field": "boundary",
      "needs_support": true,
