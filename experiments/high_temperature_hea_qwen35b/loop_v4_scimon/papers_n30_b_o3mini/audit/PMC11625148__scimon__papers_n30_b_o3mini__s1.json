      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Finely dispersed B2 precipitates provide precipitation strengthening without impeding plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combining a disordered BCC matrix with nanoscale B2 precipitates produces a balance of strength and ductility.",
