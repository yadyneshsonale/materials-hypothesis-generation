      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous ordered B2 matrix is brittle and is responsible for the low baseline fracture strain.",
