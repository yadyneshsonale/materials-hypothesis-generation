      ],
      "same_system": "yes"
    },
    {
      "text": "Friction-processed samples exhibit lower cumulative mass gain than the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Friction-processed samples exhibit lower parabolic oxidation rate constants than the as-cast alloy.",
