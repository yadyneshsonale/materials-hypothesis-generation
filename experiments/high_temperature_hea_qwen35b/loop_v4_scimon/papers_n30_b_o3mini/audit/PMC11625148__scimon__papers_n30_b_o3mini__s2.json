  "claims": [
    {
      "text": "Al0.5NbTa0.8Ti1.5V0.2Zr is a refractory high-entropy alloy system.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The homogenized baseline alloy has a continuous ordered B2 matrix containing discrete BCC precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast alloy also has the stated continuous-B2/discrete-BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous-B2 baseline exhibits very low room-temperature compressive ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "A high-temperature solution treatment followed by moderate-temperature annealing and water quenching can produce an inverted microstructure in this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The inverted microstructure consists of a continuous disordered BCC matrix with discrete B2 precipitates approximately 50 nm in size.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous disordered BCC matrix facilitates dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Discrete B2 precipitates provide precipitation strengthening without impeding ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing a continuous brittle B2 phase with discrete B2 precipitates in a BCC matrix improves ductility while retaining acceptable yield strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous ordered B2 phase limits plastic deformation because it is brittle.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous-B2 baseline has a compressive fracture strain of approximately 4.7%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous-B2 baseline has a yield strength of approximately 2032 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The inverted-microstructure condition has a yield strength of approximately 1345 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The inverted-microstructure condition can reach approximately 38% compressive fracture strain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant mechanical test is room-temperature uniaxial compression under a controlled strain rate.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
