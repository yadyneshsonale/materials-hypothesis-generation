      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Variations in composition, processing, or testing conditions may alter the magnitude of the ductility improvement.",
      "field": "boundary",
