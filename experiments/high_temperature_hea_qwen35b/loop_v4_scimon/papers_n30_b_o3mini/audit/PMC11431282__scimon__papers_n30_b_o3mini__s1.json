  "claims": [
    {
      "text": "The initial FeCoNiTi alloy is an as-cast polycrystalline material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial FeCoNiTi alloy contains an fcc phase and minor secondary phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fine-tuning Ti content and processing can produce a dominant fcc phase in FeCoNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing can establish controlled chemical short-range order in FeCoNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti atoms in FeCoNiTi tend to couple antiferromagnetically with Fe, Co, and Ni.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-induced antiferromagnetic coupling lowers the saturation magnetization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-induced antiferromagnetic coupling increases magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased magnetocrystalline anisotropy accounts for or is correlated with the high coercive field of the fcc phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tuning the proposed magnetic interactions can shift or sharpen the alloy's multiple ferromagnetic transitions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Shifting or sharpening those transitions will increase the magnetic entropy change.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An optimized fcc-dominant FeCoNiTi alloy will have a larger magnetic entropy change than the baseline alloy near at least one magnetic transition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast FeCoNiTi exhibits ferromagnetic transitions at approximately 1084 K, 214 K, and 168 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The fcc phase is responsible for the transitions at approximately 1084 K and 168 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The C14 Laves phase is responsible for the transition at approximately 214 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coercive field of the fcc phase is approximately 489 Oe at 300 K and 667 Oe at 400 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11375712::rubric_card::000::e3a2069f7c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy has a typical saturation magnetization.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetocaloric enhancement requires a high fraction of the fcc phase.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti must be kept within a concentration window that promotes antiferromagnetic interactions without excessive phase instability or loss of ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative relationship between Ti adjustment, fcc-phase fraction, and magnetic entropy change has not yet been established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A greater than 10% increase in magnetic entropy change near at least one transition is the proposed criterion for a successful enhancement.",
