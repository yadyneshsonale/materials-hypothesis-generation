      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnitude of strength and ductility improvement depends on alloy composition and processing details.",
      "field": "uncertainty",
