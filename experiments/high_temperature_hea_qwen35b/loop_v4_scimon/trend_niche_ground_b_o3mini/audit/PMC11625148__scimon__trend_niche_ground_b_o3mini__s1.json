  "claims": [
    {
      "text": "High-purity aluminum has an FCC structure under the proposed room-temperature conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-purity FCC aluminum exhibits a standard level of room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–3 wt% copper or magnesium to high-purity aluminum can adjust its stacking-fault energy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor copper or magnesium additions will enhance the ductility of high-purity aluminum.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault energy influences the activation of stacking faults and related deformation modes in FCC alloys.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing or optimizing stacking-fault energy in aluminum enhances dislocation nucleation and motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tuning stacking-fault energy in alloyed aluminum enables activation of additional slip systems.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Activation of multiple deformation mechanisms can contribute to increased tensile ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed copper- or magnesium-alloyed aluminum will have greater elongation to failure than unmodified high-purity aluminum.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminum alloys will retain an FCC structure after addition of 1–3 wt% copper or magnesium.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature can alter stacking-fault energy and the activity of stacking faults or nanotwins.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed ductility benefit in alloyed aluminum may differ at high temperatures or dynamic deformation rates.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "The optimal alloying level and the exact effect of copper or magnesium on aluminum's stacking-fault energy are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A statistically significant increase in elongation relative to a 0 wt% control is a measurable test of the predicted ductility improvement.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
