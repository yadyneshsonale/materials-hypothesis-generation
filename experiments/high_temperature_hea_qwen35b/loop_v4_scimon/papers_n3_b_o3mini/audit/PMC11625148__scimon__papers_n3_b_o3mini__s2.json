      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxygen is added during arc-melting to produce an O-2 alloy with nominal composition (Ta0.5Nb0.5HfZrTi)98O2.",
