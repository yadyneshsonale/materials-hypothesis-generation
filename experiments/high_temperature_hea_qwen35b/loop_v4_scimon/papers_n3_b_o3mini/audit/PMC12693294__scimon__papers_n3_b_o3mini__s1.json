  "claims": [
    {
      "text": "Controlled isothermal aging can direct phase evolution in AlCoCrFeNi2.1 by changing chemical ordering and precipitate morphology.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "Temperature-controlled aging can switch AlCoCrFeNi2.1 between embrittled and ductile mechanical responses.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial AlCoCrFeNi2.1 alloy contains FCC and ordered B2 phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 can be aged isothermally at approximately 600 °C or 750 °C and then rapidly quenched.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reported aging schedule used vacuum, a heating rate of 300 °C/h, a 20-hour hold, and rapid water quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "The 20-hour aging treatment permits diffusion-controlled phase transformations.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The formation and evolution of ordered L1₂ domains mediate the brittle-to-ductile transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changes in phase-boundary character and the presence or absence of Cr-rich particles mediate the mechanical transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at approximately 600 °C produces nearly stoichiometric Ni₃Al-like L1₂ domains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "The L1₂ domains formed at approximately 600 °C are perfectly ordered and have high antiphase-boundary energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging at approximately 600 °C creates jagged, low-coherency phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 600 °C microstructure promotes planar slip, which causes embrittlement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging at approximately 750 °C forms larger, off-stoichiometric L1₂ domains with lower ordering strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at approximately 750 °C dissolves Cr-rich particles at phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 750 °C microstructure enables cross-slip and more uniform deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing the aging temperature produces measurable changes in precipitate size, ordering, and coherency.",
