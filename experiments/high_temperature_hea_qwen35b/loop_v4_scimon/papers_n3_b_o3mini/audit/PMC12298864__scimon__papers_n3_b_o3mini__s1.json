  "claims": [
    {
      "text": "Integrating high-throughput computational screening with controlled melting and heat treatment can promote phase stability, microstructure refinement, and property optimization in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimization operates by guiding the formation of beneficial nanoscale precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The candidate material is an Al–Cr–Fe–Mn–Ti quinary high-entropy alloy produced by arc melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-throughput computational screening can identify promising compositions in the Al–Cr–Fe–Mn–Ti system.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The selected alloys can be processed by repeated arc melting, drop casting, high-temperature homogenization, and controlled annealing.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Multiple remelts are used to improve alloy homogeneity.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relevant processing includes homogenization at approximately 1200 °C followed by annealing near 700 °C for a short duration.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "A promising composition range has Al below 25 at.% and Mn above 15 at.%.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized microstructure contains nanoscale L21 precipitates within a BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slight composition deviations can produce ordered antiphase domains instead of L21 precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Computationally guided composition selection promotes formation of the ordered L21 phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The L21 phase is thermodynamically stable and load bearing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "L21 precipitation strengthens the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Load-transfer effects from the L21 precipitates are responsible for the strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
