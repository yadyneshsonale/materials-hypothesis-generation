      ],
      "same_system": "no"
    },
    {
      "text": "SPS of the mechanically alloyed RHEA-Cu mixture enables a large-scale reactive process.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS overcomes the positive heat-of-mixing barrier between Cu and refractory elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
