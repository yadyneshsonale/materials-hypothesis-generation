      ],
      "same_system": "no"
    },
    {
      "text": "Intermetallic reinforcing compounds may form during SPS of the proposed RHEA-Cu mixture.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in-situ reinforcing phases stabilize the interface between Cu and the refractory matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
