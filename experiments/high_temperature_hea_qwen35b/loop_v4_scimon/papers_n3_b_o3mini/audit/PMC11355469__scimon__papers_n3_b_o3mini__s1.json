        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "yes"
    },
    {
      "text": "HEA-coated copper will have lower wear depth than bare copper at both ambient and elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HEA-coated copper will have a lower coefficient of friction than bare copper at both ambient and elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
