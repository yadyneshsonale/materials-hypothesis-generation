      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applying an AlCoCrFeNiTi0.5 HEA coating to copper will enhance the substrate's wear resistance and surface protection.",
