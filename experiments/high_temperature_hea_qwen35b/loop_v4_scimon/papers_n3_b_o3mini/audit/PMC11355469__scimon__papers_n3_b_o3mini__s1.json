      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed SPS-based process will produce a well-adhered HEA coating on copper.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dense, high-hardness HEA layer reduces substrate wear by resisting abrasion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
