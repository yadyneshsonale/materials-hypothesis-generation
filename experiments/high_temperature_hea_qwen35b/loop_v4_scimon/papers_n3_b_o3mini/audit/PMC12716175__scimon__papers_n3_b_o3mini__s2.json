      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed RHEA-Cu composite has improved mechanical properties relative to a conventionally cast material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
