  "claims": [
    {
      "text": "High-energy mechanical alloying followed by spark plasma sintering can enable a large-scale reaction between refractory alloying elements and Cu.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed route produces a stable, homogeneous RHEA-Cu composite microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material consists of powder mixtures containing refractory high-entropy-alloy elements and Cu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Positive refractory-element/Cu mixing enthalpy normally induces segregation or phase separation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-energy ball milling induces extensive mixing and promotes local reactions.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Ball milling followed by SPS provides rapid consolidation under elevated temperature and pressure.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Suitable processing conditions include ball milling at high rotational speed for several tens of hours and SPS near 1700 °C under about 30 MPa.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "The processing should be performed under a controlled inert atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short SPS durations limit undesirable diffusion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ball milling and SPS form in situ reinforcement phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Intimate intermixing of refractory and Cu phases prevents segregation driven by positive mixing enthalpy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid reaction kinetics and localized high temperatures during SPS overcome repulsive refractory-element/Cu mixing enthalpy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying followed by SPS creates a fine, stable dispersion of phases.",
