  "claims": [
    {
      "text": "AlCoCrFeNi2.1 eutectic high-entropy alloy will have superior combined high-temperature corrosion and wear resistance relative to conventional alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 is a dual-phase eutectic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast alloy has a lamellar FCC and B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC phase acts as a corrosion barrier.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B2 phase of AlCoCrFeNi2.1 is susceptible to selective dissolution in molten chloride salt.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relevant exposure conditions include molten NaCl-KCl-MgCl2 at approximately 450°C to 650°C.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 has been evaluated under combined molten-salt corrosion and mechanical sliding conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dual-phase microstructure produces micro-galvanic coupling between its phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "Exposure forms a protective, noble-element-enriched surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Micro-galvanic coupling contributes to selective dissolution of the B2 phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "Selective B2 dissolution and galvanic coupling enrich oxidation-resistant elements in the FCC matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enriched protective surface reduces chemical corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enriched protective surface reduces mechanical material removal during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "AlCoCrFeNi2.1 has a lower molten-salt corrosion rate than duplex stainless steel 2205 at both 450°C and 650°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 will have a lower combined corrosion-and-wear degradation rate than DS2205.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined tribo-corrosion degradation rate will be reduced by approximately 50% or more relative to DS2205.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "Duplex stainless steel 2205 is an appropriate conventional-alloy comparison under these molten-salt temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The expected benefit is bounded to approximately 450°C to 650°C and similar molten chloride environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy's behavior under dynamic sliding-wear conditions is less well quantified than its molten-salt corrosion behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    }
