    {
      "text": "Thermal stability and irradiation resistance allow the interlayer to mediate stress caused by thermal-expansion mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
