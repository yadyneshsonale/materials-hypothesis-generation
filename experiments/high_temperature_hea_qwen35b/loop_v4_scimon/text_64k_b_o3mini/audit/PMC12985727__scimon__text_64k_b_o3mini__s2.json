      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A W-Ta-Cr-V-Hf interlayer will form a graded or otherwise compatible bonding zone between W and CuCrZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed refractory-HEA interlayer can possess a nanocrystalline or fine-grained microstructure.",
      "field": "structural_mediator",
