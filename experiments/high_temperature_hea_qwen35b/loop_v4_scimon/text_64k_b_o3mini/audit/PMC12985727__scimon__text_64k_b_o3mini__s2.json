      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The interlayer microstructure bridges lattice differences between W and CuCrZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
