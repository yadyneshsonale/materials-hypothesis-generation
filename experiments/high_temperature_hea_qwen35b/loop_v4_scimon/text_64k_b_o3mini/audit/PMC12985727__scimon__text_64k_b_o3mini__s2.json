      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed refractory-HEA interlayer has excellent resistance to irradiation damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "unclear"
