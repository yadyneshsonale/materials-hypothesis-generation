      ],
      "same_system": "yes"
    },
    {
      "text": "In situ high-temperature X-ray diffraction is effective for studying high-temperature phase stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrMnFeCoNi can have a well-defined single-phase FCC initial state in the as-cast or homogenized condition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy can be exposed to high temperature in air or a controlled atmosphere while time-resolved XRD data are collected in situ.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The thermodynamically predicted single-phase FCC stability range of CrMnFeCoNi is approximately 750–1320 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of oxidation products is a structural mediator observable during high-temperature exposure.",
