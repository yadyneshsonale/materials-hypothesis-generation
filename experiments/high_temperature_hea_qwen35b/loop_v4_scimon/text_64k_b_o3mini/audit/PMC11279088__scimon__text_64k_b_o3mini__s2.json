  "claims": [
    {
      "text": "In situ high-temperature X-ray diffraction is effective for studying the oxidation behavior of high-entropy alloys at elevated temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
