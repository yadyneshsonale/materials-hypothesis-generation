  "claims": [
    {
      "text": "Stepwise controllable coherent nanoprecipitations can overcome the strength–ductility trade-off in tungsten-based refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent interfaces formed by SCCPs aid dislocation transmission.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent interfaces formed by SCCPs mitigate local stress concentrations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial tungsten-based refractory high-entropy alloys are processed by conventional single-principal-element methods.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These conventionally processed alloys have high strength but low ductility because of brittle phase formation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled, stepwise thermal-mechanical treatment induces coherent nanoprecipitations in the alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Strength and ductility are assessed at room temperature and at elevated temperatures up to 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "SCCPs form coherent nanoprecipitate lamellae with coherent δ/γ phase interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocations shear through δ lamellae and transmit across coherent δ/γ boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "γ″ particles pin dislocations and thereby contribute to reinforcement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Shearing of coherent lamellae accommodates large local strain rather than producing a crack.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCP alloy can attain strength above 2 GPa together with tensile ductility above 10% at ambient temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The simultaneous strength and ductility are improved relative to conventional processing routes.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Traditional processing or alloying routes generally trade increased strength for reduced ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SCCP effect has been demonstrated in a tungsten-based refractory high-entropy alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
