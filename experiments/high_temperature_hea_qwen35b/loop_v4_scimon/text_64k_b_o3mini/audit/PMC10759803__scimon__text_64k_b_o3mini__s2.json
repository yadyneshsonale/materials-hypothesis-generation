      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocations sequentially shear or cut the coherent δ lamellae as strain increases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
