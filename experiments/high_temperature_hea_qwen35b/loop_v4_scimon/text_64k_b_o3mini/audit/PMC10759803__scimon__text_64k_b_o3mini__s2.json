      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed plasticity mechanism also operates during elevated-temperature tensile loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
