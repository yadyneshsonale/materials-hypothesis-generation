      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108",
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed HEA interlayer has a single-phase structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HEA interlayer has a nanocrystalline structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed HEA forms strong metallurgical bonds with both W and CuCrZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
