      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed refractory HEA has high thermal stability and radiation resistance.",
      "field": "hypothesis",
      "needs_support": true,
