      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "HTXRD can identify time-temperature-dependent phase transformations relevant to phase stability.",
