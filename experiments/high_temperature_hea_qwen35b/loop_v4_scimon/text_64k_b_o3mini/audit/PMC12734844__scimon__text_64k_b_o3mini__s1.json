      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS enables HEA densification at a lower sintering temperature than conventional sintering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant initial material consists of mechanically alloyed HEA powders.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanically alloyed HEA powders have high surface area and reactive interfaces.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is SPS under pressure and a protective atmosphere.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS applies a pulsed electric current during sintering.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The process uses an inert or protective environment with controlled pressure.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suitable SPS temperatures are around 1200 °C or lower.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SPS process uses rapid heating and cooling cycles.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS produces localized Joule heating at particle contacts.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized Joule heating promotes rapid neck formation and interparticle diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pulsed current generates localized high-energy sites at particle interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized high-energy interfacial sites accelerate mass transport and reduce reaction times.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS lowers the effective densification temperature by minimizing grain growth and reducing the diffusion energy barrier relative to furnace sintering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS-processed HEAs will attain near-full density and refined microstructures at lower temperatures than traditionally sintered samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Traditional sintering or vacuum arc melting requires higher temperatures and longer dwell times to achieve similar densification.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Traditional processing produces more grain coarsening or oxidation than SPS.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The temperature-reduction benefit of SPS depends on electrically conductive powders that form well-connected necks.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Poor powder conductivity or inadequate oxidation control reduces the benefit of SPS.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The amount of temperature reduction and microstructural refinement varies with alloy composition, powder size, and SPS parameters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
