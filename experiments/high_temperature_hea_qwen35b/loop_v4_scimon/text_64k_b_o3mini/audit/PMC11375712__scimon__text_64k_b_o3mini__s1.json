  "claims": [
    {
      "text": "Spin-polarized DFT incorporating local spin fluctuations can predict a ferromagnetic ground state in CoCrFeMnNi high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lower total energy for aligned spins indicates a ferromagnetic ground state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoCrFeMnNi can be treated as a paramagnetic alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial CoCrFeMnNi alloy is equiatomic, chemically disordered, and in a standard solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LSF methodology can describe the finite-temperature magnetic state of each species in paramagnetic CoCrFeMnNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "A one-shot static-equilibrium approach can be used with the LSF methodology.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The cited method compares ferromagnetic configurations with non-magnetic or antiferromagnetic configurations.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The calculations establish the magnetic ground state at 0 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local spin fluctuations are relevant to finite-temperature magnetic behavior.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local magnetic moments on the constituent alloy species mediate the calculated magnetic behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "Exchange interactions among the local moments within the lattice are the relevant structural mediator.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exchange interactions lower the energy when the local moments align ferromagnetically.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The LSF treatment accounts for thermal excitations of local magnetic moments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "Including LSF demonstrates that ferromagnetic alignment minimizes the free energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::003::methods::f3287d9a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ferromagnetic configuration will have lower total energy than the non-magnetic configuration.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ferromagnetic configuration will have a nonzero net magnetic moment.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
