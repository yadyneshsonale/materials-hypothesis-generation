  "claims": [
    {
      "text": "Laser cladding a refractory HEA coating onto stainless steel improves the steel's corrosion resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "A WVTaTiCr-based refractory HEA is a suitable laser-cladding coating for stainless steel.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "Laser cladding produces a metallurgically bonded coating on the stainless-steel substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HEA coating has a refined microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating microstructure promotes formation of a dense protective surface oxide.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective surface oxide is Cr-rich.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory HEA composition favors in situ formation of stable oxides during corrosive exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxides form a continuous protective layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer is self-healing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer impedes elemental dissolution and further corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding creates a fine-grained microstructure that reduces pathways for corrosive attack.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated stainless steel will have a lower corrosion rate than uncoated stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "The coated samples will show reduced mass loss or slower oxide weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "The HEA coating will improve surface hardness relative to unmodified stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "The HEA coating will enhance durability under aggressive conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "The improvement is expected in high-temperature oxidation environments.",
