  "claims": [
    {
      "text": "Stepwise controllable coherent nanoprecipitations can overcome the strength–ductility trade-off in tungsten-based refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCPs strategy forms coherent nanoprecipitates in the alloy matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventionally processed tungsten-based refractory high-entropy alloys exhibit high strength but limited ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The limited ductility of the initial alloy is caused by brittle W-enriched phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent nanoprecipitates are uniformly distributed within the matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled thermal and mechanical processing up to 800°C maintains precipitate coherence.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precise control of alloy composition and heat treatment is required to achieve the SCCPs microstructure.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitates constitute the structural mediator responsible for the proposed property improvement.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent precipitate interfaces facilitate dislocation transmission across the precipitate structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation shearing of the coherent precipitate structure alleviates local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relieving local stress concentrations prevents premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCPs mechanism retains tensile ductility while preserving ultrahigh strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "At ambient temperature, the SCCPs alloy can exceed 2 GPa strength while attaining about 15% tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The SCCPs alloy outperforms conventional strengthening approaches that sacrifice ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The benefit is likely limited to tungsten-based refractory high-entropy alloys processed under conditions that permit coherent nanoprecipitate formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative strength and ductility improvement depends on accurate control of processing parameters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoprecipitate size, spacing, and volume fraction require optimization to maximize performance without compromising long-term stability.",
      "field": "uncertainty",
