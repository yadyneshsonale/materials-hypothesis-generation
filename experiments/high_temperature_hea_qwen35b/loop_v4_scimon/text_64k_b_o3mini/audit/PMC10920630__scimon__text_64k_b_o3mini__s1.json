      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC10142552::chunk::002::materials_and_methods::ec6d71c0fc"
      ],
      "same_system": "yes"
    },
    {
