      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "A 3.5 wt% NaCl solution is an applicable environment for the claimed corrosion improvement.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WVTaTiCr_x coatings exhibit improved behavior under high-temperature oxidation conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding itself refines the surface microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr content refines the grains of WVTaTiCr_x coatings.",
      "field": "structural_mediator",
