      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tungsten-rich bcc phases precipitate during a specific tempering-temperature window.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitation of tungsten-rich bcc phases during tempering causes embrittlement.",
