      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "At ambient or low temperatures, dislocation motion in the alloy produces ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
