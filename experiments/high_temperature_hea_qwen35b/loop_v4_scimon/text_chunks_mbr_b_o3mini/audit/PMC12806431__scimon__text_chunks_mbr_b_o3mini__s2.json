      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy has a predominantly bcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy contains a distribution of tungsten-enriched phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate-temperature tempering will induce tungsten-rich phase precipitation and brittleness.",
