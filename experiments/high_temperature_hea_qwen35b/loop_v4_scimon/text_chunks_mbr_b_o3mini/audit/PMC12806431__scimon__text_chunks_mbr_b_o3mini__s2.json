  "claims": [
    {
      "text": "A tungsten-based heavy alloy can be engineered to exhibit a ductile–brittle–ductile transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten-based alloys can contain brittle tungsten-enriched phases with bcc structures.",
