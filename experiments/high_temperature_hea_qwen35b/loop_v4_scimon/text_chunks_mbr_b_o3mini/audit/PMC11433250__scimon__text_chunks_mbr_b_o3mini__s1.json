      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitates give the tungsten-based RHEA ultra-high strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nanoprecipitate-engineered tungsten-based RHEA retains high strength at elevated temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
