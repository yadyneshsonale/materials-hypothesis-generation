      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "Vacuum and air are relevant controlled atmospheres for studying high-temperature oxidation of CrMnFeCoNi.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
