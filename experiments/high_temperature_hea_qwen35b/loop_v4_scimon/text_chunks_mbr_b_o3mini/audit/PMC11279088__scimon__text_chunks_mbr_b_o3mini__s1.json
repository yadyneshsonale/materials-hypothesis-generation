  "claims": [
    {
      "text": "In situ high-temperature X-ray diffraction is a reliable method for assessing high-temperature oxidation behavior in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "In situ HTXRD can assess the high-temperature phase stability of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
