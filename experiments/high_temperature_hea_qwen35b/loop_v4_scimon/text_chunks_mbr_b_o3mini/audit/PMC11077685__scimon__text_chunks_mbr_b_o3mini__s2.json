  "claims": [
    {
      "text": "Increasing Cr content in a high-entropy or refractory high-entropy alloy can improve its high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Al can improve the high-temperature oxidation resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Si can improve the high-temperature oxidation resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Ti as an oxidation-resistant element can improve oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Appropriate additions of Cr, Al, or Si promote formation of a dense protective surface oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting oxide film is continuous.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective film formed after increasing Cr is specifically a Cr-based oxide such as Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Cr preferentially oxidizes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-derived oxide scale is stable and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the dense surface oxidation film slows further oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compositionally modified alloy will have a lower oxidation rate than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Improved oxidation resistance will manifest as lower oxide-scale thickness and lower oxidation weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed method is effective in an oxidizing environment such as air at approximately 800°C or higher.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Competing brittle intermetallic phase formation can limit the benefits of Al, Cr, or Si additions.",
