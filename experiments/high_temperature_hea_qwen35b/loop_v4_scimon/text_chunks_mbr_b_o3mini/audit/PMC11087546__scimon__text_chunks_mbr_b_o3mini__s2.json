      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "An SCCP-designed tungsten refractory high-entropy alloy can exhibit strength exceeding 2 GPa at ambient temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "An SCCP-designed tungsten refractory high-entropy alloy can exhibit approximately 15% tensile ductility at ambient temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "An SCCP-designed tungsten refractory high-entropy alloy can retain a high yield strength at 800 °C.",
