  "claims": [
    {
      "text": "CoCrFeNiTi can form a single-phase simple solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::001::introduction::614f98a476"
      ],
      "same_system": "yes"
    },
    {
      "text": "The single-phase CoCrFeNiTi solid solution is stable in either the as-cast or heat-treated state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::001::introduction::614f98a476"
      ],
      "same_system": "yes"
    },
    {
      "text": "Titanium can replace part of the heavier elements in an equiatomic or near-equiatomic HEA formulation.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding a significant titanium fraction to CoCrFeNiTi lowers its overall density relative to similar HEAs without titanium.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoCrFeNiTi has favorable plasticity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::001::introduction::614f98a476"
      ],
      "same_system": "yes"
    },
    {
      "text": "Titanium-containing CoCrFeNiTi has comparable or improved strength relative to traditional heavy HEAs lacking titanium.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Titanium-containing CoCrFeNiTi provides favorable corrosion resistance relative to comparable titanium-free HEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11355469::chunk::001::introduction::201bec5221",
        "PMC12298864::chunk::001::introduction::614f98a476"
      ],
      "same_system": "no"
    },
    {
      "text": "The single-phase structure of CoCrFeNiTi remains stable from room temperature to approximately 750 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Multi-principal-element design produces substantial lattice distortion in CoCrFeNiTi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11355469::chunk::001::introduction::201bec5221"
      ],
      "same_system": "no"
    },
    {
      "text": "Titanium's lower atomic mass contributes to reduced alloy density.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy effect and lattice distortion promote deformation twinning and transformation-induced plasticity in CoCrFeNiTi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed deformation behavior allows CoCrFeNiTi to retain mechanical integrity while its density is reduced.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy effect and lattice distortion help CoCrFeNiTi retain corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoCrFeNiTi will provide a comparable or improved strength–ductility balance relative to traditional heavy HEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::001::introduction::614f98a476"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined density and mechanical-property advantages give CoCrFeNiTi superior comprehensive performance in structural applications.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 750 °C, CoCrFeNiTi may decompose into brittle sigma or BCC phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature phase decomposition would limit the lightweight alloy's benefits in structural applications.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
