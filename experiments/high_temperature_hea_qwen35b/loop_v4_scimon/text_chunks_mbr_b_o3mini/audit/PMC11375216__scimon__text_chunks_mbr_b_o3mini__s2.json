  "claims": [
    {
      "text": "HfNbTaTiZr is a high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial HfNbTaTiZr alloy is produced by sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::chunk::002::results_and_discussion::a284dbd27f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial sintered alloy is fully densified.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::chunk::002::results_and_discussion::a284dbd27f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy has a homogeneous microstructure before SRO precipitate formation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored heat treatment or processing can induce SRO precipitates in HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The induced SRO precipitates are distributed throughout the HfNbTaTiZr matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates act as phonon-scattering centers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scattering by SRO precipitates reduces phonon mean free paths and scattering times.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced phonon mean free path lowers lattice thermal conductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr samples containing induced SRO precipitates will have lower lattice thermal conductivity than otherwise similar samples without engineered SRO.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lattice thermal-conductivity range of 10–17 W/(m·K) has been reported for the proposed comparison.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr processed without SRO-promoting heat treatments has higher lattice thermal conductivity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect applies over approximately 50–900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inert or vacuum atmospheres minimize extrinsic effects during the proposed elevated-temperature measurements.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect is expected only when SRO formation does not cause extensive phase separation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect is expected only when SRO formation does not change the dominant heat-conduction mechanism beyond phonon scattering.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the conductivity reduction may depend on precipitate size, distribution, and volume fraction.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TEM or SEM can verify and quantify the presence or absence of the proposed SRO precipitates.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
