  "claims": [
    {
      "text": "In situ high-temperature X-ray diffraction can effectively characterize the high-temperature oxidation behavior of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "In situ HTXRD can characterize the high-temperature phase stability of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "unclear"
    },
    {
      "text": "HTXRD provides time- and temperature-resolved measurements of phase formation and transformation under oxidation conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrMnFeCoNi can begin the proposed experiment as a single-phase alloy in an as-cast or homogenized state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "In situ HTXRD can be applied to CrMnFeCoNi during heating in vacuum and air.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant high-temperature interval is approximately 750–1320 °C under both oxidative and non-oxidative environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-containing oxide phases form and evolve during high-temperature oxidation of CrMnFeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrMnFeCoNi may form phase-decomposition products during annealing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "HTXRD tracks time–temperature-dependent phase transitions and oxidation processes in situ.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The time-resolved diffraction data reveal the kinetics and stability of both the primary alloy phase and emergent oxide phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "Heating will produce distinct diffraction peaks from transient oxide phases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Heating will produce distinct diffraction peaks from alloy phase-decomposition products.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::004::discussion::7b007820ed"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HTXRD observations will highlight differences between vacuum and air environments.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional isothermal oxidation tests provide only end-point phase information and lack time-resolved data.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
