  "claims": [
    {
      "text": "HfNbTaTiZr is a refractory high-entropy alloy proposed for lattice thermal-conductivity modification.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing SRO precipitates into HfNbTaTiZr will decrease its lattice thermal conductivity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A refractory high-entropy alloy can be processed through sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::chunk::002::results_and_discussion::a284dbd27f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial HfNbTaTiZr alloy is a homogeneous, mostly uniform solid solution with minimal SRO precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled thermal treatment can induce SRO precipitates in the alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled irradiation can induce SRO precipitates in the alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice or phonon conduction is dominant over the proposed measurement range of 50 to 900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory high-entropy-alloy structures are relevant to high-temperature applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::chunk::002::results_and_discussion::a284dbd27f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "SRO precipitates act as phonon-scattering centers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates disrupt the periodic lattice.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scattering from SRO precipitates reduces phonon lifetimes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scattering from SRO precipitates reduces phonon mean free paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced phonon lifetimes and mean free paths lower lattice heat transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The induced SRO state may reduce lattice thermal conductivity by tens of percent relative to the homogeneous control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective conductivity reduction depends on the precipitate size, density, and spatial distribution.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitates that are too coarse or too sparse may produce only a minimal reduction in lattice thermal conductivity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Over-precipitation may cause microstructural degradation and allow other heat-transport mechanisms to dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative relationship between precipitate characteristics and phonon scattering in these alloys is not fully established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to observe a statistically significant conductivity decrease, or observation of an increase, would falsify the stated hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
