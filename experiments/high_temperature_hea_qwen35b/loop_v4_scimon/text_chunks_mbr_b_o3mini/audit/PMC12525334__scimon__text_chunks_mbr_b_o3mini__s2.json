  "claims": [
    {
      "text": "Combining high-throughput computational thermodynamic screening with an HEA design framework can identify RHEAs that balance high strength, ductility, and low density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CALPHAD-based modeling is suitable for high-throughput screening of refractory HEA composition space.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Multi-principal-element alloying can produce a disordered BCC or near-BCC matrix in the targeted RHEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed alloy formulations can tailor lattice distortion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed design method can control precipitate formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional RHEAs can be based on multiple refractory elements such as W, Mo, Ta, and Nb.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial refractory alloys lack optimized low-mass alloying additions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HEA design provides a wide composition space suitable for exploration.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "Experimentally validating computationally selected RHEAs containing low-weight additions will identify successful candidates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The targeted RHEAs are intended for room-temperature and elevated-temperature service at approximately 1000°C or above.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "A disordered BCC-dominated microstructure with fine-scale coherent precipitates is a suitable structural mediator for the targeted RHEAs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "no"
    },
    {
      "text": "Different atomic sizes in multi-principal-element HEAs cause atoms to deviate from ideal lattice sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "yes"
    },
    {
      "text": "HEA lattice distortions impede dislocation motion and thereby increase strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled alloying with low-density additions improves ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled low-density alloying reduces the overall weight of the RHEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-throughput screening can identify compositions in which strengthening, ductility, and density-reduction effects act synergistically.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Designed candidate RHEAs will have a better combination of strength, ductility, and density than conventional refractory alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional RHEAs commonly combine refractory elements in equiatomic or near-equiatomic ratios.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional near-equiatomic RHEAs may be strong but brittle and relatively dense.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation resistance is an important potential limitation for RHEAs used at high temperature.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
