  "claims": [
    {
      "text": "Applying a protective ceramic coating can improve the high-temperature oxidation behaviour of an uncoated metallic substrate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applying a protective ceramic coating can enhance the phase stability of the underlying metallic material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ceramic coating acts as a barrier to oxygen transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ceramic coating reduces diffusion of oxygen to the metallic substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion prevents oxidation of the substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A coated substrate will have a lower oxidation rate than an uncoated substrate under identical high-temperature oxidizing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A coated substrate will exhibit greater phase stability than an uncoated substrate under high-temperature oxidizing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect applies to oxidation-susceptible metallic substrates at temperatures above 800°C in an oxidizing atmosphere.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coating effectiveness may vary with the coating and substrate materials and with exposure conditions.",
      "field": "uncertainty",
