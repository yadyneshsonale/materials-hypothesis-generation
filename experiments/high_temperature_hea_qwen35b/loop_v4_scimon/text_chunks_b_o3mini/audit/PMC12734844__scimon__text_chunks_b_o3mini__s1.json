  "claims": [
    {
      "text": "The starting materials are mechanically alloyed refractory high-entropy-alloy powders.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS after mechanical alloying can consolidate refractory HEA powders at lower temperatures than conventional sintering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0",
        "PMC8510135::chunk::003::results::51ba8ce9a9"
      ],
      "same_system": "yes"
    },
    {
      "text": "A refractory HEA can be processed by SPS at approximately 1200 °C.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::chunk::003::results::51ba8ce9a9",
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional sintering requires temperatures above 1900 °C, near the alloy melting point, to obtain similar densification.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS processing of refractory HEAs can be performed under vacuum or an inert atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Using vacuum or an inert atmosphere minimizes oxidation during consolidation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS employs rapid heating and short holding times for this application.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS produces a refined microstructure in mechanically alloyed refractory HEAs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS limits grain growth in mechanically alloyed refractory HEAs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS reduces porosity in mechanically alloyed refractory HEAs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heating and efficient energy delivery during SPS enhance diffusion kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced diffusion kinetics permit effective densification at lower temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS suppresses grain growth and oxidation during consolidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS samples will have comparable or improved density relative to conventionally sintered samples despite the lower processing temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS samples will have comparable or improved microstructural homogeneity relative to conventionally sintered samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed temperature-reduction effect is expected to apply to refractory HEAs processed from mechanically alloyed powders.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::002::materials_and_methods::c9b39b2ae0",
        "PMC8510135::chunk::003::results::51ba8ce9a9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The effect may not apply to powders or alloy chemistries with fundamentally different characteristics.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of temperature reduction and microstructural refinement across refractory HEA compositions remains insufficiently quantified.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
