  "claims": [
    {
      "text": "AlCoCrFeNi2.1 is a eutectic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed AlCoCrFeNi2.1 interlayer has a lamellar microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lamellar microstructure of AlCoCrFeNi2.1 creates highly coherent interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing an AlCoCrFeNi2.1 interlayer into HEA multilayers will enable a transition between diffusion-mediated and dislocation-mediated creep.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial HEA multilayers have sharp, coherent interfaces.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial multilayers contain layers of a ductile FCC phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial multilayers contain a strengthening BCC/B2 or related phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent lamellar interface maintains structural order at lower temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent lamellar interface permits increased atomic mobility at higher temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, the coherent interfaces impede dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, the coherent interfaces suppress dislocation climb.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At higher temperatures, enhanced atomic diffusion at the interfaces causes diffusion-mediated creep to become dominant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The eutectic interlayer will produce a measurable shift in creep rate with temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Creep rates will be lower and creep will be dislocation-mediated at lower temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Creep will transition to diffusion-dominated behavior at higher temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The creep-mechanism transition can be tuned by changing the eutectic interlayer thickness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The creep-mechanism transition can be tuned by changing interfacial coherency.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Multilayers without the eutectic interlayer have less systematically controlled coherency and a less predictable balance of diffusion and dislocation creep.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of interface coherency may prevent the proposed transition behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Complete recovery or recrystallization at extreme temperatures may prevent the proposed transition behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
