      "support": "partial",
      "supporting_ids": [
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The HEA coating minimizes elemental dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HEA-coated stainless steel will have a lower corrosion rate than untreated stainless steel under identical harsh conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "HEA-coated stainless steel will undergo less mass loss than untreated stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
