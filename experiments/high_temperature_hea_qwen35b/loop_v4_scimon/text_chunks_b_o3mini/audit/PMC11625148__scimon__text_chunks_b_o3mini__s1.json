      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "CoNiCrFeMn HEA nanowires are more ductile than Ag nanowires.",
