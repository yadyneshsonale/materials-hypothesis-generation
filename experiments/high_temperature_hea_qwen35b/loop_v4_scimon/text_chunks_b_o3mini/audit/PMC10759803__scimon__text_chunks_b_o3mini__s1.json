      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At larger strain, slip bands shear the δ lamellae rather than creating cracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Shearing of the δ lamellae alleviates local stress concentrations.",
