  "claims": [
    {
      "text": "Introducing a coherent dual-phase lamellar microstructure into refractory high-entropy alloys can improve strength and ductility concurrently.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed microstructure contains coherent δ lamellae and γ″ precipitates.",
