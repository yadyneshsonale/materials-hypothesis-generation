  "claims": [
    {
      "text": "NbMoTaW is a refractory high-entropy alloy that can enhance glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed starting material is a homogeneous molten NbMoTaW alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling can bypass crystallization kinetics in NbMoTaW.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt spinning is a suitable rapid-cooling method for the proposed experiment.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert atmosphere is required for vitrification under the proposed conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cooling rates must be sufficiently high to vitrify NbMoTaW.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW has high configurational or mixing entropy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb, Mo, Ta, and W exhibit substantial atomic-size disparity in NbMoTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy and atomic-size disparity promote disordered atomic arrangements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::004::discussion::ef977a5008"
      ],
      "same_system": "no"
    },
    {
      "text": "Mixing entropy and atomic-size-related parameters are relevant criteria for phase formation in high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::004::discussion::ef977a5008"
      ],
      "same_system": "no"
    },
    {
      "text": "Atomic-size differences and high mixing entropy lower the nucleation driving force for crystalline phase formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed entropy and size-mismatch mechanism favors amorphization during sufficiently rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapidly cooled NbMoTaW will form a fully amorphous glass.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW will have better glass-forming ability than conventional alloys having lower entropy and less atomic-size mismatch.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional refractory or lower-entropy alloys typically crystallize at cooling rates comparable to those proposed for NbMoTaW.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced glass-forming ability is limited to compositions retaining high mixing entropy and substantial atomic-size differences.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deviation from an unspecified optimal composition may prevent formation of a fully amorphous structure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficient cooling rates may prevent formation of a fully amorphous structure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical cooling rate required to vitrify NbMoTaW is not established.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
