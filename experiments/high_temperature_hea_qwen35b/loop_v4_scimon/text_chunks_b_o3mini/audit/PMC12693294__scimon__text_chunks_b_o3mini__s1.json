  "claims": [
    {
      "text": "SPS with a controlled rapid thermal cycle applied to mechanically alloyed Al–Co–Cr–Fe–Ni powder will suppress unwanted phase transformations and stabilize a predominantly single-phase microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39",
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanically alloyed Al–Co–Cr–Fe–Ni starting powder is nanocrystalline.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "no"
    },
    {
      "text": "The starting Al–Co–Cr–Fe–Ni powder may contain multiple poorly defined phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed SPS intervention uses rapid heating, a short dwell time, and controlled rapid cooling.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An SPS temperature and dwell time can be chosen that permit densification while limiting atomic diffusion.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "A rapid thermal cycle minimizes long-range atomic diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced long-range diffusion curtails the nucleation and growth of secondary phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid SPS heating enables densification by quickly reaching the sintering temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A short dwell time and controlled cooling restrict kinetic and thermodynamic pathways for phase separation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "Restricting phase-separation pathways preserves a high-entropy, single-phase structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS-processed Al–Co–Cr–Fe–Ni will contain fewer undesired precipitates or intermetallic phases than conventionally sintered material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS processing will improve phase stability in Al–Co–Cr–Fe–Ni.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39",
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "unclear"
    },
    {
      "text": "SPS processing will enhance the mechanical properties of Al–Co–Cr–Fe–Ni relative to conventional processing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional sintering or slow cooling permits more extensive diffusion and typically produces multiphase Al–Co–Cr–Fe–Ni microstructures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase evolution and the effectiveness of phase control depend on alloy composition.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4999872::chunk::000::abstract::7a7d39c713"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive SPS temperature or dwell time could trigger phase transformations.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An SPS temperature that is too low could cause incomplete densification.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined mechanical alloying and SPS has shown phase-control and property-optimization potential in CoCrFeNiTi HEA.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "no"
    },
    {
      "text": "It is uncertain whether the rapid thermal conditions used in related HEAs will yield an optimal single-phase Al–Co–Cr–Fe–Ni microstructure without unwanted metastable phases.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
