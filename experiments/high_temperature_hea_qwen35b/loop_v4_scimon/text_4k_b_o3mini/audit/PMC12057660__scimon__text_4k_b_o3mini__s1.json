  "claims": [
    {
      "text": "The precursor is a high-entropy alloy containing both noble and less-noble metals.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::001::introduction::455ef7c5ca"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precursor metals are present in equal or near-equal atomic ratios.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11775865::chunk::001::introduction::455ef7c5ca"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Selective chemical dealloying can produce a three-dimensional nanoframework from an HEA precursor.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electrochemical dealloying can be used as an alternative to chemical dealloying.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dealloying selectively removes the less-noble elements from the precursor.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An appropriately selected electrolyte and temperature favor dissolution of less-noble elements while preserving a noble-metal framework.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Potential cycling or a constant electrochemical bias can assist selective etching.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective removal of less-noble metals leaves a nanoporous, three-dimensionally interconnected noble-metal network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The residual framework is enriched in noble metals.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the porous framework increases the material's surface area.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased surface area produces a high density of catalytically active sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::001::introduction::455ef7c5ca"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dealloyed nanoframework has a significantly higher surface-to-volume ratio than the original dense HEA nanoparticle.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dealloyed nanoframework has improved catalytic reactivity relative to the original dense HEA nanoparticle.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
