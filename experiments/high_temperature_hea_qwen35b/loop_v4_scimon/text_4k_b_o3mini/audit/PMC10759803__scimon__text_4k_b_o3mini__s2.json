      "supporting_ids": [
        "PMC5995863::chunk::000::abstract::63aa5c975c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The inverted microstructure increases yield strength relative to the conventional continuous-B2 microstructure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
