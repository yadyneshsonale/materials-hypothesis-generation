  "claims": [
    {
      "text": "Refractory HEAs can contain group-IV, group-V, and group-VI refractory elements such as Ti, Zr, Hf, V, Nb, Ta, Cr, Mo, and W.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting material is a homogeneous powder mixture of refractory alloying elements and Cu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The constituent powders are present in desired near-equiatomic ratios.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Spark plasma sintering enables large-scale processing of RHEA–Cu composites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid SPS limits excessive interdiffusion between Cu and refractory elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu and refractory alloying elements have a problematic positive heat of mixing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled rapid heating and a short SPS dwell time minimize the time available for Cu–refractory diffusion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS under an inert atmosphere is an appropriate processing condition for the proposed composite.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid densification forms an in-situ reactive interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in-situ interface preserves distinct refractory and Cu phases while promoting interfacial bonding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS heating causes a self-propagating reaction in the powder compact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local phase formation and densification occur before significant Cu–refractory diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS produces a stable composite microstructure with well-defined refractory and Cu domains.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting RHEA–Cu composite maintains high mechanical strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting RHEA–Cu composite maintains irradiation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting RHEA–Cu composite maintains high-temperature thermal stability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional sintering or melting permits prolonged diffusion and produces unstable microstructures through excessive mixing.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive SPS temperature or dwell time permits too much diffusion and negates the proposed microstructural benefits.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
