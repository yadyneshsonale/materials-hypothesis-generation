  "claims": [
    {
      "text": "Increasing chromium content enhances the alloy's oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxidation-resistance improvement from chromium occurs by promoting a protective chromium oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is a high-entropy alloy containing Ni, Co, Fe, Al, Ti, Nb, Cr, C, Mo, and W.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy has a lower chromium content than the proposed modified alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromium is included in the investigated HESA to provide oxidation and corrosion resistance.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-temperature oxidation is a performance concern for refractory high-entropy alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed chromium increase will form a continuous, adherent Cr2O3 scale on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromium in the alloy reacts with oxygen during high-temperature exposure to form chromia.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The chromia scale is a stable protective barrier that slows further oxidation and limits corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher-chromium alloy will have a lower oxidation rate than the same alloy with lower chromium content.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::004::methods::37e917c24a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The higher-chromium alloy will exhibit lower mass loss under identical oxidizing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher-chromium alloy will exhibit slower oxide-scale growth under identical oxidizing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit of increasing chromium may depend on the full alloy composition and interactions with other elements in complex HEAs or RHEAs.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of oxidation-resistance improvement may vary with composition, processing conditions, and testing environment.",
      "field": "uncertainty",
