      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified surface develops a dense oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "unclear"
    },
    {
