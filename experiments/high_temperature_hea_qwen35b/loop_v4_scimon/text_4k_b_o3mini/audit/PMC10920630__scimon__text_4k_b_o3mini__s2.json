      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the dense oxidation film improves high-temperature oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated stainless steel will have a significantly lower corrosion rate than untreated stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
