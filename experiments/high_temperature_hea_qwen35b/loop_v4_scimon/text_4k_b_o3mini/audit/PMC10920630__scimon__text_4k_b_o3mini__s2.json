      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Proper amounts of Al, Cr, and Si in an RHEA promote formation of a dense oxidation film at high temperature.",
