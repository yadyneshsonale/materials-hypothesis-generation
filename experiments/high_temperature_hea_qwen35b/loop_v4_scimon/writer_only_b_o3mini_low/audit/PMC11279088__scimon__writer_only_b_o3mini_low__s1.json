      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diffraction-peak shifts or the appearance of new peaks can evidence phase transitions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under isothermal non-oxidizing conditions, the specimen should exhibit minimal mass change.",
      "field": "baseline",
