      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The machine-learning framework can predict processing parameters that encourage formation of a low-porosity protective barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of a dense protective external oxide layer reduces oxidation-associated mass gain.",
