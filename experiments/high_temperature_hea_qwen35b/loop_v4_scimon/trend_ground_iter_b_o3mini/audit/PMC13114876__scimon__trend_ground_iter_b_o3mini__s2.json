      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti and Al are oxide-forming additions whose concentrations can be tailored to enhance oxide-scale formation in this alloy family.",
