      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed material will resist degradation under simultaneous elevated-temperature wear and exposure to a chloride-rich corrosive medium.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "A nanoscale spinel or related oxide layer will form on the alloy surface during service.",
