      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized alloy will show significantly lower wear rate and tribo-corrosion mass loss than conventional structural alloys or unoptimized AlCoCrFeNi HEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
