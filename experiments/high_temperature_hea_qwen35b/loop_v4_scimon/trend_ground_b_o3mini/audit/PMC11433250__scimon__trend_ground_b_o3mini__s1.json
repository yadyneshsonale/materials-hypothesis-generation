      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2",
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective phase may be a Cr-rich intermetallic phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The in situ phase acts as a diffusion barrier against corrosion by molten aluminum.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
