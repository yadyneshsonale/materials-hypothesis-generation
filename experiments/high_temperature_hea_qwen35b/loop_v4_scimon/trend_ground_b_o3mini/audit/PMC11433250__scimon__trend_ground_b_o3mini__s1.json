      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline high-entropy alloy does not form a robust protective surface layer during molten-aluminum exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Cr promotes formation of a self-protecting high-temperature phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Molten aluminum in hot-dip plating is encountered at temperatures above 660 degrees Celsius.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A phase analogous to Cr2Ta can form as the proposed protective layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "unclear"
    },
