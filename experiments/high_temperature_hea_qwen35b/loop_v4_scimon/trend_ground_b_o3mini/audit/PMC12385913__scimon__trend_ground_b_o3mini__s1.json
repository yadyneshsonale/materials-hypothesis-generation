  "claims": [
    {
      "text": "Conventional refractory HEAs or tungsten-based alloys suffer from high neutron activation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten, molybdenum, and niobium are high-activation refractory elements.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vanadium, titanium, and chromium are intrinsically low-activation alternatives.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing tungsten, molybdenum, and niobium with vanadium, titanium, and chromium in an HEA will yield a low-neutron-activation alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fusion plasma-facing materials must operate at temperatures of at least 1000 K under plasma and neutron exposure.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc",
        "PMC10154406::chunk::001::introduction::c389c7efcd"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fusion plasma-facing materials require low activation, a high melting point, and good thermomechanical properties.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed compositional substitution will retain a stable BCC microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High compositional entropy stabilizes the BCC phase in the proposed alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stable BCC microstructure mediates a balance between mechanical strength and irradiation performance.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed low-activation elements produce fewer long-lived radioactive isotopes under neutron irradiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incorporating the proposed low-activation elements into an HEA will retain high melting temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory HEAs can exhibit excellent high-temperature mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The specifically modified HEA will retain mechanical strength after the proposed substitutions.",
      "field": "mechanism",
