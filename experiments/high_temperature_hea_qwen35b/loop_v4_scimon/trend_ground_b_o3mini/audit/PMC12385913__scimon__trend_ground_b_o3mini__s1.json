      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified HEA will provide irradiation resistance comparable to or better than tungsten alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten is a leading plasma-facing-material candidate because of its high melting temperature, low erosion, and low tritium retention.",
