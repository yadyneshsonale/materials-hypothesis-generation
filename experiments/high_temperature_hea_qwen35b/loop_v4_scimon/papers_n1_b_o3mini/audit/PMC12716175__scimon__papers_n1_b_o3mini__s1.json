  "claims": [
    {
      "text": "High-energy planetary ball milling followed by spark plasma sintering is a viable powder-metallurgy route for producing a refractory high-entropy alloy composite.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The combined process enables a large-scale in situ reaction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The process produces stable, uniformly dispersed reinforcement phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The reinforcement phases mitigate problems caused by the positive heat of mixing with Cu.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The process starts from mixed refractory-high-entropy-alloy precursor powders.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cu components may be included in the precursor mixture.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-energy ball milling produces homogeneous mixing of the precursor powders.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Spark plasma sintering can be conducted at approximately 1700 °C and 30 MPa for 30 minutes.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The processing is performed in a controlled, non-oxidizing atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC and Al2O3 reinforcement particles form in situ in the refractory-high-entropy-alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The TiC and Al2O3 phases act as barriers to phase segregation and grain coarsening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid SPS heating and applied pressure enhance diffusion and reaction kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced diffusion and reaction kinetics facilitate the formation of stable, bonded reinforcement particles within the matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SPS process counteracts segregation tendencies associated with Cu's positive heat of mixing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
