      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "A short anneal near 900 °C for a few minutes is an appropriate processing step.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "Aging near 650 °C for several hours followed by rapid quenching is an appropriate processing step.",
