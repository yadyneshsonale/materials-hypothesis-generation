      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "Significant hot- and cold-rolling deformation is part of the proposed treatment.",
