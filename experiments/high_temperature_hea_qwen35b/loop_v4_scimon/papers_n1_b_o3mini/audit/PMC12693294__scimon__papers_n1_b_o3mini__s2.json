      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will enhance the strength of Al–Co–Cr–Fe–Ni HEAs.",
