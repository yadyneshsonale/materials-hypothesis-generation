  "claims": [
    {
      "text": "Ta20Nb20Hf20Zr20Ti20 is an equiatomic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ta20Nb20Hf20Zr20Ti20 is a refractory alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ta20Nb20Hf20Zr20Ti20 will resist corrosion and erosion by high-temperature liquid aluminum better than conventional hot-dip plating equipment materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy can be produced by casting followed by Hot Isostatic Pressing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hot Isostatic Pressing induces a secondary HCP phase in addition to the initial BCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "HIP produces a dispersed HCP phase in the alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HCP phase is beneficial to the alloy's performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "HIP processing and the associated microstructural change increase the alloy's hardness.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dispersed HCP phase increases high-temperature strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy is suitable for exposure to liquid aluminum at approximately 700–750 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory elements promote formation of protective oxide layers in molten-aluminum service.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy's refractory elements provide high-temperature stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective oxide formation and high-temperature stability reduce erosion and chemical attack by molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Parts made from or coated with the alloy will have lower mass loss and surface degradation than conventional materials in molten aluminum.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Use of the alloy could significantly extend equipment service life.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard steels or low-grade alloys used in dipping and plating equipment undergo accelerated corrosion in molten aluminum.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy exhibits very low room-temperature tensile ductility consistent with brittleness.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Prior studies observed abnormal crack propagation in the alloy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy's thermal-shock resistance under hot-dip plating conditions is unquantified.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The degree and longevity of protective oxide formation under molten-aluminum exposure have not been verified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
