  "claims": [
    {
      "text": "Al0.7CoCrFeNi is a eutectic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy may be homogenized before HPHT treatment.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy may instead be used in the as-cast state before the specified HPHT treatment.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HPHT treatment uses 6 GPa and 1473 K for 2 hours.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment induces a hierarchically patterned microstructure in homogenized Al0.7CoCrFeNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HPHT-induced microstructure contains interconnected FCC and B2 phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC/B2 interfaces produced by HPHT are coherent.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mismatch factor between the FCC and B2 phases is approximately 0.004.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The patterned FCC/B2 microstructure facilitates multiple deformation mechanisms.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interphase coherency permits dislocation transfer across the phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interphase coherency relieves stress and thereby improves mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HPHT treatment substantially increases both tensile strength and tensile ductility relative to the precursor alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT-treated Al0.7CoCrFeNi can achieve a tensile strength of 1150 MPa and tensile ductility of 36%, approximately doubling both properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::rubric_card::000::3e3b5fbe93"
      ],
      "same_system": "yes"
    },
    {
      "text": "MoS2 or graphene can be integrated into the alloy as a lubricious phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combining the stable HPHT microstructure with a self-lubricating additive may maintain low friction and wear at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HPHT-treated alloy with a lubricating additive will exhibit consistently low friction coefficients across a wide temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HPHT-treated alloy with a lubricating additive will exhibit reduced wear across a wide temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dual mechanical and tribological improvement may depend on the exact HPHT parameters and compatibility of the lubricating phase.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
