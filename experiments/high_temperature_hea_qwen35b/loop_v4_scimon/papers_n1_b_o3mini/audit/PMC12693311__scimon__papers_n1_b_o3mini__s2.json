  "claims": [
    {
      "text": "The base alloy has the formulation Ta0.5Nb0.5HfZrTi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial Ta0.5Nb0.5HfZrTi alloy is crystalline.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The base and oxygen-containing alloys can be prepared by arc-melting and water-cooled copper-mold drop-casting.",
      "field": "material_initial_state; conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Water-cooled drop-casting provides rapid cooling relevant to crystallization kinetics.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The O-2 variant has the nominal composition (Ta0.5Nb0.5HfZrTi)98O2.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxygen occupies interstitial sites in the oxygen-doped alloy.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen doping promotes the formation of ordered oxygen complexes among the constituent atoms.",
      "field": "intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen doping increases local chemical disorder.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen doping increases atomic-size mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ordered oxygen complexes disrupt the short-range ordering characteristic of crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-induced structural changes slow atomic mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic mobility impedes crystal nucleation during cooling.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen doping lowers the critical cooling rate required to form an amorphous structure and thereby enhances glass-forming ability.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-doped alloy should exhibit more amorphous content or greater glass stability than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped base alloy crystallizes more readily under otherwise similar cooling conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Glass-forming enhancement is limited to an oxygen-concentration range that promotes ordered oxygen complexes without phase segregation or embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess oxygen may induce unwanted secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-containing Ta0.5Nb0.5HfZrTi alloys have reported damping and mechanical-property measurements.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Direct evidence linking oxygen doping to enhanced glass-forming ability in this alloy system is limited.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
