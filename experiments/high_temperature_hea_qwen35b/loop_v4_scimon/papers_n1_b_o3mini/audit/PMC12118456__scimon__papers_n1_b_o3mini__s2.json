      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater relative surface-energy contributions promote atomic mobility and disorder.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chemical short-range order may emerge as temperature increases in FeCuCrCoNi nanoparticles.",
