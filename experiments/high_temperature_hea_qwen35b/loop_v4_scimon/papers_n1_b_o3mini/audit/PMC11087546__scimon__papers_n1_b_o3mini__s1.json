      "support": "entailed",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The doped alloys have greater yield strength and improved or maintained ductility relative to the undoped base alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
