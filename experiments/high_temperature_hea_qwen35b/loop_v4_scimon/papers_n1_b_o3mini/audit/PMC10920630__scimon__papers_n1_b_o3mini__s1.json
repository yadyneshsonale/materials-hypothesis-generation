      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "A uniform, low-defect RHEA film physically limits access of corrosive agents to the stainless-steel substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
