      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-doped Ta0.5Nb0.5HfZrTi will have a lower crystallization onset temperature during cooling than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Any enhancement in glass-forming ability is expected only over a limited oxygen-concentration range comparable to the O-2 composition.",
