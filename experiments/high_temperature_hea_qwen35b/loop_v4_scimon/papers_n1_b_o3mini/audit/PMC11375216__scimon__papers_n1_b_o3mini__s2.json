  "claims": [
    {
      "text": "The material is an equiatomic HfNbTaTiZr refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "The equiatomic HfNbTaTiZr alloy can be synthesized from blended hydride and elemental powders followed by sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sintering yields nearly fully densified HfNbTaTiZr material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slow cooling after sintering produces a multiphase microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slow cooling promotes the formation of short-range-order precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The slow-cooled microstructure contains β-BCC1, β-BCC2, and α-HCP phases.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Water quenching produces a single metastable β-BCC phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy is relevant to elevated-temperature studies extending to approximately 1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phonon conduction is the dominant heat-transport mechanism under the stated elevated-temperature conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates and multiple phases introduce additional phonon-scattering centers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates increase phonon-scattering events and reduce phonon scattering times or mean free paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing the phonon mean free path lowers the lattice thermal conductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow-cooled, multiphase HfNbTaTiZr should have lower lattice thermal conductivity than water-quenched, single-phase HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quenched alloy should have higher lattice thermal conductivity because it contains fewer phonon-scattering centers.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect should be significant when lattice-mediated heat transport dominates and may change when electronic conduction is important.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect of SRO precipitate density on phonon scattering and thermal conductivity has not yet been directly quantified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
