      ],
      "same_system": "unclear"
    },
    {
      "text": "The undoped base alloy has a yield strength of approximately 810 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped base alloy has an elongation of approximately 10.8%.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
