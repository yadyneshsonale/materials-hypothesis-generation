      ],
      "same_system": "yes"
    },
    {
      "text": "The initial as-cast NbMoCrTiAl alloy has a predominantly single-phase BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-energy planetary ball milling followed by spark plasma sintering can produce an NbMoCrTiAl composite containing in situ TiC and Al2O3 particles.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
