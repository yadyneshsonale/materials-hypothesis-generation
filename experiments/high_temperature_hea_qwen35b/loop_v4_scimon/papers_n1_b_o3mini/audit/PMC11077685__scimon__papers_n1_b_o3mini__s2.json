      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast alloy has a BCC/B2-dominant microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stationary friction processing can be performed with a WC cylindrical tool at 400 or 1800 rpm for 5 minutes.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant oxidation test is isothermal exposure in laboratory air at 850, 950, and 1050 °C for 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stationary friction processing refines the grain size to about 1 μm at 400 rpm and 0.43 μm at 1800 rpm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The grain refinement increases the density of grain boundaries.",
