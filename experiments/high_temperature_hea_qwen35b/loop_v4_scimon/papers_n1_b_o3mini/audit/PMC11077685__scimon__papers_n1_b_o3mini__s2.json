      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Processed samples have lower cumulative oxidation mass gains than as-cast samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Processed samples have a higher activation energy for oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
