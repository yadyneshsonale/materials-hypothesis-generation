      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial continuous-B2 state has high strength but very limited ductility.",
