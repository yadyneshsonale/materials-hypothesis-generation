      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 can achieve elongation of approximately 25% or higher.",
