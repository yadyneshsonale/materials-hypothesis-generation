      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC regions are soft and deformable, whereas the B2 regions are hard and strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::rubric_card::000::ade5504bfd"
      ],
      "same_system": "yes"
    },
    {
