      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reported testing domain is uniaxial compression at room temperature and 600 °C.",
      "field": "boundary",
