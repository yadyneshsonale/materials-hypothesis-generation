  "claims": [
    {
      "text": "Controlled elemental substitution can tune the magnetic behavior of AlCoFeNi-based high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled elemental substitution can tune the magnetocaloric behavior of non-equiatomic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co is treated as a ferromagnetic element and Cr as an antiferromagnetic element in the proposed substitution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Partially replacing Co with Cr modifies phase decomposition in AlCoFeNi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial material is a non-equiatomic AlCoFeNi-like alloy with predominantly ferromagnetic ordering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Arc melting followed by annealing at 600 °C or 1000 °C is an applicable processing route for these alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing temperature affects phase separation and chemical ordering in AlCoFeNi-based alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr substitution can produce a dual B2 plus BCC microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dual-phase microstructure specifically consists of an ordered B2 matrix containing finer BCC precipitates as a result of substitution and thermal processing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing ferromagnetic Co with antiferromagnetic Cr alters the balance of magnetic exchange interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co-to-Cr substitution changes the magnetic ordering temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changes in magnetic ordering temperature adjust the magnitude and temperature range of the magnetocaloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetic entropy change is sensitive to the nature of the magnetic transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Cr substitution systematically reduces saturation magnetization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr substitution shifts the Curie temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr substitution can optimize magnetic entropy change near the magnetic transition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-free AlCoFeNi baseline has a higher saturation magnetization than the alloy in which half of the Co is replaced by Cr.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-free baseline has a transition temperature less favorable for low-dimensional magnetocaloric applications.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Cr may detrimentally suppress magnetization.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive Cr may create unwanted brittle phases that limit the useful tuning range.",
      "field": "boundary",
      "needs_support": true,
