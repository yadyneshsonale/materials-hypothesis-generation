  "claims": [
    {
      "text": "The starting material is a mixture of high-purity Ta, Nb, Hf, Zr, Ti, or similar refractory elements with elemental Cu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refractory-element/Cu precursor mixture can be arc-melted in a Ti-gettered high-purity argon atmosphere.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "The melt can be drop-cast into a water-cooled copper mold.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "Repeated remelting ensures precursor homogeneity.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "A water-cooled copper mold produces rapid solidification.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "The copper mold acts as a high-efficiency heat sink.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heat extraction freezes in the composite microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling limits undesirable interdiffusion between the refractory phase and Cu.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "There is a significant positive heat of mixing between the refractory alloying elements and Cu.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling suppresses extensive interdiffusion associated with the positive refractory-element/Cu mixing enthalpy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fast heat extraction confines the reaction locally.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limiting interdiffusion reduces segregation and the formation of deleterious intermetallic phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting followed by copper-mold drop-casting enables a large-scale in situ reaction despite the positive refractory-element/Cu mixing enthalpy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The method will produce a stable, fine-grained composite microstructure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting composite will have minimal interfacial segregation between the refractory phase and Cu.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower cooling or casting without a water-cooled copper mold typically causes unstable microstructures and phase segregation in refractory/Cu composites.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The method's success depends on refractory-alloy composition and cooling rate, and insufficient heat extraction may permit undesirable mixing.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative effects of rapid solidification on phase stability and mechanical properties across different refractory/Cu compositions remain uncharacterized.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
