      ],
      "same_system": "yes"
    },
    {
      "text": "The MgAlTiVFeCo alloy is consolidated by spark plasma sintering at 1000 °C and designated LW1000.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The comparison variants are sintered at 850, 900, and 950 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy's corrosion behavior is evaluated in 3.5 wt% NaCl solution.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "LW1000 is exposed to simultaneous elevated-temperature, corrosive, and tribological-wear conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sintering at 1000 °C causes surface enrichment or segregation of Al and Fe.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al and Fe surface enrichment produces a continuous spinel-type oxide passive film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film formed on LW1000 is dense and acts as a protective passive barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective layer changes corrosion from direct metal/solution attack to a diffusion-controlled process.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces ion penetration during combined mechanical wear and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "LW1000 has a passive-film resistance at least one order of magnitude higher than the relevant resistance values of the lower-temperature variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "LW1000 has a lower corrosion current density than the lower-temperature variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "LW1000 exhibits superior tribo-corrosion degradation resistance relative to lower-sintering-temperature variants.",
      "field": "hypothesis",
