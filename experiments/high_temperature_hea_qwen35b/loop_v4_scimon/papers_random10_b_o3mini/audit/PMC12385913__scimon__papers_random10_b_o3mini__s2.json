      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy is primarily a single-phase refractory solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The W-Ta-Cr-V-Hf alloy can be produced by magnetron sputtering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Temperatures above 1000 K and intense ion or neutron irradiation are representative of plasma-facing fusion conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent phase boundaries in the refined microstructure promote interstitial-vacancy recombination.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent phase boundaries inhibit irradiation-induced phase decomposition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice distortion and chemical complexity prevent irradiation defects from agglomerating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppression of defect agglomeration allows the alloy to maintain mechanical integrity under irradiation and thermal loads.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The constituent elements tend to produce shorter-lived activation products.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
