  "claims": [
    {
      "text": "A quinary W-Ta-Cr-V-Hf refractory high-entropy alloy can serve as a low-activation structural material for fusion plasma-facing components.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy's complex chemical environment and refined microstructure enhance thermal stability and irradiation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::rubric_card::000::e41fdc0efc"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy can limit the buildup of long-lived activation products.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has a nanoscale grain structure.",
