        "PMC8510135::rubric_card::000::d6d90d1989"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanically alloyed refractory high-entropy alloys can be consolidated by SPS at approximately 1200–1400 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
