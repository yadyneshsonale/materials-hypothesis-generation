        "PMC8510135::rubric_card::000::d6d90d1989"
      ],
      "same_system": "yes"
    },
    {
      "text": "SPS acts synergistically with the fine, defect-rich powder microstructure to enable densification at reduced temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced-temperature route will retain a refined grain structure after full densification.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduced-temperature route may provide mechanical properties comparable to or better than conventional high-temperature processing.",
      "field": "predicted_outcome",
      "needs_support": true,
