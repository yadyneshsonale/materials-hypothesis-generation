      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if coated samples do not show measurably less oxide formation or instead show oxidation damage and mechanical degradation similar to the uncoated reference.",
      "field": "falsification_experiment.falsification_rule",
