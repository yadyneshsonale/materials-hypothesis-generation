  "claims": [
    {
      "text": "The starting material is an as-cast or homogenized FeNiCrMn high-entropy alloy with no prior cold work.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature- and strain-rate-dependent tensile/compression testing followed by microscopy can characterize the mechanical properties and active deformation mechanisms.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Relevant strain rates range from 10^-3 to 10^-1 s^-1 and relevant test temperatures extend from approximately 25°C to at least 700°C.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "FeNiCrMn will exhibit yield strength and ductility comparable to or exceeding conventional austenitic stainless steels.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "FeNiCrMn has a random solid-solution microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocation slip and mechanical twinning are active deformation modes in FeNiCrMn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Multiple principal elements produce solid-solution strengthening in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-induced plasticity promotes both high strength and reasonable ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "FeNiCrMn will retain superior strength over a broad temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "FeNiCrMn will retain adequate elongation over a broad temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical twinning will be more prevalent at lower temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocation-based deformation will dominate at higher temperatures.",
