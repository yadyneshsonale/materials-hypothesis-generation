  "claims": [
    {
      "text": "Adding 5–10 at.% Al to a CoCrFeMnNi-based HEA will enhance ductility while retaining moderate strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial CoCrFeMnNi alloy is equiatomic.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7229066::chunk::001::introduction::80504fe1f3"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast equiatomic CoCrFeMnNi has a single-phase FCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 5–10 at.% Al addition is an appropriate intervention for the CoCrFeMnNi matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "A solution treatment near 1150 °C is appropriate for the proposed Al-modified alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomistic modeling can be applied to Al-containing Cr-Co-Fe-Ni high-entropy alloys to study structural, chemical, and deformation behavior.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed Al addition and processing will stabilize an FCC structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Al addition will modify the alloy's stacking-fault energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Modified stacking-fault energy will enhance dislocation motion and partial-dislocation activity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al modifies local chemical ordering in the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Al-induced changes in local chemical ordering and stacking-fault energy promote a combination of dislocation slip and twinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The promoted combination of slip and twinning increases ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al modification will increase tensile elongation by approximately 10–20% relative to undoped CoCrFeMnNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ductility increase will occur with minimal sacrifice to yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped CoCrFeMnNi exhibits approximately 40–50% tensile elongation and 200–300 MPa yield strength.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::001::introduction::80504fe1f3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excess Al may produce unwanted brittle phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanical response may vary at elevated temperatures or nonstandard strain rates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Al concentration for ductility requires empirical validation, and processing variations may degrade performance.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
