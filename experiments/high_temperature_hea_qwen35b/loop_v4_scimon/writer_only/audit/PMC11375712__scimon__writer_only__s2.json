  "claims": [
    {
      "text": "Mössbauer spectroscopy can detect the presence of ferromagnetic ground states in materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The material is ferromagnetic at low temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Detection can be performed using a Mössbauer measurement with a gamma-ray source and detector.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The measurement is to be conducted at approximately 4.2 K under an external magnetic field of approximately 1 T.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant structural mediator is the magnetic moment of iron nuclei.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The detection mechanism is nuclear gamma-ray resonance absorption and emission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ferromagnetic state will produce at least a 6% increase in absorption-peak intensity relative to the paramagnetic state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The absorption-peak intensity can be measured in counts per second.",
      "field": "predicted_outcome",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The material is paramagnetic at approximately 300 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed operating range is 4.2–300 K and 0–1 T.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Measurement accuracy may depend on sample quality, instrument calibration, and data-analysis procedures.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low-temperature spectrum should be compared with the high-temperature spectrum of a known ferromagnetic material.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Absorption-peak intensity and magnetic hyperfine field are the proposed measured variables.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is considered falsified if the absorption-peak intensity increase is below 3% or if no magnetic hyperfine field is detectable.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
