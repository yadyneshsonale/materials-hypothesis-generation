      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Bulk FeCuCrCoNi HEA is the baseline for evaluating nanoparticle melting-point changes.",
