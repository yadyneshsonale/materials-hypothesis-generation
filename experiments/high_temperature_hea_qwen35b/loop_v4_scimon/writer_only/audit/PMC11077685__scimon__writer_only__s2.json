  "claims": [
    {
      "text": "Anodization can enhance the oxidation resistance of aluminum alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The material is AA6061 aluminum alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial aluminum surface is in a native, unoxidized state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Anodization in 15% sulfuric acid at 20°C and 20 V for 60 minutes is the proposed treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anodization is performed at constant voltage and atmospheric pressure.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Anodization produces an amorphous Al2O3 surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anodization process forms a thick Al2O3 layer on the aluminum surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion lowers the oxidation rate of the aluminum alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The specified anodization treatment will reduce the oxidation rate by 30% relative to untreated AA6061.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant oxidation-rate boundary is below 0.05 mg/cm²/h.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of oxidation-rate reduction depends on alloy composition, anodization conditions, and environmental factors.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to achieve at least a 20% lower oxidation rate than untreated AA6061 would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
