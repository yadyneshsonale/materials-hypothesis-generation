      ],
      "same_system": "unclear"
    },
    {
      "text": "B2-type precipitates can form within a BCC or partially disordered matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::003::discussion::14de281121"
      ],
      "same_system": "unclear"
    },
