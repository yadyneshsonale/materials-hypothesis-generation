      "text": "Precipitate size, volume fraction, and interfacial coherence can be finely controlled by the proposed treatment.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
