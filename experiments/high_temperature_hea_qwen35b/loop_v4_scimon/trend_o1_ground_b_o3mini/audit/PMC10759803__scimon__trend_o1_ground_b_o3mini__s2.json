      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::003::discussion::14de281121"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A process comprising high-temperature solution treatment, rapid quenching, and subsequent aging or thermomechanical treatment induces controlled precipitation.",
