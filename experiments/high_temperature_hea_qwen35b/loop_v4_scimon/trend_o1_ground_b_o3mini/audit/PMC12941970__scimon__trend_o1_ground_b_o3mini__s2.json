  "claims": [
    {
      "text": "RHEAs can exhibit high mechanical strength at elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanocrystalline RHEAs can retain high thermal stability under extreme environments.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108"
      ],
      "same_system": "yes"
    },
    {
      "text": "A sputtered nanocrystalline CuMoTaWV-type RHEA film exhibits high strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::000::abstract::f895614108",
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CuMoTaWV-type RHEA films lack robust self-lubrication at temperatures well above 300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored reactive top layer on an RHEA can oxidize during high-temperature operation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxidation of the engineered top layer produces a stable lamellar or continuous lubricious tribofilm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribofilm acts as an in-situ solid lubricant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lubricious oxide tribofilm minimizes friction at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lubricious oxide tribofilm reduces wear at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The underlying RHEA retains its nanocrystalline high-strength structure while the surface layer oxidizes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC10154406::chunk::000::abstract::f895614108",
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The multilayered coating will provide stable self-lubrication from ambient temperature to significantly above 300 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered coating will have significantly lower friction and wear than a conventional RHEA coating without the reactive layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered coating will maintain high mechanical strength relative to a conventional RHEA coating across the tested temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC10154406::chunk::000::abstract::f895614108",
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Standard RHEA films do not form stable self-lubricating oxide films over an extended temperature range and may consequently suffer increased high-temperature friction and wear.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive consumption of the underlying material by the reactive layer can compromise mechanical integrity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An unstable or non-uniform oxide film can compromise lubrication performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Layer thickness, composition, and interfacial bonding must be optimized to achieve both lubrication and mechanical robustness.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
