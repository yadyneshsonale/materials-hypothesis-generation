  "claims": [
    {
      "text": "Spark plasma sintering reduces the overall sintering temperature for nanostructured ceramics.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
