  "claims": [
    {
      "text": "A plasma-sprayed TiC coating can be used as an interlayer between W and CuCrZr in nuclear-fusion environments.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC has a thermal conductivity of approximately 20 W/mK.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC has a melting point of around 3100°C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC is compatible with both W and CuCrZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC interlayer can act as a diffusion barrier between W and CuCrZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC interlayer can reduce thermal stress at the W-CuCrZr interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting substrates are polycrystalline W and CuCrZr in their as-received conditions.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed TiC coating thickness is 10–20 μm.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed plasma-spraying temperature is 500°C while the substrate temperature is 200°C.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using a spraying temperature of 500°C with a 200°C substrate ensures proper adhesion and coating densification.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Previous plasma-sprayed-coating studies support the selected deposition temperatures.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed environment has a pressure of 10^-5 mbar and a substrate temperature of 200°C.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pressure of 10^-5 mbar is representative of vacuum conditions in some nuclear fusion reactors.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed TiC coating has approximately 5% porosity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed TiC coating has a grain size of approximately 1 μm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC coating prevents interdiffusion between W and CuCrZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thermal conductivity of TiC dissipates heat during plasma exposure and thereby reduces interfacial thermal stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC interlayer is predicted to reduce residual thermal stress at the W-CuCrZr interface by 30% relative to no interlayer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The no-interlayer baseline residual stress is 500 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlling coating thickness and porosity within 10% of their target values is necessary because excessive porosity or thickness variation can compromise thermal conductivity and diffusion-barrier performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
