      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoNiCrFeMn is a single-phase FCC alloy under ambient conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase FCC CoNiCrFeMn exhibits exceptional ductility under ambient conditions.",
