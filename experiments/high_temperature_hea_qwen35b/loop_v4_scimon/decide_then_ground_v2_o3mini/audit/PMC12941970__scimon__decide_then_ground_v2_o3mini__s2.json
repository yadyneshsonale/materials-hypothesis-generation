      ],
      "same_system": "unclear"
    },
    {
      "text": "The lubricious phase will form coherent interfaces with the RHEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The RHEA matrix provides load-bearing capacity and high-temperature strength.",
