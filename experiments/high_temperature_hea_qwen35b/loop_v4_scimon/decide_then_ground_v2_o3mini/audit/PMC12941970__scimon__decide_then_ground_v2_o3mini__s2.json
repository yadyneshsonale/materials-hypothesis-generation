      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intended operating and testing range extends from room temperature to approximately 600–800 °C or higher.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
