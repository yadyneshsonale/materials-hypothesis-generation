      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "yes"
    },
    {
      "text": "MoS2 or a similar phase will form a stable, temperature-resistant lubricating layer during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
