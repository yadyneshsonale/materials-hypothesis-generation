  "claims": [
    {
      "text": "Applying an alumina-based refractory ceramic coating to hot-dip aluminum plating equipment will significantly reduce erosion during prolonged exposure to high-temperature liquid aluminum.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sinking rollers, pulling rollers, and guide plates are commonly made from carbon or alloy steels.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These metallic components suffer direct chemical attack from molten aluminum.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An applied alumina-based ceramic coating can form a coherent and dense barrier on the equipment surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104",
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "Compact alumina layers can act as effective diffusion barriers against further oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina coating is chemically inert toward molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ceramic barrier isolates the metallic substrate from molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ceramic layer resists oxidation at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104",
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "The ceramic layer resists chemical attack by molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preventing contact between molten aluminum and the substrate minimizes interfacial reactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina coating slows diffusion of aluminum into the metallic substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing interfacial reactions and aluminum diffusion reduces substrate corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated components will exhibit significantly lower weight loss or dissolution rates than uncoated components.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina-based coating will extend the service life of hot-dip aluminum plating equipment.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uncoated metallic parts undergo rapid degradation during prolonged contact with high-temperature liquid aluminum.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal cycling stresses, mechanical wear, impact, and inadequate long-term adhesion may limit the coating's protective performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe mechanical abrasion or operation beyond typical temperatures may compromise the coating.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alumina has high-temperature stability.",
