  "claims": [
    {
      "text": "Stainless steel naturally forms an oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The naturally formed oxide layer on stainless steel is inadequate under extreme corrosive conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A DFT-guided plasma oxidation treatment can be applied to stainless steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma oxidation can form a dense and adherent passivation oxide layer on stainless steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "DFT screening can identify optimal passivation oxide phases for incorporation onto the steel surface.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment produces a tailored, uniform, and strongly adherent passivation oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A compact passivation oxide layer can act as a barrier to corrosive species and further oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "DFT can predict oxide compositions having ideal adhesion and chemical inertness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The plasma oxidation treatment deposits a nanostructured oxide film on stainless steel.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The surface treatment redefines surface properties without compromising bulk material integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified surface will have a significantly lower corrosion rate than untreated stainless steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment is expected to provide moderate-to-significant corrosion improvement.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment is expected to be effective in high-chloride environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment is expected to be effective in molten-salt environments.",
