  "claims": [
    {
      "text": "An optimized refractory high-entropy alloy enriched in Cr, Al, and Ti can provide superior tribo-corrosion resistance relative to conventional structural alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr, Al, and Ti enrichment promotes formation of a protective oxide during elevated-temperature service.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed HEA may have a single-phase or dual-phase solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial alloy lacks a pre-formed passivating oxide.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A refractory HEA can form an external protective oxide scale at temperatures of 1000–1100 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant service environment combines temperatures around or above 900 °C with sustained sliding wear in a corrosive medium.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale may contain Cr-rich oxide, alumina, or mixed oxides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale is dense and stable under the proposed service conditions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide adheres to the substrate and remains intact under mechanical stress.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale self-heals after transient wear damage.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated Cr, Al, and Ti levels cause rapid formation of a protective passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide acts as a diffusion barrier that suppresses further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The high-entropy nature of the alloy slows elemental diffusion under tribological stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower elemental diffusion prevents rapid oxide spallation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide-related mechanism mitigates synergistic damage from wear and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A protective external oxide scale can lower high-temperature oxidation-related mass gain in a refractory HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized HEA will exhibit significantly less oxide-scale growth than conventional structural alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The optimized HEA will exhibit less wear-induced material loss than conventional structural alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional alloys and unenriched HEAs are more susceptible to oxide breakup and accelerated combined degradation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory HEAs possess elevated-temperature strength, hardness, thermal stability, and softening resistance relevant to structural use.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
