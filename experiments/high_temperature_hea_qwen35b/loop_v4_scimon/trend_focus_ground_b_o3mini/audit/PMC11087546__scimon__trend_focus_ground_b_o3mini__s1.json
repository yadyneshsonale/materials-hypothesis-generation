      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An integrated machine-learning framework can identify optimized thermo-mechanical treatment parameters.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Machine-learning predictions can be used to implement a stepwise thermo-mechanical route that produces multiple coherent nanoprecipitates.",
