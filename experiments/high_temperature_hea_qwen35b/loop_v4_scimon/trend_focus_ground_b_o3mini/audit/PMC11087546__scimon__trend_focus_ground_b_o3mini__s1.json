      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed route will produce a statistically significant simultaneous increase in ultimate tensile strength and ductility relative to conventionally processed samples.",
