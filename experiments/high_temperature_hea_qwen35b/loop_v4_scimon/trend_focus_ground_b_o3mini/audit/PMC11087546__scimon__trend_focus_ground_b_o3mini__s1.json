      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combination of dislocation pinning and coherent-interface slip transmission prolongs plastic deformation while retaining high strength.",
