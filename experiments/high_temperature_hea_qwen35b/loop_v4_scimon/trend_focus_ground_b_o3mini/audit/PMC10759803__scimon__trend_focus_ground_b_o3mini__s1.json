    {
      "text": "Coherent precipitate interfaces obstruct dislocation motion and thereby enhance strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent precipitate interfaces facilitate dislocation transmission and thereby help accommodate strain.",
