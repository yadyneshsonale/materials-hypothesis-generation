      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr has high atomic packing efficiency.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The negative heat of mixing and high atomic packing efficiency associated with Zr disrupt crystal nucleation during rapid solidification.",
