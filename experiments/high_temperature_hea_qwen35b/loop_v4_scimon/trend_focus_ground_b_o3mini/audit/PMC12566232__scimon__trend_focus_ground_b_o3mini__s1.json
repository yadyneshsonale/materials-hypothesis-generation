  "claims": [
    {
      "text": "The as-developed HfZrTi alloy has brittle, limited-ductility and limited-toughness behavior.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled Nb addition will improve the ductility of HfZrTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled Nb addition will improve the toughness of HfZrTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfZrTi-based alloy has a primarily BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Nb to HfZrTi will promote formation of a minor FCC or other ductile secondary phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb is an FCC-forming element in the proposed HfZrTi-Nb system.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb will stabilize a ductile phase in HfZrTi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ductile phase will improve dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved dislocation mobility will enhance strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism will relieve local stress concentrations and delay crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will have greater tensile ductility than unmodified HfZrTi at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will have greater fracture toughness than unmodified HfZrTi at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect of Nb is limited to a narrow concentration window.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Nb could cause unwanted phase separation or degrade other mechanical properties.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb concentrations of 2, 5, and 8 atomic percent are proposed for comparative testing.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A greater than 10% increase in both ductility and fracture toughness is the proposed threshold for a significant improvement.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
