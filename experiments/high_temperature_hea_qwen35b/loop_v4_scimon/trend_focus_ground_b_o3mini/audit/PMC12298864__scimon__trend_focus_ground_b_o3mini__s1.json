      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::004::materials::575bdb9cc7",
        "PMC6926650::chunk::004::discussion::91e539d6b2"
      ],
      "same_system": "unclear"
    },
