      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The superconducting state of the modified HEA will exhibit magnetic-field expulsion through the Meissner effect.",
