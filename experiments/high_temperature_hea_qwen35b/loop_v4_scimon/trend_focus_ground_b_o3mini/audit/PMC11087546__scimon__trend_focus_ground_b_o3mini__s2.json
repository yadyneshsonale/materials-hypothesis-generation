  "claims": [
    {
      "text": "A data-driven machine-learning approach can optimize standard thermomechanical processing parameters to produce heterostructured architectures in conventional alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heterostructured architectures can simultaneously enhance alloy strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "Typical strengthening methods such as dislocation strengthening and grain refinement increase strength at the cost of ductility in conventional alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial conventional alloy has a homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Machine-learning models can correlate thermal cycles and deformation schedules with microstructural descriptors sufficiently to design and control heterostructures.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gradient or bimodal structures can provide engineered distributions of soft and hard regions.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant strength-ductility trade-off occurs under room-temperature tensile testing conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent boundaries between softer and harder regions promote distributed plasticity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "A heterogeneous structure creates an inhomogeneous strain distribution by activating multiple deformation mechanisms at phase interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent interfaces facilitate dislocation transmission and relieve local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "Stress relief at heterointerfaces delays premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "An ML-optimized heterostructured alloy will improve both tensile strength and ductility relative to a homogeneous baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "Improved strain distribution will preserve or increase strength while improving ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "A uniform high-strength baseline microstructure has low ductility because of early crack initiation and localized strain concentration.",
