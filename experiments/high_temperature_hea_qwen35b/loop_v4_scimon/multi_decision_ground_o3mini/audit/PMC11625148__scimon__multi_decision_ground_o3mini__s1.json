      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealed copper will be more ductile than similarly processed non-FCC materials or work-hardened copper.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
