      ],
      "same_system": "no"
    },
    {
      "text": "The availability of multiple active slip systems contributes to copper's high ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed initial copper is well annealed, has an ordered FCC microstructure, and is free of significant impurities or precipitates.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper's closely packed FCC arrangement provides numerous low-energy slip systems.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low stacking-fault energy facilitates the nucleation and propagation of partial dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "Low stacking-fault energy facilitates the formation of deformation twins.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "Partial-dislocation and twinning activity distributes strain and prevents localized stress concentrations that could cause brittle fracture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
