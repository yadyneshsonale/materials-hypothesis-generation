  "claims": [
    {
      "text": "A nanostructured, compositionally graded refractory HEA interlayer can bridge the property mismatch between W and CuCrZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HEA interlayer will improve adhesion and durability under fusion reactor conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "W and CuCrZr are typically used as plasma-facing and heat-sink materials, respectively.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Directly bonded W and CuCrZr have significant thermal-expansion and chemical mismatches.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A refractory HEA interlayer can be fabricated by magnetron sputtering or additive manufacturing.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed interlayer contains Cr, Zr, and other refractory components.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "The interlayer composition can be graded from W toward CuCrZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A graded interlayer minimizes abrupt compositional and microstructural differences at the W/CuCrZr interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing abrupt interfacial differences reduces stress concentrations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The gradual composition change in the HEA interlayer mitigates thermal-expansion mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HEA interlayer inhibits brittle intermetallic formation by providing chemical compatibility at both interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The graded HEA interlayer will enhance interfacial adhesion relative to direct W-to-CuCrZr bonding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The graded HEA interlayer will reduce thermal stresses and improve resistance to cracking and degradation under thermal and irradiation loads.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "Direct W-to-CuCrZr bonding commonly produces poor adhesion and brittle phases under high-temperature, high-stress conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficient control of the graded interface may prevent the expected performance improvements.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term irradiation may induce unexpected phase changes in the HEA interlayer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal HEA composition, processing parameters, and long-term irradiation stability remain experimentally unvalidated.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
