  "claims": [
    {
      "text": "Annealed copper exhibits superior ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper has a face-centered cubic crystal structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An FCC crystal structure provides approximately 12 slip systems.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multiple slip systems of FCC copper facilitate smooth and extensive dislocation motion under tensile stress.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::001::introduction::d83bb5753a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealed, recrystallized copper has a low dislocation density.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed copper is a pure, single-phase FCC material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tensile loading at ambient conditions can be combined with in situ TEM straining to observe copper deformation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Avoiding extreme temperatures and high strain rates prevents those variables from altering the operative deformation mechanisms.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high number of FCC slip systems permits uniform plastic deformation and thereby enhances ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::chunk::001::introduction::316f02dec2",
        "PMC8398136::chunk::001::introduction::d83bb5753a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation nucleation and propagation are important deformation processes in copper.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::001::introduction::d83bb5753a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The annealed state minimizes obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed copper will exhibit significant plastic elongation before failure under tensile loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::001::introduction::d83bb5753a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Multiple slip systems will be visibly activated in TEM before failure of annealed copper.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cold-worked copper has higher dislocation density and potentially inhibited slip activity relative to annealed copper.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cold-worked copper is expected to have lower plasticity and ductility than annealed copper under similar conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Metals with fewer active slip systems are expected to have lower plasticity and ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperatures or high strain rates, deformation mechanisms other than those proposed may dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact elongation percentage and strain-hardening rate remain to be determined experimentally.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
