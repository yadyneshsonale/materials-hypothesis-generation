      ],
      "same_system": "no"
    },
    {
      "text": "Synergistic interphase interactions prevent agglomeration of the lubricant phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent or synergistic interphase interactions reduce premature failure.",
