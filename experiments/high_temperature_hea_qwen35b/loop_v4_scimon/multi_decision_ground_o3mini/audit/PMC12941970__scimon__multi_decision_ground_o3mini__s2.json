  "claims": [
    {
      "text": "Soft layered lubricants such as MoS2 or graphite provide low friction.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Systems based on soft layered lubricants have poor mechanical strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
