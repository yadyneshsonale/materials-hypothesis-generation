      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent matrix-lubricant interfaces enable efficient interphase load transfer.",
