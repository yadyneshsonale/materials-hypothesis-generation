  "claims": [
    {
      "text": "Adding layered h-BN to a high-strength ceramic matrix will produce a self-lubricating composite.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
