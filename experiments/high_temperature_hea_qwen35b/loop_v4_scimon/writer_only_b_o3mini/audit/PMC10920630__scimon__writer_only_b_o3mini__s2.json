  "claims": [
    {
      "text": "A thin, dense CrN coating can be deposited on stainless steel by Physical Vapor Deposition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A PVD-deposited CrN coating improves the corrosion resistance of stainless steel in extreme environments.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard stainless steel has a native oxide-based passive film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The native passive film can be insufficient in high-chloride or high-temperature oxidizing environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "PVD deposition can produce a uniformly dense and adherent CrN coating on stainless steel.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A dense CrN coating acts as a barrier that minimizes exposure of the steel substrate to corrosive species.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrN provides a chemically inert surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrN provides a mechanically robust surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The CrN coating slows the ingress of chloride ions and oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower ingress of corrosive agents reduces localized corrosion and overall degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrN-coated stainless steel will have a lower corrosion rate than uncoated stainless steel under extreme corrosive conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrN-coated stainless steel will retain better surface integrity than uncoated stainless steel under extreme corrosive conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating is expected to be most effective when chemical corrosion predominates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical stress or abrasive wear may require alternative or supplemental surface modification.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of corrosion-resistance improvement may vary with coating thickness and deposition parameters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term adhesion under cyclic corrosion conditions may affect the magnitude of improvement.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
