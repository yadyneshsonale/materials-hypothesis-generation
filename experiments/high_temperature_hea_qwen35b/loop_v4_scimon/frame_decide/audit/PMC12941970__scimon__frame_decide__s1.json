      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The textured pores or channels can be impregnated with MoS2 or WS2 as a high-temperature lubricant.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pores or channels store lubricant.",
