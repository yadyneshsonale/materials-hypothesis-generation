  "claims": [
    {
      "text": "MoNbTaW is a refractory high-entropy alloy with a BCC structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "RHEAs are candidate materials for elevated-temperature applications because of their high-temperature strength and resistance to softening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe",
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "Plastic deformation in BCC MoNbTaW is strongly temperature-dependent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Both edge and screw dislocations play important roles in the plastic deformation of MoNbTaW RHEA.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed initial material is polycrystalline and undeformed.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The MoNbTaW lattice is distorted by the presence of multiple principal elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical testing should span room temperature through elevated temperatures while deformation is monitored in situ.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant structural mediator is the configuration and relative mobility of screw and edge dislocations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "At lower temperatures, deformation is primarily controlled by thermally limited double-kink nucleation of screw dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing temperature enhances edge-dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature variation changes the activation-energy barriers for dislocation motion in MoNbTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twinning or a minor phase transformation may become active at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature causes a transition from screw-dislocation-controlled deformation to deformation dominated by more mobile edge dislocations.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "MoNbTaW has high yield stress at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperature will reduce the yield strength of MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperature will increase the ductility of MoNbTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperature will increase macroscopic plastic strain rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature baseline data show higher yield strength and deformation dominated by screw-dislocation double-kink processes.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::chunk::000::abstract::42ea6c8bbe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted regime is limited to temperatures below those at which excessive grain-boundary sliding or major microstructural degradation occurs.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At sufficiently high temperature, other softening mechanisms or instabilities may override the predicted dislocation-mediated behavior.",
      "field": "boundary",
