      ],
      "same_system": "no"
    },
    {
      "text": "A tailored modified MEAM/EAM-type interatomic potential can capture the size-dependent behavior of FeCuCrCoNi nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Smaller FeCuCrCoNi nanoparticles have lower thermal stability than larger nanoparticles.",
