    {
      "text": "Smaller FeCuCrCoNi nanoparticles will undergo faster atomic rearrangements during heating than larger nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
