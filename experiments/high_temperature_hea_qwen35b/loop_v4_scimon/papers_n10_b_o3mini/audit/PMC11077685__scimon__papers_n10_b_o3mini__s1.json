  "claims": [
    {
      "text": "Stationary friction processing enhances the oxidation resistance of AlCoCrFeNi high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain refinement produced by stationary friction processing mediates the improvement in oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stationary friction processing promotes the formation of dense, protective oxide scales.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast AlCoCrFeNi alloy has coarse grains of approximately 98 μm.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast AlCoCrFeNi alloy has a BCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast microstructure tends to form nonprotective spinels during oxidation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stationary friction processing can be performed with a 12 mm WC cylindrical tool at 400 or 1800 rpm for 5 minutes.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant oxidation tests use laboratory air at 850, 950, and 1050 °C for up to 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stationary friction processing refines the grain size from 98 μm to about 1 μm at 400 rpm and 0.43 μm at 1800 rpm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stationary friction processing causes a BCC/B2-to-FCC transformation, yielding FCC fractions of 38% at 400 rpm and 55% at 1800 rpm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Surface free energy increases after stationary friction processing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ultrafine-grained processed material has a high density of grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
      "text": "The increased grain-boundary density facilitates rapid outward diffusion of chromium ions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outward chromium diffusion forms a dense Cr2O3 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inward oxygen diffusion produces an Al-rich inner oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed microstructure suppresses the formation of nonprotective spinels.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stationary friction processing decelerates oxidation kinetics by 12–20% at 400 rpm and 38–48% at 1800 rpm relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "yes"
    },
    {
