  "claims": [
    {
      "text": "An in-situ reinforced NbMoCrTiAl refractory high-entropy alloy composite can serve as a low-activation structural material for high-temperature plasma-facing components in fusion reactors.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC and Al2O3 reinforcement phases form in situ in the NbMoCrTiAl matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiC and Al2O3 reinforcement phases are fine particles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-energy planetary ball milling followed by spark plasma sintering produces the reinforced NbMoCrTiAl composite.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The composite is intended to operate above 1000 °C under fusion-relevant neutron irradiation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The composite microstructure contains approximately 60% BCC solid-solution matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The composite microstructure contains approximately 32% TiC.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The composite microstructure contains approximately 7% Al2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Second-phase particle strengthening enhances the alloy's high-temperature mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain refinement enhances the alloy's high-temperature mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon and oxygen provide solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reinforced microstructure improves high-temperature oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb, Mo, Cr, Ti, and Al are less prone than tungsten or tantalum to generating long-lived neutron-induced radioisotopes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed composite can achieve a compressive strength around 1500 MPa or higher at high temperature.",
      "field": "predicted_outcome",
