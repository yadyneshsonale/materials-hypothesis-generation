        "PMC5978046::rubric_card::000::c87a8ff254"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined process enables large-scale in situ reactive synthesis of RHEA-Cu composites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined process yields a stable, fine-grained RHEA-Cu microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
