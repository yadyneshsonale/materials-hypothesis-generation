      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::rubric_card::000::89abe9615e"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging changes the morphology and coherency of boundaries between constituent phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
