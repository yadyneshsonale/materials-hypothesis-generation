      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature XRD resolution may limit detection of transformations.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
