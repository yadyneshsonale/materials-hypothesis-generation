      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11",
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "A defined heating rate can be used during high-temperature oxidation testing.",
