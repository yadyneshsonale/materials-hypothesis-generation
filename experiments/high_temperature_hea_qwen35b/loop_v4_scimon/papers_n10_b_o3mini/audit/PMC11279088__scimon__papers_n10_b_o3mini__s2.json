      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "In situ XRD thereby links oxidation kinetics with phase stability.",
