      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial room-temperature XRD pattern of the unoxidized alloy serves as the baseline.",
      "field": "baseline",
      "needs_support": false,
