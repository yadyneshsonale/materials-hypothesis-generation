      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxide phases such as spinels or complex oxides form and evolve during the proposed in situ experiment.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature transitions within the alloy matrix modify its diffraction pattern.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Heating an alloy in an oxidizing environment causes new oxide phases to form.",
