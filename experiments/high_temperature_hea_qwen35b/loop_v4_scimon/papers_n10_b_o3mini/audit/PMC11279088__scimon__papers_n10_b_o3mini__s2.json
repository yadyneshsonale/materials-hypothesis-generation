      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidation will produce shifted or newly appearing diffraction peaks corresponding to oxide formation and phase transitions.",
