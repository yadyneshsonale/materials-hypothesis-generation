        "PMC11077685::rubric_card::000::9919fb4b11",
        "PMC10142552::rubric_card::000::20ee1126b8"
      ],
      "same_system": "yes"
    },
    {
      "text": "Existing alloy phases may transform during high-temperature heating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "In situ XRD records the emergence, disappearance, and shifts of diffraction peaks during heating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changes in diffraction peaks can be matched to specific phase transformations.",
