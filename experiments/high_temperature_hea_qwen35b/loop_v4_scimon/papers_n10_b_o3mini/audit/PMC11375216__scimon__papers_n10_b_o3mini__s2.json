  "claims": [
    {
      "text": "The material is an equiatomic HfNbTaTiZr refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equiatomic HfNbTaTiZr can be synthesized from a powder blend containing hydrides and vacuum-sintered at 1400 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Vacuum sintering at 1400 °C produces a nearly fully densified HfNbTaTiZr alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid quenching produces a metastable single beta-BCC phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The rapid-quenched alloy is a homogeneous, nearly fully random solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling after sintering produces a multiphase microstructure in HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slow cooling promotes the formation of chemical short-range-order precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SRO precipitates form at both intragranular and intergranular regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates act as additional phonon-scattering centers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO precipitates introduce additional interfaces into the lattice.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additional interfaces increase phonon scattering and reduce the phonon mean free path.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reduced phonon mean free path lowers the lattice contribution to thermal conductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO-containing HfNbTaTiZr will have lower lattice thermal conductivity than the fully random solid-solution state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lattice thermal-conductivity decrease is likely to be in the range of 10–30%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fast-quenched beta-BCC HfNbTaTiZr has relatively higher phonon mean free paths and lattice thermal conductivity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phonon transport dominates heat conduction from ambient to moderately high temperatures in this alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SRO-induced reduction should be most pronounced where phonon conduction dominates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At very high temperatures, other conduction mechanisms or saturation effects may make the reduction less significant.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the conductivity decrease depends on the density, size, and distribution of the SRO precipitates.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
