        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "unclear"
    },
    {
      "text": "RHEAs contain multiple principal elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700",
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "Combining refractory elements is an RHEA alloy-design strategy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The refractory elements should have different atomic sizes.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75",
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A random distribution of multiple elements with different atomic radii produces severe local lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Severe local lattice distortion impedes dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation motion causes pronounced strengthening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "RHEAs are intended for use at elevated temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700",
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed design yields high hardness and strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75",
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed design yields high ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "unclear"
    },
    {
      "text": "RHEAs exhibit exceptional resistance to softening at elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "Traditional alloy design relies on one or two principal components rather than multiple principal components.",
