      "support": "partial",
      "supporting_ids": [
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "The solid-solution microstructure of AlCoCrFeNi-based alloys provides high hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled laser-cladding conditions improve interfacial bonding and impede crack formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated composite will have greater hardness than uncoated Cu.",
