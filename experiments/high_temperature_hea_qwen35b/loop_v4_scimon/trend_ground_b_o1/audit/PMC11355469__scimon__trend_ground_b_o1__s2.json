  "claims": [
    {
      "text": "The initial substrate is pure Cu without a protective coating.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An AlCoCrFeNi-based high-entropy alloy can be deposited onto Cu by laser cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser-cladding an AlCoCrFeNi-based coating onto Cu will produce strong metallurgical bonding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated Cu will have better wear resistance than uncoated Cu.",
