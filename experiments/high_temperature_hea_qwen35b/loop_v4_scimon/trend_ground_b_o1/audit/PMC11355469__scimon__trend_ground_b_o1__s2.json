      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::chunk::001::introduction::c558c6fff9"
      ],
      "same_system": "no"
    },
    {
      "text": "Optimizing laser power, scanning speed, interlayer selection, or process-gas flow can ensure good bonding at the Cu/HEA interface.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized laser-cladding conditions can minimize cracking at the Cu/HEA interface.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid solidification during laser cladding causes partial intermixing between Cu and the AlCoCrFeNi-based layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid solidification produces a stable Cu/AlCoCrFeNi-based interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy in AlCoCrFeNi-based alloys promotes a stable solid-solution microstructure.",
