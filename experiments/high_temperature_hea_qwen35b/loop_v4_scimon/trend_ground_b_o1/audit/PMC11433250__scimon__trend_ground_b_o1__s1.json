  "claims": [
    {
      "text": "WVTaTiCr-based refractory high-entropy alloy coatings can be deposited on steel by laser cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The laser-cladded WVTaTiCr coating should be approximately 300–500 µm thick.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suitable laser-cladding parameters are approximately 1.4–1.6 kW power and 8–10 mm/s scan speed.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding will form a dense coating layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The cladding layer will be enriched in refractory elements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will contain aluminum-rich protective phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will contain chromium-rich protective phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aluminum- and chromium-rich phases will act as diffusion barriers against molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory high-entropy alloys have high-temperature stability and retain useful mechanical properties at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing chromium content improves the high-temperature oxidation and corrosion resistance of WVTaTiCr-based coatings.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Synergistic strengthening by multiple principal elements causes the proposed corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Appropriate additions of chromium can promote a dense protective oxidation film in refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective oxide scales on WVTaTiCr coatings will impede attack by molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A WVTaTiCr-based coating will significantly reduce erosion and corrosion during prolonged exposure to molten aluminum.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will prolong the service life of rollers and guide plates relative to uncoated steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uncoated steel rollers suffer severe corrosion and short service life in molten-aluminum plating baths.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Direct data for WVTaTiCr coatings in molten-aluminum environments are limited.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term performance will depend on coating integrity, molten-bath chemistry, and processing parameters.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Existing WVTaTiCr coating studies report promising high-temperature oxidation and general corrosion resistance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "yes"
    }
  ],
