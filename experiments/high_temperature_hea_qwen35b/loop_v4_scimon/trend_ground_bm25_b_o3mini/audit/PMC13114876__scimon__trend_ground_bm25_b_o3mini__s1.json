      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored AlCoCrFeNi-based HEAs will have lower wear rates under high-temperature tribo-corrosion than untailored HEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored AlCoCrFeNi-based HEAs will have lower corrosion loss under tribo-corrosion than untailored HEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
