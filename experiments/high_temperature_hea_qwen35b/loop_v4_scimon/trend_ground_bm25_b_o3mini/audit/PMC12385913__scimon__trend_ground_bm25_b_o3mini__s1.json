  "claims": [
    {
      "text": "Ta, V, and Cr are low-activation refractory alloying elements suitable for addition to tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A W-Ta-V-Cr composition can form a refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tungsten-based refractory HEA containing selected low-activation elements can provide the low activation, high-temperature strength, and irradiation resistance required for fusion plasma-facing components.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc",
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional tungsten has a high melting point and high thermal conductivity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional tungsten suffers from brittleness and very low fracture toughness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tungsten is susceptible to irradiation- or plasma-particle-induced damage under fusion conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd",
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional tungsten exhibits moderate activation under neutron exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fusion plasma-facing materials must operate at temperatures of at least 1000 K while exposed to plasma particles and neutrons.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd",
        "PMC6397024::chunk::001::introduction::6f2d9e1dbc"
      ],
      "same_system": "yes"
    },
    {
      "text": "Multi-element alloying of tungsten will refine its microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Multi-element alloying will enhance phase stability in the tungsten-based alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined and phase-stable microstructure will suppress grain growth and defect-cluster coalescence during irradiation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stable, fine-grained refractory microstructure will resist radiation damage and high-temperature degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "Excluding elements that produce long-lived radionuclides will minimize long-lived radioactive species formed after neutron capture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tungsten-based refractory HEA will outperform conventional tungsten and RAFM steels in high-temperature mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed tungsten-based refractory HEA will have greater irradiation resistance than conventional tungsten and RAFM steels.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tungsten-based refractory HEA will have a lower activation signature than conventional tungsten and RAFM steels.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
