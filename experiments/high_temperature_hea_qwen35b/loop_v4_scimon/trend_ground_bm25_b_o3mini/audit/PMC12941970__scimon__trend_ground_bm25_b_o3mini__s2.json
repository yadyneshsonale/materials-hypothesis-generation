  "claims": [
    {
      "text": "Ti3SiC2 is a layered MAX-phase material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incorporating Ti3SiC2 into a high-temperature ceramic matrix with engineered interfacial bonding will maintain high mechanical strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incorporating Ti3SiC2 into a high-temperature ceramic matrix will reduce friction across a wide temperature range.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ceramic matrix inherently has excellent high-temperature strength.",
