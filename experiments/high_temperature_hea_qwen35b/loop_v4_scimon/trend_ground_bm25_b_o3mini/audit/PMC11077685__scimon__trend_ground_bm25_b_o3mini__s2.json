  "claims": [
    {
      "text": "A silicide-based surface coating can significantly enhance the oxidation resistance of high-temperature metal alloys such as Ni-based superalloys or steels.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "Machine-learning optimization contributes to the oxidation-resistance benefit of the coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding can be used to apply the proposed silicide-based coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating promotes formation of a continuous, adherent, protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "Bare Ni-based superalloys or high-performance steels are prone to rapid oxidation and premature scale spallation under oxidizing conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating composition and processing parameters can be optimized by combining high-throughput in situ oxidation measurements with thermodynamic simulations in a machine-learning framework.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid oxidation and scale degradation are known issues over approximately 600–1200 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating forms a dense and uniform oxide layer at its surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating-generated oxide layer may be SiO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating-generated oxide layer may include a complex oxide such as CrTaO4.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimized coating pre-establishes a protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide scale acts as a diffusion barrier to oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale reduces oxidation kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective scale prevents formation of non-protective or spalling oxide layers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated samples will oxidize more slowly than uncoated samples during prolonged high-temperature exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "Coated samples will show lower oxidation-induced mass gain than uncoated samples.",
