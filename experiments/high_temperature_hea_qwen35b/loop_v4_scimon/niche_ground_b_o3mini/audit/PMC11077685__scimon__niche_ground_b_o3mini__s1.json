      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Control of coating composition and thickness enables formation of a stable protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective layer limits oxygen ingress and reduces oxidation of the underlying refractory-alloy substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated samples will have a lower oxidation rate and lower oxide mass gain than uncoated samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
