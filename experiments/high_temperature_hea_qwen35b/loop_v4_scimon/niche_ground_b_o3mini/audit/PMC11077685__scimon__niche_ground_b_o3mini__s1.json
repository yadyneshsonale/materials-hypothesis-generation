      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uncoated refractory alloys exhibit higher oxide mass gain and greater mechanical-property degradation under high-temperature oxidation than protected samples.",
