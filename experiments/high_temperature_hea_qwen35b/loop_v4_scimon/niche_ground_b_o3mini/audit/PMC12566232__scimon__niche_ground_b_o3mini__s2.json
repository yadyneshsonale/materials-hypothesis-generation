      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu-doped HfZrTi is expected to exhibit higher fracture toughness than undoped HfZrTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu doping may cause at most a modest reduction in yield or ultimate tensile strength.",
