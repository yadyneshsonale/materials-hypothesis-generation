      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Compositions outside the optimized window or processing conditions that fail to form the target precipitates will show diminished performance advantages.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnitude of density and mechanical-property improvements may vary with processing precision and compositional tolerance.",
