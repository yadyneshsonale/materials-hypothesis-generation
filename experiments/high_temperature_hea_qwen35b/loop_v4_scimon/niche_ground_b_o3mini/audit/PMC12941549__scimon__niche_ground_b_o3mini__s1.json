  "claims": [
    {
      "text": "High-throughput screening can identify precipitation-strengthened lightweight high-entropy alloys for elevated-temperature applications.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized alloy incorporates lightweight and cost-efficient elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting alloy will have lower density while maintaining or exceeding the mechanical performance of conventional high-temperature alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a",
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial, standard-processed alloy candidate does not yet possess the desired precipitation-strengthened microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Systematic composition adjustment can be performed using high-throughput synthesis.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Post-processing heat treatments will induce fine, uniformly distributed precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy is intended to retain mechanical performance at both ambient and elevated temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a",
        "PMC10759803::chunk::001::introduction::0f933d56a0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The tested loading conditions will mirror standard operational environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator is a combination of nanoscale precipitates and refined grains in the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Optimized addition of lightweight elements reduces the alloy's overall density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The induced precipitates impede dislocation motion and thereby enhance strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy will have 15–30% lower density than conventional alloys such as Ni-based superalloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy will achieve comparable or improved yield strength at ambient and elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::000::abstract::a36e5ecf5a",
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC10759803::chunk::001::introduction::0f933d56a0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy will achieve comparable or improved mechanical toughness at ambient and elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional high-performance alloys generally obtain high strength at the expense of increased density, ductility, or thermal stability.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefits occur only within a composition window optimized by high-throughput screening.",
