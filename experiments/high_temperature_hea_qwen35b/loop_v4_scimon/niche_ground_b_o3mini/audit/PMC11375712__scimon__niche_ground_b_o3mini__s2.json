  "claims": [
    {
      "text": "Spin-polarized DFT with DFT+U and both collinear and non-collinear spin configurations can be used to predict ferromagnetic ground states.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "This computational approach can reliably predict a ferromagnetic ground state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant initial material may be a chemically disordered transition-metal alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::chunk::002::methods::7c4234ec35",
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant initial material may be in a paramagnetic state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed calculations are zero-temperature ground-state calculations.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At zero temperature, thermal fluctuations are negligible.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The atomistic arrangement of transition-metal atoms is the structural mediator of magnetic ordering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Magnetic exchange interactions among transition-metal atoms mediate long-range magnetic ordering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "DFT+U improves the description of electron correlation in localized 3d electrons.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Spin-polarized, non-collinear calculations accurately capture anisotropic exchange interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "If ferromagnetism is favored, the proposed treatment lowers the calculated total energy of the ferromagnetic configuration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A ferromagnetic ground state is identified when the ferromagnetic configuration has lower total energy than non-magnetic and antiferromagnetic configurations.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Calculated magnetic moments and exchange splittings should be consistent with ferromagnetic ordering.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard DFT without DFT+U or non-collinear spin treatment may neglect important electron-correlation effects.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::002::methods::7c4234ec35"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The approach is expected to be most accurate for systems with significant localized d-electron interactions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zero-temperature ground-state calculations do not capture finite-temperature effects.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The approach's applicability to weakly correlated systems is uncertain.",
      "field": "boundary",
      "needs_support": false,
