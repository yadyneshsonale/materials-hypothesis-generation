  "claims": [
    {
      "text": "Conventional materials commonly exhibit a strength-ductility trade-off.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5",
