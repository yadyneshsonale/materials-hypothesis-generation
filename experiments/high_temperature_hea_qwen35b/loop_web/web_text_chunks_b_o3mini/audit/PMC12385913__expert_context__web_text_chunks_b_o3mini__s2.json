  "claims": [
    {
      "text": "WTaTiVZr is an equimolar alloy containing W, Ta, Ti, V, and Zr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ta, Ti, V, and Zr are randomly and homogeneously distributed in the WTaTiVZr alloy.",
      "field": "hypothesis; material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The constituent elements of WTaTiVZr are refractory elements relevant to high-temperature HEAs.",
      "field": "hypothesis; uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5434025::web::005::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Equimolar chemical complexity in WTaTiVZr produces severe lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice distortion in WTaTiVZr produces heterogeneous localized stress fields.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The local stress heterogeneities lower the activation barrier for dislocation nucleation and motion.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice distortion and chemical complexity activate additional slip systems at high temperature.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced dislocation mobility and additional slip systems produce more spatially distributed plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More distributed plastic deformation delays crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten has a comparatively uniform lattice and fewer operative slip systems than WTaTiVZr.",
      "field": "mechanism; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten has a high ductile-to-brittle transition temperature that limits its plasticity and toughness.",
      "field": "mechanism; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical tests at approximately 1000–1600 K, WTaTiVZr will exhibit greater plastic strain to failure than pure tungsten.",
      "field": "conditions; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical tests at approximately 1000–1600 K, WTaTiVZr will exhibit greater fracture toughness than pure tungsten.",
      "field": "conditions; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In-situ microscopy will show more active dislocation motion in WTaTiVZr than in pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In-situ microscopy will show a greater number of activated slip systems in WTaTiVZr than in pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed enhancement applies at plasma-facing-service temperatures of at least 1000 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, insufficient thermal activation may prevent enhanced plasticity and toughness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation or other dominant degradation mechanisms may mask or eliminate the proposed mechanical benefit.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior refractory-HEA observations support the proposition that lattice distortion facilitates dislocation mobility.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5434025::web::005::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Refractory HEAs have previously exhibited substantial high-temperature strength or compressive strain.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5434025::web::005::introduction"
      ],
      "same_system": "no"
    }
  ],
