  "claims": [
    {
      "text": "The alloy has a multiphase eutectic microstructure containing an FCC matrix and secondary σ-type phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The secondary σ phases are hard and strengthen the FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC and σ phases have compositional heterogeneity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A potential difference between the FCC and σ phases produces galvanic corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Phase boundaries act as localized galvanic cells.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The multiphase structure causes non-uniform oxide-film formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differential oxidation rates occur at FCC/secondary-phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide films form on the alloy surface during high-speed friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical loading ruptures the surface oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The ruptured oxide film spalls and exposes fresh reactive metal surfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxide-film rupture leads to adhesive and abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Wear-induced exposure of fresh surfaces further accelerates galvanic corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Galvanic corrosion and oxide-film removal mutually accelerate corrosion and wear under simultaneous exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elevated temperature promotes unstable oxide formation and premature oxide rupture during simultaneous wear and corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to a compositionally similar single-phase HEA, the multiphase eutectic alloy will have higher total degradation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the single-phase baseline, the multiphase alloy will have higher corrosion current density and more localized pitting at phase interfaces.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the single-phase baseline, the multiphase alloy will have a higher wear rate, greater material loss, and deeper wear tracks.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed synergy requires mechanical action and the corrosive environment to be active simultaneously and may not operate under inert or static conditions.",
