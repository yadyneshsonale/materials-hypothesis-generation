  "claims": [
    {
      "text": "The starting CoCrFeNi matrix is coarse-grained.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The starting CoCrFeNi matrix is single-phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A minor reactive additive can precipitate a lubricious, high-temperature-stable phase at the sliding interface.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Sliding of the modified alloy will dynamically form a nanoscale tribofilm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Sliding of the modified alloy will produce shear-induced grain refinement at the contact surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The in situ lubricious phase will lower interfacial shear strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic grain refinement will activate grain-boundary sliding through inverse Hall-Petch behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed tribofilm will continuously regenerate during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tribofilm will adapt to changes in temperature and load.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additive-modified CoCrFeNi alloy will have lower friction than unmodified CoCrFeNi throughout room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additive-modified CoCrFeNi alloy will have a lower wear rate than unmodified CoCrFeNi throughout room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC8470387::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Unmodified CoCrFeNi has variable friction and wear performance over the stated temperature range.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction and wear of unmodified CoCrFeNi increase at higher temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-layer fracture and plastic deformation cause the proposed high-temperature degradation of unmodified CoCrFeNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect will persist under variable normal loads and in both ultra-high vacuum and mildly oxidizing environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect does not require an externally supplied lubricant.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pin-on-disk testing against an unmodified CoCrFeNi control can measure friction and wear from room temperature to 800 °C in controlled atmospheres.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
