      "supporting_ids": [
        "PMC10095688::web::032::4_3_precipitates_properties_and_evolutio"
      ],
      "same_system": "no"
    },
    {
      "text": "The chemically ordered or compositionally heterogeneous regions act as heterogeneous nucleation sites for secondary phases during subsequent aging.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
