      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After identical aging, slow-cooled samples should contain more detectable secondary-phase formation than rapidly quenched samples.",
      "field": "predicted_outcome",
