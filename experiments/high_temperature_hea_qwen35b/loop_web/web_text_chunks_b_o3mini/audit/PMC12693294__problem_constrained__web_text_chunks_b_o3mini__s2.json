      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed pathway requires a cooling-rate window that permits limited diffusion and SRO formation without allowing full equilibration.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095688::web::032::4_3_precipitates_properties_and_evolutio",
        "PMC12381287::web::021::discussion"
      ],
      "same_system": "no"
    },
    {
