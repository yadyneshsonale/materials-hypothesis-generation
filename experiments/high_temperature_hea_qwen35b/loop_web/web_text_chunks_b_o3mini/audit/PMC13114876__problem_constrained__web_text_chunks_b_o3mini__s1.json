      ],
      "same_system": "unclear"
    },
    {
      "text": "The multiphase eutectic HEA will have a higher wear rate than the single-phase baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
