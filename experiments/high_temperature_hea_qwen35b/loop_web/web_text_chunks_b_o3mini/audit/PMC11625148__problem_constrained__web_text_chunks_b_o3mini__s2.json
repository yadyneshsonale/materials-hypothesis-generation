        "PMC10453588::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Untreated NbMoTaW has very poor room-temperature ductility.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding approximately 0.3–0.5 at% Hf and applying a suitable heat treatment will produce nanoscale Hf-rich precipitates in NbMoTaW.",
