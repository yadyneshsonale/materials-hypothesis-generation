  "claims": [
    {
      "text": "Adding ZrC improves the corrosion resistance of a CrMnFeCoNi-based HEA coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding a small, controlled amount of ZrC enhances the durability and reliability of HEA bond coats.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated baseline is an as-deposited CrMnFeCoNi-based HEA bond coat without secondary-phase additions.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 4 wt% ZrC should be incorporated into the HEA bond-coat formulation during deposition.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will remain effective at approximately 800–1000°C under oxidizing or molten-salt corrosive exposure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC addition produces discrete ZrC second-phase particles in the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ZrC particles are uniformly distributed within the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC particles act as grain-boundary pinning sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC particles physically impede oxygen diffusion through the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC particles slow the ingress of oxygen and other corrosive agents into the HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower ingress of oxidants and corrosive agents limits oxidation and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC addition mitigates phase instability and degradation during prolonged thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC addition will reduce combined oxidation and corrosion rates by approximately 70–80% relative to an untreated HEA bond coat.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "ZrC addition will enhance mechanical integrity under high-temperature service.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC addition will extend bond-coat service life under high-temperature conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated HEA bond coats exhibit faster corrosion degradation than ZrC-containing coatings.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated HEA bond coats exhibit faster oxidation degradation under comparable high-temperature conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Benefits of ZrC addition for wear resistance or other mechanical failure modes are uncertain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
