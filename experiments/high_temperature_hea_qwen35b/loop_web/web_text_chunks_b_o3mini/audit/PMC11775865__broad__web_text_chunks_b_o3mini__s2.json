  "claims": [
    {
      "text": "The balance between configurational entropy and short-range ordering governs the structural and chemical stability of high-entropy nanoalloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC5458502::web::001::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High configurational entropy favors a random, single-phase solid solution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range ordering tendencies promote elemental clustering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing the refractory-element fraction raises the alloy's effective melting point.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing the refractory-element fraction slows atomic diffusion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory-element enrichment suppresses thermally driven chemical ordering and helps retain a homogeneous phase during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Specific elemental pair interactions can promote local short-range ordering or clustering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "At high temperatures, the entropy contribution stabilizes a random solid-solution phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic mobility hinders the onset of chemical clustering and thereby improves structural stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "AlxCrCoFeNi exhibits substantial chemical clustering over a wide temperature range when x is below 0.5.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-strain compression promotes atomistic rearrangements in Al0.1CrCoFeNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A refractory-enriched alloy will exhibit better phase uniformity and less chemical clustering after high-temperature annealing than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lower-refractory-content alloy may develop localized clustering or an incipient secondary phase under the same annealing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled cooling rate prevents additional phase segregation after annealing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-entropy alloys are commonly defined as near-equiatomic solid solutions containing at least five component elements.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5458502::web::001::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-entropy alloys combine simple structures with high chemical disorder.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5458502::web::001::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermal stability has been reported as a property of high-entropy alloys.",
      "field": "supporting_evidence_ids",
