  "claims": [
    {
      "text": "The starting Fe–Ni–Cr–Co–Cu nanoparticles are solid, homogeneous, single-phase high-entropy alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Rapid, non-equilibrium cooling can produce and retain the stated homogeneous single-phase nanoparticle state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056590::web::033::4_summary_and_conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic mobility remains limited in Fe–Ni–Cr–Co–Cu nanoparticles during heating through premelting and melting.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limited atomic mobility during heating promotes localized compositional fluctuations or slight segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heating produces strain-induced or defect-rich regions in the nanoparticles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Locally segregated regions have a lower local melting point.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect-rich regions reduce the local energy barrier for melting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower local melting barriers cause premelting to begin earlier and occur over a more distributed temperature interval.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fe–Ni–Cr–Co–Cu high-entropy-alloy nanoparticles will begin premelting at a lower temperature than the single-metal or bimetallic baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy-alloy nanoparticles will exhibit a broader melting-temperature range than the baseline particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compositional mapping will reveal local segregation before complete melting.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In situ TEM will reveal defect accumulation before complete melting.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniform single-metal or bimetallic baseline nanoparticles exhibit a narrow, uniform melting transition.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies principally to particles below approximately 10–50 nm in diameter.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism may not apply to larger particles or to systems processed under conditions that allow high atomic mobility.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
