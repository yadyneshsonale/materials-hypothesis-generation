      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10574201::web::019::5_conclusions",
        "PMC4145285::web::005::tensile_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will preserve the alloy's impact-triggered energy release.",
