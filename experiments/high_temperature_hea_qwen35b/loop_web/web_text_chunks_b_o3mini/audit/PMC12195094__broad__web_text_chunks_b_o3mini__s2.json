      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The annealed AlCrTiZrMo coating substantially improves oxidation resistance at 800 °C in air.",
