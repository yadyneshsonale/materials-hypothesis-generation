      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zr and Ti oxidize and interact synergistically at high temperature within the HEA microstructure.",
