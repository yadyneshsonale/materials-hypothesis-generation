      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Stronger domain-wall pinning caused by the additional twin boundaries increases coercivity.",
