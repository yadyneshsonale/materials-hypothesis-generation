  "claims": [
    {
      "text": "Conventional single-phase ZrB2 made without additives requires preparation temperatures above 2300 °C.",
      "field": "hypothesis; material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional ZrB2 prepared above 2300 °C typically retains porosity and structural weaknesses.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual holes or porosity in conventional ZrB2 cause component failure during extended contact with liquid plating baths.",
      "field": "baseline; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 3–5 wt% SiC to ZrB2 powder enables densification at about 2100 °C rather than above 2300 °C.",
      "field": "hypothesis; intervention; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC reacts with surface oxides on ZrB2 at high temperature to form a transient reactive liquid at grain boundaries.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed transient liquid promotes particle rearrangement and grain-boundary diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC lowers the activation energy for densification of ZrB2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transient liquid fills microvoids and improves particle bonding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Filling microvoids and improving particle bonding produces a denser, more crack- and pore-resistant microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced porosity limits penetration of the liquid plating bath and the resulting damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC-doped ZrB2 sintered near 2100 °C will reach full densification.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with conventional ZrB2 sintered above 2300 °C, SiC-doped ZrB2 will have fewer and smaller pores.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with conventional ZrB2, SiC-doped ZrB2 will retain greater structural integrity during long-term liquid-plating-bath exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
