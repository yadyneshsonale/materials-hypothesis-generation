      "field": "hypothesis / mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "yes"
    },
