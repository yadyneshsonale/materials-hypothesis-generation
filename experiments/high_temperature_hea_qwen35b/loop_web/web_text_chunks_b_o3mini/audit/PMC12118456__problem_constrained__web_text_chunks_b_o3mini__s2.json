      "field": "intervention; conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-induced elemental segregation triggers the phase transition in FeNiCrCoCu nanoparticles.",
