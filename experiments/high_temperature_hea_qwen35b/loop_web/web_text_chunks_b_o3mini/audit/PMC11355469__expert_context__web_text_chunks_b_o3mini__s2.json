  "claims": [
    {
      "text": "High-temperature wear resistance of thin FeNiCrCoCu coatings is governed by formation of a continuous, adherent oxide scale primarily containing Cr2O3 and Cu-based oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation",
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide scale limits direct metal contact and reduces friction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing thermal treatment at approximately 500–800 °C promotes development of a protective oxide film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation",
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal treatment at approximately 500–800 °C causes transient microstructural refinement through nanotwins or dislocation accumulation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thermally induced microstructural refinement temporarily increases coating hardness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Exposure above an optimum temperature causes the coating's intrinsic hardness to decrease.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hardness decrease above the optimum temperature causes wear resistance to deteriorate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial coating is equiatomic FeNiCrCoCu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial FeNiCrCoCu coating has a primarily single-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated initial coating has minimal pre-existing surface oxide.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated temperature in air causes preferential oxidation of Cr and Cu in FeNiCrCoCu.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting oxide barrier suppresses adhesive and abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation",
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive thermal exposure leads to complete recrystallization of the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A coating oxidatively pretreated near 800 °C will develop a continuous, adherent oxide layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "A coating oxidatively pretreated near 800 °C will have a lower wear rate than an untreated coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation",
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "A coating oxidatively pretreated near 800 °C will have a lower friction coefficient than an untreated coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear testing under an inert atmosphere will produce higher wear rates than testing under air.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Only intrinsic hardness governs wear behavior for the untreated coating at room temperature or under inert conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide-controlled mechanism applies over 500–900 °C in oxidizing environments.",
      "field": "boundary",
