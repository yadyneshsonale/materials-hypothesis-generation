      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Outside 500–900 °C or in non-oxidizing conditions, other wear mechanisms may dominate and oxide formation may have negligible influence.",
      "field": "boundary",
