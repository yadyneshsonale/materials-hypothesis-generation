  "claims": [
    {
      "text": "The initial TiVNbTa alloy is a single-phase BCC dendritic alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has a room-temperature yield strength of about 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has a yield strength of about 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A post-solidification aging treatment under low-to-moderate oxygen partial pressure can precipitate fine, dispersed Ti-containing oxides in BCC TiVNbTa.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The intended precipitates will be nanoscale and uniformly distributed within the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale precipitates will obstruct dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will pin grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation strengthening can improve the elevated-temperature strength of high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A stable oxide phase in TiVNbTa will impede dislocation glide at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will slow grain-boundary sliding at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will raise the TiVNbTa yield strength at 1273 K above the reported 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will improve structural integrity under thermal and mechanical loading associated with heat transfer between W and CuCrZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11481659::web::012::tensile_and_compressive_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant service condition is approximately 1273 K under compressive strains up to 30%.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strengthening effect depends on suppressing precipitate coarsening or overaging and retaining precipitate stability near the operating temperature.",
