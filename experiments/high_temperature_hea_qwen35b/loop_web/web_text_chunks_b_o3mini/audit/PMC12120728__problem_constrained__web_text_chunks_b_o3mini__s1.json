      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC10154406::web::017::high_tolerance_to_energetic_particle_irr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At approximately 8 dpa, the Hf-modified alloy will have a lower irradiation-defect cluster density than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::017::high_tolerance_to_energetic_particle_irr"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The irradiated Hf-modified alloy will retain a hardness near 14 GPa with negligible additional irradiation hardening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed irradiation regime is energetic-ion and helium exposure up to approximately 8 dpa at temperatures near 1073 K.",
