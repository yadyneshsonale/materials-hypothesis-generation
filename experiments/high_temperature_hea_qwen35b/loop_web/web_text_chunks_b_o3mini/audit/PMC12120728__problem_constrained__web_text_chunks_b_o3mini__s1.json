      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Unirradiated W38Ta36Cr15V11 has a single-phase BCC structure.",
      "field": "material_initial_state",
