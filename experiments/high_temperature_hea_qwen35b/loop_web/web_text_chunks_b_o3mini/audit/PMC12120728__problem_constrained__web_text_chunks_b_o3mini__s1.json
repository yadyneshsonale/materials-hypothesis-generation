      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "W38Ta36Cr15V11 develops Cr- and V-rich second-phase precipitates during irradiation up to approximately 8 dpa.",
