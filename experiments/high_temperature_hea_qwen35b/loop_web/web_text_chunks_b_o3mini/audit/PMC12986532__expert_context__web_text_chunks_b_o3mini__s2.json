  "claims": [
    {
      "text": "Under sustained loading, HEA multilayers initially deform by dislocation slip.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation slip concentrates stress locally at nanoscale multilayer interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial stress concentrations trigger elastic undulations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12898549::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elastic undulations promote the nucleation and growth of deformation twins.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12898549::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Deformation-twin boundaries impede subsequent dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-mediated obstruction of dislocations produces strain hardening while retaining plastic deformation tolerance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed starting material is a nanoscale FCC/BCC HEA multilayer with sharp interfaces and a uniform dislocation configuration.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multilayer geometry is to be preserved during sustained loading at controlled strain rates and moderate temperatures.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism requires conditions that avoid interface degradation, rapid phase coarsening, and excessive diffusion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The creep mechanism of an HEA can change with loading rate.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::020::3_2_effect_of_al_content_on_properties_o"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elastic undulations lower the barrier to twin formation at multilayer interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12898549::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Sustained loading will produce localized twin networks at multilayer interfaces.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12898549::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation density will increase near the newly formed twins.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin formation will coincide with a measurable shift in strain-hardening rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
