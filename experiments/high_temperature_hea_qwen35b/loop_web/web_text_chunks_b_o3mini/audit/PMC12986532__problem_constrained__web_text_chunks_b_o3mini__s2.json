        "PMC6045582::web::005::the_promise_of_dual_phase_high_entropy_a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The onset of twinning in the FCC phase at high plastic strain substantially increases work hardening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6045582::web::005::the_promise_of_dual_phase_high_entropy_a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed boundary mechanism is effective only while creep is dominated by dislocation-based plasticity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism will not remain effective in regimes dominated by rapid oxidation or phase instability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
