  "claims": [
    {
      "text": "Creep resistance in FCC/BCC high-entropy-alloy protective coatings is primarily enhanced by the stabilization and dynamic evolution of interphase and twin boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
