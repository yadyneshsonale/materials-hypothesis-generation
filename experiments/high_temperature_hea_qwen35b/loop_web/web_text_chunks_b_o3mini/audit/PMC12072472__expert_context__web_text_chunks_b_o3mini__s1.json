  "claims": [
    {
      "text": "The initial material is zirconium-alloy cladding with a conventional pure chromium coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is to add approximately 5–10 at.% Al to the Cr coating.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition to Cr will produce an in-situ alumina phase during high-temperature steam exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting alumina phase will be dense and adherent and will occur within or at the interface of the Cr coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al will oxidize preferentially during high-temperature steam exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will act as a stable diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina barrier will retard interdiffusion between Cr and Zr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr–Zr interdiffusion will preserve coating integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under normal subcritical PWR-water conditions, the Cr matrix will retain its inherent corrosion resistance after Al addition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with pure Cr, Al-doped Cr will exhibit less Cr–Zr interdiffusion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with pure Cr, Al-doped Cr will exhibit less cracking, peeling, or delamination.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with pure Cr, Al-doped Cr will improve oxidation resistance in both normal-water and accident-steam regimes.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure Cr coatings on zirconium alloys peel and crack during high-temperature steam oxidation.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Premature high-temperature failure of pure Cr coatings is caused by pronounced Cr–Zr interdiffusion.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coating is intended for zirconium-alloy cladding exposed to both PWR primary water and accident-relevant high-temperature steam.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The applicable accident-steam temperature range extends to approximately 1000–1200 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Al concentration remains undetermined.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al addition may introduce thermal-expansion mismatch or adverse mechanical-property effects.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
