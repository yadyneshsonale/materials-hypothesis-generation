      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo acts as a beta stabilizer in the proposed Ti–Ni-primary HEA.",
