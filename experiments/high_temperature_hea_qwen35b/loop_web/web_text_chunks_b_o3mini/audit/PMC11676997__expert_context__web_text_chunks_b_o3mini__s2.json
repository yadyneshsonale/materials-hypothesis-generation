      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention substitutes 5 at% of the secondary refractory elements with Mo.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
