      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo encourages nucleation of fine coherent precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased lattice distortion and coherent precipitates impede dislocation motion at high temperature.",
