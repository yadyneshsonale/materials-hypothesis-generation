  "claims": [
    {
      "text": "High-entropy alloys consist of five or more metallic elements in equal or near-equal atomic ratios.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC3598001::web::001::body",
        "PMC4976365::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "High configurational entropy lowers the free energy of disordered solid-solution phases, especially at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC3598001::web::001::body",
        "PMC4976365::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ordering enthalpy from favorable pairwise interactions competes with configurational-entropy stabilization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "At sufficiently low temperature, favorable ordering enthalpy can overcome configurational entropy and promote chemical ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Configurational entropy scales as N ln N, whereas the number of interacting pairs that can drive ordering scales as N squared.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The degree of lattice distortion and atomic-scale mixing mediates the competition between entropy and chemical ordering.",
