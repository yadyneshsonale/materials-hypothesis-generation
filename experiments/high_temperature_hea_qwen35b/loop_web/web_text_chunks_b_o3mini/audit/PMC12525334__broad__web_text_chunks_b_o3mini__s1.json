  "claims": [
    {
      "text": "Reducing Ta in the TiZrHfTax system destabilizes the bcc phase and causes hcp domains to appear within the bcc matrix.",
      "field": "hypothesis; intervention; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A tailored rolling and annealing sequence can produce uniformly dispersed, fine hcp precipitates in a bcc TiZrHfTax matrix.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "A bcc-hcp dual-phase TiZrHfTax microstructure can improve the strength-ductility combination relative to a homogeneous bcc state.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed dual-phase microstructure will simultaneously increase Young's modulus and fracture resistance.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fully Ta-stabilized TiZrHfNbTa is a standard benchmark alloy exhibiting a single bcc phase.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benchmark single-bcc TiZrHfNbTa alloy has modest ductility and fracture resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Careful control of processing temperature, deformation rate, and cooling rate is required to form the desired dual-phase structure without excessive coarsening.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloying-element volatilization, substantial processing deviations, or inadequate grain-size control can prevent the proposed improvement.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreasing Ta softens the bcc matrix and thereby promotes ductile behavior.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hcp domains in TiZrHfTax possess enhanced resistance to shear and therefore strengthen the dual-phase alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fine hcp precipitates strengthen the alloy by impeding dislocation motion.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fine hcp precipitates arrest microcrack propagation.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The bcc matrix sustains plastic deformation while the hcp phase supplies strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Balancing the bcc and hcp phases maintains ductility while improving elastic stiffness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will exhibit yield-strength and tensile-strength gains on the order of tens of percent.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
