  "claims": [
    {
      "text": "TC4 is an alpha-plus-beta dual-phase Ti6Al4V alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated TC4 has low hardness and suboptimal friction and wear properties.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The tribological properties of untreated TC4 limit its use under extreme-service and high-contact-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding can deposit a TiAl composite coating containing dispersed WC particles on TC4.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A laser-cladded TiAl/WC coating on TC4 will create a hard surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction",
        "PMC10706897::web::023::3_3_the_effect_of_wc_content_on_properti"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A laser-cladded TiAl/WC coating on TC4 will create a wear-resistant surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The surface coating will maintain the intrinsic beneficial properties of TC4.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiAl matrix will be compatible with the TC4 substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiAl matrix will provide good adhesion to the TC4 substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniformly distributed WC particles will form hard reinforcing secondary phases in the coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10706897::web::023::3_3_the_effect_of_wc_content_on_properti"
      ],
      "same_system": "no"
    },
    {
      "text": "WC particles will increase coating hardness through solid-solution and dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10706897::web::023::3_3_the_effect_of_wc_content_on_properti"
      ],
      "same_system": "no"
    },
    {
      "text": "The strengthened coating will mitigate plastic deformation and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction",
        "PMC10706897::web::023::3_3_the_effect_of_wc_content_on_properti"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coating may approximately double surface hardness relative to untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating is expected to reduce wear rate by approximately 40–50% relative to uncoated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvements will apply at ambient and moderately elevated temperatures under both dry and lubricated friction.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvements will persist throughout the temperature range in which the TiAl phase remains stable.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated samples with varying WC contents will be compared with untreated TC4 using indentation, reciprocating wear testing, and SEM.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis will be falsified if coated samples fail to achieve a statistically significant hardness increase of at least 20% together with reduced wear rate.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
