  "claims": [
    {
      "text": "The baseline eutectic high-entropy alloy has dual-phase lamellar colonies whose internal boundaries act as room-temperature microcrack nucleation sites.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A trace addition of approximately 0.5 atomic % Hf is an appropriate intervention for the eutectic alloy.",
