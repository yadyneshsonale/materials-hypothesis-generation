      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-modified alloy will have higher room-temperature yield strength than the Hf-free baseline.",
