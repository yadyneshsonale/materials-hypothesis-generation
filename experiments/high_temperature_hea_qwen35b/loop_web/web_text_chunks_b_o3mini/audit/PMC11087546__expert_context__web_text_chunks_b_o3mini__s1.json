      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction",
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-modified alloy will have greater room-temperature tensile strain to failure than the Hf-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction",
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
