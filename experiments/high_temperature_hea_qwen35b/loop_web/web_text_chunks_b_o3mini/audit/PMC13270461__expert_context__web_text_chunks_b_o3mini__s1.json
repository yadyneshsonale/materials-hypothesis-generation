  "claims": [
    {
      "text": "The target material is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 with an FCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-manufactured alloy is homogeneous and single-phase FCC.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-manufactured alloy has minimal preexisting surface oxide and no significant oxidation-related phase segregation.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature degradation of the alloy is governed by the evolution and integrity of a duplex oxide scale.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under oxidizing conditions, Cr selectively oxidizes to form an outer Cr2O3-rich layer.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr contributes protective oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7504593::web::057::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial Cr-rich oxide slows further oxidation and preserves mechanical integrity.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Continued exposure or increasing temperature causes Ti to segregate beneath the outer oxide.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated Ti forms an inner Ti-rich oxide layer.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The inner Ti-rich oxide is less protective than the Cr-rich outer oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the Ti-rich inner layer promotes internal oxidation and compromises the initially protective scale.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under reducing conditions, oxide-scale formation is incomplete.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure produces a thinner oxide scale than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The incomplete scale formed under reducing conditions causes faster loss of mechanical integrity and more pronounced microstructural degradation than oxidizing exposure.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies over approximately 800–1200 °C in oxygen-rich or hydrogen-rich reducing atmospheres.",
      "field": "intervention; conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
