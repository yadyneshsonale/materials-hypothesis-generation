      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "An aluminide coating can form a stable protective Al2O3 scale on HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
