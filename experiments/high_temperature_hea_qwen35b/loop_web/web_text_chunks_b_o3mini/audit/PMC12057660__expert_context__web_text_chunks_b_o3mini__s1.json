      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heating and quenching can freeze zero-valent metal atoms into a homogeneous high-entropy alloy nanoparticle.",
