      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A peak temperature above 2000 K, millisecond-scale exposure, and cooling rates of approximately 10^4–10^5 K/s are the key processing conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10228495::web::004::introduction",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An inert atmosphere minimizes unwanted oxidation during the thermal-shock synthesis.",
