      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Rapid cooling suppresses secondary-phase formation and preserves a single solid solution at room temperature.",
