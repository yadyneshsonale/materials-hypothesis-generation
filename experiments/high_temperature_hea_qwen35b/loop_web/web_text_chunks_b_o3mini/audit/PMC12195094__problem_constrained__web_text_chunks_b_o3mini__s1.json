  "claims": [
    {
      "text": "The component material is prone to hot cracking during fusion welding because of a wide melting range and phase segregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456385::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "An FeCrNiTiZr-based HEA coating can serve as a repair material for H13 hot-working tool steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11433176::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed HEA coating should be applied by laser cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding is a non-fusion additive process.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The laser-clad coating will restore the damaged surface's integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433176::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FeCrNiTiZr HEA coating has high hardness and good elevated-temperature wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11433176::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is relevant to combined high-temperature and severe-wear service conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433176::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is relevant to aeroengine turbine components as well as hot-working tools.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433176::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Rapid solidification during laser cladding produces a refined microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding produces a nearly defect-free repaired microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding creates only a minimal heat-affected zone.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined microstructure and minimal heat-affected zone minimize residual stresses.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing residual stresses reduces the likelihood of crack formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low, controlled heat input limits temperature exposure and extensive melting, thereby avoiding hot cracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Traditional fusion welding can produce solidification and liquation cracking in susceptible HEAs.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456385::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Traditional fusion-weld repairs of the target component have problematic heat-affected zones that impair mechanical properties.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The laser-clad repair will have a significantly lower propensity for hot cracking than a traditional fusion-weld repair.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
