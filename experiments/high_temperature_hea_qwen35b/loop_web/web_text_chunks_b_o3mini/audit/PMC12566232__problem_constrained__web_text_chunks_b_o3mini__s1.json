  "claims": [
    {
      "text": "The baseline HfZrTiTa0.53 alloy has a quasi-static yield strength of 786 MPa, compressive strength of 1314 MPa, and fracture strain of 13.5%.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline HfZrTiTa0.53 alloy exhibits limited strain hardening, poor uniform deformability, and rapid failure under dynamic adiabatic deformation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is addition of approximately 5 at% W to HfZrTiTa0.53.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC11767206::web::019::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding W will refine the microstructure of HfZrTiTa0.53.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at% W will produce a dual-phase microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::019::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will contain finely dispersed nanoscale W-rich precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W-rich precipitates will act as barriers to dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W-rich precipitates will enhance dislocation storage and strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W-rich precipitates will retard dynamic recrystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed microstructure will mitigate local temperature rise during adiabatic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed microstructure will delay the onset of adiabatic shear bands.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The W-modified alloy will have greater dynamic yield strength than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC11767206::web::019::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The W-modified alloy will exhibit an approximately 10–15% increase in uniform strain or fracture strain relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC11767206::web::019::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The W-modified alloy will exhibit enhanced resistance to deformation localization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr"
      ],
      "same_system": "no"
    },
    {
      "text": "The W-modified alloy will undergo less rapid dynamic failure than the baseline alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC11767206::web::019::4_conclusions"
      ],
      "same_system": "no"
    },
    {
