      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic-size mismatch among Fe, Ni, Cr, Co, and Cu generates local defects, strain fields, and heterogeneous surface or grain-boundary sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limited atomic mobility suppresses complete atomic rearrangement at moderate temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Defects and local compositional inhomogeneities lower the effective local melting point.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect-rich surfaces, interfaces, and grain boundaries act as nucleation sites for localized premelting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Premelting begins at defect-rich regions before spreading through the particle.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized premelting occurs below the bulk melting point.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Complete melting occurs once heat-driven diffusion overcomes enthalpic barriers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fe–Ni–Cr–Co–Cu HEA nanoparticles have a broader and more heterogeneous melting transition than comparable binary or single-metal nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
