      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High configurational entropy stabilizes the overall mixed phase.",
