      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed interphase boundaries will act as sinks for irradiation-generated defects.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
