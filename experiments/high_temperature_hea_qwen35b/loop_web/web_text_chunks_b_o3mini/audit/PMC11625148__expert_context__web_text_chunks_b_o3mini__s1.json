      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is substitution of one NbMoTaW constituent with approximately 5–10 at.% Cr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
