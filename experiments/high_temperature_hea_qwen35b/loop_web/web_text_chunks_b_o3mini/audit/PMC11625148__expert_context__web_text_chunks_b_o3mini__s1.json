      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The segregated nanoscale phases or resulting interphase boundaries will be ductile.",
