  "claims": [
    {
      "text": "Traditional fusion-welding repair has a higher risk of hot cracking for the targeted high-value components.",
      "field": "hypothesis; material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Candidate untreated or fusion-welded components have suboptimal surface hardness and corrosion resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A WC-reinforced AlCoCrFeNi-based coating can be deposited by laser cladding for surface modification or repair.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction",
        "PMC11989606::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding provides low dilution, rapid solidification or cooling, and relatively low heat input.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction",
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pre-cleaning and preparing the substrate are required for the proposed process.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Service temperature must remain below a phase-instability limit of the coating.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding forms a metallurgical bond between the WC-AlCoCrFeNi coating and the substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed composite coating will be dense, homogeneous, and low in porosity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "WC particles will be uniformly dispersed through the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The laser-clad microstructure will minimize defects such as hot cracks.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The HEA matrix produces a stabilized, homogeneous microstructure that resists elemental segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC is a very hard ceramic reinforcement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10056557::web::002::1_introduction",
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dispersed WC particles arrest crack initiation and propagation in the coating.",
