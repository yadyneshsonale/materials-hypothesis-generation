      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::009::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain coarseness causes variable tribological performance in the starting CoCrFeNi alloy.",
