      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloying PtPd with Co, Cu, and Ni forms isolated Pt and Pd sites within the multimetallic material.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
