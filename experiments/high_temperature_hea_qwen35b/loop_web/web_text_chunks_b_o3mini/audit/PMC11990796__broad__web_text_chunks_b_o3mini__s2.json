  "claims": [
    {
      "text": "A small, controlled Ti addition to NbMoTaW will improve its strength–plasticity combination.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition will enhance grain-boundary cohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition will promote more uniformly distributed plastic deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW has high yield strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW is brittle and limited in room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Weak grain-boundary cohesion is responsible for the limited ductility of NbMoTaW.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit should occur at room temperature and elevated temperatures when the alloys have comparable thermomechanical histories.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti may promote nanotwinning in NbMoTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti may modify the local atomic environment so that intergranular fracture is delayed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti atoms segregate to NbMoTaW grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary segregation of Ti changes local bonding and reduces brittle intergranular failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing intergranular failure permits more homogeneous plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-induced nanotwinning could contribute simultaneously to strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to Ti-free NbMoTaW, the Ti-added alloy will have approximately 10–15% greater ductility or plastic strain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-added alloy will retain or slightly improve the yield strength of Ti-free NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect is restricted to Ti additions small enough to avoid deleterious secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At very low temperatures, martensitic transformations might dominate and change the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A failure to obtain a statistically significant 10–15% ductility increase while retaining comparable or greater yield strength would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
