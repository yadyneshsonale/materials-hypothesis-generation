      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nb contributes sufficient solid-solution strengthening to maintain room-temperature compressive yield strength after partial Mo replacement.",
