      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12497879::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The undoped W-based HEA interlayer has moderate thermal conductivity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
