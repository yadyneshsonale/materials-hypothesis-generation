      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Dispersed Cu will create conductive pathways that lower the interlayer's thermal resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping Cu at a low volume fraction will minimize deleterious phase separation and embrittlement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A low Cu volume fraction will preserve the W-based HEA's irradiation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-doped interlayer could reduce thermal resistance by 10–20% relative to the undoped HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
