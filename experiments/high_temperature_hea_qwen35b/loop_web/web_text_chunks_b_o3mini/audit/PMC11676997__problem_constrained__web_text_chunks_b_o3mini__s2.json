  "claims": [
    {
      "text": "The starting material is a titanium- and nickel-containing HEA in a single-phase solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally melted titanium- and nickel-containing HEAs have typical trace levels of oxygen and nitrogen.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced purification through vacuum arc melting, controlled atmospheres, or powder metallurgy with high-purity feedstocks can lower oxygen and nitrogen concentrations.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing oxygen and nitrogen will help preserve a homogeneous single-phase solid solution during elevated-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Trace oxygen and nitrogen can promote phase segregation during thermal aging.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Trace interstitial impurities can encourage formation of alpha-Ti precipitates during high-temperature aging.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Impurity-induced segregation depletes strengthening interstitial solutes from the metal matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The loss of interstitial solid-solution strengthening during aging leads to progressive softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Lowering oxygen and nitrogen will reduce deleterious phase segregation such as alpha-Ti precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Suppressing segregation and preserving the solid solution will retain load-bearing capability at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The purified alloy will have higher elevated-temperature yield strength than an otherwise identical conventionally processed alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The purified alloy will have higher elevated-temperature creep strength than an otherwise identical conventionally processed alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect applies from 700°C to 1200°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed effect applies to HEAs in which titanium and nickel are primary constituents.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A conventionally processed baseline containing typical interstitial levels may form precipitates during high-temperature exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
