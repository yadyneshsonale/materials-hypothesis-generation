  "claims": [
    {
      "text": "The baseline alloy is equiatomic HfMoTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline HfMoTaTiZr alloy is in the as-cast state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfMoTaTiZr exhibits high mechanical performance at room and elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention replaces approximately half of the Hf content with an equivalent atomic amount of either Ti or Zr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with lighter Ti or Zr will reduce the alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain a single-phase, likely BCC, solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti- or Zr-enriched alloy will retain substantial lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Ti and Zr contribute sufficient solid-solution strengthening to compensate mechanically for removing half of the Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti and Zr provide the thermal stability or elevated-temperature strength needed to preserve performance near 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is predicted to lower density by approximately 5–10% relative to 10.21 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain yield strength comparable to baseline HfMoTaTiZr at room temperature and approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain ductility comparable to baseline HfMoTaTiZr at room temperature and approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction is bounded to tensile and/or compressive loading at room temperature and around 1000 °C.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior work examined HfMoTaTiZr as one member of an equiatomic refractory-alloy subtraction study.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is rejected if density decreases by less than 5%, or if yield strength or ductility decreases by more than 10% at either room temperature or 1000 °C.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
