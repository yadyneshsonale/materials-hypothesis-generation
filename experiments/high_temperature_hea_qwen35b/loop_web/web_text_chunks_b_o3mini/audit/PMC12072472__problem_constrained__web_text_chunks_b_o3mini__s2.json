  "claims": [
    {
      "text": "The starting system is an elemental Cr coating on zirconium-alloy fuel cladding.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::001::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A thin Al interlayer or low-level Al doping of the Cr coating is proposed as the intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::001::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Introducing Al will produce a continuous Al2O3 scale at the Cr–Zr interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The introduced Al will oxidize preferentially upon environmental exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting alumina scale will be stable and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An interfacial alumina barrier will impede Cr–Zr interdiffusion at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al modification will preserve the coating's corrosion resistance during normal PWR operation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to unmodified Cr, the Al-modified coating will have a thinner or otherwise reduced Cr–Zr interdiffusion zone.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to unmodified Cr, the Al-modified coating will have improved oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::001::1_introduction",
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al modification will prolong coating integrity under both PWR-water and accident-relevant steam conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified Cr coatings are prone to premature high-temperature failure caused by Cr–Zr interdiffusion.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Normal-operation testing at approximately 300–350 °C for periods on the order of weeks, including 45 days, represents the relevant PWR-water boundary.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Steam testing up to approximately 1200 K represents the relevant accident boundary.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Al-interlayer thickness or Al-doping concentration remains undetermined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term performance under simultaneous neutron irradiation and thermal cycling remains undetermined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
