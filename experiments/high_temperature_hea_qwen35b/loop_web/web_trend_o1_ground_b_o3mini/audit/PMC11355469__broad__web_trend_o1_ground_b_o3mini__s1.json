      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "At low load, tribolayer formation is slower or less uniform.",
