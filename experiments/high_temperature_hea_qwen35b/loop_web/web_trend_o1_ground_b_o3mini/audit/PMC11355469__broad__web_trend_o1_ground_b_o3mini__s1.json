      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tribolayer mechanism applies under dry, low-oxidation conditions such as UHV.",
      "field": "boundary",
