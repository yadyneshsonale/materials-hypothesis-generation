      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A short-range-ordered HEA will retain more strength after oxidation and corrosion exposure than the minimally ordered baseline.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A short-range-ordered HEA will retain greater corrosion resistance than the minimally ordered baseline.",
