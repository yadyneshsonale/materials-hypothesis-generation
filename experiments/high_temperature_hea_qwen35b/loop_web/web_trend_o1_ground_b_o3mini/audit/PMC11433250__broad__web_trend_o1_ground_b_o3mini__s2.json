  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The initial test material is a pristine, untreated boride-based component, such as TiB2.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled pre-oxidation at 800–900 °C can produce a uniform TiO2- or Al2O3-type surface oxide on the boride-based component.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::013::3_3_hot_corrosion_behavior",
        "PMC10488483::web::015::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidation will significantly improve the component's resistance to molten-aluminum corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::013::3_3_hot_corrosion_behavior",
        "PMC10488483::web::015::3_results_and_discussion",
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion",
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidized surface will contain a dense, coherent oxide scale adhering to the boride substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::013::3_3_hot_corrosion_behavior",
        "PMC10488483::web::015::3_results_and_discussion",
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale will prevent direct contact between molten aluminum and the boride substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion",
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale will act as a passivation barrier against aluminum infiltration.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion",
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale will impede corrosion reactions by limiting diffusion of corrosive species into the underlying boride matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi",
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated controls, pre-oxidized components will exhibit lower mass loss during molten-aluminum exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::013::3_3_hot_corrosion_behavior"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated controls, pre-oxidized components will exhibit less microstructural degradation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::015::3_results_and_discussion",
        "PMC9318428::web::022::3_3_micromorphology_after_corrosion"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated controls, pre-oxidized components will retain mechanical properties better after prolonged exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::web::015::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective effect should remain effective from 650 to 750 °C for exposure durations up to 500 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance outside the stated temperature and duration range may depend on oxide-scale stability.",
      "field": "boundary",
