      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film inhibits repeated surface plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9960858::web::012::3_2_friction_coefficient"
      ],
      "same_system": "unclear"
    },
