      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Frictional heating and environmental oxygen promote oxide-film formation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9960858::web::012::3_2_friction_coefficient"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Environmental oxygen enables in situ regeneration of the lubricious oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film reduces interfacial shear strength.",
