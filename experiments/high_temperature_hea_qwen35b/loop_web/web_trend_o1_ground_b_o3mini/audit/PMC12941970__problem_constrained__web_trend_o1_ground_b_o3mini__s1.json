      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::003::introduction",
        "PMC5706259::web::014::3_4_tribological_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide layer reduces direct contact between the alloy and counterbody.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5706259::web::014::3_4_tribological_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide layer lowers adhesive interactions and frictional shear strength.",
      "field": "mechanism",
      "needs_support": true,
