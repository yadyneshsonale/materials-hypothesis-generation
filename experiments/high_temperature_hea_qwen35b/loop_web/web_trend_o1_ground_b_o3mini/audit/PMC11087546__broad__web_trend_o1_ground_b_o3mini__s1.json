      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The retained hard-phase network maintains the alloy's strength.",
