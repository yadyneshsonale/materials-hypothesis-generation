      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The refined microstructure improves strain partitioning between the soft and hard phases under load.",
      "field": "mechanism",
