      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Selective recrystallization of the soft phase increases dislocation storage and work-hardening capacity.",
      "field": "mechanism",
