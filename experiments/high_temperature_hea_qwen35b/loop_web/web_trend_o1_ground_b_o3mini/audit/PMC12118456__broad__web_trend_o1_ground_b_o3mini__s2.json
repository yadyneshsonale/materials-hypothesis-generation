  "claims": [
    {
      "text": "Local chemical ordering within high-entropy-alloy nanoparticles delays the onset of premelting.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local chemical ordering stabilizes surface atomic bonds relative to a random atomic distribution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoparticles with the same global composition can be prepared with different degrees of short-range chemical order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled thermal annealing promotes local chemical ordering.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid quenching preserves a comparatively disordered state with minimal local chemical order.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced local ordering increases the cohesive binding of surface atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater cohesive binding reduces the mobility of surface species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced surface-species mobility delays the onset of premelting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Random atomic distributions produce weaker surface bonding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Weaker surface bonding promotes earlier premelting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extended annealing will produce more local chemical order than rapid quenching.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealed, more ordered nanoparticles will have a higher premelting-onset temperature than quenched, disordered nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed, more ordered nanoparticles will exhibit less surface diffusion or restructuring during premelting.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ordering effect should hold for high-entropy-alloy nanoparticles smaller than approximately 20 nm.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect should hold for compositions in which configurational-entropy effects are significant, including CoMoFeNiCu and TaNbHfZr.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "yes"
