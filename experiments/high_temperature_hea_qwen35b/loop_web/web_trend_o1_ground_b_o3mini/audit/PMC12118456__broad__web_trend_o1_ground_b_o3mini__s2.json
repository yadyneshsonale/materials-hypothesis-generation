    {
      "text": "The quantitative shift in premelting-onset temperature depends on the alloy's elemental makeup.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-energy effects may also contribute to the premelting behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7181682::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "DSC heat-flow anomalies can determine the onset temperature of premelting in these nanoparticles.",
      "field": "falsification_experiment.measurements",
