  "claims": [
    {
      "text": "Post-deformation intermediate aging will increase the coercive field of an AlCoFeNi-type high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate aging induces fine-scale decomposition into B2 and A2 regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2 and A2 regions act as effective magnetic domain-wall pinning centers.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deformed or as-cast initial AlCoFeNi-type alloy has a predominantly homogeneous B2 phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 600–700 °C for approximately 10 hours following deformation is the proposed intervention.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coercivity effect is expected during magnetic characterization at room or slightly elevated temperature under standard field-sweep rates.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intermediate aging produces a hierarchical microstructure spanning fine length scales.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aged microstructure consists of finely dispersed nanoscale B2 and A2 regions or precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate-temperature treatment promotes phase decomposition in AlCoFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The decomposed microstructure creates numerous obstacles that impede magnetic domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase decomposition is associated with greater coercivity than a homogeneous, undecomposed B2 matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermediate-aged samples will show roughly a 50% increase in coercivity relative to as-deformed or conventionally annealed samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Samples lacking the intermediate aging treatment retain a more homogeneous B2 phase.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coercivity enhancement is expected specifically after aging at 600–700 °C for 10 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Departures from the specified aging temperature or duration may produce less decomposition and therefore less coercivity enhancement.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties",
        "PMC6197204::web::025::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The magnitude of coercivity enhancement can vary with microstructural evolution and aging homogeneity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::019::microhardness_and_magnetic_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "Failure to obtain both at least about a 10% coercivity improvement and a fine-scale phase-separated structure would falsify the hypothesis.",
