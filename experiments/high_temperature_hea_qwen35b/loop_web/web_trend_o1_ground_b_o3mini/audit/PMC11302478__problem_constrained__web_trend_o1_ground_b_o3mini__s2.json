      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The full quinary alloy has less driving force for FCC-to-HCP transformation than CrCoNi because of Mn-related magnetic effects.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
