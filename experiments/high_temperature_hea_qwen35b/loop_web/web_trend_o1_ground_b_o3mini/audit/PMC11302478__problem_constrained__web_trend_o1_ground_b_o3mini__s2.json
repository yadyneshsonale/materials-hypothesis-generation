      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC10162673::web::025::general_remarks_on_heas_subjected_to_hig"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing Mn to form CrCoNi favors a dislocation-driven FCC-to-HCP transformation relative to CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
