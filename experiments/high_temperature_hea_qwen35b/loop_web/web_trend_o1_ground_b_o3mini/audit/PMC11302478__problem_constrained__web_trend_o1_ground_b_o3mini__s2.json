      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10162673::web::025::general_remarks_on_heas_subjected_to_hig"
      ],
      "same_system": "yes"
    },
    {
      "text": "Variations in stacking-fault energy among these alloys contribute to their different defect mechanisms.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10162673::web::025::general_remarks_on_heas_subjected_to_hig"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi develops nanoscale HCP regions through an FCC-to-HCP phase transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HCP regions formed during deformation are transient lamellae.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn introduces magnetic frustration that removes or obscures the FCC-HCP energetic preference present in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
