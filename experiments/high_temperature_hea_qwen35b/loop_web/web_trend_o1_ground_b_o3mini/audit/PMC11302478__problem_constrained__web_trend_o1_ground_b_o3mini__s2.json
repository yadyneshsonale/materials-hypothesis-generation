      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing certain elements, notably Mn, alters local chemical environments relative to CrMnFeCoNi.",
