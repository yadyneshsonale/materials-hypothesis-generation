  "claims": [
    {
      "text": "Elevated-temperature mechanical loading causes the nominally single-phase HEA to develop localized chemical segregation or short-range ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC7012927::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Redistribution or clustering of trace interstitial impurities may drive the localized segregation or ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The chemical heterogeneities preferentially form at stress-concentration sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incipient precipitates or ordered domains create locally embrittled regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The microstructural changes inhibit multiple deformation mechanisms that ordinarily provide toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Inhibition of the deformation mechanisms causes a loss of toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed microstructural evolution ultimately causes brittle fracture.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy is defined as a homogeneous, single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC4682111::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial alloy has uniformly distributed principal elements and low interstitial-impurity levels.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures approaching 700–800 °C can promote phase separation or precipitate formation in initially single-phase HEAs.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical load and heat accelerate dislocation motion and stress-assisted diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Load-enhanced dislocation motion and stress-assisted diffusion trigger local segregation and ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC7012927::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Segregation or ordering disrupts dislocation glide and twinning that normally sustain toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::000::abstract",
        "PMC7012927::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the homogeneous baseline, the loaded alloy will have reduced strain-hardening capacity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the homogeneous baseline, the loaded alloy will have lower toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Local phase transformation or segregation will be observable at crack tips before brittle fracture.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The homogeneous single-phase baseline has high toughness because multiple deformation mechanisms act synergistically.",
