      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is limited to equimolar, single-phase solid-solution CoCrFeNiTi tested from 25 °C to 600 °C in tension or compression.",
