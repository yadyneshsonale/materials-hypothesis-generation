  "claims": [
    {
      "text": "Equimolar CoCrFeNiTi in a simple solid-solution state has relatively low hardness and strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equimolar CoCrFeNiTi in that state has favorable ductility and machinability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi solid solution contains only minimal short-range order or local compositional clustering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A low degree of chemical ordering lowers barriers to dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Easier dislocation motion reduces strain hardening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Easier dislocation glide lowers the alloy's overall strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Limited short-range ordering enables extensive plastic deformation in CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing CoCrFeNiTi at approximately 600 °C and quenching will enhance its short-range ordering.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced short-range order creates local compositional barriers that obstruct dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhancing short-range order will increase the hardness of CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhancing short-range order will increase the yield strength of CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhancing short-range order may slightly reduce the ductility of CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11616710::web::018::al10hf20nb22ti33v15"
      ],
      "same_system": "no"
    },
    {
      "text": "More pronounced diffuse scattering in synchrotron or neutron measurements would indicate enhanced short-range order.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison uses untreated and 600 °C-for-1-hour annealed-and-quenched batches of equimolar CoCrFeNiTi.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Both batches are to be tested under matched tensile and compressive conditions at 25 °C and 600 °C.",
      "field": "falsification_experiment.design",
