  "claims": [
    {
      "text": "The homogenized or as-cast NbTaTiV-based alloy has minimal short-range chemical order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled aging treatment will increase short-range ordering in NbTaTiV-based alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The aging treatment will promote interstitial segregation or clustering.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Homogenization minimizes both short-range order and interstitial segregation in the baseline alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized chemical short-range order or interstitial clustering modifies the alloy's local lattice landscape.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced short-range ordering increases barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced short-range ordering preferentially favors edge-dislocation-mediated plasticity over screw-dislocation mechanisms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract",
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Conventional BCC metals typically deform through screw-dislocation mechanisms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aged NbTaTiV-based alloys will shift from screw-dislocation activity toward edge-dislocation dominance at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging-induced short-range order will increase yield strength relative to the homogenized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The aged alloy will exhibit altered creep resistance relative to the homogenized alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging-induced short-range order will alter the thermoelastic anisotropy of NbTaTiV-based alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The aged alloy may show reduced thermal expansion along specific lattice directions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effects apply near 1200 degrees Celsius across the transition from yielding to steady-state creep.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract",
        "PMC7516662::web::000::abstract"
      ],
      "same_system": "unclear"
