  "claims": [
    {
      "text": "The initial high-entropy alloy has a stable, adherent oxide or passive film formed during standard processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12839976::web::000::abstract",
        "PMC12112909::web::026::3_3_electrochemical_behavior_with_heat_t"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Chloride-containing environments can promote electrochemical corrosion and affect passive-film stability.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12839976::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dynamic state and stability of the surface passive film governs the coupled tribocorrosion response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::026::3_3_electrochemical_behavior_with_heat_t",
        "PMC12839976::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical sliding repeatedly disrupts the protective oxide or passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Film disruption exposes fresh metal to the corrosive electrolyte.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Repeated mechanical disruption delays or prevents effective repassivation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impaired repassivation accelerates localized corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated localized corrosion undermines surface mechanical integrity and synergistically enhances wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The feedback between wear-induced film breakage and corrosion accelerates total degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe mechanical film disruption will produce greater total degradation and increase both wear and corrosion relative to a largely intact-film baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::026::3_3_electrochemical_behavior_with_heat_t",
        "PMC12839976::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Improving passive-film stability through composition or surface treatment should reduce both corrosion and wear degradation rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::026::3_3_electrochemical_behavior_with_heat_t",
        "PMC12839976::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lower load or sliding severity can serve as a baseline in which the passive film remains largely intact.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis should apply when corrosion resistance is primarily controlled by passive-film integrity.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::026::3_3_electrochemical_behavior_with_heat_t",
        "PMC12839976::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis may fail if an ultra-stable passive layer is insensitive to mechanical abrasion.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis may fail when plastic deformation or another wear mechanism dominates without substantial film disruption.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electrochemical impedance spectroscopy can be used during testing to assess passive-film integrity.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12839976::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The controlled experiment varies mechanical load and sliding speed while holding the corrosive environment constant.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A comparison between standard samples and samples engineered for enhanced passive-film stability is proposed.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Absence of film deterioration and correlated corrosion acceleration as sliding severity increases, or absence of reduced degradation in film-stabilized samples, would falsify the proposed governing mechanism.",
