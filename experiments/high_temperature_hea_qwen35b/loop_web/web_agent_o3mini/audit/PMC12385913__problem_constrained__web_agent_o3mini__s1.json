        "PMC10813983::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "WTaTiVZr is a low-activation refractory high-entropy alloy system.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10813983::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-processed equimolar WTaTiVZr alloy has a single-phase BCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10813983::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The WTaTiVZr microstructure contains uniformly distributed nanoscale coherent precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitates facilitate dislocation transmission.",
