  "claims": [
    {
      "text": "The WTaTiVZr alloy is equimolar.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr has enhanced high-temperature plastic strain relative to commercially pure tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr has enhanced high-temperature toughness relative to commercially pure tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced plastic strain and toughness of WTaTiVZr are governed by coherent nanoprecipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Cast or thermomechanically processed WTaTiVZr likely contains early-stage fine-scale precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Commercially pure tungsten has a coarse, unreinforced microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature exposure at 800–1200 °C can activate nanoprecipitate evolution in WTaTiVZr.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitate interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent nanoprecipitates relieve local stress concentrations that can cause premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoprecipitate-assisted dislocation transmission increases tensile ductility in tungsten-based refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanoprecipitate-assisted dislocation transmission increases fracture toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten lacks the proposed nanoprecipitate-mediated deformation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In pure tungsten, stress concentrations at grain boundaries or defects limit plastic deformation and toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under matched high-temperature tensile conditions, WTaTiVZr will exhibit greater tensile ductility than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under matched high-temperature conditions, WTaTiVZr will exhibit greater toughness than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved deformation in WTaTiVZr will correlate with TEM evidence of coherent nanoprecipitates and dislocation movement.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Pure tungsten will show limited plastic strain and early crack initiation under the same high-temperature conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism will not operate at temperatures too low for precipitate evolution.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extreme thermal conditions can dissolve the relevant nanoprecipitates and invalidate the mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain size, segregation, and secondary-phase formation may also influence WTaTiVZr plasticity and toughness.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
