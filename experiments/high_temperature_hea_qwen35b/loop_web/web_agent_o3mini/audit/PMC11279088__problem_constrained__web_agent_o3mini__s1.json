  "claims": [
    {
      "text": "Protective-oxide stability in CrFeCoNiX alloys above 900 °C is governed by selective oxidation of the X element.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001",
        "PMC9692591::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidation of Al in a CrFeCoNiAl alloy produces Al2O3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidation of Si in a CrFeCoNiSi alloy produces SiO2.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-derived oxide is coherent and adherent and forms a continuous protective barrier.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Si-derived oxide is coherent and adherent and forms a continuous protective barrier.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn is the principal oxide-forming element during high-temperature oxidation of CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidation depletes the CrMnFeCoNi alloy bulk of Mn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-rich oxides in CrFeCoNiMn are non-protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-rich oxide scales are non-coherent and crack or spall.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidizes rapidly in comparison with Al and Si.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn forms volatile oxides under the stated exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of Al2O3 and SiO2 is thermodynamically favored under the stated conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al- and Si-derived oxides grow more slowly and have better interfacial accommodation than Mn-rich oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale is lattice-matched to the underlying high-entropy-alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al content in a CoCrFeNiMn-Al alloy increases resistance to high-temperature oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9692591::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Partial replacement of Mn by Al changes the oxide layer from Mn-rich oxides toward Al-based oxides with protective properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9692591::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under identical exposure conditions, CrFeCoNiAl and CrFeCoNiSi will sustain more protective scales than CrFeCoNiMn.",
