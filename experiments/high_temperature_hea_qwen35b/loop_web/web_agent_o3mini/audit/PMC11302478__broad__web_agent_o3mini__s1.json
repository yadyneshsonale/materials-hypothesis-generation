        "PMC9645729::page::002"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing SRO in FCC CoCrNi-based alloys raises their stacking-fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing SRO increases the yield strength of FCC CoCrNi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::page::002",
        "PMC9645729::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing SRO enhances the strain-hardening capability of FCC CoCrNi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9645729::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Raising SFE suppresses deformation twinning in CoCrNi-based alloys.",
