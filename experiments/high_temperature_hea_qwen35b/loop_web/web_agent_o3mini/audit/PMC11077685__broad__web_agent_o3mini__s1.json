  "claims": [
    {
      "text": "Applying a hafnium coating to a refractory HEA improves its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed substrate is an uncoated VZrHfNbTa refractory HEA.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "A hafnium layer can be deposited on VZrHfNbTa by hot-press sintering.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deposited hafnium layer is thin.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating should improve oxidation resistance in air at 1600 °C for 5 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Zirconium from the VZrHfNbTa substrate diffuses into the hafnium coating during high-temperature processing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Zirconium diffusion into the hafnium coating forms an interfacial HfZr alloy transition layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HfZr transition layer chemically bonds the hafnium coating to the HEA substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10488483::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-temperature exposure produces a dense HfO2 surface film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposed hafnium preferentially oxidizes relative to the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfO2 film inhibits oxygen penetration and further oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will have an oxidation weight gain approximately 57.7% as large as that of the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will show less internal oxidation and structural degradation than the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated VZrHfNbTa oxidized under the stated conditions typically gains around 98 mg/cm².",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated VZrHfNbTa develops observable surface and internal oxidation damage under the stated conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit may not transfer to refractory HEA compositions or oxidation conditions substantially different from VZrHfNbTa in air at about 1600 °C for 5 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The long-term stability of the proposed HfO2 layer under cyclic temperature variations has not been established.",
      "field": "uncertainty",
