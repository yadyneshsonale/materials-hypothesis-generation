      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ion-nitrided surface layer is nanostructured.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nitrided layer is approximately 7 μm thick.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nitrided layer reaches a maximum nanohardness near 27 GPa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated substrate has a baseline nanohardness of approximately 13.5 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ion nitriding nearly doubles surface nanohardness relative to the untreated DMLS substrate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nitrided material contains residual tensile stresses.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The residual tensile stresses are induced specifically by formation of the CrN and Cr2N phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hard nitride phases are responsible for the increase in surface nanohardness.",
