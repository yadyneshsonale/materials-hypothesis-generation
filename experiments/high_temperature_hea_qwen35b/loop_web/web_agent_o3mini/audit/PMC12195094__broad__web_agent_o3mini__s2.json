      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nitrided layer acts as a protective barrier against corrosive agents.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ion nitriding improves the corrosion resistance of DMLS-produced Haynes 282.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10385837::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The corrosion benefit applies at room temperature in 0.1 M Na2SO4 plus 0.1 M NaCl.",
      "field": "conditions",
