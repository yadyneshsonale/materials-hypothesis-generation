      "text": "Ion-nitrided Haynes 282 maintains tensile strength relative to the untreated material at 750°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
