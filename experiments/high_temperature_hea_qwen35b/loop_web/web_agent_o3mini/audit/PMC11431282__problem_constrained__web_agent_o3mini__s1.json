      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has poor load-bearing integrity and tends to crack.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.2 at.% boron will improve the alloy's load-bearing integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.2 at.% boron will preserve the alloy's intrinsic caloric performance under applied-field and pressure-field operation.",
