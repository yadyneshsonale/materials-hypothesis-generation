      "supporting_ids": [
        "PMC12019924::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed phase will reduce direct metal-to-metal contact and act as a wear barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vanadium-doped CoCrFeNi will have a lower coefficient of friction than undoped CoCrFeNi throughout room temperature to 800 °C.",
