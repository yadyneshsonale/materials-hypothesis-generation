      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hardness and wear-resistance benefits should hold under frictional-wear conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
