      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grade 5 titanium alloy can be treated by active-screen ion nitriding at 530–590 °C for 5–17 hours.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Active-screen ion nitriding increases the surface hardness of Grade 5 titanium alloy relative to untreated material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Active-screen ion nitriding improves the wear resistance of Grade 5 titanium alloy relative to untreated material.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8304058::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvements arise from formation of a titanium-nitride-rich surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Active-screen ion nitriding forms a uniform titanium nitride layer on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
