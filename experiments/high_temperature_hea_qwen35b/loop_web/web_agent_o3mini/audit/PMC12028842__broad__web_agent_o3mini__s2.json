      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The titanium nitride phase is responsible for resisting wear and increasing surface hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Active-screen nitriding can produce a surface hardness of approximately 1021 HK0.025.",
      "field": "predicted_outcome",
