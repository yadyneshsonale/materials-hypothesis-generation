  "claims": [
    {
      "text": "The starting eutectic high-entropy alloy has dual-phase lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The constituent phases are a soft FCC phase and a hard BCC phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Semi-coherent internal boundaries in the untreated alloy promote dislocation pile-ups.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An optimized heat treatment can induce phase-selective recrystallization of the soft phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization produces a fully recrystallized soft phase embedded in a hard-phase skeleton.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment preserves an intact and continuous hard BCC network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting internal boundaries are stronger and less stress-concentrating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization eliminates weak boundaries in the soft phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The eliminated weak boundaries are sites for dislocation pile-up and local stress concentration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing pile-ups and local stress concentrations prevents microcrack initiation and catastrophic damage.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The recrystallized soft phase accommodates plastic deformation more uniformly and releases the strain-hardening capacity of the duplex phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The preserved hard phase maintains the alloy's strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "A phase-selectively recrystallized eutectic HEA can attain approximately 35% uniform elongation and approximately 2 GPa true stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the untreated alloy, the treatment significantly improves tensile ductility while maintaining or enhancing strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed performance applies under room-temperature uniaxial tensile testing at a controlled strain rate.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated eutectic alloys suffer from limited tensile ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated alloy's brittleness is caused by dislocation accumulation and stress concentrations at internal phase boundaries.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
