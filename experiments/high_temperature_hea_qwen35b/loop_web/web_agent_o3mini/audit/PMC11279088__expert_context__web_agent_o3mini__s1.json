{
  "run_id": "PMC11279088__expert_context__web_agent_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Across CrFeCoNiX alloys, formation and persistence of a protective oxide above 900 °C are governed by preferential oxidation of X.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "In CrFeCoNiAl, preferential oxidation of Al forms an Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 scale in CrFeCoNiAl is coherent, adherent, stable, and slow-growing, and therefore limits further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn is the major oxide-forming element during high-temperature oxidation of CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidation in CrMnFeCoNi produces non-protective oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of Mn oxides depletes the bulk CrMnFeCoNi alloy of Mn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidation is rapid relative to oxidation in the Al- and Si-containing variants.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-rich oxides are volatile or poorly adherent and consequently crack or spall.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi has oxidation behavior intermediate between the Al- and Mn-containing alloys because its oxide-growth kinetics are less favorable than those of Al2O3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective oxidation drives elemental redistribution or segregation at the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001",
        "PMC10856430::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The composition, continuity, and adhesion of the interfacial oxide scale govern whether protection persists or the scale spalls.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001",
        "PMC10856430::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNi without a significant reactive X element, or with an inert addition, does not form a stable protective oxide above 900 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn will form a cracked and spalling Mn-rich scale under the proposed exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiSi will provide partial oxidation protection but retain some scale discontinuity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed ordering of oxidation behavior applies to both single-phase and multiphase CrFeCoNiX solid-solution alloys above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interactions among the transition-metal constituents may modify oxide-formation kinetics.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
