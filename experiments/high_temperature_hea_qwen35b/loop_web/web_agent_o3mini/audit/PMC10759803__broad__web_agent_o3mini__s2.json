  "claims": [
    {
      "text": "A refractory high-entropy alloy baseline can be produced without oxide additions by ball milling and spark-plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The unmodified NbTaHfTiZrV0.5 baseline exhibits dislocation-slip-mediated plasticity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 15 wt% Al2O3 during ball milling and spark-plasma sintering promotes in-situ TiO precipitate formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The 15 wt% Al2O3 level is optimized based on prior studies.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in-situ TiO precipitates are fine and uniformly dispersed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "TiO precipitates impede dislocation motion and provide precipitation strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al2O3-induced precipitates refine the alloy microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 reacts during sintering to form TiO precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "A ductile matrix preserves good plasticity despite the ceramic addition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The low-density Al2O3-containing phase reduces the overall alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strengthening intervention remains effective under tensile or compressive loading from 673 K to 873 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::page::001",
        "PMC8746096::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al2O3-modified alloy will have approximately 30% greater yield strength than the unmodified baseline at 673–873 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::page::001",
        "PMC8746096::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al2O3-modified alloy will have nearly 15% lower density than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al2O3-modified alloy will retain room-temperature ductility comparable to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The unmodified baseline relies primarily on solid-solution strengthening and dislocation slip.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::page::001",
        "PMC8746096::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The unmodified TaNbVTi-based alloy has higher density than its Al2O3-modified counterpart.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::001"
      ],
      "same_system": "yes"
    },
    {
