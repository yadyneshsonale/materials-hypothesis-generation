  "claims": [
    {
      "text": "Undoped MnNiSi has an established magnetocaloric response.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline mechanical properties of undoped MnNiSi may be inadequate for applications.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5–10% of the Ni-site atoms should be replaced with Co.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC10265063::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed effect requires synthesis of phase-pure samples and testing near the phase-transition temperature under cyclic magnetic-field conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co atoms replacing Ni will form a solid solution in MnNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co substitution on the Ni site will induce local lattice strain.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The substitution-induced lattice strain will enhance dislocation pinning.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution strengthening from Co substitution will increase the yield strength of MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co substitution will improve the ductility of MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Isostructural substitution can be used to engineer magnetostructural coupling in MM'X magnetocaloric compounds.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10265063::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Co-for-Ni substitution will minimally perturb the magnetostructural coupling responsible for the magnetocaloric effect in MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10265063::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "MnNi1-xCoxSi with x approximately 0.05–0.10 will have higher yield strength than undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "MnNi1-xCoxSi with x approximately 0.05–0.10 will have improved ductility relative to undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "For x approximately 0.05–0.10, the magnetocaloric entropy change will remain at or above 90% of the undoped MnNiSi value.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial combination of mechanical improvement and magnetocaloric retention exists only in an approximately 5–10% Co-substitution window.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution below the proposed window may be insufficient to improve mechanical behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution above the proposed window may disturb the magnetocaloric phase transitions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Direct investigation of Co doping in this specific MnNiSi system is limited.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed experiment compares x = 0, 0.05, 0.10, and 0.15 samples using mechanical, magnetocaloric, and transition-temperature measurements.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if x = 0.05–0.10 produces no statistically significant mechanical improvement or reduces the entropy change below 90% of the undoped value.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
