      "support": "partial",
      "supporting_ids": [
        "PMC5314382::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid dislocation accumulation creates local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress concentrations generated by dislocations trigger mechanical twinning under high strain rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
