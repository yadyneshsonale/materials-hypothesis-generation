      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial single-phase alloy contains no pre-existing brittle intermetallic phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::webcard"
      ],
      "same_system": "yes"
    },
    {
