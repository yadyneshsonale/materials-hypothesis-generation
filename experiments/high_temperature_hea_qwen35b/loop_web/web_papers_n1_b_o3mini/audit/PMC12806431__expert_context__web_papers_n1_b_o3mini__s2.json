      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Deformation produces an ultra-nanocrystalline or amorphous interfacial layer at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The deformation-induced interfacial layer is brittle.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interfacial transformation reduces the capacity for dislocation-mediated plasticity.",
