      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interfacial layer concentrates or localizes strain.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interfacial layer facilitates crack initiation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the layer causes reduced toughness and earlier crack initiation and propagation relative to the initial microstructure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-strain-rate or low-temperature loading favors the proposed dynamic shear transformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation mobility is reduced at lower temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower strain rates or elevated temperatures promote recovery and may prevent formation of the deleterious layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial single-phase HEA exhibits conventional dislocation plasticity and moderate toughness under comparable loading conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional alloys typically lose toughness through grain-boundary segregation or brittle precipitate formation rather than dynamic amorphization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical deformation of single-phase CoCrFeMnNi can form an ultra-nanocrystalline near-surface layer.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "A dynamic amorphization model accounts for grain-size-dependent shear strength in the inverse Hall-Petch regime of single-phase CoCrFeMnNi.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::webcard"
      ],
      "same_system": "yes"
    },
