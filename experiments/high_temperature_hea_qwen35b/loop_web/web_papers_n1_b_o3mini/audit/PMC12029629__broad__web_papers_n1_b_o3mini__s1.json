  "claims": [
    {
      "text": "The dynamic mechanical behavior of TiZrHfTax high-entropy alloys is governed by an alloying-induced phase transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Ta destabilizes the bcc phase in the TiZrHfTax system.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Ta leads to the formation of hcp regions embedded in the bcc matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hcp regions reinforce the alloy against shear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The bcc matrix softens as Ta concentration decreases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Shear-resistant hcp regions combined with a softened bcc matrix produce a favorable strength-ductility combination.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hcp precipitates are stiff and nearly elastically isotropic.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Softening of the bcc matrix maintains ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-Ta TiZrHfTax alloys have a predominantly stable bcc phase with minimal hcp content.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lower-Ta alloys will contain a larger fraction of hcp precipitates than the high-Ta baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under dynamic loading, lower-Ta alloys will have higher yield strength than the high-Ta baseline because of enhanced local shear resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under dynamic loading, lower-Ta alloys will maintain or slightly improve ductility relative to the high-Ta baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism applies within a TiZrHfTax compositional window where bcc and hcp phases can coexist.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "yes"
