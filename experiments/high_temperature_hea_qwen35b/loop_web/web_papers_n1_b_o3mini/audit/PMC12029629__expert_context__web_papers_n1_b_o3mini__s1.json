  "claims": [
    {
      "text": "Dynamic mechanical behavior in solidified Co-free FeNiCrMn is primarily governed by a strain-rate- and temperature-dependent stress-induced phase transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6488616::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "As-solidified near-equiatomic FeNiCrMn has a predominantly FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FCC phase in as-solidified FeNiCrMn is metastable with respect to a martensitic or similar phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applied stress activates transformation of metastable FCC FeNiCrMn into a martensite-like phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6488616::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The transformed phase locally alters dislocation motion and interactions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transformation product is harder and less deformable than the initial FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher strain rates suppress the phase transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower temperatures suppress the phase transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower strain rates promote more extensive phase transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperatures promote more extensive phase transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressed transformation at higher strain rates or lower temperatures produces higher flow stress and lower ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More extensive transformation at lower strain rates or higher temperatures improves ductility while reducing flow stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Transformation activity is minimal at room temperature and moderate strain rate.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local microstructural variation may influence the observed mechanical behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6488616::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Transformation kinetics and spatial heterogeneity in FeNiCrMn under nonuniform stress fields are not fully characterized.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Testing phase-fraction evolution and mechanical response over a temperature and strain-rate grid can evaluate the proposed correlation.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
