      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-modified TiVNbTa may have improved high-temperature ductility relative to unmodified TiVNbTa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-modified TiVNbTa may have improved work-hardening behavior relative to unmodified TiVNbTa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed strengthening and phase stability are expected to apply from approximately 1273 K to 1600 K.",
