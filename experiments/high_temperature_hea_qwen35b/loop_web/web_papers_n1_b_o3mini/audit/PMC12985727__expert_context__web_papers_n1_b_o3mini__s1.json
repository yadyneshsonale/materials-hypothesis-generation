      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The transition from screw to edge dislocations will produce a high-temperature strength plateau in TiVNbTaHf.",
