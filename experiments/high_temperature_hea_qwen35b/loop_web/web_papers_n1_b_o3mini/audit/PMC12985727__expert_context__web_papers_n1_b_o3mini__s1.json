      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf addition alters local lattice distortion in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The altered local lattice distortion encourages the transition to edge-dislocation-dominated deformation.",
