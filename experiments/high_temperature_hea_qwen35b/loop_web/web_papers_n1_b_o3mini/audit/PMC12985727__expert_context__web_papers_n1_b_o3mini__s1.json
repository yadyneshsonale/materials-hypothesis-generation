      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Edge-dislocation-dominated deformation will increase resistance to thermal softening in TiVNbTaHf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Hf will increase TiVNbTa yield strength at 1273 K by at least approximately 10%, to above 360 MPa.",
