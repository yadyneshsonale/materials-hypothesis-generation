      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The dopant-induced dislocation changes will support irradiation-defect recombination.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
