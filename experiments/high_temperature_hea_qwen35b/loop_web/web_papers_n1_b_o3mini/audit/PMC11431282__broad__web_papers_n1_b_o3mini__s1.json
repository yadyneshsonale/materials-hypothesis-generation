      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ductile FCC regions in the Pd-modified MnNiSi microstructure would enhance ductility and toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The primary magnetocaloric transition of MnNiSi will be maintained after 2–5 at.% Pd addition.",
