  "claims": [
    {
      "text": "CrCoNi has superior strength and plastic deformation relative to equiatomic CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Thermomechanically processed equiatomic CrMnFeCoNi and CrCoNi initially form single-phase FCC solid solutions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has an HCP configuration with distinctly lower energy than its FCC configuration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing Mn from the quinary alloy removes magnetically frustrated Mn interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Magnetically frustrated Mn raises the barrier to the FCC-to-HCP transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation slip triggers an FCC-to-HCP phase transformation in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interaction of dislocations with internal boundaries helps trigger the transformation in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deformation-induced HCP phase forms as nanoscale regions at or near dislocation structures and internal boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deformation-induced HCP regions reinforce CrCoNi and increase strength without sacrificing plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HCP transformation increases both strength and ductility in CrCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn suppresses the deformation-induced FCC-to-HCP transformation in equiatomic CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under identical deformation conditions, CrCoNi will develop a larger HCP phase fraction than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under identical deformation conditions, CrCoNi will show enhanced yield strength and ductility relative to CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrMnFeCoNi will remain predominantly FCC during deformation and exhibit less phase-transformation strengthening than CrCoNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism applies to equiatomic and near-equiatomic, initially single-phase FCC alloys when magnetic interactions dominate stacking-fault and transformation energetics.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism may not extend to non-equiatomic alloys or alloys with radically different processing histories.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transformation can be tested by identically deforming CrCoNi and CrMnFeCoNi while measuring strain-dependent HCP fraction, mechanical properties, and defect-associated transformation zones.",
      "field": "falsification_experiment",
