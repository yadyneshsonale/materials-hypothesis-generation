      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Charge transfer to Pt/Pd causes a redshift of the linear CO adsorption band.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "PtPdCoCuNi interacts more strongly with nitrobenzene than PtPd.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The isolated sites enable more selective chemisorption of reactants.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "PtPdCoCuNi will have a higher linear-to-bridging CO adsorption ratio than PtPd.",
      "field": "predicted_outcome",
