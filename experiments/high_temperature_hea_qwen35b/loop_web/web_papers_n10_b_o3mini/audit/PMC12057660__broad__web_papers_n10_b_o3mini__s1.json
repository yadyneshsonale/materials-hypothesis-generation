      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid, controlled reduction and mixing kinetics produce a spatially homogeneous distribution of the five metals.",
