      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitrobenzene hydrogenation can be evaluated at 80 °C and at room temperature for this PtPdCoCuNi catalyst.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Uniform incorporation of the transition metals increases the relative linear CO adsorption signal by isolating Pt/Pd sites.",
