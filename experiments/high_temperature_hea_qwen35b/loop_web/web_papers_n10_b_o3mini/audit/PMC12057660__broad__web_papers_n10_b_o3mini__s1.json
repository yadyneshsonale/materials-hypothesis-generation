      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Electronically modulated, isolated Pt/Pd sites strengthen nitrobenzene interaction and enhance hydrogenation activity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::webcard"
      ],
      "same_system": "yes"
    },
    {
