      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10095625::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "An as-cast or solution-treated AlCrTiV0.5-based alloy can have a homogeneous microstructure with uniformly distributed elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an intentionally segregated variant, the homogenized alloy will exhibit lower corrosion current density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095625::webcard"
      ],
      "same_system": "yes"
    },
    {
