      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::webcard",
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-doped alloy will retain the overall ductility of baseline TiVNbTa.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
