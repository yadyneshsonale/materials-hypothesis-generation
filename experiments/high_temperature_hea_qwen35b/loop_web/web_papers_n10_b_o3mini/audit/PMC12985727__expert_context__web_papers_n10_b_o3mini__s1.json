      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo addition will promote a change from thermally activated screw-dislocation slip to edge-dislocation-dominated slip at elevated temperature.",
