      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed dislocation transition and solid-solution strengthening will improve high-temperature strength retention in Mo-doped TiVNbTa.",
