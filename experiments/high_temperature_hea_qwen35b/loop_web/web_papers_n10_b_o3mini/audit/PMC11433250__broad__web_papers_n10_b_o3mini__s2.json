  "claims": [
    {
      "text": "Increasing boronizing temperature and/or duration will produce a thicker boride layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10221107::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing boronizing temperature and/or duration will produce a more continuous and denser boride layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced layer will contain MB-type and M2B-type borides.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional boronizing produces a thinner, less uniform boride layer than the proposed enhanced treatment.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10221107::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A thicker, denser boride layer acts as a diffusion barrier against molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced boride layer reduces penetration and interaction of molten aluminum with the substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced boride layer reduces elemental interdiffusion between the substrate and molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced interdiffusion decreases dissolution of key substrate components into molten aluminum.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreased substrate dissolution lowers the molten-aluminum corrosion rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced boronizing could reduce weight loss or corrosion rate by approximately 30–50% relative to standard boronizing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should remain effective during molten-aluminum exposure at 700–800°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 700–800°C is typical of hot-dip aluminum-plating operation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Overly aggressive boronizing may increase brittleness or cause boride-layer spallation during thermal cycling.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittleness, cracking, or spallation can limit the maximum beneficial increase in boride-layer thickness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
