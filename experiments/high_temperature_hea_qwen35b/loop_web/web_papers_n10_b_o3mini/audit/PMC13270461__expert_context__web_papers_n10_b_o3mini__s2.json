    {
      "text": "Oxidizing exposure selectively produces a continuous Cr-rich oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-rich chromia scale is protective because it limits further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti segregates at defects or grain boundaries during oxidizing exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated Ti forms discrete Ti-rich oxides, identified mechanistically as dispersed TiO2 particles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti-rich oxides at critical microstructural locations are less adherent and act as weak links that initiate degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
