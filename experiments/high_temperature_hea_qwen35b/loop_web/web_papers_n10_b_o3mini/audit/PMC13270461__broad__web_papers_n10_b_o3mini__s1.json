      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice distortion elevates Al migration barriers in the Al-depletion zone.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13067856::webcard"
      ],
      "same_system": "yes"
    },
    {
