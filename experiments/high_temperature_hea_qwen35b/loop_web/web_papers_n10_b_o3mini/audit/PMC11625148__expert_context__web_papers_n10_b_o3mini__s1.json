      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The HCP precipitates will provide additional slip systems or deformation modes that reduce resistance to dislocation motion.",
