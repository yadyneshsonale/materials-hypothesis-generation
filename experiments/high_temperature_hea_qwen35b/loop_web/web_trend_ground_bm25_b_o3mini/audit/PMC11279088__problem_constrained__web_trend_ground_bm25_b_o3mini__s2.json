{
  "run_id": "PMC11279088__problem_constrained__web_trend_ground_bm25_b_o3mini__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The identity of X governs protective-scale stability in CrFeCoNiX alloys by altering cation diffusion kinetics and metal/oxide interfacial stress.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Differential diffusion of alloying cations can produce interfacial defects and loss of oxide-scale integrity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "Al-containing CrFeCoNi-based alloys form an Al2O3-containing oxide scale above 900 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 scales provide protection and are more stable than chromia scales under high-temperature oxidation or aggressive carbon- or sulfur-containing environments.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al lowers the relevant outward cation-diffusion rate relative to Si or Mn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced cation diffusion in the Al-containing alloy minimizes tensile stress at the oxide/metal interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower interfacial stress causes the Al2O3-based scale to remain coherent and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-bearing material exhibits relatively rapid cation diffusion that can generate diffusion imbalance and Kirkendall porosity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn-containing CrFeCoNiX alloys develop unstable oxide scales prone to detachment near or above 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m",
        "PMC10384371::web::036::4_4_oxidation_thermodynamics"
      ],
      "same_system": "no"
    },
    {
      "text": "Si-containing CrFeCoNiX alloys permit faster cation diffusion than the Al-containing alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-containing CrFeCoNiX alloys form unstable oxide scales prone to cracking or spallation above 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Faster cation transport increases interfacial stress and oxide defects, thereby causing cracking or spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis applies only above 900 °C in oxidative or corrosive atmospheres and while the alloy remains a metallic solid solution.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC8346963::web::009::3_2_high_temperature_surface_oxidation_m",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The diffusion-rate and interfacial-stress thresholds separating stable from unstable scale formation are not established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    }
  ],
