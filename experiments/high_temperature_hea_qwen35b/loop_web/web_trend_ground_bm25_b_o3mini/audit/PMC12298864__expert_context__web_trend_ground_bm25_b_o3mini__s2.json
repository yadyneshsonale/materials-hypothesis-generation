  "claims": [
    {
      "text": "Equimolar or nearly equimolar CoCrFeNiTi has relatively low hardness and strength while retaining high plasticity and machinability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi is predominantly a disordered solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching from the melt retains the disordered solid-solution state in CoCrFeNiTi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low local chemical order facilitates dislocation motion.",
