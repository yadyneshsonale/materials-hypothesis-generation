      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::009::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HEA's combined degradation rate will be lower than the sum of its isolated wear and isolated corrosion rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy's combined degradation rate will approach or exceed the sum of its isolated wear and corrosion rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
