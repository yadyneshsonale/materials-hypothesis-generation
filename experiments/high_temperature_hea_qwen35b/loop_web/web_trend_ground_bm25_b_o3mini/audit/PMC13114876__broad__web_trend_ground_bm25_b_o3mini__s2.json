      ],
      "same_system": "yes"
    },
    {
      "text": "The as-synthesized HEA has a high density of defects.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-synthesized HEA has severe lattice distortion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high defect density and severe lattice distortion favor formation of multi-component oxide films.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical wear intermittently disrupts the protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapidly formed mixed-metal oxide films on HEAs can reduce wear rate.",
