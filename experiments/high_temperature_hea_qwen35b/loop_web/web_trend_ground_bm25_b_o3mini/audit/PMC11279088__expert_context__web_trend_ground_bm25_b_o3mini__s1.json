      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC11169556::web::005::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding Al to CrFeCoNi promotes formation of an Al2O3 scale.",
