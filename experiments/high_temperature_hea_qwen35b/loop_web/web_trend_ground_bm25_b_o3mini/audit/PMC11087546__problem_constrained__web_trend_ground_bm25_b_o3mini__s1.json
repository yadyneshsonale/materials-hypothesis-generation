      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing alone is the intervention needed to produce the phase-selectively recrystallized state.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applicable mechanical test and operating condition is room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The desired microstructure is a fully recrystallized soft phase embedded in an intact skeletal hard-phase network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Moderate deformation creates different strain levels in the FCC and B2 phases, enabling FCC recrystallization while the B2 phase undergoes only recovery during subsequent annealing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization reduces incoherence or mismatch at the FCC/B2 interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced interface incoherence decreases the density of dislocation pile-ups at phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreasing dislocation pile-ups mitigates local stress concentrations and delays microcrack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase-selective recrystallization tailors strain partitioning and releases the strain-hardening capacity of the duplex phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced strain hardening improves tensile ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy can reach approximately 35% uniform elongation.",
