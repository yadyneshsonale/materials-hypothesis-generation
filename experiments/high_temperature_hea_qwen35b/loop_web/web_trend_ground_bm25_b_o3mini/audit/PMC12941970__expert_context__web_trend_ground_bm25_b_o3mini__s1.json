      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified CoCrFeNi will have a consistently lower wear rate than untreated CoCrFeNi from room temperature to 800 °C.",
