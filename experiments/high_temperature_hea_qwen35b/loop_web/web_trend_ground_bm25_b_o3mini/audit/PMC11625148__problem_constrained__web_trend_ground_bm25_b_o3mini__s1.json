        "PMC9739928::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equal-atomic NbMoTaW has excellent mechanical properties at 1600 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equal-atomic NbMoTaW has very poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equal-atomic NbMoTaW has predicted irradiation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf or Zr is a ductilizer for NbMoTaW when added at 1–2 at%.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction",
        "PMC8838456::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 1–2 at% Hf or Zr to NbMoTaW will form nanoscale coherent precipitates or phase heterogeneities in the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates or heterogeneities will provide additional dislocation sources.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates or heterogeneities will impede crack propagation at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at% Hf or Zr will improve the room-temperature ductility of NbMoTaW relative to untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction",
        "PMC8838456::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will retain a single-phase BCC structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will maintain the high-temperature yield strength of untreated NbMoTaW at 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale coherent precipitates or heterogeneities can act as irradiation-defect sinks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain or enhance the irradiation resistance of untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping the Hf or Zr addition below approximately 3 at% is necessary to maintain the single-phase BCC structure and high-entropy state.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf or Zr additions above approximately 3 at% may destabilize the BCC matrix or form undesirable secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Secondary phases produced by larger additions may compromise high-temperature performance and irradiation resistance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The kinetics of precipitate formation and the irradiation response of Hf- or Zr-modified NbMoTaW are not established.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to improve room-temperature ductility significantly, or degradation of high-temperature performance or irradiation resistance relative to untreated NbMoTaW, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
