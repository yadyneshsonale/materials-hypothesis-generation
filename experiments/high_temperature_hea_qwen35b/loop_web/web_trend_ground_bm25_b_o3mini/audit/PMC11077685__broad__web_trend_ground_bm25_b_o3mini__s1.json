      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract",
        "PMC7475834::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective Si-20Cr-20Fe coating can be implemented as a thin film deposited by physical vapor deposition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Physical vapor deposition will ensure coating uniformity and strong adhesion.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will protect MoNbTaTiW over 900–1000°C in air for approximately 100 hours.",
