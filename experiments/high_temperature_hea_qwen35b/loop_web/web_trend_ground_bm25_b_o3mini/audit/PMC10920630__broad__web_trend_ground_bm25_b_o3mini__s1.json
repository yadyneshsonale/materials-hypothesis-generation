        "PMC7517287::web::020::3_3_corrosion_behavior_in_3_5_wt_nacl_so"
      ],
      "same_system": "no"
    },
    {
      "text": "The passive film limits corrosive attack under high-temperature, high-pressure aqueous conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature, high-pressure aqueous environments with oxidants are representative of chemical-processing and nuclear-power service conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosion-mediating passive film is enriched in Cr, Ni, and Mo.",
