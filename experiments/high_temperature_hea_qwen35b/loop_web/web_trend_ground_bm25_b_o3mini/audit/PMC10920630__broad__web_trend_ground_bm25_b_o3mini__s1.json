      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Steels with increased Cr, Ni, and Mo will exhibit increased polarization resistance and reduced corrosion rates relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8779564::web::012::3_1_electrochemical_impedance_spectrosco"
