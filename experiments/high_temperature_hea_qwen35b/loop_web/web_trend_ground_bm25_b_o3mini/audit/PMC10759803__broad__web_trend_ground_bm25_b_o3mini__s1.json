      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A continuous B2 matrix is associated with poor room-temperature ductility in typical two-phase B2+BCC RHEAs.",
