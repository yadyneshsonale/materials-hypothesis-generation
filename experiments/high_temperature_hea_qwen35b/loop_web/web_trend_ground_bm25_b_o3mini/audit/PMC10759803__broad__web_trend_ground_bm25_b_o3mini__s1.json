      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The annealed alloy will preserve room-temperature ductility relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::021::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The thermal intervention will preserve alloy density because it does not introduce heavier alloying elements.",
