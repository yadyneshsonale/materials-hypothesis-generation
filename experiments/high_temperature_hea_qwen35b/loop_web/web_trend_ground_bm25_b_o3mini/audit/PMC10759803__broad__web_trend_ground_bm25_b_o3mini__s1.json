      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::021::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The tailored annealing treatment will significantly increase high-temperature yield strength relative to the conventionally processed or homogenized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::021::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The tailored annealing treatment will improve high-temperature creep resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitates strengthen the alloy by impeding dislocation motion through Orowan-like bowing or bypass.",
