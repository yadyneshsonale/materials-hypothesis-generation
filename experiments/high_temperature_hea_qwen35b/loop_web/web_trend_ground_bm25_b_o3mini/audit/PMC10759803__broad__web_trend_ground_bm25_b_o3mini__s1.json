      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::021::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing a continuous B2 matrix with a continuous disordered BCC matrix containing discrete B2 precipitates substantially improves room-temperature compressive ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::000::abstract",
        "PMC5995863::web::021::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The engineered BCC+B2 microstructure can retain high yield strength at room and elevated temperature.",
