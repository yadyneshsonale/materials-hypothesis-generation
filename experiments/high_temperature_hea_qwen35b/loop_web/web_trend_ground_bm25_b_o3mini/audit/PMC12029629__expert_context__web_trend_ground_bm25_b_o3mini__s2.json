  "claims": [
    {
      "text": "The studied material is equiatomic, Co-free FeNiCrMn.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solidified and homogenized equiatomic FeNiCrMn has a primarily FCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dynamic behavior of FeNiCrMn is governed by a regime-dependent transition between deformation mechanisms.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC11139900::web::002::introduction",
        "PMC10490121::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At lower strain rates and/or higher temperatures, FeNiCrMn deformation is primarily accommodated by dislocation slip.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At higher strain rates and/or lower temperatures, FeNiCrMn shifts toward dynamic twinning or elastic strain-induced amorphization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC11139900::web::002::introduction",
        "PMC10490121::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elastic strain-induced amorphization is a form of elastic instability involving sudden loss of lattice ordering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC11139900::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The transition to twinning or amorphization occurs at a critical stress or strain threshold.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC11139900::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing strain rate or decreasing temperature causes accumulated stress to make conventional dislocation slip less favorable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC10490121::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Suppressed dislocation activity can permit an elastic-instability-driven amorphization process.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11139900::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dynamic twinning is an operative high-rate or low-temperature mechanism in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transition to twinning or amorphization provides additional strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10490121::web::005::1_introduction",
        "PMC5701024::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An overly abrupt mechanism transition may reduce ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism transition underpins the maintained strength–ductility balance of FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10490121::web::005::1_introduction",
        "PMC5701024::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "High-rate, low-temperature deformation should produce twins or regions with lost lattice periodicity in FeNiCrMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11139900::web::000::abstract",
        "PMC11139900::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism transition should produce a detectable change in strain-hardening behavior.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At room temperature and moderate strain rate, FeNiCrMn plasticity is governed by dislocation-mediated slip.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Significant secondary phases, impurities, or processing-induced defects may change the operative deformation mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5701024::web::001::introduction",
        "PMC11139900::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis can be tested by comparing deformation structures and strain-hardening behavior across controlled temperature and strain-rate conditions.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
