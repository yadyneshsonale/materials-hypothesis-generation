  "claims": [
    {
      "text": "The initial passivated high-entropy alloy has a stable, protective surface oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Tribo-corrosion degradation in passivated HEAs is dominated by the interplay between mechanical film removal and hindered passive-film reformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical sliding disrupts or removes the protective oxide film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Electrolyte conditions modulate the kinetics of passive-film reformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow repassivation leaves freshly exposed alloy substrate vulnerable to rapid corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion of the exposed substrate weakens the surface and thereby accelerates mechanical wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Repeated film removal and hindered repair synergistically increase total degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The film disruption-repair cycle reinforces both the corrosion and wear components of degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing sliding load or sliding speed while slowing repassivation will increase total tribo-corrosion degradation relative to the separate pure-wear and pure-corrosion baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The adverse combined condition will produce greater wear loss than the matched pure-wear baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The adverse combined condition will produce higher corrosion current density than the static pure-corrosion baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conditions that accelerate repassivation will mitigate combined degradation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower pH or the absence of inhibitors slows repassivation in the proposed test conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should apply when degradation of a passivated HEA is primarily governed by surface-film dynamics.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism may fail when bulk microstructural instability or phase transformation governs degradation independently of passive-film behavior.",
      "field": "boundary",
