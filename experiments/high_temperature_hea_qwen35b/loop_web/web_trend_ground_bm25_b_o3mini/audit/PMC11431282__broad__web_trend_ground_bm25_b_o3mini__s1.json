  "claims": [
    {
      "text": "Undoped MnNiSi-based alloys exhibit a large magnetocaloric effect.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped MnNiSi-based alloys have limited mechanical performance characterized by brittle behavior.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 wt% Ti and subsequently annealing the alloy will produce TiSi precipitates in the MnNiSi matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting TiSi precipitates will be nanoscale, fine, and uniformly dispersed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale TiSi precipitates will hinder dislocation motion through dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale TiSi precipitates will impede crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti addition and precipitate dispersion will increase strength, ductility, and fracture toughness relative to undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Ti concentration of 1–2 wt% is sufficiently low to preserve the key magnetic sublattice.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will retain magnetic entropy change within approximately 10% of the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetic entropy change is an appropriate measure of magnetocaloric performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10145517::web::022::3_4_magnetic_properties",
        "PMC4623812::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Room-temperature operation is relevant to magnetic-refrigeration applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Ti contents above about 2 wt% could produce excessive secondary phases or alter magnetic ordering.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficiently controlled annealing could cause undesired phase transformations or microstructural changes.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive secondary phases or altered magnetic ordering could degrade the magnetocaloric effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Magnetic-refrigeration materials must combine a large magnetic entropy change with adequate mechanical stability.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10145517::web::022::3_4_magnetic_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis is falsified if the Ti-doped samples improve mechanical performance by less than 10% or lose more than 10% of the baseline magnetocaloric effect.",
