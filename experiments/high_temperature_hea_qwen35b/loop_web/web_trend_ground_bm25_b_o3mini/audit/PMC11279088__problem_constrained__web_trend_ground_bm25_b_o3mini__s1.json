  "claims": [
    {
      "text": "The formation and persistence of a protective oxide scale in CrFeCoNiX alloys is primarily governed by diffusion and segregation of the X element.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al has slower diffusion than the other proposed X elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al has a strong affinity for oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al additions promote formation of a protective Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al2O3 scales grow more slowly and are more stable than chromium-oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 scale is coherent, adherent, and persists during extended high-temperature exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 barrier limits further oxygen ingress.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation of an Al2O3 barrier minimizes volatile CrO3 formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Chromia can form volatile CrO3 above 900 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn has high mobility and undergoes rapid outward transport or surface segregation during oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn is a major oxide-forming element in CrMnFeCoNi and forms non-protective oxides that deplete Mn from the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn depletion can produce pores and accelerate oxide growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The manganese oxides formed in Mn-containing alloys are volatile.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-containing alloys develop oxide scales that crack or spall.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain boundaries and phase interfaces in multiphase alloys provide additional diffusion paths that exacerbate Mn transport and scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase alloys produce more uniform oxide scales than multiphase alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
