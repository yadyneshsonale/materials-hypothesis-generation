      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-containing CrFeCoNiX alloys will have more coherent and adherent scales than the CrFeCoNi baseline, while Mn-containing alloys will have less protective scales than Al-containing alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
