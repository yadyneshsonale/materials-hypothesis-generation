        "PMC12842692::web::030::4_conclusions",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Coatings with smaller layers and higher interface density will have lower creep rates than otherwise comparable thick-layer multilayers.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coatings with smaller layers and higher interface density will have lower creep rates than homogeneous single-phase HEA coatings.",
      "field": "predicted_outcome",
