      "supporting_ids": [
        "PMC12842692::web::021::3_3_difference_in_creep_resistance_betwe",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Interfaces produced by reducing layer thickness limit atomic diffusion pathways.",
