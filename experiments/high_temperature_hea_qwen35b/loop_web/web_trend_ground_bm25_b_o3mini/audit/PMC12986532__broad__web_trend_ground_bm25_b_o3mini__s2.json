      "supporting_ids": [
        "PMC12842692::web::021::3_3_difference_in_creep_resistance_betwe",
        "PMC12842692::web::031::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing interface density restricts dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting dislocation motion and diffusion delays the onset and progression of time-dependent plastic deformation.",
