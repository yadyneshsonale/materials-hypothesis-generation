      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfaces produced by reducing layer thickness obstruct dislocation propagation across layers.",
      "field": "structural_mediator",
      "needs_support": true,
