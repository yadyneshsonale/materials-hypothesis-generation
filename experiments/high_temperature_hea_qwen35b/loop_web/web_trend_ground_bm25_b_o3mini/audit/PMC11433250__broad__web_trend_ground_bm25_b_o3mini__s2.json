      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC-coated components will have a lower corrosion rate than untreated boride-based components under equivalent molten-aluminum exposure.",
      "field": "predicted_outcome; baseline",
