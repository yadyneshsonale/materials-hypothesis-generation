  "claims": [
    {
      "text": "The starting CoCrFeNi matrix has a single-phase solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CoCrFeNi develops uncontrolled oxide films during elevated-temperature sliding in ambient air.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Non-uniform, excessive oxide layers increase friction in unmodified CoCrFeNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Non-uniform, excessive oxide layers increase wear in unmodified CoCrFeNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention is to disperse approximately 1–3 vol% hBN platelets uniformly within CoCrFeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed hBN will produce an adaptive in situ tribofilm over approximately 25–800 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting tribofilm will be stable and enriched in hBN.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "hBN platelets act as solid lubricants at the sliding interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "hBN will suppress excessive oxide formation during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, hBN's layered structure lowers shear stress through low interlayer friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperatures, the thermal stability of hBN helps control oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation control by hBN facilitates maintenance of a lubricious tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lubricious tribofilm minimizes abrasive interactions and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "hBN-modified CoCrFeNi will have a significantly lower coefficient of friction than unmodified CoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "hBN-modified CoCrFeNi will have lower wear volume or depth than unmodified CoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::000::abstract",
        "PMC8470387::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The friction and wear benefits will persist from room temperature through 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed operating boundary is sliding in oxidizing ambient air at controlled normal loads over approximately 25–800 °C.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Potential hBN–matrix interactions at different temperatures may impair mechanical properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison will test baseline and hBN-modified specimens under identical ambient-air sliding conditions at room temperature, 400 °C, and 800 °C.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
