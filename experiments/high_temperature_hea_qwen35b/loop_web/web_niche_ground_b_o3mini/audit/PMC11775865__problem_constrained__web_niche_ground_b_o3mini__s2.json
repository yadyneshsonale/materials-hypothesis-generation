      "supporting_ids": [
        "PMC6728353::web::003::synthesis_and_characterization_of_hea_na",
        "PMC7069714::web::017::stability_of_mea_nps"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-temperature structural and chemical stability is governed by temperature-activated atomic diffusion.",
