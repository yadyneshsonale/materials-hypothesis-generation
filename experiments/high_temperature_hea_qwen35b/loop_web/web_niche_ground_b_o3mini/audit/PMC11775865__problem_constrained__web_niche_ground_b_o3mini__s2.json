      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7104385::web::002::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Temperature-activated diffusion drives elemental segregation and phase transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7104385::web::002::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reactive hydrogen-containing catalytic atmospheres accelerate segregation and phase transformation relative to inert or vacuum conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
