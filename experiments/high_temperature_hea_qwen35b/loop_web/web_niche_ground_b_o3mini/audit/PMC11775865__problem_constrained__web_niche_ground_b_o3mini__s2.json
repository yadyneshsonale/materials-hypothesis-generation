      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7104385::web::002::body"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reactive catalytic atmospheres promote reduction or differential chemical reactivity among constituent metals.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
