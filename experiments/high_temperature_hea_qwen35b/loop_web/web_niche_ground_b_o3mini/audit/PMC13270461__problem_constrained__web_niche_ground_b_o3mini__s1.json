  "claims": [
    {
      "text": "The starting material is as-built additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built alloy is a supersaturated FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built alloy contains fine precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidizing exposure produces a heterogeneous, mixed, nonprotective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC10820071::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale preferentially nucleates or grows along grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen diffusion into the alloy promotes rapid oxide formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "The heterogeneous oxide scale develops internal stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal stresses cause oxide-scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale spallation causes catastrophic failure of the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An H2-rich reducing atmosphere hinders or minimizes oxide growth because less oxygen is available.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure preserves the surface, grain-boundary integrity, and mechanical properties.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidized samples will have thicker and more discontinuous scales than the as-built baseline or reducing-atmosphere samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC10820071::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure will produce interfacial and grain-boundary microcracks.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will reduce microhardness and tensile strength relative to the as-built baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidation-related compositional changes can destabilize phases and thereby alter degradation behavior.",
