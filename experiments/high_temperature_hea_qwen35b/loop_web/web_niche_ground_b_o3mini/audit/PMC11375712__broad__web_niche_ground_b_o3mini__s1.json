      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy is a homogeneous, undoped magnetic high-entropy alloy prepared by arc-melting and homogenization annealing.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention substitutes 5–10 at.% of a transition metal with Dy or another rare-earth element.",
