    {
      "text": "Localized anisotropy creates energy barriers that pin magnetic domains more effectively.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More effective domain pinning increases the coercive field.",
