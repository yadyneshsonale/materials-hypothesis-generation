      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction",
        "PMC12692809::web::019::3_3_thermal_shock_performance"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The glaze-forming coating will maintain low friction and wear from approximately 25 °C to 800 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The uncoated CoCrFeNi substrate has a homogeneous structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uncoated CoCrFeNi exhibits increased high-temperature friction and wear because it lacks adequate surface protection.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The graded coating will present a hard ceramic surface layer at lower temperatures and an oxide-rich lubricious layer at elevated temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction",
        "PMC12692809::web::019::3_3_thermal_shock_performance"
      ],
      "same_system": "unclear"
    },
    {
