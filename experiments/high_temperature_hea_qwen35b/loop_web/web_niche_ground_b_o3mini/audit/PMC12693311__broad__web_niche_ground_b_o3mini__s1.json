  "claims": [
    {
      "text": "Adding 1–5 at.% boron to a phosphorus-containing high-entropy alloy will improve its glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–5 at.% boron will increase the thermal stability of the alloy's amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Very rapid cooling by melt-spinning can produce an amorphous Cr16Mn16Fe16Co16Ni16P20 alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cooling rate strongly affects the microstructure and phase constitution of Cr16Mn16Fe16Co16Ni16P20.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron will bond preferentially with phosphorus in the proposed alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preferential boron-phosphorus bonding will disrupt crystalline nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stable boron-phosphorus bonds will inhibit the formation of phosphorus-centered crystalline nuclei.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppression of phosphorus-centered nuclei will increase the free-energy barrier for crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed boron-mediated mechanism will stabilize the supercooled liquid.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stabilization of the supercooled liquid will expand the glass-forming window.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will have a higher glass-transition temperature than the boron-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will have a higher crystallization-onset temperature than the boron-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will exhibit a wider supercooled-liquid region than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor alloying additions do not necessarily improve the glass-forming ability of phosphorus-containing alloys.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "no"
    },
    {
      "text": "An added element with insufficient affinity for phosphorus will not provide the proposed improvement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Significant deviation from rapid-cooling conditions may prevent the proposed improvement from being observed.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A higher crystallization-onset temperature is equivalent to a wider supercooled-liquid region.",
      "field": "falsification_experiment.falsification_rule",
