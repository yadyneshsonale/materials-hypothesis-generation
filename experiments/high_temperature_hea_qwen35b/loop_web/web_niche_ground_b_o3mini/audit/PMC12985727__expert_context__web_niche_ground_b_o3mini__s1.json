      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::015::3_3_1_mechanical_properties_at_room_temp"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Changing Ta and W content can increase second-phase volume fraction and thereby lower plastic strain.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512535::web::015::3_3_1_mechanical_properties_at_room_temp"
      ],
      "same_system": "unclear"
