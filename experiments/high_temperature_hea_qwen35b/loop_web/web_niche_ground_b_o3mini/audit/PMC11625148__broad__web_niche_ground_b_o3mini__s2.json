      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-doped alloy will have greater hardness than unmodified W-Ta-Cr-V.",
