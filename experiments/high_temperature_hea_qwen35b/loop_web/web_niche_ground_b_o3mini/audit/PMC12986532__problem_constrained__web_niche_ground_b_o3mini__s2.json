      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::020::3_2_effect_of_al_content_on_properties_o"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Obstructing dislocation motion and vacancy-mediated diffusion delays progression from primary to steady-state creep.",
