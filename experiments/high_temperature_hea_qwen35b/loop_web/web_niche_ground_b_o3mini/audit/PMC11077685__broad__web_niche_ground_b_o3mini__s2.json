      "support": "partial",
      "supporting_ids": [
        "PMC9787501::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvement will occur during a 100-hour isothermal exposure at 1200°C in pure oxygen.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
