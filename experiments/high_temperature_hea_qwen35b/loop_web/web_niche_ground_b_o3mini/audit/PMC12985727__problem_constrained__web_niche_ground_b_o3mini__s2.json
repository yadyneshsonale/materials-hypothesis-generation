  "claims": [
    {
      "text": "The initial TiVNbTa alloy is a single-phase BCC, dendritic alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiVNbTa alloy has a low-temperature yield strength of about 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified TiVNbTa alloy has a yield strength of about 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified TiVNbTa alloy has approximately 30% strain capacity at 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding a minor amount of carbon and applying controlled thermomechanical treatment will precipitate nanoscale carbides in the BCC TiVNbTa matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitated carbides may include TiC.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale carbide precipitates will pin or hinder dislocations at elevated temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7376180::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitation strengthening can mitigate the elevated-temperature strength degradation of high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7376180::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbide dispersion will stabilize the TiVNbTa microstructure at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon modification and carbide precipitation will increase the TiVNbTa yield strength at 1273 K relative to the 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7376180::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will maintain adequate ductility at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength improvement will depend on the volume fraction, size, and distribution of carbide precipitates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Single-phase high-entropy alloys can have insufficient strength at elevated temperatures.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7376180::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitates have produced moderate tensile-strength increases in CoCrFeNiNbx and CoCrFeNiMox alloys.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon addition or heat treatment may form deleterious phases if processing is not carefully controlled.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Testing carbon-alloyed and carbon-free controls after identical processing at 1273 K can determine whether the intervention improves high-temperature yield strength.",
      "field": "falsification_experiment.design",
