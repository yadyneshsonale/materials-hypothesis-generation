      "support": "entailed",
      "supporting_ids": [
        "PMC4510962::web::011::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy suppresses dislocation pinning characteristic of pure tungsten.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy facilitates more reversible deformation processes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced dislocation pinning and more reversible deformation suppress premature crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
