      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual voids or holes in ZrB2 act as failure sites during liquid plating-bath exposure.",
