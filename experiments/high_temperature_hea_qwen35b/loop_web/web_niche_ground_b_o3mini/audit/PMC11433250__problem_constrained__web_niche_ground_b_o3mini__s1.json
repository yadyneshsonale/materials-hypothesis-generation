      "support": "partial",
      "supporting_ids": [
        "PMC5126569::web::024::hardness_and_oxidation_measurements"
      ],
      "same_system": "yes"
    },
    {
      "text": "Using SPS at approximately 2000 °C will lower the preparation temperature relative to conventional processing above 2300 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS processing will enhance ZrB2 densification and significantly reduce porosity relative to conventional processing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
