      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally prepared single-phase ZrB2 has insufficient strength and structural integrity for long-term plating-bath service.",
      "field": "material_initial_state",
      "needs_support": true,
