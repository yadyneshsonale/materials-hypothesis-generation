  "claims": [
    {
      "text": "Compositional tuning can systematically increase and modulate local lattice distortions in high-entropy alloys.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline alloy has a relatively homogeneous composition and minimal local lattice distortions.",
      "field": "material_initial_state; baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing method and grain size will be held constant while composition is varied.",
      "field": "intervention; falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant structural mediator is the magnitude and distribution of atomic-level local lattice strain fields.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced local lattice distortions act as obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::018::discussion",
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Elevated lattice resistance or lattice friction impedes dislocation slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::014::discussion",
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Greater resistance to dislocation motion raises alloy strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::014::discussion",
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Greater local lattice distortion raises yield strength.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Greater local lattice distortion raises hardness.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hardness and yield strength will increase proportionally with the magnitude of local lattice distortion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A distorted lattice more effectively pins dislocations.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism should dominate in single-phase or near-single-phase FCC or BCC high-entropy alloys when grain-boundary strengthening and secondary phases are not primary contributors.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Large compositional changes that cause phase instability or substantial secondary-phase formation may cause deviations from the proposed distortion-strength relationship.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain boundaries, twinning, phase transformations, stacking-fault behavior, elastic modulus, and other mechanisms can also influence alloy strength and deformation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::014::discussion",
        "PMC6687833::web::003::introduction",
        "PMC10894205::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "TEM and EBSD can quantify the local lattice distortions needed for the proposed correlation.",
      "field": "conditions; falsification_experiment.design; falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to find a statistically significant distortion–hardness or distortion–yield-strength correlation would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
