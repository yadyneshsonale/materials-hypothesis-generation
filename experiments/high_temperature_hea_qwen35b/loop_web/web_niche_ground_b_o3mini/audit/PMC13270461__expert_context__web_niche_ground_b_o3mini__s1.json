  "claims": [
    {
      "text": "The starting material is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a stable FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513170::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elevated-temperature degradation is governed by synergistic surface segregation of Cr and Ti.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction",
        "PMC9267193::web::058::4_2_5_the_nbss_solid_solution"
      ],
      "same_system": "no"
    },
    {
      "text": "Al contributes to the oxidation-related synergy and resulting scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "In an oxidizing atmosphere, Cr and Ti preferentially migrate to the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface Cr and Ti form Cr2O3 and TiO2, respectively.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure produces a duplex oxide scale with an inner Cr-rich layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The duplex scale has an outer layer influenced by Ti and Al.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale formed under oxidizing conditions is continuous and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The continuous duplex scale retards oxygen ingress and further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The underlying FCC matrix remains intact during oxidizing exposure at 800–1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513170::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing exposure results in limited oxide formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure produces irregular, discontinuous, or porous oxide patches rather than an effective barrier.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to form an effective oxide barrier under reducing conditions permits internal oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal oxidation under reducing conditions causes microstructural destabilization and accelerated degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will cause less subsurface damage than reducing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies from 800 to 1000 °C while the FCC matrix is retained.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513170::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Substantially different temperatures or gas compositions may produce different degradation phenomena.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using identical sample processing will avoid phase readjustment as a confounding factor.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
