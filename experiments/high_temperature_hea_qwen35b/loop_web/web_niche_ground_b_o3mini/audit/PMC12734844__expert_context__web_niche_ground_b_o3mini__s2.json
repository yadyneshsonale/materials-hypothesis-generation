      "supporting_ids": [
        "PMC6385271::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Substrate preheating reduces the temperature difference between the molten pool and the substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
