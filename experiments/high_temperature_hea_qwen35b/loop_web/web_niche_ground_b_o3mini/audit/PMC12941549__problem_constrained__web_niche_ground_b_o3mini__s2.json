        "PMC10384371::web::032::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing intermetallic precipitate density and redistribution will correlate with degradation of corrosion resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
