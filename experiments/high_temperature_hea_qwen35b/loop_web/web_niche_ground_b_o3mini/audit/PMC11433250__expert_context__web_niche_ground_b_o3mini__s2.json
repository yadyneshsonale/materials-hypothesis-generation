  "claims": [
    {
      "text": "Traditional single-phase ZrB2 typically requires preparation temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
