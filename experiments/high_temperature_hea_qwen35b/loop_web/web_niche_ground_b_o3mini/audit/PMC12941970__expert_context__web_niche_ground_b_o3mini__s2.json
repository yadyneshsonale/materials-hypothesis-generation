  "claims": [
    {
      "text": "The starting material is a powder-metallurgy CoCrFeNi high-entropy alloy without Ag.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention incorporates approximately 2 wt% Ag into the CoCrFeNi matrix during powder-metallurgy synthesis.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 2 wt% Ag will promote in situ formation of an Ag-rich tribofilm during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ag segregates from the alloy to the wear surface during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The segregated Ag forms a ductile, low-shear-strength tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-rich tribofilm acts as a solid lubricant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-rich tribofilm mitigates adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-rich tribofilm mitigates oxidative wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adhesive wear, oxidative wear, and oxide-layer degradation are relevant tribological processes in compositionally related CoCrFeMnNi alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9960858::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ag-doped alloy will have a lower coefficient of friction than undoped CoCrFeNi throughout the range from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-doped alloy will have a lower wear rate than undoped CoCrFeNi throughout the range from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Very low wear can be maintained from room temperature to 800 °C in a different Ni-based alloy system.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::011::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal softening can occur as temperature rises from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::011::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidation and thermal softening are pronounced at elevated temperatures in the tested CoCrFeNi system.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::000::abstract",
        "PMC10241162::web::011::remarkable_wear_resistance_and_wear_mech"
      ],
      "same_system": "no"
    },
    {
