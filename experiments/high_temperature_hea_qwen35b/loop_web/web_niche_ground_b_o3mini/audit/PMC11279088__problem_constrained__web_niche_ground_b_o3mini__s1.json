{
  "run_id": "PMC11279088__problem_constrained__web_niche_ground_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "In CrFeCoNiX alloys, stable protective-scale formation above 900 °C is governed by lattice and thermal-expansion matching between the oxide and alloy matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Better oxide/matrix matching lowers interfacial stress and thereby improves oxide coherence and persistence.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al additions promote formation of a protective Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 scales grow more slowly than chromium oxide scales and resist high-temperature oxidation and corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 reduces cation and oxygen diffusivities.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 minimizes oxide growth stresses.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 is thermodynamically stable and chemically inert under the proposed exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An alumina layer limits further oxygen ingress into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn-containing alloys form Mn-bearing spinel or other mixed oxides at temperatures around and above 950 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn-bearing mixed oxides have higher growth stresses than alumina.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-bearing mixed oxides are prone to cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si additions may form a silica layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si has an intermediate protective effect that is weaker than the effect of Al.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-containing alloys will form thinner and more continuous oxide scales than the baseline and Mn-containing variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al-containing alloys will form more adherent oxide scales with fewer cracking or spallation events than the baseline and Mn-containing variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-containing alloys will exhibit lower oxidation mass gains than the CrFeCoNi baseline and Mn-containing variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior applies broadly to both initially single-phase and multiphase CrFeCoNiX metallic solid solutions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies above 900 °C in both oxidative and corrosive atmospheres.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxide thickness, growth rate, and spallation behavior depend on alloy composition, processing history, and exposure time.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    }
  ],
