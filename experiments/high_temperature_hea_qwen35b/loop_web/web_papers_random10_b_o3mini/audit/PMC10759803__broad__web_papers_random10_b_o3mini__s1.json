      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitation strengthening can improve yield strength in lightweight refractory high-entropy alloys.",
