      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local chemical order increases lattice friction through nanoscale segment detrapping.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6687833::webcard"
      ],
      "same_system": "yes"
    },
    {
