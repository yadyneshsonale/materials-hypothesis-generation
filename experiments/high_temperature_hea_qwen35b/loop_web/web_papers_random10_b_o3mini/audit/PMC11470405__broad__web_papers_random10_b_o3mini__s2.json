      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The impurity-doped alloy will have lower yield strength after aging than an otherwise equivalent high-purity alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
