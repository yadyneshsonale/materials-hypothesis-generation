      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial-induced segregation reduces the thermoelastic modulus relative to a purified baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
