      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "During prolonged high-temperature exposure, trace interstitials promote phase segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial-induced phase segregation depletes the metal matrix of strengthening interstitial solutes.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial-induced segregation produces nanoscale inhomogeneities and precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "yes"
    },
    {
