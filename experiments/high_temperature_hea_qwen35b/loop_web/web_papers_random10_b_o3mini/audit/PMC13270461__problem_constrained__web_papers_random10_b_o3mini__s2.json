      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8346963::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxygen diffusion occurs preferentially along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale can crack or spall during elevated-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8346963::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxide-scale cracking or spallation causes localized depletion of Cr and Ti.",
