      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9319277::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical wear removes the weakened or nascent passive film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removal of the passive film exposes fresh reactive metal and causes rapid localized corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
