      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9319277::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under combined wear and corrosion, total degradation will significantly exceed the sum of degradation measured in isolated wear and corrosion tests.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
