      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC phase is mechanically soft and the B2 phase is mechanically hard.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hierarchical microstructure contains ultrafine FCC grains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Differences in strain partitioning between constituent phases contribute to formation of the hierarchical microstructure during processing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "unclear"
    },
