      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::000::abstract",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain refinement increases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hierarchical lamellar architecture improves stress distribution and delays crack propagation, thereby improving ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "unclear"
