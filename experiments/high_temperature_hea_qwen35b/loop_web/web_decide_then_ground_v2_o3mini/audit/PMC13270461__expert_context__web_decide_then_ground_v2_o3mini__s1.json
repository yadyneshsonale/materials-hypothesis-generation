  "claims": [
    {
      "text": "The as-manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy is single-phase fcc.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-manufactured alloy has a uniform elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has high strength and fatigue performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Degradation of the target alloy is primarily governed by competitive, synergistic oxidation among its constituent elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::010::1_introduction",
        "PMC7504593::web::054::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure causes rapid segregation of Al and Cr to the surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7504593::web::054::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface-segregated Al and Cr preferentially oxidize to form alumina- and chromia-rich scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al/Cr-rich oxide scale is continuous, dense, and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous Al/Cr-rich scale slows further degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective oxidation under oxidizing conditions preserves the integrity of the fcc matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under reducing conditions, Ti is retained in or dominates the substrate near the surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti retention under reducing conditions prevents complete oxidation and produces a porous, poorly adherent scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The porous scale expected under reducing conditions accelerates degradation relative to oxidizing exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will yield lower weight-gain rates and an Al/Cr-enriched coherent scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure will yield a more porous scale, unstable mass change or weight loss, and incomplete passivation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies throughout approximately 800–1200 °C under representative oxidizing and reducing gas compositions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure outside the proposed conditions may cause phase transformations or additional degradation mechanisms.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior studies support a protective oxidation role for Al and Cr.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7040784::web::010::1_introduction",
        "PMC7504593::web::054::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The quantitative effect of Ti on oxide morphology and degradation kinetics in the target alloy remains uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al/Cr enrichment and scale continuity should correlate with reduced degradation, whereas porosity and poor adherence should correlate with increased degradation.",
      "field": "falsification_rule",
      "needs_support": true,
