  "claims": [
    {
      "text": "The baseline TiVNbTa alloy has a single-phase BCC dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline TiVNbTa alloy has a lower-temperature yield strength of about 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a yield strength of about 330 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a compressive strength of about 423 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing a secondary phase along dendrite boundaries will create a bimodal or multiphase microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156277::web::017::4_conclusions",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "A controlled secondary phase can be promoted through tailored heat treatment or a minor alloying addition.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "Secondary-phase precipitates at dendrite boundaries will act as barriers that pin dislocations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "The introduced secondary phase will refine the effective microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation strengthening can improve the elevated-temperature strength of HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boundary precipitates will limit thermally activated dislocation climb or slip at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will raise the TiVNbTa yield strength at 1273 K above the 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC12156277::web::017::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention will increase the TiVNbTa compressive strength at 1273 K relative to the 423 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156277::web::017::4_conclusions",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "A multiphase microstructure can retain useful ductility while improving strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156277::web::017::4_conclusions",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "The strengthened TiVNbTa alloy will maintain good thermal conduction for heat transfer between W and CuCrZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is intended for operation at 1273 K under tensile and compressive loading representative of a W–CuCrZr intermediate layer.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed material should tolerate cyclic mechanical loading associated with approximately 30% strain without unacceptable loss of thermal conductivity.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength improvement depends on obtaining an optimal volume fraction and distribution of the secondary phase.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC7512535::web::025::4_2_ta_and_w_effects_at_room_temperature"
      ],
      "same_system": "no"
    },
    {
      "text": "An improperly controlled secondary phase may cause embrittlement or reduce thermal conductivity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention can be tested against a single-phase TiVNbTa control using mechanical tests at 1273 K and SEM/TEM characterization of precipitate size and distribution.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to produce a statistically significant strength improvement, or deterioration of ductility or thermal conductivity, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
