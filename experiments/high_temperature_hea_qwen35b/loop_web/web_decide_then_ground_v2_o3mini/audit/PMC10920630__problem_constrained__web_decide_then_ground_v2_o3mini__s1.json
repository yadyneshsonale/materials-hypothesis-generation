  "claims": [
    {
      "text": "Untreated Q235 steel forms an in-situ iron oxide/hydroxide layer during exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At low chloride concentrations and room temperature, the oxide film on Q235 steel remains relatively uniform and protective.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8836748::web::020::4_3_effects_of_mo_addition_on_the_corros"
      ],
      "same_system": "no"
    },
    {
      "text": "A uniform, protective oxide film suppresses early corrosion onset.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8836748::web::020::4_3_effects_of_mo_addition_on_the_corros"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing chloride concentration disrupts the oxide film on untreated Q235 steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chloride ions adsorb onto the Q235 steel surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adsorbed chloride interferes with formation of a uniform protective oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated temperature accelerates oxide-film breakdown.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated temperature accelerates aggressive chloride attack.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Disruption of the protective oxide film leads to localized pitting corrosion.",
