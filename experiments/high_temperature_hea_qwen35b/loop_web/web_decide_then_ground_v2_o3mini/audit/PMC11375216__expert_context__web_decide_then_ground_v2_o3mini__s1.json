      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11369437::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Chemical disorder, mass fluctuations, and force-constant fluctuations can intensify phonon scattering in high-entropy alloys.",
      "field": "baseline",
