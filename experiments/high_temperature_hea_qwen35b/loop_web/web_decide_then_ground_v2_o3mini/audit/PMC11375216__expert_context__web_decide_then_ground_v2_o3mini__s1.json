      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11136967::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Calculated phonon dispersion, including anharmonic effects, mediates the lattice-transport prediction.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11369437::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Dynamically coupling electron and phonon subsystems enables their thermal-conductivity contributions to be decoupled.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electron–phonon interactions determine the electronic thermal conductivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Anharmonic phonon scattering controls lattice thermal conductivity.",
