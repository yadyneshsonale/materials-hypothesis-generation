  "claims": [
    {
      "text": "A multiscale ab initio framework can explicitly couple electron–phonon interactions with anharmonic phonon scattering for HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "This framework will decouple and accurately predict the lattice and electronic thermal-conductivity contributions of HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The framework will improve predictive accuracy by at least 20–30% relative to Debye-temperature-based models.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
