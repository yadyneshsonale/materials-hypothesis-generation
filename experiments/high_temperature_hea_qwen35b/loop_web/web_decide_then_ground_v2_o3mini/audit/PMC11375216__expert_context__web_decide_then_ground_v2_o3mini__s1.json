      "support": "entailed",
      "supporting_ids": [
        "PMC11369437::web::003::introduction",
        "PMC9726824::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Earlier approaches relevant to HfNbTaTiZr relied on mass, force-constant, or Debye-temperature estimates.",
