      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below 200 K, lattice and electronic heat-transport contributions in HfNbTaTiZr are comparable.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11369437::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed method is valid for HfNbTaTiZr from 300 to 1200 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The total thermal conductivity of oxygen-containing HfNbTaTiZr is approximately 10–17 W/(K m) from 300 to 1200 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
