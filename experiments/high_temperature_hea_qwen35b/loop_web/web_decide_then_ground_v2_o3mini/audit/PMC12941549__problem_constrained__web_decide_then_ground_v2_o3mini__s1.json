  "claims": [
    {
      "text": "The starting Mg-containing lightweight high-entropy alloy is in a metastable, non-equilibrium solid-solution-containing state.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
