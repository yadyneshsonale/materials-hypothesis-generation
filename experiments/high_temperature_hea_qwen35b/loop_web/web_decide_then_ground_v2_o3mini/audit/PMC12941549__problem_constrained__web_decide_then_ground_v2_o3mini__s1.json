      "supporting_ids": [
        "PMC11886756::web::028::conclusions",
        "PMC12348563::web::021::3_4_microstructure_and_chemical_composit"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed Mg-based passivating film also improves aqueous corrosion resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarsening of the Mg-enriched intermetallic phases depletes Mg from the surrounding matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
