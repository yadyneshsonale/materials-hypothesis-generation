  "claims": [
    {
      "text": "The baseline condition is an as-deposited FeNiCrCoCu coating without a deliberately refined precipitate dispersion.",
      "field": "material_initial_state; baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline coating has a coarser or less-uniformly distributed precipitate arrangement than the proposed heat-treated coating.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled heat treatment will refine the precipitate size in the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled heat treatment will increase the precipitate volume fraction.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting structural mediator is a refined dispersion of fine precipitates within the alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine precipitates hinder dislocation motion during sliding.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstructing dislocation motion reduces dynamic and localized plastic deformation during sliding.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9416578::web::025::3_5_friction_wear"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined precipitate dispersion decreases localized softening during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
