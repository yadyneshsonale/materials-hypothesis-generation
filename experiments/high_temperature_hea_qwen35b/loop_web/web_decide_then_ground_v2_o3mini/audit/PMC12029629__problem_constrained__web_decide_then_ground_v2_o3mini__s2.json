      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9646780::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocation activity facilitates the local rearrangements responsible for short-range ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9646780::web::000::abstract"
      ],
      "same_system": "no"
