      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing strain rate reduces the effective energy barrier for dislocation pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The plasticity mechanism transitions from conventional dislocation glide to dynamic dislocation unpinning.",
      "field": "mechanism",
      "needs_support": true,
