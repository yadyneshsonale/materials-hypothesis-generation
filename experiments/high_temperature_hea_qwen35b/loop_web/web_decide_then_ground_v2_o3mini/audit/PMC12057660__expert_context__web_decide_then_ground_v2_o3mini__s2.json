      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
      "text": "A uniformly dispersed, single-source mixture of reducible noble-metal precursors is the relevant initial state.",
