      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The degree of atomic-level mixing during concurrent nucleation determines whether a single-phase solid solution or a segregated product forms.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Simultaneous precursor reduction causes near-synchronous nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Near-synchronous nucleation promotes extensive atomic collisions and mixing that freeze in a homogeneous alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "With unsynchronized reduction, early nuclei grow and capture later-released atoms non-uniformly.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Non-uniform capture of later-released atoms produces phase separation and elemental segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "yes"
    },
    {
