  "claims": [
    {
      "text": "Equiatomic FeCoNiPd and FeCoNiPt are fcc alloys with low coercivity and high saturation magnetization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Pd in equiatomic FeCoNiPd with Ir produces equiatomic FeCoNiIr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Pt in equiatomic FeCoNiPt with Ir produces equiatomic FeCoNiIr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ir substitution will induce a modest tetragonal distortion in the FeCoNi-based fcc lattice.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ir has stronger spin–orbit coupling than both Pd and Pt.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ir substitution will locally break fcc symmetry and create anisotropic lattice strains.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower lattice symmetry combined with strong spin–orbit coupling can enhance magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Strain-induced anisotropy can strengthen domain-wall pinning and increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced magnetocrystalline anisotropy raises the energy barrier for domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed FeCoNiIr alloy will have higher coercivity than FeCoNiPd and FeCoNiPt prepared under comparable conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "FeCoNiIr will maintain saturation magnetization comparable to that of FeCoNiPd and FeCoNiPt.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid solidification followed by controlled near-room-temperature annealing can retain a predominantly fcc FeCoNiIr phase while permitting slight tetragonal distortion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity enhancement is expected only for a nearly equiatomic, high-entropy composition that remains predominantly fcc.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Significant off-equiatomic composition or secondary-phase formation could negate the coercivity enhancement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High symmetry in a cubic lattice limits intrinsic magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "In earlier FeCoNiMnCu-based films, Pt addition reduced fcc cubic symmetry to a tetragonal L10 phase with high magnetocrystalline anisotropy.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The magnitude of coercivity enhancement will depend on processing conditions and the degree of lattice distortion.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis can be tested by comparing room-temperature coercivity, saturation magnetization, phase constitution, and lattice distortion in similarly processed FeCoNiIr, FeCoNiPd, and FeCoNiPt samples.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if FeCoNiIr does not exhibit significantly higher coercivity than the controls, or if the proposed tetragonal distortion or associated anisotropy enhancement is absent.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
