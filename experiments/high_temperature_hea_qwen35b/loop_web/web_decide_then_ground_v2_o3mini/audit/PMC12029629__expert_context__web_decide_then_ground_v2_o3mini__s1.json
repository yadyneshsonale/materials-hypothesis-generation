      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10385466::web::000::abstract",
        "PMC10385466::web::020::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher strain rates promote adiabatic shear-band formation in as-solidified FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Non-ambient temperatures can promote localized deformation and adiabatic shear-band formation in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid local deformation produces localized heating in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized heating accelerates dislocation motion in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid dislocation accumulation and localized heating trigger dynamic recrystallization in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic recrystallization ultimately contributes to adiabatic shear-band formation in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Shear localization softens the mechanical response and changes the apparent strength and ductility of FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanical response of entropy alloys can depend on temperature, strain rate, composition, and dislocation-related microstructure.",
