  "claims": [
    {
      "text": "The starting material is the HfZrTiTa0.53 refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a quasi-static yield strength of 786 MPa, compressive strength of 1314 MPa, and fracture strain of 13.5%.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated HfZrTiTa0.53 has limited strain hardening, poor uniform deformability, and rapid failure at high strain rates.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid annealing or aging of HfZrTiTa0.53 will produce a fine-scale, uniformly dispersed population of nanoscale precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will act as pinning sites and obstacles to dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will increase dislocation storage capacity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing dislocation storage and impeding dislocation motion will enhance strain hardening during high-rate deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6467881::web::013::room_temperature_deformation_mechanisms_"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced strain hardening from the precipitate dispersion will delay adiabatic shear-band initiation and deformation localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11943535::web::000::abstract",
        "PMC11943535::web::018::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated alloy will have a higher dynamic yield strength than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::009::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC12298045::web::036::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The increase in dynamic yield strength may be approximately 10–20%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will exhibit more uniform plastic flow and greater strain before localization than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298045::web::036::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will produce a more controlled and reduced burst of impact-induced energy release.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction applies at room temperature under nominally adiabatic dynamic compression at strain rates of 10^3–10^4 s^-1.",
