  "claims": [
    {
      "text": "Structural and chemical stability in initially random high-entropy nanoparticles is governed by competition between configurational-entropy stabilization and pair-specific enthalpic interactions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC4976365::web::005::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At sufficiently high operating temperatures, strongly interacting element pairs form locally ordered clusters.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC4976365::web::005::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Moderate local clustering reinforces the lattice and increases resistance to structural and chemical degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive clustering can lead to phase segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::005::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Excessive clustering can degrade catalytic or thermoelectric performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A slight deviation from an equiatomic composition can induce a modest degree of local elemental clustering.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC4976365::web::005::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A pre-annealing step can induce a controlled, modest degree of local elemental clustering.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strong pairwise interactions produce local ordered domains or nanoclusters.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract",
        "PMC4976365::web::005::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At lower temperatures, configurational entropy maintains a homogeneous random solid solution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As temperature increases, enthalpic interactions overcome local entropy and cause nanodomain formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Moderately sized clusters inhibit deleterious atomic rearrangements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderately sized clusters maintain catalytic and thermoelectric performance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimally clustered nanoparticles will have greater high-temperature structural and chemical stability than an initially random baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimally clustered nanoparticles will exhibit more stable catalytic and thermoelectric performance than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stability benefit exists only over an intermediate clustering range and is absent when clustering is too weak or sufficiently strong to cause bulk phase separation.",
