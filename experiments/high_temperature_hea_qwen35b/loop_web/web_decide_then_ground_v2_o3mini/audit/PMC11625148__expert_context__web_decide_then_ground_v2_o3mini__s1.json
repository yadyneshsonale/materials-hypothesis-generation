  "claims": [
    {
      "text": "The untreated baseline is an equal-atomic, single-phase BCC NbMoTaW alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW has excellent high-temperature mechanical performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC4145285::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The irradiation resistance of NbMoTaW has not been experimentally verified.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5–10 at% V should be added to NbMoTaW.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding V will promote a finely dispersed, coherent secondary phase in NbMoTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding V will beneficially modify grain-boundary chemistry in NbMoTaW.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The V-induced secondary phase or altered interfaces will provide ductile pathways that facilitate room-temperature dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The V-induced interfaces will act as sinks for irradiation-induced defects, including vacancies and helium atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V addition may activate new slip systems through changes in local chemistry.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V-doped NbMoTaW will have significantly greater room-temperature strain to failure than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V-doped NbMoTaW will exhibit reduced yield anomalies relative to untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 5–10 at% V will not degrade NbMoTaW's high-temperature strength up to approximately 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V-doped NbMoTaW will retain a stable BCC matrix up to approximately 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V addition will reduce irradiation-induced amorphization, blistering, and precipitation relative to untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC9572595::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed benefits will apply under reactor-relevant helium implantation energies.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Poorly controlled V content may lead to brittle precipitates and embrittlement.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    }
