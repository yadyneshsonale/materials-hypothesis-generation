      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will have significantly greater fracture toughness than the untreated alloy.",
      "field": "predicted_outcome",
