  "claims": [
    {
      "text": "Selective oxidation of Al and Cr in MPEAs drives formation of a dual-layer protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::000::abstract",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al/Cr-derived oxide scale preserves material integrity during long-term high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic AlCoCrFeNi is a representative initial MPEA composition.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial MPEA is homogeneous and single-phase with minimal pre-existing microsegregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled oxidation experiments and atomistic or mesoscale simulations can monitor oxide kinetics and interfacial structure.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::000::abstract",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed exposure window is 800–1200°C in air or another oxygen-rich environment, under static and cyclic conditions, for up to 25 hours.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale consists primarily of an outer α-Al2O3 layer and an inner Cr2O3 layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::000::abstract",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dual-layer scale minimizes defects and limits diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al and Cr have sufficiently high oxygen affinities to favor their oxidation at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al and Cr oxidize preferentially in high-temperature AlCoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::000::abstract",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 and Cr2O3 form coherent, adherent layers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3- and Cr2O3-rich layers act as diffusion barriers that reduce subsequent oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective layers suppress microstructural degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with the baseline, the optimized MPEA will have lower weight gain and thinner oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with the baseline, the optimized MPEA will have a more uniform oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with the baseline, the optimized MPEA will maintain greater mechanical integrity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies from 800°C to 1200°C when oxidation is diffusion-controlled.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The mechanism remains applicable during thermal cycling provided that extensive phase separation or other deleterious microstructural changes do not occur.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni, Fe, and Co can influence oxide-scale formation and stability, but their effects are not fully quantified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
