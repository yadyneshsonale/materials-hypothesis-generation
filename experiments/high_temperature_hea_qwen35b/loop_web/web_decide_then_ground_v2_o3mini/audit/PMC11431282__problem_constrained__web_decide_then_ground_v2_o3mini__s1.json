  "claims": [
    {
      "text": "The unchanged (MnNiSi)0.62(FeCoGe)0.38 alloy exhibits a strong caloric response under applied magnetic and pressure fields.",
      "field": "material_initial_state, baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has poor load-bearing integrity and tends to crack.",
      "field": "material_initial_state, baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of approximately 0.3–0.5 wt% Nb.",
      "field": "hypothesis, intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.3–0.5 wt% Nb will cause Nb to segregate to grain boundaries.",
      "field": "hypothesis, structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.3–0.5 wt% Nb will form fine Nb-rich precipitates.",
      "field": "hypothesis, structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Nb-rich precipitates will be ductile.",
      "field": "hypothesis, structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb addition will refine the alloy's grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4510962::web::012::discussion",
        "PMC4740901::web::009::deformation_and_failure_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain refinement can contribute to improved strength and ductility.",
      "field": "structural_mediator, mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4510962::web::012::discussion",
        "PMC4740901::web::009::deformation_and_failure_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb-rich precipitates and grain-boundary segregation will blunt crack tips.",
      "field": "hypothesis, mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb-rich precipitates and grain-boundary segregation will reduce crack initiation and propagation.",
      "field": "hypothesis, mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitates and other microstructural obstacles can strengthen crystalline metals by interacting with dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb microalloying will increase fracture toughness relative to the unchanged alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4510962::web::012::discussion",
        "PMC4740901::web::009::deformation_and_failure_mechanisms",
        "PMC5321736::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb microalloying will increase ductility relative to the unchanged alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4510962::web::012::discussion",
        "PMC4740901::web::009::deformation_and_failure_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "The magnitude of the magnetocaloric and barocaloric responses will remain statistically unchanged after Nb addition.",
      "field": "hypothesis, predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applicable magnetic-field, pressure-field, and temperature operating boundaries will remain statistically unchanged after Nb addition.",
      "field": "predicted_outcome, boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-rich microstructure will not disrupt the cooperative phase transition responsible for the magnetocaloric and barocaloric effects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb addition within the proposed range will not introduce new phase transitions or move the caloric transition outside the refrigeration operating range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact effect of Nb concentration and heat treatment on the caloric transition is uncertain and may require tuning.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
