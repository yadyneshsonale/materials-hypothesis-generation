      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline AlCrTiV0.5 alloy is a homogeneous single-phase solid solution with moderate lattice distortion and no significant segregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
