  "claims": [
    {
      "text": "Equiatomic CrMnFeCoNi and equiatomic CrCoNi are the compared alloy systems.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Both CrMnFeCoNi and CrCoNi have single-phase FCC structures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi exhibits higher strength than the CrMnFeCoNi baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi exhibits higher ductility than the CrMnFeCoNi baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has a lower stacking-fault energy than CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lower stacking-fault energy of CrCoNi promotes deformation-induced nanotwinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Networks of nanotwins form in CrCoNi after extensive deformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi develops a higher density of deformation-induced nanotwins than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deformation-induced nanotwin network in CrCoNi is more interconnected than that in CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanotwins act as strong obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanotwins provide sites for dislocation absorption and thereby accommodate plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twinning-controlled deformation contributes to the favorable mechanical behavior of CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation-twin interactions raise the strength of CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twin-mediated plastic accommodation improves strain hardening and delays necking, thereby increasing ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to CrMnFeCoNi, CrCoNi will exhibit a higher strain-hardening rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed superiority of CrCoNi should be observable at both room and cryogenic temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism applies primarily to single-phase FCC high- and medium-entropy alloys without second-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing conditions and temperature extremes can substantially alter twin-formation dynamics.",
