  "claims": [
    {
      "text": "Single-phase ZrB2 normally requires processing temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrB2 produced at lower temperatures has limited oxidation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10813983::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "ZrB2 produced at lower temperatures has limited liquid-metal corrosion resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10813983::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 5–10 wt% SiC should be incorporated into ZrB2 powder.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC addition can enable full or near-full densification of ZrB2 below 1700 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC addition can improve the high-temperature stability of ZrB2.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC addition can improve the corrosion resistance of ZrB2.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-rich interfacial phases form along grain boundaries in SiC-doped ZrB2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silica-rich glassy grain-boundary phase promotes liquid-phase-assisted densification.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-rich phase acts as a continuous protective barrier.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC initiates a transient liquid phase that facilitates particle bonding and lowers the effective sintering temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During high-temperature exposure, SiC reacts to form a silica-based scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silica-based scale protects the ZrB2 matrix against rapid oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silica-based scale protects the ZrB2 matrix against liquid-metal corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC-doped ZrB2 processed below 1700 °C should have greater structural strength than undoped lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC-doped ZrB2 should resist high-temperature oxidation better than conventional single-phase ZrB2 and prior lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SiC-doped ZrB2 should resist liquid-metal corrosion better than conventional single-phase ZrB2 and prior lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefits apply at service temperatures up to approximately 1500–1700 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidation and liquid-heavy-metal corrosion are important service challenges for Zr-based materials.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10813983::web::003::1_introduction"
      ],
      "same_system": "no"
    }
  ],
