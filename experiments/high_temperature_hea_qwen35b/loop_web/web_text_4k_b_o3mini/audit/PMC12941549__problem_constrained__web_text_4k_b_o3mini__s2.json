      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature exposure activates Mg diffusion out of the metastable solid solution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mg diffusion causes segregation and nucleation and growth of Mg-rich intermetallic compounds.",
