  "claims": [
    {
      "text": "The initial AlCoCrFeNi-based EHEA has a dual-phase lamellar-colony microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Internal boundaries in the initial alloy act as microcrack-nucleation sites and cause room-temperature brittleness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A small Hf addition produces Hf-rich precipitates in the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-rich precipitates will be fine and uniformly distributed.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-rich precipitates are located at grain and phase boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Hf-rich precipitates provide precipitation strengthening within the matrix or B2 phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitation-strengthening effect operates by impeding dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Boundary-associated Hf-rich precipitates pin grain and phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Boundary pinning by Hf-rich precipitates arrests microcrack initiation at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boundary pinning by Hf-rich precipitates arrests microcrack propagation at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions",
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-modified alloy will have higher room-temperature yield and tensile strengths than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-modified alloy will have greater room-temperature tensile ductility than the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::018::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Tailored casting, rolling, and annealing can preserve the alloy's lamellar character.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is effective only when processing produces a stable, fine dispersion of Hf-rich precipitates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Hf may cause coarse precipitates or deleterious phase transformations that prevent the predicted improvements.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
