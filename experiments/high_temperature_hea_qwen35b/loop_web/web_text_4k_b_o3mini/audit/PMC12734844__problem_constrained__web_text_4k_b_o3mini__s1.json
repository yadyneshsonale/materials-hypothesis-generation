  "claims": [
    {
      "text": "AlCrFeNiSi powder can be used as feedstock for selective laser melting of miniature components.",
      "field": "material_initial_state; conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10145717::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The AlCrFeNiSi feedstock is atomized powder.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A particle-size distribution of approximately 15–53 μm is typical for laser cladding or SLM feedstock relevant to these components.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11396468::web::008::2_1_experimental_design"
      ],
      "same_system": "no"
    },
    {
      "text": "The build platform and local build atmosphere should be preheated during processing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A preheat temperature between 600 °C and 800 °C is an applicable processing window for AlCrFeNiSi.",
      "field": "intervention; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating reduces temperature gradients during melting and solidification.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced temperature gradients lower the rapid cooling rate.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower cooling produces more uniform heat distribution and permits stress relaxation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More uniform heating and stress relaxation reduce retained residual thermal stress.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating leads to fewer thermal contractions and reduces microcrack or defect formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated components will have lower residual stress than ambient-substrate SLM components.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated components will have a finer and more uniform microstructure than ambient-substrate SLM components.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated components will exhibit improved ductility relative to ambient-substrate SLM components.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheated components will exhibit higher yield strength relative to ambient-substrate SLM components.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard SLM at ambient substrate temperature typically causes high residual stress and degraded mechanical properties because of rapid cooling.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention applies to miniature AlCrFeNiSi components for which thermal management is critical.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal AlCrFeNiSi preheat temperature may vary with small compositional changes and component geometry.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
