  "claims": [
    {
      "text": "A transient fully molten state is the critical mediator governing single-phase formation in noble-metal HEA nanoparticles under rapid heating and cooling.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Momentarily melting all constituents enables complete atomic intermixing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Rapid cooling after complete melting can kinetically trap a single-phase solid solution such as FCC.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Failure to achieve full melting causes elemental segregation and phase separation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficiently fast cooling causes elemental segregation and phase separation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial state consists of mixed metal precursors on conductive supports.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precursor morphology is controlled and remains unmelted before processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to vary peak temperature or pulse duration while holding the fast cooling rate constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applicable synthesis regime uses an inert atmosphere such as argon.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The applicable regime requires heating above the constituent liquidus temperatures, targeting approximately 2000 K or higher.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The applicable regime requires cooling rates greater than 10^4 K/s.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis is limited to noble-metal-based HEA systems containing more than five elements.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The transient liquid phase enables rapid atomic diffusion and mixing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Brief collective melting overcomes constituent immiscibility and differences in melting point.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A peak temperature that is too low or a melting duration that is too brief produces insufficient mixing and non-uniform particle morphologies.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing peak temperature or pulse duration will increase the fraction of nanoparticles with a homogeneous single-phase structure relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lower peak conditions will increase phase separation, elemental segregation, and multiphase formation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Carbothermal shock and microwave heating are established rapid heating-cooling methods for synthesizing HEA nanoparticles.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline rapid methods yield only a modest fraction of single-phase nanoparticles and some segregation because of incomplete melting or suboptimal mixing.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
