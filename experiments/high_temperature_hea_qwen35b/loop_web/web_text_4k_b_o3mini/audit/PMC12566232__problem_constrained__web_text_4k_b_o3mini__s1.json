      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will resist adiabatic shear localization better than the baseline alloy.",
      "field": "predicted_outcome",
