      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-modified alloy will exhibit improved uniform deformability under dynamic loading.",
      "field": "predicted_outcome",
