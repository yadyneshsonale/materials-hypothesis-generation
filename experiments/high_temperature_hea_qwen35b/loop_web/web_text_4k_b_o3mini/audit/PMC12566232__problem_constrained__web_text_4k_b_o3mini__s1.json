      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-enhanced BCC phase will undergo a strain-induced transformation, such as martensitic transformation, during dynamic deformation.",
