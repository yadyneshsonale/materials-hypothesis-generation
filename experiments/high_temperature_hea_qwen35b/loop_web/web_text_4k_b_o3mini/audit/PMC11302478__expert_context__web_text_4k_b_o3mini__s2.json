      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "At low to moderate strains, lower-SFE derivatives will have higher twin density and connectivity than equiatomic CrMnFeCoNi.",
