      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The selected ternary and quaternary derivatives in the proposed comparison are single-phase FCC after comparable thermomechanical processing.",
