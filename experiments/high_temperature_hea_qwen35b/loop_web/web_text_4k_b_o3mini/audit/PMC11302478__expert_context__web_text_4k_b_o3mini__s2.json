      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanotwin networks have been observed after extensive deformation in both CrCoNi and CrMnFeCoNi.",
