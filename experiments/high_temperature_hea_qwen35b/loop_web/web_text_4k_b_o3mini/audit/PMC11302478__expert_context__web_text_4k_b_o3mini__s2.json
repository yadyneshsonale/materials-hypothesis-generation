      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Single-phase FCC CrCoNi has higher cryogenic strength and ductility than equiatomic CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
