  "claims": [
    {
      "text": "Cyclic wear removes portions of the protective oxide film from a multiphase eutectic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Wear-induced oxide removal exposes adjacent phases having different electrochemical potentials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Electrochemically dissimilar phases form micro-galvanic couples that accelerate localized corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Localized corrosion degrades the integrity of the constituent phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-induced loss of phase integrity further increases mechanical wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reciprocal enhancement of corrosion and wear creates a feedback loop that accelerates total degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed eutectic alloy has a primary FCC matrix containing intermetallic sigma or Laves phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC and intermetallic phases are electrochemically dissimilar.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A stable protective oxide film naturally forms on the alloy before being disrupted by wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The multiphase eutectic alloy will have greater total degradation than a matched single-phase or galvanically minimized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multiphase alloy will corrode faster than the baseline because of galvanic effects.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The multiphase alloy will wear faster than the baseline as its structural integrity deteriorates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing electrochemical potential differences between phases reduces galvanic coupling.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism requires a temperature high enough for dynamic oxide formation but not high enough to completely stabilize the oxide.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear must be sufficiently severe and cyclic to disrupt passivation for the proposed mechanism to prevail.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The electrolyte must not permit immediate repassivation of newly exposed surfaces for the proposed mechanism to prevail.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
