      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pd-doped samples will exhibit reduced magnetic hysteresis relative to Pd-free NiFeCoCr.",
      "field": "predicted_outcome",
