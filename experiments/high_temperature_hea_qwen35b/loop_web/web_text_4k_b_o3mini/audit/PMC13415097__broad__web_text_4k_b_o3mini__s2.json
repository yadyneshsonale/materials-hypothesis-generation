      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Narrowing the exchange-energy distribution sharpens the magnetic transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
