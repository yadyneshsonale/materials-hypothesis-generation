  "claims": [
    {
      "text": "The dynamic mechanical response of solidified FeNiCrMn is primarily governed by temperature- and strain-rate-dependent deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic solidified FeNiCrMn has a stable single-phase FCC microstructure.",
