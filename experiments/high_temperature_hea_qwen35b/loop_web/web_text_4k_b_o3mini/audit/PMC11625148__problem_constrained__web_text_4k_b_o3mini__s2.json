    {
      "text": "The precipitates will enhance dislocation mobility and promote crack-tip blunting at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-modified alloy will have greater room-temperature ductility than untreated NbMoTaW.",
