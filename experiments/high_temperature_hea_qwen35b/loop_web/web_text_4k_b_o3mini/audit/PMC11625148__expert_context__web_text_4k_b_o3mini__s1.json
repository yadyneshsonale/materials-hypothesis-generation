  "claims": [
    {
      "text": "Untreated equiatomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated NbMoTaW has excellent high-temperature strength but poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The irradiation resistance of NbMoTaW has been inferred computationally rather than established experimentally.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention replaces approximately 5 at% Nb in equiatomic NbMoTaW with Cr, producing Nb20Mo25Ta25W25Cr5.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at% Cr will create local chemical inhomogeneity or controlled nanoscale precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-associated nanoscale features will serve as irradiation-defect sinks.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr-associated nanoscale features will facilitate dislocation mobility.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr atoms can stabilize local BCC configurations in NbMoTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr atoms can act as barriers to irradiation-induced defect accumulation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr promotes low-temperature dislocation activity and thereby facilitates plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-induced heterogeneity provides more effective point-defect recombination sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-induced heterogeneity reduces helium-bubble growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated NbMoTaW, Nb20Mo25Ta25W25Cr5 will have significantly higher room-temperature strain-to-failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated NbMoTaW, the Cr-modified alloy will exhibit fewer irradiation defects, smaller helium bubbles, or fewer dislocation loops.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-modified alloy will retain high-temperature strength and BCC phase stability up to 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction",
        "PMC10179711::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention is applicable from room temperature through 1600 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable under both helium implantation and heavy-ion irradiation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive Cr may produce mechanically deleterious precipitates, including Sigma or Laves phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A successful alloy should improve room-temperature ductility by more than 20% while avoiding more than 10% degradation of high-temperature strength or phase stability.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to reduce irradiation-induced defect density or helium-bubble formation relative to untreated NbMoTaW would falsify the irradiation-tolerance component of the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
