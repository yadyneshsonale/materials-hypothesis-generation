  "claims": [
    {
      "text": "Cr39Co18Fe18Ni18Al7 is initially in a high-temperature BCC state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling from the high-temperature BCC state followed by prolonged intermediate-temperature annealing promotes nucleation and growth of a secondary phase in Cr39Co18Fe18Ni18Al7.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
