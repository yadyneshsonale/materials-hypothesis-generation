  "claims": [
    {
      "text": "Thermal annealing of high-entropy alloys in air promotes formation of a dense surface oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The annealing-induced oxide layer is self-lubricating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealing-induced oxide layer reduces both coefficient of friction and wear rate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An untreated HEA has a crystalline or amorphous microstructure lacking a protective surface oxide.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 800°C for 1 hour in air can produce the proposed surface modification.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The annealing-induced oxide remains stable in oxidative service environments from room temperature to approximately 800°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing can form a dense ZrTiO4-type composite oxide layer on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dense oxide layer protects the surface against continued oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide film minimizes direct metal-to-metal contact during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing direct metal-to-metal contact simultaneously reduces friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed HEA will have a lower coefficient of friction than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The annealed HEA will have a lower wear rate than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The reductions in friction and wear will persist from ambient temperature to 800°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated HEA surfaces have higher friction and wear because they experience direct contact and lack a self-forming lubricious oxide.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective friction and wear reduction requires uniform and complete formation of the oxide layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid thermal fluctuations may reduce the benefits of annealing.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nonoxidative service environments may reduce the benefits of annealing.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of friction and wear reduction may depend on alloy composition, annealing duration, and environmental conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
