      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10813983::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding a modest volume fraction of SiC enables effective densification of ZrB2 below 1700 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
