  "claims": [
    {
      "text": "A baseline alloy containing approximately 10 at% Al can be described as equiatomic Al–Co–Cr–Fe–Ni.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The approximately 10 at% Al baseline is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The approximately 10 at% Al baseline remains single phase from cryogenic to elevated temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low-Al baseline delivers balanced high-temperature and cryogenic properties.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al content in Al–Co–Cr–Fe–Ni increases atomic-size mismatch.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Greater atomic-size mismatch causes lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7012927::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing Al induces local compositional fluctuations that promote second-phase nucleation at lower temperatures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al alters electronic interactions and increases the ordering enthalpy of Al–Co–Cr–Fe–Ni.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "At low temperatures, favorable ordering enthalpy can overcome configurational-entropy stabilization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased Al therefore causes formation of a dual-phase microstructure at room and cryogenic temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At sufficiently high temperature, the entropy contribution to free energy can favor a single solid-solution phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature annealing suppresses the dual-phase state of the higher-Al alloys and recovers a single-phase solid solution.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The low-temperature dual-phase microstructure reduces cryogenic toughness relative to the low-Al baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Recovery of a high-temperature single phase preserves high-temperature strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Recovery of a high-temperature single phase preserves environmental resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The competition between ordering and configurational entropy correlates with deformation mechanisms that govern cryogenic toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::001::introduction",
        "PMC5494191::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The critical Al concentration for phase separation is sensitive to processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
