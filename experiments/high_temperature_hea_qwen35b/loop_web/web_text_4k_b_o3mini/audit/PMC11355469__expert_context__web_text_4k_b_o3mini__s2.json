  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin-film coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited FeNiCrCoCu coating has a more uniform microstructure than the heat-treated coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum heat treatment at approximately 500°C induces a heterogeneous microstructure containing nanotwins in FeNiCrCoCu coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::015::3_1_phase_structure_and_morphology_of_co"
      ],
      "same_system": "no"
    },
    {
      "text": "The 500°C treatment produces nanocrystalline or grain-refined regions in FeNiCrCoCu coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 500°C treatment causes partial recrystallization in the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::015::3_1_phase_structure_and_morphology_of_co"
      ],
      "same_system": "no"
    },
    {
      "text": "A heterogeneous nanotwinned microstructure produced at 500°C increases coating microhardness.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::015::3_1_phase_structure_and_morphology_of_co",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Greater coating hardness improves resistance to abrasive and fatigue wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::023::3_1_phase_structure_and_morphology_of_co",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The heat-treatment-induced microstructure enhances the oxidation behavior of FeNiCrCoCu.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During wear at 500–700°C, the treated coating forms a stable protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer acts as a protective and lubricating barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined hardness and oxide-layer effects reduce abrasive, adhesive, and oxidation wear relative to the as-deposited FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::023::3_1_phase_structure_and_morphology_of_co",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The 500°C-treated coating will have a wear rate at least approximately 20% lower than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated coating will exhibit improved microhardness relative to the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::015::3_1_phase_structure_and_morphology_of_co",
