  "claims": [
    {
      "text": "The initial material is an Hf-free refractory high-entropy alloy such as NbMoTaWTi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is to add less than 1 at.% Hf during alloy processing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trace Hf addition will cause in situ precipitation of Hf-bearing phases in the refractory alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-bearing precipitates will be nanoscale and located both at grain boundaries and within the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-rich precipitates will pin or impede dislocations at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitation strengthening will increase the alloy's yield strength at approximately 1600 °C under mechanical loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-modified alloy will retain room-temperature strength similar to that of the Hf-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-modified alloy will retain room-temperature ductility similar to that of the Hf-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding less than 1 at.% Hf will leave the alloy's overall density effectively unchanged.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
