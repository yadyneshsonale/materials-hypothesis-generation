    {
      "text": "High density and poor plasticity limit the aerospace application of refractory high-entropy alloys.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744483::web::001::1_introduction"
      ],
      "same_system": "yes"
