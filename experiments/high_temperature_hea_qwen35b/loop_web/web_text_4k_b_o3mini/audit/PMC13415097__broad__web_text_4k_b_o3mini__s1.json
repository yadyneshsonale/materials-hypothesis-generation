      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pd-alloyed samples will have lower magnetic hysteresis losses than baseline NiFeCoCr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pd alloying will preserve or enhance heat-exchange rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
