      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A narrower exchange-energy distribution produces more homogeneous magnetic order.",
