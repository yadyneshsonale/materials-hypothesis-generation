      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The second-order transition can be triggered by low applied magnetic fields.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The NiFeCoCrPdx family exhibits a second-order magnetic phase transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
