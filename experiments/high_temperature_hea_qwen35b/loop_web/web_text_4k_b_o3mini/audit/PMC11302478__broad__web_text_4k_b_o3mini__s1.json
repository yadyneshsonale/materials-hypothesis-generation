  "claims": [
    {
      "text": "In metastable multi-component alloys, particular chemical compositions modify intrinsic energy barriers that govern deformation behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "The chemistry-dependent intrinsic energy barrier is specifically the stacking fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intrinsic energy barriers govern whether deformation proceeds primarily by dislocation slip or deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lower stacking fault energy predisposes these alloys to deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Small affine shear strain can promote or amplify deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twinning induced by low stacking fault energy yields a superior strength–ductility response.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fe80−xMnxCo10Cr10 alloys with 30 ≤ x ≤ 45 are representative metastable FCC multi-component alloys in which twinning has been observed.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Systematically varying Mn content or substituting elements can be used to modify stacking fault energy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6006257::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Decreasing temperature can drive metastable multi-component alloys across different deformation modes.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant FCC lattices are thermodynamically metastable or unstable at ambient and cryogenic conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Chemical composition changes the local bonding environment and thereby changes stacking fault energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6006257::web::004::introduction",
        "PMC6006257::web::030::stacking_fault_energy_and_metastable_twi"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lower stacking fault energy reduces the twin-nucleation barrier relative to the barrier for dislocation slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Activation of twinning enhances strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloys modified to have lower stacking fault energy should develop a higher deformation-twin fraction than a higher-SFE, slip-dominated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-temperature testing should produce sustained or higher yield strength in the modified alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower-temperature testing should improve ductility in the modified alloys relative to the higher-SFE baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A relatively higher stacking fault energy makes dislocation slip the primary deformation mechanism and suppresses twinning.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate distribution and grain size may independently affect deformation behavior and confound the inferred chemistry–SFE relationship.",
