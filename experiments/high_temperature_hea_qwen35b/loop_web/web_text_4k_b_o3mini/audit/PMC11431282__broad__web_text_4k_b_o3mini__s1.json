  "claims": [
    {
      "text": "MnNiSi-based magnetic-refrigeration materials have high magnetic entropy change but limited mechanical robustness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A small, controlled amount of carbon should be introduced during alloy processing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition results in carbide formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11173170::web::014::3_3_effect_of_carbon_addition_on_mechani"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The carbides form at grain and twin boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11173170::web::014::3_3_effect_of_carbon_addition_on_mechani"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The boundary carbides will be finely dispersed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural defects favor carbide nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11173170::web::014::3_3_effect_of_carbon_addition_on_mechani"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An optimized heat treatment can promote controlled growth of fine rather than coarse carbides.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine carbides strengthen the material by pinning grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine carbides impede crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition and carbide precipitation will increase fatigue life and fracture toughness relative to a carbon-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At low carbon concentration and under controlled heat treatment, the magnetically active matrix will remain largely intact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnetic entropy change will remain close to that of the carbon-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect requires carbon concentration and heat-treatment parameters that produce fine carbides.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive carbon or suboptimal heat treatment may produce coarse carbides.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse carbides may compromise magnetic exchange interactions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
