  "claims": [
    {
      "text": "Equiatomic CrMnFeCoNi and CrCoNi can have single-phase FCC structures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The equiatomic quaternary and ternary subsets considered are single-phase FCC after identical thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi has superior mechanical performance to CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi exhibits higher cryogenic strength, ductility, and fracture toughness than its quinary parent and other equiatomic FCC derivatives.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi exhibits enhanced local Co segregation at intrinsic stacking faults relative to CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978039::web::026::4_4_minority_phase"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co enrichment at stacking faults in CrCoNi lowers the local stacking-fault energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978039::web::026::4_4_minority_phase"
      ],
      "same_system": "no"
    },
    {
      "text": "In CrMnFeCoNi, Co atoms near intrinsic stacking faults can decrease the stacking-fault energy by more than 50%.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5978039::web::026::4_4_minority_phase"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lower stacking-fault energy facilitates deformation twinning by promoting partial-dislocation dissociation and planar stacking faults.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced Co segregation causes CrCoNi to form a denser nanotwin network than CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Networks of nanotwins have been observed after extensive deformation in both CrCoNi and CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanotwins provide additional barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanotwins accommodate strain and thereby increase ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed nanotwin network simultaneously increases strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10026765::web::004::introduction",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CrCoNi has a lower effective stacking-fault energy than CrMnFeCoNi under the specified conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi has a higher deformation-induced nanotwin density than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi will have greater strain hardening than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi will have higher strength and ductility than CrMnFeCoNi at both room and cryogenic temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The CrMnFeCoNi baseline lacks the pronounced Co enrichment at stacking faults proposed for CrCoNi.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault-related phenomena dominate deformation in these alloys at room and cryogenic temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor phases or elemental interactions other than Co segregation could contribute to the mechanical-property differences.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978039::web::026::4_4_minority_phase"
      ],
      "same_system": "yes"
    }
