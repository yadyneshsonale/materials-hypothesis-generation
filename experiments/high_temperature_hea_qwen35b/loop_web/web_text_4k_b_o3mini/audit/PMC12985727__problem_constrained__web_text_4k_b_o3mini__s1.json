  "claims": [
    {
      "text": "The initial TiVNbTa alloy is an as-cast, single-phase, dendritic BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has a lower-temperature yield strength of about 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a yield strength of 330 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K and 30% compressive strain, the baseline TiVNbTa alloy has a compressive strength of 423 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying and spark plasma sintering with controlled oxygen addition will produce TiO precipitates in TiVNbTa.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Mechanical alloying and spark plasma sintering will refine the BCC matrix grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting TiO precipitates will be nanometer-scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The TiO precipitates will remain thermally stable around 1273 K.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiO precipitates will obstruct dislocation motion and provide precipitation strengthening at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain refinement will increase grain-boundary area and strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The combined precipitation and grain-refinement effects will reduce high-temperature softening in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the modified TiVNbTa alloy will have higher yield and compressive strengths than the 330 MPa and 423 MPa baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed modification may produce a 30–50% increase in strength retention at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alloy is intended to operate between tungsten and CuCrZr during thermal cycling from ambient temperature to about 1273 K and at plastic strains around 30–40%.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
