      "supporting_ids": [
        "PMC5995863::web::017::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The continuous BCC matrix will be low-density and enriched in light elements such as Al or Ti.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2 precipitates hinder dislocation glide and thereby provide precipitation strengthening.",
