  "claims": [
    {
      "text": "An untreated refractory high-entropy alloy develops unstable, non-adherent oxide scales and high mass gain under the specified extreme-temperature oxidation conditions.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding approximately 0.1–0.5 at.% Y improves the alloy's high-temperature oxygen resistance relative to the untreated alloy.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y segregates to the metal/oxide interface during high-temperature oxidation.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Y lowers the metal/oxide interfacial energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Y enhances oxide-scale adherence.",
      "field": "mechanism; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y promotes self-healing of the protective oxide scale.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y addition produces a denser and more continuous protective oxide scale than forms on the untreated alloy.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A CrTaO4-based scale can contribute to reduced oxidation in a refractory high-entropy alloy.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::web::015::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Y addition can modify or stabilize a CrTaO4-based protective scale.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous protective oxide layer inhibits oxygen ingress and further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9787501::web::003::1_introduction",
        "PMC6513993::web::015::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Y-doped alloy will have a statistically significant reduction in oxidation rate and mass gain relative to the untreated alloy.",
      "field": "predicted_outcome; falsification_experiment.falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-doped alloy will form a more uniform and mechanically intact oxide scale than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit will persist in ambient air at 1100–1200°C for 100 hours.",
