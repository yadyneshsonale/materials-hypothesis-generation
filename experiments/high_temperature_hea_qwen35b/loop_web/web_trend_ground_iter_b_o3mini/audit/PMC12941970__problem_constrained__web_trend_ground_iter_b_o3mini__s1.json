  "claims": [
    {
      "text": "The starting CoCrFeNi alloy is pristine and contains no secondary phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe plastic deformation followed by tailored annealing will produce a gradient nanohierarchical microstructure in CoCrFeNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed surface layer will contain ultrafine grains and embedded nanoprecipitates.",
