        "PMC10241162::web::000::abstract",
        "PMC10241162::web::036::adaptive_friction_interface_protection"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated CoCrFeNi alloy will have a lower and more stable coefficient of friction than pristine CoCrFeNi throughout approximately 25–800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated CoCrFeNi alloy will have a lower wear rate than pristine CoCrFeNi throughout approximately 25–800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC10241162::web::036::adaptive_friction_interface_protection"
      ],
      "same_system": "no"
