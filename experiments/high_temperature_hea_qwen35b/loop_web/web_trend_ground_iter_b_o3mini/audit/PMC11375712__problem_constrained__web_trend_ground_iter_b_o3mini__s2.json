      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pt-induced strain or chemical inhomogeneity will establish effective domain-wall-pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced magnetocrystalline anisotropy and domain-wall pinning will increase coercivity.",
