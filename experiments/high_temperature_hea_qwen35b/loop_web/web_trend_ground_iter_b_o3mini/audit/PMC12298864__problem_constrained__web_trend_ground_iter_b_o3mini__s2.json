  "claims": [
    {
      "text": "Equimolar or nearly equimolar CoCrFeNiTi can exist as a single-phase simple solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase equimolar or nearly equimolar CoCrFeNiTi has favorable plasticity and machinability but relatively low hardness and strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low hardness and strength of the alloy arise from intrinsically low lattice friction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low lattice friction enables facile dislocation glide in the pristine alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Facile dislocation glide enables efficient dynamic recovery through dislocation annihilation or rearrangement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Efficient dynamic recovery results in low work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored heat treatment or minor composition adjustment can generate nanoscale precipitates while retaining a predominantly solid-solution matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::018::5_conclusions",
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC9414008::web::000::abstract",
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitate size and distribution can be controlled by alloy composition and heat-treatment parameters.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11989734::web::018::5_conclusions",
        "PMC6478865::web::028::conclusions_and_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The desired mediator is a uniform dispersion of nanoscale, ideally coherent precipitates.",
      "field": "structural_mediator",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoscale precipitates act as obstacles to dislocation glide.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitate obstacles suppress dynamic recovery.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitates cause dislocations to accumulate and form pile-ups at obstacle sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Introducing fine precipitates will increase yield strength relative to the pristine solid-solution state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::018::5_conclusions",
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Introducing fine precipitates will increase hardness relative to the pristine solid-solution state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11989734::web::018::5_conclusions",
        "PMC6478865::web::028::conclusions_and_summary",
        "PMC9572892::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitate-enhanced alloy will exhibit higher dislocation density and visible dislocation pile-up structures in TEM.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The comparison should use otherwise equivalent pristine and precipitate-enhanced CoCrFeNiTi specimens tested under identical loading conditions.",
      "field": "falsification_experiment.design",
