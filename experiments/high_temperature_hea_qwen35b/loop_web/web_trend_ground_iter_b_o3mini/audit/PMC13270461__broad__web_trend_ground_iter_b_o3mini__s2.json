  "claims": [
    {
      "text": "Increasing Cr concentration in a FeNiCuAl-based multiprincipal-element alloy stabilizes a protective duplex oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective duplex scale consists of a continuous inner Al2O3 layer and an outer MnCr2O4-containing layer.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr shifts the local redox potential at the alloy surface.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Cr directly reduces the diffusion rate of reactive metal cations during oxidation.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective oxidation of Al produces a stable, continuous Al2O3 barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "An outer MnCr2O4-containing layer impedes oxygen ingress and outward cation transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline FeNiCuAl-based alloy with standard Cr content typically forms a thicker, porous, multilayered oxide scale.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature durability is governed substantially by oxide-scale composition, compactness, adhesion, and growth kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A dense, continuous, adherent oxide scale suppresses inward oxygen diffusion and outward metal-cation transport, slowing oxidation and scale failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed Cr effect should hold during sustained oxidation from 800 to 1200 °C when other reactive elements and microstructural factors are unchanged.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the baseline, the Cr-enhanced alloy will have lower oxidation weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the baseline, the Cr-enhanced alloy will develop a thinner, more uniform oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr alone will improve oxide-scale adhesion relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined duplex scale enhances overall material integrity during prolonged high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::003::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Microstructural differences caused by processing can substantially alter protective-scale formation and oxidation behavior.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
