      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn produces magnetic frustration in CrMnFeCoNi and related alloys.",
