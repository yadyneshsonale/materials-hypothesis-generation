  "claims": [
    {
      "text": "The baseline catalyst is an equimolar nanoscale PtPdRhRuIrOs solid solution.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pt content will be systematically decreased while Rh content is increased and the other metal fractions are held constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compensating reduced Pt with Rh maintains the total metal loading.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Pt and increasing Rh will shift the overall d-band center downward.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Composition changes in multimetal catalysts can alter electronic interactions and charge redistribution among constituent metals.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
