  "claims": [
    {
      "text": "Equimolar or nearly equimolar CoCrFeNiTi can be processed into a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase equimolar CoCrFeNiTi has moderate hardness and compressive strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Single-phase equimolar CoCrFeNiTi has good ductility or high plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9975007::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Single-phase equimolar CoCrFeNiTi has favorable machinability.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi solid solution lacks nanoscale chemical ordering or clustering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The absence of nanoscale barriers permits relatively easy dislocation motion in the starting alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Easier dislocation motion accounts for the starting alloy's relatively low hardness and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties",
        "PMC9975007::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Easier dislocation motion accounts for the starting alloy's high ductility and machinability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 5–10 at.% Al to CoCrFeNiTi promotes nanoscale chemical ordering or cluster formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale ordered regions or precipitate clusters act as barriers to dislocation glide.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Impeded dislocation migration increases alloy strength and hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al-modified alloy will have a higher density of nanoscale clusters than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 5–10 at.% Al will increase hardness relative to baseline CoCrFeNiTi at both 25 °C and 600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 5–10 at.% Al will increase compressive strength relative to baseline CoCrFeNiTi at both 25 °C and 600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-induced strengthening may be accompanied by a slight reduction in ductility, particularly at elevated temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trends in other high-entropy-alloy systems support strengthening through nanoscale ordering.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A simple solid-solution CoCrFeMnNi alloy can combine high ductility with relatively low yield and tensile strength.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9975007::web::001::introduction"
      ],
      "same_system": "yes"
