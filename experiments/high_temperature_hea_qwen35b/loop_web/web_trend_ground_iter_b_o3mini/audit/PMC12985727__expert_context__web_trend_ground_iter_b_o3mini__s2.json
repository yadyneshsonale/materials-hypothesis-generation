      ],
      "same_system": "yes"
    },
    {
      "text": "Baseline TiVNbTa has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a compressive strength of approximately 423 MPa at 1273 K and about 30% strain.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add 5–10 atomic percent Mo to TiVNbTa.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo incorporation will increase lattice distortion in the BCC TiVNbTa matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Mo will trigger formation of fine nanometer-scale precipitates in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-induced lattice distortion will provide solid-solution strengthening that impedes dislocation motion at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo-induced nanometer-scale precipitates will pin dislocations at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-containing refractory MPEAs generally retain yield strength comparatively well at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain"
      ],
      "same_system": "no"
    },
    {
      "text": "Solid-solution strengthening contributes to the ultra-high-temperature strength of Hf0.5MoNbTaW and HfMoNbTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 5–10 atomic percent Mo will increase both yield strength and compressive strength of TiVNbTa at 1273 K by approximately 20–30%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12463061::web::013::comparison_of_the_temperature_and_strain",
        "PMC9586648::web::024::conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-modified alloy will retain sufficient ductility at 1273 K for service as an intermediate layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-modified alloy will retain sufficient thermal conductivity for effective heat transfer between W and CuCrZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted enhancement applies at approximately 1273 K and strains of about 30–40%.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
