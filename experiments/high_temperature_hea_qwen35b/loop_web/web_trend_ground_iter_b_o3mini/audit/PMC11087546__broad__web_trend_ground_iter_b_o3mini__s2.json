  "claims": [
    {
      "text": "A hybrid treatment combining cryogenic deformation with two-step annealing will induce phase-selective recrystallization in eutectic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::010::discussion",
        "PMC9365806::web::011::psr_mechanisms",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization will simultaneously increase strength and ductility relative to conventional annealing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial eutectic HEA has a dual-phase microstructure containing a softer FCC or L12-like phase and a harder B2 phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::010::discussion",
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial dual-phase microstructure is lamellar.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation enhances strain partitioning between the soft and hard phases.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::010::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A subsequent two-step annealing cycle can fully recrystallize the soft phase while allowing only recovery in the hard phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hard phase can recover during the treatment without significant coarsening.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 30% deformation per cycle is a suitable moderate deformation level for selective recrystallization.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The beneficial behavior should hold during room-temperature service when phase stability is maintained.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective recrystallization of the soft phase improves ductility while retention of the hard phase's skeletal morphology preserves strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phase-selectively recrystallized architecture enhances strain-hardening capacity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation increases the flow-stress or hardness differential between the B2 hard phase and the FCC/L12 soft phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::010::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The increased phase-strength differential causes more deformation strain to partition into the soft phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::010::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation creates a higher density of recrystallization nucleation sites in the soft phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Full recrystallization of the soft phase rejuvenates ductility, whereas recovery and morphological retention of the hard phase preserve strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment will improve both yield strength and ductility by approximately 10–20% relative to standard casting and single-step annealing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A phase-selectively recrystallized FCC/B2 EHEA can attain approximately 35% uniform elongation and approximately 2 GPa true stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::014::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive deformation or non-optimized annealing may cause over-recrystallization or hard-phase coarsening and negate the strength-ductility synergy.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
