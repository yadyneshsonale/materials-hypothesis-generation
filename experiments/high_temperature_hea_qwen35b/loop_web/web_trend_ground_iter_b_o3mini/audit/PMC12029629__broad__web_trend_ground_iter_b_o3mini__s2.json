  "claims": [
    {
      "text": "Under dynamic loading, intrinsic lattice disorder in HEAs promotes a strain-rate-dependent transition from full dislocation glide to enhanced partial-dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10058552::web::003::1_introduction",
        "PMC8398136::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced partial-dislocation motion increases stacking-fault formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced partial-dislocation motion promotes deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC8398136::web::006::1_introduction",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Stacking faults and twins impede dislocation motion and thereby increase strength and strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10574201::web::000::abstract",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Stacking faults and twins accommodate plastic deformation and thereby enhance ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10574201::web::000::abstract",
        "PMC5321736::web::002::body",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed test material is an as-processed, single-phase FCC HEA.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A single-phase FCC HEA possesses intrinsic chemical and lattice disorder.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10574201::web::000::abstract",
        "PMC8398136::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic-scale chemical and lattice disorder in the HEA locally reduces its effective stacking-fault energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced stacking-fault energy favors partial-dislocation activation over full-dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::006::1_introduction",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Under dynamic loading, the HEA will develop a statistically significant higher stacking-fault and twin density than a similarly processed conventional single-phase alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dynamic loading, the HEA will show a greater shift toward partial-dislocation activity than the conventional-alloy baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The greater stacking-fault and twin activity will give the HEA a higher strain-hardening rate than the conventional-alloy baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10574201::web::000::abstract",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism will give the HEA a superior strength-ductility balance relative to the conventional-alloy baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10574201::web::000::abstract",
        "PMC5321736::web::002::body",
        "PMC9645729::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis should hold from moderate to high strain rates and from room temperature to moderately elevated temperatures where dynamic dislocation processes dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using comparable processing histories for the HEA and baseline alloy provides a controlled comparison of their dynamic deformation responses.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
