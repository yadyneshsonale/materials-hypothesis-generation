  "claims": [
    {
      "text": "The baseline alloy is equiatomic HfMoTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a single-phase BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "As-cast HfMoTaTiZr possesses high strength from room temperature to approximately 1000°C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to replace 25–50% of the Ta content with Nb while retaining Hf, Mo, Ti, and Zr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing part of the Ta with Nb will reduce the density of HfMo(Ta1−xNbx)TiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The density reduction will be on the order of a few percent.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Ta-to-Nb substitution will preserve a single-phase BCC solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb is a lower-density refractory element than Ta.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb has high-melting-point characteristics favorable for elevated-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nb provides solid-solution strengthening comparable to Ta.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preservation of the BCC solid solution and its phase stability will sustain strength at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The substituted alloys will retain yield and compressive strength similar to, or only slightly below, HfMoTaTiZr from room temperature through approximately 1000°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed performance applies under compression at temperatures from 25°C to at least 1000°C and at deformation rates comparable to standard refractory-alloy compression tests.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The favorable behavior is limited to partial Ta substitution in the approximate range of 25–50%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive substitution or complete removal of Ta may compromise strength, ductility, or phase stability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
