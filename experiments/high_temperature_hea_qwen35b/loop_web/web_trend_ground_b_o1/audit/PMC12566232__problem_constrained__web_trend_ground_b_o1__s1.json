      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5314382::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment will increase dynamic yield or flow strength by approximately 10–25% relative to the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will increase uniform deformability by approximately 30–50% relative to the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will postpone the onset of shear-band localization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treatment will distribute impact-induced energy release more broadly and increase energy absorption before failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted benefits apply under predominantly compressive, adiabatic loading at strain rates from approximately 10^3 to 10^4 s^-1.",
