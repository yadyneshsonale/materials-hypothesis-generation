      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::010::results_and_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dispersed precipitates will anchor dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refined grains and precipitates will distribute deformation-generated heat over a larger volume and thereby reduce thermal softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal softening promotes adiabatic shear localization at high strain and strain rate.",
