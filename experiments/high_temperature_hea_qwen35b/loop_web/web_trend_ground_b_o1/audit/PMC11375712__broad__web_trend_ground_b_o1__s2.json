      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 600–700 °C for 2–4 hours induces nanoscale B2 precipitation within an A2 matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator is a dispersion of nanoscale B2 precipitates in an A2 matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2 precipitates impede domain-wall motion and enhance domain-wall pinning.",
