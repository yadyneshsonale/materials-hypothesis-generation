      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8961229::web::029::the_effect_of_constituent_phases_on_magn",
        "PMC9685441::web::031::low_coercivity_analysis"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Impeded domain-wall motion and enhanced pinning increase coercivity.",
