      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9685441::web::031::low_coercivity_analysis"
      ],
      "same_system": "no"
    },
    {
      "text": "The specified aging treatment will increase coercive field relative to the same unaged, solution-annealed alloy.",
