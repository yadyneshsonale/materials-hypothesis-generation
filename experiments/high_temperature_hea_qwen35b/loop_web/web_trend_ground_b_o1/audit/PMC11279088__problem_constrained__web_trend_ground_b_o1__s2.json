      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant exposure is air or corrosive gas above 900 °C for approximately 24–100 hours or longer.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics",
