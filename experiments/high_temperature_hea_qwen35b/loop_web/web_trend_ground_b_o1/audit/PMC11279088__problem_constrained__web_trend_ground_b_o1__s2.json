        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr and X at the interface nucleate a continuous spinel or other protective oxide phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local compositional or phase inhomogeneity disrupts beneficial Cr–X partitioning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Disrupted partitioning favors brittle, multilayered oxides with poor adhesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Poorly adherent multilayered oxides crack or spall.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
