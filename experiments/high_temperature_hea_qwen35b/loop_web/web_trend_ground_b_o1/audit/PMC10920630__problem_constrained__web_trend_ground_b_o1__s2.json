      "support": "partial",
      "supporting_ids": [
        "PMC6427115::web::016::4_2_corrosion_resistance"
      ],
      "same_system": "no"
    },
    {
      "text": "Elevated temperature and chloride content cause local acidification at the Q235 steel surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local acidification destabilizes the oxide film and triggers a rapid transition from passivity to active corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::web::016::4_2_corrosion_resistance"
      ],
      "same_system": "no"
    },
