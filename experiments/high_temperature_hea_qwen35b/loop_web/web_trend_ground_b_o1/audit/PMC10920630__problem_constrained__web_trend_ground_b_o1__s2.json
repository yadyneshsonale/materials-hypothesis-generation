      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::web::016::4_2_corrosion_resistance"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing chloride content and temperature will shift the open-circuit potential of Q235 steel to more negative values.",
      "field": "predicted_outcome",
