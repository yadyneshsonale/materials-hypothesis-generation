  "claims": [
    {
      "text": "Applying a dense, adherent Hf-based diffusion-barrier coating to a refractory high-entropy alloy will form an HfO2 surface scale in air at 1200 °C or above.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
