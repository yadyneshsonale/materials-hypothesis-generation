        "PMC6212920::web::051::4_3_1_tin_rich_areas",
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Coated specimens will have a shallower oxygen diffusion profile than uncoated controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6804173::web::003::1_introduction"
      ],
      "same_system": "no"
