      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 500–600 °C for 1–10 hours followed by rapid quenching will produce partial chemical ordering.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion",
        "PMC11267332::web::029::conclusion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The specified annealing and quenching treatment will form nanometric precipitates or nanoscale phase separation.",
