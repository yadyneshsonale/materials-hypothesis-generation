      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Local strain, chemical inhomogeneity, and domain-boundary pinning are the primary factors governing the magnetocaloric response and hysteresis.",
