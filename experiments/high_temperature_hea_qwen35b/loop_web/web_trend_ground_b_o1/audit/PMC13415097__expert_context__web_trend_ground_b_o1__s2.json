      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Sub-transition annealing promotes short-range chemical ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing defects and promoting short-range order lowers the energy barriers around the phase transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial annealing will reduce hysteresis losses relative to the as-deposited baseline.",
