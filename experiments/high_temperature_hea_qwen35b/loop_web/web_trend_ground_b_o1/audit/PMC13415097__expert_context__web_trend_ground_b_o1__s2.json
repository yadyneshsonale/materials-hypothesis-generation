      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Local strain fields obstruct the first-order transition and thereby cause large hysteresis.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor chemical inhomogeneities obstruct the first-order transition and thereby cause a sharp magnetocaloric peak.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Domain-boundary pinning obstructs the first-order transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing reduces lattice strain and microstructural defects.",
