  "claims": [
    {
      "text": "Near-equimolar CoCrFeNiTi solid-solution alloys have low hardness and strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy contains minimal chemical short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNiTi alloy lacks fine Ti-rich precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimal short-range order reduces lattice friction and resistance to dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9646780::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The absence of fine precipitates leaves fewer obstacles to dislocation glide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::020::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Easy dislocation glide caused by limited barriers lowers hardness and yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::020::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial material is a solution-annealed, single fcc-like CoCrFeNiTi solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material has not received an intentional precipitation or ordering treatment.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-term aging can induce local ordering or fine precipitation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::020::effect_of_microstructure_on_mechanical_p",
        "PMC9646780::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Short-range ordered regions can impede dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9646780::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Fine coherent precipitates can impede dislocation motion and increase strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::020::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Slight aging should increase both hardness and yield strength by approximately 20% relative to the as-annealed state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::020::effect_of_microstructure_on_mechanical_p"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The comparison should hold composition and grain size constant between as-annealed and aged specimens.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
