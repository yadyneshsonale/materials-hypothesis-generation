  "claims": [
    {
      "text": "Pre-oxidizing CoCrFeNi in air at approximately 700 °C for 10–30 minutes is sufficient to form an oxide scale.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::009::results_and_discussion",
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-oxidation treatment produces a thin, adherent, chromium-rich oxide scale.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting chromium-rich oxide tribofilm remains stable during sliding from room temperature to 800 °C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
