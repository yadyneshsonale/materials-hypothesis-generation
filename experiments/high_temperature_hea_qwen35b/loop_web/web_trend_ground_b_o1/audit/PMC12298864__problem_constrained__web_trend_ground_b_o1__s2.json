  "claims": [
    {
      "text": "Near-equimolar CoCrFeNiTi can be prepared in a single-phase, solution-annealed state with minimal second-phase precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The solution-annealed CoCrFeNiTi starting state has little short-range chemical order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The solution-annealed CoCrFeNiTi starting state lacks nanoscale Ti-enriched clusters.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The absence of short-range order and Ti-enriched clusters leaves dislocation glide largely unimpeded.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Easy dislocation glide governs the relatively low hardness and strength of the starting alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate aging can induce short-range chemical ordering in near-equimolar CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate aging can induce incipient nanoscale Ti-rich clustering in near-equimolar CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range chemical order or nanoscale Ti-rich clusters act as dislocation barriers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6504951::web::021::property_targeted_quantitative_design_of"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The added barriers reduce easy dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging will increase hardness by approximately 5–15% relative to the solutionized condition.",
