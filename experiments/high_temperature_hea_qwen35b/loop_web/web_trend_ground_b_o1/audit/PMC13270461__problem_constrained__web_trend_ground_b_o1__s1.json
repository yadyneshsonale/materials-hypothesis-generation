      "support": "partial",
      "supporting_ids": [
        "PMC9969177::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism can culminate in abrupt catastrophic fracture under thermal stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Systematically changing O2 partial pressure controls oxide-scale formation at grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
