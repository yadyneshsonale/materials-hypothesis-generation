      "supporting_ids": [
        "PMC13208696::web::021::3_5_2_interfacial_mechanics_and_spallati"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Brittle grain-boundary reaction layers provide crack-initiation pathways.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cracks initiated at the reaction layers propagate intergranularly.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed grain-boundary reaction mechanism reduces tensile ductility.",
