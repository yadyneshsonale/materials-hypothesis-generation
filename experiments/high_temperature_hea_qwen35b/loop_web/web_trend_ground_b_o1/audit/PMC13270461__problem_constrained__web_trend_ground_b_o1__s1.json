      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher O2 partial pressure will cause greater oxide coverage and earlier intergranular cracking than an inert baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher H2 partial pressure will cause greater hydride-like phase coverage and earlier intergranular cracking than an inert baseline.",
