      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid heating combined with limited atom mobility can facilitate HEA nanoparticle formation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
