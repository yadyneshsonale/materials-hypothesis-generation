        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed process can operate under inert or mildly reducing conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction",
        "PMC10621632::web::015::combined_in_situ_structural_characteriza"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The individual precursor reduction steps can be precisely timed to occur within a narrow interval.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limited free-atom mobility increases the likelihood of random alloy formation as the number of atom types increases.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Simultaneous co-reduction promotes uniform elemental distribution and prevents phase segregation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::015::combined_in_situ_structural_characteriza",
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coordinated reduction makes early nuclei incorporate all constituent elements at once.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Incorporating all elements during early nucleation blocks elemental-segregation pathways and favors uniform, single-phase HEA nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::015::combined_in_situ_structural_characteriza",
        "PMC10228495::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
