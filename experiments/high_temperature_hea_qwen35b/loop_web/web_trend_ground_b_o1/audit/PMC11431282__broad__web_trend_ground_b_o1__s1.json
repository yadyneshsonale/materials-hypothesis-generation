      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing increases structural or magnetic homogeneity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing will not significantly alter the lattice parameters governing the magnetocaloric transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced internal stress concentrations will lead to improved ductility and toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
