      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing will reduce microstrain or lattice strain.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::010::x_ray_diffraction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing will form coherent subgrain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will produce no major compositional changes.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing relaxes residual stresses introduced by solidification and processing.",
