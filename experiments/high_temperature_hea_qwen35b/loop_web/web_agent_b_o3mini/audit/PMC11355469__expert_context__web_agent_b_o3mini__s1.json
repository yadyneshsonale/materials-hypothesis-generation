  "claims": [
    {
      "text": "High-temperature annealing improves the wear resistance of FeNiCrCoCu thin-film coatings.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvement in wear resistance is caused by formation of a denser, more coherent oxide scale.",
