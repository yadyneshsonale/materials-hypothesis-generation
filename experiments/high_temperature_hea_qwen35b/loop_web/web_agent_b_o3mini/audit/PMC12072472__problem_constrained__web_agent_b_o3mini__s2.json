      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The Si-doped Cr coating will maintain adequate corrosion resistance in subcritical water.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::page::001"
      ],
      "same_system": "no"
    },
