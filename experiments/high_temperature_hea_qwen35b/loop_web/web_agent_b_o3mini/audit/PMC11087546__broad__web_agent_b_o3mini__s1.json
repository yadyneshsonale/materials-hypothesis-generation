  "claims": [
    {
      "text": "Phase-selective recrystallization can produce a fully recrystallized soft FCC phase while retaining a skeletal hard B2 phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization will simultaneously increase strength and ductility relative to conventional processing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001",
        "PMC9365806::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial eutectic high-entropy alloy has lamellar or dendritic duplex microstructures in its as-cast or fully recrystallized state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled annealing protocol can selectively recrystallize the FCC phase while preserving the hard-phase skeleton.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001",
        "PMC9365806::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealing at sufficiently low temperatures and short times avoids full recrystallization of the hard phase.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable to duplex alloys having clearly differentiated soft and hard phases.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting soft phase is fully recrystallized, equiaxed, and strain-hardenable.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting hard B2 phase remains a continuous skeletal phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization increases twin boundaries and confines low-angle grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Eliminating weak boundaries reduces early crack nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001",
        "PMC9365806::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The preserved hard-phase skeleton provides a load-bearing framework.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase-selective recrystallization manipulates strain partitioning between the soft and hard phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced and confined cracking allows the strain-hardening capacity of both phases to be fully activated.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001",
        "PMC9365806::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy can approach approximately 2 GPa tensile strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy can achieve approximately 35% uniform elongation.",
