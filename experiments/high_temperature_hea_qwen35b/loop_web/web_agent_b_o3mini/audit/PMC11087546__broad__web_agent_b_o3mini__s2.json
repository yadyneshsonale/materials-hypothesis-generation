      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNi2.1 is a eutectic high-entropy alloy with a lamellar duplex microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Casting or conventional cold rolling produces the stated naturally occurring lamellar duplex initial microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic rolling introduces high defect densities.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
