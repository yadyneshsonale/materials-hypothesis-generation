      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001",
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation refines the grain size.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryogenic deformation raises stored energy, thereby enabling selective recrystallization during annealing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The selectively recrystallized soft regions are FCC regions.",
