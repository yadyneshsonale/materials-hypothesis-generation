      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization eliminates weak boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting microstructure enhances beneficial strain partitioning between the constituent phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001",
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phase-selectively recrystallized microstructure arrests microcrack propagation.",
      "field": "mechanism",
