      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001",
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization should apply to eutectic or duplex alloys having similarly distributed soft and hard phases.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
