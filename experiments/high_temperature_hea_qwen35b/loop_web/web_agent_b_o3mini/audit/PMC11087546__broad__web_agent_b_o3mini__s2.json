      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::page::001",
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Full recrystallization of the soft phase releases strain-hardening capacity and improves ductility.",
