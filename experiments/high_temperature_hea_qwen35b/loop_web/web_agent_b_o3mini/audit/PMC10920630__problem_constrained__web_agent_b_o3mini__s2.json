      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr/Nb-associated passive film is less susceptible to localized chloride-induced breakdown.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::page::001"
      ],
      "same_system": "no"
    },
    {
