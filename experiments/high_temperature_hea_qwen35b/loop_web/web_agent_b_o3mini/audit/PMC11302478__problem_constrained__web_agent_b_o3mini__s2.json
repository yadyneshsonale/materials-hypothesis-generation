      "text": "The mesoscopic chemically modulated domains are regions of local chemical ordering or short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9537164::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interactions involving Cr and Mn promote formation of the mesoscopic domains.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9537164::page::001"
      ],
      "same_system": "yes"
