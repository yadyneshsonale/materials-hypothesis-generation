      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid quenching improves the thermal stability of the resulting amorphous state relative to slower cooling.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc-melted Cr16Mn16Fe16Co16Ni16P20 develops a crystalline or multiphase microstructure under slow or moderate cooling.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Melt spinning can cool Cr16Mn16Fe16Co16Ni16P20 at approximately 10^5–10^6 K/s.",
