      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11355962::page::002"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid solidification during metallic additive manufacturing produces non-equilibrium microstructures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12113129::page::002"
      ],
      "same_system": "no"
    },
    {
      "text": "The as-built AlCrFeNiSi components have degraded mechanical properties.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12113129::page::002"
      ],
      "same_system": "no"
    },
    {
