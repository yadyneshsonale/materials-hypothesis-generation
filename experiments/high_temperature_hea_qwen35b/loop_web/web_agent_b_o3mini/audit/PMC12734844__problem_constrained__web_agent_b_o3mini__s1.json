      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11355962::page::002",
        "PMC12113129::page::002"
      ],
      "same_system": "no"
    },
    {
      "text": "Deep-cryogenically-treated AlCrFeNiSi components will have lower residual stress than untreated additively manufactured controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deep-cryogenically-treated AlCrFeNiSi components will have higher tensile strength than untreated controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11355962::page::002",
        "PMC12113129::page::002"
      ],
      "same_system": "no"
    },
    {
