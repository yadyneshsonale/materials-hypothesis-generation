      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating remains effective under high-wear and high-friction conditions from ambient to moderately elevated temperatures.",
