  "claims": [
    {
      "text": "The ESD electrode contains 25–35% Co-Ni-Cr-B-Si bonding mass together with WC, B4C, and TiB2 particles.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112868::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pulse energy can be optimized for ESD with these multicomponent electrodes.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112868::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "ESD with the specified multicomponent electrodes can form composite coatings on C45 carbon steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112868::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "A bonding-mass content of 25–35% produces coatings with improved adhesion and higher hardness and toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12112868::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized ESD process produces a dense and uniform coating.",
