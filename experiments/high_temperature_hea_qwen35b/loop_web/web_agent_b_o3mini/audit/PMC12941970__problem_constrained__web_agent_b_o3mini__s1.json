  "claims": [
    {
      "text": "The starting undoped CoCrFeNi alloy has a single-phase FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 5 wt% Nb is an optimum addition to CoCrFeNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Nb transforms CoCrFeNi from a single FCC phase into an FCC plus Laves dual-phase microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The large atomic size of Nb causes lattice distortion in CoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Nb-induced Laves phase is hard and brittle, and increasing its fraction raises alloy hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Nb content can reduce plasticity and create a brittleness trade-off.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Finely dispersed hard phases generated by Nb addition resist material removal during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11990320::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Nb-enriched regions form stable oxides at elevated temperatures during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-derived oxides form a protective and lubricious tribolayer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb-derived tribolayer lowers the coefficient of friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5 wt% Nb will give CoCrFeNi a lower coefficient of friction than undoped CoCrFeNi at every temperature from 25 °C to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5 wt% Nb will reduce the wear rate relative to undoped CoCrFeNi throughout the full 25 °C to 800 °C range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11990320::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Undoped CoCrFeNi exhibits increased wear and a higher coefficient of friction at elevated temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement is intended to apply to sliding in ambient air from approximately 25 °C to 800 °C under high contact pressures.",
