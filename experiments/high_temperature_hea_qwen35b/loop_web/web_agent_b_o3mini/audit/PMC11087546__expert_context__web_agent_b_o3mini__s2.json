      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The recrystallized soft phase and intact hard phase release or enhance the alloy's strain-hardening capacity.",
