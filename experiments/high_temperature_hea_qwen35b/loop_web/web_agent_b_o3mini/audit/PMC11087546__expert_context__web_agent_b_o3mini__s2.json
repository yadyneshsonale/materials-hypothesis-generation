      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization eliminates or minimizes weak internal boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization modifies strain partitioning between the soft and hard phases.",
