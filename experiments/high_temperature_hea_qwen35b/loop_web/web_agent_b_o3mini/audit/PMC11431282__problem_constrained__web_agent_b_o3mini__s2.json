  "claims": [
    {
      "text": "(MnNiSi)0.62(FeCoGe)0.38 has a single-phase matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "(MnNiSi)0.62(FeCoGe)0.38 exhibits a strong caloric response under applied magnetic or pressure fields.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has limited load-bearing capacity and tends to crack.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding about 1–2 wt% extra Si and C is an appropriate low loading for reinforcing this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Si and C will react in situ to form SiC in (MnNiSi)0.62(FeCoGe)0.38.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention will produce submicron SiC particles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The submicron SiC particles will be uniformly dispersed in the target alloy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "SiC particles will strengthen the matrix through load transfer or load-bearing effects.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "SiC particles will strengthen the matrix through dislocation strengthening and pinning.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "SiC particles will strengthen the matrix through the Orowan mechanism.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The SiC reinforcement will increase tensile strength and load-bearing capacity relative to the unchanged alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6841954::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The SiC particles will impede crack propagation and increase fracture toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A low SiC fraction will preserve the phase-transition behavior responsible for the caloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reinforced material's caloric performance will remain within 5–10% of that of the unchanged alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
