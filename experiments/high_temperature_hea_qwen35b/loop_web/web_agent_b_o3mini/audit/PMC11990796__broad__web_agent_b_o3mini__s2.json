  "claims": [
    {
      "text": "VNbMoTaW is a predominantly BCC refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reference VNbMoTaW alloy is a fully single-phase BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "VNbMoTaW has high strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "VNbMoTaW has very low room-temperature ductility, including in compression.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10894205::page::001",
        "PMC10894205::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 10–20 at.% Ti, Zr, or Hf to VNbMoTaW is a suitable moderate intervention.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit is conditional on the modified alloy remaining a single-phase BCC solid solution.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing HCP-forming elements into the BCC alloy will lower dislocation core energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Introducing HCP-forming elements will increase lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The HCP-forming additions will locally reduce the shear modulus.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The additions will shift the balance between screw- and edge-dislocation mobilities.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additions will modify dislocation-core structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified dislocation behavior will activate additional slip systems or alter slip-plane preferences.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Changes in dislocation cores and slip behavior will enhance room-temperature plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001",
        "PMC10894205::page::002"
      ],
      "same_system": "no"
    },
    {
      "text": "Solid-solution and lattice-distortion strengthening will preserve high yield strength after the additions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to VNbMoTaW, the modified alloy will have greater plastic strain before failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::001",
        "PMC10894205::page::002"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to VNbMoTaW, the modified alloy will maintain or slightly increase yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive HCP-forming-element additions may produce secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High concentrations of HCP-forming elements may degrade high-temperature creep performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::page::002"
      ],
      "same_system": "no"
    }
