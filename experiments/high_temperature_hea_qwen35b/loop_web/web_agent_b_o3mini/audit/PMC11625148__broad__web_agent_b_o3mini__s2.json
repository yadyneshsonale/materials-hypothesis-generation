  "claims": [
    {
      "text": "The baseline is a nanocrystalline refractory high-entropy alloy with a BCC solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding approximately 0.1 at.% boron induces grain-boundary boride precipitation in a refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The boron-induced precipitates are hexagonal close-packed borides, most likely (Hf, Zr)B2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The boride precipitates form at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Boron segregates to grain boundaries and reacts with refractory elements to form borides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary borides enhance grain-boundary cohesion and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The boride precipitates reduce grain-boundary brittleness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The boride precipitates impede grain-boundary sliding under extreme conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.1 at.% boron improves ductility relative to the boron-free alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 0.1 at.% boron improves work hardenability relative to the boron-free alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvement in ductility and work hardenability will persist during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvement in ductility and work hardenability will persist during dual-beam irradiation and helium implantation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will not compromise thermal stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will not compromise irradiation stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-doped alloy will show no significant grain growth or deterioration of bulk matrix properties after thermal and irradiation exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-free nanocrystalline baseline has good thermal and irradiation stability but may suffer grain-boundary brittleness under extreme stress.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The beneficial effect requires boron content to remain around 0.1 at.% so that only fine, dispersed borides form and the nanocrystalline structure is preserved.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::page::001"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The borides must remain stable during prolonged irradiation and high-temperature exposure for the proposed effect to hold.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative gains in ductility and work-hardening rate and the long-term cyclic-irradiation stability of the borides are unknown.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison of otherwise identically processed boron-free and 0.1 at.% boron alloys after exposure above 1200 °C and dual-beam helium irradiation can falsify the hypothesis through mechanical and microstructural measurements.",
      "field": "falsification_experiment",
      "needs_support": false,
