  "claims": [
    {
      "text": "The proposed intervention is to add approximately 5 at.% Al to near-equiatomic CoFeMnNi and vacuum anneal it at approximately 800 °C for 12–24 hours.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at.% Al and annealing at approximately 800 °C for 12–24 hours will promote partial B2-type ordering in CoFeMnNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting CoFeMnNi(Al) matrix will contain ordered B2-phase domains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Ordered B2 domains will locally increase magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Ordered B2 domains will act as domain-wall pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced magnetic anisotropy and domain-wall pinning can increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-doped, partially B2-ordered sample will have a higher room-temperature coercive field than an identically processed Al-free CoFeMnNi reference.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The comparison should use an Al-free CoFeMnNi-based alloy subjected to the same melting and annealing schedule.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al contents above 5 at.% may diminish the coercivity-enhancing effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficient annealing may produce incomplete ordering and diminish the coercivity-enhancing effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The optimal Al content, annealing parameters, and B2-phase fraction for maximizing coercivity are not precisely known.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coercivity and B2-phase fraction can be compared using room-temperature magnetic hysteresis measurements and X-ray diffraction, supplemented by electron microscopy.",
