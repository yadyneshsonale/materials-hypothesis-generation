  "claims": [
    {
      "text": "A critical minimum Al content in CrFeCoNiAl alloys stabilizes a coherent protective oxide above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9692591::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "A critical minimum Si content in CrFeCoNiSi alloys stabilizes a coherent protective oxide above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al additions can produce a protective Al2O3 scale with greater high-temperature stability than chromia.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Si additions can produce a protective SiO2 barrier in high-temperature alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective Al- or Si-based scale limits outward diffusion of less-stable oxide-forming elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The compact Al- or Si-based scale inhibits inward oxygen diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 scales grow more slowly than chromium oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At the threshold Al or Si content, the protective oxide forms faster than competing spinel or chromia-based scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the Al- or Si-based protective scale reduces oxide-growth stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxide-growth stress suppresses surface cracking and thereby prevents spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNi alloys containing at least 5 at.% Al will form a stable, coherent oxide scale under the specified exposures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::000::abstract",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing Al content from 5 to 15 at.% increases high-temperature oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Alloys at or above the proposed Al threshold will exhibit minimal oxidation mass gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9692591::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Alloys at or above the proposed Al threshold will exhibit negligible spallation during exposures up to 100 h.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-Al or lower-Si alloys will form more porous spinel or mixed-oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9692591::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower-Al or lower-Si alloys will be more likely to crack or spall than the compositionally enriched alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature homogenization will provide uniform alloying-element distributions and comparable grain sizes and phase fractions across the composition series.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
