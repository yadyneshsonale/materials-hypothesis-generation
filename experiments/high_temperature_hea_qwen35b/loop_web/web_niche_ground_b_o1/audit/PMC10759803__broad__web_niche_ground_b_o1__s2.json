  "claims": [
    {
      "text": "The initial NbMoTaW alloy has a predominantly single-phase BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC4510575::web::001::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW is a high-density refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ta and W are high-density constituents whose replacement by lighter elements can reduce RHEA density.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing 2–5 at.% W or Ta in NbMoTaW with Al will reduce the alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The specified Al substitution will lower density by approximately 3–5% relative to NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 2–5 at.% Al to NbMoTaW will promote B2 precipitate formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-containing B2 precipitates will remain stable at elevated temperatures up to approximately 1200 °C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2 precipitates will resist dislocation motion and provide precipitation strengthening at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition will maintain sufficient lattice distortion to preserve room-temperature ductility.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloy will have approximately 10–15% greater yield strength than NbMoTaW at approximately 1200 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-substituted alloy will retain at least 80–90% of the baseline room-temperature strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloy will retain at least 80–90% of the baseline room-temperature ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Above approximately 5 at.% Al, excessive B2 or other brittle intermetallic formation may compromise room-temperature ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 1200 °C represents a jet-turbine operating temperature relevant to the proposed alloy test.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
