  "claims": [
    {
      "text": "The starting material is a W–Cu composite containing W particles or interconnected W ligaments in a Cu matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated W–Cu composite is prepared by powder blending and sintering without additional alloying elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of 1–3 wt% Ni followed by high-temperature co-sintering under vacuum or inert atmosphere.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni addition and co-sintering will suppress phase separation in W–Cu.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni addition and co-sintering will reduce W–Cu interfacial void formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fusion divertor joints involving W-based plasma-facing material and Cu-based cooling components experience high temperature, high heat flux, and irradiation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11901246::web::002::1_introduction",
        "PMC5434025::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Temperatures up to approximately 600–800 °C are typical service conditions for the relevant W–Cu joints.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderate neutron or ion fluxes are representative of the intended service condition.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11901246::web::002::1_introduction",
        "PMC5434025::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ni will segregate to W–Cu grain boundaries or interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Ni will enhance W–Cu bonding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfacial Ni will lower W–Cu interfacial energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower interfacial energy will stabilize the W–Cu interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ni will mitigate vacancy agglomeration during high-temperature and irradiation exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced vacancy agglomeration and interface stabilization will decrease interfacial void formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced interfacial void formation will preserve thermal-transport paths.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ni-doped composite will have higher thermal conductivity after heat and irradiation exposure than an otherwise identically processed undoped W–Cu composite.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thermal-conductivity improvement will be at least several percent.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention's effectiveness depends on Ni concentration and sintering parameters.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
