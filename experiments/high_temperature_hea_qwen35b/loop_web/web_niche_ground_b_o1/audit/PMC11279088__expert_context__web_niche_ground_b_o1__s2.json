  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Above approximately 900 °C, sufficient Al in CrFeCoNiX promotes formation of an Al2O3-based scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al2O3 scales are slower-growing and more stable than chromium-oxide scales at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Al2O3-based scale formed on sufficiently Al-rich CrFeCoNiX is dense, coherent, and adherent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 900 °C, chromia can form volatile CrO3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Formation of an Al2O3-based scale mitigates volatile chromium-oxide formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An Al2O3-based scale lowers oxidation-scale stress buildup.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower scale stress prevents or substantially delays cracking and spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-containing CrFeCoNi alloys form layered Cr-rich inner and Mn-rich outer oxides through outward cation diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "High Mn mobility and Mn depletion can cause pores and accelerate oxide growth in CrFeCoNiMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-dominated oxide scales accumulate tensile stress and consequently crack or spall.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-dominated oxide scales grow rapidly, accumulate tensile stress, and crack or spall.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr diffuses outward faster than oxygen diffuses inward, causing chromia scales to grow predominantly outward.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Selective outward diffusion of Al forms the proposed protective alumina layer in CrFeCoNiAl.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective alumina scale is specifically dense alpha-Al2O3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At least 5–8 at.% Al is sufficient for stable scaling with minimal spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower or zero Al produces thick, multiphase scales susceptible to cracking and scale loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC11169556::web::003::introduction",
        "PMC10384371::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed comparison varies Al from 0 to about 10 at.% while testing a no-Al or trace-Al CrFeCoNi baseline under identical exposure conditions.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed scope covers isothermal exposures at or above 900 °C for tens of hours in air or comparably severe oxidizing or corrosive gases.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies to both single-phase and multiphase CrFeCoNiX solid-solution states containing up to approximately 10–12 at.% Al.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
