  "claims": [
    {
      "text": "Adding 1–5 at.% Gd to CoCrFeNi and vacuum annealing it will increase coercive field by at least 20–30% relative to an identically processed undoped alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is equiatomic CoCrFeNi with no rare-earth addition.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is arc-melted and vacuum-homogenized.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of 1–5 at.% Gd by arc melting followed by the same homogenization cycle used for the baseline.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum homogenization near 1000 °C for 12–24 h is sufficient to ensure uniform elemental distribution.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gd addition induces lattice distortion in the CoCrFeNi-based high-entropy matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gd addition strengthens magnetocrystalline anisotropy in the CoCrFeNi-based matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Gd-induced lattice distortion and stronger magnetocrystalline anisotropy enhance domain-wall pinning.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local magnetic anisotropy and strain fields produced by partial Gd substitution hinder domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hindering domain-wall motion raises the coercive field.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gd doping will cause only a minimal reduction in saturation magnetization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The identically processed rare-earth-free CoCrFeNi baseline has a lower coercive field than the proposed Gd-doped alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gd concentrations above approximately 5 at.% may produce secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gd concentrations above approximately 5 at.% may cause excessive lattice distortion and negate coercivity gains.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of coercivity enhancement depends on heat-treatment duration, final grain size, and the distribution of Gd-rich precipitates.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
