  "claims": [
    {
      "text": "The baseline material is a BCC refractory high-entropy alloy in the W-Ta-Cr-V class.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456733::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Refractory high-entropy alloys can be prepared by arc melting or spark plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456733::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding a minor amount of Y during mechanical alloying and spark plasma sintering will produce a fine dispersion of Y2O3 nanoparticles in the RHEA matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in-situ Y2O3 nanoparticles will remain stable during service at approximately 1200 °C and under irradiation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 dispersoids impede dislocation motion and thereby provide dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 dispersoids trap and promote the annihilation of irradiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect trapping and annihilation by Y2O3 particles will enhance radiation tolerance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-modified alloy will have greater high-temperature strength than an otherwise equivalent undoped RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-modified alloy will have better creep resistance than the undoped RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-modified alloy will accumulate less irradiation-induced damage than the undoped RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "BCC RHEAs are promising for high-temperature and irradiation-exposed nuclear applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456733::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An identically processed Y-free RHEA is an appropriate experimental control.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess Y, different RHEA chemistries, or different processing parameters may not produce the same strengthening and radiation-tolerance effects.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y addition may trade strength or radiation tolerance against ductility.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y addition may trade strength or radiation tolerance against oxidation resistance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
