  "claims": [
    {
      "text": "NiFeCoCr-based high-entropy alloys can be rare-earth-free magnetocaloric materials.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial as-cast or as-synthesized alloys have coarse, non-uniform grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloys have compositional variations.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled annealing can refine the grains of NiFeCoCr-based alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat treatment makes NiFeCoCr-based alloys more homogeneous.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Thermal treatment enhances phase uniformity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat treatment reduces the distribution of exchange energies in the NiFeCoCrPd_x alloy family.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A more uniform grain structure reduces local compositional and magnetic inhomogeneities.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "NiFeCoCrPd_x alloys exhibit a second-order magnetic phase transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain and compositional uniformity maintains a mostly second-order transition at applied fields up to about 2 T.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Maintaining a second-order transition lowers magnetic hysteresis.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed, grain-refined alloys will have a higher isothermal entropy change at fields no greater than 2 T than coarse-grained unannealed alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::020::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Annealed, grain-refined alloys will have lower hysteresis losses during low-field cycling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed, grain-refined alloys will exchange heat faster than their coarse-grained baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing and grain refinement will not deteriorate yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unannealed coarse-grained NiFeCoCr-based alloys have lower magnetocaloric response and higher hysteresis than the proposed annealed state.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship applies primarily to near-single-phase FCC NiFeCoCr-based alloys that can be fully recrystallized and moderately grain-refined without brittle secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregation, multiphase precipitation, chemical short-range order, minor secondary phases, or incomplete recrystallization can suppress or mask the expected magnetocaloric and mechanical benefits.",
      "field": "boundary; uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
