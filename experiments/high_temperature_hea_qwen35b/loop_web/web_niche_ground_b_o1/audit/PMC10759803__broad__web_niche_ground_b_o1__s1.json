      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516739::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 5–10 at.% Al produces B2-ordered precipitates in the Ti-Nb-Ta-V alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::002::1_introduction"
      ],
      "same_system": "no"
