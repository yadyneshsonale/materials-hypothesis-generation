      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "At 1200 °C, the Al-modified alloy has 10–20% greater tensile or compressive yield strength than the Al-free baseline.",
