      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy is an Al-free Ti-Nb-Ta-V alloy produced by vacuum arc melting and homogenization.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy has a predominantly BCC matrix.",
