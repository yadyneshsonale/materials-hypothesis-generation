        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al is introduced by partially replacing heavier refractory elements such as Ta or Nb.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of refractory elements with Al reduces alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
