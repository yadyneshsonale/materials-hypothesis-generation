      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed treatment will produce B2-ordered microdomains dispersed in an fcc matrix, creating a partially two-phase microstructure.",
