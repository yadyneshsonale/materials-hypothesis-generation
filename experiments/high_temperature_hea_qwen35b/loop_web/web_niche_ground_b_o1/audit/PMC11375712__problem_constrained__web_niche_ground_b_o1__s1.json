      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2-ordered regions act as domain-wall pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B2-ordered regions enhance magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Domain-wall pinning and enhanced magnetocrystalline anisotropy from the B2 regions will increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::web::000::abstract",
        "PMC9079992::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Al addition and annealing will raise coercivity above 100 Oe.",
