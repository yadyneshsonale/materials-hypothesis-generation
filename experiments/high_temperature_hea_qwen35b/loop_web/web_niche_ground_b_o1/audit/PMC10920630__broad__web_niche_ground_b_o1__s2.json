      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Steels with higher chromium and balanced nickel will have more positive corrosion potentials than lower-chromium steels.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Steels with higher chromium and balanced nickel will have higher charge-transfer resistance than lower-chromium steels.",
