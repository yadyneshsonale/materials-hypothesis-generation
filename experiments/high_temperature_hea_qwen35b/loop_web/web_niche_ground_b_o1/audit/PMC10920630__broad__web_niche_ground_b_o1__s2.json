      "supporting_ids": [
        "PMC9318428::web::024::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A dense (FeCrNi)3O4 spinel layer acts as a corrosion barrier and substantially improves corrosion resistance.",
