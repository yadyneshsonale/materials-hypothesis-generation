      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::024::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting surface oxide is a dense (FeCrNi)3O4 spinel-like phase.",
