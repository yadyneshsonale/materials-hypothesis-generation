{
  "run_id": "PMC13270461__expert_context__web_niche_ground_b_o1__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The starting alloy is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a primarily single-phase fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The additively manufactured starting state contains minimal precipitation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Degradation at 700–900 °C is governed by whether a stable Al–Cr-enriched protective oxide scale forms.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction",
        "PMC6164265::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al and Cr act synergistically to improve oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction",
        "PMC6164265::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Above a threshold oxygen partial pressure, Al and Cr form a continuous spinel-like oxide film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous Al–Cr-rich oxide scale impedes further corrosion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the protective oxide scale preserves the fcc matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At sufficient oxygen partial pressure, Al and Cr partition to the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent oxide scale prevents further inward diffusion of oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing or subcritical-oxygen conditions cause scale breakdown and localized infiltration of reactive species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized infiltration causes subsurface phase transformations and cracking that accelerate degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strongly oxidizing conditions produce protective oxides, low oxidation kinetics, and near-baseline post-exposure mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction",
        "PMC6164265::web::006::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing or very-low-oxygen conditions produce greater mass gain, subsurface reactions, and mechanical-property loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant oxygen-activity range is approximately 1 to 10^-6 bar at 700–900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At substantially higher temperatures or under extreme environmental changes, liquation or nitridation may dominate degradation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature structural materials require a balance between mechanical properties and oxidation resistance.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Failure to form the predicted Al–Cr-rich scale, or occurrence of subsurface degradation under conditions predicted to be protective, would falsify the hypothesis.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
