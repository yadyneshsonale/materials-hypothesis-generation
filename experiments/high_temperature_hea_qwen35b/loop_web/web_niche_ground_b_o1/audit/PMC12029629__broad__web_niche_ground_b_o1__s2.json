  "claims": [
    {
      "text": "The intended test materials are solutionized, single-phase FCC high-entropy alloys.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
