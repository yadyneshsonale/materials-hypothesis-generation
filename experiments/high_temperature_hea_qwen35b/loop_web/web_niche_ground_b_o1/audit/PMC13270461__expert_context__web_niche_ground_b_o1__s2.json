  "claims": [
    {
      "text": "The starting material is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-solidified starting alloy has an fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy retains formability and has high strength and fatigue performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Degradation is governed by formation and local destabilization of a protective Al- and Cr-rich oxide scale whose integrity depends on reactive-gas partial pressure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderately oxidizing conditions produce a continuous protective Al- and Cr-rich scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The continuous oxide scale protects the fcc matrix and preserves near-baseline mechanical strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High oxygen partial pressure disrupts or spalls the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strongly reducing atmospheres disrupt or spall the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aggressive atmospheres cause local depletion of Al and Cr near boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al and Cr partition into oxide layers at free surfaces and grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "B2- or Laves-type secondary phases may consume Al and Cr and reduce oxide-scale continuity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of scale continuity accelerates oxygen ingress and internal oxidation near grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen ingress, internal oxidation, and secondary-phase evolution reduce mechanical integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure at 600–900 °C for up to 100 hours is representative of high-temperature service conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below approximately 600 °C or during short exposures, oxidation and scale disruption are limited.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 900 °C, the protective scale is more likely to spall or degrade.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-produced specimens exposed to inert or mild gas atmospheres maintain a largely intact oxide scale.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-produced specimens exposed to inert or mild gas atmospheres exhibit stable strength and fatigue behavior.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "It is uncertain whether sluggish Al and Cr diffusion in the fcc matrix can maintain a uniform oxide layer.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The partial-pressure threshold for initiation of scale disruption is not established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
