{
  "run_id": "PMC11279088__expert_context__web_niche_ground_b_o1__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Adding at least about 5 at.% Al to CrFeCoNi preferentially produces a coherent alpha-Al2O3-rich scale above about 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions",
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alumina scales grow more slowly than chromia scales and can provide high-temperature oxidation and corrosion resistance.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed alpha-Al2O3-rich scale remains adherent and resists cracking and spallation.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CrFeCoNi alloys lacking sufficient Al, or using Mn or Si instead, form less stable oxides prone to cracking or spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::004::1_introduction",
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC8346963::web::010::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A Mn-containing Cr-Mn-Fe-Co alloy forms Mn-Fe oxides and chromia and undergoes oxide cracking and spallation at 900 °C.",
      "field": "baseline; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8346963::web::010::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "CrMnFeCoNi can form mixed Mn-Fe and Mn-Cr oxide phases during high-temperature oxidation.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al has a stronger thermodynamic affinity for oxygen than Si, Mn, Cr, Fe, Co, or Ni.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al selectively oxidizes in Al-containing CrFeCoNi to produce alumina.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Strong alumina-scale adhesion minimizes scale cracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn- or Si-containing alternative oxides spall because of higher volatility or oxide/alloy mismatch stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromia can form volatile CrO3 above 900 °C.",
      "field": "mechanism; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CrFeCoNi alloys containing at least 5 at.% Al will have significantly lower oxidation mass gain than otherwise identical Mn- or Si-containing variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC8346963::web::010::4_conclusions",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNi alloys containing at least 5 at.% Al will show minimal cracking or spallation compared with Mn- or Si-containing variants.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC8346963::web::010::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A CrFeCoNi or CrFeCoNi-(Mn,Si) baseline containing less than 1 at.% Al will grow oxide faster and be more likely to crack or spall above 900 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air",
        "PMC8346963::web::010::4_conclusions",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective behavior is expected to persist up to about 1100 °C, under high oxygen partial pressure or mild corrosive species, for tens of hours or longer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher temperatures or extreme corrosive environments may alter oxide-scale formation kinetics or composition.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::004::1_introduction",
        "PMC11169556::web::003::introduction",
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Si-enriched silica films may form under some conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact protective Al threshold and interactions with minor alloying elements are not yet sufficiently quantified.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::004::1_introduction",
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    }
  ],
