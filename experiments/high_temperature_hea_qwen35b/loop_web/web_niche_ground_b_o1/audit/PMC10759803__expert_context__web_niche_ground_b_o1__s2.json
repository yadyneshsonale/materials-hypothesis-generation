  "claims": [
    {
      "text": "The as-cast HfMoTaTiZr baseline is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a yield strength of approximately 1600 MPa at 25 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a yield strength of approximately 855 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with Al will reduce the density of HfMoTaTiZr by at least 5%.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing Hf with Al will keep the 25 °C yield strength within 5% of the approximately 1600 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing Hf with Al will keep the 1000 °C yield strength within 5% of the approximately 855 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution of lighter Al for heavier Hf decreases the alloy's average atomic mass and thereby lowers density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al substitution induces localized lattice strain in HfMoTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-induced lattice strain produces solid-solution strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution strengthening from Al can preserve or slightly enhance the alloy's strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-to-Al substitution at the proposed levels will retain a predominantly BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al contents above 10 at% may produce detrimental secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al content may significantly reduce ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Microstructural variation or secondary-phase formation could diminish high-temperature performance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural variation or secondary-phase formation could diminish fracture toughness.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In Ti-Al-V-Nb-Mo RHEAs, increasing Al content reduced density and increased room-temperature specific yield strength.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516739::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloys are to be compared with unmodified HfMoTaTiZr at 25 °C and 1000 °C at a nominal strain rate of approximately 10^-3 s^-1.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to achieve a 5% density reduction, or a strength loss greater than 5% at either test temperature, rejects the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
