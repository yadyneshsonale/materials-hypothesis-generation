      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher configurational entropy reduces the Gibbs free energy of the amorphous phase and favors it over crystalline phases.",
