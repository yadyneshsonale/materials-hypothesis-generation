  "claims": [
    {
      "text": "Boron and silicon are metalloid elements.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add boron or silicon to a phosphorus-containing high-entropy or compositionally complex alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding boron or silicon to a phosphorus-containing high-entropy or compositionally complex alloy will improve its glass-forming ability.",
