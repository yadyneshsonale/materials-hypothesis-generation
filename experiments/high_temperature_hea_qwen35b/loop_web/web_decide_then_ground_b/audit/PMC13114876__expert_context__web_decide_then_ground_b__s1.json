      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11378927::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy will exhibit a coupled wear-corrosion response rather than independent wear and corrosion behavior.",
