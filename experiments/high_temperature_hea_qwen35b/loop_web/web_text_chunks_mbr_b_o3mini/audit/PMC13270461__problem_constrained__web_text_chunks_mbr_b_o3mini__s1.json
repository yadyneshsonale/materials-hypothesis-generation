  "claims": [
    {
      "text": "The additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy initially has an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The as-manufactured alloy is a supersaturated solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Selective laser melting typically produces this alloy with fine grains and minimal pre-existing precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The gas environment triggers segregation of Cr, Al, and Ti to grain boundaries during elevated-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reactive-element segregation promotes nucleation and coarsening of intergranular oxide or sigma-like precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Intergranular phase evolution weakens grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary weakening from intergranular phase evolution eventually causes catastrophic failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At temperatures of approximately 950 K and above, prolonged exposure permits diffusion-driven phase evolution.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing conditions accelerate diffusion of Cr, Al, and Ti toward grain boundaries, where selective oxidation occurs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intergranular precipitates alter local grain-boundary chemistry.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intergranular precipitates concentrate mechanical stresses and reduce grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reducing atmosphere suppresses oxidation-driven segregation and delays precipitate coarsening and failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the as-manufactured state, oxidizing exposure produces a higher density and larger size of brittle intergranular precipitates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure lowers microhardness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure reduces fracture toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure produces fewer intergranular precipitates and slower mechanical-property degradation than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-manufactured baseline has a uniform FCC microstructure with a fine dispersion of any initial precipitates.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
