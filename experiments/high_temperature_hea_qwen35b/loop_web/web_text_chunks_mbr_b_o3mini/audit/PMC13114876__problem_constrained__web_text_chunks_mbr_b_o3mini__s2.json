  "claims": [
    {
      "text": "The proposed eutectic HEA has an FCC matrix containing dispersed sigma phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC matrix is softer than the sigma phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An electrochemical potential difference between the FCC and sigma phases establishes micro-galvanic cells.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The micro-galvanic cells create localized anodic sites at FCC/sigma interphase boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Galvanic coupling accelerates localized corrosion specifically at FCC/sigma phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Localized corrosion disrupts the protective oxide film and weakens the FCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During friction and wear, an oxide film forms and its rupture contributes to adhesive and abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Corrosion-induced oxide breakdown allows mechanical wear to remove material more readily.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical removal of the oxide exposes fresh substrate and thereby accelerates corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reciprocal interaction between wear-induced film disruption and galvanic corrosion increases the overall degradation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coupled mechanism operates at approximately 400–600 degrees Celsius in an aggressive chloride or acidic environment.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the stated baseline, simultaneous wear and corrosion will produce greater total mass loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the stated baseline, simultaneous wear and corrosion will produce a higher wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the stated baseline, simultaneous wear and corrosion will produce a higher corrosion current density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-induced weakening of the matrix exacerbates wear damage.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
