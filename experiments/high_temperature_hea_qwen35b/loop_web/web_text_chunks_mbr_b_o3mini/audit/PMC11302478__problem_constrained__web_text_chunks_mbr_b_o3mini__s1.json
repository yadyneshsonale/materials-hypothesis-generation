      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lack of Mn reduces the energetic separation or barrier between the FCC and HCP states in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation slip and interactions trigger or promote the FCC-to-HCP transformation in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twin formation mitigates stress concentrations and enables simultaneous strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
