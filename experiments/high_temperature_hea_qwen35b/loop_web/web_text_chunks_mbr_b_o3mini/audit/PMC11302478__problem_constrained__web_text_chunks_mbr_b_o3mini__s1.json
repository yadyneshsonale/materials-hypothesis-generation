      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The superior mechanical performance of CrCoNi is caused by its greater propensity for a dislocation-induced FCC-to-HCP transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing Mn from the quinary alloy removes Mn-associated magnetic frustration.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Removing Mn lowers the stacking-fault-energy barrier in CrCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation of CrCoNi produces nanoscale HCP regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Deformation of CrCoNi produces twin networks associated with the HCP regions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transformation-related nanostructure accommodates strain and increases hardening, thereby improving strength without sacrificing ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
