      ],
      "same_system": "unclear"
    },
    {
      "text": "Isolated Pt/Pd sites in a multimetal matrix enhance catalytic performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adjacent, less-noble transition metals transfer charge to Pt and Pd.",
