        "PMC9260516::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to monometallic Pt, the Pt-Cu catalyst will show enhanced selectivity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
