        "PMC6570760::web::015::design_and_application_of_a_multifunctio",
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderating adsorption through Pt-Cu alloying improves catalytic selectivity relative to monometallic Pt.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Weaker adsorption mitigates surface poisoning caused by overly strong intermediate binding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pt-Cu alloying suppresses carbon deposition and thereby improves durability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to monometallic Pt, the Pt-Cu catalyst will exhibit higher turnover frequency and lower overpotential.",
