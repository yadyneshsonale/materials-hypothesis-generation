      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Alloying Pt with Cu can form isolated Pt sites or Pt-Cu bimetallic active-site configurations.",
