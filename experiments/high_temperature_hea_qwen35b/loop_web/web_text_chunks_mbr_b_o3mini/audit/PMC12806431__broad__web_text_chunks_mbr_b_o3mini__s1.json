  "claims": [
    {
      "text": "In FCC high-entropy alloys, retention of toughness is governed by the degree of heterogeneous lattice strain.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9231497::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heterogeneous lattice strain causes multiple dislocation kinks and jogs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9231497::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heterogeneous lattice strain causes bidirectional cross slips.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9231497::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The unusual dislocation mechanisms promoted by heterogeneous lattice strain enhance energy dissipation during deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing atomic-size mismatch through compositional adjustment reduces lattice-strain heterogeneity.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing lattice-strain heterogeneity shifts dislocation activity toward conventional slip modes.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9231497::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reducing lattice-strain heterogeneity lowers toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A single-phase equiatomic FCC CrCoNi-type or Cantor alloy exhibits significant lattice-strain heterogeneity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local stress fields introduced by heterogeneous lattice strain facilitate non-conventional dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9231497::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Multiple kinks, jogs, and cross slips allow the alloy to absorb and dissipate deformation energy and thereby retain toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diminishing the unusual dislocation processes leads to earlier strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloys with reduced lattice-strain heterogeneity will have lower fracture toughness K_IC than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
