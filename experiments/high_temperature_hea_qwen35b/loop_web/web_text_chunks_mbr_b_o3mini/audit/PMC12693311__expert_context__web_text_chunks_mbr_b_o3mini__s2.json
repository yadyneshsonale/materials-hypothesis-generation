  "claims": [
    {
      "text": "Standard Cr16Mn16Fe16Co16Ni16P20 has limited amorphous retention.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Amorphous regions in standard Cr16Mn16Fe16Co16Ni16P20 are thermally unstable.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A suitable intervention is adding approximately 1–2 at% carbon to the melt.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will improve amorphous retention in Cr16Mn16Fe16Co16Ni16P20 during rapid quenching.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for",
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon addition will improve the thermal stability of amorphous Cr16Mn16Fe16Co16Ni16P20 during reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should be effective at cooling rates around 3000 K/s and above.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::020::4_discussion",
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention should remain effective during moderate reheating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy exhibits multiple pronounced crystallization events during reheating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added carbon will be homogeneously distributed within the amorphous matrix or at local cluster boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon atoms act as barriers to atomic diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon disrupts the atomic rearrangements required for crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Impeding diffusion and crystallization stabilizes the amorphous phase during rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "The carbon-doped alloy should exhibit a single, narrower exothermic crystallization peak than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-doped alloy should have a higher crystallization-onset temperature than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-doped alloy should retain more amorphous structure across rapid-cooling conditions than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Extremely slow cooling may overcome the beneficial effect of carbon and permit crystallization.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056590::web::007::1_introduction",
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Overly aggressive reheating may overcome the beneficial effect of carbon and permit crystallization.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal carbon concentration and its interactions with phosphorus and the transition metals are not yet established.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
