{
  "run_id": "PMC11279088__expert_context__web_text_chunks_mbr_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The nature of the protective oxide on CrFeCoNiX alloys is governed by the dominant oxide-forming element.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "In CrFeCoNiAl, aluminum diffuses outward faster than oxygen diffuses inward.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiAl forms an alumina-containing passivating oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alumina scale on CrFeCoNiAl grows more slowly than competing oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alumina layer on CrFeCoNiAl is coherent and adherent and therefore resists spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi and CrFeCoNiMn form mixed, non-coherent oxide scales.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon and manganese provide less effective diffusion and phase compatibility than aluminum in these alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal-expansion mismatch and internal stress in the mixed Si- or Mn-containing scales cause cracking or spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 900 °C, CrFeCoNiAl will develop a continuous, stable, predominantly alumina-rich scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiAl will oxidize more slowly than CrFeCoNiSi and CrFeCoNiMn under identical exposure conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi and CrFeCoNiMn will exhibit unstable scales that crack or spall under high-temperature exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi and CrFeCoNiMn provide appropriate less-stable mixed-oxide baselines for CrFeCoNiAl.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies to both single-phase and multiphase CrFeCoNiX metallic solid solutions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10780756::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior applies above 900 °C during extended exposure to oxidative or corrosive environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Diffusion kinetics, oxide growth rates, and stress accommodation may vary with multiphase microstructure.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Failure of CrFeCoNiAl to produce a more coherent, alumina-rich, adherent, and slower-growing scale than both comparison alloys would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
