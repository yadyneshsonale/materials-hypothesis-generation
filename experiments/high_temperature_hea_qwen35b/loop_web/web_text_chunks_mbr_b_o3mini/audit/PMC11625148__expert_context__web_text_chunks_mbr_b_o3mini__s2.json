  "claims": [
    {
      "text": "Equiatomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbMoTaW has excellent high-temperature strength, including at approximately 1600 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbMoTaW has very low room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The irradiation resistance of equiatomic NbMoTaW has not been experimentally verified.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5–10 at.% V should be introduced into NbMoTaW to create a quinary refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW containing 5–10 at.% V will retain a predominantly BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The V-modified alloy may develop nanoscale coherent compositional fluctuations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale coherent compositional fluctuations can enhance dislocation mobility and irradiation-defect recombination.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding V to NbMoTaW will reduce bond stiffness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V-induced localized atomic rearrangements will facilitate dislocation glide and room-temperature ductile deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced diffusion at elevated temperature will promote self-healing of irradiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced diffusion will suppress large-scale irradiation-defect clustering without causing undesirable phase transformations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to untreated NbMoTaW, V-modified NbMoTaW will have greater room-temperature elongation and reduced brittleness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to untreated NbMoTaW, V-modified NbMoTaW will accumulate fewer irradiation-induced defects.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "V-modified NbMoTaW will retain high-temperature yield strength similar to untreated NbMoTaW up to approximately 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The ductility improvement is expected to persist from room temperature to approximately 800 °C.",
