      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The irradiation benefit is limited to conditions below thresholds for severe precipitation or amorphization.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
