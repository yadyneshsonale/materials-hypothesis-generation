  "claims": [
    {
      "text": "Sufficient concentrations of Cr and Al in multiprincipal-element alloys promote formation of a continuous, adherent Cr2O3- or Al2O3-based scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cr2O3 and Al2O3 can act as protective oxide barriers in high-temperature alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A protective oxide scale limits outward diffusion of alloying elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A protective oxide scale limits inward diffusion of oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective scale formation reduces the formation or persistence of non-protective and volatile oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An oxide barrier formed by active elements improves high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Improved protective-scale formation preserves the alloy's mechanical integrity during oxidation exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to form Cr2O3 permits further outward diffusion of Mn and formation of Mn3O4 at 950°C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "V-rich oxide formation and V2O5 evaporation can degrade scale adherence and contribute to breakaway oxidation at temperatures of at least 700°C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloys enriched in Cr and Al will oxidize more slowly than otherwise similar alloys with lower Cr and Al contents.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The lower oxidation rate of the enriched alloy will be observable as lower weight gain or a thinner oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr/Al-enriched alloys will retain mechanical properties better than the lower-Cr/Al baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced Cr and Al levels produce a fragmented or non-protective oxide scale.",
