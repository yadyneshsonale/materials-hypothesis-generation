      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed governing behavior should hold in air from 700°C to 950°C when Cr/Al content is the primary compositional variable.",
