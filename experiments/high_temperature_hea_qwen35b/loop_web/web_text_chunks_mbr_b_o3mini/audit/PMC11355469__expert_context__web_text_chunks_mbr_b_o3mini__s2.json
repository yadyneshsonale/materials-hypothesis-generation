  "claims": [
    {
      "text": "Vacuum heat treatment at approximately 500 °C improves the high-temperature wear resistance of FeNiCrCoCu thin-film coatings relative to an untreated as-sprayed coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The 500 °C heat treatment produces a refined microstructure containing nanotwins.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 500 °C heat treatment promotes in situ formation of an adherent protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide scale reduces abrasive wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::web::014::4_summary",
        "PMC9820961::web::023::3_1_phase_structure_and_morphology_of_co"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide scale reduces adhesive wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::web::014::4_summary",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant structural mediator is a heterogeneous microstructure of recrystallized grains with nanotwins.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The surface oxide is thin and stable and likely contains Cu together with oxides of Fe, Co, or Ni.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 500 °C vacuum heat treatment increases coating microhardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanotwins and high-density dislocations are responsible for the heat-treatment-induced increase in microhardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer acts as both a lubricant and a barrier to further wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::web::014::4_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Heat-treatment temperatures above 500 °C cause excessive recrystallization and a reduction in hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::023::3_1_phase_structure_and_morphology_of_co",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heat-treatment temperatures above 500 °C degrade protective oxide properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 500 °C heat-treated coating will have a lower wear rate than the untreated coating during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The 500 °C heat-treated coating will have a lower coefficient of friction than the untreated coating during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coatings treated above 500 °C will have inferior wear performance because of hardness loss and diminished oxide adhesion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::023::3_1_phase_structure_and_morphology_of_co",
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
