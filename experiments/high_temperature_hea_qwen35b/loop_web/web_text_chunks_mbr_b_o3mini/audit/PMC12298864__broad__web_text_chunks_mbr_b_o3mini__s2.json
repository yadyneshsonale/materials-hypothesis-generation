  "claims": [
    {
      "text": "Refractory BCC high-entropy alloys can exhibit a high-temperature strength plateau.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "yes"
    },
    {
      "text": "Refractory BCC high-entropy alloys exhibit a high-temperature hardness plateau.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength and hardness plateau is governed by a predominance of edge dislocations.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results",
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermally activated super-jogging makes edge dislocations strong, temperature-insensitive barriers to further dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbTaHfTiZrV0.5 is an example of the proposed BCC refractory high-entropy alloy initial state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HEA has a mixed dislocation population in which edge dislocations are unusually prevalent relative to conventional BCC alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Inert or ultra-high-vacuum test conditions avoid oxidation effects during high-temperature testing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TEM or diffraction methods can distinguish and quantify edge and screw dislocation populations as a function of temperature.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A high edge-dislocation density and thermal super-jogging pin dislocation motion and maintain nearly constant elevated-temperature yield strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results",
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing temperature activates edge dislocations but also causes them to develop mobility-limiting super-jogs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "yes"
    },
    {
      "text": "In conventional screw-dislocation-dominated BCC materials, increasing temperature lowers barriers to dislocation motion and decreases yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed HEA will exhibit a yield-strength plateau between approximately 673 K and 1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed HEA will exhibit an ultimate-strength plateau between approximately 673 K and 1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "A conventional BCC control alloy will show a continuous decrease in strength with increasing temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "yes"
    },
    {
      "text": "A high edge-dislocation fraction in the HEA will correlate with the high-temperature strength plateau.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results",
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Conventional elemental and dilute BCC alloys are generally dominated by screw-dislocation-mediated plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::web::012::3_results",
        "PMC8446014::web::009::determination_of_type_of_mobile_dislocat"
      ],
      "same_system": "yes"
    },
    {
      "text": "Significant lattice distortion promotes edge-dislocation activity in refractory or high-entropy alloys.",
      "field": "boundary",
