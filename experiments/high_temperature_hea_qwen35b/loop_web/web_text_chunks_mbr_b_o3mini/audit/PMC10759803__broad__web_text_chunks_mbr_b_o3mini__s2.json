      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The beneficial response exists only within a narrow carbon-concentration window.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess carbon can cause excessive carbide formation.",
