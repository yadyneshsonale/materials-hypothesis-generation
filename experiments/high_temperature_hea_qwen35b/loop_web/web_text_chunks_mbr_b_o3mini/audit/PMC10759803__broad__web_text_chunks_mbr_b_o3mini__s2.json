      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strengthening effect should operate above approximately 800 °C, including the 800–1000 °C test range.",
