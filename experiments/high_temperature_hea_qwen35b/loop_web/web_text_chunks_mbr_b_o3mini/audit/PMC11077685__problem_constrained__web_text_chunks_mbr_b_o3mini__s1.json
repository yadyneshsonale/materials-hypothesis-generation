      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing oxygen diffusion prevents formation of deleterious oxides within the alloy bulk.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preventing internal oxidation maintains the alloy's intrinsic solid-solution structure.",
