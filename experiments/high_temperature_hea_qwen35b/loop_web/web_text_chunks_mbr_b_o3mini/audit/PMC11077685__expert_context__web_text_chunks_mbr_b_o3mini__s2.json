  "claims": [
    {
      "text": "The starting material is cast equiatomic HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast equiatomic HfNbTaTiZr is a single-BCC-phase alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr has inadequate oxygen resistance at 800 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to introduce 2–5 at% Sn while retaining equal atomic fractions of Hf, Nb, Ta, Ti, and Zr.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 2–5 at% Sn will improve the oxygen resistance of equiatomic HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Sn addition will produce a thin Sn-enriched oxide scale on the alloy surface and along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sn will selectively segregate during oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-associated oxide scale will be stable and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stable, adherent scale will reduce oxygen ingress by limiting oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing oxygen ingress will mitigate oxidation-related loss of ductility or embrittlement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::017::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing oxygen ingress will mitigate pesting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sn addition will leave the alloy's bulk microstructure largely unchanged.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 5 hours in air at 800 °C, the Sn-modified alloy will show less scale spallation, pesting, or oxidation depth than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6981790::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Sn-modified alloy will retain room-temperature tensile ductility in the 8–16% range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-modified alloy will retain a yield strength of 163–530 MPa at 1000 °C at strain rates of 10⁻⁴–10⁻² s⁻¹.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed applicability boundary is a 5-hour exposure to air at 800 °C, with mechanical evaluation at room temperature and 1000 °C over strain rates of 10⁻⁴–10⁻² s⁻¹.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to achieve a statistically significant oxidation-resistance improvement, or notable degradation of ductility or yield strength relative to the untreated control, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
