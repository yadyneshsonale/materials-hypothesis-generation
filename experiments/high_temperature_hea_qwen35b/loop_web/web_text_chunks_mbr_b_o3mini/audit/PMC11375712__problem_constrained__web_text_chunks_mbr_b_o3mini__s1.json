        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Sn addition will induce nanoscale precipitates in an initially single-phase fcc FeCoNi-based alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Sn destabilizes the pure fcc phase and causes nucleation of nanoscale BCC regions or precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The Sn-induced BCC regions or precipitates act as magnetic-domain-wall pinning centers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of a structurally distinct second phase increases local magnetic anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interfaces associated with the second phase impede magnetic-domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Domain-wall pinning caused by the Sn-induced microstructure increases coercivity relative to a homogeneous fcc matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-modified alloy will have a coercive field significantly above approximately 100 Oe.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sn-modified alloy will retain high saturation magnetization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::web::000::abstract",
        "PMC7512446::web::012::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The Sn-induced secondary phase or nanoprecipitates will be detectable by X-ray diffraction and electron microscopy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting followed by annealing can provide the nominally single-phase fcc baseline and, after parameter adjustment, favor a nanoscale second phase in the Sn-added samples.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
