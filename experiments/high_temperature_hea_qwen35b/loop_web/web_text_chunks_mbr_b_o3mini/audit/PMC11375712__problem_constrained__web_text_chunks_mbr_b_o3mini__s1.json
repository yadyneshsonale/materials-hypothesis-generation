    {
      "text": "Single-phase fcc FeCoNi and its reported derivatives have coercivity no greater than approximately 100 Oe.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding a few atomic percent Sn to an initially single-phase fcc FeCoNi-based alloy will promote formation of a BCC second phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
