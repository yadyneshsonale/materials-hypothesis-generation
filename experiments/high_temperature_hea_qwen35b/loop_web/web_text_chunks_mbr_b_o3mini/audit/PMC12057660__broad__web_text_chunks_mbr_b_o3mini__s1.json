      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9260516::web::000::abstract",
        "PMC9260516::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Charge transfer from adjacent Co, Cu, and Ni is responsible for achieving or stabilizing the atomic dispersion of Pt and Pd.",
