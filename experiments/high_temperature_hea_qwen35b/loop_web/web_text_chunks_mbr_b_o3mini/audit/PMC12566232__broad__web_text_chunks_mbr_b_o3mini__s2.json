  "claims": [
    {
      "text": "Refractory high-entropy alloys can possess high strength while suffering from limited ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744483::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated refractory HEA exhibits non-uniform plastic deformation and early strain localization under dynamic loading.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled high-strain-rate deformation followed by tailored annealing will nucleate a dense, uniformly distributed mechanical-twin network in a refractory HEA.",
      "field": "intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twins act as barriers to dislocation motion.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "A dense twin network increases strain hardening.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::001::body",
        "PMC6006257::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "A uniformly distributed twin network suppresses localized shear banding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-assisted plasticity can provide substantial uniform ductility while retaining high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::001::body",
        "PMC6006257::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed twin-assisted mechanism will operate in refractory high-entropy alloys under dynamic loading.",
      "field": "hypothesis; mechanism; conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-enhanced processing will significantly increase uniform elongation and improve deformability relative to untreated refractory HEA samples at high strain rates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::001::body",
        "PMC6006257::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin-enhanced processing will maintain a yield strength comparable to that of the untreated refractory HEA.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::001::body",
        "PMC6006257::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Twin-enhanced processing will preserve impact-induced energy release.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit should hold from room temperature to moderately elevated service temperatures under high-strain-rate loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit is limited to alloy compositions and processing regimes in which twinning is thermodynamically and kinetically feasible.",
