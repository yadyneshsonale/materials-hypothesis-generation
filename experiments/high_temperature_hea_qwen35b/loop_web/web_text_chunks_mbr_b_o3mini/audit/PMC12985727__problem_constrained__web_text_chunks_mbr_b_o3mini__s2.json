  "claims": [
    {
      "text": "The as-cast TiVNbTa alloy has a dendritic, single-phase BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast TiVNbTa alloy has a lower-temperature yield strength of approximately 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast TiVNbTa alloy has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline TiVNbTa alloy sustains 30% compressive strain at 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A post-casting aging treatment can induce coherent second-phase precipitates within the BCC TiVNbTa matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The induced precipitates could be a Laves-type phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aging treatment will produce a uniform nanoscale dispersion of precipitates that remains thermally stable at 1273 K.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates hinder dislocation motion and thereby provide dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitation strengthening will impede high-temperature plastic deformation in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The aged TiVNbTa alloy will have a higher yield strength at 1273 K than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction",
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The yield strength at 1273 K could approach the mid- to high-600 MPa range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strengthened alloy will retain acceptable ductility for the intermediate-layer application.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intended intermediate layer operates under compressive loading during heat transfer between W and CuCrZr.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applicable operating-temperature range extends from room temperature to 1273 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High thermal conductivity and mechanical integrity are both critical properties for the intermediate layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of strengthening depends on precipitate identity, stability, and spatial distribution.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Microstructural optimization may be required to balance precipitation strengthening against ductility.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::011::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A controlled comparison of aged and as-cast TiVNbTa specimens at 1273 K can test the proposed strengthening effect.",
      "field": "falsification_experiment.design",
      "needs_support": false,
