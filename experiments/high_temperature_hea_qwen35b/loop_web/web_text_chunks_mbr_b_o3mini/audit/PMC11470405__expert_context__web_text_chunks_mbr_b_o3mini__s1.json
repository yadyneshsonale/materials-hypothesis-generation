  "claims": [
    {
      "text": "As-cast HfNbTaTiZr is primarily a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr is metastable at room temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr is prone to elemental segregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514597::web::023::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoscale precipitates can form during intermediate-temperature processing of HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion",
        "PMC7514597::web::023::5_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ta and Zr segregation promotes local phase separation or Ta-rich precipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514597::web::023::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed precipitates have a coefficient of thermal expansion different from that of the BCC matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal-expansion mismatch between precipitates and the matrix generates interfacial residual stresses.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mismatch-generated residual stresses modify dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mismatch-generated residual stresses alter the alloy's thermoelastic response and measured elastic moduli.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling from the melt suppresses precipitation and produces a more homogeneous BCC baseline with minimal mismatch stress.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 600–800 °C promotes fine-scale precipitation relative to the rapid-cooled baseline.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Precipitate-promoting aging will produce greater internal residual stress than rapid cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate-containing samples will have altered steady-state creep rates at 1250 °C, potentially including faster creep.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate-containing samples will show a different cold-rolling microhardness evolution because their work-hardening response is modified.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate-containing samples will deviate from the baseline elastic-modulus trend over 293–1100 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate-containing samples will have lower uniform elongation than the precipitate-minimized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514597::web::023::5_conclusions",
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary precipitates can damage plasticity, and Ta-rich grain-boundary precipitates can strongly reduce elongation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514597::web::023::5_conclusions",
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "A single precipitate-induced thermal-mismatch mechanism explains the reported creep, cold-rolling hardness, elastic-modulus, and aging-hardening behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
