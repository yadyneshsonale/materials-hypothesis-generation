  "claims": [
    {
      "text": "Across rare-earth-free high-entropy alloys, strong low-field magnetocaloric response is governed by a reduced dispersion of local exchange interactions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Selective alloying can produce a more chemically homogeneous magnetic lattice.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Magnetic homogenization sharpens the second-order magnetic phase transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A sharper, more homogeneous magnetic transition enhances the magnetic entropy change.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed alloying strategy maintains rapid heat exchange.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alloying strategy maintains or reduces magnetic hysteresis.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alloying strategy maintains robust mechanical stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The experimental baseline is NiFeCoCr without an additional FCC-metal additive.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 0.5 atomic fraction of Pd, Ag, or Cu to NiFeCoCr can tune chemical homogeneity and narrow the exchange-energy distribution.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Measurements should be made near room temperature and at applied fields up to approximately 1 T after uniform heat treatment.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "FCC-metal substitution narrows the local distribution of exchange interactions and makes the magnetic environment more homogeneous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The additive reduces intrinsic disorder in the magnetic exchange network.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A narrowed exchange-energy distribution produces a more synchronized second-order magnetic transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The synchronized transition produces a higher magnetic entropy change per field increment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract",
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The synchronized second-order transition reduces hysteresis.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical properties are preserved because of the inherent stability of the high-entropy matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will retain heat-transfer properties similar to those of baseline NiFeCoCr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline NiFeCoCr has a broader exchange-interaction distribution that dilutes its low-field magnetocaloric response.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
