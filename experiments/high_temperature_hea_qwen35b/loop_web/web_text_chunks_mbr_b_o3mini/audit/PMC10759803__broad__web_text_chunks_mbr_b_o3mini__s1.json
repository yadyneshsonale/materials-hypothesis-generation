  "claims": [
    {
      "text": "Adding approximately 0.1 at% carbon to the refractory alloy will induce carbide precipitation during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The carbon-induced carbides will form a fine, dispersed precipitate population.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates may include Ta3C and Nb3C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Carbide formation will occur under ordinary tensile exposure at approximately 800–1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tensile loading at 800–1000 °C represents operational conditions typical of jet-turbine applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbide precipitates impede dislocation motion under high-temperature loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbide precipitates impede grain-boundary sliding under high-temperature loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-induced carbide precipitation will increase high-temperature yield strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The high-temperature yield-strength increase will be approximately 10–25% relative to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.1 at% carbon will not appreciably change the alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 0.1 at% carbon will preserve room-temperature ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At ambient conditions, 0.1 at% carbon does not significantly alter the alloy's phases or lattice constant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Trace carbon does not cause brittle intermetallic formation at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped starting refractory alloy is single phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped starting alloy has acceptable room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The undoped starting alloy has limited high-temperature strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping carbon near 0.1 at% is necessary to obtain fine, controlled carbide precipitation and strengthening.",
