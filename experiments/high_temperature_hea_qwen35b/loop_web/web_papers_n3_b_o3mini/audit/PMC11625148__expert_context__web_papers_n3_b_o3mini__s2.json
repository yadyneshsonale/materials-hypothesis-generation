      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The HCP-forming additive will alter and lower dislocation core energies in NbMoTaW.",
