      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Uniform Cr and Ta distribution enables self-healing of the oxide by preferential oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
