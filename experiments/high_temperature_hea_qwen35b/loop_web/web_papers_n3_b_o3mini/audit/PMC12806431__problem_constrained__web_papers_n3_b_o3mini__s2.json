  "claims": [
    {
      "text": "The refractory high-entropy alloy was originally engineered as a single-phase solid solution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy has low impurity concentrations.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trace oxygen and nitrogen promote phase segregation during thermal aging.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging near 700°C produces microstructural evolution associated with trace interstitials in a refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Impurity-induced segregation forms brittle precipitates or secondary phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed brittle secondary phases form along grain boundaries or within the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trace interstitials initially provide solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At service-relevant temperatures, oxygen and nitrogen diffuse through the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Interstitial redistribution causes local compositional fluctuations and phase segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Segregation creates brittle regions that cannot accommodate plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittle secondary phases act as stress concentrators and crack-nucleation sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed brittle regions cause crack initiation and propagation under mechanical loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impurity-enriched aged samples will exhibit more phase segregation than low-impurity controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Greater impurity-induced segregation will reduce fracture toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater impurity-induced segregation will lower ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater impurity-induced segregation will increase the propensity for brittle fracture.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
