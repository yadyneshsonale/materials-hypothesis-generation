      "supporting_ids": [
        "PMC5893566::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deformation-induced FCC-to-HCP transformation delays void coalescence.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
