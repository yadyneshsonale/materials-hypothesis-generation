      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Edge-dislocation slip is less sensitive to thermal activation than screw-dislocation slip.",
