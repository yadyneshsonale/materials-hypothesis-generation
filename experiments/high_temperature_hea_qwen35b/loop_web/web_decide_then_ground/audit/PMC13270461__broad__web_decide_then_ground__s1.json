        "PMC11169556::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr2O3, Al2O3, and SiO2 can act as protective oxide barriers against further oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation behavior is driven by element-level thermodynamic and physicochemical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::000::abstract",
        "PMC11169556::web::005::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Standard reduction potential, cohesive energy density, and atomic radius influence elemental reactivity toward oxygen.",
