      ],
      "same_system": "yes"
    },
    {
      "text": "Material integrity in harsh high-temperature environments is governed by the formation of protective oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
