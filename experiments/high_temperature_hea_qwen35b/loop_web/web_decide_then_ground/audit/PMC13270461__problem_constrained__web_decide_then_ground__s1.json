  "claims": [
    {
      "text": "The starting material is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 with an FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature exposure of this alloy to oxidizing gases forms Mn-based oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mn-based oxides formed during exposure are non-protective.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of non-protective Mn-based oxides governs degradation of the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation behavior at elevated temperature is influenced by elemental reactivity toward diffusing oxygen atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::005::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermally driven oxygen diffusion and reaction with Mn produce the Mn-based oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics",
        "PMC11169556::web::005::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn oxidation depletes Mn from the bulk alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Bulk Mn depletion degrades the alloy's mechanical properties and leads to catastrophic failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Mn-oxide mechanism also applies during exposure to reducing gases or vacuum.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure will reduce yield strength by at least 20% relative to the as-manufactured baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies over 500-1100 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::036::4_4_oxidation_thermodynamics"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed behavior applies after 100 hours of exposure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
