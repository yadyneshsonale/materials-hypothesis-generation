  "claims": [
    {
      "text": "Resistance to time-dependent plastic deformation in high-entropy-alloy multilayer coatings is governed by interactions between partial dislocations and localized planar-slip bands.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::009::subsequent_deformation_modes"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Localized bands of planar slip block partial dislocations and make their subsequent motion more difficult.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::009::subsequent_deformation_modes"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Additional force is required for partial dislocations to overcome the planar-slip barriers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::009::subsequent_deformation_modes"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Blocking dislocation motion through these interactions produces a strengthening effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::009::subsequent_deformation_modes"
      ],
      "same_system": "unclear"
    },
    {
      "text": "This strengthening mechanism explains resistance specifically to creep or other time-dependent plastic deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::009::subsequent_deformation_modes"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed mechanism applies to both as-deposited and annealed coatings.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed comparison uses in-situ TEM or SEM during creep testing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation density and plastic-deformation rate are the proposed measured variables.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The multilayer coatings are expected to show a 20% increase in resistance to time-dependent plastic deformation relative to single-layer high-entropy alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is asserted to apply from 20 to 800 °C.",
