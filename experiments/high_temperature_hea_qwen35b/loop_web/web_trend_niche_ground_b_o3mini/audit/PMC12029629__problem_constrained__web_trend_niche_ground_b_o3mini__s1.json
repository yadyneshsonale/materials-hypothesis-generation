      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased solute-dislocation interactions enhance dislocation drag.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced dislocation drag gives Co-free FeNiCrMn a higher low-temperature yield strength than CoCrFeMnNi.",
