  "claims": [
    {
      "text": "Cr16Mn16Fe16Co16Ni16P20 has limited amorphous retention after rapid quenching.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr16Mn16Fe16Co16Ni16P20 exhibits multiple early crystallization events during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The phosphorus-containing Cr16Mn16Fe16Co16Ni16P20 alloy has a broad solidification range and complex crystallization behavior.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 3–5 at.% boron will improve the glass-forming ability of Cr16Mn16Fe16Co16Ni16P20.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at.% boron will improve the thermal stability of Cr16Mn16Fe16Co16Ni16P20.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron atoms are small and have metalloid character.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron promotes a more densely packed, topologically disordered structure and acts as a network former in this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron-enhanced atomic packing and local structural frustration increase the kinetic or energetic barrier to crystalline nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased crystallization barrier delays crystallization during rapid cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased crystallization barrier delays crystallization during subsequent reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will have a higher amorphous phase fraction after rapid quenching than the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will exhibit a delayed and simplified DSC crystallization response, ideally a single higher-temperature peak.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt-spinning of the base alloy can provide cooling rates in the range of approximately 10^5–10^6 K/s.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid cooling can promote amorphous-structure formation in Cr16Mn16Fe16Co16Ni16P20.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The beneficial effect of boron should manifest at cooling rates of at least 10^5 K/s.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction",
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "At substantially lower cooling rates, boron's benefit may diminish and ordinary crystallization may occur.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::020::4_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The comparison should use DSC reheating at approximately 40 K/min.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "XRD, TEM, and DSC can be used to compare phase retention, microstructure, and thermal transitions between undoped and boron-added samples.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is falsified if boron produces neither increased amorphous retention nor a delayed and simplified crystallization response relative to the baseline.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
