  "claims": [
    {
      "text": "The initial material is a uniform, single-phase, FCC high-entropy alloy in the as-cast state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::025::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated single-phase alloy exhibits ductile and tough behavior under moderate loading.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::012::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High applied mechanical stress induces local compositional segregation in the initially homogeneous matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress-induced segregation is localized at grain boundaries and defect clusters.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The localized segregation nucleates brittle secondary phases at microstructural defect sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittle secondary-phase regions inhibit dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Intrinsic toughening in high-entropy alloys is associated with plastic deformation ahead of a crack and can resist crack initiation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::012::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Segregated or secondary-phase regions suppress intrinsic plasticity and intrinsic toughening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppression of plasticity facilitates crack initiation and propagation, producing brittle fracture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4682111::web::012::discussion",
        "PMC10003886::web::025::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A nominally single-FCC-phase high-entropy alloy can display cleavage-type brittle fracture.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10003886::web::025::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical loading can drive dynamic phase evolution under high stress.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7012927::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed embrittlement occurs only after a critical stress, strain, or temperature threshold is exceeded.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below the critical loading and temperature conditions, the alloy retains its toughness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High nanoindentation loads, high strain rates, or elevated temperatures represent the demanding service conditions relevant to the proposed transition.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal pre-conditioning can promote microstructural phase evolution.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::025::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Loaded samples will show detectable markers of phase segregation or brittle-phase precipitation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loaded samples will have lower fracture toughness than untreated baseline samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loaded samples will shift from ductile to brittle fracture relative to the baseline.",
