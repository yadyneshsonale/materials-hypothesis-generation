        "PMC9365806::web::011::psr_mechanisms",
        "PMC8347531::web::013::3_5_annealing_treatment_on_the_al50ti20c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "EBSD and TEM can be used to assess FCC recrystallization and B2-network integrity, while mechanical testing can measure strength and ductility.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
