  "claims": [
    {
      "text": "A two-step annealing treatment can induce phase-selective recrystallization of the FCC phase while preserving the B2 network in eutectic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "This phase-selective treatment will simultaneously increase strength and ductility relative to conventional slow-cooling.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms",
        "PMC8347531::web::013::3_5_annealing_treatment_on_the_al50ti20c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial slow-cooled eutectic HEA has a lamellar FCC+B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC phase is soft and ductile, whereas the B2 phase is hard.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
