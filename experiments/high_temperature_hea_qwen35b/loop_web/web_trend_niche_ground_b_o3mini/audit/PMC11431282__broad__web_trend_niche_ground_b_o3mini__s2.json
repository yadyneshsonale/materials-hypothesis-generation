  "claims": [
    {
      "text": "The baseline MnNiSi-based alloy has a large magnetocaloric entropy change near its magneto-structural transition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline MnNiSi-based alloy has inadequate toughness and is brittle.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is substitutional Ti doping at 2–5 at.% during MnNiSi alloy synthesis.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti added to MnNiSi at 2–5 at.% will preferentially segregate to grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti grain-boundary segregation will cause grain refinement in MnNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11172879::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary compositional decoration can improve the mechanical properties of nanocrystalline materials.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11172879::web::000::abstract",
        "PMC11172879::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary segregation strengthens boundaries by inhibiting grain-boundary migration and sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11172879::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Ti-enriched grain boundaries will reduce defect-induced crack propagation in MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced crack propagation will enhance the fracture toughness of Ti-doped MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping Ti at a low concentration and largely confined to grain boundaries will leave the bulk MnNiSi crystal lattice substantially unperturbed.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An unperturbed bulk crystal lattice will preserve the magnetic behavior responsible for the magnetocaloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to undoped MnNiSi, 2–5 at.% Ti doping will improve ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to undoped MnNiSi, 2–5 at.% Ti doping will improve fracture toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11172879::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to undoped MnNiSi, 2–5 at.% Ti doping will retain a similar magnetocaloric entropy-change magnitude near the transition temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefits should persist during cyclic magnetic and thermal loading near the magneto-structural transition.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti concentrations above approximately 5 at.% could degrade magnetocaloric properties by altering the bulk magnetic transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison of 0, 2, 3, and 5 at.% Ti samples can test changes in mechanical and magnetocaloric properties.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant mechanical improvement, or a magnetocaloric entropy-change reduction greater than approximately 10%, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
