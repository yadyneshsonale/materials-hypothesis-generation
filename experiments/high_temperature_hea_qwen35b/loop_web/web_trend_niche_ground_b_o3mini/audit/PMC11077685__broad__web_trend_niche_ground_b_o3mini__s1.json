      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective layer slows oxygen ingress into the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding aluminum reduces oxidation rates and protects the underlying alloy relative to an untreated alloy.",
