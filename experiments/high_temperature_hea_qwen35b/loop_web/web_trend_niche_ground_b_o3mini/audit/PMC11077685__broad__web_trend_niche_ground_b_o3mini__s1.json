      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox",
        "PMC9787501::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The aluminum-treated alloy will develop a significantly thinner oxide scale than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
