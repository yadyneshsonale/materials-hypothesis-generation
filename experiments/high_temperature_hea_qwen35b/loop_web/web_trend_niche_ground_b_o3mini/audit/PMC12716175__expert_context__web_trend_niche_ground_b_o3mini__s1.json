      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ALD-Ni composite will have better interfacial contact than the vapor-coated-tungsten baseline.",
