      "supporting_ids": [
        "PMC9960858::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The corrosive environment simultaneously promotes reformation of the oxide removed by sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater oxide-film stability intrinsically produces faster repair after mechanical damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Faster oxide repair reduces the duration for which bare metal is exposed to the electrolyte.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing bare-metal exposure mitigates corrosive attack.",
