      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical sliding intermittently removes or disrupts the surface oxide layer.",
