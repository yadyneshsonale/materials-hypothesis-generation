  "claims": [
    {
      "text": "The starting eutectic high-entropy alloy has a hierarchical dual-phase lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The starting alloy is in an as-cast, untreated state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has limited room-temperature tensile ductility and brittle premature failure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pile-ups at internal lamellar-colony boundaries cause the starting alloy's limited ductility and brittleness.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A minor boron addition can be introduced in a single processing step.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added boron will selectively segregate to lamellar-colony boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solidification or a subsequent heat treatment can be adjusted to promote boron segregation at internal boundaries.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated boron modifies the local chemistry and structure of the interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron segregation reduces the barrier for dislocation transmission across internal boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing the dislocation-transmission barrier lessens dislocation pile-ups.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pile-ups produce local stress concentrations, microcracking, and brittle failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron segregation enhances interfacial bonding and thereby enables more uniform plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron doping will markedly increase room-temperature tensile elongation relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron doping will retain or increase yield strength and ultimate tensile strength relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron doping will significantly reduce microcrack initiation near internal boundaries.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit applies under room-temperature, quasi-static tensile loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC9267696::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Excessive boron could form brittle intermetallic phases at boundaries.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittle boundary phases formed by excessive boron would negate the ductility benefit.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dopant-segregation interface engineering is supported in related high-entropy-alloy systems.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal boron concentration, processing conditions, and quantitative mechanical-property improvements remain undetermined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
