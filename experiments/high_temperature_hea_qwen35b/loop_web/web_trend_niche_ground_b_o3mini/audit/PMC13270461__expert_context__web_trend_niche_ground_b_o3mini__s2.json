  "claims": [
    {
      "text": "The additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has a uniform, single-phase fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a homogeneous elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature degradation of the alloy is governed by the formation and integrity of its oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Under oxidizing conditions, Al and Cr preferentially oxidize.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract",
        "PMC7504593::web::054::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure produces a continuous and adherent mixed Al2O3-Cr2O3 scale on the target alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al- and Cr-containing protective scale limits further oxidation and degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract",
        "PMC7504593::web::054::5_4_2_oxidation_at_1200_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide scale maintains the fcc matrix during oxidizing exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale preserves strength and fatigue performance during oxidizing exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The lower oxygen chemical potential in reducing gas inhibits formation of a continuous protective layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure produces discontinuous or less-adherent oxides on the target alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti may alter oxide-scale adhesion under reducing conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inadequate or incoherent oxide growth leads to premature scale spallation and interfacial breakdown.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scale spallation and interfacial breakdown accelerate degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure will yield a stable, adherent scale with limited weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing exposure will cause greater weight loss or erratic weight change due to spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure will cause interfacial microstructural damage.",
