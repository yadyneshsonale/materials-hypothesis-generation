      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Kinetic hindrance caused by rapid cooling stabilizes retained BCC or metastable intermediate phases in Cr39Co18Fe18Ni18Al7.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "The critical temperature interval for kinetically limited phase transformation is 1350–1100 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic mobility at the BCC/competing-phase interface mediates the transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Nucleation barriers at the BCC/competing-phase interface mediate the transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al content affects atomic mobility and interfacial nucleation barriers in this alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A slight increase in Al lowers the free-energy barrier for transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling should produce more complete transformation toward the equilibrium phase.",
