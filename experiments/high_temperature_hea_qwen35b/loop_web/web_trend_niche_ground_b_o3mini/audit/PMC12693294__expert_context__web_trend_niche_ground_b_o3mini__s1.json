      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid cooling should retain a higher BCC phase fraction than slow cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
    },
    {
      "text": "With sufficient thermal exposure, an Al-enriched variant should transform more extensively than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard furnace cooling of Cr39Co18Fe18Ni18Al7 should yield phase compositions close to thermodynamic equilibrium.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::011::kinetic_effect_and_tailoring_phases_in_c"
      ],
      "same_system": "no"
