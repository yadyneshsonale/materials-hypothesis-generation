{
  "run_id": "PMC13270461__broad__web_trend_niche_ground_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "In multiprincipal-element alloys such as CrMnFeCoNi, the relative concentrations of high-affinity oxide-forming elements govern oxidation resistance and material integrity by controlling the surface oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Mn relative to Cr and/or Al will favor protective Cr2O3 and/or Al2O3 over non-protective Mn-rich oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn is a major oxide-forming element during high-temperature oxidation of CrMnFeCoNi in air.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-rich oxides formed on CrMnFeCoNi can be non-protective and deplete Mn from the bulk alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lowering the alloy's Mn content decreases preferential Mn outward diffusion and oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High Mn mobility and oxide formation can produce Mn depletion, pore formation, and accelerated oxide growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr and/or Al promotes early formation of compact, stable Cr2O3 and/or Al2O3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Compact Cr2O3 or Al2O3 can act as a diffusion barrier and improve oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will develop a dual-layer scale with an inner protective Cr2O3/Al2O3-rich layer and an outer sacrificial layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A protective oxide barrier will limit further elemental depletion from the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The equiatomic CrMnFeCoNi baseline forms predominantly non-protective Mn-rich oxides under high-temperature oxidation.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to equiatomic CrMnFeCoNi, the reduced-Mn and increased-Cr/Al alloy will have lower oxide thickness and a lower parabolic oxidation rate constant.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The reduced-Mn and increased-Cr/Al alloy will exhibit improved oxide-scale adhesion and integrity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Suppressing Mn depletion and forming a protective scale will improve retention of hardness, strength, or other mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed governing behavior should hold in air from 800°C to 1200°C for exposures of 24 to 120 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Changing the atmosphere or applying thermal cycling outside the tested regime may change the governing oxidation mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC13208696::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Microstructural factors and minor alloying additions can affect oxidation kinetics, scale adhesion, and mechanical integrity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::000::abstract",
        "PMC13208696::web::026::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact compositional threshold required for optimal protective oxide formation is not established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
