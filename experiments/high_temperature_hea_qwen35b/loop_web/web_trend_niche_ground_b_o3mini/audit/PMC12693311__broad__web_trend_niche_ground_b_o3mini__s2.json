  "claims": [
    {
      "text": "A phosphorus-containing compositionally complex alloy can form an amorphous structure under rapid cooling.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "yes"
    },
    {
      "text": "The target baseline alloy has only modest glass-forming ability.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The target baseline alloy has limited amorphous-state thermal stability.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Micro-alloying approximately 1 at% of a large-radius element such as Gd will enhance glass-forming ability in phosphorus-containing high-entropy or compositionally complex alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying",
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "yes"
    },
    {
      "text": "The same approximately 1 at% addition will increase the thermal stability of the resulting amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Gd addition at or below approximately 1 at% can measurably affect glass formation in Pd-Ni-P.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding a large-radius element increases the atomic-radius mismatch and disrupts regular local atomic packing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying",
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "yes"
    },
    {
      "text": "Significant atomic-radius mismatch disrupts the regular packing required to form crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Variability in constituent atomic radii typically elevates melt viscosity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The packing disruption and increased viscosity impede crystalline nucleation, diffusion, rearrangement, and growth during cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The large-radius addition retards crystallization during subsequent thermal annealing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will require a lower critical cooling rate for glass formation than the additive-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying",
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified alloy will have a higher crystallization onset temperature than the additive-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect is limited to low additive concentrations.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "yes"
    },
    {
      "text": "Additions above approximately 2 at% may fail to improve glass-forming ability or thermal stability.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect may disappear when cooling or annealing conditions fall outside a regime dominated by atomic-size mismatch.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
