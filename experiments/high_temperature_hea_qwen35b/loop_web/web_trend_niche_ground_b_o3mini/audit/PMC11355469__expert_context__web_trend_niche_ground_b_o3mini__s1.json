  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin-film protective coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
