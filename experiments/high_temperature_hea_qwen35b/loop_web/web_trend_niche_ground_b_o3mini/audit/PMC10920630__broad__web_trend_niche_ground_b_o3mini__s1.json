  "claims": [
    {
      "text": "Conventional corrosion-resistant steels are used in chemical-processing and nuclear-power applications.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated conventional steels naturally form relatively uncontrolled passive layers containing Cr, Ni, and Mo.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::web::014::4_2_corrosion_resistance"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled pre-oxidation promotes chromium segregation at the steel surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective oxidation during pre-oxidation enriches the steel surface in chromium.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface chromium enrichment leads to formation of a Cr2O3-rich passive layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427115::web::014::4_2_corrosion_resistance",
        "PMC8838792::web::011::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr2O3-rich film produced by pre-oxidation is denser and more stable than the naturally formed film on untreated steel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A protective Cr2O3-rich layer inhibits attack by aggressive ions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "A protective Cr2O3-rich layer limits further metal dissolution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517287::web::017::3_3_corrosion_behavior_in_3_5_wt_nacl_so",
        "PMC9457219::web::018::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "Chromium-rich passivation enhances corrosion resistance.",
