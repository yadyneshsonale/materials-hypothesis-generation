      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Selective dissolution of Fe contributes to Cr enrichment of the passivation film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation of Cr contributes to Cr enrichment of the passivation film.",
