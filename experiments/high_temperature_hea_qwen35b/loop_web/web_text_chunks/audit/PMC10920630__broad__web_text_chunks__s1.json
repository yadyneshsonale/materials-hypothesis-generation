      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Selective Fe dissolution and Cr oxidation lead to formation of a stable passivation film across the stated corrosive environments.",
