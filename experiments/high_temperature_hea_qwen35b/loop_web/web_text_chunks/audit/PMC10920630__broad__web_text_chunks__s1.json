      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8838792::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-Cr steels have better corrosion resistance than steels without high Cr content.",
