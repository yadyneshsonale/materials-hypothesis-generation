  "claims": [
    {
      "text": "Adding a boride layer to a boride-based component can improve its resistance to molten-aluminum corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10221107::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention is the addition of a boride layer.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention produces a surface boride layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10221107::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boride layer acts as a barrier between molten aluminum and the underlying component.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boride layer prevents or suppresses reaction between molten aluminum and the boride-based component.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing the reaction with molten aluminum reduces corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated component will have better molten-aluminum corrosion resistance than an otherwise comparable component without the boride layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10221107::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The improvement is expected under hot-dip aluminum-plating service conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective protection requires a sufficiently thick boride layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective protection requires a uniform boride layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
