  "claims": [
    {
      "text": "Cryo-rolling followed by annealing can overcome the strength-ductility trade-off in the eutectic high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated starting alloy has a hierarchical microstructure of dual-phase lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is the combined processing route of cryo-rolling and annealing.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed performance applies under room-temperature tensile loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed performance applies specifically under quasi-static loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cryo-rolling and annealing produce a hierarchical microstructure containing fine lamellar regions and coarse non-lamellar regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hardness heterogeneity and associated strain gradients generate significant back-stress strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Back-stress strengthening delays necking and improves both strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed microstructure has a self-generated microcrack-arresting mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cryo-rolled and annealed material will exhibit a yield strength greater than 1400 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cryo-rolled and annealed material will exhibit elongation to failure greater than 14%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment simultaneously enhances strength and ductility relative to as-cast and cold-rolled-and-annealed baselines.",
      "field": "predicted_outcome; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5818523::web::000::abstract",
        "PMC5818523::web::013::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is limited by the ability to achieve a uniform and fine lamellar microstructure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Internal boundaries cause dislocation pile-ups and microcracking in this alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
