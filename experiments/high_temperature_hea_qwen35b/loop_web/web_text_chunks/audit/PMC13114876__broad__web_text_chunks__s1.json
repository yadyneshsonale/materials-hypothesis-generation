  "claims": [
    {
      "text": "Resistance to simultaneous wear and corrosion in high-entropy alloys is governed by formation of a stable, dense, and refined microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mo addition can produce the stable, dense, and refined microstructure proposed to improve tribocorrosion resistance.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12525669::web::007::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Si addition can refine or otherwise beneficially modify an HEA microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12654518::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "B addition can modify an alloy microstructure and improve both wear and corrosion resistance.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Processing that promotes grain refinement and lattice distortion can generate a stable and dense microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12654518::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Laser cladding is a suitable processing route for producing the proposed beneficial HEA microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12654518::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Vacuum arc remelting promotes the stable, dense, and refined microstructure invoked by the hypothesis.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain size, phase composition, and lattice distortion are the relevant structural mediators of wear-corrosion resistance.",
      "field": "structural_mediator",
