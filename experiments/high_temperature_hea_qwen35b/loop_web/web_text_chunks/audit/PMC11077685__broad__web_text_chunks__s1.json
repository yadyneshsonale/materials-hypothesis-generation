  "claims": [
    {
      "text": "Adding 0.1 at.% carbon to a refractory high-entropy alloy can improve its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is the addition of 0.1 at.% carbon to the RHEA.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should work above 700°C in an oxidizing atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding carbon causes formation of carbides such as Ta3C and Nb3C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ta3C and Nb3C form under the stated high-temperature oxidizing conditions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbides act as a barrier to oxygen diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon reacts with refractory elements in the RHEA to form carbides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Carbide formation reduces diffusion of oxygen into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion improves oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified alloy will have a lower oxidation rate than the untreated alloy.",
