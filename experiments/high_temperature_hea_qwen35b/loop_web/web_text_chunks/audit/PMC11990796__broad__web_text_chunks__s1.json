  "claims": [
    {
      "text": "Interstitial carbon addition can improve the strength–ductility combination of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The starting refractory high-entropy alloy has a single-phase structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is the addition of carbon as an interstitial alloying element.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC5227964::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed benefit should occur at temperatures above 1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon addition will cause the formation of nanoscale carbides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale carbides will produce precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition or the resulting carbides will enhance grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will increase yield strength relative to a refractory high-entropy alloy without interstitial carbon.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon addition will increase ductility relative to a refractory high-entropy alloy without interstitial carbon.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5227964::web::001::body",
        "PMC10744483::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
