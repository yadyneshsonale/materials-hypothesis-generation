        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant alloys are single-phase FCC after thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changing constituent identity and concentration changes stacking-fault energy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed comparison applies to deformation at room or cryogenic temperatures.",
      "field": "conditions",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stacking-fault energy influences whether dislocation slip or deformation twinning is activated.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Low stacking-fault energy promotes dissociated partial dislocations, planar faults, and twinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Twinning-controlled deformation can contribute to high strength and ductility in equiatomic CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Changes in dislocation-slip mode can affect strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to the quinary baseline, lower-SFE subsets will exhibit both greater strength and greater ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10026765::web::004::introduction",
        "PMC5321736::web::002::body",
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted improvements arise from enhanced twinning.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted improvements arise from enhanced dislocation slip.",
