      ],
      "same_system": "yes"
    },
    {
      "text": "Cr2O3, Al2O3, and SiO2 can serve as protective oxides for high-temperature alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Refractory multiprincipal-element alloys and high-entropy alloys have high melting points and strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature exposure promotes oxide formation on multiprincipal-element alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Temperatures of 700-1000 °C are relevant to the proposed governing behavior.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Fusion-reactor and nuclear-reactor service environments are represented by the proposed exposure conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A compact protective oxide layer acts as a barrier to further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide layer reduces inward diffusion of oxygen and other corrosive species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Absence of a Cr2O3 layer can permit continued elemental diffusion and formation of less protective oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Loss or evaporation of oxide scale constituents can reduce scale adherence and activate breakaway oxidation at temperatures of at least 700 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced ingress of oxidizing or corrosive species maintains alloy integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air",
        "PMC6317005::web::016::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Multiprincipal-element alloys possessing a protective oxide layer will show improved oxidation resistance relative to alloys without such a layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::web::027::4_3_oxidation_in_air"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Multiprincipal-element alloys possessing a protective oxide layer will retain greater material strength or integrity than alloys without such a layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional alloys used in traditional nuclear or high-temperature applications lack protective oxide layers.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
