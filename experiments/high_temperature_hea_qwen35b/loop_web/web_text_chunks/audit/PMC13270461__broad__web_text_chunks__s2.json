  "claims": [
    {
      "text": "Oxidation resistance and material integrity of multiprincipal-element alloys are governed by formation of a protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
