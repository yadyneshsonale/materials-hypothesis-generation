  "claims": [
    {
      "text": "Eutectic high-entropy alloys can have lamellar or rod-like eutectic microstructures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding an appropriate amount of Cr to a eutectic high-entropy alloy can simultaneously increase its strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract",
        "PMC10179711::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "There is a specific or optimal Cr addition that produces the desired property improvement.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Cr-induced improvement should occur at room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract",
        "PMC10179711::web::001::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Cr-induced improvement should also occur at elevated temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cr addition causes formation of a dual-phase FCC-BCC microstructure in the eutectic high-entropy alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC phase is mechanically softer than the BCC phase in the proposed eutectic microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The BCC phase supplies the hard component of the proposed eutectic microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Cr regulates the fractions of the two phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10179711::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing Cr regulates the spatial distribution of the two phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10179711::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Regulating the phase fractions and distribution produces a balance between strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract",
        "PMC10179711::web::001::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cr addition can improve resistance to localized deformation, reduce nonuniform strain, and thereby promote a strength-ductility balance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10179711::web::001::abstract"
      ],
      "same_system": "unclear"
    },
