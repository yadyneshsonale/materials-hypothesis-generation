      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Carbide formation reduces oxygen diffusion into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion improves oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified RHEA will undergo less oxidation than the untreated RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified RHEA will have a longer lifespan under extreme-temperature conditions than the untreated RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
