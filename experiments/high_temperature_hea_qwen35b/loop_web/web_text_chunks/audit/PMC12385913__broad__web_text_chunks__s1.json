      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism operates under high strain rates and high pressures relevant to fusion plasma-facing service.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Twin-network formation under the proposed conditions will yield high strength, high ductility, and high fracture toughness.",
