      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al addition improves room-temperature creep resistance in RHEAs.",
      "field": "predicted_outcome",
      "needs_support": true,
