      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction",
        "PMC11203300::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated starting RHEAs have a BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is the addition of Al to an RHEA.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed benefits should hold at room temperature, at elevated temperature, and during exposure to corrosive media.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction",
        "PMC11203300::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al forms solid solutions with refractory metals and induces lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al addition can induce hard Laves phases in an RHEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al-induced lattice distortion produces solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al-induced hard Laves phases produce precipitation hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al addition improves the mechanical durability of RHEAs.",
