  "claims": [
    {
      "text": "The baseline is an elemental Cr coating on a zirconium-alloy fuel-cladding substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature Cr–Zr interdiffusion causes premature failure of the elemental Cr coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elemental Cr coatings can peel and crack during high-temperature steam oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is addition of Al to the Cr coating.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Al to the Cr coating can prevent premature coating failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC9318428::web::001::1_introduction",
        "PMC9318428::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Al to the Cr coating can suppress elevated-temperature Cr–Zr interdiffusion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified Cr coating will preserve protection during normal subcritical-water operation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC9318428::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified Cr coating will preserve protection in accident-relevant high-temperature steam.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9318428::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al addition produces a denser oxide layer consisting of Al2O3 and Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Al reacts with Cr to form a stable oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stable oxide layer reduces Cr–Zr interdiffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of a denser protective oxide can improve corrosion resistance on zirconium-alloy cladding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC9318428::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified coating will outperform the elemental-Cr-coated baseline and exhibit less premature failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC9318428::web::001::1_introduction",
        "PMC9318428::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis is intended to apply from 500 to 1000 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is intended to apply for exposure times from 100 to 1000 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant environments are subcritical water and high-temperature steam.",
      "field": "boundary",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC9318428::web::001::1_introduction",
        "PMC9318428::web::002::1_introduction"
      ],
      "same_system": "unclear"
