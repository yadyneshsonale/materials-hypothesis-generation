    {
      "text": "A controlled comparison of Cr coatings with and without Al can test the hypothesis using coating thickness, oxide composition, corrosion rate, and interdiffusion rate.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
