      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr2O3 and spinel oxides are the particularly important constituents of the protective layer.",
      "field": "hypothesis",
      "needs_support": true,
