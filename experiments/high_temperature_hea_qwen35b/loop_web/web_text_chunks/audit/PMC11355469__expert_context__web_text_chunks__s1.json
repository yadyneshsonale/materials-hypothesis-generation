      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer acts as a barrier against further oxidation of the underlying material.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
