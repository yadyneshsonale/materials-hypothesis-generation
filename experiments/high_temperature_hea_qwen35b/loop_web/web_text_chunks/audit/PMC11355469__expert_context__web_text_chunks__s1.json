      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Suppressing oxidation and corrosion through the oxide barrier enhances coating wear resistance.",
