      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::028::characterization_of_mobile_dislocations_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The elevated-temperature deformation behavior is caused by interaction between edge dislocations and thermal super-jogging.",
