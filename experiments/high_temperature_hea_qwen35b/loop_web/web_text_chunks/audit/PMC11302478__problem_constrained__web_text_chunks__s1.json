      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10026765::web::004::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Twinning-controlled deformation can contribute to high strength, ductility, and fracture toughness in equiatomic CrCoNi.",
      "field": "mechanism",
