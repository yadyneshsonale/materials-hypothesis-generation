  "claims": [
    {
      "text": "Resistance to time-dependent plastic deformation in high-entropy-alloy multilayer protective coatings is governed by formation of an ultra-nanocrystalline near-surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interactions between partial dislocations and planar slip bands govern resistance to time-dependent plastic deformation.",
