      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an untreated alloy with no oxide layer, the oxide-bearing alloy will have a lower wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::001::introduction"
      ],
      "same_system": "yes"
    },
