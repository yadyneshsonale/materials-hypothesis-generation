        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The balance between Cr and Al is the particularly important alloy-chemistry variable governing protective-scale formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-Al balance controls the outward diffusion of Cr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al promotes formation of a protective Al2O3 layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 and Cr2O3 layers are the structural mediators of passivation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed material begins in a single- or multiphase metallic solid-solution state.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is exposure above 900 °C to an oxidative or corrosive atmosphere.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr and Al affect oxide formation through outward diffusion and selective formation of passivating oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::024::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism produces a stable, coherent, slow-growing protective oxide layer.",
      "field": "predicted_outcome",
