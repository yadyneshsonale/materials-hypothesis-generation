      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed improvement should hold under high-temperature oxidation conditions encountered in PWR accidents.",
