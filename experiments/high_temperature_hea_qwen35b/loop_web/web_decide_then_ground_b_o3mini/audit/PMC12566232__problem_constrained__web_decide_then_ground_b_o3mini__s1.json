      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstruction of dislocation motion and shear-band propagation will promote continuous dynamic strain hardening.",
