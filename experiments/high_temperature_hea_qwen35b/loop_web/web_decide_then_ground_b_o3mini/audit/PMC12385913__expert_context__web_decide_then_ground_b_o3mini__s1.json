      "support": "partial",
      "supporting_ids": [
        "PMC5578249::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Dynamic recovery reduces localized stress concentrations in WTaTiVZr relative to pure tungsten.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
