  "claims": [
    {
      "text": "Grain boundaries and inclusions in as-received Q235 promote early oxide formation during salt exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The early oxide on Q235 is ultrathin, Fe-rich, and initially non-equilibrium.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At room temperature, slow oxidation kinetics on Q235 produce a thin passivating film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The room-temperature oxide on Q235 minimizes corrosion-related mass change.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 700–900 °C, thermal activation enhances grain-boundary diffusion in Q235.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::015::thermal_stability_and_applicability_to_n"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced high-temperature diffusion causes rapid oxide growth on Q235.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress accumulation in a rapidly growing Q235 oxide can cause scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxide-scale spallation causes accelerated corrosion and greater mass change in Q235.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "If diffusion and stress remain below a critical threshold, Q235 forms a coherent, protective high-temperature oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nature, thickness, and adherence of the early Fe-rich oxide mediate Q235 corrosion behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stainless-steel reference forms a uniform, resilient, stable oxide scale at both room temperature and 700–900 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Q235 exhibits minimal corrosion at room temperature relative to its high-temperature behavior.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under high-temperature salt exposure, Q235 can develop a non-coherent, spallation-prone scale and degrade more than the stainless-steel reference.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Variation in the as-received Q235 microstructure can alter diffusion paths and produce sample-to-sample variation in oxide evolution.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::web::015::thermal_stability_and_applicability_to_n",
        "PMC10488378::web::000::abstract"
      ],
      "same_system": "no"
