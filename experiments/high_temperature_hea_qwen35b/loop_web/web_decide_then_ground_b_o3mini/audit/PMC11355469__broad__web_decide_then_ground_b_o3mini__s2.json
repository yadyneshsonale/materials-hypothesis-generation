      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10890335::web::016::3_4_morphlology_and_wear_mechanism_of_we"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The shear-band-associated oxide layer reduces friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The shear-band-associated oxide layer reduces wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert environment limits formation of the protective oxide barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear rates are higher in an inert atmosphere than under oxidizing conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing conditions will produce significantly lower wear rates than inert conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing conditions will produce smoother wear tracks than inert conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
