  "claims": [
    {
      "text": "A thin ZrTiO4 ceramic coating can be deposited on a refractory high-entropy alloy by chemical vapor deposition.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The applied ZrTiO4 coating will form a continuous and adherent surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en"
      ],
      "same_system": "unclear"
    },
    {
      "text": "ZrTiO4 will remain a stable barrier under the proposed high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The ZrTiO4 layer will reduce oxygen diffusion into the refractory alloy substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Reduced oxygen ingress will inhibit oxidation reactions responsible for rapid scale degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en",
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Applying the ZrTiO4 coating will improve high-temperature oxygen resistance relative to leaving the alloy untreated.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en",
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated refractory HEA experiences rapid oxidation and oxide-scale degradation under extreme-temperature conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective effect is expected to operate during exposure at approximately 1200 °C in air for 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will exhibit lower oxidation mass gain than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en",
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coated alloy will retain microhardness better than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will retain structural integrity better than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An untreated refractory HEA exposed at 1200 °C in air for 100 hours develops a thick, non-protective oxide scale.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale produced on the untreated alloy under the specified exposure compromises mechanical performance.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective effect depends on the coating remaining intact and adherent.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::010::3_2_high_temperature_annealing_in_air_en"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coating delamination would diminish the protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure at significantly higher temperatures or for much longer durations may diminish the protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative oxidation-resistance improvement depends on coating thickness, uniformity, and adhesion.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's long-term durability under thermal cycling has not been fully characterized.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
