      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Localized surface damage and grain refinement disrupt the passive oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12112909::web::000::abstract",
        "PMC12112909::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical wear removes or damages the passive layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removal of the passive layer exposes fresh alloy surfaces that preferentially corrode.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion weakens the surface structure and thereby increases its susceptibility to wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear-assisted corrosion and corrosion-assisted wear form a positive feedback loop.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined tribo-corrosion will produce higher mass loss than the wear-only and corrosion-only baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined tribo-corrosion will increase the wear rate relative to the separate baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Combined tribo-corrosion will reduce electrochemical impedance relative to the separate baselines.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
