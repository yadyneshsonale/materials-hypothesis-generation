      ],
      "same_system": "unclear"
    },
    {
      "text": "Coupled tribo-corrosion produces overall material loss exceeding the sum of wear-only and corrosion-only losses.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The tested initial state has a homogeneous microstructure and an intact, stable passive oxide film.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding contact causes localized surface damage and grain refinement.",
