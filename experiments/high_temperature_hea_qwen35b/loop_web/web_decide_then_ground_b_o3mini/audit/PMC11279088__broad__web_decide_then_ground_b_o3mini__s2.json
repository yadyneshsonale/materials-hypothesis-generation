  "claims": [
    {
      "text": "High mixing entropy stabilizes a homogeneous solid-solution microstructure in HEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A homogeneous solid-solution microstructure promotes controlled, preferential outward diffusion of Cr and/or Al.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Selective outward diffusion of Cr and/or Al drives formation and maintenance of a continuous protective Cr2O3 or Al2O3 layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective Cr2O3 or Al2O3 scales enhance high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "High mixing entropy confers low compositional segregation in the proposed homogenized HEA.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High mixing entropy creates reduced-segregation, controlled diffusion pathways.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High mixing entropy reduces random interdiffusion among alloying elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromium can diffuse outward faster than oxygen diffuses inward, causing chromia scales to grow outward.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Selective oxidation of Al and Cr at high temperature produces Al2O3 and Cr2O3 scales in Al-containing Co-Cr-Fe-Ni HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled Cr/Al migration produces a slow-growing and continuous oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide layer can self-heal minor defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Self-healing and controlled scale growth mitigate oxide-scale spallation and reduce overall oxidation rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "HEAs optimized for mixing entropy and oxide-former balance will have more uniform and adherent scales, lower mass gain, and less spallation than baseline alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Only HEAs with enhanced mixing entropy will develop markedly improved oxide continuity and oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-entropy HEAs or conventional alloys tend to form discontinuous or non-protective oxide scales under otherwise identical conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism is applicable over 800–1200 °C in controlled oxygen atmospheres.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC10856430::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Very long high-temperature exposures can produce additional or complex oxide phases and phase instability.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Above 900 °C, volatility of CrO3 can limit the persistence of a chromia-based protective scale.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relative effects of mixing entropy and oxide-former concentration on diffusion kinetics have not been quantitatively separated.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
