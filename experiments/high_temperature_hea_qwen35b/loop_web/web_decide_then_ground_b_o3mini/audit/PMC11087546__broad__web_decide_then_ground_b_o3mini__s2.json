      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed Nb or Ti addition will overcome the usual strength–ductility trade-off and improve both properties concurrently.",
