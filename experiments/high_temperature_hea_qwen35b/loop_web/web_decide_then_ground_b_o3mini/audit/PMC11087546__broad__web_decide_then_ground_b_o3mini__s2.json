      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 1–2 at.% Nb or Ti will induce in situ nanoscale precipitation during solidification.",
