      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heterogeneous strain accommodation will increase tensile ductility.",
