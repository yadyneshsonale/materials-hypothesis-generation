  "claims": [
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr is a disordered solid solution, likely with a BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "As-cast HfMoTaTiZr has high strength at room and elevated temperatures.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction",
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is to replace 10%, 15%, or 20% of the Hf atoms with Al.",
      "field": "intervention; falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al has a significantly lower atomic mass than Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with Al reduces the alloy's average atomic mass.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reduction in average atomic mass caused by Al substitution will reduce the density of HfMoTaTiZr.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled Al substitution can retain a disordered solid solution or a similar strengthening microstructure without producing brittle intermetallic or segregated phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction",
        "PMC6982153::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion and solid-solution strengthening underlie the high mechanical properties of HfMoTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Careful Al substitution will preserve the lattice-distortion and solution-strengthening effects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preserving the strengthening microstructure will maintain room-temperature and approximately 1000 °C mechanical performance.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Al substitution is predicted to decrease density by approximately 5–10% relative to as-cast HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yield strength and ductility of the Al-substituted alloys will remain comparable to the baseline at room temperature and approximately 1000 °C.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stated applicability boundary is a homogenized, cast microstructure tested from room temperature to approximately 1000 °C under conventional tensile or compressive loading.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance at much higher temperatures or under different loading regimes is not assured.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Al may form brittle phases or cause undesirable phase transformations that impair mechanical integrity, particularly during thermal cycling near 1000 °C.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The experiment compares Al-substituted alloys against as-cast HfMoTaTiZr using density, phase, microstructure, yield-strength, and ductility measurements at room temperature and approximately 1000 °C.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is rejected if density decreases by less than 5% or if yield strength or ductility decreases by more than 10% at either test temperature.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
