      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "As-cast HfMoTaTiZr has high mechanical strength at room temperature and elevated temperatures near 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction",
        "PMC8074761::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A fraction of Hf should be replaced with Nb while retaining Mo, Ta, Ti, and Zr.",
