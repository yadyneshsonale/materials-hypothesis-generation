  "claims": [
    {
      "text": "Equiatomic FeCoNi is an fcc alloy with high saturation magnetization and low coercivity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substituting 5–10 at.% of one FeCoNi primary element with Ir can produce a FeCoNiIr high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 5–10 at.% Ir substitution can maintain configurational entropy above 1.0R.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid solidification or controlled annealing can stabilize single-phase fcc FeCoNiIr at the proposed Ir concentration.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Ir substitution will cause local lattice distortion and reduced lattice symmetry in fcc FeCoNiIr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Ir substitution may induce short-range chemical order or slight ordering tendencies.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Reduced lattice symmetry and chemical ordering favor increased magnetocrystalline anisotropy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Ir has sufficiently strong spin–orbit coupling to enhance magnetocrystalline anisotropy in FeCoNiIr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased magnetic anisotropy strengthens domain-wall pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "Stronger domain-wall pinning produces a higher coercive field.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "FeCoNiIr with 5–10 at.% Ir will have significantly higher coercivity than equiatomic FeCoNi processed under the same conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion",
        "PMC11426066::web::019::conclusion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ir-modified alloy will retain high saturation magnetization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed 5–10 at.% Ir composition remains nearly equiatomic.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is effective only while Ir remains at a minor concentration and the alloy remains single-phase and high-entropy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping Ir at 5–10 at.% will prevent a transformation to a non-fcc structure such as an L10 intermetallic phase.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
