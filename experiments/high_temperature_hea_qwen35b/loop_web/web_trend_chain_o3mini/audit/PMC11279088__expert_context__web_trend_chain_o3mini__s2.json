      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Balanced diffusion of Cr, X, and oxygen minimizes interfacial misfit stress during oxide growth.",
