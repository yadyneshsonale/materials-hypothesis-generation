      ],
      "same_system": "unclear"
    },
    {
      "text": "Combining defect physics and measurements will predict HfNbTaTiZr conductivity more accurately than perfect-crystal analytical models.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen at the 1 wt.% level creates defects that modify electronic scattering environments and carrier mobilities in HfNbTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The model will capture a nonlinear effect of oxygen-induced defects on conductivity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electrical conductivity can exhibit distinct temperature regimes associated with different conduction mechanisms.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10900490::web::013::structural_stability_of_lix_heo_at_high_",
