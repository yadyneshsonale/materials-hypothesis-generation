  "claims": [
    {
      "text": "Conventionally processed MnNiSi-based magnetic-refrigeration alloys can have a single-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline MnNiSi-based alloy has an excellent or large magnetocaloric effect.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline MnNiSi-based alloy is brittle and has poor mechanical performance.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled gradient anneal can selectively recrystallize the surface of a MnNiSi-based alloy while leaving its bulk substantially unaltered.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface-localized thermal processing can produce a gradient-structured layer with a thickness on the order of millimeters.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will produce a fine-grained, recrystallized, ductile surface layer.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated material will have a dual-phase microstructure consisting of a surface layer over an unaltered bulk magnetocaloric phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The core will retain a coarse-grained structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A coarse-grained core is necessary to retain a sharp magnetocaloric transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gradient microstructures can help overcome strength–ductility trade-offs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The recrystallized surface layer will increase resistance to crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The recrystallized surface layer will improve alloy ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Localized surface recrystallization decouples mechanical performance from the magnetic phase transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gradient-annealed samples will have greater toughness or strain to failure than untreated MnNiSi-based samples.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11012396::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Gradient-annealed samples will retain magnetic entropy change and transition characteristics comparable to the untreated alloy.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement requires recrystallization to remain confined to the surface.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive or deep recrystallization may degrade the bulk magnetocaloric response.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The expected combination of mechanical improvement and retained magnetocaloric performance should hold near the critical temperature under cyclic magnetic fields.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
