      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified TiVNbTa has a compressive strength of approximately 423 MPa at 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y2O3 modification could increase the TiVNbTa yield strength at 1273 K from approximately 330 MPa to approximately 500 MPa or more.",
