      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 nanoparticles will remain stable as pinning centers at temperatures up to 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide particles will hinder dislocation motion at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::000::abstract"
      ],
      "same_system": "no"
