      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed processing will create a uniform nanoscale Y2O3 dispersion in the BCC TiVNbTa matrix.",
