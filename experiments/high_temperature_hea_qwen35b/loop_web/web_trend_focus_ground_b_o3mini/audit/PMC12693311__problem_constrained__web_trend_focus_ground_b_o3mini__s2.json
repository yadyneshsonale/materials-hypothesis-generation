  "claims": [
    {
      "text": "The Cr16Mn16Fe16Co16Ni16P20 alloy was produced by arc melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy forms several primary non-eutectic crystalline phases during solidification.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy exhibits complex, multistep crystallization behavior.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::017::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 1–2 at.% boron is the proposed intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at.% boron will inhibit nucleation of primary crystalline phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will increase amorphous retention during cooling.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will improve the amorphous alloy's thermal stability during reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron induces chemical disorder, disrupts local atomic packing, and increases structural heterogeneity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Small boron atoms interfere with regular atomic arrangements and elevate the nucleation barrier for primary crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The elevated nucleation barrier kinetically delays crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The crystallization delay will lower the critical cooling rate required for amorphization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The crystallization delay will produce a more stable amorphous structure upon reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 52 K/s the baseline alloy develops a complex crystalline microstructure, whereas cooling at 3018 K/s reduces the number of crystalline phases.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid melt-spinning at approximately 10^5–10^6 K/s produces an amorphous baseline alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phosphorus and high mixing entropy enhance the baseline alloy's glass-forming ability during rapid cooling.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under identical processing, the boron-modified alloy will show a larger amorphous fraction and delayed or reduced DSC crystallization exotherms relative to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
