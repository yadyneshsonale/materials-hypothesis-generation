      "support": "entailed",
      "supporting_ids": [
        "PMC9498035::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al-containing scale adheres better above 900 °C in oxidative or corrosive atmospheres.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
