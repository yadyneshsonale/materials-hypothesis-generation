  "claims": [
    {
      "text": "Between 400°C and 700°C, FeNiCrCoCu coating wear resistance is primarily governed by formation and evolution of a continuous, thermally stable oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer forms preferentially along well-distributed grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-deposition annealing refines the coating microstructure and redistributes its grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::015::3_1_phase_structure_and_morphology_of_co"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing-induced microstructural refinement enhances oxide-layer formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary density and distribution mediate oxide nucleation and growth.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined microstructure promotes formation of a uniform and adherent surface oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined microstructure promotes oxide formation along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer acts as a protective tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide tribofilm reduces abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide tribofilm reduces coating delamination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed FeNiCrCoCu coating will develop a more homogeneous and stable oxide layer than the as-deposited coating during high-temperature wear.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed coating will have a lower wear rate than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed coating will have better coating–substrate adhesion than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies to wear at 400°C–700°C under high mechanical loads.",
