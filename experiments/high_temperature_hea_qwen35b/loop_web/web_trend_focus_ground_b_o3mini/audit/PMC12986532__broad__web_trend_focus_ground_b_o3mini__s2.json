      "support": "entailed",
      "supporting_ids": [
        "PMC7516662::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact creep-rate reduction and its quantitative dependence on interface spacing and chemistry are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
