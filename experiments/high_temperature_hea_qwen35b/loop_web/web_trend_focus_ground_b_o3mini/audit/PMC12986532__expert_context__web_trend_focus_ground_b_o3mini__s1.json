      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11032334::web::019::indentation_force_and_hardness"
      ],
      "same_system": "no"
    },
    {
      "text": "Modified samples will show increased localized dislocation density at multilayer interfaces.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing interfacial short-range order will alter, and is expected to increase, nanoindentation hardness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11032334::web::019::indentation_force_and_hardness"
      ],
      "same_system": "no"
