  "claims": [
    {
      "text": "A controlled minor Zr addition during synthesis will refine eutectic colony spacing.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled minor Zr addition will induce nanoscale precipitates.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-induced nanoscale precipitates will be located at phase boundaries.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed hard in-situ precipitate-like phases can contribute to a favorable combination of strength and ductility in an HEA matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9744852::web::017::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed nanoscale phase-boundary precipitates obstruct dislocation motion and thereby enhance strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9744852::web::017::results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed nanoscale precipitates provide sites for dislocation nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate-assisted dislocation nucleation will improve ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strength and ductility are traditionally difficult to improve simultaneously in structural metallic materials.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4682111::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Eutectic HEAs can achieve a balance of strength and ductility through their multiphase eutectic microstructures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline as-cast or annealed EHEA has relatively coarse eutectic colony spacing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline EHEA has a suboptimal nanoscale-precipitate distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-modified alloy will exhibit at least a 20% increase in yield strength relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Zr-modified alloy will exhibit at least a 20% improvement in ductility relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The simultaneous strength and ductility improvements will hold under room-temperature tensile loading after standard heat treatment and cooling.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
