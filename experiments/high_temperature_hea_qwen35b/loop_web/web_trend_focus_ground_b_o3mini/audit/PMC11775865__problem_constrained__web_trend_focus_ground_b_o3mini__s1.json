      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6728353::web::018::atomistic_modeling_of_hea_nanoparticles"
      ],
      "same_system": "yes"
    },
    {
      "text": "Prolonged high-temperature dwell will cause detectable local ordering or phase separation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sufficiently long high-temperature exposure allows diffusion to overcome the lattice-distortion-induced kinetic barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diffraction-peak splitting or shifting will provide a detectable signature of phase segregation or atomic ordering.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
