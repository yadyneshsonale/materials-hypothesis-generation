      "supporting_ids": [
        "PMC10466320::web::001::introduction",
        "PMC6728353::web::018::atomistic_modeling_of_hea_nanoparticles"
      ],
      "same_system": "yes"
    },
    {
      "text": "Differences in constituent atomic sizes produce severe lattice distortion in HEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Severe lattice distortion reduces atomic diffusivity in HEAs.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10466320::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced atomic diffusivity kinetically limits phase segregation and chemical ordering.",
