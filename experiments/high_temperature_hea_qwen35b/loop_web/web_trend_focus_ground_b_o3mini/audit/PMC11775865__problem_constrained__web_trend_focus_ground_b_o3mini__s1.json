      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10466320::web::001::introduction",
        "PMC10983832::web::029::discussion_and_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lattice distortion enhances the stability of a single-phase solid solution relative to phase separation or ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10983832::web::029::discussion_and_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elevated temperature normally creates a thermodynamic driving force for phase separation or ordering in these HEA nanoparticles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heating and short high-temperature dwells are typical of catalytic and thermoelectric operation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under rapid heating, HEA nanoparticles will retain a single-phase solid-solution structure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6728353::web::018::atomistic_modeling_of_hea_nanoparticles"
      ],
      "same_system": "yes"
    },
    {
      "text": "The rapid-heating stability regime extends to approximately 1923 K.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A modeled quinary HEA nanoparticle retains structural similarity from 573 to 1000 K.",
