  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Increasing trace Y content enhances the oxidation resistance of nanocrystalline FeNiCuAl-based multiprincipal-element alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y forms discrete nanoscale Y2O3 particles at the internal oxide/alloy interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interfacial Y2O3 particles pin and mechanically anchor the oxide scale, thereby limiting spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y preferentially segregates to oxide grain boundaries and the scale/alloy interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Segregated Y suppresses outward metal-cation diffusion and mitigates oxide growth stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline is a FeNiCuAl-based alloy containing major additions including Cr, Co, and Mn.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding produces a nanocrystalline structure in the alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The high grain-boundary density of the laser-cladded nanocrystalline structure accelerates formation of a continuous protective Al2O3 inner layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cr and Mn promote formation of a stable MnCr2O4/Cr2O3 outer oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified transport and interfacial pinning produce a continuous, adherent dual-layer oxide scale with inner Al2O3 and outer MnCr2O4/Cr2O3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed controlled comparison uses nominal Y additions of 0 or minimal Y, 0.1 at.%, 0.5 at.%, and 1.0 at.% while holding other composition and processing variables constant.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxidation conditions span 900–1100°C in air, with exposures such as 120 hours and 100 thermal cycles.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Y-doped alloys should have a lower parabolic oxidation-rate constant and lower mass gain than the Y-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y-doped alloys should form more continuous and adherent oxide scales than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "Y-doped samples should exhibit higher interfacial fracture energy and higher critical load than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y-free baseline typically develops less stable scales, faster oxidation kinetics, and greater scale spallation.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism is expected to hold in air at approximately 900–1100°C under thermal cycling.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::004::1_introduction",
        "PMC13208696::web::024::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
