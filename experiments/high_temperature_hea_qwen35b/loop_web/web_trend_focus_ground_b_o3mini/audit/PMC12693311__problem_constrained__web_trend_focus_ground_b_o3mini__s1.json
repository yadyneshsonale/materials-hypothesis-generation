  "claims": [
    {
      "text": "Ultra-rapid quenching of Cr16Mn16Fe16Co16Ni16P20 by melt spinning produces a primarily amorphous structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant ultra-rapid-quenching regime has cooling rates of at least 10^4 K/s.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quenched amorphous alloy undergoes extensive primary crystallization upon reheating.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::017::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "A flash anneal immediately after ultra-rapid quenching will increase amorphous retention and thermal stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The flash anneal should use a heating ramp of 100–200 K/min.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The appropriate flash-annealing window is approximately 1200–1291 K, just below crystallization onset.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::017::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Flash annealing in this window annihilates structural defects and relaxes the amorphous matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relaxation occurs without significant atomic diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Matrix relaxation increases the effective activation-energy barrier for crystallite nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brief sub-onset heating stabilizes short-range order in the amorphous alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stabilized short-range order kinetically hinders nucleation and growth of primary crystalline phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing primary-phase nucleation and growth limits multistep crystallization during subsequent thermal treatment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Flash-annealed samples will have a higher glass-transition temperature than samples subjected only to ultra-rapid cooling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Flash-annealed samples will show a delayed or higher-temperature crystallization exotherm in DSC.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Flash-annealed samples will contain fewer and smaller crystalline remnants than unannealed controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heating above the proposed window or dwelling too long will promote crystallization rather than suppress it.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
