  "claims": [
    {
      "text": "Equiatomic CoCrFeMnNi is a single-phase solid-solution alloy with a favorable strength–ductility combination.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Co-free FeNiCrMn alloy is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Co-free and Co-containing alloys have similar grain sizes and processing histories.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing Co from CoCrFeMnNi changes the stacking-fault energy of the resulting FeNiCrMn alloy.",
      "field": "hypothesis; structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault energy governs the balance between dislocation glide and deformation twinning.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8875034::web::013::3_4_stacking_fault_energy"
      ],
      "same_system": "no"
    },
    {
      "text": "Co removal lowers the energy barrier for deformation-twin nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dynamic loading, FeNiCrMn initiates deformation twinning at a lower strain than CoCrFeMnNi.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical dynamic loading, FeNiCrMn develops a higher deformation-twin density than CoCrFeMnNi.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed enhancement of twinning is strongest at low temperature and/or high strain rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More extensive deformation twinning enhances strain hardening.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More extensive deformation twinning delays plastic localization or instability.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to CoCrFeMnNi, FeNiCrMn will exhibit increased flow stress under identical test conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to CoCrFeMnNi, FeNiCrMn will exhibit greater strain hardening and extended ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The twin-mediated mechanism gives FeNiCrMn a superior strength–ductility balance over a wide range of temperatures and strain rates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under comparable conditions, CoCrFeMnNi is predominantly dislocation-slip controlled and has later or less extensive twinning than FeNiCrMn.",
      "field": "baseline; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies from approximately 77 K to 500 K and from strain rates of 10^-3 s^-1 to 10^3 s^-1.",
      "field": "boundary; conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Outside the specified temperature and strain-rate ranges, alternative deformation mechanisms may make twinning insignificant.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in twin onset and twin-density evolution should correlate with differences in strain hardening and ductility between the alloys.",
      "field": "predicted_outcome; falsification_experiment.falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
