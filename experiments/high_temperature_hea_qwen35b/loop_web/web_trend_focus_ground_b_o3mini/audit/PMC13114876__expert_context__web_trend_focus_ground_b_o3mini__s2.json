      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract",
        "PMC12839976::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increased mechanical stress accelerates physical removal of the passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
