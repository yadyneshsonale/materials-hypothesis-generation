  "claims": [
    {
      "text": "Dynamic mechanical behavior in as-solidified Co-free FeNiCrMn is governed by a transition between dislocation glide and deformation twinning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "At high temperatures, homogeneous dislocation glide is the dominant deformation mechanism in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high strain rates, homogeneous dislocation glide is the dominant deformation mechanism in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower temperature promotes deformation twinning in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower strain rate promotes deformation twinning in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation twinning increases work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twins delay plastic instability and thereby enhance ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "The twinning-mediated increase in work hardening and ductility preserves the strength–ductility balance of FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal activation at higher temperature favors dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced temperature lowers dislocation mobility and consequently promotes twin nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing strain rate favors dislocation glide through the proposed thermal-activation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Related 3d-transition-metal high-entropy alloys have mechanical behavior sensitive to temperature, composition, strain rate, strain level, and phase transformations.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7801446::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Related CoNiCrFeMn nanowires at cryogenic temperature exhibit dislocation nucleation followed, after elongation, by activation of twinning.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "At room temperature and a standard strain rate, FeNiCrMn is expected to deform predominantly by dislocation glide with minimal twinning.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering temperature or strain rate should systematically increase twin density, work-hardening rate, and ductility and should alter yield stress and elongation relative to slip-dominated conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::web::019::3_3_superplasticity_in_ag_nws_and_conicr"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-existing defects, chemical inhomogeneity, or secondary phases can alter deformation modes and obscure the proposed transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TEM and EBSD can be used to quantify deformation-twin density and dislocation density under the tested conditions.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to observe increased twinning and corresponding work-hardening or ductility changes upon lowering temperature or strain rate would falsify the proposed mechanism transition.",
      "field": "falsification_experiment.falsification_rule",
