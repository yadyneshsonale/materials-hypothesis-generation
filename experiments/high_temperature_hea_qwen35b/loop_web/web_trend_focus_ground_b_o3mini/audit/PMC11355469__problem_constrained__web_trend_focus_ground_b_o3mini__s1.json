  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin coating with a relatively coarse grain structure on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled thermal or thermomechanical annealing treatment can refine the coating's near-surface grain size relative to the as-deposited state.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
