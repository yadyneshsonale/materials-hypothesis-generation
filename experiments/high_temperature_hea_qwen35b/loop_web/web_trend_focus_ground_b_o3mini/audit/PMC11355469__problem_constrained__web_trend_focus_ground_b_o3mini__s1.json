        "PMC9960858::web::022::4_conclusions",
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined coating will exhibit less localized and more homogeneous microscopic plastic deformation than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9960858::web::000::abstract"
      ],
      "same_system": "no"
    },
