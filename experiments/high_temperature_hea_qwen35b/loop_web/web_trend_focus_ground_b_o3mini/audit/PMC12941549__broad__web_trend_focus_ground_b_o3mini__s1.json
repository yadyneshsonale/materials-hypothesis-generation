  "claims": [
    {
      "text": "A homogeneous nanoscale dispersion of Al and Cr promotes formation of a coherent, self-healing nano-oxide layer during service.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A continuous Al- or Cr-rich oxide layer impedes oxygen ingress and reduces high-temperature oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed nano-oxide layer reduces aqueous corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interaction between the nano-oxide layer and dislocations enhances mechanical strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregation of oxide-forming elements into clusters produces discontinuous, non-protective oxides and poorer overall performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline alloy's conventional heat treatment typically produces a less uniform distribution of oxide-forming elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adjusting the Al/Cr ratio and applying tailored thermomechanical heat treatment can control segregation and promote a uniform nanoscale oxide dispersion.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095625::web::003::1_introduction",
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Exposure at 900–1100 °C and immersion in 3.5% NaCl are relevant test conditions for the stated aerospace and rail applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator is a continuous, coherent nanoscale layer composed primarily of Al2O3 and Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Optimal chemical fluctuations in the matrix accompany the protective oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A homogeneous distribution of oxide-forming elements enables in-situ formation and self-repair of the protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have a lower oxidation rate than the baseline under identical conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12348563::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have lower corrosion current density and higher polarization resistance than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10095625::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
