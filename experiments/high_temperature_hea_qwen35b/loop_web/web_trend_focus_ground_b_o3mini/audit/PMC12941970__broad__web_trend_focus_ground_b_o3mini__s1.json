      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12019924::web::003::main"
      ],
      "same_system": "no"
    },
    {
      "text": "Sliding-induced adaptation lowers interfacial shear strength and thereby lowers friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12019924::web::003::main"
      ],
      "same_system": "no"
    },
    {
      "text": "The dense composite layer protects the HEA against material loss and thereby reduces wear.",
