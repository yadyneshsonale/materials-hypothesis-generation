      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective oxide is intimately integrated with refined HEA nanostructures or two-dimensional HEA nanoflakes.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12019924::web::003::main"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A dense ZrTiO4 composite oxide layer prevents continued oxidation of AlCrTiZrMo.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid thermal shock induces dynamic amorphization in the near-surface HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid thermal shock induces grain refinement in the near-surface HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
