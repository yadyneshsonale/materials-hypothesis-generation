  "claims": [
    {
      "text": "The starting eutectic high-entropy alloy has a hierarchical dual-phase lamellar microstructure comprising soft FCC and hard B2 phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Internal boundaries in the untreated alloy act as sites for dislocation pile-ups.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pile-ups at internal interfaces generate localized stress concentrations that cause premature microcracking and brittle damage.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase-selective recrystallization can overcome the limited ductility of eutectic alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A controlled annealing treatment near the FCC solvus can selectively recrystallize the FCC lamellae while causing only recovery in B2.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The selective treatment can preserve the skeletal morphology and non-recrystallized state of the hard B2 phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The desired microstructure is a fully or partially recrystallized FCC phase embedded in a recovered, intact B2 skeletal network.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization eliminates weak internal boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Selective recrystallization improves interfacial coherency and minimizes incoherent boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Recrystallizing the FCC phase reduces microstructural heterogeneity and local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified interfacial structure alleviates dislocation pile-ups and thereby suppresses microcrack nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Maintaining the recovered B2 skeleton preserves the alloy's high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy can approach 35% uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy can maintain tensile strength at or above approximately 2 GPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treatment increases ductility while retaining or increasing strength relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract",
        "PMC9365806::web::011::psr_mechanisms"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted benefits apply under room-temperature tensile testing at conventional structural deformation rates.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
