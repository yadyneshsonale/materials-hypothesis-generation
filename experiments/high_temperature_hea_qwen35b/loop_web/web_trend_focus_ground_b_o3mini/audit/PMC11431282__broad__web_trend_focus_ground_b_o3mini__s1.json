  "claims": [
    {
      "text": "The baseline MnNiSi-based alloy has a strong magnetocaloric effect.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline MnNiSi-based alloy has insufficient mechanical strength and ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniform dispersion of nanoscale TiC at less than about 5 vol% will improve the mechanical performance of MnNiSi-based material.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::003::introduction",
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A uniform dispersion of nanoscale TiC at less than about 5 vol% will largely retain the magnetocaloric effect of MnNiSi-based material.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect should hold near the magnetic phase transition, close to room temperature, under magnetic fields typical of refrigeration applications.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale TiC particles will refine the grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC particles will pin grain boundaries.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "TiC particles will impede dislocation motion and provide dispersion strengthening.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "TiC particles are chemically inert in the MnNiSi matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement and dislocation pinning will increase yield strength.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::003::introduction",
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The TiC dispersion will increase ductility.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Particles sufficiently smaller than the magnetic domain-wall thickness should have little interaction with domain walls.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Minimizing TiC interaction with magnetic domain walls will preserve the magnetocaloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiC-containing alloy will show statistically significant improvements in mechanical properties relative to the TiC-free baseline.",
      "field": "predicted_outcome; falsification_rule",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::003::introduction",
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The magnetic entropy change of the TiC-containing alloy will decrease by less than approximately 10% relative to the baseline.",
      "field": "predicted_outcome; falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit depends on maintaining a fine, uniform TiC dispersion below a critical particle size and volume fraction.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Coarse or excessive TiC dispersoids may interact strongly with magnetic domain walls.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11469235::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Coarse or excessive TiC dispersoids may disrupt the magnetocaloric transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
