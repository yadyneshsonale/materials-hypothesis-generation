  "claims": [
    {
      "text": "Equiatomic NbMoTaW is a single-phase BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW retains high mechanical strength up to 1600 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::001::body"
      ],
      "same_system": "no"
    },
    {
      "text": "The irradiation resistance of NbMoTaW has not been experimentally verified.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti or Al is a ductilizing addition for NbMoTaW.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at% Ti or Al to NbMoTaW will induce well-distributed nanoscale precipitates or secondary-phase particles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting nanoscale particles will act as distributed ductile interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting nanoscale particles will act as irradiation-defect sinks.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoprecipitates will facilitate stress relaxation and dislocation mobility at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Facilitating stress relaxation and dislocation mobility will increase room-temperature ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed defect sinks will reduce irradiation-induced defect accumulation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed defect sinks will delay irradiation-induced amorphization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed modification will mitigate helium-energy-dependent blistering and irradiation-enhanced precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Modified NbMoTaW will have greater room-temperature elongation than untreated NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Modified NbMoTaW will accumulate fewer irradiation-induced defects and exhibit later blistering or amorphization than untreated NbMoTaW at comparable doses.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Ti or Al will preserve the high-temperature strength of NbMoTaW up to 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Ti or Al will preserve the overall BCC phase stability of NbMoTaW up to 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefits will extend from room temperature to about 1600 °C under helium-ion or heavy-ion irradiation representative of reactor environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
