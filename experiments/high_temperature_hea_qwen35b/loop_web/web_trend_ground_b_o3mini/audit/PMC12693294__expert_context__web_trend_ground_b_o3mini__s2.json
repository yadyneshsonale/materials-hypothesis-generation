  "claims": [
    {
      "text": "Cr39Co18Fe18Ni18Al7 can be homogenized or equilibrated in a high-temperature BCC state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase retention in Cr39Co18Fe18Ni18Al7 is governed by a composition-dependent free-energy threshold.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6207727::web::002::introduction",
        "PMC6393512::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Crossing the free-energy threshold causes transformation only when cooling is slow enough to provide sufficient atomic mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra",
        "PMC6393512::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid quenching minimizes atomic diffusion, whereas slow furnace cooling allows diffusion.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra"
      ],
      "same_system": "no"
    },
    {
      "text": "The controlled comparison varies cooling rate while holding composition, initial phase state, environment, and other processing parameters constant.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Transformation proceeds through atomic-scale diffusion and nucleation at grain boundaries or within grains.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Potential secondary phases include FCC phases and ordered intermetallic phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6207727::web::002::introduction",
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy composition establishes a free-energy difference between the high-temperature BCC phase and lower-energy secondary phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6207727::web::002::introduction",
        "PMC6393512::web::014::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Slow cooling provides sufficient mobility to overcome kinetic barriers and permit nucleation and growth once the free-energy drop exceeds a critical value.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra",
        "PMC6393512::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid cooling kinetically suppresses diffusion and can retain BCC despite a thermodynamic preference for transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapidly cooled Cr39Co18Fe18Ni18Al7 samples will largely retain BCC.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra"
      ],
      "same_system": "no"
    },
    {
      "text": "Slowly cooled Cr39Co18Fe18Ni18Al7 samples will contain a significant fraction of secondary phases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5043342::web::009::phase_selection_in_solid_state_phase_tra"
      ],
      "same_system": "no"
    },
    {
      "text": "An intermediate cooling rate will produce an intermediate or transitional secondary-phase fraction.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intermediate-rate baseline should consist of BCC with minor secondary phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
