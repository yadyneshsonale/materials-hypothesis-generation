  "claims": [
    {
      "text": "As-cast equimolar CoCrFeNiTi is a simple solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equimolar CoCrFeNiTi has relatively low hardness and strength.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equimolar CoCrFeNiTi has favorable ductility and machinability.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low hardness and strength of as-cast CoCrFeNiTi are caused by the absence of incipient short-range ordering or nanoscale clustering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat treatment at approximately 400–600 °C can induce short-range ordering or nanoclusters in CoCrFeNiTi without forming a secondary phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range ordered regions or nanoclusters act as obstacles to dislocation motion and strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "High configurational entropy promotes a disordered solid solution in the as-cast alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9975007::web::001::introduction",
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The disordered solid solution has high dislocation mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High dislocation mobility produces good ductility but low dislocation pinning, hardness, and strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat-treated CoCrFeNiTi will have higher hardness than the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat-treated CoCrFeNiTi will have higher yield, tensile, and compressive strength than the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Strengthening caused by induced ordering will reduce the plastic strain or ductility of CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation or growth of a full secondary phase could reduce plastic performance or introduce brittleness.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies to CoCrFeNiTi mechanical behavior from 25 °C to 600 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain structure can influence strength and post-yield behavior in high-entropy alloys.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9975007::web::001::introduction"
      ],
      "same_system": "no"
