      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quinary alloy has more short-range chemical order than its quaternary and ternary subsets.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local lattice distortions and short-range order hinder dislocation mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5314382::web::009::results_and_discussion",
        "PMC10162673::web::025::general_remarks_on_heas_subjected_to_hig"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The heterogeneous local strain field promotes branching of deformation modes, including mechanical twinning.",
