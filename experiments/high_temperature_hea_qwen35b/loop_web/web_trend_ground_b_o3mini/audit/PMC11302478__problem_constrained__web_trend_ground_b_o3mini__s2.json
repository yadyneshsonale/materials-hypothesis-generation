      "supporting_ids": [
        "PMC5314382::web::009::results_and_discussion",
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dynamic strain partitioning increases strain hardening and delays failure in the quinary alloy relative to its subsets.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quinary alloy and the compared equiatomic quaternary and ternary subsets have single-phase FCC initial microstructures after thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5321736::web::002::body"
      ],
      "same_system": "yes"
    },
    {
