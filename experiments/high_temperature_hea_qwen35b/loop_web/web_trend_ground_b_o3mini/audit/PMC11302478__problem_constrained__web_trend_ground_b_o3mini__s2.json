      "supporting_ids": [
        "PMC10144805::web::008::3_1_xrd_analysis_of_heaps"
      ],
      "same_system": "no"
    },
    {
      "text": "Quaternary and ternary subsets will have lower strain-hardening rates than the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Quaternary and ternary subsets will localize strain earlier and have lower ductility than the quinary baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced subsets will exhibit lower average lattice strain than the quinary alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced subsets will form fewer or less diverse deformation-induced twin boundaries than the quinary alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic Cr-Mn-Fe-Co-Ni has superior mechanical performance relative to its ternary and quaternary subsets.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
