  "claims": [
    {
      "text": "A minor similar-element substitution will improve glass-forming ability in phosphorus-containing high-entropy or compositionally complex alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The same substitution will improve the thermal stability of the amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvements will arise from optimization of the atomic-size distribution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions",
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "A small critical casting diameter indicates limited glass-forming ability.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "A low crystallization-onset temperature indicates poor thermal stability of the amorphous state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is to replace 5–10% of a principal metallic component with a chemically similar element having a slightly different atomic radius.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention should work when substitution reduces excessive atomic-size mismatch without promoting phase separation or crystallinity.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution will improve local atomic packing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution will reduce free volume.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The parameter δ′ is associated with atomic-size distribution, lattice distortion, and phase selection in high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Similar-element substitution will decrease δ′ and lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Decreasing lattice distortion will lower the liquidus temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreasing lattice distortion will impede nucleation during cooling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic-radius mismatch can disrupt crystalline packing and impede crystal nucleation and growth, thereby enhancing glass-forming ability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::073::feature_interpretation"
      ],
      "same_system": "no"
    },
    {
      "text": "The substituted alloy will have a larger critical casting diameter than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8911233::web::000::abstract",
        "PMC8911233::web::012::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The substituted alloy will have a higher crystallization-onset temperature than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
