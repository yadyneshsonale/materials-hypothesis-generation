      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiVNbTa alloy's yield strength falls to approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at approximately 1300 °C for 12 hours will form Ti-rich nanobands in TiVNbTa.",
