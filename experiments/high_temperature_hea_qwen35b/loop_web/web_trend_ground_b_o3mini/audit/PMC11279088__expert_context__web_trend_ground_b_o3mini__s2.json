        "PMC10384371::web::028::4_3_oxidation_in_air"
      ],
      "same_system": "no"
    },
    {
      "text": "Al has inherently slower diffusion kinetics than the relevant species in the Si- and Mn-containing variants.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
