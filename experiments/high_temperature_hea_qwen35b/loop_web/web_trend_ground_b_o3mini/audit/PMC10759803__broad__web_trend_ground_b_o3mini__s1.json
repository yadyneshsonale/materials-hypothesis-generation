  "claims": [
    {
      "text": "Adding approximately 0.1 wt% boron to a conventional refractory high-entropy alloy will improve its high-temperature mechanical capability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract",
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron addition will stabilize grain boundaries through controlled nanoprecipitates or interfacial complexions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 0.1 wt% boron will not appreciably increase alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 0.1 wt% boron will not degrade room-temperature performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron will segregate to grain boundaries in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary segregation of boron will produce beneficial complexions or finely dispersed nanoprecipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron atoms preferentially segregate to grain boundaries and thereby stabilize the interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-induced interfacial structures will impede dislocation motion at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-induced interfacial structures will reduce grain-boundary sliding at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Impeded dislocation motion and reduced grain-boundary sliding will enhance high-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Impeded dislocation motion and reduced grain-boundary sliding will enhance creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The trace boron addition will not significantly alter room-temperature deformation mechanisms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will exhibit an approximately 20–30% increase in high-temperature strength relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Alternatively, the boron-modified alloy will exhibit a corresponding reduction in creep rate relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will retain room-temperature ductility similar to that of the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will have density similar to that of the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement will hold between approximately 800 and 1200 °C under sustained and cyclic loading.",
