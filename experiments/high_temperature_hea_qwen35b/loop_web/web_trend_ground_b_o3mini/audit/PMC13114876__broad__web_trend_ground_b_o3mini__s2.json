  "claims": [
    {
      "text": "An engineered fine microstructure enables a dynamic, self-healing passive oxide film to regenerate rapidly during wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The combination of engineered microstructure and passive-film regeneration concurrently mitigates mechanical wear and electrochemical corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A coarse or less-optimized as-fabricated HEA forms only a partially protective and less dynamic passive film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural refinement can produce finer grains, dispersed inclusions, and tailored multiphase regions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine grains, nanoscale inclusions, and multiphase regions promote formation and continuous regeneration of a dense, adherent passive oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical wear exposes fresh alloy surfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fresh surfaces rapidly reoxidize because the engineered microstructure provides favorable oxidation kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A fine microstructure limits crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A fine microstructure minimizes defects in the passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Passive-film dynamics governed by microstructural features controls resistance to combined wear and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The engineered alloy will have a lower wear rate than an untreated matched baseline during tribocorrosion.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The engineered alloy will exhibit smaller open-circuit-potential shifts during tribocorrosion than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The engineered alloy will exhibit a lower coefficient of friction than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The engineered alloy will have a slower corrosion rate under combined tribocorrosion conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The predicted benefit should hold under moderate-to-high simultaneous mechanical and corrosive stresses.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit should fail when wear removes the passive film faster than it can regenerate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
