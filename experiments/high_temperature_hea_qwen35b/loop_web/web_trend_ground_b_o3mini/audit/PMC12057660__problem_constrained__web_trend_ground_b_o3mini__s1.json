  "claims": [
    {
      "text": "A controlled dwell just below the precursor decomposition point will increase atomic mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The increased mobility during the dwell will promote local segregation and phase separation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dwell-induced segregation will disrupt the kinetically trapped single-phase solid solution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid heating and cooling can produce a metastable single-phase high-entropy alloy nanoparticle solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Atomic diffusion is limited during the rapid synthesis process.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is a pause after mixing and before rapid cooling.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dwell temperature should be below but close to the primary precursor decomposition threshold.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dwell can be long enough to enhance diffusion without fully melting the nanoparticle precursors.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased local diffusion influences elemental redistribution and local mixing in the nanoparticle lattice.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Limited free-atom mobility can favor kinetic formation of a randomly mixed high-entropy alloy phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid cooling maintains the high-entropy single-solid-solution state by suppressing secondary-phase formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Differences among elemental diffusion rates and mixing enthalpies drive segregation once additional diffusion time is provided.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to a no-dwell rapid-quench baseline, the dwell-treated nanoparticles will exhibit distinct elemental segregation patterns.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to the baseline, the dwell-treated nanoparticles will exhibit secondary phases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the baseline, the dwell-treated nanoparticles may exhibit morphological inhomogeneity in particle size or structure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies to fixed-composition systems containing more than five noble-metal elements.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dwell must end before full melting and agglomeration occur.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is effective only in rapid thermal regimes that normally limit atomic mobility.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::027::conclusions",
        "PMC11427457::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The segregation threshold and extent will vary with elemental diffusion coefficients and local mixing enthalpies.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lack of statistically significant phase, elemental-distribution, and morphology differences between dwell and no-dwell samples would falsify the hypothesis.",
