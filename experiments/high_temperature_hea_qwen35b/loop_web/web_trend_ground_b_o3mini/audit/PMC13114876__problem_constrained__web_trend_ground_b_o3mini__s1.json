  "claims": [
    {
      "text": "The as-processed alloy has a multiphase eutectic microstructure with alternating phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The constituent phases have different corrosion resistances and oxide-formation behaviors.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::041::3_3_corrosion_properties",
        "PMC12525669::web::006::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlled thermal oxidation or chemical passivation can enhance oxide-film stability and adherence.",
