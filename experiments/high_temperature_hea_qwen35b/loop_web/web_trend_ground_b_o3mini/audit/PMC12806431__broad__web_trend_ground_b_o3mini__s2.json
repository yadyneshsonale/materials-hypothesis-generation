      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary segregation of Cr, Ni, and Mn embrittles grain boundaries and contributes to intermediate-temperature ductility loss.",
