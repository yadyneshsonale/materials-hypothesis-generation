      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Cr may also reduce associated Ni and Mn nanoclustering or segregation at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing Cr lowers the driving force for grain-boundary nanoclustering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced grain-boundary nanoclustering will improve or maintain intergranular cohesion.",
