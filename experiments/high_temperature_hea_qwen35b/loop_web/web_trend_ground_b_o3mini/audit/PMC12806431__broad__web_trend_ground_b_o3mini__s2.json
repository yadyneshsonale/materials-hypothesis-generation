      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately equiatomic Cr20Mn20Fe20Co20Ni20 alloys exhibit ductility loss at intermediate temperatures over grain sizes from 4.4 to 155 micrometers.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6897545::web::010::gb_segregation_engineering_to_enhance_du"
      ],
      "same_system": "yes"
    },
