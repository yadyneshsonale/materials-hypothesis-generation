      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6897545::web::008::nanoclustering_induced_gb_embrittlement"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reduced-Cr alloy will have higher ductility than the baseline under identical intermediate-temperature tests.",
