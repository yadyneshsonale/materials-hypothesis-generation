  "claims": [
    {
      "text": "The baseline is a conventional FeNiCrCoCu thin protective coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slightly increasing the coating's Cr content can promote formation of a stable, adherent Cr-enriched oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled pre-oxidation can promote formation of a stable, adherent Cr-enriched oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The promoted surface layer will be nanoscale, continuous, adherent, and enriched in Cr.",
