  "claims": [
    {
      "text": "The target alloy has a multiphase eutectic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Under non-wear conditions, the alloy develops an in situ protective passive film at phase boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical wear at elevated temperature disrupts the surface film at multiphase boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Film disruption exposes fresh, chemically active surfaces that are more susceptible to corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9457219::web::017::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "Wear-induced film removal initiates a positive feedback loop between corrosion and wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Potential differences between the constituent phases cause galvanic corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The interphase galvanic corrosion is accelerated and localized at the exposed multiphase interfaces.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Corrosion weakens the surface so that it becomes more prone to mechanical removal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rupture of a surface oxide film can lead to adhesive and abrasive wear in a multiphase HEA coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Simultaneous wear and corrosion produce significantly greater total degradation than corrosion without wear.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Simultaneous wear increases the corrosion rate relative to the no-wear control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-induced loss of surface integrity increases the wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The no-wear baseline maintains an intact passive film during elevated-temperature chloride exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism dominates in a temperature range that permits both robust film formation and rapid film breakdown.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism requires a mechanical load sufficient to remove the film at phase interfaces.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aggressive chloride ions drive the proposed localized corrosion process.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12156342::web::000::abstract",
        "PMC9457219::web::017::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective films lower corrosion current density in chloride solution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9457219::web::017::3_5_1_potentiodynamic_polarization_studi"
      ],
      "same_system": "no"
    },
    {
      "text": "Changes in alloy composition or microstructure can alter passive-film resilience and the resulting synergistic degradation.",
