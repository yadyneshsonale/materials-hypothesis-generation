  "claims": [
    {
      "text": "Synchronizing the reduction kinetics of noble-metal precursors produces a uniform atomic pool during nanoparticle nucleation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A uniform atomic pool promotes homogeneous HEA nanoparticles rather than phase-separated, core-shell, or segregated structures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed starting material is a homogeneous solution of at least five noble-metal precursors with ligands in a solvent.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing precursor ligand environments can align the reduction kinetics of different precursors.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled dropwise addition can align precursor atom generation during the steady state.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The controlled comparison holds temperature, solvent, concentration, and overall reaction environment constant while changing reduction synchronization.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The time-resolved steady state of atomic deposition controls atomic intermixing and localized concentration gradients during nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fast, synchronized reduction causes a simultaneous influx of atoms from all precursors.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An atom-deposition rate greater than the surface-diffusion rate suppresses segregation and enables a dendritic solid-solution HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Asynchronous reduction causes staggered atom deposition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Staggered atom deposition facilitates elemental clustering, phase separation, or core-shell formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Synchronized reduction produces single-phase solid-solution HEA nanoparticles with uniformly distributed constituents.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Synchronized reduction produces nanoparticles with high surface-atom exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A conventional one-pot baseline with different reduction rates produces phase-separated, core-shell, or irregularly segregated nanoparticles.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::022::dropwise_synthesis_of_pd_hea_core_shell_",
        "PMC10171813::web::029::discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism applies to solution-based or low-temperature HEA syntheses in which precursor reduction kinetics can be independently controlled.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10171813::web::029::discussion",
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The mechanism may not apply to high-temperature shock or microwave routes because rapid thermal profiles dominate and individual precursor kinetics are difficult to control.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The quantitative relationship between kinetic synchronization and phase homogeneity is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
