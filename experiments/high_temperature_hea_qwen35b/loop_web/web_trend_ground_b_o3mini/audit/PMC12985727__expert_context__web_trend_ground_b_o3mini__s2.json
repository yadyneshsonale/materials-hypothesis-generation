      ],
      "same_system": "no"
    },
    {
      "text": "Mo addition will induce short-range ordering in the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo atoms create local lattice distortions in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-induced lattice distortion facilitates nanoscale precipitation or enhances short-range ordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine precipitates or short-range order impede dislocation motion and thereby strengthen the alloy at elevated temperature.",
