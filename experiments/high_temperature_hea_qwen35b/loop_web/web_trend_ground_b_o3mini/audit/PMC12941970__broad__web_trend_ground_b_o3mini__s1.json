  "claims": [
    {
      "text": "The starting material is untreated CoCrFeMnNi high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated CoCrFeMnNi alloy has a conventional microstructure and native surface oxides.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal oxidation at approximately 800 °C for 1 hour will convert the CoCrFeMnNi surface into a continuous oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The thermally formed oxide layer will be dense.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The thermally formed oxide glaze will be nanostructured.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide glaze will be self-healing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide glaze will provide solid lubrication.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide glaze will minimize adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide glaze will reduce abrasive damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer will act as a protective barrier against continued surface degradation or oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer will lower shear stress at the sliding contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled thermal oxidation will simultaneously decrease friction and material loss relative to the untreated alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated CoCrFeMnNi typically has a coefficient of friction around 0.3 under the proposed conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated CoCrFeMnNi alloy could exhibit a coefficient of friction below 0.1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The treatment will significantly reduce wear rate relative to untreated CoCrFeMnNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The reductions in both friction and wear will persist from ambient temperature through 600–800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effective performance depends on formation and retention of a uniform, mechanically stable oxide layer.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC9960858::web::017::3_4_worn_track_morphology_and_wear_mecha"
      ],
      "same_system": "no"
    },
    {
      "text": "A fractured oxide or glaze layer can increase wear and reduce wear resistance.",
      "field": "boundary",
