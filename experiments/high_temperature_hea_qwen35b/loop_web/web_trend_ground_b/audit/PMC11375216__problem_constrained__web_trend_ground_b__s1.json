        "PMC8658560::web::003::1_introduction",
        "PMC10728133::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Learning such patterns will produce more accurate conductivity predictions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Existing analytical approaches have limited predictive accuracy.",
