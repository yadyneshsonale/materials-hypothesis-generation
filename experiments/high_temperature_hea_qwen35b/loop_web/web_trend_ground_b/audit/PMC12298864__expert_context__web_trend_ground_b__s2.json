      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4949441::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion can impede dislocation motion, increase dislocation density, and thereby increase alloy strength and hardness.",
