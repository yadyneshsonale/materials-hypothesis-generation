  "claims": [
    {
      "text": "Phase-selective recrystallization can simultaneously increase strength and ductility in eutectic high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The target initial materials are eutectic high-entropy alloys with limited strength and ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is phase-selective recrystallization.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is intended for eutectic high-entropy alloys used as structural materials.",
      "field": "conditions",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase-selective recrystallization produces a fully recrystallized soft phase embedded in a hard-phase skeleton.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Combining a soft phase with a hard phase can provide a balance of tensile ductility and strength in eutectic high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::003::introduction",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phase-selectively recrystallized microstructure eliminates weak boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Eliminating weak boundaries fully releases the strain-hardening capacity of the duplex phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A phase-selectively recrystallized eutectic high-entropy alloy can achieve approximately 35% uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A phase-selectively recrystallized eutectic high-entropy alloy can sustain approximately 2 GPa true stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast eutectic high-entropy alloys provide the baseline and have limited ductility and strength.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9365806::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strength and ductility improvement may depend on alloy composition and processing conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::003::introduction",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The exact magnitude of the strength and ductility improvement may vary among alloys and processing conditions.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::003::introduction",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis can be tested by comparing eutectic high-entropy alloys with and without phase-selective recrystallization.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a significant improvement in both strength and ductility relative to the as-cast alloy would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
