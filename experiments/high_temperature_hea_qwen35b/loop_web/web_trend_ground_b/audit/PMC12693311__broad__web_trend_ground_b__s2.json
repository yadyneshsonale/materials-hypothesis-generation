  "claims": [
    {
      "text": "Increasing phosphorus content improves glass-forming ability in phosphorus-containing high-entropy or compositionally complex alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction",
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing phosphorus content improves the thermal stability of the amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is to increase phosphorus content relative to an otherwise comparable lower-phosphorus alloy.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant initial material may be amorphous or partially amorphous.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect should be investigated under slow cooling, accelerated cooling, and rapid quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Configurational entropy and phosphorus enrichment are the structural mediators of the proposed improvement.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation",
        "PMC11642357::web::004::1_introduction",
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher configurational entropy lowers the Gibbs free energy of the amorphous phase and favors it over crystalline phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Incorporated phosphorus disrupts crystal nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Incorporated phosphorus slows grain growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Suppression of crystal nucleation and grain growth favors amorphous structures over crystalline structures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11480990::web::072::feature_interpretation"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Suppression of nucleation and grain growth increases the thermal stability of the resulting amorphous state.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher-phosphorus alloy will have better glass-forming ability and thermal stability than a comparable lower-phosphorus alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction",
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The optimal phosphorus content and cooling-rate range are unknown.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relationship among phosphorus content, cooling rate, glass-forming ability, and thermal stability is not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction",
        "PMC11642357::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "XRD, SEM, TEM, and Mössbauer spectroscopy can be used to characterize structures produced under the tested conditions.",
      "field": "falsification_experiment.measurements",
