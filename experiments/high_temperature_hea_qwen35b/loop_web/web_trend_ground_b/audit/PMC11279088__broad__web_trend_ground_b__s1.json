  "claims": [
    {
      "text": "Alloy composition governs the development and retention of protective oxide layers on high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox",
        "PMC10384371::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The presence of Cr, Al, and Ti promotes formation of a dense protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A dense protective oxide layer provides oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior applies in oxygen-rich environments at temperatures above approximately 500 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC10384371::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Protective HEA oxide layers can contain Cr2O3, Al2O3, and TiO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox",
        "PMC11169556::web::002::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide layer acts as a barrier to further oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "yes"
    },
    {
      "text": "Outward diffusion of Cr and other alloying elements, together with inward diffusion of oxygen, forms the protective oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::002::introduction",
        "PMC10384371::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Alloy composition influences oxide-layer formation and stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::004::1_introduction",
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Alloy microstructure influences oxide-layer formation and stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective layer reduces the oxidation rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of the protective oxide layer improves high-temperature properties generally.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8468823::web::014::3_4_cross_sectional_morphology_of_the_ox"
      ],
      "same_system": "yes"
    },
    {
      "text": "Traditional Ni-Cr and Fe-Cr alloys have lower oxidation resistance than HEAs.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 500 °C, HEA oxidation behavior is significantly different from that of traditional alloys.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanism of oxide-layer formation and the effects of individual alloying elements are not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
