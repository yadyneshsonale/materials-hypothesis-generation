      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During reheating, the 2 at.% boron-modified alloy will have a higher crystallization-onset temperature than undoped Cr16Mn16Fe16Co16Ni16P20.",
