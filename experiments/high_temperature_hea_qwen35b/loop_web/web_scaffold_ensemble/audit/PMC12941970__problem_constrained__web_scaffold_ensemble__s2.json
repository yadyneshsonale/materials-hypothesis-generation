  "claims": [
    {
      "text": "Sulfur or phosphorus can function as a lubricious addition to a CoCrFeNi high-entropy-alloy matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding sulfur or phosphorus to CoCrFeNi will produce a lubricious tribofilm during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added element will react at the sliding surface to form the tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting tribofilm will reduce the coefficient of friction.",
