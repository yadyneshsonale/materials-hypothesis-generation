      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5321736::web::016::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Incipient ordering increases strain hardening and helps preserve the strength-ductility balance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The crossover between slip and twinning or ordering sustains a favorable strength-ductility balance across the tested regime.",
