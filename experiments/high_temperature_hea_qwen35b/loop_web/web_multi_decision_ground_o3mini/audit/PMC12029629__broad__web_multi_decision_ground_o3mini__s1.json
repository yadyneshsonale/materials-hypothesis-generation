      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local lattice distortion modulates dislocation core structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local lattice distortion raises the barrier to dislocation glide.",
