      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The distortion-rich variant will exhibit more rugged dislocation lines than the smoother lines expected in the homogenized baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
