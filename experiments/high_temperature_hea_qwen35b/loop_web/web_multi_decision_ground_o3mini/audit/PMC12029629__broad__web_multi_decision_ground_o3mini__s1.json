      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocations in distortion-rich HEAs propagate through rugged, extended segments that depin locally from atomic-scale heterogeneities.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10656519::web::016::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rugged dislocation propagation produces a self-adaptive network that delays strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A distortion-rich HEA will have higher dynamic yield strength than a compositionally identical homogenized baseline.",
