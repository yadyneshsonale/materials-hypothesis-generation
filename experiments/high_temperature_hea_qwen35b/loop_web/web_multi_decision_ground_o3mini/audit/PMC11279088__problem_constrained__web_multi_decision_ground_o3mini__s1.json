  "claims": [
    {
      "text": "Protective-scale stability in CrFeCoNiX alloys is governed by the balance between Cr/X oxidation kinetics and their relative diffusion rates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe",
