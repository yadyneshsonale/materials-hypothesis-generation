      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction",
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-modified alloy will retain adequate ductility under strains of approximately 30–40%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 2–5 at.% Mo addition will not compromise thermal conductivity or heat-transfer performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-containing NbMoTaW and NbMoTaVW refractory alloys exhibit weak temperature dependence of yield strength from 600 to 1600 °C and retain yield strength above 400 MPa at 1600 °C.",
