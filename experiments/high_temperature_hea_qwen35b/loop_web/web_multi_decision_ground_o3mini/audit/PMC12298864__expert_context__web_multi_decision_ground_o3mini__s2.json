    {
      "text": "Nanoscale chemical short-range order impedes dislocation glide in CoCrFeNiTi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range order generates local antiphase-boundary energies that confine dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate formation can contribute to alloy strengthening.",
