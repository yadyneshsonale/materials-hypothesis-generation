      "support": "entailed",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Impeding dislocation motion through the induced nanoscale structure will increase hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeding dislocation motion through the induced nanoscale structure will increase compressive yield strength.",
