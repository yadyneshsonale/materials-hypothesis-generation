  "claims": [
    {
      "text": "Applying a rapid deposition process to boride-based components will significantly improve their resistance to molten-aluminum corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated native boride surfaces provide only moderate resistance to molten-aluminum corrosion in hot-dip aluminum plating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sputtering offers a rapid means of depositing a protective film.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9959495::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A single-step sputtering process under a controlled atmosphere can directly form the proposed film on a boride substrate.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The deposited protective phase can be dense and inert, for example a CrN-like film.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hot-dip aluminum-plating exposure occurs around 660 degrees Celsius.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant hot-dip aluminum-plating environment includes reactive fluxes.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deposition treatment will produce a homogeneous, well-adhered film on the boride surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9959495::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The deposited film will act as a barrier to aluminum diffusion into the boride substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deposited film will protect the boride substrate from chemical attack by molten aluminum.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert film will inhibit direct contact between molten aluminum and the underlying boride.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inhibiting contact between molten aluminum and the boride substrate will lower the corrosion rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated components may exhibit a corrosion rate at least 50% lower than untreated boride components under identical hot-dip conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective treatment is expected to remain effective around 660 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Film nonuniformity, mechanical damage, or thermally induced damage will reduce the protection during service.",
      "field": "boundary",
