      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective surface layer will include Cu-containing or Cu-modified oxide phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10908794::web::037::microstructure_investigation"
      ],
      "same_system": "no"
