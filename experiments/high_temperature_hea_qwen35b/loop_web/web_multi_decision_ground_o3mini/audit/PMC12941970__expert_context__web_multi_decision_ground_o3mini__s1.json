  "claims": [
    {
      "text": "Untreated as-fabricated CoCrFeNi exhibits temperature-dependent friction and wear behavior.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored laser or plasma surface treatment can create a reactive precursor interface on CoCrFeNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment-induced interface will promote in situ formation and stabilization of an oxide nanocomposite layer during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8448869::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
