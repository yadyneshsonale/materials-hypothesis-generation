      "supporting_ids": [
        "PMC8448869::web::000::abstract",
        "PMC9960858::web::021::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting oxide layer will be lubricious and self-healing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide nanocomposite layer will minimize adhesive wear.",
