      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC8448869::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide nanocomposite layer will accommodate high shear stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC8448869::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface-treated CoCrFeNi will have a lower coefficient of friction than untreated CoCrFeNi from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-treated CoCrFeNi will have a lower wear rate than untreated CoCrFeNi from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC8448869::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The friction and wear improvements will persist under both low and high normal loads.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated CoCrFeNi forms only transient or non-robust oxide layers that inadequately control wide-temperature friction and wear.",
