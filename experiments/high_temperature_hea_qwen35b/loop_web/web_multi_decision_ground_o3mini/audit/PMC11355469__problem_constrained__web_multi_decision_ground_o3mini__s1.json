  "claims": [
    {
      "text": "The baseline coating is equiatomic FeNiCrCoCu.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline coating is homogeneous and single-phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated baseline has minimal elemental segregation and no induced nanoscale precipitates.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at approximately 650°C will induce moderate Cu segregation in the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing-induced Cu segregation will form nanoscale Cu-rich precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-rich precipitates will obstruct dislocation motion and enhance dislocation pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu-rich precipitates may favor nano-twinning as a secondary deformation process.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nano-twinned FeNiCrCoCu and single-crystal FeNiCrCoCu exhibit different deformation mechanisms involving dislocation nucleation and stacking faults.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10058552::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation pinning and possible nano-twinning will increase the coating's surface hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pinning and possible nano-twinning will reduce plastic deformation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing sliding-induced plastic deformation is expected to reduce material loss and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::014::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "The annealed coating will have a lower wear rate than the untreated homogeneous coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed coating will show altered microscopic deformation, evidenced by greater dislocation pinning and/or nano-twinning.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10058552::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted effects should hold during sliding at approximately 600–700°C under moderate loads.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effects may differ under significantly higher sliding loads.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10730726::web::014::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "no"
    },
    {
      "text": "The effects may differ at ambient temperature.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal degree of Cu segregation that improves wear resistance without embrittlement is not known precisely.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
