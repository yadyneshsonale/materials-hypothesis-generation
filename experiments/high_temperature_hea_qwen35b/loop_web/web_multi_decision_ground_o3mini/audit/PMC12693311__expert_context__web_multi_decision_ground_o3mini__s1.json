  "claims": [
    {
      "text": "Substituting 3–5 at.% of phosphorus with boron in Cr16Mn16Fe16Co16Ni16P20 will improve glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction",
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "no"
    },
    {
      "text": "Substituting 3–5 at.% of phosphorus with boron will improve thermal stability during reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapidly quenched Cr16Mn16Fe16Co16Ni16P20 has limited amorphous retention.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr16Mn16Fe16Co16Ni16P20 exhibits complex, multistage crystallization upon reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron has a smaller atomic radius relevant to the proposed substitution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron forms stronger, more directional bonds in the proposed alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron substitution increases atomic-size mismatch and packing frustration.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516748::web::013::3_3_micro_alloying"
      ],
      "same_system": "no"
    },
    {
      "text": "Increased size mismatch and packing frustration hinder the atomic rearrangements required for crystallization.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing phosphorus with boron increases topological frustration in the liquid.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy develops a denser and more uniformly disordered atomic structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will have a broader supercooled-liquid region than Cr16Mn16Fe16Co16Ni16P20.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will show a single, more clearly defined DSC crystallization exotherm instead of complex multistage crystallization.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron substitution will raise the onset temperature of crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-modified alloy will retain more amorphous material when quenched at rates above 10^4 K/s.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The benefit of boron substitution will be less pronounced under slow cooling.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The benefit of boron substitution will be less pronounced at excessively high reheating rates or during rapid thermal overshoots.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phosphorus additions have previously enhanced glass-forming ability in NiNbP bulk metallic glasses.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
