      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher dislocation barrier in pure tungsten causes localized deformation and lower plastic strain before failure.",
