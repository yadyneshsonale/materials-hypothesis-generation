  "claims": [
    {
      "text": "Mechanical sliding continuously disrupts or removes the passive oxide film on a high-entropy alloy surface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::013::3_4_tribocorrosion_performance_after_ann"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Passive-film removal prevents timely film reformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::013::3_4_tribocorrosion_performance_after_ann"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Failure to reform the passive film accelerates localized corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coupling wear and corrosion causes a nonlinear increase in material loss relative to wear and corrosion acting independently.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial alloy surface has an intact and stable passive oxide film.",
      "field": "material_initial_state",
