      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::018::discussion",
        "PMC8368001::web::005::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heat-treated specimens with enhanced short-range order will have lower creep rates than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat-treated specimens with enhanced short-range order will exhibit modified temperature-dependent elastic moduli relative to the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
