      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline NbTaHfTiZrV0.5 alloy is as-cast and has a predominantly disordered solid-solution microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored heat treatment can enhance short-range chemical order in a refractory high-entropy alloy without changing its overall composition.",
      "field": "intervention",
