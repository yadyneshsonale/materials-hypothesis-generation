      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::018::discussion",
        "PMC7921137::web::006::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Enhanced short-range order produces increased local lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range order and its associated lattice distortions impede edge-dislocation motion at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7921137::web::006::introduction",
        "PMC8368001::web::005::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing short-range order raises energy barriers to dislocation activity.",
