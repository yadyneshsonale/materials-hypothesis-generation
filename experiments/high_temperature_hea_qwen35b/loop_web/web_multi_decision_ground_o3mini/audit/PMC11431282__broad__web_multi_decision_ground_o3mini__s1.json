  "claims": [
    {
      "text": "Conventionally synthesized MnNiSi-based magnetic-refrigeration alloys have relatively coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These MnNiSi-based alloys exhibit a large magnetocaloric effect but poor mechanical performance such as brittleness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid, controlled post-synthesis annealing followed immediately by quenching will refine the grain structure of MnNiSi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions",
        "PMC9736672::web::027::3_4_3_effect_of_process_parameters_on_fa"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will significantly improve mechanical ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will significantly improve mechanical toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9736672::web::027::3_4_3_effect_of_process_parameters_on_fa"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed treatment will preserve the large magnetocaloric effect of the as-synthesized alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealing treatment should be performed near or slightly below the magnetocaloric transition temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment should be conducted under conditions mimicking the cyclic magnetic-field and temperature variations of practical refrigeration operation.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled annealing and rapid cooling can produce a refined grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions",
        "PMC9736672::web::027::3_4_3_effect_of_process_parameters_on_fa"
      ],
      "same_system": "no"
    },
    {
      "text": "A subtle phase transformation may reinforce ductility without altering the key magnetocaloric phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement increases grain-boundary density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased grain-boundary density creates barriers to crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement improves plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid quenching locks in the fine microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching minimizes compositional or phase changes that could compromise magnetic entropy change.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an untreated baseline, treated samples will show increased tensile elongation and toughness with reduced brittleness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9267696::web::018::4_conclusions",
        "PMC9736672::web::027::3_4_3_effect_of_process_parameters_on_fa"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to the untreated baseline, treated samples will retain similar magnetic entropy change under operating conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
