      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-quenched alloy contains metastable solid-solution domains and a dispersed intermetallic-compound network.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12299034::web::035::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermal aging causes the metastable solid solution to decompose.",
