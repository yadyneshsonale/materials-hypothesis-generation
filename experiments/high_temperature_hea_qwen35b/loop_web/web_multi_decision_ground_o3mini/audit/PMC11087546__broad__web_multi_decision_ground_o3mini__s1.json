      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging-induced nanoprecipitation can simultaneously increase strength and ductility.",
