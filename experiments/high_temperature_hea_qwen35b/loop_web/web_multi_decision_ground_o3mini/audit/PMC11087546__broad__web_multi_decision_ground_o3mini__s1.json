      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC7516913::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An aging temperature in the range of 500–600 °C is suitable for stabilizing the desired nanoprecipitates.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514937::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Vacuum-sealed processing or cooling will avoid oxidation during the treatment.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimizing aging temperature and duration can form coherent nanoprecipitates without coarsening.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514937::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The nanoprecipitates will decorate and refine the eutectic lamellae.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoprecipitates pin phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine nanoprecipitates increase yield strength through precipitation strengthening, including Orowan bowing and bypass.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "unclear"
