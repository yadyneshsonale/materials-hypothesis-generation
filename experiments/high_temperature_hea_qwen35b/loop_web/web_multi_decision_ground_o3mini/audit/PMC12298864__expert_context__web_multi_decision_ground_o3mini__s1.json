  "claims": [
    {
      "text": "The starting material is equimolar CoCrFeNiTi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equimolar CoCrFeNiTi is a disordered, single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relatively low hardness and strength of this alloy result from a scarcity of nanoscale short-range chemical order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale chemically ordered regions can act as effective dislocation-pinning sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Incipient precipitates can provide barriers to dislocation motion and strengthen an alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "A tailored intermediate-temperature thermal or thermo-mechanical treatment can induce nanoscale ordering or incipient precipitation in CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment does not alter the alloy's overall chemical composition.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lack of nanoscale ordering leaves fewer obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fewer obstacles to dislocation motion reduce hardness and yield strength while permitting favorable ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Induced nanoscale ordering or incipient precipitation will impede dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties",
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "Impeded dislocation glide will raise hardness and yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003886::web::022::3_3_2_mechanical_properties",
        "PMC7512535::web::030::5_summary"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated alloy will retain adequate ductility without a dramatic loss relative to the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will show a significant increase in hardness and yield strength at approximately 25 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will show a significant increase in hardness and yield strength at 600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is limited to treatments that do not produce new secondary bulk phases.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled comparison holds deformation rates and loading protocols constant between as-cast and treated samples.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant hardness and yield-strength increase would falsify the proposed controlling role of nanoscale ordering.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A severe treatment-induced loss of ductility would falsify the hypothesis.",
