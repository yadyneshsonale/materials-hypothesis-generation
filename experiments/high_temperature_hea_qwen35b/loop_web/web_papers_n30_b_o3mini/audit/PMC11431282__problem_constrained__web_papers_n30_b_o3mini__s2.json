      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-modified alloy will retain entropy-change and adiabatic-temperature-change metrics similar to those of the unmodified alloy.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping carbon at approximately 0.5–1 at% will avoid disturbing the caloric phase transformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
