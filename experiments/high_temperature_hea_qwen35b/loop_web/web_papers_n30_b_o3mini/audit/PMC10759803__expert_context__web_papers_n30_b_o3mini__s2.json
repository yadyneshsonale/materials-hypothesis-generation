      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing 10–30% of the Hf sublattice fraction with Al is the proposed intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of Hf by Al will reduce the density of HfMoTaTiZr.",
