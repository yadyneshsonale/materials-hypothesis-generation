      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard",
        "PMC7504593::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "CrFeCoNiSi and CrFeCoNiAl will form uniform, adherent, and coherent protective scales.",
      "field": "predicted_outcome",
