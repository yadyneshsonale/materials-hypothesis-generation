  "claims": [
    {
      "text": "The proposed system comprises CrFeCoNiX alloys with X = Si, Mn, or Al in single- or multiphase metallic solid-solution states.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Protective-scale stability above 900 °C is governed by selective chromium oxidation together with the oxidation behavior of element X.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::webcard",
        "PMC6513993::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Si forms a stable oxide under the proposed high-temperature exposure conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7504593::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Al forms a stable oxide under the proposed high-temperature exposure conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard",
        "PMC10456374::webcard",
        "PMC10820071::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxides formed by Si or Al have sufficiently low thermal-expansion mismatch to improve scale stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si- or Al-containing CrFeCoNiX alloys form an interfacial composite scale consisting of Cr2O3 with SiO2 or Al2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "A continuous chromium- and X-oxide-enriched interfacial sublayer acts as a diffusion barrier.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::webcard",
        "PMC6513993::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The composite scale retards both oxygen and cation diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::webcard",
        "PMC6513993::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The Si- or Al-bearing composite scale accommodates or relieves thermal stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8036373::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Retarded transport and thermal-stress accommodation prevent crack initiation and scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard",
        "PMC7504593::webcard",
        "PMC8036373::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Mn forms volatile or less coherent oxides than Si or Al in this alloy family.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-bearing CrFeCoNiX develops a rapidly growing scale that is more susceptible to cracking and spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
