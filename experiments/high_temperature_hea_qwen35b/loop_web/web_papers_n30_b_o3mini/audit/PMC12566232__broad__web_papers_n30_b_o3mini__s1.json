  "claims": [
    {
      "text": "Thermomechanical processing of Ti40Zr40W10Mo10 can improve ductility and uniform deformability without sacrificing strength or impact-induced energy release.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti40Zr40W10Mo10 is a dual-phase refractory high-entropy alloy with a BCC matrix and Mo-W-rich BCC precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast Ti40Zr40W10Mo10 alloy has relatively coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast Ti40Zr40W10Mo10 alloy has a heterogeneous precipitate distribution with regions of aggregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aggregation of large Mo-W-rich precipitates degrades mechanical performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "A sequence of hot rolling, cold rolling, and rapid annealing can refine the grains and produce a fine, homogeneous precipitate dispersion in this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed processing will produce coherent, ductile, nanometer-scale BCC precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniform dispersion of Mo-W-rich BCC precipitates is associated with exceptional dynamic compressive performance in Ti40Zr40W10Mo10.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Uniformly dispersed precipitates mitigate localized strain concentrations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural refinement and uniform precipitate dispersion enhance dislocation mobility and thereby promote homogeneous deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6105605::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twinning or transformation mechanisms can delay strain localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10162673::webcard",
        "PMC6105605::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Shock-induced planar defects and nanotwins can delay void coalescence.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10162673::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent precipitate-matrix interfaces relieve stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed coherent interfaces will not impede impact-induced energy release.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will significantly increase uniform elongation or plastic strain relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will retain high yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::webcard",
        "PMC6105605::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treated alloy will retain impact-induced deflagration and dynamic energy-release capability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti40Zr40W10Mo10 sustains a compressive strength of 2300 MPa at a strain rate of 3000 s−1.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti40Zr40W10Mo10 exhibits deflagration during dynamic deformation.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11767206::webcard"
      ],
      "same_system": "yes"
    },
    {
