  "claims": [
    {
      "text": "The baseline alloy is equal-atomic, single-phase BCC NbMoTaW.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW has outstanding mechanical strength at approximately 1600 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbMoTaW has poor room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The irradiation resistance of NbMoTaW has only been inferred computationally rather than demonstrated experimentally.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add approximately 5 at.% Ti to NbMoTaW and apply a controlled heat treatment.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition and heat treatment will produce nanoscale, discrete B2 precipitates in a continuous BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ti addition will lower dislocation-core energy in the modified alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower dislocation-core energy will facilitate activation of room-temperature slip systems.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Discrete B2 precipitates will act as barriers to crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Discrete B2 precipitates will act as sinks for irradiation-induced point defects and promote defect recombination and self-healing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inverted BCC-matrix/B2-precipitate microstructure can improve room-temperature compressive ductility while maintaining high yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Ti-modified NbMoTaW alloy will have greater room-temperature tensile or compressive strain to failure than pristine NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10894205::webcard",
        "PMC5995863::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-modified alloy will have lower irradiation-induced defect density, blistering, or amorphization under helium implantation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will retain yield strength comparable to pristine NbMoTaW at temperatures around 1600 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention will preserve the high melting point and BCC stability underlying the parent alloy's high-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Ti may destabilize the BCC phase or cause unwanted elevated-temperature phase transformations.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Helium fluences beyond service-relevant levels may activate other degradation mechanisms.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Ti concentration, heat-treatment schedule, quantitative property improvement, and long-term phase stability remain undetermined.",
      "field": "uncertainty",
