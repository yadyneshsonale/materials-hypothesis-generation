  "claims": [
    {
      "text": "The identity of X in CrFeCoNiX controls whether a stable protective oxide scale forms above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "X governs protective-scale formation through its effects on oxide-growth kinetics and chemistry.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al and Si diffuse more slowly and have a stronger affinity for oxygen than Mn in these alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al- and Si-containing alloys form alumina- or silica-based surface oxides, respectively.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::webcard",
        "PMC9498035::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al and Si diffuse to the alloy surface at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina- or silica-based oxides have low growth rates and develop into coherent, adherent protective layers.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent alumina- or silica-based layers limit internal oxidation and spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn diffuses faster than Al or Si under the stated exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn forms less stable and more voluminous oxides than the corresponding Al- or Si-based oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mn-based oxides produce stress accumulation that causes cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiAl and CrFeCoNiSi will form thinner, more uniform, and more adherent oxide films than CrFeCoNiMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
