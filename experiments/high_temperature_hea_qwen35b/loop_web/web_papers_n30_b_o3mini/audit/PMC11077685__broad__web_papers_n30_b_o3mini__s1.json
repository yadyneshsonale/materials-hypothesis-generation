{
  "run_id": "PMC11077685__broad__web_papers_n30_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Applying a silicide-based surface coating to MoNbTaTiW will improve its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated MoNbTaTiW alloy has a homogeneous BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide coating can be applied to MoNbTaTiW using fused slurry processing.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will provide oxidation protection in air near 1100 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will remain protective for exposures of approximately 50–200 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial coating contains an outer MSi2-rich layer and an inner M5Si3-rich layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-temperature oxidation converts the coating surface into an outer oxide layer while retaining an inner silicide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting oxide is a dense, continuous silica-rich or mixed-oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting oxide scale is robust and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale acts as a barrier that slows oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "During exposure, silicon diffuses outward to form the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating prevents internal oxidation of the alloy substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale slows subsequent degradation of the substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will have significantly lower oxidation mass gain than the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will retain better surface integrity than the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::webcard"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will reduce oxidation weight gain by roughly 50%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is effective under oxidizing conditions up to approximately 1100 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Benefits outside the stated temperature range or in non-oxidizing atmospheres are uncertain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative improvement and long-term scale stability under cyclic thermal stress are not fully determined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
