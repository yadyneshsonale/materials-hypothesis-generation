      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention replaces 5–8 at.% of the total composition's Cr with the same atomic percentage of Hf while leaving W, Ta, and V nominally unchanged.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prior W38Ta36Cr15V11 irradiation study included exposures at 1073 K up to 8 dpa.",
