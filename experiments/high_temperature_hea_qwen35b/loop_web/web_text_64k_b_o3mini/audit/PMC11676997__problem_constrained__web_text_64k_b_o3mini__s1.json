  "claims": [
    {
      "text": "The target alloy is a single-phase solid-solution high-entropy alloy with titanium and nickel as main constituents.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
