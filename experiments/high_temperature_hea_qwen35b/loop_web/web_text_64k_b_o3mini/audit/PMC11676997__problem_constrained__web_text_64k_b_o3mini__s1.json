      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Maintaining a uniform solid solution prevents disruption of beneficial solid-solution strengthening.",
