      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum arc remelting with in situ degassing or getters will substantially reduce oxygen and nitrogen contamination.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing oxygen and nitrogen will minimize interstitial-induced precipitate formation and phase segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Trace oxygen and nitrogen can promote phase segregation during thermal aging.",
