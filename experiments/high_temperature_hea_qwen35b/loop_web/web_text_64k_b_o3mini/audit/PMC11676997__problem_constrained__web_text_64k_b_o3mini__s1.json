      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Reducing oxygen and nitrogen will suppress brittle alpha-titanium or oxide precipitates at high temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower impurity content will maintain a uniform single-phase solid solution at elevated temperature.",
