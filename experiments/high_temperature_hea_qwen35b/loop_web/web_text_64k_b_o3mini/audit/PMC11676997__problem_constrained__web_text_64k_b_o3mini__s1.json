      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "An impurity-reduced matrix will exhibit greater elevated-temperature ductility than a conventionally processed matrix.",
