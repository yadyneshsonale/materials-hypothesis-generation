  "claims": [
    {
      "text": "The initial material is an as-cast HfMoTaTiZr alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a room-temperature yield strength of approximately 1600 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has an elevated-temperature yield strength of approximately 855 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A fraction of Hf should be replaced with Al, using AlₓHf₁₋ₓMoTaTiZr compositions with x approximately 0.05–0.15.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al atoms will dissolve in the BCC solid-solution matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloys will retain a single-phase BCC microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with lower-atomic-weight Al will reduce the alloy's overall mass density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al in solid solution will provide sufficient solid-solution strengthening to maintain high yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HfMoTaTiZr matrix has established severe lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion and dislocation interactions will remain effective strengthening mechanisms after Al substitution at both room temperature and 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al substitution will reduce density by approximately 10–15% relative to the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The room-temperature yield strength of the Al-substituted alloys will remain within approximately 10% of 1600 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 1000 °C yield strength of the Al-substituted alloys will remain within approximately 10% of 855 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Al substitution may destabilize the BCC phase or form intermetallic compounds that degrade ductility or elevated-temperature performance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical testing should be conducted under uniaxial tensile or compressive loading at room temperature and approximately 1000 °C at a strain rate near 1×10⁻³ s⁻¹.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 0%, 5%, 10%, and 15% Hf-replacement alloys should be produced by the same casting route and compared using density, phase, fracture-toughness, and yield-strength measurements.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is rejected if any Al-substituted alloy loses more than 10% yield strength at either room temperature or 1000 °C, or develops secondary phases that compromise ductility.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
