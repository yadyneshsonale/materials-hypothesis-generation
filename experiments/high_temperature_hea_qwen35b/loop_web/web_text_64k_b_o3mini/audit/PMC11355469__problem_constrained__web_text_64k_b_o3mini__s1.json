  "claims": [
    {
      "text": "The as-deposited FeNiCrCoCu coating has a relatively coarse, mixed microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding induces dynamic grain refinement in the near-surface region of the coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Sliding induces partial amorphization in the near-surface region of the coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Post-deposition annealing at approximately 500°C forms or enhances an ultra-nanocrystalline, partially amorphous near-surface layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultra-nanocrystalline surface layer produces inverse Hall–Petch behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The ultra-nanocrystalline, partially amorphous layer impedes dislocation motion and shear localization.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of an ultra-nanocrystalline near-surface layer lowers the friction coefficient.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation of an ultra-nanocrystalline near-surface layer improves wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined surface layer reduces wear by distributing contact stress more uniformly.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperature, sliding energy and heat facilitate dynamic structural transformation of the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inverse Hall–Petch behavior in the refined grains increases local shear strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to the as-deposited coating, the annealed coating will have a lower friction coefficient.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the as-deposited coating, the annealed coating will have a lower wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the as-deposited coating, the annealed coating will exhibit fewer and less pronounced microscopic strain bursts.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted mechanism and outcomes hold during sliding at approximately 500°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert or controlled atmosphere minimizes oxidation and mixed metal-oxide-film formation.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Significant oxidation can render the proposed refinement-mediated mechanism inactive.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
