      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::web::017::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dislocation-mediated strengthening mechanisms will remain active after replacing part of the Hf with Ti.",
