      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::017::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will retain comparable yield strength at room temperature and around 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain comparable ductility at room temperature and around 1000 °C.",
