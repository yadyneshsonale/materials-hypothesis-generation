  "claims": [
    {
      "text": "The initial material is an AlCoCrFeNi high-entropy alloy without ceramic reinforcement.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "WC can be incorporated into AlCoCrFeNi during laser cladding at additions of approximately 0.1–0.3 wt.%.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Incorporating WC into the HEA will induce a self-adaptive, tribo-reactive nanocomposite layer during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC incorporation will simultaneously reduce friction and wear across a wide service-temperature range.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention will remain effective from room temperature to approximately 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Effectiveness up to 800 °C depends on maintaining the metallurgical bond and WC-particle dispersion.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniformly distributed WC particles promote formation of a dynamic reactive tribolayer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tribolayer contains nanoscale oxides and/or WC-derived compounds.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical interaction and localized frictional heating trigger tribocatalytic reactions at the WC/HEA interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The interfacial reactions produce a lubricious nanocomposite layer in situ.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tribolayer reduces interfacial shear stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed tribolayer reduces material removal during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC reinforcement will reduce the coefficient of friction by approximately 30–50% relative to the untreated HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC reinforcement will reduce wear rate by nearly one order of magnitude relative to the untreated HEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated HEA has a higher coefficient of friction under otherwise identical test conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated material has higher wear than the WC-reinforced laser-clad material.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "WC-particle agglomeration or interface defects may impair tribolayer formation and limit self-lubrication.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
