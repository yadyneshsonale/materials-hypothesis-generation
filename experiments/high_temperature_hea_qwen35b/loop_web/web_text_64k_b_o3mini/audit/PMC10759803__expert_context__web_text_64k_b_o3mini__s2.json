  "claims": [
    {
      "text": "As-cast HfMoTaTiZr has a density of 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a room-temperature yield strength near 1600 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a yield strength of approximately 855 MPa around 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing part of Hf with Al will reduce the density of HfMoTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Al-for-Hf substitution can preserve both room-temperature and elevated-temperature yield strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al0.3Hf0.7MoTaTiZr is a candidate composition corresponding to replacement of 30% of the Hf content with Al.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will maintain a homogeneous, single-phase BCC solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al substitution will induce additional lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The atomic mass and atomic radius of Al are lower than those of Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-induced lattice distortion will help preserve the alloy's high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution strengthening provided by Mo, Ta, and Ti will remain largely unchanged after Al-for-Hf substitution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution and precipitation strengthening mechanisms will remain effective in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dislocation-controlled deformation mechanism, including a high-temperature transition from screw to edge dislocations, will persist after Al substitution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al substitution will reduce density by roughly 10–15% relative to 10.21 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's room-temperature yield strength will remain within ±10% of 1600 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's yield strength at 1000 °C will remain within ±10% of 855 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed substitution range is 0–30% replacement of the Hf content.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical performance is to be evaluated under quasi-static uniaxial loading at 298 K and 1000 °C using strain rates comparable to the baseline.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al substitution may create trade-offs in ductility or toughness.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516739::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Refractory high-entropy alloys can exhibit substantial high-temperature yield strength while suffering low plasticity.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
