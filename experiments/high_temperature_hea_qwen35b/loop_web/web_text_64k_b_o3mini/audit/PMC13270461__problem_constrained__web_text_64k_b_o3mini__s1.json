  "claims": [
    {
      "text": "The as-built Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has a supersaturated FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-built alloy contains fine, homogeneously dispersed constituents with minimal secondary-phase precipitation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prolonged aging at approximately 950–1300 K promotes nucleation and growth of Cr-rich sigma phase in the target alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Prolonged aging at approximately 950–1300 K promotes growth of Cr-rich nitride precipitates in the target alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Sigma phase preferentially localizes and coarsens at grain boundaries during elevated-temperature exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Nitride particles preferentially develop and coarsen at grain boundaries during elevated-temperature exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Enhanced atomic diffusion at elevated temperature drives formation and coarsening of sigma and nitride precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary sigma and nitride precipitates weaken intergranular cohesion and act as stress concentrators.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Accumulation of sigma and nitride precipitates reduces ductility and fracture toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9414008::web::000::abstract",
        "PMC9414008::web::008::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitate-induced intergranular embrittlement ultimately causes abrupt catastrophic failure under applied stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing conditions can accelerate phase separation through modified surface reactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under reducing conditions, precipitate evolution follows kinetics similar to those under oxidizing conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
