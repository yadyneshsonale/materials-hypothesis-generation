  "claims": [
    {
      "text": "As-cast or cold-rolled HfNbTaTiZr is single-phase BCC.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr has high lattice distortion typical of refractory high-entropy alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, HfNbTaTiZr plasticity is dominated by screw-dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::020::correction_of_the_theorical_yield_streng"
      ],
      "same_system": "no"
    },
    {
      "text": "Heating HfNbTaTiZr into the 673–1073 K range causes a transition from screw-controlled to edge-dislocation-dominated plasticity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract",
        "PMC9586648::web::020::correction_of_the_theorical_yield_streng"
      ],
      "same_system": "no"
    },
    {
      "text": "Elevated-temperature edge dislocations in HfNbTaTiZr undergo thermal super-jogging.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced atomic mobility and lattice distortion facilitate thermal super-jogging on edge dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal super-jogs act as robust obstacles to dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Super-jogged edge dislocations impede dynamic recovery.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A transition from screw- to edge-dislocation control can produce elevated-temperature plateau strength in refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9586648::web::020::correction_of_the_theorical_yield_streng"
      ],
      "same_system": "no"
    },
    {
      "text": "HfNbTaTiZr will exhibit a yield-strength plateau with low temperature sensitivity between 673 and 1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::020::correction_of_the_theorical_yield_streng"
      ],
      "same_system": "no"
    },
    {
      "text": "The prevalence of edge-dislocation features will increase in HfNbTaTiZr over the elevated-temperature regime.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The elevated-temperature dislocation transition will modify the elastic moduli of HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The dislocation transition produces elastic isotropy in elevated-temperature HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The edge-dislocation and super-jog mechanism contributes to atypical thermal expansion in HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr will have a modified thermal-expansion coefficient at 673–1073 K relative to room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using a strain rate of approximately 10^-3 s^-1 will minimize dynamic recovery effects.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below 673 K, screw-dislocation processes dominate deformation in HfNbTaTiZr.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9586648::web::020::correction_of_the_theorical_yield_streng"
      ],
      "same_system": "no"
    },
    {
      "text": "Above approximately 1073 K, precipitation or oxidation may alter the mechanical, elastic, or thermal responses.",
      "field": "boundary",
