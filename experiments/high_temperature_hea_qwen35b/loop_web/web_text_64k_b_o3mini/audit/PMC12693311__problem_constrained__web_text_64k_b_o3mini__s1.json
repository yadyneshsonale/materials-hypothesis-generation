      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The phases formed during slow cooling are non-eutectic primary phases caused by extended nucleation and growth.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
