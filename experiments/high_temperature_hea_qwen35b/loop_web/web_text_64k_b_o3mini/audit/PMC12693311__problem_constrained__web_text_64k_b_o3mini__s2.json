  "claims": [
    {
      "text": "The starting material is molten Cr16Mn16Fe16Co16Ni16P20 prepared by arc melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Melt-spinning can cool Cr16Mn16Fe16Co16Ni16P20 at approximately 10^5–10^6 K/s.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Melt-spinning at very high cooling rates produces an amorphous Cr16Mn16Fe16Co16Ni16P20 ribbon.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::018::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid cooling suppresses the multiple crystalline phases observed after slower cooling.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding a brief sub-crystallization isothermal hold after melt-spinning will stabilize the amorphous phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A cooling rate of at least 10^5 K/s is a necessary boundary for successful amorphous retention.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 960 K is the relevant crystallization-onset boundary for post-quench reheating or annealing.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "An annealing temperature around 900 K is below Tg for melt-spun Cr16Mn16Fe16Co16Ni16P20.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A brief hold at approximately 850–950 K can permit structural relaxation without triggering nucleation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ultra-rapid quenching suppresses primary-phase nucleation and growth by drastically reducing atomic diffusivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::018::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sub-crystallization annealing lowers internal stresses in the amorphous matrix without inducing crystallization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling produces a complex multiphase crystalline microstructure in Cr16Mn16Fe16Co16Ni16P20.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined melt-spinning and annealing treatment will yield a higher amorphous fraction than slower cooling routes.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::web::000::abstract",
        "PMC11642357::web::018::4_discussion",
        "PMC11642357::web::021::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined treatment will increase the crystallization-onset temperature measured during subsequent thermal analysis.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
