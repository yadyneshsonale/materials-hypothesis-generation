  "claims": [
    {
      "text": "The baseline alloy is equimolar or nearly equimolar CoCrFeNiTi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9962455::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Baseline CoCrFeNiTi is a homogeneous single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9962455::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Baseline CoCrFeNiTi has low lattice distortion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline CoCrFeNiTi contains minimal chemical short-range order and no significant nanoprecipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equimolar or nearly equimolar CoCrFeNiTi has relatively low hardness and strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The absence of short-range order and precipitates is responsible for the relatively low hardness and strength of baseline CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The absence of nanoscale obstacles allows dislocations to glide easily.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Easy dislocation glide gives baseline CoCrFeNiTi high ductility and machinability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal treatment can induce nanoscale chemical ordering or coherent nanoprecipitates in CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A minor compositional adjustment can alter the phase or microstructure and mechanical properties of CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9962455::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Induced short-range order or coherent precipitates impede dislocation motion through pinning or related obstacle strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Induced nanoscale ordering or precipitation should increase hardness and yield strength relative to untreated CoCrFeNiTi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The strengthening treatment should cause a moderate reduction in ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive ordering or precipitation could produce brittleness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed microstructural features remain relevant and stable from approximately 25 °C to 600 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Large or brittle intermetallic phases fall outside the intended regime of the hypothesis.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
