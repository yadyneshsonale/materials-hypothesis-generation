  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The identity of X governs whether CrFeCoNiX forms a stable, coherent protective oxide scale above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiAl forms a protective Al2O3-containing scale during high-temperature oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 scales grow more slowly and are more thermodynamically stable than chromia scales.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Low cation diffusivity is responsible for the slow growth of the Al2O3 scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrFeCoNiSi forms a slow-growing, adherent silica-based protective scale above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn forms porous, rapidly growing oxide scales that crack or spall.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromia commonly grows outward because chromium diffuses outward faster than oxygen diffuses inward.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At temperatures above 900 °C, chromia can produce volatile CrO3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn enhances chromium outward diffusion and thereby promotes CrO3 formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-related oxides have higher diffusion rates and greater volatility than the protective Al- or Si-based oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The balance between outward metal-cation flux and inward oxygen flux governs oxide-scale formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "Low-diffusivity Al2O3 or SiO2 limits further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Limiting oxygen ingress minimizes scale stress accumulation and produces a uniform, adherent layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical exposure, the Al- or Si-containing alloys will exhibit slower-growing, more continuous, and more adherent scales than the Mn-containing alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::web::003::introduction",
        "PMC9498035::web::011::3_1_oxidation_of_the_equiatomic_alcocrfe"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Mn-containing alloy is an appropriate less-protective baseline.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis applies to single-phase or controlled-multiphase CrFeCoNiX metallic solid solutions exposed above 900 °C in oxidative or corrosive environments.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloy chemistry, microstructure, surface heterogeneity, and phase instability can alter the resulting oxide structure.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hypothesis is falsified if Al- or Si-containing alloys show no statistically significant protective-scale advantage over the Mn-containing alloy, or if the Mn alloy develops a similarly protective scale.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
