{
  "run_id": "PMC13270461__broad__web_text_64k_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Oxidation resistance and material integrity in multiprincipal-element alloys are governed by the formation of a continuous, adherent protective oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A nanocrystalline microstructure enhances grain-boundary diffusion of oxide-forming elements such as Cr and Al.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Trace Y promotes interfacial anchoring and adhesion of the oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coarse-grained alloys lacking grain refinement and reactive elements tend to form discontinuous, non-protective Mn-rich oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract",
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mn-rich non-protective oxide formation depletes the alloy bulk and promotes degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid solidification associated with laser cladding can produce substantial grain refinement.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The high density of grain boundaries in a refined microstructure provides fast diffusion pathways for oxide-forming elements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Grain boundaries provide sites for reactive-element segregation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Enhanced transport of Cr and Al to the surface produces continuous Cr2O3 or Al2O3 scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine Y2O3 particles at the scale/alloy interface strengthen adhesion and reduce scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to a coarse-grained alloy without reactive elements, a nanocrystalline and/or Y-modified alloy will form a more continuous and adherent oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The nanocrystalline and/or Y-modified alloy will exhibit less scale spallation than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC13208696::web::025::3_6_high_temperature_oxidation_mechanism"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The nanocrystalline and/or Y-modified alloy will retain high-temperature mechanical properties better during prolonged oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should hold from approximately 700 °C to 1100 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the proposed temperature range, extreme diffusion may compromise the protective scale.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effective temperature window and optimal Y addition vary with alloy composition and environmental conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
