  "claims": [
    {
      "text": "Adding 0.25–0.5 wt% Y2O3 nanoparticles to a CoCrFeNi matrix can produce a uniformly dispersed nanoparticle-reinforced microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5706259::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The unmodified CoCrFeNi alloy is a homogeneous FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Powder-metallurgy processing can retain Y2O3 as nanoparticles in a high-entropy-alloy matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5706259::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Y2O3 nanoparticles will act as nucleation sites for nano-coupled grain structures in CoCrFeNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoparticle-reinforced microstructure will promote formation of a dense nanocrystalline oxide glaze on the worn surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "At room temperature, Y2O3 nanoparticles will impede dislocation motion and reinforce CoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5706259::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "At room temperature, the nanoparticles will promote stable shear localization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoparticle reinforcement and stable shear localization will reduce the room-temperature coefficient of friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, Y2O3 nanoparticle/matrix interfaces will catalyze tribochemical reactions that rapidly generate the glaze layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "A dense nanocrystalline glaze layer can minimize adhesive and oxidative wear at 800 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y2O3-modified CoCrFeNi alloy will maintain a consistently low coefficient of friction from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3-modified CoCrFeNi alloy will have a wear rate one to two orders of magnitude below unmodified CoCrFeNi throughout the room-temperature-to-800 °C range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract",
        "PMC5706259::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Unmodified CoCrFeNi has acceptable tribological performance at lower temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperatures, unmodified CoCrFeNi suffers surface softening, adhesive wear, and oxidative degradation that increase friction and wear.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance is expected in air from room temperature to 800 °C under normal loads and sliding velocities similar to prior evaluations.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoparticle agglomeration or nanoparticle/matrix incompatibility could impair glaze-layer formation.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
