  "claims": [
    {
      "text": "The starting material is a single-phase, undoped CoCrFeNi alloy with coarse-to-moderate grain size.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline CoCrFeNi exhibits increasing friction and wear at elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is an approximately 0.5 at.% tungsten addition to CoCrFeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::011::3_3_high_temperature_friction_and_wear_p"
      ],
      "same_system": "no"
    },
    {
      "text": "A 0.5 at.% tungsten addition will induce localized lattice distortion in CoCrFeNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::011::3_3_high_temperature_friction_and_wear_p"
      ],
      "same_system": "no"
    },
    {
      "text": "The tungsten addition will produce finely dispersed tungsten-rich precipitates at the sliding interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::011::3_3_high_temperature_friction_and_wear_p"
      ],
      "same_system": "no"
    },
    {
      "text": "The tungsten addition will promote stable tungsten-associated oxide layers at the sliding interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten-induced precipitates or oxides will form a continuous, stable, and adherent adaptive tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The adaptive tribofilm will reduce interfacial shear strength and thereby lower friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The adaptive tribofilm will reduce adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The adaptive tribofilm will suppress rapid oxidation or surface softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten-doped CoCrFeNi will maintain a friction coefficient of approximately 0.2-0.3 or lower from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten-doped CoCrFeNi will have a wear rate potentially one order of magnitude lower than undoped CoCrFeNi from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8470387::web::011::3_3_high_temperature_friction_and_wear_p"
      ],
      "same_system": "no"
    },
    {
      "text": "The friction and wear improvements will persist across varied normal loads and sliding speeds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The friction and wear improvements will persist in both ambient air and vacuum or other low-reactivity environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extreme cyclic thermal or mechanical loading may destabilize the adaptive tribofilm.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal tungsten content for long-term or cyclic tribofilm stability is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
