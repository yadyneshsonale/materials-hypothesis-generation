      "supporting_ids": [
        "PMC9586648::web::004::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention will refine the alloy's grain boundaries or grain structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
