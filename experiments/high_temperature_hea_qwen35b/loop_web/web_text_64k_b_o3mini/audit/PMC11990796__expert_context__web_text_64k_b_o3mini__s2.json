  "claims": [
    {
      "text": "The baseline alloy is equiatomic NbZrTiHfMo.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbZrTiHfMo forms a disordered BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Equiatomic NbZrTiHfMo has a room-temperature compressive yield strength of approximately 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline NbZrTiHfMo alloy has limited room-temperature plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The limited plasticity of the baseline alloy is caused by its high Mo content.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A fraction of the Mo atoms should be replaced by Nb atoms.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Mo with Nb will decrease the alloy's electronegativity difference.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Mo with Nb will reduce local bonding heterogeneity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Mo with Nb will reduce lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced bonding heterogeneity or lattice distortion will enhance dislocation mobility and facilitate dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-to-Nb substitution may improve grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Mo-to-Nb substitution will increase room-temperature compressive strain before failure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain a yield strength close to 1719 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo contributes to the room-temperature strength of refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Moderate Mo-to-Nb substitution can preserve a single-phase BCC structure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Mo reduction could diminish solid-solution strengthening and substantially reduce yield strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive Mo reduction could destabilize the BCC phase or induce additional phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Mo-to-Nb substitution fraction depends on processing details and minor composition variations.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloys with 10%, 20%, and 30% reductions in the initial Mo amount can be compared with the equiatomic baseline under identical processing and room-temperature compression conditions.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to improve ductility, a substantial strength decrease, or formation of undesirable phases would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
