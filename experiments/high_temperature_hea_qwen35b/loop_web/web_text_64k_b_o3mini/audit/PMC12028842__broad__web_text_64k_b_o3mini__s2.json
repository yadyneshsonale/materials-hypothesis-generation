      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056557::web::026::3_6_wear_resistance_test"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive TiC content can degrade wear resistance or mechanical integrity in laser-cladded coatings on Ti6Al4V.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11356081::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Poor laser-cladding parameters can cause brittleness or coating inhomogeneity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The quantitative improvements depend on laser-cladding parameters, coating thickness, and TiC concentration.",
      "field": "uncertainty",
