  "claims": [
    {
      "text": "A TiC-containing composite coating can be deposited on Ti6Al4V by laser cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11356081::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The laser-cladded coating has a titanium matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser cladding can produce uniformly dispersed TiC particles in the coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laser-cladded TiC reinforcement increases the surface hardness of Ti6Al4V relative to untreated Ti6Al4V.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11356081::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Laser-cladded TiC reinforcement increases the wear resistance of Ti6Al4V relative to untreated Ti6Al4V.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11356081::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The improvement should hold during room-temperature dry sliding ball-on-disk testing under moderate loads.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056557::web::026::3_6_wear_resistance_test"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The untreated Ti6Al4V baseline has a conventional microstructure and moderate surface hardness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention forms a well-bonded composite microstructure with evenly distributed TiC particles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC particles impede dislocation motion in the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiC particles provide load-bearing reinforcement that increases surface hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11356081::web::004::1_introduction",
        "PMC10056557::web::026::3_6_wear_resistance_test"
      ],
      "same_system": "no"
    },
    {
      "text": "TiC particles act as barriers to crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hard reinforcing particles reduce abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056557::web::026::3_6_wear_resistance_test",
        "PMC11356081::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will increase surface hardness by approximately 25–40% relative to untreated Ti6Al4V.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will reduce wear rate by approximately 50% relative to untreated Ti6Al4V.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uniform TiC dispersion is necessary for the beneficial wear response.",
