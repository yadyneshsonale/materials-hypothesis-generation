  "claims": [
    {
      "text": "A stable, nanocrystalline passive oxide film governs simultaneous wear and corrosion resistance in high-entropy alloys used in harsh environments.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled microstructural refinement using Mo and minor boron additions produces the protective passive oxide film.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003814::web::004::1_introduction",
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A refined microstructure promotes a uniform, adherent, and protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide layer limits corrosive attack by reducing ion dissolution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003814::web::004::1_introduction",
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide layer enhances wear resistance by lowering friction through improved load distribution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The representative untreated CoCrFeNiMo-based baseline has a relatively coarse-grained microstructure and lacks enhanced passive-film formation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying followed by annealing can induce grain refinement and promote formation of a coherent passive oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8305802::web::000::abstract",
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Boron microalloying can induce grain refinement and promote passive-film formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanocrystalline grains and associated lattice distortion facilitate formation of a thin, uniform, and adherent oxide film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dopant-assisted passive films may contain TiB2 or other composite oxide phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural refinement increases grain-boundary area and element homogenization, thereby promoting passive-film formation in oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The passive film inhibits corrosive-ion transport while providing a hard, low-friction surface that resists wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC10003814::web::004::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mo stabilizes the oxide film and improves passivation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003814::web::004::1_introduction",
        "PMC12525669::web::007::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Boron doping can produce beneficial precipitates that support grain refinement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Processed samples will have lower wear rates than untreated coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract",
        "PMC12565319::web::020::4_conclusions"
      ],
      "same_system": "no"
    },
    {
      "text": "Processed samples will have lower coefficients of friction than untreated coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456374::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Processed samples will have lower corrosion current densities than untreated coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12525669::web::007::1_introduction",
        "PMC12565319::web::020::4_conclusions",
        "PMC8305802::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Combined wear-corrosion degradation will be less severe than the sum of independently measured wear and corrosion contributions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective effect requires sufficient oxygen and mechanical loading low enough that the passive film can persist or reform.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism may fail under extreme wear, very high temperature, or reducing conditions that prevent passive-film stability.",
      "field": "boundary",
