  "claims": [
    {
      "text": "MoNbTaTiW is a refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated MoNbTaTiW exhibits poor high-temperature oxidation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Untreated MoNbTaTiW exhibits high oxide weight gain and scale spallation under extreme-temperature exposure in air.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Si-20Cr-20Fe coating can be prepared on MoNbTaTiW by a fused-slurry method.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deposited Si-20Cr-20Fe coating will be thin and uniform.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-20Cr-20Fe coating improves the high-temperature oxidation resistance of MoNbTaTiW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "During high-temperature oxidation, the silicide coating develops an outer oxide layer while retaining an inner silicide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating-derived oxide layer is continuous, dense, and adherent to the substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating-derived protective oxide is rich in silica and related compounds.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating-derived oxide scale acts as a diffusion barrier that slows oxygen penetration into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The surface coating reduces oxidation-induced degradation without affecting the bulk mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 10 hours at 1200 °C in ambient air, coated MoNbTaTiW will have significantly lower oxide weight gain than uncoated MoNbTaTiW.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "After 10 hours at 1200 °C in ambient air, coated MoNbTaTiW will show no catastrophic scale spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated RHEAs typically form thick, non-adherent oxide layers with substantial material loss and spallation during extended exposure at 1200 °C in air.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coating will be effective during a static or controlled-flow, 10-hour oxidation exposure at approximately 1200 °C in ambient air.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
