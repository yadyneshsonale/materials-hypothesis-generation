  "claims": [
    {
      "text": "The initial titanium- and nickel-primary alloy is a single-phase, uniform solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Each major constituent is restricted to 5–35 at%.",
      "field": "material_initial_state; conditions; boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::002::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding approximately 5 at% Mo and aging the alloy will induce fine precipitates.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-induced precipitates will be uniformly distributed through the matrix.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Aging at approximately 1050°C for 2 hours is suitable for promoting precipitate nucleation and growth in this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitate phase may be an intermetallic or sigma phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will hinder dislocation motion.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will hinder grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-added and aged alloy will have higher elevated-temperature yield strength than the unmodified, unaged baseline.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo-added and aged alloy will have better elevated-temperature creep resistance than the unmodified, unaged baseline.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature yield strength and creep resistance will improve by roughly 10–20%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is applicable over operating temperatures of approximately 1200–1600°C.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Mo or unsuitable heat treatment may produce coarse or brittle precipitates that negate the mechanical benefit.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
