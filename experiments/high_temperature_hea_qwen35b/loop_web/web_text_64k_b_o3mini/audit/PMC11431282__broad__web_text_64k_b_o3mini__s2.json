      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 3 at% Ag will not significantly alter the magnetic exchange interactions responsible for the MnNiSi magnetocaloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ag-modified alloy will have greater ductility and toughness than undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-modified alloy will have better fatigue resistance than undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-modified MnNiSi alloy will retain a magnetic entropy change comparable to that of undoped MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The beneficial trade-off is limited to Ag concentrations around 3 at%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher Ag concentrations may disturb magnetic interactions and reduce magnetocaloric performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
