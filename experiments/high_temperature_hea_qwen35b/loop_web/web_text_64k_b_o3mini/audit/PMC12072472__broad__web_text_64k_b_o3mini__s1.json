      ],
      "same_system": "yes"
    },
    {
      "text": "AlNbTiZr MEA coatings can be deposited on zirconium-alloy cladding by RF magnetron co-sputtering.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "An Al content of approximately 10 at.% is optimal among the investigated AlNbTiZr coatings for corrosion resistance and limiting oxygen penetration.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The approximately 10 at.% Al AlNbTiZr coating forms a dense oxide layer containing Nb2Zr6O17 and ZrO2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide scale formed by the coating is self-healing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled Al content promotes formation of a continuous oxide scale at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide scale is adherent to the coating and substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dense oxide layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxygen barrier slows oxidation of the underlying zirconium alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating maintains mechanical integrity and substrate adhesion while protecting the cladding.",
