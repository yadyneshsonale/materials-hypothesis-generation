      "support": "entailed",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The optimized coating produces lower oxidation weight gain than uncoated cladding or a non-optimized coating during high-temperature steam exposure.",
