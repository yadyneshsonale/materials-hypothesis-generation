      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract",
        "PMC8709257::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The approximately 10 at.% Al coating significantly reduces high-temperature steam oxidation under LOCA-like conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimized coating produces lower oxygen penetration than coatings with non-optimized Al content.",
