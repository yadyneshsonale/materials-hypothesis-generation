  "claims": [
    {
      "text": "The initial Ti-V-Nb-Ta refractory high-entropy alloy is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::003::introduction",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti-V-Nb-Ta has superior high-temperature strength and room-temperature ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial alloy has high fracture toughness.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Trace oxygen and nitrogen are initially uniformly distributed in the solid-solution matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Interstitial oxygen and nitrogen initially contribute to solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Thermal aging near 700-800 degrees Celsius can cause initially single-phase RHEAs to phase-separate and form precipitates.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Aging Ti-V-Nb-Ta at 700 degrees Celsius causes trace interstitial impurities to encourage alpha-Ti precipitation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "During elevated-temperature service, oxygen and nitrogen diffuse and segregate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxygen and nitrogen segregation lowers the nucleation barrier for second phases.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The impurity-induced phases are nanoscale precipitates located both at grain boundaries and within the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The impurity-induced secondary phases are brittle intermetallics.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates interrupt homogeneous deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates act as stress concentrators and preferential sites for brittle-crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impurity-induced precipitation reduces ductility and fracture toughness and can lead to brittle fracture.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fracture after oxygen- or nitrogen-rich aging will exhibit cleavage facets and reduced work-to-fracture.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen- or nitrogen-rich aging will produce more precipitation than matched aging under high-purity inert conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10708198::web::000::abstract",
        "PMC10708198::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Samples aged with minimal oxygen and nitrogen will largely retain their original toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen and nitrogen can accumulate further during service.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Temperatures near 700-800 degrees Celsius are relevant to potential next-generation nuclear-reactor applications of RHEAs.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10708198::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed brittle-fracture mechanism applies under cyclic or static high mechanical loads in aerospace or nuclear service.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
