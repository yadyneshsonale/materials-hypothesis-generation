  "claims": [
    {
      "text": "The as-sprayed FeNiCrCoCu coating has relatively coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-sprayed FeNiCrCoCu coating has minimal dislocation density.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-sprayed FeNiCrCoCu coating has little or no protective oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum heat treatment at about 500 °C forms fine nanotwins in the FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum heat treatment at about 500 °C increases the coating's dislocation density.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Vacuum heat treatment at about 500 °C produces a thin, adherent oxide scale enriched in Cr and Cu.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 500 °C vacuum heat treatment produces the highest microhardness among the compared heat-treatment conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A 500 °C vacuum heat treatment lowers wear rate relative to the as-sprayed condition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The wear-rate benefit of the 500 °C treatment persists during wear testing at approximately 400–900 °C under high load.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The 500 °C treatment lowers the friction coefficient relative to the as-sprayed coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanotwin formation refines the microstructure and thereby increases hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribolayer is self-healing and protects the coating during high-temperature wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined increase in hardness and protective oxide formation suppresses abrasive, adhesive, and oxidation wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adhesive, abrasive, fatigue, and oxidation wear occur in the compared as-deposited and heat-treated coatings.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9820961::web::027::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Heat treatments at 700–900 °C cause complete recrystallization and grain coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heat treatments at 700–900 °C reduce microhardness.",
