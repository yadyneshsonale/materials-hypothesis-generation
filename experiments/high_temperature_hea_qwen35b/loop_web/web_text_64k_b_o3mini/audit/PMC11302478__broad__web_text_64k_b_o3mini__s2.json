      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::000::abstract",
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation pinning by local fault-energy barriers raises the critical resolved shear stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6687833::web::003::introduction"
      ],
      "same_system": "yes"
    },
