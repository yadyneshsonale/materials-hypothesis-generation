      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10041143::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Local fault-energy fluctuations dominate the broader deformation behavior of multi-component concentrated alloys.",
