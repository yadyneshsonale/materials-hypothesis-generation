      "support": "partial",
      "supporting_ids": [
        "PMC5216361::web::020::electronic_origin_of_phase_stability_of_"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed initial Al0.1CrCoFeNi nanoalloy is a near-equimolar random solid solution.",
