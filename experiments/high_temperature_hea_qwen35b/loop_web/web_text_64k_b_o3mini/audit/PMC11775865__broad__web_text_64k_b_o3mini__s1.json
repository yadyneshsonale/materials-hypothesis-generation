      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::012::summary"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid atomic vibrations favor disorder by maximizing configurational entropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Strong pairwise enthalpic interactions can locally overcome configurational entropy and produce short-range order.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::012::summary",
        "PMC5216361::web::020::electronic_origin_of_phase_stability_of_"
      ],
      "same_system": "yes"
    },
    {
