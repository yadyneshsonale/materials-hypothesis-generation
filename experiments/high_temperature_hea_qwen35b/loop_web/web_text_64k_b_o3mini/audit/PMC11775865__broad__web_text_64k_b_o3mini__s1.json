      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::web::012::summary",
        "PMC5216361::web::020::electronic_origin_of_phase_stability_of_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing temperature favors disorder and reduces clustering strength.",
