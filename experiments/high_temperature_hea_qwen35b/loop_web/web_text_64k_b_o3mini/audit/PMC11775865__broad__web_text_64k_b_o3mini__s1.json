      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local chemical short-range order is manifested by elemental clustering, including enhanced Al-Ni pairing within nanoscale grains.",
      "field": "structural_mediator",
