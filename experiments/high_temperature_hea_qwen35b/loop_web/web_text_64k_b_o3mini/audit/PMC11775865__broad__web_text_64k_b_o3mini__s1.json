      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::012::summary",
        "PMC5216361::web::020::electronic_origin_of_phase_stability_of_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Favorable Al-Ni interactions in Al-containing alloys drive local chemical clustering or short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::web::012::summary",
        "PMC5216361::web::020::electronic_origin_of_phase_stability_of_"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al-Ni-associated short-range order can compromise a disordered single-phase state.",
