      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::005::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Suppression of dislocation slip activates grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High strain-rate specimens will exhibit more grain-boundary cavitation than coarse-grained baseline specimens.",
