  "claims": [
    {
      "text": "High strain-rate or elevated-temperature loading can induce extreme dynamic grain refinement in a single-phase compositionally complex alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::005::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dynamic refinement under such loading produces local grain-boundary amorphization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::005::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The highly deformed, refined region develops cavitation-induced nanoporosity associated with high-angle grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoporosity and cavitation reduce grain-boundary cohesive strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced grain-boundary cohesion triggers brittle intergranular decohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "This brittle process can occur without significant impurity segregation or intermetallic precipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "CoCrFeMnNi can be an initially single-phase high-entropy alloy.",
