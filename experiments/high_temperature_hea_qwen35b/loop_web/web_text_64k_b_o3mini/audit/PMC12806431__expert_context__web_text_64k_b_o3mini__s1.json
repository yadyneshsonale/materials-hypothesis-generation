      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed starting CoCrFeMnNi alloy is equiatomic, coarse-grained, and a stable solid solution suitable for demanding engineering service.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Severe sliding deformation in ultra-high vacuum can form an ultra-nanocrystalline near-surface layer in CoCrFeMnNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract",
        "PMC7311485::web::005::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "An ultra-high-vacuum environment mitigates oxidation and mixed metal-oxide film formation during sliding.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Low strain-rate deformation preserves a coarse-grained state with sustained ductility.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In sufficiently refined regions, conventional dislocation slip is suppressed.",
