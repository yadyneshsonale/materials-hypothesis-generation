  "claims": [
    {
      "text": "Equiatomic AlCoCrFeNi is a representative high-entropy-alloy base material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated AlCoCrFeNi alloy has a homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy has moderate intrinsic wear resistance and friction performance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC particles can be incorporated into AlCoCrFeNi by laser cladding to form a WC–HEA composite coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Powder metallurgy is a suitable alternative method for producing the proposed WC–HEA composite.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will produce a uniform dispersion of fine WC particles.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed WC particles increase the local hardness of the HEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC incorporation refines the grain microstructure of the HEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC incorporation facilitates formation of a continuous tribolayer composed of WC fragments and partially oxidized HEA phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC particles act as hard barriers that reduce plastic deformation and adhesion during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WC-containing tribolayer is lubricious and protective, thereby reducing friction and preventing severe wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An appropriate amount of WC reduces the friction coefficient of an HEA matrix under dry sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "WC addition substantially reduces the wear of an HEA matrix under dry sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The WC-reinforced composite will reduce both friction and wear by approximately 60–70% relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The friction and wear benefits will remain effective from room temperature to approximately 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The composite will remain effective under lightly lubricated sliding as well as dry sliding.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Tribological performance depends on selecting an appropriate WC content.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Excessive WC content or poor interfacial bonding can cause brittleness or phase segregation and negate the tribological benefits.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
