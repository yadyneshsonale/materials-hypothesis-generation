  "claims": [
    {
      "text": "Equiatomic CrCoNi has a superior strength–ductility balance compared with equiatomic CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The absence of Mn in CrCoNi enables an FCC-to-HCP transformation that is suppressed in equiatomic CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn suppresses the transformation through magnetic frustration.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC-to-HCP transformation in CrCoNi is accompanied by nanotwin formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Transformation and nanotwinning enhance strain hardening and delay failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The transformation mechanism improves strength without compromising plastic deformation despite CrCoNi having fewer constituent elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Equiatomic CrMnFeCoNi and CrCoNi can both begin as single-phase FCC solid solutions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Deformation of equiatomic CrCoNi produces a nanostructured HCP phase within the nominally FCC alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "HCP nanostructures and twin networks impede dislocation motion while accommodating plastic strain.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing Mn lowers the stacking-fault energy of CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrCoNi has an energetic preference for HCP relative to FCC that is absent or disrupted in Mn-containing CrMnFeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn raises the kinetic energy barrier for the FCC-to-HCP transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation slip and interactions with internal boundaries trigger the FCC-to-HCP transformation in CrCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Transformation-induced plasticity increases strain hardening and produces a superior strength–ductility balance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi will exhibit an earlier onset and a higher fraction of deformation-induced HCP than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract",
        "PMC5893566::web::019::dislocation_mechanisms_for_fcc_to_hcp_ph"
      ],
      "same_system": "yes"
    },
    {
      "text": "CrCoNi will exhibit greater deformation-induced twinning activity than CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to CrMnFeCoNi, CrCoNi will have higher yield and ultimate tensile strengths while retaining comparable or improved ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5893566::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted advantage of CrCoNi will be particularly strong at cryogenic temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
