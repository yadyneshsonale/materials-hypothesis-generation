      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed substitution would not significantly reduce room-temperature mechanical properties.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::page::005"
      ],
      "same_system": "no"
    },
    {
