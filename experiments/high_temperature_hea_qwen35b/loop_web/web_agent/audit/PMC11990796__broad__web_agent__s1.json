      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::004",
        "PMC8746096::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al introduced through the Al2O3 addition dissolves into the TaNbVTi matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "TiO precipitates provide precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al dissolved in the matrix provides solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 addition increases compressive yield strength relative to TaNbVTi-0 without Al2O3.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8746096::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al2O3 addition increases specific yield strength relative to TaNbVTi-0 without Al2O3.",
