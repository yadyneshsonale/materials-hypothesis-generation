      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sn addition promotes BCC-phase formation in single-phase fcc FeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512446::page::002",
        "PMC7512446::page::003",
        "PMC7512446::page::004"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing Sn content increases the BCC-phase fraction in FeCoNi(CuAl)0.8Snx.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512446::page::003",
        "PMC7512446::page::004"
      ],
      "same_system": "yes"
