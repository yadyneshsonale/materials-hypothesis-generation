      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant Sn-addition range is x = 0.02-0.10 in FeCoNi(CuAl)0.8Snx.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512446::page::002",
        "PMC7512446::page::003"
      ],
      "same_system": "yes"
