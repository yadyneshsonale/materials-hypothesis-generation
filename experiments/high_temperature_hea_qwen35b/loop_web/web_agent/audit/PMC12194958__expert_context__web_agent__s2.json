        "PMC8838456::page::005",
        "PMC8838456::page::007"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Sc-containing refractory alloys have coexisting bcc and hcp phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838456::page::005",
        "PMC8838456::page::007"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hcp phase is rich in Sc and Zr and poor in Ta and Nb.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8838456::page::007"
      ],
      "same_system": "yes"
    },
    {
      "text": "The elemental partitioning arises because Sc mixes relatively well with Zr but is strongly repelled by Nb and Ta.",
