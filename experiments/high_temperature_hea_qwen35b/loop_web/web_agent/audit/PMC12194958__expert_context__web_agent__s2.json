      "supporting_ids": [
        "PMC8838456::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed starting Hf-Nb-Ta-Ti-Zr material is in the as-cast state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Sc to refractory Hf-Nb-Ta-Ti-Zr-based alloys promotes formation of an hcp phase.",
      "field": "hypothesis",
