  "claims": [
    {
      "text": "Across CrFeCoNiX alloys with X = Si, Mn, or Al, formation of a stable, coherent protective oxide above 900 °C is governed by the preferential interactivity parameter (PIP).",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::003",
        "PMC11169556::page::004",
        "PMC11169556::page::005"
      ],
      "same_system": "unclear"
    },
    {
      "text": "PIP dictates the thermodynamic and kinetic favorability of constituent elements to oxidize.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::004",
        "PMC11169556::page::005"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed hypothesis applies to CrFeCoNiSi, CrFeCoNiMn, and CrFeCoNiAl alloys.",
      "field": "hypothesis",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::003",
        "PMC11169556::page::004"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The applicable initial material state is a single- or multiphase metallic solid solution.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::003"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is exposure above 900 °C to an oxidative or corrosive atmosphere.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant oxidation conditions are oxygen-rich environments.",
      "field": "conditions",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation produces diffusion- and redox-driven elemental gradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::004",
        "PMC11169556::page::005",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
    {
      "text": "Elemental transport during oxidation produces a layered oxide film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::005",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
    {
      "text": "The layered oxide contains a Cr-rich inner oxide.",
