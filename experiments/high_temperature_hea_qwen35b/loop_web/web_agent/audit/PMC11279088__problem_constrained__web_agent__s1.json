      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::005",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
    {
      "text": "The layered oxide contains a Mn-rich outer oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
