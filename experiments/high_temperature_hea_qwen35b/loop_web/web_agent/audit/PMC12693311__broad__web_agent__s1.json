      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect is expected under varied cooling rates, including slow cooling, accelerated cooling, and rapid melt-spinning quenching.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::page::002",
        "PMC11642357::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Configurational entropy is the structural mediator of the phosphorus effect.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::page::002",
        "PMC11642357::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phosphorus addition increases configurational entropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
