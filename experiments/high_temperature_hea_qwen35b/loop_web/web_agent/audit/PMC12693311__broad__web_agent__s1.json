      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::page::002",
        "PMC11642357::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Cooling rate influences phase composition, phase transformations, and material properties in high-entropy alloys.",
