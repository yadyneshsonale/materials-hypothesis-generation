      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11642357::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The configurational-entropy-mediated enhancement of glass formation leads to improved thermal stability of the amorphous state.",
