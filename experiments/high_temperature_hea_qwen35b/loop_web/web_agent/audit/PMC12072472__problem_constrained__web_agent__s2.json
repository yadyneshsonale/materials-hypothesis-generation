      ],
      "same_system": "yes"
    },
    {
      "text": "Elevated-temperature Cr–Zr interdiffusion causes premature failure of Cr-coated zirconium alloy.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled pre-oxidation can create a thin oxide layer specifically at the buried Cr/Zr-alloy interface.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
