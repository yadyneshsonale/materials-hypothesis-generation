      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::003"
      ],
      "same_system": "no"
    },
    {
      "text": "The hypothesis should hold from 250 to 650 °C at irradiation doses relevant to fusion reactors.",
