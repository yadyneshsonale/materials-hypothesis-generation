  "claims": [
    {
      "text": "High-temperature plastic strain and toughness in RAFM steels are governed by a combination of strengthening mechanisms.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::003",
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified thermomechanical process induces a high dislocation density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified thermomechanical process promotes a fine distribution of MC carbides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High dislocation density and finely distributed MC carbides enable simultaneous high strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial RAFM steel has nominal composition Fe-0.11C-9Cr-1.1W-0.2V-0.07Ta-0.4Mn-0.25Si-0.01Ti.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is a modified thermomechanical manufacturing route involving three stages of rolling and heat treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is intended to apply under irradiation at high operating temperatures of 550-650 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified process produces a multiscale ferrite/martensite structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified structure contains heterogeneous grain-size populations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified structure contains a fine distribution of MC carbides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The operative mechanism combines work hardening, precipitation hardening, and grain-boundary strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::003",
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified route will improve high-temperature plastic strain and toughness relative to conventional RAFM steel.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::003",
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified route will increase uniform elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::003",
        "PMC11926085::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified route will increase resistance to irradiation-induced embrittlement.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11926085::page::002",
        "PMC11926085::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional RAFM steel provides a single-phase polycrystalline baseline.",
