      "support": "entailed",
      "supporting_ids": [
        "PMC10873330::page::005"
      ],
      "same_system": "no"
    },
    {
      "text": "Feed rate and related plasma-processing parameters can affect vaporization efficiency and retained elemental ratios.",
      "field": "uncertainty",
