  "claims": [
    {
      "text": "Mechanical-property differences among equiatomic Cr-Mn-Fe-Co-Ni and its quaternary and ternary subsets are governed by stacking fault energy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456299::page::003",
        "PMC10456299::page::004"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The investigated alloys are single-phase FCC after thermomechanical processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Constituent selection and additions of B, C, and N are intervention variables.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456299::page::002",
        "PMC10456299::page::004"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed applicability range is 77 K to 673 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10456299::page::002"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stacking fault energy influences the activation of deformation mechanisms and phase transformations in FCC alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456299::page::003"
      ],
      "same_system": "no"
    },
    {
      "text": "SFE influences the balance among TRIP, deformation twinning or TWIP, and dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456299::page::003"
      ],
      "same_system": "no"
    },
    {
      "text": "Below approximately 40 mJ/m2, TRIP and deformation twinning are dominant.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456299::page::003"
      ],
      "same_system": "no"
    },
    {
      "text": "Alloys with SFE below 40 mJ/m2 will have higher strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloys with SFE below 40 mJ/m2 will have lower ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The higher strength and lower ductility at low SFE are caused by dominance of TRIP and TWIP.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation glide is typically active at high SFE.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10456299::page::003"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher-SFE alloys will have higher ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher-SFE alloys will have lower strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain size may influence the measured mechanical-property differences independently of SFE.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary cohesion may influence the measured mechanical-property differences independently of SFE.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
