  "claims": [
    {
      "text": "Whether CrFeCoNiX alloys form a stable, coherent, slow-growing protective oxide above 900 °C is governed by the preferential interactivity parameter (PIP) of their constituent elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::004"
      ],
      "same_system": "unclear"
    },
    {
      "text": "PIP predicts the speciation and spatial distribution of elements within an oxide formed on a high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::004"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant initial material may be a single- or multiphase metallic solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::003"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Exposure to an oxygen-containing oxidative or corrosive atmosphere above 900 °C produces oxide-layer formation and growth.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::005"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The preferential oxidation sequence is governed by standard reduction potential, cohesive energy density, and atomic radius.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::004",
        "PMC11169556::page::005"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Preferential oxidation and element diffusion lead to a compositionally layered oxide structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::005",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting oxide is stable, coherent, protective, and slow-growing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting oxide has a compositionally layered structure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11169556::page::002",
        "PMC11169556::page::005",
        "PMC11169556::page::006"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide surface becomes enriched in Mn, Fe, and Co.",
