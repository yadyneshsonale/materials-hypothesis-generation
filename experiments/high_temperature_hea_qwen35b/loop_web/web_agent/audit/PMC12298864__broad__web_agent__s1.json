      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001",
        "PMC10573949::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Nb to CoCrFeNi increases yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
