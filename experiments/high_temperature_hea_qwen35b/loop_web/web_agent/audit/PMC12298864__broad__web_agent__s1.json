  "claims": [
    {
      "text": "Hardness and strength in high-entropy alloys are governed by the formation of hard, brittle phases such as Laves phases.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::page::001",
        "PMC10573949::page::003"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nb has a large atomic size that produces lattice distortion in CoCrFeNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "A negative enthalpy of mixing associated with Nb promotes Laves-phase formation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Nb to CoCrFeNi changes its microstructure from single-phase FCC to an FCC-plus-Laves dual-phase structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Nb content increases the volume fraction of the Laves phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Laves phase in CoCrFeNi-Nb alloys is hard and brittle.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::001",
        "PMC10573949::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Solid-solution strengthening contributes to strengthening after Nb addition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10573949::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitation strengthening by the Nb-induced Laves phase contributes to strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::page::001",
        "PMC10573949::page::003"
      ],
      "same_system": "yes"
    },
    {
      "text": "Precipitate strengthening can increase strength and hardness through an Orowan mechanism in a related FCC entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11204598::page::001"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Nb to CoCrFeNi increases tensile strength.",
