      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9962455::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti-modified CoCrFeNi can retain a single-phase FCC structure for Ti molar ratios from 0.5 to 1.5.",
