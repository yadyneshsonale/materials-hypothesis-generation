      "support": "entailed",
      "supporting_ids": [
        "PMC9962455::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Ti addition may produce a dual-phase FCC-and-Laves structure in CoCrFeNi.",
