      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Ti addition strengthens CoCrFeNi through solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased hardness and tensile performance arise from Ti-induced lattice distortion and solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10573949::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Ti addition preserves favorable plasticity in CoCrFeNi.",
