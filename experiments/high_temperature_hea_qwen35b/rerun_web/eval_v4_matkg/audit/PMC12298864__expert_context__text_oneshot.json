      "supporting_ids": [
        "PMC9962455::web::000::abstract",
        "PMC10573949::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding Ti to CoCrFeNi increases hardness relative to unmodified CoCrFeNi.",
