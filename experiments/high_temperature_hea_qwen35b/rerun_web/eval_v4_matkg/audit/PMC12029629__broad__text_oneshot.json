      "support": "entailed",
      "supporting_ids": [
        "PMC7376180::web::024::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Superdislocation pinning strengthens the alloy relative to alloys containing only an FCC matrix and L12 precipitates.",
