      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7376180::web::000::abstract",
        "PMC7376180::web::024::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nanoscale FCC particles can pin superdislocations in the L12 precipitates.",
