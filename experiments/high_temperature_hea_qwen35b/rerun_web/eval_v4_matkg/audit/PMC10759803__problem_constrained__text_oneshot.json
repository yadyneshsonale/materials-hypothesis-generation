  "claims": [
    {
      "text": "The baseline material is as-cast HfMoTaTiZr.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of 10.21 g cm−3.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention replaces Ti with Al, producing HfMoTaAlZr from HfMoTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Ti with Al will reduce the alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8074761::web::014::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Al has a lower atomic mass than Ti.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lower atomic mass of Al relative to Ti is the mechanism by which substitution reduces density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfMoTaAlZr will form or maintain a solid-solution structure after Ti is replaced by Al.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Maintaining the solid-solution structure will maintain the alloy's mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfMoTaAlZr will not suffer a significant loss of mechanical properties relative to as-cast HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted density and mechanical-property response applies from room temperature through approximately 1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance boundary includes both compression and tension.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior work demonstrates low measured densities of approximately 5.61–5.84 g cm−3 in Al-containing Nb-Ti-V-based refractory alloys.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8074761::web::014::3_results_and_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact effect of Al substitution on mechanical properties is uncertain and requires experimental verification.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A greater than 20% reduction in yield strength or fracture strain relative to HfMoTaTiZr is defined as a significant mechanical-property loss.",
      "field": "falsification_experiment.falsification_rule",
