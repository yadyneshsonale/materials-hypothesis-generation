  "claims": [
    {
      "text": "The starting material is a refractory high-entropy alloy in an as-cast or homogenized condition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is addition of 0.1 at.% carbon to the RHEA.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding 0.1 at.% carbon promotes formation of Ta3C and Nb3C under combined high-pressure and high-temperature conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ta3C and Nb3C formed under these conditions are stable.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed effect should occur above 800 °C and above 6 GPa.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ta3C and Nb3C act as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Blocking oxygen diffusion reduces the oxidation rate of the RHEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A carbon-doped RHEA will have better high-temperature oxygen resistance than the corresponding undoped RHEA.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will reduce the oxidation rate relative to the undoped alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will increase the alloy's service lifespan.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbide stability and oxygen-barrier effectiveness depend on temperature and pressure.",
