      "support": "partial",
      "supporting_ids": [
        "PMC11203300::web::003::1_introduction",
        "PMC11396108::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The added element minimizes formation of deleterious intermetallic phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added element enhances solid-solution strengthening.",
