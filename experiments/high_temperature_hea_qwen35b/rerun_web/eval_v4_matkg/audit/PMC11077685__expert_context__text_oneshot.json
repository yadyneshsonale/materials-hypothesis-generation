      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-modified HfNbTaTiZr will have a lower oxidation rate than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-modified HfNbTaTiZr will retain or improve mechanical properties after high-temperature air exposure relative to untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mo can benefit room-temperature or elevated-temperature strength in alloys from the Hf-Mo-Nb-Ta-Ti-Zr family.",
