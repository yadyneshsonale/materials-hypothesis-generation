  "claims": [
    {
      "text": "The proposed test system is a FeNiCrCoCu coating on a Cu matrix.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
