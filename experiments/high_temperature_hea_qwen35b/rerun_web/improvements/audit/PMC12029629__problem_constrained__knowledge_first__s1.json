      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1 at.% Ti will improve the balance of strength and ductility relative to unmodified FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11767206::web::012::3_2_effect_of_w_element_on_mechanical_pr",
        "PMC10453588::web::004::1_introduction"
      ],
      "same_system": "no"
    },
    {
