      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC phase is comparatively soft and ductile.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The BCC phase is comparatively hard.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Combining a soft FCC phase with a hard BCC phase can provide a balance of strength and ductility in eutectic high-entropy alloys.",
