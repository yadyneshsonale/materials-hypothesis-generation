      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of an ultrafine-grained duplex microstructure improves the mechanical response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cold-rolling and annealing enhances the work-hardening response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cold-rolling and annealing promotes a favorable strength-ductility balance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514768::web::003::1_introduction",
        "PMC6353877::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
