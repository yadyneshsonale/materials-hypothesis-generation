  "claims": [
    {
      "text": "Applying an Al2O3 coating can improve the oxygen resistance of equiatomic cast HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Anti-oxidation coatings are required for high-temperature use of Hf-Nb-Ta-Ti-Zr-family alloys in air.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The applied coating will form a dense Al2O3 surface layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 surface layer will adhere to HfNbTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 coating will act as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen diffusion will prevent formation of a thick oxide layer on HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen diffusion will reduce the oxidation rate of HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will have a lower oxidation rate than untreated equiatomic cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will exhibit a later onset of pesting than untreated equiatomic cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will preserve useful room-temperature mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514597::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating will preserve useful high-temperature mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection is applicable in air at temperatures up to 1000 °C for exposures up to 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
