    {
      "text": "Adding a small amount of Ti can improve Co-free FeNiCrMn under dynamic loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A representative Ti addition is 1 at.%.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti addition to FeNiCrMn will form a stable L12 precipitate phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The L12 precipitates will pin dislocations.",
