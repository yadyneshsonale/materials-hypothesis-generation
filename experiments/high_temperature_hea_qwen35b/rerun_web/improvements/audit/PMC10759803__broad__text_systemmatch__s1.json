{
  "run_id": "PMC10759803__broad__text_systemmatch__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Adding less than 1 at.% Hf to an RHEA improves its high-temperature mechanical capability relative to an otherwise similar undoped RHEA.",
      "field": "hypothesis; intervention; predicted_outcome; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The small Hf addition limits the increase in alloy density.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The small Hf addition preserves room-temperature ductility.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial RHEA is an as-cast or wrought disordered solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition causes precipitation of Ni7Hf2 intermetallic compounds.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition causes precipitation of Laves phases.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-induced intermetallic precipitates act as strengthening agents.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation strengthening from Hf improves high-temperature properties without significantly reducing ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement applies under high-temperature conditions above 800 degrees Celsius.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvement remains significant up to 1000 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 1000 degrees Celsius, strengthening may diminish because the intermetallic compounds may degrade.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limited density increase combined with higher yield strength may increase specific strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "RHEAs are relevant candidate materials for high-temperature aerospace applications but can be limited by density and poor room-temperature plasticity.",
      "field": "hypothesis; conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744483::web::001::1_introduction",
        "PMC7516739::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The appropriate comparison is an undoped RHEA with similar composition and processing history.",
      "field": "baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect can be tested by comparing Hf-doped and undoped samples using high-temperature tensile tests, room-temperature ductility measurements, TEM, and XRD.",
      "field": "falsification_experiment.design; falsification_experiment.measurements",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "No significant high-temperature yield-strength improvement or a substantial room-temperature ductility loss would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
