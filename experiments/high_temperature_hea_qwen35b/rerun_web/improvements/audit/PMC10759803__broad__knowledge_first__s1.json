  "claims": [
    {
      "text": "Adding approximately 1–2 at.% boron to a refractory high-entropy alloy will improve its high-temperature mechanical capability.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant initial alloy can be represented by a refractory high-entropy alloy containing transition metals such as Cr, Mo, W, and Nb.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10179711::web::000::abstract",
        "PMC10744483::web::001::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed benefit should hold above 1000°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit should hold under high stresses relevant to jet-turbine service.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit may extend to potentially corrosive high-temperature environments.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will form boride precipitates or boron-rich phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting boride precipitates or boron-rich phases will resist high-temperature deformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The resulting boride precipitates or boron-rich phases will reduce high-temperature degradation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron will strengthen the refractory high-entropy alloy through solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron will strengthen the refractory high-entropy alloy through precipitation hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10647333::web::002::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Boron addition may improve the alloy's oxidation resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will have at least 20% greater high-temperature yield strength than the boron-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will have at least 20% greater high-temperature creep resistance than the boron-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will maintain a density below 9.5 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-containing alloy will retain room-temperature ductility above 10%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "RHEAs' high density and inferior plasticity are important limitations for aerospace use.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10744483::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
