  "claims": [
    {
      "text": "A protective CrTaO4-based oxide layer can improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is applicable to as-cast or wrought refractory high-entropy alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled oxidation can form a CrTaO4-based oxide layer on a refractory high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A coating process can form the proposed CrTaO4-based oxide layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxide-layer intervention should be effective across 1000–1100 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should operate in an oxidizing atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The CrTaO4-based oxide layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the CrTaO4-based oxide layer reduces the oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Formation of the CrTaO4-based oxide layer improves the alloy's high-temperature stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to an untreated refractory high-entropy alloy, the treated alloy will have a lower oxidation rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to an untreated alloy, the treated alloy will have an increased service lifetime.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit should persist during long-term oxidation exposure.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Alloy composition and processing conditions may affect the formation and effectiveness of the CrTaO4-based layer.",
