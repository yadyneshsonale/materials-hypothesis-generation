      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will have greater strength than the unmodified CoCrFeNiTi alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The boron-modified alloy will have improved ductility relative to the unmodified alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
