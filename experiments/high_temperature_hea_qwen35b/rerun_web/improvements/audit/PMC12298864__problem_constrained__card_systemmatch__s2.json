  "claims": [
    {
      "text": "The starting material is an equimolar or nearly equimolar CoCrFeNiTi high-entropy alloy with a simple solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of 0.1 at.% boron.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 0.1 at.% boron can overcome the alloy's strength and hardness limitation while retaining favorable mechanical characteristics.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The intervention is applicable to either an as-cast or annealed alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy can be tested at room temperature or elevated temperature.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition will induce intergranular precipitation of hexagonal close-packed borides.",
