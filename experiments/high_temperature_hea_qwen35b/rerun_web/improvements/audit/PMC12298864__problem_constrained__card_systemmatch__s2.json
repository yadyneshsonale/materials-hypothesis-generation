      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Intergranular boride precipitation will enhance grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9572892::webcard"
      ],
      "same_system": "no"
    },
    {
