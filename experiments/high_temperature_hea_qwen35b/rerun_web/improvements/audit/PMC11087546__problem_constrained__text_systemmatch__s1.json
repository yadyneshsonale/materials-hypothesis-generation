      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cryo-rolling and annealing produce or retain a hierarchical dual-phase lamellar microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
