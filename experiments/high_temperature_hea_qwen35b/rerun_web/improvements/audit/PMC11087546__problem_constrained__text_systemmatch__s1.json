      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated starting material is an as-cast eutectic high-entropy alloy with a hierarchical microstructure of dual-phase lamellar colonies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
