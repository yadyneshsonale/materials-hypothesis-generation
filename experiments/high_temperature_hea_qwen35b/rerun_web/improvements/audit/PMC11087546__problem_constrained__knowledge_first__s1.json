      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The precipitates promote dislocation cross-slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation pile-ups near internal boundaries lead to local stress concentration and microcracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Introducing nanoscale precipitates will reduce dislocation pile-ups near internal boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing boundary pile-ups will suppress microcracking and catastrophic damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::016::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The precipitate-treated alloy will retain or increase strength relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The precipitate-treated alloy will have greater tensile ductility than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy may attain a yield strength of approximately 1000 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy may attain an ultimate tensile strength of approximately 1400 MPa.",
      "field": "predicted_outcome",
