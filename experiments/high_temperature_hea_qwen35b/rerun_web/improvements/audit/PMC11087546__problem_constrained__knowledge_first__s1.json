        "PMC4145285::web::005::tensile_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is to introduce a controlled density of nanoscale precipitates within the lamellar colonies.",
      "field": "hypothesis",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoscale precipitates can be formed within a lamellar dual-phase eutectic high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed benefit applies under room-temperature uniaxial tensile loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties",
        "PMC5818523::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoscale precipitates impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The precipitates promote dislocation bowing and bypass.",
