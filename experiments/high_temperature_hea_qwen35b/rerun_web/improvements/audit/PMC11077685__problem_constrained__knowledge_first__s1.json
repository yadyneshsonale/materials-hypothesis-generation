  "claims": [
    {
      "text": "Equiatomic HfNbTaTiZr has useful room-temperature mechanical performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10453588::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Poor oxygen resistance limits the practical high-temperature use of HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Applying a ceramic coating can overcome the oxygen-resistance limitation of equiatomic HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy is initially in the cast state.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is a thin, continuous, adherent alumina or zirconia coating on the alloy surface.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed service or test temperature extends to 1000 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant atmosphere is air or another oxygen-rich environment.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant oxidation exposure duration is hours to days.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanical-loading boundary is tensile loading at strain rates from 10^-4 to 10^-2 s^-1.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ceramic coating acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing oxygen diffusion prevents formation of a thick oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preventing thick oxide formation reduces degradation of the alloy's mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will improve high-temperature oxidation resistance relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1000 °C, the coated alloy will maintain yield strength above 163 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1000 °C, the coated alloy will maintain tensile ductility above 8%.",
