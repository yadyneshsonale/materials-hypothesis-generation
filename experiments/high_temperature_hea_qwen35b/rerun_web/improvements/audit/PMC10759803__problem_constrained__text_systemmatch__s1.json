  "claims": [
    {
      "text": "The baseline material is an as-cast HfMoTaTiZr high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Hf and Ta are relatively dense elements, whereas Al and Si are lighter elements.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partially replacing Hf or Ta with Al or Si would decrease the density of HfMoTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement with Al or Si would avoid a significant loss of room-temperature mechanical properties.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement with Al or Si would avoid a significant loss of elevated-temperature mechanical properties through approximately 1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding the lighter elements would produce solid-solution strengthening in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding the lighter elements would create lattice distortion in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution strengthening and lattice distortion would maintain the alloy's strength and hardness after substitution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::web::001::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed property retention applies under both compressive and tensile loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact effect depends on replacement amount, alloy composition, and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
