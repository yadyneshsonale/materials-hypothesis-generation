      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7181682::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Doped nanoparticles will retain better catalytic performance than untreated nanoparticles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated nanoparticles will undergo significant coarsening at 773–1173 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7181682::web::001::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated nanoparticles will suffer degradation of catalytic performance at 773–1173 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide-doping intervention will be effective for nanoparticles containing at least five metals.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide-doping intervention will be effective when total noble-metal content is below 50%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
