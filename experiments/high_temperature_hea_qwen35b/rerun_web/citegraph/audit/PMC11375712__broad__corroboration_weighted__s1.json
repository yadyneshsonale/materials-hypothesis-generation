      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "node::10.1002/adem.200300567"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention is to increase the concentrations of Fe, Co, and Ni.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fe, Co, and Ni are magnetic elements.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy should remain a single-phase solid solution.",
