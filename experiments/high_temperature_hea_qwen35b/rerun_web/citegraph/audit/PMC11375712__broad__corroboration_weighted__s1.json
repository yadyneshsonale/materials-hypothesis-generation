      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1002/adem.200300567"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing the concentration of magnetic elements strengthens magnetic interactions among the elements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stronger magnetic interactions increase the energy required to reverse magnetization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An increase in the energy required for magnetization reversal produces a higher coercive field.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coercive field will increase as magnetic-element concentration increases relative to an alloy with a lower magnetic-element concentration.",
