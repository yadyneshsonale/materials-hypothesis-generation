      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "node::10.1002/adem.200300567"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The magnetic-element concentrations can be increased while retaining a high-entropy-alloy composition.",
