      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1002/adem.200300567",
        "node::10.1016/j.msea.2003.10.257"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis is expected to hold when the constituent phases have simple crystal structures.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1002/adem.200300567",
        "node::10.1016/j.msea.2003.10.257",
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "The dual-phase microstructure is the structural mediator between the intervention and the mechanical-property changes.",
