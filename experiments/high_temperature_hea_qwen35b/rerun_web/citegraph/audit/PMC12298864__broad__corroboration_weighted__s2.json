      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary hardening contributes to the expected mechanical-property improvement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation twinning can enhance strength while retaining or improving ductility in a high-entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1016/j.actamat.2013.06.018"
      ],
      "same_system": "yes"
    },
    {
      "text": "A strain-induced martensitic transformation in an FCC–HCP dual-phase high-entropy alloy can produce mechanical properties superior to a monolithic counterpart.",
