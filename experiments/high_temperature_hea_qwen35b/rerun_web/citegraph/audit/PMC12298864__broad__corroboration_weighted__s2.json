      ],
      "same_system": "yes"
    },
    {
      "text": "Introducing a dual-phase microstructure into a high-entropy alloy can increase its hardness relative to a single-phase baseline.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A dual-phase high-entropy alloy can improve strength without sacrificing useful mechanical performance, particularly ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1002/adem.200300567",
        "node::10.1016/j.msea.2003.10.257"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated initial state is a single-phase high-entropy alloy.",
