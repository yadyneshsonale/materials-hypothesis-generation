  "claims": [
    {
      "text": "The initial material is cast equiatomic HfNbTaTiZr.",
      "field": "material_initial_state/baseline",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is alloying HfNbTaTiZr with 1–2% boron.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2% boron will cause formation of a boron-rich oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A boron-rich oxide layer will improve the oxidation resistance of the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron-alloyed HfNbTaTiZr will have better oxidation resistance than untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2% boron will not compromise the useful mechanical properties of cast HfNbTaTiZr.",
      "field": "hypothesis/predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted benefit applies at 1000 °C in air for exposures up to 100 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted mechanical-performance boundary extends to loading up to 500 MPa and strain rates of approximately 10^-4–10^-2 s^-1.",
      "field": "conditions/boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "AlCoCrFeNiSix alloys have been reported to show good high-temperature strength and excellent oxidation resistance.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::10.1016/j.msea.2010.07.049"
      ],
      "same_system": "no"
    },
    {
      "text": "The exact boron content needed for optimal performance is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled comparison can be performed by exposing boron-alloyed and unalloyed specimens to air at 1000 °C for 100 hours and then tensile testing them.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
