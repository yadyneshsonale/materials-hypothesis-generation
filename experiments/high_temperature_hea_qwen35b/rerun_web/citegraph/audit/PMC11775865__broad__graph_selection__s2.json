      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is to introduce multiple principal elements to create a high-entropy alloy composition.",
      "field": "intervention",
