    {
      "text": "Improved stability will enhance the performance and longevity of the nanoalloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6728353::card::0",
        "PMC8505510::card::0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-entropy alloys are relevant to high-temperature applications.",
