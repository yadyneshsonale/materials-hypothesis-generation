{
  "run_id": "PMC11077685__broad__corroboration_weighted__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Adding yttrium to refractory high-entropy alloys can improve their high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention applies to refractory high-entropy alloys in an as-cast or wrought state.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A yttrium addition of 0.1–1.0 at.% is a suitable small-alloying range for the intervention.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is proposed for exposure at 1000–1200°C in air or oxygen.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium addition causes a protective yttrium-oxide layer to form on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added yttrium reacts with oxygen to form yttrium oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting yttrium-oxide layer is stable and adherent under the proposed exposure conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium-oxide layer inhibits further oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium-modified alloys will exhibit reduced oxidation kinetics relative to untreated alloys under identical conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium modification will increase alloy lifespan in high-temperature oxidizing environments.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improvement should be most significant above 1000°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A yttrium-oxide layer is most effective above 1000°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal yttrium concentration and the refractory alloy compositions that benefit most remain uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
