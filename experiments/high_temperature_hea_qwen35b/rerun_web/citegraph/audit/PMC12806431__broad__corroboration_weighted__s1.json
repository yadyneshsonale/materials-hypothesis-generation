      "same_system": "na"
    },
    {
      "text": "Failure of the TRIP-associated second phase to improve strength, ductility, and toughness at cryogenic temperature would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
