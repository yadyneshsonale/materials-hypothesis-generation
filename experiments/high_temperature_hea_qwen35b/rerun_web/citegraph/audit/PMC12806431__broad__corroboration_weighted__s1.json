  "claims": [
    {
      "text": "Introducing a TRIP-assisted second phase can improve resistance to thermally induced toughness loss in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial material is a high-entropy alloy with a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "TRIP can introduce or generate a second phase during deformation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed benefit should hold at cryogenic temperatures and high strains.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Deformation-induced nanotwinning is a structural mediator of the proposed benefit.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation activity mediates the deformation-induced phase transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TRIP effect produces elevated strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strain hardening caused by TRIP is continuous and steady.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "yes"
    },
    {
      "text": "A TRIP-enabled second-phase alloy will have greater cryogenic strength than an otherwise comparable single-phase alloy without TRIP.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A TRIP-enabled second-phase alloy will have greater cryogenic ductility than an otherwise comparable single-phase alloy without TRIP.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A TRIP-enabled second-phase alloy will have greater cryogenic toughness than an otherwise comparable single-phase alloy without TRIP.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant baseline is a single-phase high-entropy alloy without a TRIP effect.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The applicable temperature boundary extends from room temperature to cryogenic temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The precise interaction among TRIP, nanotwinning, and dislocation activity is not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis can be tested by comparing otherwise comparable alloys with and without the TRIP-associated second phase at cryogenic temperatures.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
