  "claims": [
    {
      "text": "Introducing a TRIP-assisted second phase can improve resistance to thermally induced toughness loss in high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial material is a high-entropy alloy with a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "TRIP can introduce a second phase into the initially single-phase alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed benefit should occur at cryogenic temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed benefit should occur at strains of approximately 20%.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Deformation nanotwinning mediates the response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation activity mediates the response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "unclear"
    },
    {
      "text": "TRIP produces continuous, steady strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to a comparable single-phase alloy without TRIP, the intervention will improve cryogenic strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to a comparable single-phase alloy without TRIP, the intervention will improve cryogenic ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/nature17981",
        "node::10.1038/ncomms10602"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to a comparable single-phase alloy without TRIP, the intervention will improve cryogenic toughness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant temperature boundary extends from room temperature to cryogenic temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1038/ncomms10602"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant strain boundary is 0–20%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
