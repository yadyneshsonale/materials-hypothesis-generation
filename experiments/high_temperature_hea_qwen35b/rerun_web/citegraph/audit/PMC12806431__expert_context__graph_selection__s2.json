      "support": "partial",
      "supporting_ids": [
        "PMC9506522::card::0"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary strengthening, suppression of impurity-induced softening, and enhanced thermal stability lead to improved toughness retention after heating.",
