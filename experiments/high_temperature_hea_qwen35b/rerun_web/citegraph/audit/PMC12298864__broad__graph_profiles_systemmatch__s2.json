      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1016/j.ijplas.2019.07.017"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial as-cast or wrought alloy has a homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing can introduce a gradient hierarchical microstructure into a high-entropy alloy.",
