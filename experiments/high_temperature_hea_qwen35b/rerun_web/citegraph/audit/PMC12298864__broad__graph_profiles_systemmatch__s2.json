      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should hold at room temperature.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement requires a composition optimized for solid-solution strengthening and precipitation hardening.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "node::10.1016/j.actamat.2014.11.014"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The gradient hierarchy consists of a mixture of harder and softer layers.",
      "field": "structural_mediator",
