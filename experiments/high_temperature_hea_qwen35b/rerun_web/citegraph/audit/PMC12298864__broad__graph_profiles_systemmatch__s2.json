      "support": "partial",
      "supporting_ids": [
        "node::10.1016/j.ijplas.2019.07.017"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing the strength difference between the surface and undeformed core improves strength–ductility synergy.",
