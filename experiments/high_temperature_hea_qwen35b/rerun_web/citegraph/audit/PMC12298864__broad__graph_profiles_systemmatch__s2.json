    {
      "text": "Precipitation hardening contributes to the proposed strength and hardness improvement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Gradient-generated geometrically necessary dislocations increase hardness and strength without significantly reducing ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
