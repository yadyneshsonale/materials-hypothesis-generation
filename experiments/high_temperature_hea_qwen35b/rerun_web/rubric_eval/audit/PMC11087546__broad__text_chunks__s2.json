  "claims": [
    {
      "text": "The initial eutectic high-entropy alloy has a single solid-solution phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tailored thermo-mechanical processing can introduce a lamellar dual-phase microstructure into a eutectic high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting microstructure consists of lamellar FCC and B2 phases.",
