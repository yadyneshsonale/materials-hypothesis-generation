      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC phase is soft and ductile.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2 phase is hard.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed effect should occur at room temperature under quasi-static loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Synergistic reinforcement between the two phases produces a favorable strength-ductility combination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::000::abstract",
        "PMC6478865::web::000::abstract",
        "PMC7514768::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lamellar dual-phase alloy will have greater strength than a single-solid-solution-phase baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lamellar dual-phase alloy will have greater ductility than a single-solid-solution-phase baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention may not be effective in every eutectic high-entropy alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimal thermo-mechanical processing conditions depend on alloy composition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanisms responsible for the proposed simultaneous improvement are not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
