      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of Ta3C and Nb3C may enhance high-temperature oxygen resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-doped alloy will have better high-temperature oxygen resistance than untreated Mo15Nb20Re15Ta30W20.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
