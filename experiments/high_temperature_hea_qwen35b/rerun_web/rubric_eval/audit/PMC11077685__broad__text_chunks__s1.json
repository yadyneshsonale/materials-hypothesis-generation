      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding 0.1 at.% carbon can improve the alloy's high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should occur under combined high-pressure and high-temperature conditions.",
