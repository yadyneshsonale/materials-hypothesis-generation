  "claims": [
    {
      "text": "The target material is a Co-free FeNiCrMn high-entropy alloy in an as-cast or homogenized state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suitable heat treatment or mechanical processing can introduce coherent nanoscale L12 precipitates into the FCC phase of FeNiCrMn.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Introducing coherent nanoscale L12 precipitates will improve the strength-ductility balance of Co-free FeNiCrMn under dynamic loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed improvement will apply from strain rates of 10^-3 s^-1 to 10^3 s^-1.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed improvement will apply at temperatures from -200°C to 500°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoscale L12 precipitates will act as obstacles to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Obstruction of dislocation motion by the L12 precipitates will increase strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The L12 precipitates will increase work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FCC phase will retain sufficient ductility after L12 precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to unmodified FeNiCrMn, the modified alloy will have increased yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to unmodified FeNiCrMn, the modified alloy will have increased ultimate tensile strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to unmodified FeNiCrMn, the modified alloy will maintain or improve ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard",
        "PMC11606435::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The strength-ductility improvement will be most pronounced at high strain rates.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6478865::webcard"
      ],
      "same_system": "no"
    },
    {
      "text": "The strength-ductility improvement will be most pronounced at low temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11606435::webcard"
      ],
      "same_system": "unclear"
