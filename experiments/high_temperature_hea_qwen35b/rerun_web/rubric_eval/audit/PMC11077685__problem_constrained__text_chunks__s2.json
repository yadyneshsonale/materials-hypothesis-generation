      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::018::4_discussion"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coated alloy will retain yield strength relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will retain ductility relative to untreated cast HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
