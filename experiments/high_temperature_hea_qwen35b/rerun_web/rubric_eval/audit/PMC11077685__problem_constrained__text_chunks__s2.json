      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::020::5_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The anti-oxidation coating will prevent or reduce oxide-layer formation on the alloy surface.",
