  "claims": [
    {
      "text": "Adding a CrTaO4-based oxide layer to a refractory high-entropy alloy can improve its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed intervention is the addition of a CrTaO4-based oxide layer.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should work at 1000°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should work at 1100°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should work in an oxidizing atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A dense, protective CrTaO4-based oxide layer forms under the proposed conditions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At 1100°C, formation of a protective CrTaO4-based oxide layer is associated with parabolic oxidation behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The CrTaO4-based oxide layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer reduces the oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the untreated alloy, the treated alloy will exhibit reduced weight gain during oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the untreated alloy, the treated alloy will retain improved mechanical properties after oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact formation mechanism of the CrTaO4-based layer is not fully understood.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
