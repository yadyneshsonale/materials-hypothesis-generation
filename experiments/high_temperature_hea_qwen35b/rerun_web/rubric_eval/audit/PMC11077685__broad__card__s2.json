  "claims": [
    {
      "text": "Adding a CrTaO4-based surface oxide layer can improve the high-temperature oxygen resistance of a refractory high-entropy alloy relative to the untreated alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A CrTaO4-based oxide layer can be applied as an external surface treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention should work at temperatures up to 1100°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should work in an oxidizing atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention should remain effective for exposures up to 200 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The intervention produces a dense, protective CrTaO4-based oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The CrTaO4-based layer acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen diffusion through the layer reduces the alloy's oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will exhibit less oxidation-associated weight gain than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::webcard"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The treated alloy will have improved mechanical properties relative to the untreated alloy after exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness of the oxide layer may depend on the refractory alloy's composition.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effectiveness of the oxide layer may depend on its thickness and uniformity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
