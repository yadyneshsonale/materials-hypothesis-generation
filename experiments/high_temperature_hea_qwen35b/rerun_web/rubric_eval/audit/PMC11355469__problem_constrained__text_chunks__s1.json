  "claims": [
    {
      "text": "The target material is a FeNiCrCoCu high-entropy-alloy coating on a Cu matrix.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is adding W to the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding W will improve the coating's wear resistance across different temperatures, sliding velocities, and wear depths.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11278666::web::018::3_5_friction_and_wear_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing W content reduces the friction coefficient of a high-entropy-alloy cladding coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11278666::web::018::3_5_friction_and_wear_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding W promotes formation of a protective oxide glaze layer on the worn surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed glaze layer consists of various nanocrystalline oxides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A tribo-oxidation-derived glaze layer can protect or enhance the friction interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::003::introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide layer provides solid lubrication.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10241162::web::003::introduction",
        "PMC9960858::web::022::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The W-modified coating will have a lower friction coefficient than the unchanged FeNiCrCoCu coating under identical conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11278666::web::018::3_5_friction_and_wear_properties"
      ],
      "same_system": "no"
    },
    {
      "text": "The W-modified coating will have a lower specific wear rate than the unchanged FeNiCrCoCu coating under identical conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
