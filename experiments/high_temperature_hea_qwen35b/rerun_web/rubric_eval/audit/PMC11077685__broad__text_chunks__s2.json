  "claims": [
    {
      "text": "The untreated alloy is Mo15Nb20Re15Ta30W20.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is addition of 0.1 at.% carbon to Mo15Nb20Re15Ta30W20.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "At 6 GPa and 809 °C, dilute carbon doping promotes carbide formation in Mo15Nb20Re15Ta30W20.",
      "field": "conditions; structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The carbides formed under the specified high-pressure and high-temperature conditions include Ta3C and Nb3C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting Ta3C and Nb3C carbides are stable.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Carbide formation improves the mechanical performance of the dilute carbon-doped alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of Ta3C and Nb3C enhances high-temperature oxidation resistance.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.1 at.% carbon improves high-temperature oxygen resistance relative to untreated Mo15Nb20Re15Ta30W20.",
      "field": "hypothesis; predicted_outcome; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should apply over the temperature range from 700 °C to 1643 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7517255::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed oxidation-resistance improvement should apply under both ambient and high-pressure conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact mechanism by which the carbides might improve oxidation resistance is not fully understood.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of the carbon-doped alloy to show a significant oxidation-resistance improvement over the untreated alloy would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
