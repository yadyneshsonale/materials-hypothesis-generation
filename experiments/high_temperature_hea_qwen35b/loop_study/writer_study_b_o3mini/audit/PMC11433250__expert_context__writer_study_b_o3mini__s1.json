  "claims": [
    {
      "text": "Single-phase ZrB2 conventionally requires processing temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-temperature processing routes for ZrB2 produce materials with poor oxidation and liquid-metal corrosion resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 3–5 wt.% silicon to a ZrB2 precursor enables reactive hot pressing at around 1700 °C.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon addition enables liquid-phase sintering of ZrB2 at approximately 1700 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing silicon-doped ZrB2 produces a Si-rich glassy phase along ZrB2 grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-rich intergranular phase aids densification of the ZrB2 body.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During high-temperature service, silicon segregates to grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary silicon oxidizes to form a continuous glassy SiO2 or borosilicate layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The glassy SiO2 or borosilicate layer impedes oxygen penetration.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The glassy SiO2 or borosilicate layer impedes penetration by molten plating metal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon-doped ZrB2 will achieve full densification at approximately 1700 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon-doped ZrB2 will have better mechanical integrity than both pure high-temperature-sintered ZrB2 and prior lower-temperature specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon-doped ZrB2 will exhibit lower oxidation weight gain during cyclic high-temperature exposure than the comparison materials.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon-doped ZrB2 will exhibit reduced liquid-metal corrosion relative to the comparison materials.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective glassy phase is likely to remain stable up to approximately 1500 °C or slightly higher.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed material is applicable in oxidizing atmospheres and typical liquid plating-metal baths.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
