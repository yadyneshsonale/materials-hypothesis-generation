      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As a small metalloid, boron promotes topological frustration and local atomic-size mismatch in the melt.",
