      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The boron-doped alloy will require a lower critical cooling rate for glass formation than the undoped alloy.",
