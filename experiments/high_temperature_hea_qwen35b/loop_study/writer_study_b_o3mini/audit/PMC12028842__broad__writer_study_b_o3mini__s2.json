  "claims": [
    {
      "text": "Plasma nitriding Ti-6Al-4V at approximately 700–800°C in a nitrogen-rich plasma will form a TiN-rich surface layer.",
      "field": "hypothesis/intervention/structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitrogen diffuses into the titanium-alloy surface during plasma nitriding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diffused nitrogen reacts with titanium to form TiN.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TiN is a hard, wear-resistant phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiN-rich layer increases the surface hardness of the titanium alloy.",
      "field": "hypothesis/mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiN-rich layer acts as a protective barrier against abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TiN-rich layer acts as a protective barrier against adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma nitriding is expected to increase surface hardness by approximately 20% or more relative to untreated Ti-6Al-4V.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma-nitrided Ti-6Al-4V is expected to have lower wear-track depth than untreated Ti-6Al-4V in pin-on-disk testing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plasma-nitrided Ti-6Al-4V is expected to have lower wear-volume loss than untreated Ti-6Al-4V in pin-on-disk testing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hardness and wear benefits are expected under ambient-temperature, moderate-load conditions in air.",
      "field": "conditions/boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefits may also persist at moderately elevated temperatures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Very high-temperature or corrosive service may require additional surface interventions.",
