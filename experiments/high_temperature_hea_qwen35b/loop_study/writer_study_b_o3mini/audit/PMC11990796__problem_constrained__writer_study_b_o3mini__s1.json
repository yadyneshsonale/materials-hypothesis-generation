  "claims": [
    {
      "text": "The initial NbZrTiHfMo alloy is equiatomic and has a disordered BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic NbZrTiHfMo has a room-temperature compressive yield strength of approximately 1719 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high Mo content produces a large electronegativity mismatch in NbZrTiHfMo.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Electronegativity-driven bonding inhomogeneity associated with Mo limits the alloy's plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention replaces approximately 20% of the Mo atoms with V, giving nominal Nb20Zr20Ti20Hf20Mo16V4 in atomic percent.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of Mo by V will reduce the overall electronegativity mismatch among the constituent elements.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial replacement of Mo by V will modify short-range order or local chemical fluctuations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced electronegativity mismatch will mitigate local bonding heterogeneity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mitigating bonding heterogeneity will lower barriers to dislocation glide and promote more uniform dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Easier and more uniform dislocation motion will increase room-temperature compressive plasticity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V has a high melting point.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V has an atomic size sufficiently similar to the other constituents to retain significant lattice distortion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Retained lattice distortion and solid-solution strengthening after V substitution will preserve high compressive yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's room-temperature compressive yield strength will remain close to 1719 MPa, with only a minimal reduction.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The improved strength–plasticity balance is expected for substitutions of up to approximately 30% of the Mo by V under room-temperature compressive loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing more than approximately 30% of the Mo by V may cause phase instability or loss of high-strength characteristics.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Testing at temperatures substantially different from room temperature may cause phase instability or loss of the beneficial high-strength behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting followed by homogenization at 1200 °C for 24 hours will ensure adequate chemical uniformity.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The useful V-substituted compositions are expected to retain a single-phase BCC structure.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
