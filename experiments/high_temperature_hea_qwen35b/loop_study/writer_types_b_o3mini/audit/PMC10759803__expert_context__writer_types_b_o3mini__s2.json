      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Avoiding deleterious secondary phases is necessary for preserving the alloy's mechanical performance.",
