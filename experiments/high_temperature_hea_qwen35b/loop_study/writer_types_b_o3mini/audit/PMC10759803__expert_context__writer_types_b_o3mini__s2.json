      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition will produce minor lattice distortions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The retained solid solution and lattice distortion will maintain solid-solution strengthening at room temperature and 1000 °C.",
