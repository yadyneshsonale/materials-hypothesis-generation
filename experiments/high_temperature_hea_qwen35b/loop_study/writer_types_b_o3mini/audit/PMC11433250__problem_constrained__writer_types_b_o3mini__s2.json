  "claims": [
    {
      "text": "Conventional single-phase ZrB2 requires sintering above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally sintered single-phase ZrB2 typically contains residual porosity and structural defects.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1–2 wt% Si to ZrB2 powder lowers its required sintering temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon forms a transient Si-rich liquid phase during sintering of ZrB2.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transient Si-rich liquid increases atomic mobility and particle rearrangement during sintering.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-rich liquid accelerates particle diffusion and pore elimination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon addition produces a more uniform and dense ZrB2 microstructure with fewer pores.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pores and other microstructural defects act as initiation sites for hole formation and failure during prolonged liquid plating bath exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrB2 containing approximately 1–2 wt% Si can densify at 2100–2200 °C in an inert or reducing atmosphere.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-modified ZrB2 sintered at 2100–2200 °C will have significantly lower porosity than undoped ZrB2 conventionally sintered above 2300 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-modified ZrB2 will have greater mechanical strength than conventionally sintered undoped ZrB2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-modified ZrB2 will show less hole formation and greater resistance to eventual failure during prolonged liquid plating bath exposure than conventionally sintered undoped ZrB2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Transient liquid-phase sintering by silicon is well documented in similar ceramics.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual silicon or undesirable secondary phases may compromise the performance of the modified ZrB2.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
