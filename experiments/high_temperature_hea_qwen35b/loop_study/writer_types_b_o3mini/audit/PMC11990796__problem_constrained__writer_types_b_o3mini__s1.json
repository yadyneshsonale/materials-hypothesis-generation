      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy's limited plasticity is attributable in part to its high Mo content increasing the overall electronegativity difference.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A portion of Mo should be replaced with W to form NbZrTiHfMo0.75W0.25.",
