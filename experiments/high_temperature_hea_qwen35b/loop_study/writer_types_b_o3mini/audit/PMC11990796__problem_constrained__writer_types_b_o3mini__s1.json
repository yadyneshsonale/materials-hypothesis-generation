      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is refuted if the modified alloy fails to improve plastic strain by at least 20% while limiting the yield-strength reduction to no more than 10%, or if it changes away from the disordered BCC phase.",
