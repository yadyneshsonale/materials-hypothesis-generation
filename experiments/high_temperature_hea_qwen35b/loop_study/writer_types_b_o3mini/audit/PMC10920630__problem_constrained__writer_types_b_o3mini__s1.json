    {
      "text": "The corrosion behavior of Q235 steel is governed by the quality of its native oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
