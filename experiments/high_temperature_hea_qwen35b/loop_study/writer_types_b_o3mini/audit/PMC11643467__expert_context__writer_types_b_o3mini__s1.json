      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will have greater corrosion resistance than the uncoated alloy under similar test conditions.",
