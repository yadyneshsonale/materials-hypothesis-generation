      "supporting_ids": [
        "PMC10621632::web::022::simulated_particle_formation_and_influen",
        "PMC10621632::web::026::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Restricted atomic mobility suppresses diffusion-driven elemental segregation and intermetallic ordering.",
