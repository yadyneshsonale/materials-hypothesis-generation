  "claims": [
    {
      "text": "The feedstock is cobalt-free AlCrFeNiSi powder produced by mechanical alloying.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional bulk fabrication of AlCrFeNiSi produces compositional segregation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional processing of AlCrFeNiSi produces residual stresses.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12250662::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS should replace casting or standard laser additive manufacturing as the consolidation method.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "An SPS temperature of approximately 900–1000 °C with rapid heating and a short dwell is an appropriate processing window for AlCrFeNiSi.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS will produce a fine, homogeneous AlCrFeNiSi microstructure with uniform grain size.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS will minimize secondary phases and defect sites in AlCrFeNiSi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid densification and pulsed electric current are inherent features of SPS.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid SPS processing reduces the time available for elemental diffusion and segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The short SPS processing time minimizes thermal gradients and residual-stress buildup.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A more uniform microstructure with fewer internal defects enhances mechanical integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10003814::web::001::1_introduction",
        "PMC12250662::web::005::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS-processed AlCrFeNiSi will have higher yield strength than conventionally fabricated AlCrFeNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS-processed AlCrFeNiSi will have higher ductility than conventionally fabricated AlCrFeNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10772231::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS-processed AlCrFeNiSi will exhibit less elemental segregation than conventionally fabricated AlCrFeNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS-processed AlCrFeNiSi will exhibit lower residual stress than conventionally fabricated AlCrFeNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Casting typically produces elemental segregation and a rough microstructure.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10772231::web::001::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Additive manufacturing can produce high residual stresses and crack defects.",
      "field": "baseline",
