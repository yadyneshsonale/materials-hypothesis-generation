  "claims": [
    {
      "text": "A dual-phase FCC/BCC microstructure enhances the creep resistance of high-entropy-alloy protective coatings under continuous loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FCC dendrites are relatively ductile, while the BCC precipitates are relatively strong.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The FCC/BCC interfaces in the proposed coating are coherent.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "FCC/BCC interfaces act as barriers to dislocation glide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a",
        "PMC8249401::web::000::abstract"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanical contrast between the FCC and BCC phases produces heterogeneous load or strain partitioning.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a",
        "PMC6045582::web::009::experimental_results"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Deformation twinning is activated in the FCC phase during deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a",
        "PMC6045582::web::009::experimental_results"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Interface blocking, load partitioning, and FCC twinning collectively suppress strain localization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting coating contains oriented FCC dendrites with embedded BCC precipitates and developed phase boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-temperature creep is progressive plastic deformation under sustained mechanical stress over extended periods.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11203300::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Creep testing at 500–600°C represents relevant service conditions for the proposed coating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under sustained elevated-temperature stress, FCC/BCC boundaries delay plastic-strain accumulation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "FCC/BCC boundaries encourage deformation twinning in the FCC phase during elevated-temperature creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6045582::web::004::the_promise_of_dual_phase_high_entropy_a",
        "PMC6045582::web::009::experimental_results"
      ],
      "same_system": "unclear"
    },
    {
      "text": "FCC/BCC boundaries constrain dislocation motion in the BCC regions during elevated-temperature creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic strain accommodation by the two phases reduces localized creep deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A refined coherent dual-phase coating will have a lower creep strain rate than a coating with fewer or less coherent phase boundaries.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
