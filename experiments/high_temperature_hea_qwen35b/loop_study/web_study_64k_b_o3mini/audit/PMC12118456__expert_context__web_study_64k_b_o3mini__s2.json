  "claims": [
    {
      "text": "Premelting and melting in Fe–Ni–Cr–Co–Cu nanoparticles are governed by kinetically limited atomic mobility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::022::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Intrinsic lattice disorder and lattice distortion restrict atomic mobility during heating.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10621632::web::022::simulated_particle_formation_and_influen"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Restricted atomic diffusion produces or preserves local compositional heterogeneities in the HEA nanoparticles.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056590::web::018::3_2_crmnfeconicu_after_high_temperature_",
        "PMC10621632::web::022::simulated_particle_formation_and_influen"
      ],
      "same_system": "no"
    },
    {
      "text": "Stochastic local compositional variations create regions with lower bonding strength and lower local melting points.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-local-melting-point regions melt before the rest of the particle and generate a premelting regime.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10056590::web::018::3_2_crmnfeconicu_after_high_temperature_"
      ],
      "same_system": "no"
    },
    {
      "text": "The initially liquid regions act as nucleation sites and gradually coalesce.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heterogeneous local melting produces a broader overall melting transition than occurs in homogeneous single-metal nanoparticles.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed particles are equimolar Fe–Ni–Cr–Co–Cu solid solutions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial Fe–Ni–Cr–Co–Cu nanoparticles have a single-phase disordered FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::010::characterization_of_laser_synthesized_cr"
      ],
      "same_system": "no"
    },
    {
      "text": "Ultrashort-pulse laser processing can prepare the stated single-phase Fe–Ni–Cr–Co–Cu nanoparticle material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11427457::web::010::characterization_of_laser_synthesized_cr"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed test uses controlled rapid heating from approximately 600 °C to 1400 °C in an inert atmosphere while structural evolution is monitored.",
      "field": "intervention; conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
