      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8709257::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Zirconium-alloy nuclear-fuel cladding is currently protected by standard coatings or unoptimized MEA coatings.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer formed on the optimized coating is adherent.",
