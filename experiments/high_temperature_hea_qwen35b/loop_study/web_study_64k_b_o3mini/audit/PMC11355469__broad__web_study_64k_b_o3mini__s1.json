  "claims": [
    {
      "text": "An AlCoCrFeNi high-entropy-alloy coating can serve as the baseline protective coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline coating exhibits abrasive, adhesive, and oxidative wear under high-temperature conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10890335::web::016::3_4_morphlology_and_wear_mechanism_of_we"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing the relative Al and Cr content promotes more rapid oxide-layer formation during high-temperature wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide formed by increasing Al and Cr is denser than that on the baseline coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The tribologically generated oxide layer is self-lubricating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator is a continuous, nanostructured surface oxide layer containing Al2O3 and Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10856430::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "The in-situ oxide scale acts as a barrier that reduces direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced metal-to-metal contact suppresses abrasive and adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al and Cr lowers the friction coefficient relative to the baseline coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Al and Cr lowers the wear rate relative to the baseline coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified coating will develop a thicker and more continuous oxide layer than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified coating will show higher surface oxygen content than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10890335::web::016::3_4_morphlology_and_wear_mechanism_of_we"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed wear-protection effect should operate in air between 650 and 1000 °C.",
