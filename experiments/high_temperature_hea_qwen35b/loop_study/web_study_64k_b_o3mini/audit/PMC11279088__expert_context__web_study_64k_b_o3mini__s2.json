  "claims": [
    {
      "text": "The identity of X in CrFeCoNiX controls selective oxidation kinetics.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::web::004::1_introduction",
        "PMC9498035::web::015::3_1_1_effect_of_the_al_cr_ratio"
      ],
      "same_system": "yes"
    },
    {
      "text": "Al substitution promotes formation of an oxide scale containing Al2O3 and Cr2O3.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::015::3_1_1_effect_of_the_al_cr_ratio"
      ],
      "same_system": "yes"
    },
    {
      "text": "An Al2O3-Cr2O3 scale on the Al-containing alloy is coherent, slow-growing, and protective above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9498035::web::015::3_1_1_effect_of_the_al_cr_ratio"
      ],
      "same_system": "yes"
    },
    {
      "text": "Si- or Mn-containing CrFeCoNiX alloys form faster-growing scales than the Al-containing alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide scales on the Si- or Mn-containing alloys are particularly prone to cracking or spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-scale composition and microstructural integrity govern protective-scale persistence.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms",
        "PMC9498035::web::015::3_1_1_effect_of_the_al_cr_ratio"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Al has a lower diffusion rate that favors slow oxide growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al and Cr oxides have favorable thermodynamic stability relative to Fe-, Co-, and Ni-containing oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9498035::web::015::3_1_1_effect_of_the_al_cr_ratio"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mixing alumina with chromia accommodates oxide-growth stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina-chromia scale has a thermal expansion sufficiently matched to the substrate to remain adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si and Mn do not form scales with protective characteristics comparable to the proposed alumina-chromia scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si- and Mn-containing scales permit higher oxygen fluxes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Scale growth can induce interfacial stresses that cause cracking, spallation, and breakaway oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6317005::web::017::4_1_oxidation_kinetics_and_mechanisms"
      ],
      "same_system": "no"
    },
    {
      "text": "Al-containing alloys will develop thinner oxide scales than Si- or Mn-containing alloys under the specified exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-containing alloys will show fewer cracks and spallation events than Si- or Mn-containing alloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unmodified CrFeCoNi baseline does not form a stable protective oxide under high-temperature exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior remains valid above 900 °C for exposures lasting up to 100 hours in oxidative or corrosive environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing variations and local compositional heterogeneity may alter oxide growth and adherence.",
      "field": "uncertainty",
