  "claims": [
    {
      "text": "MnNiSi-based magnetocaloric alloys can exhibit a large magnetocaloric effect.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline MnNiSi-based alloy has poor mechanical performance, including brittleness and susceptibility to fatigue cracking.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu is a nominally FCC metal.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Cu is sufficiently ductile to serve as a ductility-enhancing addition to MnNiSi-based alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 3 at% Cu will improve the toughness and ductility of a MnNiSi-based magnetocaloric alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melting followed by homogenization annealing will produce relatively uniform Cu segregation at MnNiSi grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary Cu segregation will reduce intergranular stress concentrations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced intergranular stress concentrations will inhibit crack initiation and improve fatigue resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 3 at% Cu addition will not disrupt the primary MnNiSi phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu can have a predominantly structural role in a magnetic alloy rather than strongly determining its magnetic entropy change.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The limited Cu concentration will preserve magnetic ordering in the MnNiSi-based alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-modified alloy will retain a magnetic entropy change close to that of the Cu-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4623812::web::019::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "The predicted mechanical and magnetocaloric benefits should hold near room temperature under field changes of approximately 1–4 T and repeated cycling.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial balance of mechanical and magnetocaloric performance is restricted to low Cu additions near 3 at%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger Cu additions risk disturbing magnetic exchange interactions and reducing the magnetocaloric effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reduction in magnetic entropy change exceeding approximately 10% relative to the Cu-free control is defined as a falsifying outcome.",
      "field": "falsification_rule",
