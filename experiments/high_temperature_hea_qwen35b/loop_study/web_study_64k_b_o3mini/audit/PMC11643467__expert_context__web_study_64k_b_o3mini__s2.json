  "claims": [
    {
      "text": "The starting material is an as-cast AlCoCrFeNi2.1 eutectic high-entropy alloy produced by conventional casting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC4145285::web::009::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy has a fine lamellar FCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC4145285::web::009::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The uncoated AlCoCrFeNi2.1 alloy has a favorable strength–ductility balance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::000::abstract",
        "PMC4145285::web::009::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed intervention is deposition of an approximately 50 nm conformal Al2O3 coating by atomic layer deposition.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed alumina coating is thermally stable and corrosion resistant under the stated service conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ALD will produce a continuous and adherent alumina layer on AlCoCrFeNi2.1.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will act as a surface diffusion barrier and passivation film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina coating will limit surface oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina coating will reduce ingress of corrosive species into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will inhibit surface diffusion and microcrack initiation during thermal cycling and sustained loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing surface degradation will help preserve the alloy's bulk microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will decrease creep deformation under long-term room-temperature sustained loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will decrease the corrosion rate in chloride-containing sulfuric-acid solutions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will retain a strength–ductility balance comparable to that of the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's creep and corrosion benefits will persist during thermal cycling between room temperature and approximately 700°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's benefits are limited to moderately aggressive corrosive environments and may diminish under extreme impact or more severe environments.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Long-term coating adhesion and stability during repeated thermal cycling and sustained mechanical stress have not been established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
