  "claims": [
    {
      "text": "Unmodified TC4 (Ti6Al4V) has an alpha-plus-beta dual-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "TC4 has relatively low hardness and poor wear resistance under extreme-service or high-contact-stress conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "A TiAl-based coating can be deposited on TC4 by laser cladding to improve wear resistance through solid-solution strengthening.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding dispersed TiC or WC particles to the laser-cladded TiAl coating will further increase hardness and wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed coating will be metallurgically bonded to the TC4 substrate.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will contain multiple TiAl-system intermetallic or microstructural phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hard particles will be uniformly distributed and produce a refined, load-bearing coating microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Solid-solution strengthening in the TiAl-based coating will enhance surface hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Intermetallic precipitation hardening will enhance the coating hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Embedded WC or TiC particles will impede plastic deformation and promote matrix hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Embedded hard particles will reduce abrasive wear damage.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "A strong metallurgical bond will minimize coating delamination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will retain the substrate's toughness and corrosion resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated TC4 will have greater surface hardness than untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction",
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coated TC4 will have a lower sliding wear rate than untreated TC4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11509624::web::005::1_introduction",
        "PMC8949536::web::003::1_introduction"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The hardness and wear improvements will extend service life under high-contact stresses.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will not compromise TC4's beneficial lightweight and ductile properties.",
