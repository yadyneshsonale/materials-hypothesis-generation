{
  "run_id": "PMC11990881__broad__web_study_64k_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Adding ZrC to a CrMnFeCoNi HEA bond coat will improve its durability and reliability under high-temperature TBC service conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated baseline is a CrMnFeCoNi HEA coating without a ceramic additive.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional plasma transferred arc deposition is a typical preparation method for the baseline coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing approximately 4 wt% fine ZrC particles during PTA deposition will produce an in-situ ZrC dispersion in the bond coat.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The modified coating should remain beneficial during oxidizing thermal cycles between room temperature and approximately 1000 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC forms a dispersed second phase within a predominantly FCC HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "ZrC particles are stable and oxidation-resistant at the proposed service temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed ZrC particles inhibit interdiffusion and outward transport of reactive species.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ZrC dispersion refines the coating microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC strengthens the HEA matrix through dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ZrC suppresses the formation and propagation of damaging oxide scales and thermal-cycle spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the untreated coating, the ZrC-modified coating will have a lower high-temperature oxidation rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the untreated coating, the ZrC-modified coating will have greater adhesion strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the untreated coating, the ZrC-modified coating will exhibit less spallation and cracking.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A ZrC content around 4 wt% is expected to be near an effective or optimized level.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive ZrC additions may cause phase segregation or embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit may not persist outside the approximate room-temperature-to-1000 °C service range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior evidence shows that adding ZrC improves the aqueous corrosion resistance of CrMnFeCoNi HEA coatings, with resistance increasing as ZrC content increases.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "In 1 mol/L NaCl, the annual corrosion rate of the reported 04ZrC coating was 21.5% of that of the unmodified HEA coating.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10707036::web::023::4_conclusions"
      ],
      "same_system": "yes"
    }
  ],
