        "PMC11642357::web::001::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Adding approximately 1–2 at% carbon will improve amorphous retention during rapid solidification.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding approximately 1–2 at% carbon will delay crystallization during subsequent reheating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting followed by rapid quenching or melt-spinning yields an amorphous Cr16Mn16Fe16Co16Ni16P20 structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The amorphous baseline alloy crystallizes early during reheating and has limited thermal stability.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt-spinning provides cooling rates of approximately 10^5–10^6 K/s for the proposed processing route.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added carbon will occupy interstitial sites in the amorphous alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon disrupts local atomic ordering in the amorphous matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon reduces the density of crystallization nucleation sites in the amorphous matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon kinetically impedes diffusion and atomic rearrangements needed for crystallization during rapid solidification.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon kinetically impedes diffusion and atomic rearrangements needed for crystallization during reheating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon doping will enhance glass-forming ability relative to the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12767063::web::015::insights_into_amorphous_nanoparticle_for"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon doping will increase the crystallization-onset temperature during DSC reheating relative to the undoped baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect will diminish under sufficiently extreme reheating because thermal energy can overcome the proposed kinetic barriers.",
