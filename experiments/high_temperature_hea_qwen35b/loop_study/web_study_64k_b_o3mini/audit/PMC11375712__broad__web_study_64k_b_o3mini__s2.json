      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11426066::web::012::results_and_discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial FeCoNiMnCu-based alloy is a fully disordered FCC alloy with coercivity below approximately 100 Oe.",
