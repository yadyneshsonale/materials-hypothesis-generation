      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10820071::web::002::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Minimal in-spray oxidation will preserve bond-coat integrity and high-temperature durability.",
