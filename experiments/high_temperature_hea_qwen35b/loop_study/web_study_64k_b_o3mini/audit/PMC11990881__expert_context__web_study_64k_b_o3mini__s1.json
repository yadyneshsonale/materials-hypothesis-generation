      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved flattening, splat formation, and deposition efficiency facilitate buildup of a thicker coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
