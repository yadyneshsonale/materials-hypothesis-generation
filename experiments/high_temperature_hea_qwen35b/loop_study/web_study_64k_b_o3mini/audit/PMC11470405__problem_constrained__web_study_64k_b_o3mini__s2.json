      ],
      "same_system": "no"
    },
    {
      "text": "The elevated-temperature edge dislocations feature thermal super-jog structures.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing temperature reduces lattice friction and makes dislocation motion easier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal activation modifies dislocation-core structure in a way that favors edge-dislocation activity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Edge-dislocation super-jogs provide strong barriers to dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "Super-jog-mediated resistance balances strain hardening against thermal softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr will exhibit a yield-strength plateau, with little strength reduction, between 673 K and 1073 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
      "text": "The thermal expansion of HfNbTaTiZr will be less temperature-sensitive than conventional predictions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The elastic moduli of HfNbTaTiZr will have weak temperature dependence at elevated temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::web::003::introduction"
      ],
      "same_system": "no"
