      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature plasticity in HfNbTaTiZr is dominated by thermally activated screw-dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10453588::web::012::3_results"
      ],
      "same_system": "no"
    },
    {
