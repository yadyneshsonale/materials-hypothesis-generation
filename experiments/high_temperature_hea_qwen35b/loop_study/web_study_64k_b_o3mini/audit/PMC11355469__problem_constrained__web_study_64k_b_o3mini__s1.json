        "PMC10730726::web::016::effect_of_control_functions_on_wear_rate"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Higher sliding speed can increase shear strain, interfacial temperature, thermal softening, and wear rate.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10730726::web::016::effect_of_control_functions_on_wear_rate"
