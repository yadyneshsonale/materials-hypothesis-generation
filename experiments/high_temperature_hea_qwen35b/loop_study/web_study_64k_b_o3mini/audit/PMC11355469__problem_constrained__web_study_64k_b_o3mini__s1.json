  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline coating has a relatively coarse microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-annealing at approximately 500 °C can induce nanotwins or grain refinement in the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pre-induced nanocrystalline surface structure promotes formation of an ultra-refined tribofilm during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The ultra-nanocrystalline tribofilm forms through shear-induced near-surface refinement.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-annealed microstructure undergoes further dynamic recrystallization during high-temperature sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ultra-refined sliding layer exhibits inverse Hall-Petch behavior.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Inverse Hall-Petch refinement lowers the effective shear strength of the tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Formation of the ultra-nanocrystalline near-surface layer governs overall wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined tribofilm reduces material removal during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "The refined tribofilm reduces crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The refined tribofilm limits microscopic plastic deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the as-deposited baseline, the pre-annealed coating will have a lower wear rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the as-deposited baseline, the pre-annealed coating will show less severe plastic flow and microcracking.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted behavior should hold at approximately 500–800 °C under limited-oxidation sliding conditions.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "More oxidative conditions may change the predicted wear behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7311485::web::000::abstract"
      ],
      "same_system": "no"
    },
    {
      "text": "Changes in load or sliding speed may change wear behavior.",
