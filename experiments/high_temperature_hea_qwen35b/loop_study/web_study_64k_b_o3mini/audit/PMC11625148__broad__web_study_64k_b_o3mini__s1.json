      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Magnetron-sputtered baseline W–Ta–Cr–V will be a homogeneous nanocrystalline solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::web::004::introduction"
      ],
      "same_system": "yes"
    },
    {
