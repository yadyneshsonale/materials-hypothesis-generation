  "claims": [
    {
      "text": "Equimolar WTaTiVZr has enhanced high-temperature plastic strain and toughness relative to commercially pure tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy contains equiatomic proportions of W, Ta, Ti, V, and Zr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516662::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "Powder metallurgy and spark-plasma sintering can produce uniform, single-phase BCC WTaTiVZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr has significant lattice distortion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Solid-solution additions of Ta, Ti, V, and Zr create greater lattice distortion than occurs in pure tungsten.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lattice distortion reduces the effective Peierls barrier for dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy contains a uniform dislocation network that contributes to lowering the barrier to dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Plastic deformation in WTaTiVZr is dislocation-mediated.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7516662::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "A reduced Peierls barrier increases dislocation mobility in WTaTiVZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Enhanced dislocation mobility produces more homogeneous plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "More mobile dislocations delay brittle-crack initiation and increase ductility and toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At temperatures above 1000 K, WTaTiVZr will have lower yield stress than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At temperatures above 1000 K, WTaTiVZr will sustain more plastic strain before fracture than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At temperatures above 1000 K, WTaTiVZr will absorb more energy before failure than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten has limited plastic deformation under plasma-facing conditions because of its high ductile-to-brittle transition and high effective Peierls barrier.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed lattice-distortion mechanism is expected to dominate at temperatures of at least 1000 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures, other deformation or failure mechanisms may dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Prior work on similar refractory high-entropy alloys supports lattice-distortion-enhanced dislocation mobility.",
