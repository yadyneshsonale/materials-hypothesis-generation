      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6393512::web::014::discussion"
      ],
      "same_system": "no"
    },
    {
      "text": "Al content affects ΔG_bcc-fcc in this alloy.",
