  "claims": [
    {
      "text": "Nanocrystalline W38Ta36Cr15V11 films can be produced by magnetron sputtering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-produced W38Ta36Cr15V11 films have a single-phase BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The W38Ta36Cr15V11 films have a bimodal grain-size distribution, with most grains no larger than 100 nm.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Irradiated W38Ta36Cr15V11 develops a second phase rich in Cr and V by approximately 8 dpa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy exhibits Cr and V segregation at grain boundaries and triple junctions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy shows no irradiation-induced dislocation loops under the reported exposures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline W38Ta36Cr15V11 alloy shows only slight irradiation hardening near 8 dpa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant baseline alloy has been irradiated at room temperature and 1073 K to doses up to 8 dpa.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6397024::web::017::conclusions"
      ],
      "same_system": "yes"
    },
    {
      "text": "Introducing 4–8 at.% Hf while replacing part of the Cr is a suitable modification of W38Ta36Cr15V11.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf addition will retard diffusion and segregation of Cr and V at grain boundaries and within grain interiors.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf enhances chemical stability and lattice distortion in the BCC matrix because it is refractory and forms stable bonds in the matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-induced chemical stability and lattice distortion reduce the mobility and clustering tendency of Cr and V during irradiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding Hf will markedly reduce or completely suppress Cr–V-rich precipitates after irradiation near 8 dpa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-modified alloy will retain the baseline alloy's low irradiation hardening and radiation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-modified alloy will remain practically manufacturable because its chemistry remains largely refractory.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect is expected near 8 dpa and at specimen temperatures no higher than about 1073 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit may not persist at substantially higher doses or temperatures, or outside the proposed Hf concentration range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Matched undoped and Hf-modified sputtered films should be irradiated under identical conditions and compared by TEM, APT, nanoindentation, and XRD.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if Hf modification leaves Cr–V precipitate density, size, and distribution similar to the baseline or causes substantially greater irradiation hardening.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
