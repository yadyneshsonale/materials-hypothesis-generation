  "claims": [
    {
      "text": "The baseline is an as-cast equiatomic HfMoTaTiZr refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514121::web::000::abstract"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast equiatomic HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has excellent strength at room temperature and around 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf can be partially or fully replaced with Sc while Mo, Ta, Ti, and Zr remain in near-equiatomic proportions.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Full equiatomic replacement of Hf by Sc yields ScMoTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc is significantly lighter than Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with Sc will reduce the alloy density, potentially to below 10.21 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sc-substituted alloy will maintain a single-phase BCC solid solution similar to HfMoTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc can substitute into the refractory-alloy lattice and provide solid-solution strengthening through size-misfit and electronic interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514121::web::000::abstract",
        "PMC9586648::web::003::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "Solid-solution strengthening from Sc will permit retention of high strength at room temperature and approximately 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Sc-substituted alloy will retain ductility at room temperature and approximately 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Its yield and flow strengths at room temperature and approximately 1000 °C will be maintained or altered only slightly relative to HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Its phase stability and ductility will remain comparable to those of as-cast HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sc-containing refractory alloys can be prepared by vacuum arc melting.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8956691::web::002::introduction"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed property retention applies from room temperature to approximately 1000 °C under quasi-static loading.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert or controlled atmosphere will minimize oxidation effects during testing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The extent of Hf replacement and its effect on phase stability will determine the magnitude of density reduction and preservation of mechanical properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A greater than 10% loss in yield or ultimate strength at either room temperature or 1000 °C would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
