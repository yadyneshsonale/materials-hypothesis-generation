  "claims": [
    {
      "text": "The starting AlCoCrFeNi2.1 alloy has an as-cast, uniform, fine, dual-phase lamellar microstructure.",
      "field": "material_initial_state; structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "The starting alloy has insufficient strength and ductility for industrial fastener requirements.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433366::web::003::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "An 8–10% cold-rolling reduction followed by a short anneal at approximately 700°C is an appropriate treatment for this alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433366::web::003::1_introduction",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed cold-rolling and annealing treatment will decrease the alloy's interlamellar spacing.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed treatment will produce nanoscale, coherent secondary precipitates.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cold rolling introduces a high defect density that causes recovery and precipitation during the subsequent anneal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase decomposition or precipitation can be used to optimize the properties of AlCoCrFeNi2.1.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Refined lamellae and coherent precipitates will impede dislocation motion and crack propagation.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The treated alloy will have higher yield and fracture strength than the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433366::web::003::1_introduction",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strength improvement will be approximately 10–20% or greater.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will retain ductility at least as well as the as-cast alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11433366::web::003::1_introduction",
        "PMC6353877::web::018::discussion"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation pinning from the refined structure and precipitates will delay room-temperature creep deformation.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will improve room-temperature creep resistance under long-term mechanical loading.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refinement will reduce corrosive-attack sites by limiting high-energy interphase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will have improved localized and general corrosion resistance in aggressive environments.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment is applicable to service and testing at temperatures up to 700°C.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::web::005::tensile_properties"
      ],
      "same_system": "yes"
    },
    {
      "text": "A 3.5% NaCl solution or salt spray adequately represents the relevant industrial corrosive service environment.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if the treatment fails to deliver a statistically significant yield-strength increase of at least 10% with comparable or improved ductility and measurable creep and corrosion improvements.",
