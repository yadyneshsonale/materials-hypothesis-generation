  "claims": [
    {
      "text": "Adding an appropriate amount of WC particles to an HEA can reduce its coefficient of friction under dry sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding WC particles to an HEA can reduce wear volume relative to the unreinforced matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Approximately 30 wt.% WC is an optimal reinforcement level.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "WC can be incorporated into an AlCoCrFeNi HEA coating by laser cladding.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "Laser cladding can provide metallurgical bonding, low dilution, high bonding strength, and fast solidification.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8949536::web::004::1_introduction"
      ],
      "same_system": "yes"
    },
    {
      "text": "The WC intervention will reduce both friction and wear throughout a range from room temperature to approximately 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding of the WC-reinforced HEA will form a lubricious tribofilm containing WC or WC reaction products.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC addition will refine the HEA microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC addition will enhance hardness and stabilize protective oxide formation during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC particles reinforce the HEA matrix and thereby reduce plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC particles produce solution strengthening in the HEA matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WC thermodynamically promotes a wear-induced reaction that forms a lubricious protective nanolayer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protective layer reduces direct metal-to-metal contact, which lowers friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an untreated HEA, a WC-enhanced HEA should have lower friction and substantially lower wear under comparable sliding conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10706897::web::029::4_conclusions"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The friction and wear improvements will remain stable across the entire tested temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 800 °C, the WC phase and generated tribofilm may lose stability.",
      "field": "boundary",
      "needs_support": true,
