      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will be coherent with the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
