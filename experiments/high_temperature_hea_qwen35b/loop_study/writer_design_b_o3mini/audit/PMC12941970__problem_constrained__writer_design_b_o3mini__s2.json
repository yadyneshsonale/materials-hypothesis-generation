  "claims": [
    {
      "text": "Adding Ag to CoCrFeNi will promote in situ formation of an Ag-rich surface film during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ag addition will maintain a lower coefficient of friction than undoped CoCrFeNi from room temperature to 800 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ag addition will reduce wear rate relative to undoped CoCrFeNi from room temperature to 800 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Arc melting followed by homogenization near 1000 °C produces a uniform, equiaxed CoCrFeNi microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing approximately 1–3 wt% Ag into the melt will produce a uniform Ag-containing CoCrFeNi alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ag introduced into CoCrFeNi will remain available to segregate to surfaces during sliding.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding will form Ag-rich nanoprecipitates or a continuous Ag-enriched film at the worn surface and along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Soft, relatively low-melting Ag phases will diffuse and segregate to the contact surface during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Ag-rich film will provide a low-shear-strength contact interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A low-shear-strength Ag-rich interface will reduce friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-rich film will reduce wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-rich film will remain stable across a wide temperature range extending to 800 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The melting temperature of Ag is approximately 961 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ag being below its melting temperature at 800 °C will ensure lubrication at that temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping Ag at 1–3 wt% will avoid adverse effects on the mechanical integrity of CoCrFeNi.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance claim is scoped to ambient-air sliding, loads around 30 N, and temperatures from room temperature to 800 °C.",
      "field": "boundary",
