      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa exhibits approximately 330 MPa yield strength and 423 MPa compressive strength at 1273 K, associated with approximately 30% strain.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
