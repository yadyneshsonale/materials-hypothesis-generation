  "claims": [
    {
      "text": "Adding approximately 1–2 at.% yttrium to an HEA bond coat will improve protective oxide-scale adhesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1–2 at.% yttrium to an HEA bond coat will improve protective oxide-scale stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add approximately 1–2 at.% yttrium during melting and alloying.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium promotes formation of a thin, adherent alumina-based or mixed oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium segregates to grain boundaries in the growing oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary segregation of yttrium improves oxide-scale structural integrity during thermal cycling.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium inhibits the growth of non-adherent oxide scales.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium reduces oxide-scale spallation.",
