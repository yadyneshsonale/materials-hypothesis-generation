  "claims": [
    {
      "text": "The starting material is an equimolar CoCrFeNiTi powder mixture.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting powder has coarse grains, low lattice strain, and high porosity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equimolar CoCrFeNiTi is prone to HCP formation during thermal exposure because of its Ti content.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 6 hours of high-energy ball milling creates a high dislocation density and nanocrystalline grain size.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::chunk::000::abstract::3437e8a43f"
      ],
      "same_system": "no"
    },
    {
      "text": "Milling-induced lattice strain and grain refinement lower the activation-energy barrier for a metastable FCC/BCC solid-solution transition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS at 1000°C densifies the milled CoCrFeNiTi powder.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS at 1000°C avoids excessive Ti-driven HCP precipitation in CoCrFeNiTi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Valence electron concentration and atomic-radius mismatch govern phase selection in high-entropy alloys.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::chunk::004::discussion::ef977a5008",
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant VEC of equimolar CoCrFeNiTi is approximately 8.0-8.5.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping VEC below a critical threshold maintains solid-solution stability against HCP precipitation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stored strain energy generated by 6-hour milling compensates for the enthalpy penalty of the FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS supplies thermal energy for diffusion and densification while its rapid processing can limit grain coarsening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed process will produce a bulk alloy with less than 2% porosity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "The product will retain a refined nanocrystalline FCC/BCC dual-phase or single-phase solid solution without brittle HCP phases or excessive grain coarsening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "The SPS-processed alloy will have significantly higher Vickers hardness than a cast counterpart.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
