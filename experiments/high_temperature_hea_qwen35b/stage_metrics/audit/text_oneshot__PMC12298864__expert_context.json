        "PMC8510135::chunk::000::abstract::3437e8a43f",
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventional casting of CoCrFeNiTi produces low hardness, high porosity, coarse grains, segregation, and potentially brittle intermetallic phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
