      ],
      "same_system": "no"
    },
    {
      "text": "The ball-milled powder has a nanocrystalline grain size below 50 nm.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Milling introduces significant oxygen contamination as interstitial oxygen or surface oxides.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC8510135::chunk::000::abstract::3437e8a43f"
      ],
      "same_system": "no"
    },
    {
      "text": "Sintering between 900 °C and 1000 °C precipitates a continuous nanoscale Ti-rich oxide network at BCC grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS heating also precipitates a grain-boundary intermetallic network.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC7866258::chunk::000::abstract::81dff592dd",
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-rich grain-boundary network restricts outward Mg diffusion and Mg volatilization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-rich grain-boundary network restricts inward oxygen diffusion and prevents bulk oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures above 1000 °C cause excessive Mg loss and composition deviation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive sintering temperature causes grain coarsening that disrupts diffusion-barrier continuity.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS at 950 °C for 5–10 minutes maximizes diffusion without triggering Mg volatility.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A vacuum or argon atmosphere minimizes additional oxygen intake during SPS.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy and lattice distortion suppress intermetallic formation during milling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS heating activates diffusion and thereby causes secondary-phase precipitation from the milled BCC solid solution.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "The presence of Ti and oxygen lowers the activation energy for Ti-oxide precipitation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary precipitates pin the boundaries, preserve a fine-grained matrix, and increase hardness through Hall–Petch strengthening.",
