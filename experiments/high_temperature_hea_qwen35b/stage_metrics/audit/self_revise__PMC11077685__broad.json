{
  "unit": "self_revise__PMC11077685__broad",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "W-Mo-Ta-Nb-V and Nb-Mo-Ta-W are Group IV-V refractory transition-metal alloy systems.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective laser melting can form a single-BCC NbMoTaW alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6427779::chunk::000::abstract::df84b48db4",
        "PMC6427779::hypothesis_evidence_v2::fb095d0ba0462b35"
      ],
      "same_system": "yes"
    },
    {
      "text": "PBF-LB/M can fabricate W20Mo20Ta20Nb20V20 by in-situ alloy formation from elemental powders.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "A linear energy density of at least 2.83 J/mm is appropriate for forming a single-BCC alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427779::chunk::000::abstract::df84b48db4",
        "PMC6427779::hypothesis_evidence_v2::fb095d0ba0462b35"
      ],
      "same_system": "yes"
    },
    {
      "text": "Optimized PBF-LB/M parameters can produce fully fused W20Mo20Ta20Nb20V20 with density greater than 99.8%.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "PBF-LB/M-produced W20Mo20Ta20Nb20V20 can possess a single BCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "PBF-LB/M-produced W20Mo20Ta20Nb20V20 exhibits a dendritic and/or cellular microstructure that is partly controllable through processing parameters.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "Rapid solidification during additive manufacturing produces a refined microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "Post-processing annealing homogenizes the additively manufactured refractory HEA microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::chunk::001::introduction::b3039e0f42"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Post-processing annealing reduces the concentration of O, N, and C interstitial impurities in the printed alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-processing annealing minimizes the clustering of interstitial impurities into ordered complexes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy stabilizes the single-phase BCC structure in these refractory HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial impurities can originate from alloy synthesis and raw materials.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::chunk::003::discussion::b922b22541"
      ],
      "same_system": "no"
    },
    {
      "text": "Ordered interstitial complexes pin dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ordered interstitial complexes reduce ductility and cause brittleness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial impurities are inherently responsible for brittleness in the proposed refractory HEAs.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A single-phase BCC state with a refined, homogeneous microstructure and minimized interstitial content is optimal for mechanical performance.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6427779::chunk::000::abstract::df84b48db4",
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional metallurgical processing of refractory HEAs is difficult because of their high melting temperatures, disparate constituent melting points, and segregation tendency.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6427779::chunk::000::abstract::df84b48db4",
        "PMC8201384::chunk::000::abstract::c39421387b",
        "PMC8201384::chunk::001::introduction::b3039e0f42"
      ],
      "same_system": "yes"
    },
    {
      "text": "Combining additive manufacturing with high-temperature annealing enables retention of high-temperature structural integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b",
        "PMC8201384::chunk::001::introduction::b3039e0f42"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed route enhances elevated-temperature strength, ductility, and creep resistance relative to conventionally processed or unannealed additively manufactured controls.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
