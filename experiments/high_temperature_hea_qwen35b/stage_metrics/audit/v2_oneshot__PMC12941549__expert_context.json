      ],
      "same_system": "no"
    },
    {
      "text": "High-energy ball milling produces a nanocrystalline, oxygen-containing powder with high surface reactivity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6926650::hypothesis_evidence_v2::44fa78caca8c8827"
      ],
      "same_system": "no"
    },
    {
