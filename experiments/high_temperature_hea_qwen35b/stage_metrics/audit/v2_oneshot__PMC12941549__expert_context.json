      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sintering below 800 °C provides insufficient driving force for bulk formation and results in porous, low-hardness material.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sintering above 1000 °C causes substantial magnesium loss and composition deviation.",
      "field": "boundary",
      "needs_support": true,
