  "claims": [
    {
      "text": "The as-cast AlCoCrFeNi2.1 eutectic alloy has a fine lamellar FCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
