      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::hypothesis_evidence_v2::bdc1a929869789cf",
        "PMC10154406::hypothesis_evidence_v2::01da13c37cb988fe"
      ],
      "same_system": "yes"
    },
    {
