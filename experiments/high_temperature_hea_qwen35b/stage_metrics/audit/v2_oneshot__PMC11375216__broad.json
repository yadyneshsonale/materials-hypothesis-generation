        "PMC6397024::hypothesis_evidence_v2::e69adc3294a34141"
      ],
      "same_system": "unclear"
    },
    {
      "text": "SRO suppresses lattice thermal conductivity relative to a disordered solid solution of the same refractory alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO-associated nanoscale compositional fluctuations scatter phonons more effectively than random mass disorder.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed suppression applies when the SRO correlation length is smaller than the dominant phonon mean free path.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
