      "supporting_ids": [
        "PMC8510135::chunk::000::abstract::3437e8a43f",
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS at 1050 °C, 150 °C/min, a five-minute dwell, and 60 MPa suppresses porosity in CoCrFeNiTi.",
