  "claims": [
    {
      "text": "The starting CoCrFeNiTi powder mixture is equimolar.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
