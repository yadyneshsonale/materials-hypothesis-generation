      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "no"
    },
    {
      "text": "Conventionally cast CoCrFeNiTi has a soft single-phase FCC structure with hardness below 300 HV.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ten hours of high-energy ball milling induces severe plastic deformation and nanocrystallization.",
