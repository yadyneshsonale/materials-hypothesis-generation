      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed precipitates may be coherent or semi-coherent with the matrix.",
