      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The fcc phase forms an FeCoNi matrix and the C14 phase occurs as precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The C14 phase induces antiferromagnetic coupling between Fe, Co, and Ni transition-metal sublattices and Ti in the C14 phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "KG::antiferromagnetic::213b37a7db"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The C14 phase in this alloy is Ti-rich.",
