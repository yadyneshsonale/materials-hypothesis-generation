      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::002::results::85fd43f3b9"
      ],
      "same_system": "yes"
    },
    {
      "text": "A VEC below 4.4 favors stable BCC solid solutions in refractory high-entropy alloys.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10154406::chunk::002::results::85fd43f3b9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Forty hours of mechanical alloying will produce two distinct BCC solid solutions in W-Ta-Cr-V-Hf.",
