      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast refractory high-entropy alloys typically have limited ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5"
      ],
      "same_system": "no"
    },
    {
      "text": "Slow cooling and segregation in cast refractory high-entropy alloys commonly produce brittle intermetallic phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
