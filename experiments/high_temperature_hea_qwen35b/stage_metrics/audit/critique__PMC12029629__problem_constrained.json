        "PMC5461481::chunk::002::discussion::aad813a188"
      ],
      "same_system": "no"
    },
    {
      "text": "Crystal orientation may change the critical resolved shear stress for partial-dislocation nucleation and the transition between thermally activated and athermal regimes.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Traditional FCC metals such as Cu and Al have higher strain-rate sensitivity because dislocation glide is easier and activation barriers are lower.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
