  "claims": [
    {
      "text": "HEA coatings on transition-metal matrices exhibit a non-monotonic relationship between ambient temperature and wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::hypothesis_evidence_v2::fbf664005e234ec9",
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Wear resistance initially improves as temperature rises because a protective tribo-oxide layer forms.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Beyond a critical temperature, excessive tribochemical reactions produce high friction and accelerated wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::hypothesis_evidence_v2::fbf664005e234ec9",
        "PMC7304825::hypothesis_evidence_v2::ea3e639539e10bc1"
      ],
      "same_system": "yes"
    },
    {
      "text": "CuMoTaWV can be deposited as a nanocrystalline RHEA coating on 304 stainless steel.",
