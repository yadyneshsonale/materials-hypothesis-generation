  "claims": [
    {
      "text": "The starting material consists of elemental Co, Cr, Fe, Ni, and Ti powders in equimolar proportions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
