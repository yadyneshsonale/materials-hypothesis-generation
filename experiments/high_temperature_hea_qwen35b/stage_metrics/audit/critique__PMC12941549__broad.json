      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed CoCrFeNiTi alloy will have compressive strength above 1800 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy density will be approximately 7.5 g/cm3.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
