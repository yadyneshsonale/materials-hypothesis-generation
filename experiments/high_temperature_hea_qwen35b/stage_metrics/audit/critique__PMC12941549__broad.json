      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical alloying of CoCrFeNiTi produces nanocrystalline solid-solution powder.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical alloying followed by SPS is a viable processing route for bulk CoCrFeNiTi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "CoCrFeNiTi should be SPS-consolidated at 1200-1300 °C for 10 minutes under vacuum or inert gas.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed alloy will have a stable dual-phase microstructure containing 83% FCC and 17% BCC.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy will retain a grain size below 48 nm.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined mechanical-alloying and SPS route controls phase stability, microstructural refinement, and mechanical-property optimization in CoCrFeNiTi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "yes"
    },
    {
      "text": "The FCC phase supplies ductility, whereas the BCC phase supplies hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation hardening contributes to the predicted property enhancement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A protective Cr2O3 surface layer forms during high-temperature exposure and suppresses further oxidation and corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed CoCrFeNiTi alloy will have Vickers hardness above 650 Hv.",
      "field": "predicted_outcome",
