      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial single crystal has an FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2",
        "PMC8398136::hypothesis_evidence_v2::765e878a36cb8b1b"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial crystal is free of pre-existing twins and HCP regions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocations nucleate at free surfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Pre-existing vacancy clusters act as dislocation-nucleation sites.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nucleation proceeds through emission of Shockley partial dislocations with Burgers vector 1/6<112>.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2",
        "PMC8398136::hypothesis_evidence_v2::765e878a36cb8b1b"
      ],
      "same_system": "yes"
    },
    {
      "text": "The emitted partial dislocations create intrinsic stacking faults.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The <110> orientation has a higher maximum yield stress than the <111> orientation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed orientation dependence of yield stress arises from differences in resolved shear stress on primary {111} slip planes.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The observed HCP-like regions are stacking faults rather than a true HCP phase transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HRTEM and SAED can discriminate stacking faults from a separate HCP phase through <111> diffraction streaking versus distinct HCP spots or rings.",
      "field": "falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chemical short-range order produces lattice friction that hinders partial-dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::hypothesis_evidence_v2::765e878a36cb8b1b"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation interactions form Lomer-Cottrell locks that contribute to work hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Yield strength is relatively insensitive to strain rate from 10^8 to 10^10 s^-1 because athermal dislocation-nucleation barriers dominate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yield strength decreases monotonically with temperature because thermal vibrations reduce the critical resolved shear stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yielding produces an abrupt stress drop followed by plastic flow mediated by partial dislocations and stacking faults.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The fraction of HCP-like regions increases with both strain and temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2",
        "PMC8398136::hypothesis_evidence_v2::765e878a36cb8b1b"
      ],
      "same_system": "yes"
    },
    {
      "text": "HCP-like regions remain stacking faults unless a critical defect density is reached to form a distinct phase.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::002::results_and_discussion::b39f44a3e2"
      ],
      "same_system": "yes"
    },
    {
      "text": "No FCC-to-BCC transformation occurs under the proposed conditions.",
