  "claims": [
    {
      "text": "The ball-milled Mg-Al-Ti-V-Fe-Co powder is a BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-energy ball milling can introduce oxygen contamination into the powder.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC5978046::hypothesis_evidence_v2::f7a616e2d022619d",
        "PMC6926650::hypothesis_evidence_v2::e3fc5e976e655c2d"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS between 800 °C and 1000 °C produces a specific beneficial microstructural evolution in Mg-Al-Ti-V-Fe-Co.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Within the 800-1000 °C window, enhanced atomic diffusion enables secondary-phase nucleation and growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS precipitates fine, coherent Ti-rich and Al-rich intermetallic phases such as TiAl and Ti3Al.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::hypothesis_evidence_v2::2f1d7d8457735f63",
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC5978046::hypothesis_evidence_v2::f7a616e2d022619d"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS produces Mg-deficient MgO and TiO2 oxide phases at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC5978046::hypothesis_evidence_v2::f7a616e2d022619d",
        "PMC6926650::hypothesis_evidence_v2::e3fc5e976e655c2d"
      ],
      "same_system": "no"
    },
    {
      "text": "The grain-boundary intermetallic and oxide phases act as diffusion barriers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The secondary phases increase hardness through precipitation strengthening.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC5978046::hypothesis_evidence_v2::f7a616e2d022619d",
        "PMC6926650::hypothesis_evidence_v2::e3fc5e976e655c2d",
        "PMC7513042::hypothesis_evidence_v2::9c16f9976e960c5c"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed diffusion barriers suppress magnesium volatilization during SPS.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing magnesium loss reduces porosity and increases the sintered density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::hypothesis_evidence_v2::2f1d7d8457735f63"
      ],
      "same_system": "no"
    },
    {
      "text": "The secondary phases produce a continuous, self-healing passive film.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::hypothesis_evidence_v2::2f1d7d8457735f63"
      ],
      "same_system": "no"
    },
    {
      "text": "The passive film increases both oxidation and corrosion resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::hypothesis_evidence_v2::2f1d7d8457735f63"
      ],
      "same_system": "no"
    },
    {
      "text": "The overall mechanism is diffusion-controlled and secondary-phase kinetics are optimized between 800 °C and 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 1000 °C, magnesium volatility causes composition deviation, porosity, and loss of barrier continuity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below 800 °C, insufficient diffusion or driving force prevents secondary-phase formation and bulk consolidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The identity and barrier role of the secondary phases may vary with initial oxygen content and milling parameters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34",
        "PMC5978046::hypothesis_evidence_v2::f7a616e2d022619d",
        "PMC6926650::hypothesis_evidence_v2::e3fc5e976e655c2d"
      ],
      "same_system": "no"
    },
    {
      "text": "A sample sintered at 900 °C should have a continuous, thin, protective oxide layer and parabolic oxidation kinetics.",
      "field": "falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A sample sintered at 1050 °C should have a discontinuous, thick, non-protective oxide layer and linear or accelerated oxidation kinetics because of magnesium loss and porosity.",
      "field": "falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Parabolic oxidation kinetics would indicate diffusion-controlled oxidation.",
      "field": "falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "If oxidation is surface-reaction-limited, oxidation kinetics would not correlate with the observed bulk microstructural evolution.",
      "field": "falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
