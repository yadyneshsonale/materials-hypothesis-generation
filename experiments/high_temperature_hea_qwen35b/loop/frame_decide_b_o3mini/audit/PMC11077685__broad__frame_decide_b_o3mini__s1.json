  "claims": [
    {
      "text": "Adding 0.1–0.5 wt% yttrium to a refractory high-entropy alloy will improve its high-temperature oxygen resistance.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium addition will promote formation of a stable oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium addition will promote formation of an adherent oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yttrium-modified alloy will form a continuous oxide scale during exposure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale may incorporate yttrium oxides.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The continuous oxide scale will act as a barrier to oxygen ingress.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium will segregate to oxide grain boundaries during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium segregation will enhance protective-scale adhesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium segregation will enhance protective-scale stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved scale adhesion and stability will reduce the oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A comparable reactive-element effect occurs in nickel-based superalloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical exposure conditions, the yttrium-doped alloy will have lower oxidation weight gain than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical exposure conditions, the yttrium-doped alloy will have a thinner oxide layer than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under identical exposure conditions, the yttrium-doped alloy will have a more coherent oxide layer than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated refractory alloy exhibits rapid oxidation under extreme-temperature conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated refractory alloy forms a less adherent oxide scale under extreme-temperature conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement is expected at approximately 1100°C during approximately 100 hours of exposure to air or oxygen.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of oxidation reduction may depend on yttrium concentration and alloy microstructure.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
