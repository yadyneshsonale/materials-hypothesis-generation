      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy previously showed limited amorphous retention after rapid quenching.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy exhibits a complex thermal response involving early crystallization during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 2 atomic % boron should be added to the baseline alloy.",
