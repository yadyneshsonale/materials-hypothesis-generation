      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incorporating Mo into TiVNbTa will improve high-temperature phase stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo modification will increase TiVNbTa yield strength at 1273 K by roughly 20–30% relative to the 330 MPa baseline.",
