      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Moderately annealed samples will have higher fracture toughness than the as-cast homogeneous baseline.",
