      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti addition and aging treatment will not compromise the high saturation magnetization of the base alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
