  "claims": [
    {
      "text": "Premelting and melting in Fe–Ni–Cr–Co–Cu nanoparticles are governed by thermally activated Cu surface segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "A compositionally distinct Cu-enriched surface layer initiates melting in Fe–Ni–Cr–Co–Cu nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The starting Fe–Ni–Cr–Co–Cu nanoparticles are initially solid and chemically homogeneous.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant particle-size range is approximately 5–20 nm.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled in situ heating from room temperature to above the bulk melting point can resolve the proposed premelting and melting sequence.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu segregation produces a surface-to-core compositional gradient.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cu-enriched surface layer acts as a liquid nucleation site.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Copper has a lower melting point and higher diffusivity than Fe, Ni, Cr, and Co under the relevant nanoparticle conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Copper's lower melting point and higher diffusivity drive its preferential migration to the nanoparticle surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Cu surface segregation reduces the local surface melting temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The reduced local melting temperature promotes a liquid-like surface layer that initiates whole-particle melting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Cu-containing Fe–Ni–Cr–Co–Cu nanoparticles will begin surface melting earlier than comparable Cu-deficient or less chemically complex particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature will produce a detectable Cu-enriched compositional gradient at the nanoparticle surface.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Region-specific surface melting and elemental redistribution should be observable using in situ STEM and EDX mapping.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies primarily below approximately 20 nm, where surface effects dominate.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism may not apply to bulk samples or HEAs with substantially different elemental proportions.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Absence of Cu surface enrichment before or during premelting would falsify the proposed Cu-segregation mechanism.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equivalent premelting behavior in Cu-containing and Cu-deficient controls would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
