{
  "run_id": "PMC11279088__expert_context__text_chunks_mbr_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "In CrFeCoNiX alloys, formation and persistence of a protective oxide above 900 °C are governed by segregation of X to the oxide/alloy interface.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al or Si preferentially reacts with oxygen at the surface of CrFeCoNiX alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 and SiO2 are thermodynamically stable oxides that can provide high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 or SiO2 scales formed on the proposed alloys have low oxygen diffusivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective Al2O3 or SiO2 scale has a close lattice match with the underlying CrFeCoNiX alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusivity through the protective scale produces slow, parabolic oxide-growth kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "no"
    },
    {
      "text": "Close lattice matching minimizes thermal-expansion mismatch and internal scale stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower scale stresses prevent oxide cracking and spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn and X-free CrFeCoNi exhibit inadequate reactive-element segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inadequate reactive-element segregation leads to poorly adherent oxide scales.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiAl and CrFeCoNiSi will form continuous, adherent oxide layers above 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "no"
    },
    {
      "text": "CrFeCoNiAl and CrFeCoNiSi will exhibit slower, parabolic oxidation kinetics than CrFeCoNiMn and X-free CrFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "no"
    },
    {
      "text": "CrFeCoNiMn and X-free CrFeCoNi will form discontinuous, rapidly growing oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxides on CrFeCoNiMn and X-free CrFeCoNi will be more prone to cracking and spallation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Al- or Si-mediated behavior is expected to hold in oxidative or corrosive atmospheres above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104",
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "no"
    },
    {
      "text": "The processing route may affect the proposed oxidation behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Phase distribution in a multiphase CrFeCoNiX alloy may complicate its corrosion or oxidation behavior.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "yes"
    },
    {
      "text": "The quantitative effects of Al or Si on oxide-growth rate and stress reduction are not established.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "no"
    }
  ],
