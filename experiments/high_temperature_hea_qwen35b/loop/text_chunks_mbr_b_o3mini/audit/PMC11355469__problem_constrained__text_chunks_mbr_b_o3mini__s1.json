  "claims": [
    {
      "text": "A controlled pre-oxidation heat treatment will form a surface oxide layer on the FeNiCrCoCu coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "no"
    },
    {
      "text": "The pre-formed oxide layer will be Cr-rich or a Cr-containing mixed oxide.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-formed oxide layer will be thin, coherent, and continuous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer will limit direct metal-to-metal contact during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer will inhibit grain-boundary sliding during high-temperature sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer will inhibit dislocation motion during high-temperature sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will decrease the rate of tribo-oxidation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation will decrease mechanical degradation of the coating during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will have a lower wear rate than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-oxidized coating will undergo less microscopic plastic deformation than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted wear and deformation benefits should occur during sliding in an oxidizing atmosphere at approximately 400–600°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures or in inert atmospheres, the pre-formed oxide layer's effect on wear may be diminished or different.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-layer structure and composition depend on oxidation temperature and environment.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99",
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "no"
    },
    {
      "text": "The optimum oxide-layer thickness, composition, and microstructure for maximizing wear reduction are not known.",
