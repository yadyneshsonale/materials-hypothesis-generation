  "claims": [
    {
      "text": "Wear performance of HEA protective coatings is governed by coherent nanoprecipitates formed during processing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline coating has a homogeneous, single-phase microstructure without a significant nanoprecipitate dispersion.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled heat treatment or adjusted deposition parameters can trigger stepwise coherent nanoprecipitation in an HEA coating.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent nanoprecipitates remain stable from room temperature to moderately elevated wear-test temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant structural mediator is a fine dispersion of coherent secondary-phase nanoparticles in the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitates act as barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The nanoprecipitates reduce shear-band formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitates reduce local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The nanoprecipitates constrain localized plastic deformation during wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoprecipitation increases coating hardness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanoprecipitation lowers the coating wear rate and material loss.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoprecipitates improve load distribution during wear.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitates reduce crack initiation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The beneficial wear effect holds under moderate stresses and temperatures typical of protective-coating tests.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial wear effect diminishes above the stability range of the nanoprecipitates.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimal nanoprecipitate size, volume fraction, and distribution vary with HEA composition.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Quenching the comparison samples will maintain a single-phase microstructure while heat treatment induces coherent nanoprecipitates.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure of precipitate-bearing coatings to show both a statistically significant hardness increase and wear-rate reduction relative to the baseline would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
