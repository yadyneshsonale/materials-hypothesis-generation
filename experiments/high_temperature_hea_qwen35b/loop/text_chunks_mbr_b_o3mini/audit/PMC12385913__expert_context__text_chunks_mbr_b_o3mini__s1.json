      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "V contributes to improved high-temperature mechanical behavior in refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::001::introduction::03a7cc91e7"
      ],
      "same_system": "no"
    },
    {
