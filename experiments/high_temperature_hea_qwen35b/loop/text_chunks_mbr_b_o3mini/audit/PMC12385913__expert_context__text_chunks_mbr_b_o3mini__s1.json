      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti and Zr preferentially segregate to grain boundaries in WTaTiVZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ta contributes to the proposed enhancement of the alloy's mechanical behavior.",
