  "claims": [
    {
      "text": "The as-fabricated Al0.2Co1.5CrFeNi1.5Ti0.3 alloy has a homogeneous FCC matrix with relatively uniform elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-fabricated alloy contains no concentrated grain-boundary oxides or embrittling phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature oxidizing exposure selectively oxidizes Al and Cr in the target alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "no"
    },
    {
      "text": "Selective oxidation and segregation are concentrated at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary oxidation forms brittle oxide precipitates or films.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178",
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "no"
    },
    {
      "text": "Brittle grain-boundary phases weaken intergranular cohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178"
      ],
      "same_system": "no"
    },
    {
      "text": "Brittle grain-boundary phases act as stress concentrators and crack-initiation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain-boundary embrittlement can produce brittle or catastrophic failure under mechanical loading.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant oxide products include alumina and chromia.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature diffusion promotes Al and Cr segregation to grain boundaries in the target alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178"
      ],
      "same_system": "no"
    },
    {
      "text": "The grain-boundary oxides formed in the target alloy are adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing or inert atmospheres suppress selective grain-boundary oxidation relative to oxygen-rich exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing oxidation under reducing or inert exposure preserves ductility and toughness and delays failure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will produce thicker and more continuous grain-boundary oxide films than the starting state or reducing-atmosphere control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will reduce ductility and cause earlier catastrophic failure relative to reducing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation and diffusion-driven degradation are applicable over approximately 700–1050 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "no"
    },
    {
      "text": "Changing only the exposure atmosphere while holding temperature and time fixed can test whether oxidation governs degradation.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to observe either increased grain-boundary oxidation or degraded mechanical performance in oxidizing exposure relative to reducing exposure would falsify the proposed governing mechanism.",
      "field": "falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
