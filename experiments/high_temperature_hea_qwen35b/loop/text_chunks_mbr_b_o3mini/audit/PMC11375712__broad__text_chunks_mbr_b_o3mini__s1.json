      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed domain-wall pinning occurs without formation of secondary phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
