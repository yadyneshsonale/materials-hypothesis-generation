  "claims": [
    {
      "text": "Controlled processing can form coherent nanoprecipitates in a high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "A conventional HEA can begin as a uniform solid solution and subsequently form coherent nanoprecipitates under appropriate processing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitates create interfaces that are well aligned with the matrix lattice.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The nanoprecipitate interfaces are reversible under dynamic loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitates impede dislocation motion and thereby contribute to strengthening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitate interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dislocation transmission across coherent interfaces is reversible.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent interfaces reduce local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relieving stress concentrations delays premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent nanoprecipitation can produce high strength without sacrificing tensile ductility in a tungsten refractory HEA.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strength-and-ductility benefit persists under dynamic mechanical loading.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dynamic loading, an HEA with coherent nanoprecipitates will have higher yield strength and greater ductility than the same HEA with incoherent precipitates or random solute clustering.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coherent-precipitate sample will show more efficient dislocation transmission and fewer stress-concentration sites than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "An HEA with incoherent precipitates or random solute distributions exhibits a conventional strength-ductility trade-off.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior applies at ambient and moderately elevated temperatures within the operational range of refractory HEAs.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The mechanism applies only while the precipitates remain stable and below temperatures causing significant coarsening or dissolution.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism generalizes from tungsten refractory HEAs to multiprincipal-element alloys that form coherent precipitates.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The temperature dependence and strain-rate sensitivity of the mechanism may vary among HEA systems.",
      "field": "uncertainty",
