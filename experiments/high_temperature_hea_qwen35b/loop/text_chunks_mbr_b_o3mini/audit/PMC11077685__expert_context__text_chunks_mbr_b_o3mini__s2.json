      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding approximately 5 at.% Al to equiatomic cast HfNbTaTiZr will improve its oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 5 at.% Al can be incorporated by partially substituting one or more of Hf, Nb, Ta, Ti, and Zr during melting.",
