      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will form a continuous, adherent Al2O3 scale during exposure at 800 °C in air.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
