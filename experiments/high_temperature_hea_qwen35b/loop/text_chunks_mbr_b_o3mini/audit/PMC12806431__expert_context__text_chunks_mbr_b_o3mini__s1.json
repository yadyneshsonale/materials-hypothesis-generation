  "claims": [
    {
      "text": "Sustained service-relevant thermal and mechanical loading can induce nanoscale compositional fluctuations in an initially single-phase HEA.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The induced compositional fluctuations or local chemical ordering occur preferentially at or near grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale grain-boundary heterogeneities act as weak interfacial links.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These nanoscale heterogeneities reduce toughness by compromising grain-boundary cohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Toughness degradation can occur without coarse grain-boundary segregation or large intermetallic precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is an as-cast HEA.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial HEA is single-phase and has a homogeneous microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial HEA has high ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial HEA is equimolar or near-equimolar.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::001::introduction::e75d2cc4bf"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Prolonged loading below the yield stress, combined with elevated temperature, allows local chemical reordering.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermal activation and mechanical stress provide the driving force for local chemical instability in the HEA matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The local chemical instability produces incipient nanoscale phase separation or ordering in intergranular regions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Exposed specimens will have lower fracture or impact toughness than the initial baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposed specimens will initiate cracks earlier at grain boundaries than the initial baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Toughness degradation will coincide with detectable nanoscale chemical heterogeneity at grain boundaries.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
