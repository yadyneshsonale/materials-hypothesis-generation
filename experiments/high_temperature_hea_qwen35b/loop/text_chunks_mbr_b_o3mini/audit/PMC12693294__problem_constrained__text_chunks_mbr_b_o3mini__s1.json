  "claims": [
    {
      "text": "Cr39Co18Fe18Ni18Al7 is initially a homogeneous, high-temperature disordered BCC phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cooling Cr39Co18Fe18Ni18Al7 from its high-temperature BCC state induces local chemical ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::004::conclusion::d17597a177"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The local chemical ordering during cooling is driven primarily by Cr segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr segregation nucleates nanoscale B2-type precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed B2 precipitates are Cr-enriched and form within a disordered BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Evolution of the ordered precipitate microstructure accounts for the apparent phase variability during cooling and subsequent thermal exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::004::conclusion::d17597a177"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Moderate atomic mobility permits local concentration fluctuations and activates the proposed ordering mechanism.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::001::introduction::fdf1475178"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermally activated diffusion allows Cr atoms to cluster as the alloy cools.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-rich clusters lower their local free energy by adopting an ordered B2 structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ordered B2 structure competes with a metastable disordered BCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Competition between diffusion kinetics and the thermodynamic driving force for ordering produces an inhomogeneous phase mixture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::004::conclusion::d17597a177"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlled cooling with an intermediate-temperature hold will produce more nanoscale B2 precipitates than rapid quenching.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Controlled cooling with an intermediate-temperature hold will produce more detectable Cr segregation than rapid quenching.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching will retain a largely single, disordered BCC phase with minimal local chemical ordering.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in local ordering and precipitation can alter ductility and produce brittle or ductile behavior.",
      "field": "predicted_outcome",
      "needs_support": true,
