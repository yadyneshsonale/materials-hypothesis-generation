      ],
      "same_system": "unclear"
    },
    {
      "text": "Differences in the proposed microstructure may produce measurable hardness differences.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
