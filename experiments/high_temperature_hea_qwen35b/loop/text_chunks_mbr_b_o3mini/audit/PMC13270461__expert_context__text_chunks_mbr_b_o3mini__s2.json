  "claims": [
    {
      "text": "The studied alloy is additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has a homogeneous, strength-optimized fcc matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The starting alloy has minimal pre-existing oxide coverage.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Selective oxidation of Ti and Cr at the surface primarily governs the alloy's elevated-temperature degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti and Cr have high oxygen affinity and therefore oxidize preferentially.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::000::abstract::779028fdaa"
      ],
      "same_system": "no"
    },
    {
      "text": "An oxidizing atmosphere produces a continuous, adherent Cr-Ti-rich surface oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::000::abstract::779028fdaa"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-Ti-rich scale is slow-growing and restricts further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide scale limits degradation of the underlying fcc matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective scale preserves bulk strength and fatigue performance during oxidizing exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing atmospheres do not promote formation of a stable protective scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under reducing conditions, oxygen ingress proceeds more rapidly along grain boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure produces more grain-boundary internal oxidation and microstructural damage than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure will produce a thin, coherent Cr-Ti oxide layer with limited internal oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::000::abstract::779028fdaa"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed mechanism applies from 750 to 900 °C for exposure durations up to 100 hours.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::000::abstract::779028fdaa"
      ],
      "same_system": "no"
    },
    {
      "text": "Identical specimens should be compared at 800 °C for 100 hours in oxidizing and reducing atmospheres under otherwise identical thermal cycles.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide thickness, continuity, composition, internal oxidation, fcc-phase retention, and mechanical-property changes can distinguish the proposed mechanism.",
      "field": "falsification_experiment.measurements",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::000::abstract::779028fdaa"
