  "claims": [
    {
      "text": "As-cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic HfNbTaTiZr has poor oxidation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 2 at.% Al can be incorporated into HfNbTaTiZr during melting or alloying.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 2 at.% Al to HfNbTaTiZr will produce a continuous, adherent Al2O3 surface layer during high-temperature oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al preferentially oxidizes at high temperature to form a stable alumina scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina scale will act as a barrier to further oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina barrier will prevent rapid oxidation-related degradation of the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 2 at.% Al will leave the internal microstructure responsible for mechanical performance largely intact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "Relative to untreated HfNbTaTiZr, the Al-modified alloy will exhibit lower oxidation weight gain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to untreated HfNbTaTiZr, the Al-modified alloy will form a thinner and more protective oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain 8–16% room-temperature tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will retain a yield strength within 163–530 MPa at 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxidation-resistance improvement is expected around 1000 °C in moderately oxidizing environments such as air for exposures on the order of 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance may differ at substantially different temperatures or much higher oxygen pressures.",
      "field": "boundary",
      "needs_support": false,
