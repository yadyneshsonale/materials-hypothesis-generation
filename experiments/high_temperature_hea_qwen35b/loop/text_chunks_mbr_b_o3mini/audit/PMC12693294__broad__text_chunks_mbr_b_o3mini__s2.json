  "claims": [
    {
      "text": "Phase stability in Al–Co–Cr–Fe–Ni alloys is governed by a balance between B2 ordering tendency and destabilization from configurational entropy, atomic-size mismatch, and electronic mismatch.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Co with Cr promotes decomposition from an ordered B2 phase into an ordered B2 plus disordered BCC mixture.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2 plus BCC mixture compromises low-temperature or cryogenic toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The B2 plus BCC mixture compromises radiation tolerance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The two-phase mixture can increase high-temperature strength through precipitation strengthening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "A Co-rich Al–Co–Cr–Fe–Ni baseline can exhibit a single ordered B2 phase at high temperature.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The single-B2 baseline has desirable high-temperature strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The single-B2 baseline has desirable environmental resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The single-B2 baseline has desirable radiation tolerance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The single-B2 baseline has desirable cryogenic toughness.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic-size misfit and electronic interactions introduced by additional Cr mediate the emergence of the disordered BCC phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High configurational entropy initially favors a single-phase ordered structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr favors a different local bonding environment and creates lattice distortion that overcomes B2 ordering stabilization.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr substitution triggers either spinodal or nucleation-limited decomposition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittle interfaces in the dual-phase microstructure cause reduced cryogenic toughness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Brittle interfaces reduce the alloy's ability to tolerate radiation-induced defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher-Cr alloys will have increased high-temperature microhardness relative to the Co-rich baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
