      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Single-component Ag has minimal lattice distortion relative to CoNiCrFeMn.",
