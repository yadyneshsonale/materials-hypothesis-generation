      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local lattice distortions create localized stress fields that influence defect mobility.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "unclear"
    },
    {
