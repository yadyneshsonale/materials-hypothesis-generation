      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to Ag, CoNiCrFeMn is expected to activate twinning or phase transformation during deformation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to Ag, CoNiCrFeMn should be stronger but potentially less ductile.",
