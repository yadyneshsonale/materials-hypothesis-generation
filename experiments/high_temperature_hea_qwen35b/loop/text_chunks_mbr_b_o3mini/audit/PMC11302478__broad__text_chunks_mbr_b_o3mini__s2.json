      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Relative to Ag, CoNiCrFeMn is expected to show slower or otherwise altered dislocation motion.",
