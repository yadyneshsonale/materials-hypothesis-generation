{
  "run_id": "PMC11279088__broad__text_chunks_mbr_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Reactive elements such as Al and Cr preferentially diffuse along grain boundaries to the alloy surface at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing grain-boundary density enhances transport of reactive elements from the bulk toward the surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Surface enrichment in Al or Cr produces alumina or chromia during oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The resulting alumina or chromia layer is uniform, continuous, and adherent.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alumina and chromia grow slowly and impede oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide diffusion barrier self-limits further oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine-grained HEAs will develop a more uniform and continuous protective oxide than coarse-grained HEAs of the same bulk composition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine-grained HEAs will oxidize more slowly than coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine-grained samples will show lower oxidation-related mass gain than coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine-grained samples will exhibit less oxide spallation than coarse-grained samples.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A sparse grain-boundary network can produce less continuous scales and accelerated oxidation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed behavior is applicable in oxidizing environments at 850–1050 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective-scale formation by this mechanism requires sufficient Al and/or Cr.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "HEAs lacking Al and Cr may not follow the proposed protective-oxide mechanism.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-containing HEAs do not necessarily form protective chromia under high-temperature oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relative contributions of grain-boundary diffusion and bulk diffusion are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation mechanism may depend on alloy composition and processing history.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c",
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A controlled comparison should hold bulk composition and oxidation conditions constant while varying grain-boundary density.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism would be falsified if fine-grained samples show neither a significantly lower oxidation rate nor a more continuous and adherent scale than coarse-grained controls.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
