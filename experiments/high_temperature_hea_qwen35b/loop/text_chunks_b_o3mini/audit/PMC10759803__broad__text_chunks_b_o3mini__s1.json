  "claims": [
    {
      "text": "Al10Co25Cr8Fe15Ni36Ti6 is presented as a representative baseline alloy composition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec",
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The representative baseline has a primarily single-phase BCC or FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline has acceptable room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline has insufficient high-temperature strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Molybdenum is a lightweight refractory element suitable for a minor alloying addition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Approximately 1 at.% Mo can be added to the Al10Co25Cr8Fe15Ni36Ti6-based alloy for further optimization.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant mechanical evaluation uses tensile testing from room temperature to about 900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tensile conditions up to about 900 °C are representative of jet-turbine service.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 1 at.% Mo addition will trigger uniformly distributed, coherent nanoscale precipitates in the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec",
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mo nucleates and stabilizes the proposed coherent nanoprecipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec",
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent nanoprecipitates impede dislocation motion at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation caused by the Mo addition will increase high-temperature tensile or yield strength relative to the Mo-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "no"
    },
    {
      "text": "The Mo addition will not significantly alter the matrix at room temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature ductility and other room-temperature mechanical performance will be maintained or only minimally affected.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1 at.% Mo will cause only a negligible density increase.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect occurs only in a narrow Mo-content range around 1 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed beneficial effect persists up to temperatures near 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "yes"
    },
    {
      "text": "Higher Mo concentrations or temperatures significantly above 900 °C may cause adverse phase evolution or over-precipitation that compromises performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
