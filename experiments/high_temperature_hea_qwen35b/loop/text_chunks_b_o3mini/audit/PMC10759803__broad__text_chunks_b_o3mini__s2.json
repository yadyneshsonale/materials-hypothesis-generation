  "claims": [
    {
      "text": "The NbMoTaW-based refractory HEA baseline has adequate room-temperature performance but limited high-temperature strength.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 1–2 at.% Hf is an appropriate minor-alloying intervention for the proposed refractory HEA.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf addition will cause in situ formation of Hf-rich nanoprecipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-rich nanoprecipitates will be coherent with the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The matrix containing the nanoprecipitates will be BCC.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent nanoprecipitates will obstruct dislocation motion through Orowan looping.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitation can improve high-temperature strength in a refractory HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent nature of the precipitates will preserve room-temperature ductility by limiting stress concentration and premature cracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The low precipitate volume fraction will prevent a significant density penalty.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-modified alloy will have 15–30% higher high-temperature yield and tensile strength than the Hf-free baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed strength benefit will hold under tensile loading at approximately 800–900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The Hf-free refractory HEA has lower tensile strength at temperatures of at least 800 °C than the proposed Hf-modified alloy.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–2 at.% Hf will have no notable adverse effect on room-temperature mechanical performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Adding 1–2 at.% Hf will cause only a negligible increase in alloy density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess Hf or improper processing could produce coarse precipitates or intermetallic phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coarse precipitates or intermetallic phases produced by excess Hf could reduce ductility and increase density.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
