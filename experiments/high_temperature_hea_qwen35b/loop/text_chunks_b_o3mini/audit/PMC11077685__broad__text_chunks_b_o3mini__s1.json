{
  "run_id": "PMC11077685__broad__text_chunks_b_o3mini__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Applying a Si-20Cr-20Fe fused-slurry silicide coating to MoNbTaTiW RHEA improves its high-temperature oxidation resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating produces a self-healing silicide/oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The uncoated MoNbTaTiW alloy has a BCC solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Si-20Cr-20Fe coating can be prepared on MoNbTaTiW RHEA by a fused slurry method.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial coating has an outer high-silicon MSi2 layer and an inner lower-silicon M5Si3 layer.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating is expected to be effective at approximately 1000 °C in air for up to 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During high-temperature oxidation, silicon diffuses from the coating toward the MoNbTaTiW substrate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation converts the coating into an outer oxide layer and an inner silicide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The silicide layer moves inward into the substrate and increases in thickness during oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting silicide scale is dense and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon diffusion promotes a continuous, slow-growing protective silicide/oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective scale retards oxygen ingress and mitigates rapid oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will have significantly lower oxidation mass gain than the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will develop a more coherent and less spallation-prone oxide scale than the uncoated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
