      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment can increase yield and ultimate tensile strength by approximately 50% or more relative to the untreated state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "yes"
    },
    {
