  "claims": [
    {
      "text": "The protective coating has an intrinsic positive lattice misfit between its FCC matrix and BCC or ordered precipitate phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Positive lattice misfit drives formation of a coherent, rafted microstructure under sustained load and moderate temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The rafted architecture creates high-energy interfaces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The rafted interfaces impede diffusion-controlled dislocation climb and thereby retard creep deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060",
        "PMC7512559::chunk::003::discussion::49b8051d92"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-deposited coating consists of an FCC matrix containing finely dispersed BCC or L12-type ordered precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Engineering greater positive misfit through enhanced precipitate coherence and volume fraction will promote rafting.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 550–600 °C under moderate constant stress, diffusion-assisted dislocation climb is active in the coating.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::chunk::003::discussion::49b8051d92"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dynamic recrystallization and other phase transformations are minimal under the proposed test conditions.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Positive misfit causes BCC precipitates to self-organize into rafts within the FCC matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "The coherent FCC/precipitate interface has high anti-phase-boundary energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High anti-phase-boundary energy makes dislocation climb across the interface energetically unfavorable.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The primary creep mechanism is stress-assisted dislocation climb controlled by lattice diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::chunk::003::discussion::49b8051d92"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Slowing stress-assisted dislocation climb increases the coating's creep resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060",
        "PMC7512559::chunk::003::discussion::49b8051d92"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Misfit-engineered coatings will have a lower steady-state creep strain rate than baseline coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Misfit-engineered coatings will show delayed onset of tertiary creep relative to baseline coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
