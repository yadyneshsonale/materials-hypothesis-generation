        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will retain room-temperature tensile ductility in the 8–16% range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
