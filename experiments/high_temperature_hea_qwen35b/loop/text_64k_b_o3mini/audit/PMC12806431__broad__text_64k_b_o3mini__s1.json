  "claims": [
    {
      "text": "Toughness retention in high-entropy alloys is governed by a balanced dual-phase microstructure containing finely dispersed coherent precipitates or lamellae.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1",
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Maintaining an optimal precipitate size and interface coherence during thermal exposure preserves toughness.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Precipitate coarsening or loss of interface coherence causes toughness loss.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed initial material is an as-cast equiatomic or near-equiatomic high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An FCC high-entropy matrix can contain coherent L1_2-type strengthening precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed initial dual-phase state has a favorable combination of strength and ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1",
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlled thermal or high-pressure high-temperature treatment can tune the precipitate structure and interface coherence.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging below approximately 700 °C for a suitable time promotes precipitate nucleation without significant coarsening.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert aging atmosphere prevents oxidation that could interfere with the proposed behavior.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate volume fraction, size, and coherence determine dislocation mobility and stress distribution during deformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1",
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitates promote dislocation slip, twinning, and transformation-induced plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A coherent-interface microstructure reduces local stress concentrations and suppresses interfacial cracking.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Over-aging-induced precipitate coarsening or incoherence creates localized strain concentrations that facilitate crack initiation and propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimally treated samples will have higher fracture toughness than the as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimally treated samples will have greater tensile ductility than the as-cast baseline.",
