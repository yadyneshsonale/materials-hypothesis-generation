  "claims": [
    {
      "text": "The starting high-entropy alloy is a homogeneous, precipitate-free, single-phase BCC or FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated mechanical loading causes local atomic rearrangements in the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress-assisted atomic rearrangements nucleate and grow nanoscale brittle secondary phases or clusters.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::000::abstract::0c0fe3ff2a",
        "PMC5578249::chunk::001::introduction::c4f919e1c8"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The stress-induced secondary phases preferentially form at grain boundaries or other stress-concentration sites.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The secondary phases may be brittle intermetallic or HCP phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::000::abstract::0c0fe3ff2a",
        "PMC5578249::chunk::001::introduction::c4f919e1c8"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Localized plastic deformation and stress concentrations accelerate local atomic mobility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated atomic mobility causes segregation or ordering into brittle clusters or precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting precipitates hinder dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting precipitates provide crack-nucleation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the inhomogeneities reduces toughness and causes a transition from ductile to brittle fracture.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::000::abstract::0c0fe3ff2a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanically pre-strained or cyclically loaded specimens will contain a higher density of nanoscale precipitates than the as-processed baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanically loaded specimens will have lower strain to failure than the as-processed baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::000::abstract::0c0fe3ff2a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Mechanically loaded specimens will exhibit brittle fracture features such as cleavage facets and little plastic deformation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::000::abstract::0c0fe3ff2a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial single-phase baseline has high toughness and ductility under low-load conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies under sustained or cyclic stress close to or above a significant fraction of yield strength.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures around 500–600 °C are representative service-relevant conditions for the proposed creep or fatigue tests.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High stress and service temperature promote stress-assisted diffusion and phase transformation in demanding aerospace or structural service.",
      "field": "boundary",
