  "claims": [
    {
      "text": "The baseline is a low-density refractory HEA based on Nb, Ta, V, and Ti.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy has moderate high-temperature strength and limited performance under sustained high-temperature loading.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy maintains good room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 1 at.% Mo should be introduced as a microalloying addition.",
