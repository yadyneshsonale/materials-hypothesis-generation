      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "no"
    },
    {
      "text": "A 1 at.% Mo addition will trigger precipitation in the Nb-Ta-V-Ti-based refractory HEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates produced by Mo addition will be nanoscale and coherent with the matrix.",
