      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "The precipitates will be enriched in Mo and finely dispersed.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent nanoprecipitates will obstruct high-temperature dislocation glide through precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitation can combine high strength with retained tensile ductility in a refractory HEA.",
