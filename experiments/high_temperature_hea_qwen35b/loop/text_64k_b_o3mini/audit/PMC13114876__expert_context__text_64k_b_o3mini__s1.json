  "claims": [
    {
      "text": "Overall HEA degradation during tribo-corrosion is governed by the interplay between mechanical passive-film removal and subsequent film reformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tribological loading continuously removes the protective passive oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Passive-film reformation occurs through surface elemental enrichment.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Removing the passive film faster than it reforms accelerates localized corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated localized corrosion increases wear damage synergistically.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accelerated localized corrosion increases the corrosion component of damage.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial HEA surface has a homogeneous, thin passive oxide film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial passive film is enriched in Cr or Mn, which impart corrosion resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The selected HEA has established wear resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11355469::chunk::000::abstract::097bca92f1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The selected HEA has established oxidation resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HEA's heterogeneous elemental composition influences passive-film integrity and reformation kinetics.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Metal newly exposed by wear rapidly reacts with aggressive species in the corrosive medium.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The complex elemental makeup of an HEA can cause its reformed oxide to be non-uniform or less protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Localized corrosion undermines wear resistance and thereby accelerates material loss.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding in 3.5 wt% NaCl will produce a significantly higher total degradation rate than matched sliding in an inert medium.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosive test will produce greater wear depth than the inert baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosive test will produce higher corrosion current density than the inert baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The corrosive test will produce a more disrupted or thinner passive oxide film than the inert baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction should hold when passive-film formation is sensitive to mechanical abrasion.",
