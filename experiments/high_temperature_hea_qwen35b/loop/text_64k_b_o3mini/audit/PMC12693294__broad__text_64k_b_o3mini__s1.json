  "claims": [
    {
      "text": "An ordered B2 phase can coexist with a disordered BCC matrix in Al–Co–Cr–Fe–Ni alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Phase stability is governed by forming a nanoscale, coherent B2 phase in a disordered matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2-plus-disordered-matrix microstructure retains the combined high-temperature strength, environmental resistance, radiation tolerance, and cryogenic toughness of the alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dual-phase microstructure arises from competition between configurational entropy favoring a single-phase solid solution and local chemical ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0",
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Negative mixing enthalpies between Al and Cr or Co drive the proposed local ordering.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored aging treatment will nucleate a stable dispersion of nanoscale, coherent B2 precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coherent B2 precipitates are enriched in Al and Cr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Composition and annealing temperature determine the length scale of B2-plus-BCC decomposition.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The B2 precipitates impede dislocation motion and thereby enhance high-temperature strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "no"
    },
    {
      "text": "B2–matrix interfaces act as efficient defect sinks and improve radiation tolerance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates stabilize the distribution of protective oxide-forming elements and improve environmental resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine precipitate size and coherency preserve toughness at cryogenic temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The tailored alloy will have higher elevated-temperature tensile strength than the baseline.",
