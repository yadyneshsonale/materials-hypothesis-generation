      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7514651::chunk::000::abstract::ae847ae7a5"
      ],
      "same_system": "no"
    },
    {
      "text": "The tailored alloy will have higher elevated-temperature creep strength than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The tailored alloy will have lower oxidation and corrosion rates than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The tailored alloy will exhibit improved defect absorption under irradiation.",
      "field": "predicted_outcome",
