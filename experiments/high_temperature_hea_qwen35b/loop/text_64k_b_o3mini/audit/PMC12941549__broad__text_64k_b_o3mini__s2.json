  "claims": [
    {
      "text": "Lightweight high-entropy alloys can simultaneously combine low density, high mechanical strength, corrosion resistance, and high-temperature oxidation resistance when their composition is appropriately tuned.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1",
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A uniform dispersion of coherent nanoscale precipitates increases mechanical strength by impeding dislocation motion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoscale precipitates stabilize a protective surface oxide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Incoherent or coarsened precipitates prevent the alloy from combining the target mechanical, corrosion, and oxidation properties.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c",
        "PMC12806431::chunk::004::conclusion::d17597a177"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermal or high-pressure/high-temperature processing can induce coherent nanoscale secondary structures in high-entropy alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC11087546::chunk::000::abstract::0f6f5ee9c1"
      ],
      "same_system": "unclear"
    },
    {
      "text": "B2- or L1₂-type precipitates are suitable examples of the proposed coherent strengthening dispersion.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent nanoprecipitates produce a fine-scale, chemically ordered matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::004::conclusion::d17597a177",
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Fine-scale chemical ordering supports high mechanical strength.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12806431::chunk::004::conclusion::d17597a177",
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitate-containing, chemically ordered matrix supports formation of a slow-growing protective oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substitution with lighter alloying elements lowers alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lighter alloying elements induce local lattice distortions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::chunk::001::introduction::e80cc84e75"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Correct thermal processing stabilizes coherent nanoscale precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
