      "text": "Coherent precipitates promote formation and adhesion of a protective oxide layer during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to an otherwise comparable baseline without optimized precipitate coherence, the tuned alloy will have higher yield and tensile strengths.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
