  "claims": [
    {
      "text": "The initial material is equiatomic cast HfNbTaTiZr in the as-cast condition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C and strain rates of 10^-4–10^-2 s^-1.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of approximately 5 at% Al to HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5 at% Al will produce a stable protective alumina scale during elevated-temperature exposure in air.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An adherent alpha-Al2O3 layer will form on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will suppress internal oxidation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will suppress pesting reactions.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Added Al will partition to the surface under oxidizing conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting alumina scale will have low oxygen diffusivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low oxygen transport through the alumina scale will reduce oxidation kinetics and oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen ingress will reduce oxygen embrittlement in the alloy bulk.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will exhibit a lower scale-growth rate than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will exhibit less oxide spallation than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain mechanical properties with only minimal decline relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr has poor oxygen resistance in elevated-temperature air.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr suffers oxidation-induced embrittlement or pesting.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protective effect is expected to apply in air at temperatures up to approximately 800 °C, for no more than 5 hours, under moderate tensile loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Longer or higher-temperature exposures may require more Al or additional protective measures and may entail mechanical-property trade-offs.",
      "field": "boundary",
      "needs_support": true,
