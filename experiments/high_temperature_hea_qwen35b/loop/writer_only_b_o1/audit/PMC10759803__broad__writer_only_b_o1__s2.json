      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The 0.5 at% C alloy will retain room-temperature ductility comparable to undoped NbMoTaW.",
      "field": "predicted_outcome",
      "needs_support": true,
