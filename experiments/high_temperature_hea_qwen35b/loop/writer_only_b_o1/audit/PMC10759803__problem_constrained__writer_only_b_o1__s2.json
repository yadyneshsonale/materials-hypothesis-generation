      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloy is predicted to maintain or slightly increase mechanical strength at elevated temperatures up to approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is limited to as-cast material tested in tension or compression from ambient temperature to approximately 1000 °C.",
