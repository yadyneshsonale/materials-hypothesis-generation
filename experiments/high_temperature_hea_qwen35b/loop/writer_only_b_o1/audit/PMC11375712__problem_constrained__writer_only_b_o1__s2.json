      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Domain-wall pinning by B2 precipitates increases coercivity relative to single-phase fcc FeCoNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will increase coercivity significantly above 100 Oe.",
