  "claims": [
    {
      "text": "The baseline NbMoCrTiAl composite was processed by high-energy ball milling followed by spark plasma sintering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline composite contains approximately 32 vol% TiC and 7 vol% Al2O3.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline composite has a predominantly BCC solid-solution matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline composite has a room-temperature compressive fracture strength of approximately 1542 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline composite exhibits cleavage fracture with little or no room-temperature ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline's high compressive strength is due to reinforcement and grain refinement.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "A 5–10 vol% refractory second phase such as tungsten should be introduced during powder processing before sintering.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten would function as a ductile second-phase metal in this composite.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ductile phase must be uniformly dispersed without excessive agglomeration for the proposed improvement to occur.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added particles will act as deformation buffers at grain boundaries and within the matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added particles will enhance dislocation motion and grain-boundary sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added particles will inhibit the initiation and propagation of cleavage cracks.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added phase will provide plastic accommodation and redistribute local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The existing TiC and Al2O3 will continue to provide second-phase strengthening after addition of the ductile phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The TiC and Al2O3 reinforcements provide impact-induced energy release.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified composite will exhibit increased plastic strain at fracture and more uniform deformation than the untreated composite.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified composite will lose less than 15% of the untreated composite's compressive strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified composite will preserve impact-induced energy release relative to the untreated composite.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An excessive amount of the added phase may significantly reduce compressive strength.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An insufficient amount of the added phase may fail to produce the desired plasticity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
