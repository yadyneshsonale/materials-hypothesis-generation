  "claims": [
    {
      "text": "The baseline high-entropy alloy is produced by mechanical alloying and spark-plasma sintered at 850–950 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Little surface oxide-film development occurs at sintering temperatures of 850–950 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The comparison alloy is spark-plasma sintered at approximately 1000 °C.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Sintering at 1000 °C induces surface segregation or enrichment of Al and Fe.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The segregated elements react in situ with oxygen to form a spinel-type oxide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting oxide film is dense, continuous, spinel-type, and enriched in Al and Fe.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy sintered at 1000 °C possesses a resistive passive film.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide film limits penetration or diffusion of aggressive ions and thereby slows corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film increases surface hardness and thereby resists abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "Under modest mechanical stress, the film remains sufficiently intact to avoid premature spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During simultaneous sliding wear and corrosion, the 1000 °C alloy will have a lower corrosion current density than the 850–950 °C baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "During simultaneous sliding wear and corrosion, the 1000 °C alloy will exhibit less weight or material loss than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During simultaneous sliding wear and corrosion, the 1000 °C alloy will exhibit a lower friction coefficient than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy sintered at 1000 °C will have higher microhardness than alloys sintered at 850–950 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12941549::rubric_card::001::2d84cdcce9"
      ],
      "same_system": "yes"
    },
    {
      "text": "The lower-temperature baseline has increased wear because its oxide film is thinner or less continuous.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical loads exceeding the film's adhesion strength will cause spallation and diminish protection.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Environments that chemically destabilize the oxide will diminish its protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
