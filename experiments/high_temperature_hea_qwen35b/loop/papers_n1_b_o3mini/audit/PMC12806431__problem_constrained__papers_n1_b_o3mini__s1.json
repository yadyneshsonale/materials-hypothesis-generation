  "claims": [
    {
      "text": "The alloy is equiatomic Ta20Nb20Hf20Zr20Ti20.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial as-cast alloy is a single-phase BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial BCC state is a rapidly cooled, supercooled phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HIP processing induces a secondary HCP phase in addition to the initial BCC phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Slow cooling during HIP is the processing feature that enables formation of the HCP phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The BCC-to-BCC-plus-HCP transformation occurs through a eutectoid reaction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The secondary HCP phase is enriched in Zr and Hf.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HCP phase can be distributed homogeneously in the matrix or concentrated at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "HIP-treated gravity-cast specimens have an evenly dispersed HCP phase, whereas HIP-treated suction-cast specimens have HCP concentrated mostly at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The HCP precipitates are intrinsically brittle.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HCP precipitates hinder dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary HCP precipitates act as crack-initiation sites and promote inter-crystalline crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HIP-induced HCP precipitation causes reduced toughness and brittle fracture.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "HIP-treated specimens with pronounced HCP precipitation will have lower ductility and toughness than as-cast specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HIP-treated specimens with pronounced HCP precipitation will exhibit near-zero tensile elongation and brittle fracture characteristics.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-cast BCC baseline retains higher toughness and ductility under otherwise similar loading.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy was evaluated under room-temperature tensile and compression loading and under creep at 982°C and 120–200 MPa.",
      "field": "conditions",
