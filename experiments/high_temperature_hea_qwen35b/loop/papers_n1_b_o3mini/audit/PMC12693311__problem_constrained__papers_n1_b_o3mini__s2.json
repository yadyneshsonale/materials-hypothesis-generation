    {
      "text": "Cr16Mn16Fe16Co16Ni16P20 undergoes a multistep crystallization sequence during reheating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 2 at% boron should be added to the alloy before quenching.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed treatment uses cooling rates of approximately 10^3 K/s or higher.",
