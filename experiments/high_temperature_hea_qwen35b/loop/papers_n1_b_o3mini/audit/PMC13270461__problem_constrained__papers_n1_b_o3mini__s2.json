      "field": "hypothesis; structural_mediator; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide films formed during oxidizing exposure are initially protective but later crack under thermal or mechanical stress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure prevents formation of a protective oxide film.",
