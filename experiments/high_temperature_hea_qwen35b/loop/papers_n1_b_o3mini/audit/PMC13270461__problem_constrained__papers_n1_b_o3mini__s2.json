      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reactive-element-enriched grain boundaries serve as nucleation and growth sites for brittle secondary phases.",
