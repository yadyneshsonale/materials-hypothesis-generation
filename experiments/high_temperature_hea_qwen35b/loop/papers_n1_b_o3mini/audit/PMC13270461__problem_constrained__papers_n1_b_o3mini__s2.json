      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::rubric_card::000::831f456be3"
      ],
      "same_system": "no"
    },
    {
      "text": "Localized brittle phases and cracked oxides act as stress concentrators.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
