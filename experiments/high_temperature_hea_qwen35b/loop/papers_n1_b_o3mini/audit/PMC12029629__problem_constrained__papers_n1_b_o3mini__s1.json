  "claims": [
    {
      "text": "The Co-free FeNiCrMn alloy retains a favorable strength–ductility balance in its solidified solid-solution state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FeNiCrMn alloy is equiatomic.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The solidified FeNiCrMn alloy is a single-phase solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compositional randomness in FeNiCrMn produces inherent lattice distortions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice distortion modifies dislocation core structures in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified dislocation cores promote edge-dislocation glide with wavy dislocation lines.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation mobility in FeNiCrMn is strongly dependent on temperature and strain rate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature- and strain-rate-dependent dislocation mobility causes a transition in plastic-deformation behavior relative to the baseline state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compositional fluctuations create elastic distortions that displace dislocation cores from their usual neutral plane.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lattice distortions favor formation and motion of <111>{110} edge dislocations with irregular, wavy lines.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures and strain rates, lattice-distortion barriers impede dislocation glide and maintain high strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature thermally activates dislocation motion and reduces the effective glide barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature from the room-temperature, quasi-static baseline will reduce yield stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11206460::rubric_card::000::bd033a5c9c"
      ],
      "same_system": "no"
    },
    {
      "text": "Changing strain rate from the quasi-static baseline will reduce yield stress.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature or strain-rate changes will shift the work-hardening rate.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The onset of plasticity and dislocation mobility will correlate with the degree of lattice-distortion-induced core deviation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At room temperature and a quasi-static strain rate, edge-dislocation-dominated plasticity and resistance from lattice distortions are maximal.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed regime can extend to about 900°C while retaining a solid-solution state.",
