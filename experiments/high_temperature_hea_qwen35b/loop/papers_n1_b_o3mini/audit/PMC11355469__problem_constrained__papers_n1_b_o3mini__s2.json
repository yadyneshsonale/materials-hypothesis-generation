  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited FeNiCrCoCu coating has relatively larger or less optimized grains than the proposed annealed coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited FeNiCrCoCu coating has minimal preformed or controlled surface oxide.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled modification is a post-deposition anneal at approximately 300 °C or within the operating-temperature range.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "no"
    },
    {
      "text": "Post-deposition annealing refines the nanocrystalline grain structure of the FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-deposition annealing promotes formation of a thin CuO-rich surface layer on the FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement increases grain-boundary density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased grain-boundary density shifts coating plasticity from dislocation-mediated deformation to grain-boundary-controlled deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A thin CuO-rich layer formed at high temperature acts as a lubricious barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed CuO-rich barrier reduces direct metal-to-metal contact during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced direct metal-to-metal contact decreases wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the unannealed baseline, the annealed FeNiCrCoCu coating will have a lower wear rate during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the unannealed baseline, the annealed coating will show more grain-boundary-controlled microscopic deformation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealed coating may exhibit more intergranular fracture during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted effects hold approximately from 300 to 500 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "no"
    },
    {
      "text": "Within 300–500 °C, thermal energy promotes controlled oxidation and grain-boundary strengthening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At significantly lower temperatures, the proposed oxide-mediated wear mechanism may be inactive.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At excessively high temperatures, over-oxidation or deleterious grain growth may occur.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
