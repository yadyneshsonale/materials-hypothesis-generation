      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "An effective process should include homogenization, controlled rolling, short-duration annealing, and aging.",
