      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "Coherent precipitate interfaces relieve stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent precipitates permit dislocation shearing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stress relief and dislocation shearing delay crack initiation and thereby improve ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
