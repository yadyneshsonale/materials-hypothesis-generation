      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "no"
    },
    {
      "text": "Internal boundaries in dual-phase eutectic lamellar colonies are prone to microcracking during tensile deformation.",
