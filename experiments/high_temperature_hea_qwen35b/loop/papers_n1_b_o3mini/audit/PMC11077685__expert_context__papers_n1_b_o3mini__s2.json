      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5 at.% Al should be incorporated into equiatomic HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at.% Al will produce a continuous, thin, and adherent Al2O3 surface scale.",
