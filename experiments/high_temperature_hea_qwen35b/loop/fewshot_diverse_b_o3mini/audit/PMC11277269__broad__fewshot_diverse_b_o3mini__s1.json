      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to pure Pt, Pt-Ni catalysts will have greater current density at a given overpotential.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
