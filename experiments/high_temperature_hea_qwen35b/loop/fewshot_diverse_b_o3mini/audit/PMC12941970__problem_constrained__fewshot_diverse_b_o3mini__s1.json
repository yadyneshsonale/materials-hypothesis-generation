      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ag-modified alloy will have a coefficient of friction approximately 20–30% lower than baseline CoCrFeNi.",
