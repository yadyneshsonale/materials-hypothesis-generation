  "claims": [
    {
      "text": "The starting material is a homogeneous, single-phase CoCrFeNi high-entropy alloy produced by conventional melting.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 3 at.% W is added to the CoCrFeNi matrix during melting.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added W will be uniformly distributed in the alloy matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "During sliding, W at or near the surface will oxidize in situ to form WO3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding will produce a continuous, coherent, and adherent WO3 tribofilm on the worn surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WO3 tribofilm acts as a solid lubricant by lowering interfacial shear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WO3 tribofilm remains sufficiently stable to function from room temperature to 800 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower interfacial shear resistance from the WO3 tribofilm will reduce friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WO3 tribofilm will reduce wear over the full temperature range.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to undoped CoCrFeNi, CoCrFeNi containing approximately 3 at.% W will have significantly lower coefficient of friction from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to undoped CoCrFeNi, CoCrFeNi containing approximately 3 at.% W will have a reduced wear rate from room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped CoCrFeNi tends to develop less effective or non-uniform oxide scales.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped CoCrFeNi exhibits elevated friction and wear, particularly at high temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit is limited to oxidizing environments such as ambient air.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit may not occur in vacuum or inert atmospheres.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit may not persist under loading regimes drastically different from approximately 10 N.",
