  "claims": [
    {
      "text": "Single-phase fcc FeCoNi has high saturation magnetization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline single-phase fcc FeCoNi alloy has a coercive field of approximately 100 Oe.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "FeCoNi can accommodate approximately 2–3 at.% interstitial carbon while retaining a single-phase fcc structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Melt processing followed by rapid solidification is a suitable route for introducing 2–3 at.% carbon into fcc FeCoNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon induces local lattice distortions in fcc FeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial carbon induces internal stresses in fcc FeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-induced distortions may generate short-range ordering in fcc FeCoNi.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-induced distortions may produce local variations in magnetocrystalline anisotropy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-induced lattice distortions, anisotropy variations, and stress fields act as magnetic-domain-wall pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "These pinning sites increase the energy barrier for domain-wall motion and thereby increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–3 at.% interstitial carbon will increase the coercivity of single-phase fcc FeCoNi by at least 50% relative to a baseline of about 100 Oe.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–3 at.% interstitial carbon will not substantially reduce the high saturation magnetization of fcc FeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping the carbon content below approximately 3 at.% avoids secondary carbide formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon contents above the proposed range may produce carbide precipitates that adversely affect magnetic performance.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity response depends on carbon concentration and processing conditions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature quasi-static hysteresis measurements can determine whether carbon addition changes coercivity and saturation magnetization.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "X-ray diffraction or equivalent characterization can test whether the carbon-containing samples remain single-phase fcc and lack detectable carbide phases.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
