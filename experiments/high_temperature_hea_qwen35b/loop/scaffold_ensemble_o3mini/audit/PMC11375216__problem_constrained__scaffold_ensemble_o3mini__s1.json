  "claims": [
    {
      "text": "As-prepared bulk HfNbTaTiZr contains inherent crystallographic defects.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "One HfNbTaTiZr specimen contains a controlled addition of 1 wt.% oxygen.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Available conventional analytical conductivity models for HfNbTaTiZr assume perfect, defect-free crystals.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Crystallographic defects act as electronic scattering centers in bulk HfNbTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen impurities act as electronic scattering centers in bulk HfNbTaTiZr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Defect- and oxygen-induced scattering centers modify the alloy's conduction pathways.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Explicitly representing defects and oxygen impurities changes the model's predicted electron scattering and conduction properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accounting for realistic defects and oxygen impurities will improve agreement between predicted and measured conductivity relative to perfect-crystal analytical models.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced model will have lower conductivity-prediction error than conventional analytical methods in the nearly 0–200 K regime.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The enhanced model will have lower conductivity-prediction error than conventional analytical methods in the 300–1200 K regime.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvement applies to bulk HfNbTaTiZr specimens with oxygen levels near 1 wt.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact magnitude of the prediction improvement is uncertain because defect-defect and impurity-defect interactions are complex.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Evidence is limited regarding the quantitative effect of defect and impurity interactions on HfNbTaTiZr conductivity.",
      "field": "uncertainty",
