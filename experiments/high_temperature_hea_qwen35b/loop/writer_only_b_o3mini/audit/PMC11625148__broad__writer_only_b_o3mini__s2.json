      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–3 wt.% Y2O3 or a similar rare-earth oxide during processing promotes formation of finely dispersed oxide particles.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
