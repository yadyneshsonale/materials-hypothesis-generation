      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide-dispersed alloy will have better creep resistance than the alloy processed without oxide dispersoids.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanical improvements will occur without compromising thermal stability.",
      "field": "predicted_outcome",
      "needs_support": true,
