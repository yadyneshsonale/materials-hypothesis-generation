  "claims": [
    {
      "text": "Adding approximately 0.5–1 wt.% Hf to high-entropy-alloy bond coats will improve thermal-barrier-coating durability and reliability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-entropy-alloy bond coats typically used in TBC systems contain no reactive-element additions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf doping will promote formation of a stable, adherent Hf-rich oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-containing oxide scale will be dense and continuous.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf enrichment will occur at grain boundaries and at the bond-coat surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf acts as a reactive element in the proposed bond-coat system.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf will preferentially oxidize to form an Hf-rich oxide phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-rich oxide phase will enhance adhesion of the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-rich oxide phase will improve the barrier properties of the protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved oxide-scale barrier properties will mitigate rapid oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved oxide-scale adhesion will reduce spallation during thermal cycling.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen ingress and scale spallation will reinforce the mechanical integrity of the bond coat.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-doped bond coats will exhibit slower oxidation kinetics than untreated bond coats.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-doped bond coats will exhibit less oxide-scale spallation than untreated bond coats.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf doping will extend coating lifetime by approximately 20% or more relative to untreated bond coats.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed benefit will remain effective in oxidizing environments at approximately 1100–1200°C under thermal cycling.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit of Hf may be reduced under extreme thermal gradients.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The benefit of Hf may be reduced in environments containing additional aggressive species not represented in the proposed tests.",
      "field": "boundary",
