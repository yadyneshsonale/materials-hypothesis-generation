      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has inadequate long-term high-temperature performance for aerospace fasteners.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting alloy has inadequate corrosion resistance for aerospace fasteners.",
