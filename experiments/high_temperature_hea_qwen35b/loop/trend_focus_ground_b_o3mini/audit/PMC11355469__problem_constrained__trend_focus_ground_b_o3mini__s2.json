      ],
      "same_system": "no"
    },
    {
      "text": "Relative to the as-deposited coating, the pre-oxidized coating will exhibit a lower coefficient of friction.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
