  "claims": [
    {
      "text": "The starting material is an as-cast eutectic high-entropy alloy with a lamellar microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-cast lamellar microstructure is coarse to intermediate rather than fine.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The lamellar microstructure comprises a soft FCC-like phase and a hard BCC/B2 phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Isothermal annealing just below the lamellar coarsening threshold can refine the eutectic lamellae.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed annealing treatment reduces interlamellar spacing.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed annealing treatment improves coherence between the FCC-like and BCC/B2 interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Finer lamellae are more effective barriers to dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater resistance to dislocation motion increases strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature annealing preserves or enhances connectivity of the ductile FCC-like phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved connectivity of the FCC-like phase enhances strain accommodation and tensile ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Fine lamellar FCC/B2 eutectic structures can exhibit a combination of high strength and high tensile ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relative to the unannealed as-cast baseline, the annealed alloy will have higher yield strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the unannealed as-cast baseline, the annealed alloy will have higher tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The simultaneous strength and ductility improvement should occur under identical room-temperature or moderately elevated-temperature tensile testing.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing beyond a narrow optimized temperature-time window may coarsen the lamellae and negate the improvements.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effect depends on retention of a stable dual-phase structure and may fail if processing significantly shifts the phase balance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant simultaneous increase in yield strength and ductility relative to the as-cast control would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
