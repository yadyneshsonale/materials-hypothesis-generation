  "claims": [
    {
      "text": "The baseline single-phase fcc FeCoNi or its high-entropy derivative has high saturation magnetization and coercivity no greater than approximately 100 Oe.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to introduce 2–5 at.% Mo into FeCoNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at.% Mo to fcc FeCoNi will produce Mo-rich secondary precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-rich precipitates will be nanoscale, finely dispersed, and coherent with the fcc matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Composition changes and annealing conditions can cause phase decomposition and control its length scale in high-entropy alloys.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c",
        "PMC6197204::chunk::001::introduction::4e2212de98"
      ],
      "same_system": "no"
    },
    {
      "text": "An fcc high-entropy-alloy matrix can coexist with ordered secondary precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Mo-rich precipitates will enhance magnetocrystalline anisotropy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo-rich precipitates will act as pinning centers for magnetic domain walls.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restriction of domain-wall motion by the precipitates will increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compositionally induced phase decomposition can be associated with increased coercivity in a high-entropy alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 2–5 at.% Mo will raise coercivity well above 100 Oe.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 2–5 at.% Mo will preserve saturation magnetization to within approximately 10% of the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo-containing alloys should be compared with a 0% Mo control made using identical processing and annealing protocols.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis requires at least a 50% coercivity increase relative to the baseline, described as exceeding 150 Oe.",
