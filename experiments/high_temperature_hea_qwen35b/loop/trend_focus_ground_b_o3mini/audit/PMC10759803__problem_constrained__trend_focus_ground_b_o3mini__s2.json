  "claims": [
    {
      "text": "As-cast HfMoTaTiZr is a disordered BCC alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of approximately 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has high strength at room and elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is partial replacement of Hf by Al to form Hf1−xAlxMoTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Hf-to-Al substitution will reduce the density of HfMoTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf1−xAlxMoTaTiZr will retain a BCC solid-solution structure at an optimized substitution level.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with lower-atomic-mass Al reduces the alloy's average atomic mass and thereby its density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Retention of the BCC phase will preserve the alloy's solid-solution-strengthening benefits.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized Hf-to-Al substitution will retain mechanical strength comparable to as-cast HfMoTaTiZr at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "Optimized Hf-to-Al substitution will retain mechanical performance comparable to as-cast HfMoTaTiZr at approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "The cited AlCoCrFeNi2.1 eutectic HEA has an as-cast lamellar FCC/B2 microstructure and combines high tensile ductility with high fracture strength at room temperature.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "The cited AlCoCrFeNi2.1 alloy retains excellent mechanical properties up to 700 °C.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed operating boundary extends from room temperature to approximately 1000 °C under standard tensile or compressive loading.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimum Al substitution level and its effects on phase stability, microsegregation, and ductility are unknown and require experimental validation.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A greater than 10% reduction in tensile strength relative to as-cast HfMoTaTiZr would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of unwanted brittle phases absent from the original HfMoTaTiZr would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
