    {
      "text": "Adding less than 1 wt% boron to refractory high-entropy alloys improves their high-temperature mechanical capability.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding less than 1 wt% boron limits the alloy's density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding less than 1 wt% boron preserves room-temperature mechanical performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Boron addition forms boride precipitates along grain boundaries.",
