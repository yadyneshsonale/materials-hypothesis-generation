  "claims": [
    {
      "text": "Eutectic high-entropy alloys generally exhibit a trade-off between strength and ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f"
      ],
      "same_system": "yes"
    },
    {
      "text": "A hierarchical microstructure consisting of coarse and fine grains can be designed in eutectic high-entropy alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Introducing a coarse-and-fine-grained hierarchical microstructure can simultaneously increase strength and ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combination of coarse and fine grains facilitates dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "The combination of coarse and fine grains relieves stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "Facilitated dislocation transmission and relieved stress concentrations lead to improved strength and ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "no"
    },
    {
      "text": "Eutectic microstructures can provide a combination of high fracture strength and high tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hierarchical microstructure will improve both strength and ductility relative to a conventional eutectic high-entropy-alloy microstructure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed improvement should hold in structural applications requiring both high strength and high ductility.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The exact magnitudes of the strength and ductility improvements are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A comparative tensile study can test hierarchical and conventional eutectic high-entropy-alloy microstructures.",
