      ],
      "same_system": "no"
    },
    {
      "text": "Applying a SiO2 coating to equiatomic HfNbTaTiZr can improve its oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
