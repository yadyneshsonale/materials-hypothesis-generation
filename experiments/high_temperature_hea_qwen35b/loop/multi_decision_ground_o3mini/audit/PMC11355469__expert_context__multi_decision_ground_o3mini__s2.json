  "claims": [
    {
      "text": "The baseline is an as-deposited FeNiCrCoCu thin-film coating on a conventional metal substrate without a pre-formed oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled pre-oxidation heat treatment is applied before wear testing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized pre-oxidation temperature and duration will promote copper segregation.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Optimized pre-oxidation will produce a continuous surface oxide.",
