      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will have lower wear rates than untreated coatings under identical high-temperature sliding conditions.",
