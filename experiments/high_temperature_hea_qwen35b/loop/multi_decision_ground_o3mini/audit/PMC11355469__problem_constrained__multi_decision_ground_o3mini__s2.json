      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will show fewer or smaller deformation bands and less plastic flow than untreated coatings.",
