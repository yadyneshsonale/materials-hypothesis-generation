      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "The preformed spinel layer will reduce direct metal-to-metal contact during sliding.",
      "field": "mechanism",
