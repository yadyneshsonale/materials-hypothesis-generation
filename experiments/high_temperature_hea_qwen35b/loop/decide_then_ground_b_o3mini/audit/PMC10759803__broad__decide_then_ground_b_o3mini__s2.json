  "claims": [
    {
      "text": "The baseline alloy is a refractory high-entropy alloy primarily containing W, Mo, Ta, and Nb.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965",
        "PMC6427779::chunk::000::abstract::df84b48db4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline microstructure is optimized for both high-temperature strength and room-temperature ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 5–10% of the tungsten should be replaced by titanium.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing 5–10% of tungsten with titanium will induce stable, coherent nanoscale precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent nanoprecipitation can produce a combination of high strength and tensile ductility in tungsten refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The titanium substitution will reduce the alloy's density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The coherent nanoprecipitates will hinder dislocation motion under high-temperature loading.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent precipitate interfaces facilitate dislocation transmission and relieve stress concentrations that could initiate cracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The precipitates will allow unimpeded dislocation movement at room temperature.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have greater high-temperature yield strength than the baseline at 800–1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have greater creep resistance than the baseline at 800–1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will preserve room-temperature tensile ductility relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The modified alloy will have only a negligible density change relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The beneficial effects occur only when the substitution level remains near 5–10%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
