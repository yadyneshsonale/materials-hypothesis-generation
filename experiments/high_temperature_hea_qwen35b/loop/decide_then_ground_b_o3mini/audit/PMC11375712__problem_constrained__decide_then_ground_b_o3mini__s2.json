      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The B-modified alloy may attain a coercive field approximately an order of magnitude above 100 Oe.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity increase can occur without a significant loss of saturation magnetization if the precipitates remain nanoscale and well distributed.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limiting B to 1–3 at.% will avoid extensive secondary-phase formation that disrupts the fcc matrix.",
