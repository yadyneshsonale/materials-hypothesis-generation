      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "B perturbs the homogeneity of the fcc solid solution and thereby triggers controlled precipitation.",
