  "claims": [
    {
      "text": "The baseline system is an equiatomic FeNiCrCoCu thin-film protective coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is pre-oxidation in air at approximately 450°C for 1 hour.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies during wear testing at 400–600°C under service-representative mechanical loads.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature wear resistance of FeNiCrCoCu coatings is governed by rapid formation of a protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective oxide layer is continuous and adherent.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "The protective layer is Cr-rich and consists primarily of Cr2O3.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide preferentially localizes along coating grain boundaries and at the coating–substrate interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermally activated selective oxidation of Cr produces the passivating scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing Cr can improve the high-temperature oxidation resistance of a high-entropy-alloy coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10142552::chunk::000::abstract::d0fb87d7d2"
      ],
      "same_system": "no"
    },
    {
      "text": "The passivating scale protects the underlying metallic phases from direct abrasive interaction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Grain boundaries enhance oxygen diffusion and oxide-formation kinetics.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale reduces the effective contact area during wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of a protective oxide layer at elevated temperature can increase wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Elevated-temperature oxide formation can reduce the coefficient of friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will have a lower wear rate than otherwise identical as-deposited coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu coatings will have a lower coefficient of friction than otherwise identical as-deposited coatings.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microscopy and phase analysis of the pre-oxidized coating will reveal a continuous protective Cr-rich oxide layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The individual contribution of Cu and the detailed kinetics of oxide formation are not yet quantified.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
