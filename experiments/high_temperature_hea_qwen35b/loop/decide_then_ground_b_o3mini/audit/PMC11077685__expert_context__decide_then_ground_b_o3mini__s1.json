      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "no"
    },
    {
      "text": "The alumina scale inhibits oxygen ingress into the alloy.",
