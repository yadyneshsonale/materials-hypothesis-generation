        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Poor high-temperature oxidation resistance is a general obstacle to refractory high-entropy alloy applications.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
