  "claims": [
    {
      "text": "As-cast equiatomic HfNbTaTiZr exhibits 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at.% Al during casting will improve the oxygen resistance of equiatomic HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al addition will promote formation of a continuous and adherent Al2O3 surface scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, alloyed Al will diffuse to the surface and react with oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Al2O3 layer will be dense and slow-growing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A dense Al2O3 layer will impede oxygen ingress and prevent pesting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low Al content will preserve the underlying alloy microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low Al content will preserve room-temperature ductility and high-temperature yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "Al is used as a strengthening alloying element in refractory high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will oxidize significantly less than untreated equiatomic HfNbTaTiZr during 5 hours in air at 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain room-temperature ductility similar to that of untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain high-temperature yield strength similar to that of untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr undergoes rapid oxidation and pesting during high-temperature air exposure.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
