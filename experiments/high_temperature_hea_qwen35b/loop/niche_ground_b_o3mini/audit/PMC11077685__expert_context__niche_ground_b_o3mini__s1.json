  "claims": [
    {
      "text": "Cast equiatomic HfNbTaTiZr exhibits 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C at strain rates of 10⁻⁴–10⁻² s⁻¹.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr has inadequate oxygen resistance at high temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 5 at.% of the base elements will be replaced with Al.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al is an alloying element used in refractory high-entropy alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy will be prepared by vacuum arc melting.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 5 at.% Al will cause a thin, adherent Al2O3 scale to form on equiatomic HfNbTaTiZr during exposure to air at 800 °C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al will promote rapid formation of a continuous and protective Al2O3 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 layer will act as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Barrier action by the Al2O3 scale will reduce oxidation of the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The underlying alloy microstructure will remain largely unchanged after Al addition and oxidation exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 5 hours in air at 800 °C, the Al-modified alloy will have lower oxidation weight gain than untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will form a thicker protective oxide scale than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain room-temperature tensile ductility within 8–16%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain a yield strength of 163–530 MPa at 1000 °C and strain rates of 10⁻⁴–10⁻² s⁻¹.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed comparison applies to cast alloys exposed to air at approximately 800 °C for up to 5 hours, followed by tensile testing at room temperature and 1000 °C.",
