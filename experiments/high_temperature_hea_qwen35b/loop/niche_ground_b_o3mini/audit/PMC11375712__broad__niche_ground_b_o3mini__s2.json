      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity increase is expected under ambient testing conditions when Pt substitution is maintained near 5 at.%.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pt incorporation enhances magnetocrystalline anisotropy in the alloy.",
