  "claims": [
    {
      "text": "A Si-rich diffusion coating can improve the high-temperature oxidation resistance of a refractory high-entropy alloy relative to the uncoated alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective Si-rich diffusion coating can be made thin.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will produce a continuous SiO2 barrier layer during high-temperature exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting SiO2 layer will be self-healing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "MoNbTaTiW is a refractory high-entropy alloy system to which a silicide coating can be applied.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "A Si-rich silicide coating can be prepared on MoNbTaTiW by a fused slurry process.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating is expected to remain effective at approximately 1100°C in an oxygen-rich atmosphere for 100 hours or longer.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4",
        "PMC6513993::chunk::000::abstract::e30693f104"
      ],
      "same_system": "unclear"
    },
    {
      "text": "During high-temperature oxidation, silicon diffuses from the silicide coating into the RHEA substrate or near-surface region.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Diffusing silicon reacts with ambient oxygen to form a dense, slow-growing SiO2 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The SiO2 layer limits further oxygen ingress into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Limiting oxygen ingress preserves the structural integrity of the underlying RHEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will exhibit lower oxidation mass gain than the uncoated control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coated alloy will exhibit less oxide-scale spallation than the uncoated control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coated alloy will exhibit more continuous and protective oxide coverage than the uncoated control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "Untreated RHEAs typically form non-protective, unstable oxide scales at 1100°C in oxygen-rich environments.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated RHEAs undergo significant oxidation and mass gain during extended exposure at 1100°C.",
      "field": "baseline",
      "needs_support": true,
