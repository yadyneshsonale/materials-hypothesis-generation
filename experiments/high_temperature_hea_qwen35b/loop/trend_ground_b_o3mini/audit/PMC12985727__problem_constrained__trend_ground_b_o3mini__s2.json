        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-rich nanoprecipitates will pin or impede dislocations in TiVNbTa at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060",
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The Hf-rich nanoprecipitates will inhibit grain-boundary sliding at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Addition-induced secondary phases can increase the strength of refractory HEAs.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
