      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy's caloric response is driven by a martensitic or magneto-structural transformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After Cu addition, the matrix will retain the crystallographic features required for the caloric response.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cu microalloying will increase compressive strength by 20–50% relative to the unchanged alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "no"
    },
