      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cu-induced precipitates will be nanoscale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-induced precipitates will be ductile.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will refine the grain-boundary structure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will increase resistance to crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates will impede crack propagation.",
