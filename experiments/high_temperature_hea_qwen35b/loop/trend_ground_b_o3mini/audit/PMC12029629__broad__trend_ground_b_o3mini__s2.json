      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocations dynamically unlock from distortion-induced pinning sites during deformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocations overcoming pinning sites preserves plastic deformation capacity and ductility.",
