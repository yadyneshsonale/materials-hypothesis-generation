      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Distortion-induced pinning and unlocking enable a simultaneous increase in strength and ductility during high-strain-rate deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "unclear"
    },
