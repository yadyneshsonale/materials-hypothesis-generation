  "claims": [
    {
      "text": "Dynamic removal and reformation of a protective oxide film governs the tribocorrosion response of high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding mechanically disrupts the passivating oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Disruption of the oxide exposes a reactive substrate and accelerates electrochemical degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "Reformation of the oxide film temporarily retards corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "Repeated oxide-removal and reformation cycles produce a net increase in degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-stabilizing the oxide film improves its resistance to mechanical removal.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved oxide-film stability lowers both wear-induced degradation and corrosion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated high-entropy alloy naturally carries a passivating oxide film that provides corrosion protection.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "no"
    },
    {
      "text": "Controlled pre-oxidation or mild surface treatment enhances oxide robustness and adhesion.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-treated alloy will exhibit lower total degradation than the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-treated alloy will exhibit reduced wear-track depth relative to the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The pre-treated alloy will exhibit a lower electrochemical corrosion rate relative to the untreated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The prediction applies when the oxide is periodically removed but can reform in situ.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At loads too low to remove the oxide, oxide stabilization will be redundant.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At very high mechanical stress or chemical aggressiveness, even a stabilized oxide will lose integrity and the predicted benefit may fail.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
