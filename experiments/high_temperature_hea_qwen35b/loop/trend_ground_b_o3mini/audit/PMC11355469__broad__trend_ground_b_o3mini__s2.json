  "claims": [
    {
      "text": "The dominant mechanism governing wear performance in high-entropy-alloy protective coatings is formation of a continuous protective oxide or spinel surface layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing ambient oxygen partial pressure during wear promotes formation of a thicker oxide or spinel layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing ambient oxygen partial pressure makes the protective layer more continuous, refined, and robust.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A more developed protective oxide or spinel layer reduces friction during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A more developed protective oxide or spinel layer reduces material loss during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Ambient air containing 21% oxygen provides the baseline oxidation environment.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing oxygen partial pressure can control oxide-layer formation, thickness, and continuity.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Oxidation kinetics are appreciable during moderate-to-high-temperature wear testing.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC9026100::chunk::000::abstract::5d6ac9a02c",
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Protective oxides evolve at the coating surface and at critical grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An adherent oxide or spinel layer acts as a barrier against abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide or spinel layer lowers friction by reducing direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering oxygen partial pressure produces a less protective oxide layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering oxygen partial pressure increases wear rate relative to ambient air.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed relationship should hold where temperature and oxygen pressure permit active oxidation kinetics.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
