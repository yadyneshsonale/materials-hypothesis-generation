  "claims": [
    {
      "text": "The target material is solidified, Co-free, equiatomic FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processed FeNiCrMn can have a microstructure comparable to conventional CoCrFeMnNi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dynamic behavior of solidified FeNiCrMn is governed by a transition between thermally activated glide and stronger dislocation interactions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "At higher temperatures and lower strain rates, thermally activated dislocation glide dominates in FeNiCrMn.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature, low-strain-rate glide produces ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "At lower temperatures and higher strain rates, reduced thermal activation causes dislocation build-up and interaction in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The low-temperature, high-strain-rate dislocation interactions may include crowding or dynamic strain aging.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increased dislocation interactions promote strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "Low-temperature hardening in FeNiCrMn can occur while preserving ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "Intrinsic stacking-fault energy and solute–dislocation interactions govern the proposed mechanism transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature, low-strain-rate deformation should exhibit smoother glide and lower dislocation density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature, high-strain-rate deformation should produce greater dislocation accumulation and crowding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Low-temperature, high-strain-rate deformation should produce elevated stacking-fault density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted low-temperature microstructure should correlate with higher strength without severe loss of ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "Equiatomic CoCrFeMnNi provides a known strength–ductility balance suitable as a performance reference.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed mechanism is applicable only where phase transformations and deformation twinning do not dominate.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "When twinning, phase transformation, or related structural changes dominate, mechanisms other than the proposed glide-to-interaction transition may control deformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "A lack of systematic coupling between temperature or strain rate, dislocation structures, and mechanical response would falsify the hypothesis.",
