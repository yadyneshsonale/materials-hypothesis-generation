  "claims": [
    {
      "text": "The baseline material is a nanostructured FeNiCrCoCu thin-film coating on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-annealing FeNiCrCoCu in a controlled oxidizing atmosphere will produce a fine oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale produced by pre-annealing will be adherent and uniform.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered oxide scale will stabilize the nanocrystalline FeNiCrCoCu structure at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale will limit grain coarsening in the nanocrystalline matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale will limit high-temperature phase degradation or phase changes.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A surface oxide scale can mechanically protect a high-entropy alloy during elevated-temperature sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale will maintain the integrity of the FeNiCrCoCu coating at elevated temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu will have a lower high-temperature wear rate than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu will exhibit less material transfer than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized FeNiCrCoCu will exhibit a more stable coefficient of friction than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed effect applies over approximately 500–800°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect applies under sliding loads typical of high-temperature protective-coating service.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
