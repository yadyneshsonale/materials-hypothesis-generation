      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures above 700 °C represent fusion-relevant high-temperature test conditions for these alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd"
      ],
      "same_system": "yes"
    },
    {
      "text": "Grain-boundary precipitate density and coherence govern high-temperature mechanical behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060",
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A denser grain-boundary precipitate network acts as a physical barrier to dislocation climb.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A denser grain-boundary precipitate network limits grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-aging will reduce high-temperature plastic strain relative to the unaged state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-aging will increase high-temperature yield strength relative to the unaged state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-aging will improve high-temperature creep resistance relative to the unaged state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Pre-aging will increase fracture toughness relative to the unaged state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should operate only while the precipitates remain coherent and stable.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Excessive precipitate coarsening or destabilization would limit the proposed mechanism.",
      "field": "boundary",
      "needs_support": true,
