  "claims": [
    {
      "text": "Tungsten-based alloys are relevant candidate materials for fusion plasma-facing components.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10154406::chunk::001::introduction::c389c7efcd"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-manufactured tungsten-based alloy has a random, less optimized baseline distribution of grain-boundary precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal pre-aging can increase grain-boundary precipitate density in tungsten-based alloys.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "yes"
    },
    {
      "text": "Thermal pre-aging can create a uniformly dispersed and coherent precipitate network specifically at grain boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
