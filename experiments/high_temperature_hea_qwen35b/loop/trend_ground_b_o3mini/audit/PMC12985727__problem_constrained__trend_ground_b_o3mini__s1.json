  "claims": [
    {
      "text": "The initial TiVNbTa alloy has a single-phase BCC dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified TiVNbTa has approximately 330 MPa yield strength and 423 MPa compressive strength at 1273 K and 30% strain.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.2–0.5 wt% Y2O3 during processing is an appropriate intervention for TiVNbTa.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 addition will produce stable, uniformly distributed nanoscale oxide dispersoids in TiVNbTa.",
      "field": "hypothesis; intervention; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide particles will be distributed throughout the BCC matrix and along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide dispersoids will pin dislocations and reduce dislocation mobility.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide dispersoids will pin grain boundaries and inhibit grain-boundary sliding at 1273 K.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation glide and grain-boundary sliding are important thermally activated deformation processes responsible for the high-temperature strength loss.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersoid pinning will increase TiVNbTa yield strength at 1273 K.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The modified alloy's yield strength at 1273 K will be well above the 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modification will increase compressive strength at 1273 K relative to the 423 MPa baseline.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The Y2O3-modified alloy will have enhanced creep resistance at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will maintain adequate room-temperature mechanical properties.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain acceptable thermal conductivity for transferring heat between W and CuCrZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An inert testing atmosphere will minimize oxidation at 1273 K.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical testing should be conducted at 1273 K and approximately 30–40% strain.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mechanical alloying followed by spark plasma sintering can be used to process the proposed oxide-dispersion-strengthened material.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::000::abstract::93e23f7e34"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy must remain functional as an intermediate heat-transfer layer between tungsten and CuCrZr.",
      "field": "conditions; boundary",
