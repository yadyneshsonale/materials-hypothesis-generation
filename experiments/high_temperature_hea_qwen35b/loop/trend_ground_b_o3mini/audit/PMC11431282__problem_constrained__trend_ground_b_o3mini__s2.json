  "claims": [
    {
      "text": "The unchanged (MnNiSi)0.62(FeCoGe)0.38 alloy has a significant caloric response.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The unchanged alloy has poor load-bearing integrity and tends to crack under load.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 wt.% Nb is a suitable micro-alloying intervention for this alloy.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb atoms will segregate to grain boundaries during synthesis and heat treatment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Nb addition will nucleate a controlled ductile secondary phase at grain boundaries.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intergranular phase will bridge microcracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intergranular phase will enhance local plastic deformation and arrest crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the secondary phase will improve load-bearing integrity.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::001::introduction::73adf78dd5",
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "no"
    },
    {
      "text": "The Nb-modified alloy will exhibit an approximately 10–20% improvement in fracture toughness and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-entropy matrix will remain largely unaffected by the Nb-induced intergranular phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Leaving the matrix largely unaffected will preserve its caloric phase transformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The caloric-response magnitude under magnetic-field and pressure-field operation will remain within 10% of the unmodified alloy's response.",
      "field": "predicted_outcome; falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted integrity and caloric benefits will hold at the temperatures and magnetic and pressure fields associated with the caloric transformation.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimum Nb concentration and the interaction between the secondary phase and the caloric transition remain uncertain and require experimental validation.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
