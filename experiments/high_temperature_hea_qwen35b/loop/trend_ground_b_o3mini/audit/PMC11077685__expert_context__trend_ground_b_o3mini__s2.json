      ],
      "same_system": "no"
    },
    {
      "text": "The protective layer prevents the formation and detachment of non-protective oxides on the bulk alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applying the coating leaves the substrate microstructure unchanged.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
