  "claims": [
    {
      "text": "Single-phase ZrB2 conventionally requires pressureless sintering above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventionally pressureless-sintered ZrB2 contains residual porosity.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual porosity predisposes ZrB2 to weakening and failure during exposure to a liquid plating bath.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS at approximately 2000–2100 °C can densify single-phase ZrB2 with fewer residual pores than conventional pressureless sintering above 2300 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heating and high uniaxial pressure during SPS enhance densification and reduce pore formation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::chunk::000::abstract::3437e8a43f"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS can produce a refined ZrB2 microstructure with minimal residual porosity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SPS accelerates diffusion and promotes densification at a reduced temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8510135::chunk::000::abstract::3437e8a43f"
      ],
      "same_system": "no"
    },
    {
      "text": "Using a reduced SPS temperature and short dwell limits grain growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS processing limits pore coalescence in ZrB2.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Residual pores act as weak spots and failure-initiation sites during exposure to corrosive or plating environments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with conventionally sintered ZrB2, SPS-processed ZrB2 will have fewer and smaller pores.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compared with conventionally sintered ZrB2, SPS-processed ZrB2 will better resist structural degradation during extended liquid-plating-bath exposure.",
