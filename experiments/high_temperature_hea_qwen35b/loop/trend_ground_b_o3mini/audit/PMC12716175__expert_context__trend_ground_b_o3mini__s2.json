      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::001::introduction::d4357504cd"
      ],
      "same_system": "no"
    },
    {
      "text": "Copper has a boiling point of approximately 2562 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
