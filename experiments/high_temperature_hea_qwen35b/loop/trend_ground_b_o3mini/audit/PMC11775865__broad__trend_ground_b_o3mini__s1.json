  "claims": [
    {
      "text": "Structural and chemical stability in high-entropy nanoalloys is primarily governed by kinetic constraints from inhibited atomic diffusion at high-density grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Kinetic stabilization is more important than thermodynamic stabilization from configurational entropy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-synthesized nanoalloys have a uniform, near-random elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changing particle size changes grain-boundary density.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature exposure can produce atomic diffusion, phase segregation, and phase changes in high-entropy alloys.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature exposure can cause sintering of high-entropy nanoparticles.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain boundaries in the nanoalloy act as kinetic barriers to atomic diffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary density and connectivity impede phase transformation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Smaller nanoalloy particles possess higher grain-boundary density than larger particles.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Higher grain-boundary density restricts atomic mobility at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted atomic mobility delays or prevents phase segregation and decomposition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger particles have fewer grain boundaries and therefore greater atomic diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Smaller particles will retain a uniform elemental distribution and a single phase after high-temperature exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger particles will exhibit more elemental segregation, phase decomposition, or sintering than smaller particles.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloy composition and annealing temperature can affect phase stability and the length scale of decomposition.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermodynamic contributions can influence phase stability in high-entropy alloys.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Surface energy and oxidation kinetics may also influence high-temperature nanoalloy stability.",
      "field": "uncertainty",
