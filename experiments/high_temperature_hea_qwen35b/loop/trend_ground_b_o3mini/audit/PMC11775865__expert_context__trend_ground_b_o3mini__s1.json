  "claims": [
    {
      "text": "High-temperature nanoparticle stability is governed by kinetically driven surface segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface segregation rapidly produces a protective oxide or intermetallic layer.",
