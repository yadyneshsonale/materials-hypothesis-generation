      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The surface compound suppresses high-temperature phase transformations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Analogous compact, self-healing protective oxide layers occur in bulk alloys containing suitable oxide-forming elements.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e"
      ],
      "same_system": "unclear"
    },
    {
