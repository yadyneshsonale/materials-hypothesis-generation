  "claims": [
    {
      "text": "The target nanoparticles contain more than five noble-metal elements at fixed equiatomic composition.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapidly heated and cooled noble-metal high-entropy alloy nanoparticles typically exhibit phase separation and elemental segregation without an intermediate dwell.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Such baseline nanoparticles typically have uncontrolled particle morphologies.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A brief intermediate-temperature dwell increases transient atomic mobility and interdiffusion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The increased interdiffusion homogenizes the elemental distribution across each nanoparticle.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interdiffusion during the dwell reduces local supersaturation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing local supersaturation prevents element-specific nucleation that would otherwise cause segregation or phase separation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid heating and cooling promote element-specific nucleation, segregation, or phase separation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The dwell therefore favors a single-phase solid solution over phase-separated or segregated structures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dwell-treated nanoparticles will have a more uniform single-phase crystalline structure than nanoparticles made without the dwell.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dwell-treated nanoparticles will exhibit less elemental segregation than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dwell-treated nanoparticles will have more controlled particle morphology than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dwell must remain below the melting or decomposition threshold of the most thermally sensitive constituent.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11775865::chunk::000::abstract::cfe160ba3c"
      ],
      "same_system": "no"
    },
    {
      "text": "The strategy may fail when diffusion remains too slow during the dwell.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature ramp rates must be tightly controlled for the strategy to work.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An insufficient dwell duration will not produce adequate homogenization.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An excessively long dwell may cause grain growth or unintended phase transitions.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
