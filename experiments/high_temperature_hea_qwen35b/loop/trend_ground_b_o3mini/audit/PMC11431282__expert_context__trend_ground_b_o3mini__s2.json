      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Ti-rich precipitates will be ductile.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate formation can strengthen high-entropy alloys.",
