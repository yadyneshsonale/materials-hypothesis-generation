  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The initial CrMnFeCoNi alloy is homogenized and has a uniform elemental distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidation resistance in CrMnFeCoNi is primarily governed by Mn diffusion kinetics.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn is preferentially oxidized during high-temperature exposure of CrMnFeCoNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn oxidation produces non-protective oxides and depletes Mn from the bulk CrMnFeCoNi alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lowering Mn concentration slows Mn diffusion to the alloy surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lowering Mn concentration reduces selective formation of non-protective Mn oxides.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lowering Mn concentration enables formation of a continuous and adherent Cr2O3 scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous Cr2O3 scale acts as a diffusion barrier to further oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-rich oxide scales in this system are prone to spallation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing Mn concentration enhances Mn diffusion and selective oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing Mn concentration compromises oxide-scale integrity and promotes bulk-alloy degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-reduced alloys will have lower oxidation weight gains than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-reduced alloys will develop a more continuous, adherent, Cr2O3-dominated scale than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-reduced alloys will retain better mechanical integrity after oxidation than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-enriched alloys will have higher oxidation weight gains than the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-enriched alloys will form discontinuous or porous non-protective Mn-oxide scales.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed Mn-controlled behavior applies in oxygen-rich environments from 800 to 1200 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
