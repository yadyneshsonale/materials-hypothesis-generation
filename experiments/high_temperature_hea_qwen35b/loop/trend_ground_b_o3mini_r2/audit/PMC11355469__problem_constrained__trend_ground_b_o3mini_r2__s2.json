  "claims": [
    {
      "text": "The baseline FeNiCrCoCu coating lacks a pre-formed, significant, stable oxide tribolayer.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidation annealing under controlled oxygen partial pressure and temperature will form an oxide layer on the FeNiCrCoCu coating before sliding.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide layer produced by pre-oxidation will be nanocrystalline.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer produced by pre-oxidation will remain stable during high-temperature sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide formation and evolution are significant at high temperature in this alloy system.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "no"
    },
    {
      "text": "The operative structural mediator during sliding is a dynamically generated ultrafine-grained oxide tribolayer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribolayer distributes applied shear stresses.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribolayer acts as an in situ lubricating barrier that reduces direct metal-to-metal contact.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced direct contact lowers adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribolayer lowers abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide tribolayer accommodates localized shear deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Accommodation of localized shear by the tribolayer limits deep plastic deformation in the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized coatings will have lower wear rates than untreated coatings during otherwise identical high-temperature sliding tests.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pre-oxidized coatings will develop shallower localized plastic-deformation tracks than untreated coatings during high-temperature sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted benefits apply only in regimes where thermally activated oxidation and oxide-layer evolution dominate wear behavior.",
