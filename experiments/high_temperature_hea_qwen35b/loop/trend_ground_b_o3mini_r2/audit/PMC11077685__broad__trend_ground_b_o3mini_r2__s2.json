  "claims": [
    {
      "text": "The untreated refractory high-entropy alloy forms non-protective or discontinuous oxide scales under extreme-temperature oxygen exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "no"
    },
    {
      "text": "A thin, pre-formed Al2O3 coating can be deposited on the alloy by physical vapor deposition.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A pre-formed Al2O3 coating promotes in situ development of a continuous alumina scale on a refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "An Al2O3 layer can provide high-temperature oxidation resistance in refractory high-entropy-alloy applications.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting Al2O3 layer will be continuous and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The continuous Al2O3 layer acts as a diffusion barrier.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The pre-formed coating seeds formation of a robust, slow-growing oxide scale during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina scale slows oxygen ingress into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating reduces oxidation kinetics by limiting further oxide-scale growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating reduces oxide-scale spallation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating substantially reduces oxidation-related mass gain relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700",
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coating improves oxide-scale integrity relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxidation benefit should occur at approximately 1150 degrees Celsius in 1 atm oxygen-rich atmosphere over 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance outside the specified temperature, atmosphere, and exposure duration remains uncertain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal cycling and substrate/coating thermal-expansion mismatch may compromise long-term coating adhesion and mechanical stability.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mass gain per unit area can be used as an indicator of oxidation behavior.",
      "field": "falsification_experiment.measurements",
