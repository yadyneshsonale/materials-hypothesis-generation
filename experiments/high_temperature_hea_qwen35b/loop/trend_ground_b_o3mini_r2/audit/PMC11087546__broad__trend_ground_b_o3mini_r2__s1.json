  "claims": [
    {
      "text": "The starting eutectic high-entropy alloy has a lamellar FCC/B2 microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The as-cast starting microstructure is relatively coarse and non-uniform.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A rapid annealing-quench cycle will refine the lamellar FCC/B2 microstructure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A precisely controlled rapid annealing-quench cycle can adjust the phase morphology.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will produce more uniform and more finely spaced lamellae.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Finer, more uniform lamellae enhance the distribution of phase boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced lamellar spacing increases strength because phase boundaries hinder dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment preserves or enhances connectivity of the softer FCC phase.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Connectivity of the softer FCC phase facilitates dislocation mobility and thereby improves ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treated alloy will have both higher yield strength and higher ductility than an as-cast or conventionally heat-treated baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A fine lamellar FCC/B2 EHEA microstructure can provide a favorable combination of high strength and high ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lamellar refinement should mitigate the conventional strength-ductility trade-off.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline alloy has a coarser lamellar structure and exhibits either high strength with limited ductility or the converse.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will be effective under quasi-static loading at ambient and moderately elevated temperatures.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment's benefits may diminish at very high strain rates or at thermal conditions far outside the annealing-quench regime.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing temperatures or quench rates outside an optimal window may fail to refine the microstructure.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the strength and ductility improvements depends on fine-tuning the thermal-cycle parameters.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal processing window varies among alloy compositions.",
