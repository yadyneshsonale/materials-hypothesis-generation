  "claims": [
    {
      "text": "Partially or fully replacing Hf with Nb in as-cast HfMoTaTiZr will reduce alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::001::introduction::c4f919e1c8"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-to-Nb substitution will retain the alloy's high strength at room temperature and near 1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "As-cast HfMoTaTiZr has a density of 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has excellent room-temperature and high-temperature mechanical properties.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb is lighter than Hf.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nb has refractory character and a high melting point.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "The Nb-substituted alloy will maintain a single-phase BCC or related solid-solution structure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Maintaining the BCC solid solution is critical to preserving strength across room temperature to approximately 1000 °C.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing Hf with Nb will not drastically change atomic-size mismatch.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Avoiding drastic changes in atomic-size mismatch and crystal structure will largely preserve room-temperature and high-temperature mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's density should approach or fall below 10.0 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5578249::chunk::001::introduction::c4f919e1c8"
      ],
      "same_system": "no"
    },
    {
      "text": "Yield strength and ductility should show minimal or no reduction at room temperature and approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed performance range extends from ambient temperature to approximately 1000 °C under tensile or compressive structural loading.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alloy must remain as-cast or in a similarly stable state with its microstructural features intact.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Hf replacement may alter phase stability or microstructural features.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Changes in bonding and dislocation behavior caused by Nb substitution may affect mechanical properties.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Variants with 25%, 50%, and 75% replacement of the original Hf content by Nb will be synthesized using the same arc-melting and casting process.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The experiment will compare density, phase constitution, strength, ductility, and fracture behavior against the original alloy at room temperature and approximately 1000 °C.",
      "field": "falsification_experiment",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A strength or ductility loss greater than 10% at either test temperature will reject the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a significant density reduction relative to 10.21 g/cm³ will reject the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
