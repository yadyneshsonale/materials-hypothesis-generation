  "claims": [
    {
      "text": "Increasing the oxide-forming-element fraction promotes formation and stability of a protective oxide tribolayer during elevated-temperature wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in-situ tribolayer is nanocrystalline and may contain a spinel or similar protective oxide phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A protective oxide layer can form during atmospheric elevated-temperature wear of an HEA.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribolayer reduces wear by minimizing direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide tribolayer serves as a self-adjusting friction modifier.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of a protective oxide layer at elevated temperature increases wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The initial material is a multiphase, multielement HEA coating.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The baseline coating has a low concentration of a key oxide-forming element.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled intervention is a 10–20% relative increase in an oxide-forming element such as Ti or Al.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect holds during sliding wear at 500–900 °C in an oxidation-permitting atmosphere.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing oxide-former content will produce a thicker tribolayer than the baseline composition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing oxide-former content will produce a more continuous tribolayer than the baseline composition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing oxide-former content will lower the wear rate relative to the baseline composition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing oxide-former content will slightly reduce the coefficient of friction relative to the baseline composition.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lower-oxide-former baseline coatings form thinner or less stable tribolayers and consequently have higher wear rates.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Non-oxidizing environments may prevent the anticipated protective tribolayer behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Extremely high temperatures may prevent the anticipated protective tribolayer behavior.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant wear-rate reduction, failure to form a more robust tribolayer, or deterioration relative to the baseline would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
