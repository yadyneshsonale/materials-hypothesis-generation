      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dy-doped CoCrFeMnNi will have a higher coercive field than an identically processed undoped CoCrFeMnNi baseline.",
