  "claims": [
    {
      "text": "The starting material is equiatomic as-cast HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C at strain rates of 10^-4–10^-2 s^-1.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HfNbTaTiZr has poor oxygen or oxidation resistance that limits high-temperature use.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "A less-than-1-μm Al2O3 coating will be deposited on the cast alloy by ALD.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "ALD will produce a uniform, pinhole-free Al2O3 coating on HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The thin Al2O3 coating will remain stable at approximately 1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The deposited Al2O3 layer will form a dense, adherent surface barrier.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 barrier will impede oxygen diffusion into the bulk HfNbTaTiZr alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion will suppress deleterious oxide-scale formation and oxidation weight gain.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressing oxygen ingress and oxide formation will protect the alloy microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will preserve the alloy's native room-temperature tensile ductility after high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will preserve the alloy's yield strength at approximately 1000 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 100 hours at 1000 °C in an oxidizing atmosphere, coated specimens will have markedly less weight gain or thinner oxide scales than uncoated specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After exposure, coated specimens will have tensile ductility and yield strength comparable to or better than uncoated specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Uncoated HfNbTaTiZr will undergo significant oxygen ingress and scale formation under the same 1000 °C, 100-hour conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed protection is expected to remain effective during static exposure and loading at strain rates of 10^-4–10^-2 s^-1.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Extreme deformation, thermal cycling, or mechanical fatigue may damage coating adhesion or integrity.",
      "field": "uncertainty",
      "needs_support": true,
