      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealed coatings will have lower coefficients of friction and wear rates than as-deposited coatings at both room temperature and 300 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stable oxide-layer formation will markedly reduce wear at elevated temperature.",
