      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing produces a refined grain-boundary network together with a continuous, thin tribochemical oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing-induced grain refinement increases hardness.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing shifts deformation toward grain-boundary-mediated plasticity.",
