      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Annealing at 300 °C further refines the grain structure.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing promotes formation of a thin, stable oxide such as CuO.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear is tested at room temperature and 300 °C under the same 1 N load and 0.1 m/s sliding speed.",
