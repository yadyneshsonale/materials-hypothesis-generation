  "claims": [
    {
      "text": "Equiatomic NbTaTiV is a refractory HEA with a single-phase disordered BCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11206460::rubric_card::000::bd033a5c9c"
      ],
      "same_system": "yes"
    },
    {
      "text": "NbTaTiV is a low-density refractory HEA suitable as the proposed base alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 0.5–1.0 at.% nitrogen can be incorporated as an interstitial addition during synthesis of an NbTaTiV-based alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 0.5–1.0 at.% nitrogen to NbTaTiV will produce nanometer-scale ordered nitride clusters in its BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed nitride clusters will increase local lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed nitride clusters will act as barriers that pin dislocations.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitrogen-induced lattice distortion and dislocation pinning will enhance high-temperature yield strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nitrogen addition will not substantially alter the BCC phase stability of NbTaTiV.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.5–1.0 at.% nitrogen will not substantially increase the alloy's density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nitrogen-doped alloy will retain room-temperature ductility close to that of the undoped alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7299626::rubric_card::000::06c4d095e9"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed nitrogen treatment will improve yield strength under uniaxial loading at 600–900 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high-temperature yield-strength improvement will be 20–30% relative to undoped NbTaTiV.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature ductility will remain within ±10% of the undoped alloy's ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "NbTaTiV is a relevant baseline for elevated-temperature testing through 900 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11206460::rubric_card::000::bd033a5c9c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nitrogen contents above approximately 1.0 at.% will promote brittle nitride precipitation or excessive lattice distortion.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The microstructural changes caused by nitrogen contents above approximately 1.0 at.% will degrade both high-temperature and room-temperature mechanical performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of strengthening depends on processing conditions and nitrogen solubility.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
