      "supporting_ids": [
        "PMC7229066::rubric_card::000::3519eb0b1c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Matched processing histories are required for the Co-free and Co-containing control alloys.",
      "field": "conditions",
      "needs_support": false,
