  "claims": [
    {
      "text": "The initial TiVNbTa alloy is single-phase BCC.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has a dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TiVNbTa alloy has approximately 800 MPa yield strength and approximately 40% strain at lower temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a yield strength of approximately 330 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, the baseline TiVNbTa alloy has a compressive strength of approximately 423 MPa at 30% strain.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add approximately 1 wt.% oxygen to TiVNbTa during processing.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added oxygen will dissolve interstitially in the BCC TiVNbTa matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial oxygen will produce local lattice distortions in TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-induced lattice distortions will impede dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation glide will hinder thermally activated softening at 1273 K.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial oxygen strengthening will reduce high-temperature diffusional creep.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 1 wt.% oxygen will improve TiVNbTa yield strength at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The yield-strength improvement at 1273 K may be approximately 50–100% or more relative to the 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen addition will improve compressive strength at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen strengthening can improve high-temperature strength without significantly compromising ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-doped alloy will retain acceptable ductility for use as an intermediate layer.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature compression testing around 1273 K is an applicable method for assessing a refractory HEA under the proposed conditions.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "no"
    },
    {
      "text": "A controlled inert or vacuum atmosphere can be used during processing or testing to limit extensive oxidation.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a",
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "no"
    },
    {
      "text": "Excess oxygen may form secondary oxide phases that compromise alloy integrity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimum oxygen concentration and the magnitude of strength improvement at 1273 K are undetermined.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
