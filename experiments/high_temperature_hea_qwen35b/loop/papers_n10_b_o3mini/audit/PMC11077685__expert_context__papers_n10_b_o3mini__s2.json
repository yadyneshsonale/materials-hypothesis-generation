  "claims": [
    {
      "text": "Equiatomic cast HfNbTaTiZr exhibits 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has inadequate oxygen resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 1–3 at% Al to equiatomic cast HfNbTaTiZr will improve its oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 1–3 at% Al addition will promote formation of a continuous and adherent Al2O3 surface scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aluminum is a strong oxide former.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The added aluminum will oxidize preferentially to form alumina.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting alumina scale will be dense and protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina scale will act as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen diffusion through the alumina scale will slow internal oxidation and pesting.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping the Al content at 1–3 at% will avoid substantial alteration of the matrix microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Keeping the Al content at 1–3 at% will avoid inducing new phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will have lower oxidation kinetics and oxygen uptake than untreated material during approximately 5 h of exposure to air at 800–1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will exhibit less pesting than untreated material during approximately 5 h of exposure to air at 800–1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain room-temperature tensile ductility within the 8–16% range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain high-temperature yield strength similar to that of untreated equiatomic HfNbTaTiZr.",
      "field": "predicted_outcome",
