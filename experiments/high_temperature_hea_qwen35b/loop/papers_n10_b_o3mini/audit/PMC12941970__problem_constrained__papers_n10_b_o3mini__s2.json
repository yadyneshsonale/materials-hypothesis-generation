  "claims": [
    {
      "text": "The starting material is an equiatomic CoCrFeNi high-entropy alloy without modifying elements.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add approximately 1 at% Ti to CoCrFeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A roughly 1 at% Ti addition will promote in situ formation of an oxide tribolayer during sliding.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-enabled tribolayer will be fine or nanocrystalline, continuous, adherent, and stable.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-enabled tribolayer is likely to contain a spinel-type oxide phase.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ti accelerates tribo-oxidation during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, the oxide tribolayer minimizes direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing direct metal-to-metal contact through the oxide layer reduces friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At room temperature, adding approximately 1 at% Ti will not adversely affect the underlying mechanical properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Ti-modified alloy will have a lower coefficient of friction than unmodified CoCrFeNi throughout room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The Ti-modified alloy will have a lower wear rate than unmodified CoCrFeNi throughout room temperature to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "Unmodified CoCrFeNi has low friction and wear at room temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi exhibits increased friction and wear at elevated temperatures.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The elevated-temperature deterioration of unmodified CoCrFeNi is caused by uncontrolled oxide formation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
