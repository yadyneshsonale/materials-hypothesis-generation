  "claims": [
    {
      "text": "Single-phase fcc FeCoNi or closely related high-entropy alloys have high saturation magnetization and coercivity no greater than 100 Oe.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A post-synthesis anneal around 600 °C for 15 h followed by rapid quenching is the proposed intervention.",
      "field": "intervention",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "no"
    },
    {
      "text": "Annealing at about 600 °C for 15 h can trigger formation of nanoscale B2 or BCC secondary precipitates in an fcc FeCoNi matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed annealing temperature is low enough to limit extensive diffusion.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching will retain the annealing-induced multiphase microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "no"
    },
    {
      "text": "The structural mediator is a population of coherent or semi-coherent nanoscale precipitates within the fcc matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "no"
    },
    {
      "text": "Nanoscale precipitates act as pinning centers for magnetic domain walls.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitate pinning raises the energy barrier for domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded domain-wall motion increases coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation induced by the treatment will increase coercivity relative to the single-phase control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::rubric_card::000::faac17e0f4"
      ],
      "same_system": "no"
    },
    {
      "text": "The treated sample will have coercivity well above 100 Oe.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The treatment will leave saturation magnetization relatively high and will not significantly reduce it.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity enhancement depends on precipitate size, volume fraction, and spatial distribution.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
