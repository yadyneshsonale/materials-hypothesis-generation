      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Ta is a comparatively high-density constituent, while Al and Ti are comparatively low-density alloying additions.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "unclear"
    },
    {
