      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "High-entropy alloys contain at least five principal elements in equal or near-equal atomic percentages.",
