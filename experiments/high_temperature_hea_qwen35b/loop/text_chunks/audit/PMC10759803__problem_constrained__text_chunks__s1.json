      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding Al would reduce the density of HfMoTaTiZr.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
