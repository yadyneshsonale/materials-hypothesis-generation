      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed controlled comparison tests CoCrFeNiTi with precipitation hardening against CoCrFeNiTi without precipitation hardening.",
      "field": "falsification_experiment.design",
