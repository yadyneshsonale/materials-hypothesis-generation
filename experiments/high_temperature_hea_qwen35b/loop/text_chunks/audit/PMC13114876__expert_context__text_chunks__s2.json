  "claims": [
    {
      "text": "The coupled tribo-corrosion response of high-entropy alloys is governed by formation of a protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant high-entropy alloy may have either a single-phase or a multi-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec",
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The imposed exposure combines mechanical wear and corrosion.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies in harsh environments involving high temperature, corrosive media, and mechanical stress.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Chromia or alumina can serve as the protective oxide mediator in the proposed tribo-corrosion response.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A protective oxide layer forms on the high-entropy-alloy surface during the relevant exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide acts as a diffusion barrier and thereby reduces oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer reduces mechanical wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An oxide-protected high-entropy alloy will have lower total tribo-corrosion degradation than an alloy without the protective oxide.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An oxide-protected high-entropy alloy will have a lower wear rate than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An oxide-protected high-entropy alloy will have a lower corrosion rate than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9229239::chunk::000::abstract::78b0a496b7",
        "PMC9955357::chunk::000::abstract::094b212c37"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective oxide layer may break down or become unstable at very high temperatures or in aggressive corrosive media.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Breakdown of the protective oxide layer leads to accelerated wear and corrosion.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Alloy composition and microstructure influence formation and stability of the protective oxide layer.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The specific tribo-corrosion test conditions influence formation and stability of the protective oxide layer.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
