      ],
      "same_system": "unclear"
    },
    {
      "text": "The coupled tribo-corrosion response of high-entropy alloys is governed by formation of a protective oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
