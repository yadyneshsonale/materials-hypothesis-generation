        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent nanoprecipitate interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Dislocation interactions with coherent nanoprecipitates relieve local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Relief of stress concentrations by coherent nanoprecipitates prevents premature crack initiation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The alloy before nanoprecipitate introduction has a single-phase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stepwise controllable coherent-nanoprecipitation design can introduce coherent nanoprecipitates into a high-entropy alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SCCP-mediated behavior applies at ambient temperature.",
