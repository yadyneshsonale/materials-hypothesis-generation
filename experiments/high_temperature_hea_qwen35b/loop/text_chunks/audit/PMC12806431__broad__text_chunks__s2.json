      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The SCCP-mediated behavior remains applicable at temperatures up to 800 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Introducing SCCPs produces ultrahigh strength together with tensile ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An SCCP-containing alloy can retain a high yield strength at 800 °C.",
      "field": "predicted_outcome",
