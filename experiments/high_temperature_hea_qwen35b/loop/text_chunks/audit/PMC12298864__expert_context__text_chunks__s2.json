  "claims": [
    {
      "text": "Deformation, hardness, and strength in equimolar or nearly equimolar CoCrFeNiTi are governed by deformation-induced nano-twins and stacking faults.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e",
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "The formation of nano-twins and stacking faults is influenced by microstructure, temperature, and loading conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial material is equimolar or nearly equimolar CoCrFeNiTi in a simple solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperature and loading conditions are the proposed controlled variables.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis applies from 25 °C to 600 °C under compression and tension.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Nano-twins and stacking faults are the structural mediators of the proposed behavior.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e",
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation twinning is an operative deformation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e",
        "PMC7229066::chunk::000::abstract::33b9dea56c"
      ],
      "same_system": "no"
    },
    {
      "text": "Transformation-induced plasticity is an operative deformation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Decreasing temperature enhances the strength-ductility combination.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e",
        "PMC8398136::chunk::000::abstract::92875111a7"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy maintains outstanding fracture toughness at cryogenic temperatures.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "CoCrFeNiTi has an FCC single-phase random-solid-solution baseline.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
