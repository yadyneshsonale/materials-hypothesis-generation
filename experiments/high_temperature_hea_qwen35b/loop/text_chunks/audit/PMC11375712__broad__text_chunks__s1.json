  "claims": [
    {
      "text": "The baseline material is the magnetic high-entropy alloy AlCoFeNi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The intervention is partial replacement of Co by Cr in AlCoFeNi.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Co with Cr in AlCoFeNi increases coercivity relative to AlCoFeNi without Cr substitution.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The predicted coercivity increase should hold under lower-temperature annealing.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co-to-Cr substitution and lower annealing temperatures promote decomposition into ordered B2 and disordered BCC phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Co is ferromagnetic whereas the substituted Cr is antiferromagnetic.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Replacing Co with Cr substantially reduces the saturation magnetization of AlCoFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The reduction in saturation magnetization is the mechanism responsible for the increase in coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant structural length scale depends on both alloy composition and annealing temperature.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The specific modified alloy proposed for testing is AlCo0.5Cr0.5FeNi, compared with AlCoFeNi.",
      "field": "falsification_experiment.design",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    }
  ],
