  "claims": [
    {
      "text": "Controlled post-deposition oxidation forms an alumina nanolayer on the high-entropy-alloy bond-coat surface.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation treatment can produce a thin, uniform alumina nanolayer.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Typical high-entropy-alloy bond-coat microstructures are susceptible to oxidation under high-temperature cyclic conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Typical high-entropy-alloy bond-coat microstructures are susceptible to thermal damage under high-temperature cyclic conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina nanolayer bonds to the underlying high-entropy alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina nanolayer reduces oxygen ingress into the bond coat.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina nanolayer impedes crack propagation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina nanolayer slows diffusion of deleterious species other than oxygen into the bond coat.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced ingress of oxygen and deleterious species stabilizes the bond-coat microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural stabilization reduces oxidation-induced degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Microstructural stabilization reduces thermal-stress-related defects.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-oxidized bond coats will have lower oxidation rates than untreated bond coats during high-temperature cycling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-oxidized bond coats will have fewer microstructural defects than untreated bond coats during high-temperature cycling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-oxidized bond coats will have greater durability and longer operational lifetimes than untreated bond coats.",
      "field": "hypothesis; mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated high-entropy-alloy bond coats exhibit faster oxidation, higher crack density, and shorter lifetime during high-temperature cycling in oxidizing environments.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective effect may diminish above the controlled processing limits or at abnormal oxygen partial pressures.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inadequately optimized oxidation time, temperature, or oxygen level can cause detrimental alumina-layer growth.",
      "field": "boundary",
      "needs_support": true,
