      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is approximately 1–2 at% tungsten doping during synthesis.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Tungsten atoms will segregate at grain boundaries.",
