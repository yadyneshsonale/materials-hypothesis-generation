    {
      "text": "Incorporating a small percentage of yttrium into a refractory high-entropy alloy will improve its high-temperature oxygen resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yttrium addition will cause a Y2O3 layer to form on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting Y2O3 surface layer will be stable and protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Y2O3 layer will inhibit oxygen diffusion into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Inhibiting oxygen diffusion into the alloy will reduce its oxidation rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 100 hours at 1000°C in an oxygen-rich atmosphere, the yttrium-containing alloy will exhibit at least 30% less oxidation-associated weight loss than the untreated alloy.",
