  "claims": [
    {
      "text": "The baseline TiVNbTa alloy is a single-phase BCC dendritic material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has approximately 800 MPa room-temperature yield strength and approximately 40% strain.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has approximately 330 MPa yield strength and 423 MPa compressive strength at 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 3–5 at% Cr to TiVNbTa will promote formation of a Laves phase in addition to the BCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-induced Laves phase in TiVNbTa will be fine and dispersed within the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Laves-phase precipitation will impede dislocation motion at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "Precipitation strengthening from the Laves phase will increase the high-temperature yield strength of TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "The Cr-modified alloy will retain a ductile BCC matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr addition will minimally perturb room-temperature ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::chunk::000::abstract::41e69f8748"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr addition and Laves-phase formation will minimally affect the thermal conductivity of TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will preserve effective heat transfer between W and CuCrZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, Cr-modified TiVNbTa will exhibit a yield-strength increase of roughly 100–150 MPa relative to baseline TiVNbTa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 1273 K, Cr-modified TiVNbTa will have higher compressive strength than baseline TiVNbTa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-modified TiVNbTa will maintain ductility near or above 30% strain at 1273 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvement applies from room temperature to approximately 1273 K under compressive loading reaching about 30–40% strain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Cr may produce coarser secondary phases that embrittle the alloy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
