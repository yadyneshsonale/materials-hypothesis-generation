      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The engineered nanoprecipitates maintain coherent interfaces with the matrix.",
