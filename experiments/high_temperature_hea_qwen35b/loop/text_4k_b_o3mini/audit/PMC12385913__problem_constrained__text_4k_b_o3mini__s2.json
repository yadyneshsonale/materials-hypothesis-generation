      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Under identical high-temperature loading, WTaTiVZr should sustain greater plastic strain than pure tungsten.",
