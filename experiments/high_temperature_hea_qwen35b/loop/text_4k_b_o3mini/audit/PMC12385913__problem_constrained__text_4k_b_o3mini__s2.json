      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The WTaTiVZr stress–strain curve should have a more prolonged plastic-deformation region than that of pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Crack initiation should occur later in WTaTiVZr than in pure tungsten.",
