  "claims": [
    {
      "text": "Reducing Mn concentration shifts oxidation from Mn-rich oxides toward a continuous protective spinel or Cr-rich oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CrMnFeCoNi oxidation is predominantly governed by Mn oxide formation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventional CrMnFeCoNi has a high Mn content.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism applies during sustained oxidation in air at 700–1000°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant structural mediator is a transition from discontinuous, non-protective Mn oxides to a continuous protective Cr-rich or spinel scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Lowering Mn reduces the tendency to form non-protective Mn oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mn-rich oxides quickly deplete Mn from the bulk alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Lowering Mn enables formation of an adherent, self-limiting Cr2O3 or spinel layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "An adherent, self-limiting oxide scale diminishes further oxidation and bulk-alloy degradation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reduced-Mn alloy will exhibit lower oxidation kinetics and less mass gain than baseline CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reduced-Mn alloy will form a more continuous and adherent oxide scale than baseline CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale on a reduced-Mn alloy will be dominated by Cr-rich or spinel phases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reducing Mn will improve overall material integrity relative to baseline CrMnFeCoNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In situ high-temperature XRD studies of CrMnFeCoNi show that Mn is the major oxide-forming element.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Mn oxides observed during high-temperature oxidation of CrMnFeCoNi are non-protective.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "yes"
