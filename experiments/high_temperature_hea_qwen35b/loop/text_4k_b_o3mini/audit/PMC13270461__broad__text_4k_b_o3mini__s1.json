      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Other alloying elements or processing histories can alter oxide-scale formation enough to produce deviations from the proposed mechanism.",
      "field": "boundary",
