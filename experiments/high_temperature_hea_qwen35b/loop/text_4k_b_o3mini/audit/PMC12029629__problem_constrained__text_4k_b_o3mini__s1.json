  "claims": [
    {
      "text": "The Co-free FeNiCrMn alloy is obtained by removing Co from equiatomic CoCrFeMnNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic FeNiCrMn has an initially single-phase, disordered solid-solution state.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Removing Co enhances the tendency of FeNiCrMn to form chemical short-range order during deformation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range ordering in the Co-free alloy is activated in a temperature-dependent fashion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Short-range ordering in the Co-free alloy is activated in a strain-rate-dependent fashion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Deformation can promote atomistic rearrangements and chemical clustering in a high-entropy alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Thermally activated atomic rearrangements promote local chemical ordering in FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "no"
    },
    {
      "text": "Short-range-order clusters obstruct dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic short-range ordering enhances the strength of Co-free FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic short-range ordering modifies the ductility of Co-free FeNiCrMn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co in equiatomic CoCrFeMnNi hinders pronounced short-range-order formation relative to Co-free FeNiCrMn.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At elevated temperatures and lower strain rates, Co-free FeNiCrMn will have higher yield strength than equiatomic CoCrFeMnNi because short-range order has time to develop.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Co-free FeNiCrMn will exhibit a ductility response different from that of equiatomic CoCrFeMnNi under comparable testing conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high strain rates, insufficient time for short-range-order development will reduce the associated strengthening effect.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic CoCrFeMnNi shows less strain-rate-sensitive short-range ordering than Co-free FeNiCrMn.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism is applicable only while the alloy remains a single-phase solid solution without precipitation or other phase transformations.",
