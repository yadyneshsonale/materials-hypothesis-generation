      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "no"
    },
    {
      "text": "Load sharing by TiC reduces abrasive wear at low temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Load sharing by TiC reduces adhesive wear at low temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
