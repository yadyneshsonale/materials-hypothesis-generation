    {
      "text": "At high temperatures, TiC promotes a protective tribo-layer that resists oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective tribo-layer resists high-temperature softening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 10 vol.% TiC will lower the steady-state coefficient of friction of CoCrFeNi throughout sliding from about 25 °C to 800 °C.",
