  "claims": [
    {
      "text": "The alloy is a multi-phase eutectic high-entropy alloy containing a dominant BCC phase and secondary Laves-type phases.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Spark plasma sintering can produce the stated BCC-plus-Laves microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The relevant elevated-temperature wear-corrosion exposure range is approximately 1200–1400 °C.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An acidic medium such as sulfuric acid is relevant to corrosion testing of the alloy.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Wear and corrosion occur concurrently under the proposed exposure.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear continuously removes protective oxide or passive layers.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear exposes phases having different corrosion resistances.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Differences in redox stability between phases create local galvanic cells at interphase boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The BCC matrix is mechanically robust.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Laves or other secondary phases are more corrosion-sensitive than the BCC matrix.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Galvanically enhanced localized corrosion weakens interphase bonds and roughens the surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Corrosion-induced interphase weakening and surface roughening exacerbate mechanical wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Simultaneous wear and corrosion produce total degradation greater than the sum of wear-only and corrosion-only degradation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Simultaneous exposure increases wear-scar depth and volume relative to the matched wear-only response.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Simultaneous exposure increases corrosion-pit density and depth relative to the matched corrosion-only response.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism requires distinct phases with different corrosion resistances and may not apply to single-phase alloys.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism may cease to operate when protective scales fully regenerate between wear events.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The cited CrMoNbWV material exhibits good wear performance and high electrochemical corrosion resistance when these behaviors are tested separately.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Failure of simultaneous exposure to produce statistically greater degradation than the sum of the isolated responses would falsify the proposed synergy.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
