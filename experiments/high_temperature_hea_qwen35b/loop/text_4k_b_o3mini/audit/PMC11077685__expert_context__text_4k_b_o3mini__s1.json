  "claims": [
    {
      "text": "The initial material is cast equiatomic HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Untreated equiatomic HfNbTaTiZr has inadequate oxygen resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed intervention is to add approximately 2–5 at% Al to equiatomic HfNbTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at% Al will improve the oxygen resistance of equiatomic HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition will promote a continuous alumina scale on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina scale formed on the Al-modified alloy will be adherent and protective.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al will preferentially oxidize because of its strong affinity for oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting dense alumina layer will act as a diffusion barrier to further oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina layer will minimize internal oxidation of Hf, Ti, and Zr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced oxygen ingress and internal oxidation will improve resistance to pesting and oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will have lower oxidation weight gain than untreated equiatomic HfNbTaTiZr during exposure to air at 800 °C for 5 hours.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will show minimal oxide-scale spallation during exposure to air at 800 °C for 5 hours.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at% Al will not compromise room-temperature ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 at% Al will not compromise high-temperature strength.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation prediction is limited to air exposure near 800 °C for up to 5 hours.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Al concentration and the effects of Al on phase stability, mechanical properties, and alumina-formation kinetics in this alloy are uncertain.",
