      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The coherent nanoprecipitates are distributed both at grain boundaries and within grain interiors.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
