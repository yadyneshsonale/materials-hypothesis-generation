      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated alloy undergoes nonuniform deformation because of stress concentration at grain boundaries.",
