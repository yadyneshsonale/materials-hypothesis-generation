      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::001::introduction::40d6c7eeec"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermally aged and cyclically loaded samples will have lower toughness than the as-quenched baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
