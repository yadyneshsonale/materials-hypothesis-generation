      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed phase decomposition is thermodynamically driven.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Cyclic mechanical loading contributes to initiating phase decomposition during thermal exposure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Local solute diffusion under elevated temperature and cyclic loading overcomes the entropic stabilization of the HEA.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The decomposition nucleates nanoscale precipitates preferentially at or near grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The grain-boundary precipitates are brittle.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale grain-boundary precipitates reduce grain-boundary cohesion.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced grain-boundary cohesion causes a transition from ductile to brittle fracture.",
