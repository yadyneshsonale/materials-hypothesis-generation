      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Controlled minimal surface oxidation creates a barrier to further diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
