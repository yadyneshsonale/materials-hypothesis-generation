        "PMC8201384::rubric_card::000::e06b53e060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed experiments apply to nanoparticles smaller than 100 nm and having low impurity levels.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant structural mediator is retention of a chemically uniform, single-phase solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::rubric_card::000::6a984a21e0",
