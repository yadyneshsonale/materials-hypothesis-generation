      ],
      "same_system": "unclear"
    },
    {
      "text": "High configurational entropy kinetically suppresses phase separation in these nanoparticles.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling minimizes surface segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid cooling minimizes oxidation that would otherwise destabilize the nanoparticle structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid-quench fabrication can produce a uniform, metastable solid-solution structure.",
