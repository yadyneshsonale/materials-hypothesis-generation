      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to the baseline alloy, the B-modified alloy will have a higher crystallization-onset temperature during reheating.",
