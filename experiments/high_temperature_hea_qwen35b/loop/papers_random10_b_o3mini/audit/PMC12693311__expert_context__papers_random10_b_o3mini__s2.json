      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Approximately 3 at% B should be added by replacing an equivalent but unspecified fraction of one or more transition-metal components.",
      "field": "intervention",
