      ],
      "same_system": "no"
    },
    {
      "text": "Cu-rich precipitates redistribute local stresses and improve load transfer during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Obstruction of dislocation motion and stress redistribution reduce localized shear during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
