  "claims": [
    {
      "text": "The initial Al0.1CrCoFeNi alloy is a disordered solid solution with a nearly random atomic distribution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic compressive loading induces an atomic clustering-to-ordering transition in Al0.1CrCoFeNi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compression-induced transition increases unlike-pair correlations such as Al-Co and Al-Cr.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compression-induced transition decreases like-pair correlations such as Al-Al.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tensile loading does not induce the clustering-to-ordering transition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "Compressive deformation causes atomic rearrangements that reduce local disorder by forming ordered clusters.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ordered clusters impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeded dislocation motion caused by the ordered clusters promotes strain hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The clustering-to-ordering transition increases strain hardening under compression relative to tension.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The clustering-to-ordering transition enhances strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The clustering-to-ordering transition enhances ductility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Compression produces a higher peak flow stress than tension at otherwise identical high-rate conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "Tensile loading produces minimal strain hardening relative to compression.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted mechanical and ordering effects are more pronounced below a spinodal temperature of approximately 840 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The compression-induced effects remain observable from 77 K to 1000 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis applies to Al0.1CrCoFeNi under deformation near 10^10 s^-1 over 77-1000 K.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC4976365::rubric_card::000::15644a8136"
      ],
      "same_system": "yes"
    },
    {
      "text": "The hypothesis should also hold for other high-entropy alloys with compositions similar to Al0.1CrCoFeNi.",
      "field": "boundary",
