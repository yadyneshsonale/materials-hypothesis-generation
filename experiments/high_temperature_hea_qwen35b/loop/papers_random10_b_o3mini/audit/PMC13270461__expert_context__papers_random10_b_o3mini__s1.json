      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed effects occur only above an approximate threshold temperature of 850 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing-induced heterogeneity or minor phases can alter surface reaction kinetics.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidizing exposure will cause limited mass gain and form an adherent composite oxide scale.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide scale formed under oxidizing exposure will contain characteristic Cr2O3 and TiO2.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
