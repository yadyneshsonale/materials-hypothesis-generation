      "same_system": "no"
    },
    {
      "text": "Standard CoCrFeNi tends to exhibit higher wear at elevated temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The elevated-temperature friction and wear of standard CoCrFeNi are caused by the absence of a stable self-lubricating phase.",
