  "claims": [
    {
      "text": "The baseline is conventional as-cast or standard-processed CoCrFeNi without engineered oxide dispersions.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing CoCrFeNi under controlled oxygen partial pressure will induce in-situ precipitation of nanoscale Cr2O3.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will produce a fine, uniformly dispersed Cr2O3 nanoprecipitate network.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr2O3 precipitates will be located at grain boundaries and the sliding interface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr2O3 precipitates act as a lubricious phase in CoCrFeNi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding will convert or organize the Cr2O3 precipitates into a stable, self-healing tribofilm.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr2O3-containing tribofilm will minimize metal-to-metal contact and adhesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film will adapt its lubricity as temperature changes.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-engineered CoCrFeNi will have a lower coefficient of friction than unmodified CoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-engineered CoCrFeNi will have a lower wear rate than unmodified CoCrFeNi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reductions in friction and wear will persist throughout approximately 25 °C to 800 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard CoCrFeNi tends to exhibit increased friction at elevated temperature.",
