  "claims": [
    {
      "text": "The baseline TiVNbTa alloy is a single-phase BCC dendritic alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a room-temperature yield strength of about 800 MPa.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to replace 0.5–1 at.% of Ti in TiVNbTa with Hf.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf additions will induce local lattice distortions in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf additions may promote beneficial grain-boundary segregation in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minor Hf additions may produce limited, finely dispersed secondary phases in TiVNbTa.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-induced microstructural changes will impede dislocation motion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf will reduce dislocation mobility and enhance grain-boundary cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced dislocation mobility and enhanced grain-boundary cohesion will increase the high-temperature yield strength of TiVNbTa.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf modification will not significantly disrupt the thermal conductivity needed for W-to-CuCrZr heat transfer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11375216::rubric_card::001::2376e969d1"
      ],
      "same_system": "no"
    },
    {
      "text": "At 1273 K, Hf-modified TiVNbTa will have a yield strength 20–30% above the 330 MPa baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-modified TiVNbTa will maintain room-temperature ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hf-modified TiVNbTa will retain acceptable thermal conductivity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11375216::rubric_card::001::2376e969d1"
      ],
      "same_system": "no"
    },
    {
      "text": "The beneficial effects will persist within the operating-temperature range of divertor components.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Hf or processing deviations can cause unwanted secondary phases that compromise stability and thermal performance.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 0.5 at.% Hf addition has previously been processed in a high-entropy alloy and evaluated for high-temperature mechanical behavior.",
      "field": "supporting_evidence_ids",
