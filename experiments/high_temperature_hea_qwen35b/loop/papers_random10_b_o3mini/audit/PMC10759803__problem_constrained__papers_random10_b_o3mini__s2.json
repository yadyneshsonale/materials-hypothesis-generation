  "claims": [
    {
      "text": "As-cast HfMoTaTiZr has a density of 10.21 g/cm³.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has high mechanical strength at room and elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A fraction of Hf, proposed as 10–30% of the Hf content, will be replaced by Al.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Mo, Ta, Ti, and Zr contents will remain unchanged during Hf-to-Al substitution.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Replacing Hf with lower-atomic-mass Al will lower the alloy's average density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Hf-to-Al substitution will reduce density by approximately 5–10% relative to as-cast HfMoTaTiZr.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy will retain a predominantly single-phase BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::rubric_card::000::249db7bc37",
        "PMC5978046::rubric_card::000::c87a8ff254"
      ],
      "same_system": "no"
    },
    {
      "text": "Hf-to-Al substitution may form nanoscale ordered precipitates in the modified alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "no"
    },
    {
      "text": "Fine ordered precipitates can provide precipitation strengthening in lightweight Al-containing high-entropy alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::rubric_card::000::82c51610a5"
      ],
      "same_system": "no"
    },
    {
      "text": "High mixing entropy will help the Al-substituted HfMoTaTiZr alloy maintain mechanical integrity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloy will have mechanical properties comparable to as-cast HfMoTaTiZr at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-substituted alloy will have mechanical properties comparable to as-cast HfMoTaTiZr at approximately 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed hypothesis applies from room temperature to approximately 1000 °C under loading comparable to standard tensile or compressive tests.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal Hf-replacement fraction for minimizing density without degrading mechanical properties is unknown.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The stability and nature of precipitates in the modified alloy are uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled alloy series with 0%, 10%, 20%, and 30% replacement of Hf by Al will be fabricated by identical melting and casting methods and characterized by density, mechanical, XRD, SEM, and TEM measurements.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis will be rejected if any Al-substituted alloy fails to lower density by at least 5% or loses at least 10% strength at room temperature or approximately 1000 °C.",
