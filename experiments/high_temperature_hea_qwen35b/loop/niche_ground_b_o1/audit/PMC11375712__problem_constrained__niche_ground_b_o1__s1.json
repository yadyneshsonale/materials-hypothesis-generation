      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "Excessive Al content or altered processing routes could degrade mechanical or magnetic properties.",
