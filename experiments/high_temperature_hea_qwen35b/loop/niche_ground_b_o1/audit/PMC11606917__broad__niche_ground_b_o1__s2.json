      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0",
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "CALPHAD supplies broad multicomponent composition-phase relations and equilibrium thermodynamic predictions.",
