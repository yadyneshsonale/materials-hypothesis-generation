        "PMC8282813::chunk::004::methods::fd16072951"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The approach applies to homogenized or as-cast multi-principal-element alloys spanning representative quaternary through senary compositions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-throughput DSC scans can determine melting temperature.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-throughput DSC scans can determine enthalpy and entropy of fusion.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-throughput DSC scans can extract volume changes at melting.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
