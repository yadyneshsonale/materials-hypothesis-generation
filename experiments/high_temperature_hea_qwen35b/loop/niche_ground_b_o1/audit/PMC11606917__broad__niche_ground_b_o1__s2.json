      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::chunk::003::discussion::b590527e4b",
        "PMC8282813::chunk::004::methods::fd16072951"
      ],
      "same_system": "yes"
    },
    {
      "text": "Atomistic simulations can leverage first-principles-based calculations to predict relevant HEA properties.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC4976365::chunk::000::abstract::c056d652e0"
      ],
      "same_system": "unclear"
    },
    {
