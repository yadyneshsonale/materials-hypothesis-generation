      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "As-cast HfMoTaTiZr has high strength at room and elevated temperatures.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::chunk::001::introduction::a5a32da999",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Replacing part of the Hf or Ta in HfMoTaTiZr with Al will reduce alloy density.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Al substitution can preserve strength and hardness from room temperature to at least 1000 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Approximately 10–20 at% Al should be substituted for Hf or Ta.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified HfMoTaTiZr alloy will form an Al-containing BCC solid solution.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965",
