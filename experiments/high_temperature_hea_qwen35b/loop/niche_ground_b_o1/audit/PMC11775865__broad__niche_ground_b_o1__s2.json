      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced atomic mobility delays chemical or phase segregation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Between 700 and 1100 °C, Al- or Ti-doped CoCrFeMnNi variants will retain smaller grains than identically treated undoped CoCrFeMnNi.",
