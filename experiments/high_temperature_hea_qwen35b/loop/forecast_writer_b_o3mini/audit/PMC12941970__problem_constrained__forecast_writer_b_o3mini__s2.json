  "claims": [
    {
      "text": "The starting material is monolithic CoCrFeNi without an added solid-lubricant phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to disperse 5–10 wt% CaF2 uniformly in the CoCrFeNi matrix.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dispersed CaF2 will form a continuous or semi-continuous CaF2-based tribofilm during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CaF2 has low shear strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CaF2 provides high-temperature lubricity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The CaF2-derived tribofilm will act as a protective lubricious layer at the sliding interface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The CaF2-derived tribofilm will minimize direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Minimizing direct metal-to-metal contact will reduce friction and wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The CaF2-derived tribofilm will remain sufficiently stable to maintain lubrication from 25 °C to 800 °C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CaF2-modified CoCrFeNi will have a lower coefficient of friction than unmodified CoCrFeNi throughout the 25–800 °C test range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CaF2-modified CoCrFeNi will have a lower wear rate than unmodified CoCrFeNi throughout the 25–800 °C test range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi has acceptable tribological performance over only part of the stated temperature range.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi experiences increased friction and wear at one or both extremes of the stated temperature range.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed performance prediction is bounded to sliding in ambient air at 25–800 °C and loads of approximately 10–20 N.",
