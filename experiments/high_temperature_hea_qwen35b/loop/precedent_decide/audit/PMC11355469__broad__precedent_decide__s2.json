  "claims": [
    {
      "text": "Wear performance of high-entropy-alloy protective coatings is governed by formation of a stable, coherent, thin oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The composition-dependent ratio of aluminum to the other alloying elements mediates oxide-layer formation and wear performance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline coating has composition FeCoCrNiAl0.2.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled intervention increases the aluminum coefficient from 0.2 to 0.5 while retaining Fe, Co, Cr, and Ni.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Testing will use dry sliding at room temperature, a 10 N normal load, and a sliding speed of 0.1 m/s.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing aluminum content produces a stable, coherent, thin oxide layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aluminum reacts with oxygen to form the proposed stable oxide layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer reduces wear by preventing direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing the aluminum coefficient from 0.2 to 0.5 will reduce wear rate by 30%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline wear rate is 2.5 × 10^-4 mm³/Nm and the modified coating's predicted wear rate is 1.75 × 10^-4 mm³/Nm.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is expected to hold over aluminum coefficients from 0.2 to 0.5.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain at least a 20% wear-rate decrease when increasing the aluminum coefficient from 0.2 to 0.5 falsifies the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
