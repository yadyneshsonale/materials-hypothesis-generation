  "claims": [
    {
      "text": "Adding approximately 5 at.% Al to a refractory high-entropy alloy will promote in situ formation of a continuous, adherent Al2O3 surface scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104",
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "unclear"
    },
    {
      "text": "An Al2O3 layer can provide high-temperature oxidation resistance in refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy rapidly oxidizes at approximately 1100°C in air.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The baseline alloy forms thick, nonprotective oxide scales under the specified extreme-temperature exposure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The approximately 5 at.% Al intervention will be effective during continuous exposure at approximately 1100°C in 21% oxygen for 100 hours.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention produces a dense and continuous Al2O3 barrier on the alloy surface.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::000::abstract::e30693f104",
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Added Al preferentially oxidizes to Al2O3.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al2O3 is thermodynamically stable under high-temperature oxidation conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting Al2O3 scale is slow-growing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al2O3 scale acts as a diffusion barrier that reduces oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "Reduced oxygen ingress mitigates further oxidation of the underlying alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Al-modified alloy will show approximately 30–50% lower oxidation than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will have lower mass gain per unit area than the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will form a thinner, continuous oxide scale relative to the untreated alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain its structural integrity after the oxidation exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidation can cause severe degradation of the mechanical properties of refractory high-entropy alloys.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6513993::chunk::001::introduction::4b945ce700"
      ],
      "same_system": "yes"
    },
    {
      "text": "Processing history, microstructure, and interactions with other alloying elements may alter the effectiveness of alumina-scale formation.",
      "field": "boundary",
