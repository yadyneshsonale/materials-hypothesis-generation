  "claims": [
    {
      "text": "The initial material is equiatomic cast HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic cast HfNbTaTiZr has yield strength up to 530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic cast HfNbTaTiZr undergoes rapid oxidation and pesting during high-temperature air exposure.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6317005::chunk::001::introduction::42ad25eeb0",
        "PMC7513042::chunk::001::introduction::f13797f6f6"
      ],
      "same_system": "no"
    },
    {
      "text": "Adding 3–5 at.% Al to equiatomic cast HfNbTaTiZr will improve its high-temperature oxygen resistance.",
      "field": "hypothesis; intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al in the modified alloy will oxidize preferentially during high-temperature exposure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al addition will rapidly form a continuous and adherent Al2O3 surface scale.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting alumina scale will be thermodynamically stable and slow-growing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The alumina scale will act as a barrier to oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricting oxygen ingress will inhibit pesting and reduce oxide spallation and oxidation weight gain relative to untreated material.",
      "field": "mechanism; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 3–5 at.% Al addition will not significantly alter the bulk microstructure or produce deleterious phases.",
      "field": "mechanism; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain room-temperature tensile ductility similar to that of untreated equiatomic HfNbTaTiZr.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Al-modified alloy will retain high-temperature yield strength comparable to that of untreated equiatomic HfNbTaTiZr.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed oxidation protection is expected to apply in air at 800–1000 °C for exposures of approximately 5 hours.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection and retained mechanical performance are expected under loading at strain rates of 10^-4–10^-2 s^-1.",
      "field": "conditions; boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation resistance in refractory high-entropy alloys depends strongly on alloy composition and testing conditions.",
      "field": "uncertainty",
