    {
      "text": "Replacing 5–15% of the Hf content with V is the proposed intervention for as-cast HfMoTaTiZr.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Partial Hf-to-V substitution will reduce the density of as-cast HfMoTaTiZr by approximately 5–10%.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5995863::chunk::001::introduction::a6c9e13965"
      ],
      "same_system": "no"
    },
    {
      "text": "Partial Hf-to-V substitution will retain the room-temperature yield strength of as-cast HfMoTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::001::introduction::03a7cc91e7"
      ],
      "same_system": "no"
    },
    {
