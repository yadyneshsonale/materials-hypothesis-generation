      ],
      "same_system": "unclear"
    },
    {
      "text": "The wear-resistance enhancement is caused by more rapid and robust formation of a shear-induced, oxidation-accelerated protective tribolayer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "HEA protective coatings typically have a multiphase microstructure and moderate grain size under standard deposition conditions.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing changes can refine an HEA microstructure and increase its grain-boundary density without intentionally changing its nominal alloy composition.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c",
