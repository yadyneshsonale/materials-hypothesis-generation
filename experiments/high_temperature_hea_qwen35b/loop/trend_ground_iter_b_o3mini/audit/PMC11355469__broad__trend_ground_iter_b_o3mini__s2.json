      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::chunk::000::abstract::5d6ac9a02c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Nanoscale grain boundaries act as active sites for localized shear and tribolayer nucleation.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater grain-boundary area accelerates local oxidation reactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater grain-boundary area accelerates local shear during sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sliding of an HEA can form a protective oxide layer that improves wear resistance.",
