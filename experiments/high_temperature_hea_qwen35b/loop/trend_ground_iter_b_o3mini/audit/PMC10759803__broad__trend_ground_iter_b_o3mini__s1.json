  "claims": [
    {
      "text": "The as-cast NbMoCrTiAl baseline has a multi-principal-element BCC solid-solution structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy contains no pre-existing oxide dispersion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A minimal oxygen addition during melting will trigger in-situ formation of oxide particles such as Al2O3 in NbMoCrTiAl.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615"
      ],
      "same_system": "yes"
    },
    {
      "text": "The resulting oxide dispersion will be uniform, ultra-fine, and coherent with the HEA matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::003::discussion::5f899153c9"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide nanoparticles will obstruct dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::003::discussion::5f899153c9"
      ],
      "same_system": "no"
    },
    {
      "text": "The oxide nanoparticles will pin and stabilize grain boundaries at elevated temperatures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoscale size and coherent interfaces of the oxides will prevent an adverse effect on room-temperature ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::003::discussion::5f899153c9"
      ],
      "same_system": "no"
    },
    {
      "text": "The minimal oxide addition will not materially increase the alloy density.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-doped alloy will exhibit approximately 15–20% higher high-temperature yield strength than the inert-processed as-cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-doped alloy will have a lower creep rate than the inert-processed baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-doped alloy will maintain room-temperature mechanical performance relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::chunk::000::abstract::b55c769615",
        "PMC7229066::chunk::003::discussion::5f899153c9"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed improvements should hold during sustained creep and cyclic loading between 800°C and 1100°C.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::chunk::003::discussion::5f899153c9"
      ],
      "same_system": "no"
    },
    {
      "text": "Excess oxygen may produce larger, incoherent oxide phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger, incoherent oxide phases may embrittle the alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Larger oxide phases may increase the density of the alloy.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Insufficient oxygen will fail to produce a beneficial oxide nanodispersion.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal oxygen concentration window is not yet established and must be determined experimentally.",
      "field": "uncertainty",
