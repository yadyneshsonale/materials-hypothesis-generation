  "claims": [
    {
      "text": "Wear performance of FeCoCrNiMn high-entropy-alloy protective coatings is governed by the formation of a stable, coherent surface oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stable, coherent oxide layer acts as a barrier to abrasive wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A stable, coherent oxide layer reduces the coefficient of friction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial coating is an as-deposited, polycrystalline FeCoCrNiMn high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The controlled intervention is annealing at 800°C for 1 hour in an inert atmosphere.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing produces or stabilizes the coherent oxide layer proposed as the structural mediator.",
      "field": "intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide layer prevents direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preventing direct metal-to-metal contact reduces abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dry sliding at 10 N and 0.1 m/s, the annealed coating is expected to have a 30% lower wear rate than the as-deposited coating.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed mechanism should hold for FeCoCrNiMn high-entropy-alloy coatings annealed between 700°C and 900°C.",
