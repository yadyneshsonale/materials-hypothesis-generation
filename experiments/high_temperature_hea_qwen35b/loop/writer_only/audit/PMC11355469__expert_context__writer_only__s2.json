  "claims": [
    {
      "text": "The overall wear resistance of FeNiCrCoCu thin protective coatings is governed by the formation of a stable oxide-based tribofilm at high temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide-based tribofilm acts as a lubricating layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of the oxide-based tribofilm reduces frictional forces.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed system is a thin FeNiCrCoCu coating deposited on a conventional metal substrate.",
      "field": "material_initial_state",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is annealing the coating at 600°C for 1 hour relative to an unannealed coating.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing at 600°C for 1 hour enhances formation of a stable oxide-based tribofilm on FeNiCrCoCu.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The annealing-enhanced tribofilm reduces the coating's wear rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under dry sliding above 300°C, annealing will reduce wear rate by 30% relative to the unannealed baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed test boundary is 200–500°C at a normal load of 10 N and a sliding speed of 0.1 m/s.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
