  "claims": [
    {
      "text": "The initial FeCoNiCrMn alloy is equiatomic.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial FeCoNiCrMn alloy has a homogeneous FCC structure after annealing at 800 °C and slow cooling.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is incorporation of 0.5 at.% carbon as an interstitial dopant during melting.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-doped and baseline alloys will be annealed at 800 °C for 24 h and slow-cooled to 25 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon interstitials will generate local lattice-strain fields in FeCoNiCrMn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon-induced lattice strain will be detectable as microstrain by X-ray diffraction.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon-induced strain fields will act as magnetic-domain-wall pinning sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Domain-wall pinning will raise the energy barrier for domain-wall motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The increased barrier to domain-wall motion will increase coercivity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 0.5 at.% interstitial carbon will increase the coercive field by approximately 30–50% relative to an identically processed undoped FeCoNiCrMn alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity-enhancing effect is expected to hold for carbon concentrations up to approximately 1 at.%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The effect is expected to hold for annealing temperatures between 700 and 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coercivity enhancement may diminish if carbon precipitates or carbides form at higher carbon concentrations.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The magnitude of the coercivity increase depends on carbon distribution and microstructural homogeneity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
