      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline CoCrFeNi has a coefficient of friction of approximately 0.6 or higher at 800 °C.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear rate of baseline CoCrFeNi rises with temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The rising wear rate of baseline CoCrFeNi is caused by oxide-dominated wear.",
