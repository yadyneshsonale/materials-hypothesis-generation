  "claims": [
    {
      "text": "Preheating the build plate and powder bed to 250 °C during PBF-LB of equimolar CoCrFeNiMn lowers cooling rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating to 250 °C reduces thermal gradients during the build.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced thermal gradients lead to lower residual stresses.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower residual stress reduces stress concentrations that nucleate microcracks and pores.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The elevated base temperature promotes homogeneous nucleation of equiaxed grains rather than columnar growth.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention produces a fine, uniform equiaxed grain microstructure.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting microstructure has fewer microcracks and less porosity.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing residual stress, microcracks, and porosity improves dimensional precision and mechanical integrity.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating will reduce warpage by at least 30% relative to ambient-temperature builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating will reduce bulk porosity by at least 25% relative to ambient-temperature builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating will increase ultimate tensile strength by approximately 5–10% relative to ambient-temperature builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preheating will increase elongation to failure by approximately 10% relative to ambient-temperature builds.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ambient-temperature baseline builds have approximately 0.8 ± 0.2% porosity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ambient-temperature baseline builds exhibit approximately 0.5 mm warpage over a 50 mm length.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ambient-temperature baseline builds have an ultimate tensile strength of approximately 650 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ambient-temperature baseline builds have approximately 20% elongation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is expected to hold for equimolar CoCrFeNiMn processed at 200–300 W, 30–50 µm layers, and scan speeds of 600–1000 mm/s.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed effect may not apply to other HEA compositions or to directed-energy-deposition processes.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The estimated improvements are based on analogous results in Ni-base superalloys and Ti-6Al-4V.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Direct evidence for the proposed effect in PBF-LB CoCrFeNiMn is lacking.",
