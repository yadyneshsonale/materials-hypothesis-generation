  "claims": [
    {
      "text": "The intervention replaces 2 at.% Fe with Mo in an FeCoNiCrP alloy containing 5 at.% P.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 2 at.% Mo-for-Fe substitution will improve glass-forming ability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 2 at.% Mo-for-Fe substitution will improve the thermal stability of the amorphous state.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mo substitution increases chemical mismatch.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
