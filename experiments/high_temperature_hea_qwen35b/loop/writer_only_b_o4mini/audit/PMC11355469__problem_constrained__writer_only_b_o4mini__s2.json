      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr enrichment will produce a thicker Cr2O3 tribo-oxide scale than the equiatomic baseline.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A thicker, coherent Cr2O3 layer acts as a protective barrier during sliding.",
