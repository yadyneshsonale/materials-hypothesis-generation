      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Under the same sliding conditions, the Cr-enriched coating will have a thinner subsurface plastic-deformation zone than the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predictions are intended to hold during sliding at 500–700 °C in air.",
