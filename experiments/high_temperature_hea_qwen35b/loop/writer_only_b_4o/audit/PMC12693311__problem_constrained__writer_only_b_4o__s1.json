      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified Cr16Mn16Fe16Co16Ni16P20 forms several primary non-eutectic phases during solidification.",
