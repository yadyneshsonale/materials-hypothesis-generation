      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "B addition will suppress primary crystallization.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
