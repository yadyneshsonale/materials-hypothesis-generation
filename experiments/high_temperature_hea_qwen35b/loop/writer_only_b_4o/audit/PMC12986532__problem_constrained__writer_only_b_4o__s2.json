      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice distortion increases the energy required for dislocation movement.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combined effects of nanoscale precipitates and lattice distortion reduce creep-deformation rates.",
      "field": "mechanism",
