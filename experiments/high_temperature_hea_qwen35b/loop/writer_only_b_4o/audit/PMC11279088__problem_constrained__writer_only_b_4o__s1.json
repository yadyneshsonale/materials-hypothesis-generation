  "claims": [
    {
      "text": "Preferential segregation of Cr to the alloy surface governs formation and persistence of a stable protective oxide layer above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Surface-segregated Cr enables formation of a continuous Cr2O3 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous Cr2O3 layer protects CrFeCoNiX alloys during oxidative or corrosive exposure above 900 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Using Al as X promotes formation of a mixed Al2O3-Cr2O3 oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Al2O3-Cr2O3 layer is more thermodynamically stable than the oxides formed when X is Si or Mn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed Al2O3-Cr2O3 layer has better mechanical integrity than the oxides formed when X is Si or Mn.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si- or Mn-containing variants may form less protective oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si- or Mn-containing variants may form more brittle oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermal stress causes the less protective or more brittle oxides to crack or spall.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiAl will develop a stable, coherent oxide layer with minimal cracking or spalling.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiSi will develop a less stable oxide layer prone to cracking or spalling relative to CrFeCoNiAl.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "CrFeCoNiMn will develop a less stable oxide layer prone to cracking or spalling relative to CrFeCoNiAl.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies to both single- and multiphase metallic solid-solution states in oxidative or corrosive atmospheres above 900 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
