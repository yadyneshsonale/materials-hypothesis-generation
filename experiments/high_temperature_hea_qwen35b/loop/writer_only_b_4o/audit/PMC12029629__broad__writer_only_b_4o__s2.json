      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe lattice distortions enhance strain hardening under dynamic loading.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
