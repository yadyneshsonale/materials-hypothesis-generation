      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature degradation is governed by selective oxidation of Cr and Ti at grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary oxidation produces brittle oxide phases.",
