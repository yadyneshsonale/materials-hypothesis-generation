  "claims": [
    {
      "text": "The initial TiVNbTa alloy is a single-phase BCC alloy with a dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is to add approximately 0.5-1 atomic percent carbon to TiVNbTa.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding carbon to TiVNbTa will produce carbide precipitates.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting carbide precipitates will be fine and distributed within the BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbide precipitates will remain stable at temperatures up to 1273 K.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbide precipitates impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbide precipitates impede grain-boundary sliding.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation motion and grain-boundary sliding are dominant mechanisms of high-temperature strength degradation in this alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reported baseline yield strength is 330 MPa at 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The reported baseline compressive strength is 423 MPa at 30% strain and 1273 K.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will increase yield strength at 1273 K by approximately 20-40% relative to 330 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Carbon addition will produce a proportional increase in compressive strength at 30% strain.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed hypothesis applies under compression at temperatures up to 1273 K and strains up to 30%.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The carbon fraction needed to optimize carbide formation without compromising ductility is uncertain.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to increase both specified strengths by at least 20%, or failure to observe stable carbide precipitates, is designated as falsifying the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
