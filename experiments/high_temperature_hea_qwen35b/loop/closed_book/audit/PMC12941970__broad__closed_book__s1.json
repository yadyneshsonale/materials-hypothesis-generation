      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The graphene coating acts as a barrier against oxidation and corrosion, thereby reducing wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating produces at least a 30% reduction in coefficient of friction relative to the untreated alloy.",
