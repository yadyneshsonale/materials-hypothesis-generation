  "claims": [
    {
      "text": "Aluminum oxide layer formation through pack cementation can improve the high-temperature oxygen resistance of refractory high-entropy alloys.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pack cementation with aluminum oxide will produce an aluminum oxide layer on the alloy surface.",
      "field": "intervention; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The aluminum oxide surface layer will prevent or impede oxygen diffusion into the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Impeding oxygen diffusion will reduce oxidation of the alloy.",
