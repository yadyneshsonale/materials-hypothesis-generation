      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "After 100 hours at 1000°C in air, the treated alloy will have an oxidation rate at least 50% lower than that of the untreated alloy.",
