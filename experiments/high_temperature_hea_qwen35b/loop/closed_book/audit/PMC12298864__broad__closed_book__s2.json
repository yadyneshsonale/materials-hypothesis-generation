      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The strength of high-entropy alloys is governed by the formation of a disordered lattice structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A disordered lattice hinders dislocation movement.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Hindered dislocation movement increases resistance to deformation.",
