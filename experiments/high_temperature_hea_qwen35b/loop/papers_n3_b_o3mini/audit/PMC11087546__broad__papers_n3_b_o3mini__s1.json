      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Conventionally processed NbMoCrTiAl contains relatively coarse TiC and Al2O3 particles.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The ceramic-particle-containing NbMoCrTiAl composite has greater strength than the as-cast alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "yes"
    },
    {
