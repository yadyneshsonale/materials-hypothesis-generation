  "claims": [
    {
      "text": "The baseline TiVNbTa alloy is a single-phase BCC dendritic material.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a yield strength of approximately 330 MPa at 1273 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Baseline TiVNbTa has a compressive strength of approximately 423 MPa at 1273 K and 30% strain.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed intervention is addition of approximately 1–2 at.% carbon to TiVNbTa.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A tailored heat treatment after carbon addition will promote TiC nucleation and dispersion.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon-modified TiVNbTa will contain fine, coherent TiC nanoprecipitates distributed within its BCC matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "TiC precipitates will impede dislocation motion through precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "The TiC precipitates will refine the TiVNbTa microstructure.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent TiC interfaces will preserve ductility while increasing high-temperature mechanical stability and yield-strength retention.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An NbMoCrTiAl composite reinforced with in-situ TiC and Al2O3 exhibited an approximately 50% increase in room-temperature compressive fracture strength relative to as-cast NbMoCrTiAl.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon modification is predicted to increase TiVNbTa yield strength at 1273 K by approximately 40–50% relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "Carbon modification is predicted to increase TiVNbTa compressive strength at 1273 K by approximately 40–50% relative to the baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7513042::rubric_card::000::c40db9eaa7"
      ],
      "same_system": "no"
    },
    {
      "text": "The strength improvement will occur without severely compromising ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The modified alloy's ductility will remain compatible with W-to-CuCrZr heat-transfer and mechanical requirements.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted improvement requires TiC precipitates to remain fine, evenly dispersed, and coherent over the operating-temperature range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive carbon or suboptimal processing could cause deleterious phase formation or precipitate coarsening.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The relevant performance boundary is compression at approximately 1273 K to strains of up to 30%.",
      "field": "conditions",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
