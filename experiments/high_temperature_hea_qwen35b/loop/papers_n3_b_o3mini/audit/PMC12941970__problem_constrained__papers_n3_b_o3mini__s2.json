  "claims": [
    {
      "text": "The starting material is equiatomic CoCrFeNi.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting CoCrFeNi alloy has a solid-solution microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi has low friction at room temperature.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi develops increased friction at elevated temperatures.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Unmodified CoCrFeNi develops increased wear at elevated temperatures because of uncontrolled oxidation and tribochemical reactions.",
      "field": "material_initial_state; baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention is addition of 3–5 at.% Al to CoCrFeNi.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 3–5 at.% Al addition will promote an in situ continuous, stable, nanocrystalline, adherent Al2O3 tribofilm.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At low temperatures, the alumina tribofilm will be lubricious and reduce metal-to-metal contact.",
      "field": "structural_mediator; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At temperatures up to 800 °C, thermally stable Al2O3 will act as a protective oxide scale.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective alumina scale will suppress further tribochemical oxidation and abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al-modified CoCrFeNi will maintain low friction and wear from room temperature through 800 °C.",
      "field": "hypothesis; mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will have a consistently lower coefficient of friction than unmodified CoCrFeNi over the full temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The Al-modified alloy will have a consistently lower wear rate than unmodified CoCrFeNi over the full temperature range.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed applicability boundary is dry sliding in ambient air from room temperature to 800 °C.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed load boundary is approximately 1 N.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed sliding-speed boundary is approximately 0.1 m/s.",
      "field": "conditions; boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al addition may adversely alter phase stability or ductility at lower temperatures.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective role of Al2O3 at high temperature is well documented.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain statistically significant reductions in both friction and wear at room temperature and 800 °C relative to an unmodified control will falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Formation of deleterious phases that compromise mechanical integrity will falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
