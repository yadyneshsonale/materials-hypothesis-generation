      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature reciprocating wear tests at 800–900 °C should be compared with room-temperature tests under similar loads.",
      "field": "intervention",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
