  "claims": [
    {
      "text": "Equiatomic HfNbTaTiZr can be produced from hydride and elemental powders by vacuum sintering at about 1400 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "The established starting alloy contains approximately 1 wt% oxygen.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slow cooling after sintering produces a multiphase microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "The slow-cooled microstructure specifically consists of β-BCC and α-HCP phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention introduces approximately 1 wt% interstitial oxygen during synthesis.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Water quenching from approximately 1500 °C will stabilize a single metastable β-BCC phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A silicide coating can be applied to HfNbTaTiZr by pack cementation.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "High-temperature mechanical behavior should be assessed over 750–1100 °C.",
      "field": "conditions",
      "needs_support": false,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior should hold under dual-beam irradiation conditions near 1073 K.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial oxygen creates local lattice distortion that impedes dislocation motion and produces solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid quenching suppresses formation of mechanically deleterious multiphase microstructures.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A uniform single-phase β-BCC microstructure supports formation of a coherent silicide coating.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The silicide coating provides oxidation protection.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_card::000::9919fb4b11"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of (Zr,Hf)O2 enables self-healing of coating cracks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating's proposed crack-healing mechanism contributes to irradiation stability.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxygen-tailored, rapidly quenched alloy will have significantly higher high-temperature yield strength than the slow-cooled multiphase baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will not compromise oxidation resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention will not compromise irradiation stability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excess oxygen or insufficiently rapid quenching may cause phase separation or brittle-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
