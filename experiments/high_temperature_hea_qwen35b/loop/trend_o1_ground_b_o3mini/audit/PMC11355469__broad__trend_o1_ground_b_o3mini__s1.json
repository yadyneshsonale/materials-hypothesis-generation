  "claims": [
    {
      "text": "In frictional wear of HEA protective coatings, in-situ formation of an oxide tribofilm is the dominant wear-resistance mechanism.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective tribofilm is a stable, adherent oxide or spinel.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The protective tribofilm forms under elevated-temperature, oxygen-rich conditions.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "Formation of the tribofilm reduces friction and material removal.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "Powder-metallurgically processed AlCoCrFeNiTi0.5 has a predominantly solid-solution microstructure before wear.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "AlCoCrFeNiTi0.5 can be treated as a protective coating produced by powder metallurgy or sputtering.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In-situ Raman spectroscopy or synchrotron X-ray diffraction can monitor oxide-film formation during wear.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::chunk::000::abstract::5201bb0b99"
      ],
      "same_system": "no"
    },
    {
      "text": "Around 300°C is sufficient for the proposed oxidation-mediated wear mechanism in the stated HEA coating.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Friction locally raises the contact-interface temperature enough to promote oxidation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In oxygen-rich conditions, a protective oxide layer forms on the HEA surface.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxide layer reduces direct metal-to-metal contact by acting as a barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diminished tribo-oxide formation in oxygen-poor conditions causes higher wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Diminished tribo-oxide formation in oxygen-poor conditions causes higher friction.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-rich testing will produce a measurably thicker and more stable oxide tribofilm than oxygen-depleted testing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen-rich testing will yield a lower wear rate than oxygen-depleted testing.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
