      ],
      "same_system": "no"
    },
    {
      "text": "The Al2O3 coating will impede oxygen ingress into the underlying alloy at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10142552::chunk::001::introduction::6f0510eec9",
        "PMC7475834::chunk::000::abstract::d1ff4579e4"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will significantly improve the high-temperature oxidation resistance of HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::000::abstract::d1ff4579e4",
        "PMC10142552::chunk::001::introduction::6f0510eec9"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will reduce oxide-scale formation relative to untreated HfNbTaTiZr.",
