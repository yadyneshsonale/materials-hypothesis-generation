      "support": "partial",
      "supporting_ids": [
        "PMC4145285::chunk::000::abstract::c334ecd44f",
        "PMC4145285::chunk::002::discussion::f8c841f9e4"
      ],
      "same_system": "yes"
    },
    {
      "text": "As-cast AlCoCrFeNi2.1 has a two-phase lamellar FCC/B2 microstructure.",
