  "claims": [
    {
      "text": "The additively manufactured Al0.2Co1.5CrFeNi1.5Ti0.3 alloy begins with a homogeneous FCC matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting material has minimal pre-existing oxides and intact grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The starting material has a refined microstructure characteristic of additive manufacturing.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature oxidizing exposure causes Ti and Al to segregate preferentially to grain boundaries.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Segregated Ti and Al oxidize to form continuous oxide layers along grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting oxide is non-protective.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_card::000::8d6800c362"
      ],
      "same_system": "no"
    },
    {
      "text": "High-temperature oxidation behavior depends on whether exposure occurs in an oxygen-rich or oxygen-poor environment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_card::000::8d6800c362"
      ],
      "same_system": "no"
    },
    {
      "text": "Continuous grain-boundary oxide layers reduce intergranular cohesive strength.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Weakened oxide-bearing grain boundaries act as crack-initiation sites.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxide-induced intergranular cracking can lead to catastrophic failure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A hydrogen-rich reducing environment suppresses Ti and Al segregation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reducing environment limits oxide formation and consequently preserves intergranular cohesion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_card::000::8d6800c362"
      ],
      "same_system": "no"
    },
    {
      "text": "Under oxidizing conditions, grain-boundary oxide layers thicken with exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure increases the density of intergranular cracks relative to the as-manufactured state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidizing exposure significantly reduces tensile strength and creep strength relative to the as-manufactured state.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reducing exposure maintains a microstructure closer to the starting baseline and yields better mechanical performance than oxidizing exposure.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies between 800 and 900 degrees Celsius for exposures up to 100 hours, comparing oxygen partial pressures at least as high as air with hydrogen-rich reducing conditions.",
