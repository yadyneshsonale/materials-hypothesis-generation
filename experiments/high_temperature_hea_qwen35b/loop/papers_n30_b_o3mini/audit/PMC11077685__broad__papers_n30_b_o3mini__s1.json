  "claims": [
    {
      "text": "The substrate is a bulk MoNbTaTiW refractory high-entropy alloy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial MoNbTaTiW alloy has a dendritic microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated MoNbTaTiW oxidizes rapidly at high temperature and forms a thick, nonprotective scale.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Applying a Si-20Cr-20Fe silicide coating will improve the high-temperature oxygen resistance of MoNbTaTiW.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Si-20Cr-20Fe coating can be deposited by a fused-slurry process followed by high-temperature heat treatment.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The relevant oxidation test uses 1000 °C for 1 hour with an approximately 10 °C/min heating rate.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxidation exposure is conducted in static air.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "A comparison oxidation test can be conducted at 1300 °C for 1 hour.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial coating has an outer high-silicon MSi2 layer and an inner low-silicon M5Si3 layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxidation of the double-layer silicide coating produces a protective oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "yes"
    },
    {
      "text": "Silicon and chromium diffuse during exposure and react with oxygen.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxidation products include stable SiO2 and chromium-bearing oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting oxide is continuous and adherent and acts as a barrier to oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating suppresses oxygen ingress and breakaway oxidation relative to the untreated alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated specimens will have lower mass gain than untreated specimens under the stated test conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated specimens will have a thinner oxide scale than untreated specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated specimens will have a more adherent oxide scale than untreated specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coated specimens will exhibit less oxygen penetration than untreated specimens.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective benefit should be significant around 1000 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above approximately 1300 °C, scale spallation or volatile oxide formation may diminish the protective effect.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
