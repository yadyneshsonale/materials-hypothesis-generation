  "claims": [
    {
      "text": "The starting material is equiatomic cast HfNbTaTiZr.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast equiatomic HfNbTaTiZr has 8–16% room-temperature tensile ductility.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic HfNbTaTiZr has a yield strength of 163–530 MPa at 1000 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Equiatomic HfNbTaTiZr has inadequate oxidation resistance in air.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A Si–20Cr–20Fe coating can be deposited by a fused-slurry method followed by heat treatment at approximately 1430 °C for 1 hour in a low-pressure or controlled atmosphere.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating will be thin and diffusion-bonded to cast equiatomic HfNbTaTiZr.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating heat treatment promotes interfacial diffusion and in situ silicide formation.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "no"
    },
    {
      "text": "The coating on HfNbTaTiZr will form an outer high-silicon MSi2 layer and an inner lower-silicon M5Si3 layer.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::rubric_card::000::2a469694d7"
      ],
      "same_system": "no"
    },
    {
      "text": "Oxidation of the dual-layer silicide structure will produce a continuous, dense, adherent oxide scale.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide will comprise silica and mixed-metal oxides.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale will act as an oxygen-diffusion barrier and significantly slow oxygen ingress.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Slower oxygen ingress will minimize pesting of equiatomic HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating will significantly reduce mass gain relative to untreated cast HfNbTaTiZr during exposure at 1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coating and its heat treatment will not alter the beneficial bulk microstructure of HfNbTaTiZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Room-temperature tensile ductility will remain within an acceptable range relative to untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature yield strength will remain within an acceptable range relative to untreated material.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Untreated equiatomic cast HfNbTaTiZr undergoes rapid oxidation with exponential kinetics and high mass gain under similar conditions.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection is applicable in static air at approximately 1000 °C for exposures up to 5 hours.",
      "field": "boundary",
      "needs_support": true,
