    {
      "text": "The Cr addition does not increase irradiation-induced defect accumulation relative to the baseline alloy.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
