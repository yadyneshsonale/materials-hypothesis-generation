      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A 0.5 at.% Hf addition increases high-temperature yield strength by approximately 20–50% relative to the Hf-free baseline.",
