      ],
      "same_system": "no"
    },
    {
      "text": "The BCC lattice of equimolar WTaTiVZr is severely distorted.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Commercially pure tungsten has a coarse-grained BCC structure under the proposed comparison.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "WTaTiVZr exhibits superior high-temperature plastic strain and toughness relative to pure tungsten.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe lattice distortion produces the nanocrystalline microstructure and its high grain-boundary density.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Severe lattice distortion disrupts classical dislocation slip in WTaTiVZr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The high grain-boundary area of nanocrystalline WTaTiVZr promotes grain-boundary sliding and intergranular plastic flow at high temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary-mediated flow produces more uniform deformation and greater energy absorption.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain-boundary-mediated plasticity delays void formation, crack initiation, and crack propagation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, WTaTiVZr will have a lower yield stress than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high temperature, WTaTiVZr will have much higher total plastic strain and fracture toughness than pure tungsten.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Post-deformation analysis of WTaTiVZr will show intergranular features and evidence of grain-boundary sliding.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Pure tungsten will deform predominantly by dislocation slip and exhibit cleavage fracture with limited plasticity.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed grain-boundary-mediated mechanism is applicable between 800 and 1100 degrees Celsius.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At lower temperatures or under different loading modes, WTaTiVZr may revert to predominantly dislocation-mediated plasticity.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing-dependent grain-size distributions and residual stresses influence the magnitude of ductility, toughness, and grain-boundary sliding.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
