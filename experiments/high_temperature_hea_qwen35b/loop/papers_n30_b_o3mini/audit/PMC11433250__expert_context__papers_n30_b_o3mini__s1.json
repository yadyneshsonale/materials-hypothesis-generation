  "claims": [
    {
      "text": "Single-phase ZrB2 requires processing temperatures above 2300 °C.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Undoped ZrB2 processed below about 1700 °C has inadequate oxidation protection.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lower-temperature undoped ZrB2 is vulnerable to corrosion by liquid plating metals.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding 2–5 wt% Si permits ZrB2 densification at approximately 1600–1700 °C.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon reacts during processing to form a thin, continuous borosilicate glass phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed borosilicate phase contains SiO2, B2O3, and related compounds.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The borosilicate phase forms along ZrB2 grain boundaries and interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Silicon promotes densification during lower-temperature processing.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Exposure to oxidizing or liquid-plating environments causes Si, oxygen, and boron to form a self-healing protective borosilicate layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective borosilicate layer limits oxygen ingress by acting as a diffusion barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective borosilicate layer limits attack and penetration by liquid plating metal.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will have a lower oxidation rate than undoped ZrB2 processed at the same lower temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will show lower oxidation mass gain than the undoped control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will develop a thinner and more adherent oxide scale than the undoped control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will exhibit less liquid-metal penetration or a lower corrosion rate than the undoped control.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Si-doped ZrB2 will retain comparable or slightly improved strength and structural integrity.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed protection is expected to operate for Si additions of roughly 2–5 wt% and sintering temperatures of about 1600–1700 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive Si may produce detrimental secondary phases.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Processing outside the proposed temperature and composition windows may cause incomplete densification.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
