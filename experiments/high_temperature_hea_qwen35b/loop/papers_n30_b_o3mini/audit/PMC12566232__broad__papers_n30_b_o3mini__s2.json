      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated alloy has compressive or yield strength of approximately 1540 MPa.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated alloy has limited ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The untreated alloy exhibits cleavage-dominated fracture.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 4 at.% Cr to HfMoTaTiZr causes a Laves phase to form.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr-modified alloy contains both BCC and Laves phases.",
