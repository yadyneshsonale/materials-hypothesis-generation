      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated HfMoTaTiZr alloy is single-phase BCC.",
