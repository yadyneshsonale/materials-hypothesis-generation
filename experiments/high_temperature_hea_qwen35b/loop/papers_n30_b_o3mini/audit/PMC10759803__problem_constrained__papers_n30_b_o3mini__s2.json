      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The substitution will preserve the solid-solution and any precipitation-strengthening mechanisms of the original alloy.",
      "field": "mechanism",
