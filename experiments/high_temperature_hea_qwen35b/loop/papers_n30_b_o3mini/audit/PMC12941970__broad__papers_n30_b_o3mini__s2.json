  "claims": [
    {
      "text": "The as-deposited equimolar CuMoTaWV film is a nanocrystalline BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-deposited CuMoTaWV film has a relatively rough surface.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited CuMoTaWV film has weak adhesion.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated film has higher friction and wear than an annealed film.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The intervention is post-deposition annealing at approximately 300°C in a mildly oxidative atmosphere.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "Controlled oxidative annealing induces a uniform nanoscale CuO surface film on CuMoTaWV.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting CuO or similar oxide layer is coherent, stable, and adherent during sliding.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The in situ grown CuO film acts as a solid lubricant.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film reduces interfacial shear by preventing direct metal-to-metal contact.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide film redistributes contact stresses.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced shear and redistributed stress minimize plastic deformation and abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing will produce roughly a twofold reduction in room-temperature coefficient of friction relative to the untreated film.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Annealing will reduce wear rate by as much as two orders of magnitude relative to the untreated film.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The friction and wear improvements will be maintained from room temperature to approximately 300°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "The untreated film does not form a stable lubricious surface oxide.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive oxidation or degradation of the nanocrystalline structure may eliminate the tribological improvement.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance at temperatures substantially above 300°C is uncertain.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimal annealing duration, oxygen partial pressure, long-term oxide stability, and behavior under cyclic or prolonged loading remain unquantified.",
      "field": "uncertainty",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A controlled experiment will compare annealed and untreated CuMoTaWV films using sliding tests from room temperature to 300°C and measure friction, wear, and surface chemistry.",
      "field": "falsification_experiment.design",
      "needs_support": false,
      "support": "entailed",
      "supporting_ids": [
        "PMC7304825::rubric_card::000::6980db1684"
      ],
      "same_system": "yes"
    },
    {
      "text": "Failure to obtain a statistically significant reduction in both friction and wear, or failure to confirm a coherent stable CuO layer, is defined as falsifying the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
