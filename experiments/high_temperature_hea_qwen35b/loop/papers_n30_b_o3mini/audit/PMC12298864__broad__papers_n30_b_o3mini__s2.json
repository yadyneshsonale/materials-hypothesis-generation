  "claims": [
    {
      "text": "A suitable baseline HEA is a single-phase BCC or FCC solid solution lacking pronounced secondary precipitates.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The baseline alloy has relatively coarse grains.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Adding approximately 4 at.% Cr to an HEA can induce a Laves secondary phase.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "Stepwise thermomechanical treatment and aging can produce coherent precipitation structures.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Oxygen introduced during mechanical alloying and spark-plasma sintering can be used to form strengthening secondary phases.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5978046::rubric_card::000::c87a8ff254"
      ],
      "same_system": "yes"
    },
    {
      "text": "The oxygen-assisted route specifically produces coherent nanoscale TiO precipitates.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The engineered secondary phases are uniformly dispersed and coherent within a refined-grain matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Coherent secondary phases generate local lattice misfits and interfacial energy barriers that impede dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The precipitates strengthen the alloy through dislocation pinning and delayed nucleation of kinks.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Grain refinement increases strength through the Hall–Petch effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Precipitation can substantially raise yield strength relative to an as-cast or single-phase baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3",
        "PMC10759803::rubric_card::000::1894dec07a"
      ],
      "same_system": "yes"
    },
    {
      "text": "The combined precipitate and grain-refinement intervention should increase both hardness and yield strength by about 20–50% or more.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_card::000::1894dec07a",
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "yes"
    },
    {
      "text": "High strength can be retained together with appreciable ductility when coherent precipitation is engineered.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3"
      ],
      "same_system": "yes"
    },
    {
      "text": "The strengthening benefit requires the precipitate size and volume fraction to remain within an optimal range.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Excessive secondary-phase formation, loss of coherency, or loss of precipitate stability can negate strengthening or promote brittleness.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed behavior applies under ambient to moderately elevated temperatures and quasi-static loading.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_card::000::2d68b747c3",
        "PMC10759803::rubric_card::000::1894dec07a",
        "PMC5978046::rubric_card::000::c87a8ff254"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed behavior requires precipitate coherency and sub-micron to low-micron grain sizes.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Failure to obtain a statistically significant hardness and yield-strength increase, or observation of an overall performance decrease caused by the precipitates, would falsify the hypothesis.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
