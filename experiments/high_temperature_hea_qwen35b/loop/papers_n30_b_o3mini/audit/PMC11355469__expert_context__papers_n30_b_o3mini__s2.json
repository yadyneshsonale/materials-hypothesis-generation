  "claims": [
    {
      "text": "At 800–900 °C, the overall wear resistance of thin-film FeNiCrCoCu is governed by an in-situ tribo-oxidation layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The protective oxide layer is rich in chromium- and nickel-based oxides or a mixed spinel phase.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale is continuous and adherent.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The oxide scale protects against mechanical abrasion and further oxidation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited FeNiCrCoCu coating has a homogeneous BCC/FCC solid-solution microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-deposited coating contains no preformed protective oxide layer.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Elevated-temperature sliding in an oxidizing environment triggers tribo-oxidation of the coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Chromium and nickel preferentially participate in tribo-oxidation because of their high oxygen affinity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A hard, adherent oxide layer reduces metal-to-metal contact and consequently lowers abrasive and adhesive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At room temperature, minimal protective oxide forms and wear proceeds mainly through direct material removal.",
      "field": "mechanism; baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear depth at 800–900 °C will be lower than at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "The coefficient of friction at 800–900 °C will be lower than at room temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
      "text": "Post-test XRD and SEM/EDS will detect oxide phases and an oxide scale in the high-temperature wear track.",
      "field": "predicted_outcome; falsification_experiment",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The cited AlCoCrFeNiTi0.5 study found a distinct reduction in wear depth at 800 °C and its highest wear resistance at 900 °C.",
      "field": "supporting_evidence_ids",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "no"
    },
    {
