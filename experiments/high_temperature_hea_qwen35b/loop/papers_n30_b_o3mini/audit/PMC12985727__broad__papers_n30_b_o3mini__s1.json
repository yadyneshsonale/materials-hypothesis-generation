      "support": "partial",
      "supporting_ids": [
        "PMC11375216::rubric_card::000::73c21da9f2"
      ],
      "same_system": "yes"
    },
    {
      "text": "SRO creates more coherent bonding pathways that enhance lattice thermal transport.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
