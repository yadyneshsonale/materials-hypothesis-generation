        "PMC11375216::rubric_card::000::73c21da9f2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The conductivity benefit should persist under moderate mechanical loads typical of plasma-facing intermediate layers.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
