      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The anticipated decrease in saturation magnetization is caused by inclusion of a non-magnetic or weakly magnetic oxide phase.",
