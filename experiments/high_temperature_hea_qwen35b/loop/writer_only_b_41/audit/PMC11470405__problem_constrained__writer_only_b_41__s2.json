      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 600–1200°C, HfNbTaTiZr will have higher ultimate tensile strength than Nb or NbTa tested under identical conditions.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 600–1200°C, HfNbTaTiZr will have a lower thermal-expansion coefficient than Nb or NbTa tested under identical conditions.",
