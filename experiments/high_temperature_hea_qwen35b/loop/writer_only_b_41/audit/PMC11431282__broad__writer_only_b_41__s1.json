  "claims": [
    {
      "text": "The proposed intervention is partial substitution of Si with Ge in MnNiSi1-xGex at x approximately 0.1–0.2.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge substitution at x approximately 0.1–0.2 will improve ductility and fracture toughness relative to MnNiSi.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge-substituted material will retain a large magnetocaloric effect.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge substitution reduces lattice mismatch and internal strain.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced lattice mismatch and internal strain improve grain-boundary cohesion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Improved grain-boundary cohesion and reduced internal strain improve mechanical properties.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge substitution at the proposed level maintains the first-order magnetostructural transition.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge atoms are larger than Si atoms.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The larger size of Ge relieves lattice strain and reduces brittleness in MnNiSi.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Ge and Si have sufficiently similar electronic structures that Ge substitution preserves the relevant magnetic exchange interactions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Preservation of the magnetic exchange interactions preserves the magnetocaloric effect.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Relative to MnNiSi, MnNiSi1-xGex will exhibit higher fracture toughness and ductility.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Peak magnetic entropy change in MnNiSi1-xGex will decrease by no more than 10% relative to MnNiSi.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Polycrystalline MnNiSi has a large magnetocaloric effect but poor mechanical performance characterized by brittleness.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The predicted effects should hold in polycrystalline bulk samples from room temperature to near the magnetostructural transition temperature under ambient pressure.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At Ge contents above approximately x = 0.2, the magnetocaloric effect may decrease significantly.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed decrease in magnetocaloric effect above x approximately 0.2 would result from disruption of the magnetostructural transition.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The hypothesis is falsified if the substituted samples fail to achieve at least a 10% increase in fracture toughness or ductility, or if peak magnetic entropy change decreases by more than 10%.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
