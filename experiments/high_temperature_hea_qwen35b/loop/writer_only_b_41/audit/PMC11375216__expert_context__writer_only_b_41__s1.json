    {
      "text": "The new approach will predict total thermal conductivity from 300 to 1200 K within ±20% of experiment.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
