{
  "run_id": "PMC11355469__broad__text_systemmatch__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "Wear resistance will initially increase with rising ambient temperature up to a critical threshold and then degrade rapidly.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The dominant mechanism for improved elevated-temperature wear resistance is formation of a protective tribo-oxide layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The protective tribo-oxide layer is self-healing.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Between approximately 200°C and 600°C, diffusion of elements such as Al, Cr, and Ti is sufficient to form a continuous, adherent oxide scale.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale reduces the coefficient of friction.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale prevents direct asperity contact and thereby increases wear resistance.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "At sufficiently high temperature, the oxide layer becomes thick and brittle and undergoes spallation.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature matrix softening, loss of solid-solution strengthening, or phase instability can cause failure of the protective layer.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Performance degrades when oxide spallation becomes faster than oxide formation or when matrix yield strength falls below that required to support the contact load.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The degradation boundary typically lies above 600–700°C for many Al/Cr-containing HEAs.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory HEAs have poor oxidation resistance, which can cause degradation at lower temperatures.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7475834::chunk::001::introduction::97cd4ea6cb"
      ],
      "same_system": "yes"
    },
    {
      "text": "HEA microstructures can contain BCC phases, FCC matrices, and ordered precipitates depending on composition.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Increasing temperature promotes formation of continuous Al2O3 or Cr2O3 scales through faster diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The oxide scale acts as both a solid lubricant and a barrier.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Thermal-expansion mismatch and oxide brittleness cause spallation that exposes softer underlying metal to abrasive wear.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear rate will decrease by 30–50% between 25°C and approximately 500°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coefficient of friction will decrease slightly as temperature increases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Above approximately 600°C, wear rate will increase by more than 200% relative to peak performance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The exact critical temperature depends strongly on HEA composition, coating grain size, and porosity.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Substrate thermal conductivity can influence the local coating–substrate interface temperature.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
