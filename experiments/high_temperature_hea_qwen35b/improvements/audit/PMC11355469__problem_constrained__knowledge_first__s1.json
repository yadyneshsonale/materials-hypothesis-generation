  "claims": [
    {
      "text": "The FeNiCrCoCu coating has a face-centered cubic structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FeNiCrCoCu coating has low stacking-fault energy.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial coating contains a high density of pre-existing dislocations.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial coating contains stable stacking faults.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 300 K, the coating has high elastic modulus and stable wear resistance.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The dissociation width of Shockley partial dislocations is governed by stacking-fault energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below the critical temperature, low stacking-fault energy stabilizes wide stacking faults and promotes planar slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Planar slip produces work hardening that maintains wear resistance below the critical temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault energy increases with temperature in the relevant FCC alloy system, suppressing stacking-fault formation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing temperature thermally activates cross-slip and recombination of partial dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermally activated cross-slip changes deformation from planar slip to wavy slip.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The transition to wavy slip causes rapid dislocation multiplication.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid dislocation multiplication causes collapse of ordered short-range atomic structures and lattice disordering.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Lattice disordering reduces strain-hardening capacity and sharply lowers wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The mechanism changes at a critical temperature of approximately 450 K.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the critical temperature, wear rate increases exponentially.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Crossing the critical temperature produces a corresponding decrease in measured elastic modulus.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory high-entropy alloys generally have BCC structures and resistance to elevated-temperature softening.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cu matrix does not significantly diffuse into the coating during the test.",
      "field": "boundary",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Composition ratios, processing history, and coating–matrix interdiffusion could shift the estimated critical temperature or alter the mechanism.",
