  "claims": [
    {
      "text": "The FeNiCrCoCu coating has a single-phase FCC structure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FeNiCrCoCu coating has high elastic modulus and stable wear resistance at 300 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "In CoCrFeMnNi, stacking-fault energy increases with increasing temperature.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "yes"
    },
    {
      "text": "Increasing temperature raises the stacking-fault energy of the FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing stacking-fault energy suppresses stacking faults and nano-twins.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::chunk::000::abstract::b3f2cb8881"
      ],
      "same_system": "no"
    },
    {
      "text": "Stacking faults and nano-twins accommodate plastic deformation and provide strain hardening in the FeNiCrCoCu coating at room temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "Higher stacking-fault energy promotes cross-slip and planar slip by full dislocations in the FeNiCrCoCu coating.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The shift to full-dislocation slip causes rapid dislocation multiplication and pile-up.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Rapid dislocation multiplication and pile-up cause local lattice disorder and breakdown of lattice coherence.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of stacking-fault- or twinning-mediated hardening produces a sharp decrease in yield strength and wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "no"
    },
    {
      "text": "The critical temperature occurs when stacking-fault energy exceeds the barrier for twin nucleation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the critical temperature, frictional shear produces rapid lattice disorder and amorphization-like behavior.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear resistance remains stable up to a critical temperature of approximately 500–600 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above the critical temperature, wear rate increases by an order of magnitude.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation density exhibits a sudden subsurface spike at the critical temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Stacking-fault width and twin density decrease at the critical temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cu-matrix interface may alter local stresses and stacking-fault energy in the coating.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Refractory BCC HEAs can have exceptional resistance to elevated-temperature softening.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::chunk::001::introduction::0cf0f01e08"
      ],
      "same_system": "yes"
    },
    {
      "text": "HEAs containing ordered precipitates may avoid this sharp transition because they have different and more thermally stable strengthening mechanisms.",
      "field": "boundary",
      "needs_support": true,
