  "claims": [
    {
      "text": "The target material is a quaternary equiatomic alloy with an FCC structure.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "The initial alloy is a fully annealed, single-phase FCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy has moderate stacking-fault energy that permits mechanical instability.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At low strain rates, plasticity is governed by thermally activated dislocation glide.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cross-slip contributes to low-strain-rate plasticity.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dislocation-controlled yielding produces positive strain-rate sensitivity at low strain rates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-rate tensile loading induces stacking faults and transient nanotwins near the yield point.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "High-rate tensile loading nucleates a stress-induced FCC-to-HCP martensitic transformation near yield.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "The stacking faults, nanotwins, or martensitic nuclei impede dislocation motion or absorb strain energy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At high strain rates, the FCC-to-HCP transformation becomes a competing deformation mechanism.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "Transformation-mediated deformation is effectively insensitive to strain rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Activation of the transformation decouples yield strength from the usual logarithmic or power-law strain-rate dependence of dislocation glide.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yield strength will rise approximately linearly with logarithmic strain rate at low rates and plateau or saturate above about 10^2 s^-1.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HCP material will be detectable in the high-rate-deformed gauge region.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6093928::chunk::001::introduction::2dc33c3a9e"
      ],
      "same_system": "no"
    },
    {
      "text": "In the absence of phase transformation, standard dislocation-glide behavior gives a continuous monotonic increase in yield strength with strain rate without saturation.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed transition requires stacking-fault energy within a critical range that permits instability while avoiding suppression of twinning or transformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The test temperature must remain below the critical temperature for reverse transformation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The critical transformation strain rate depends strongly on elemental composition and the resulting stacking-fault energy.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
