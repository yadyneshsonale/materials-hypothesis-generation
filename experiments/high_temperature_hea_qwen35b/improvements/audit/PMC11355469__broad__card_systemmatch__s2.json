{
  "run_id": "PMC11355469__broad__card_systemmatch__s2",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "CoCrFeMnNi is an FCC-based high-entropy alloy system.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7512559::rubric_card::000::77895ab356"
      ],
      "same_system": "yes"
    },
    {
      "text": "The deposited HEA can have an initial dislocation density of approximately 10^14 m^-2.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::rubric_card::000::3519eb0b1c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The initial coating contains nanoscale oxide or carbide precipitates at cell or grain boundaries.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7512559::rubric_card::000::77895ab356"
      ],
      "same_system": "yes"
    },
    {
      "text": "Nanoscale precipitates strengthen the coating through Orowan looping.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A high dislocation density strengthens the coating through forest hardening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7229066::rubric_card::000::3519eb0b1c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The high lattice distortion inherent to HEAs impedes plastic deformation and abrasive wear.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 25 °C, the coating will have a wear rate below 10^-6 mm^3/Nm.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Wear resistance degrades gradually as temperature rises from ambient until a critical boundary is reached.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature thermally activates dislocation climb and cross-slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Thermally activated climb and cross-slip reduce the effectiveness of Orowan barriers and grain-boundary pinning.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature lowers the yield strength of the CoCrFeMnNi material.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7229066::rubric_card::000::3519eb0b1c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The temperature-induced reduction in yield strength increases the coating wear rate.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Dynamic recovery or thermally activated diffusion begins near 300–400 °C.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Heating changes the dominant wear mode from mild abrasive wear at 25 °C to severe adhesive or oxidative wear at 400 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The activation energy for dislocation climb in FCC HEAs is approximately 0.5–0.8 eV.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The significant performance-degradation boundary is 350 ± 50 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 300 °C, wear rate increases exponentially with temperature.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear rate at 400 °C will be approximately an order of magnitude higher than at 25 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional steel coatings or uncoated transition-metal matrices show a linear or moderate increase in wear rate with temperature.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Conventional steel coatings and uncoated matrices lack the initial strength and precipitation hardening attributed to the HEA coating.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
