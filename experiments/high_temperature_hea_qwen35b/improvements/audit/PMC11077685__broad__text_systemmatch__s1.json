  "claims": [
    {
      "text": "The target alloy has the equiatomic composition W20Mo20Ta20Nb20V20.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "W20Mo20Ta20Nb20V20 is a Group IV-V refractory high-entropy alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "W20Mo20Ta20Nb20V20 can be fabricated by LPBF through in-situ alloy formation from mixed elemental powders.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8201384::chunk::000::abstract::c39421387b"
      ],
      "same_system": "yes"
    },
    {
      "text": "The as-fabricated LPBF alloy has a dendritic or cellular BCC microstructure.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Typical C, N, and O impurity levels in the starting material are below 0.1 wt%.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An LPBF linear energy density of approximately 2.8 J/mm produces greater than 99.5% relative density.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Homogenization at 1200-1300°C for 24 hours eliminates segregation in the LPBF alloy.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Homogenization reduces clustering or segregation of embrittling interstitial elements in BCC refractory alloys.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 600-800°C nucleates stepwise controllable coherent nanoprecipitates in W20Mo20Ta20Nb20V20.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Vacuum or high-purity argon post-processing prevents additional interstitial uptake.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The desired microstructure consists of coherent SCCPs dispersed within a continuous BCC matrix rather than a continuous ordered B2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2",
        "PMC5995863::chunk::000::abstract::63aa5c975c"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent SCCP interfaces facilitate dislocation transmission.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent SCCP interfaces relieve stress concentrations that can otherwise cause premature crack initiation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Coherent precipitates minimize lattice-mismatch strain energy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The nanoprecipitates provide pinning points that permit uniform plastic deformation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Interstitial C, N, and O and high BCC lattice friction are inherent sources of brittleness in the proposed alloy.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed alloy will have ambient-temperature ultimate tensile strength above 2.0 GPa and tensile ductility above approximately 10-15%.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The processed alloy will retain yield strength above 1.0 GPa and tensile ductility above 5% at 800°C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::000::abstract::2906c9eda2"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The resulting coherent nanoprecipitates will be uniformly distributed and 5-20 nm in size.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A continuous ordered B2 matrix in B2+BCC refractory high-entropy alloys is associated with poor room-temperature ductility, whereas discrete B2 precipitates in a continuous BCC matrix improve ductility while retaining strength.",
      "field": "baseline",
      "needs_support": true,
