      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Standard solid-state sintering at 900–950 °C typically produces relative density below 92%, significant Mg loss, and coarse discontinuous intermetallic networks that initiate corrosion.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Below 820 °C, porosity exceeds 5% because insufficient liquid forms.",
