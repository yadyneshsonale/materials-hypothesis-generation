      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_card::000::16e383e6c2"
      ],
      "same_system": "yes"
    },
    {
      "text": "The processed alloy will have a density of approximately 7.5–8.0 g/cm³.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation mass gain will remain below 0.2 mg/cm² after 100 hours at 900 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC9026100::rubric_card::000::8d31f456a8"
      ],
      "same_system": "no"
    },
