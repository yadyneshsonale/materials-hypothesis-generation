  "claims": [
    {
      "text": "Near-equiatomic AlCoCrFeNiTi is a lightweight multi-principal-element alloy system suitable for the proposed optimization.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "yes"
    },
    {
      "text": "Mechanical alloying of this alloy will produce a defect-rich, lattice-distorted nanocrystalline solid solution.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39",
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "no"
    },
    {
      "text": "SPS near 1250 °C will densify AlCoCrFeNiTi while preserving a nanoscale B2 plus BCC microstructure and avoiding significant Laves precipitation or coarsening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278",
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "yes"
    },
    {
      "text": "The 1200–1300 °C SPS interval lies below the temperature at which Laves phases dominate or BCC grains coarsen significantly.",
      "field": "conditions",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "High configurational entropy stabilizes the solid solution in the proposed AlCoCrFeNiTi alloy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Atomic-size mismatch between Al and Ti and the transition metals causes severe lattice distortion.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::chunk::001::introduction::a325666ec3"
      ],
      "same_system": "no"
    },
    {
      "text": "Lower-temperature annealing provides a thermodynamic driving force for separation into ordered B2 and disordered BCC phases.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6197204::chunk::000::abstract::a6951d7e3c"
      ],
      "same_system": "no"
    },
    {
      "text": "Defects and lattice distortion introduced by mechanical alloying impede dislocation motion and strengthen the alloy.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ordered B2 phase supplies high hardness while the disordered BCC matrix supplies ductility.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The Cr and Al content will rapidly form a compact, self-healing Cr2O3/Al2O3 layer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e",
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The Cr/Al-rich oxide layer will suppress bulk high-temperature oxidation and aqueous corrosion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6908586::chunk::001::introduction::7b08936e5e",
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "A fine microstructure prevents dissolution of less noble elements in corrosive environments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed AlCoCrFeNiTi alloy will have Vickers hardness above 600 Hv.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "no"
    },
    {
      "text": "The processed alloy will have a density below 9.0 g/cm3.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The processed alloy will have compressive strength above 1500 MPa.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::chunk::000::abstract::934a070a39"
      ],
      "same_system": "no"
    },
    {
      "text": "The alloy will show negligible oxidation mass loss during exposure at 800–1000 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::chunk::000::abstract::cd6baea278"
      ],
      "same_system": "yes"
    },
    {
      "text": "The alloy will exhibit high aqueous corrosion resistance in H2SO4.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "Sintering at 1400 °C causes significant BCC grain coarsening.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7866258::chunk::000::abstract::81dff592dd"
      ],
      "same_system": "no"
    },
    {
      "text": "Laves phases form or dominate at 1400 °C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Mn-rich oxidation products are non-protective and detrimental when Cr/Al is insufficient.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
