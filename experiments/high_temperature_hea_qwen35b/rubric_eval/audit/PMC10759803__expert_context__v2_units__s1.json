      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A reticulated Laves-phase network impedes crack extension by forcing crack deflection and branching.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr-induced lattice distortion impedes dislocation motion and produces solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr-induced lattice contraction increases the Peierls stress for dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
