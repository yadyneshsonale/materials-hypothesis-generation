      ],
      "same_system": "no"
    },
    {
      "text": "The proposed intervention is HPHT treatment in a hexahedron-anvil apparatus at approximately 6 GPa and 1473 K for 2 hours.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Treatment at 6 GPa and 1473 K for 2 hours will topologically transform the lamellae into a hierarchical pattern.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The HPHT treatment will replace incoherent FCC/B2 boundaries with coherent FCC/B2 interfaces.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
