      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "no"
    },
    {
      "text": "The transformed structure will activate stacking-fault formation and twinning in addition to dislocation transfer.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
