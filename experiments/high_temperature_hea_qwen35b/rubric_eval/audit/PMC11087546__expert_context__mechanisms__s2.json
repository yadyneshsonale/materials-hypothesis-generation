      "support": "partial",
      "supporting_ids": [
        "PMC10213035::rubric_mechanisms::000::0acd88f470"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocation transfer across coherent interfaces will alleviate interfacial stress concentrations and suppress premature cracking.",
