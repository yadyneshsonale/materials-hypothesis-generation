      "support": "partial",
      "supporting_ids": [
        "PMC5461481::rubric_mechanisms::001::8100474dc6"
      ],
      "same_system": "no"
    },
    {
      "text": "Rapid SPS will kinetically suppress HCP formation in CoCrFeNiTi.",
