  "claims": [
    {
      "text": "The proposed workflow replaces the EAM reference potential with an MTP and replaces thermodynamic integration with free energy perturbation.",
      "field": "intervention",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial TaVCrW alloy is a random solid solution with possible short-range order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range order stabilizes the TaVCrW solid by approximately 2-3 meV/atom.",
      "field": "material_initial_state; mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The TaVCrW MTP is trained on DFT data for elemental and binary/quaternary subsystems.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High-temperature magnetic fluctuations are neglected in the baseline calculation.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An accurate MTP can reproduce the ab initio phase-space distribution of solid and liquid TaVCrW.",
      "field": "hypothesis; structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_effects::006::d446f6eae4"
      ],
      "same_system": "no"
    },
    {
      "text": "The relevant phase-space reproduction includes Warren-Cowley SRO parameters and local atomic environments.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_effects::006::d446f6eae4",
        "PMC8357793::rubric_effects::012::f620f2652f",
        "PMC11375216::rubric_effects::009::5d4dbdec92"
      ],
      "same_system": "no"
    },
    {
      "text": "EAM potentials may miss or misrepresent relevant local environments and SRO in complex refractory liquids.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "For MoNbTaW, the MTP formalism provides a favorable balance between accuracy and computational cost.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_effects::006::d446f6eae4"
      ],
      "same_system": "yes"
    },
    {
      "text": "MTP accuracy enables efficient phase-space sampling suitable for FEP.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_effects::006::d446f6eae4"
      ],
      "same_system": "no"
    },
    {
      "text": "FEP can use the MTP-sampled potential-energy distribution to calculate solid-liquid free-energy differences without an expensive thermodynamic-integration path.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "SRO changes local energy landscapes and mechanical behavior in MoNbTaW.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_effects::012::f620f2652f",
        "PMC8357793::rubric_effects::014::3a07cc00a7"
      ],
      "same_system": "yes"
    },
    {
      "text": "The MTP+FEP workflow will reduce computational cost by more than 80% relative to TOR-TILD.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The MTP+FEP result will agree with TOR-TILD within 0.5 meV/atom.",
      "field": "hypothesis; predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed workflow will correctly identify the SRO contribution to solid-phase stability.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
