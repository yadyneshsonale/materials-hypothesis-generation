      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::rubric_mechanisms::002::027b53a6a6"
      ],
      "same_system": "yes"
    },
    {
      "text": "In CoCrFeMnNi, increasing stacking fault energy with temperature suppresses stacking faults and nano-twins.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC6093928::rubric_mechanisms::002::027b53a6a6"
      ],
      "same_system": "yes"
    },
    {
      "text": "CoNiCrFeMn HEA nanowires shift from deformation twinning to dislocation slip at elevated temperature.",
