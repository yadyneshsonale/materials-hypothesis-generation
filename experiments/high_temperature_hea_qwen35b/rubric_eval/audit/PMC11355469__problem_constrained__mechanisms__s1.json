        "PMC8398136::rubric_mechanisms::006::15b975642e"
      ],
      "same_system": "no"
    },
    {
      "text": "Twinning is an energy-dissipating deformation mechanism in this coating.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Loss of the stacking-fault barrier causes rapid dislocation multiplication.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
