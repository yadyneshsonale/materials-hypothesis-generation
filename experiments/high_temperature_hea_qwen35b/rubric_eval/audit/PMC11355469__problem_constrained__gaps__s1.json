{
  "run_id": "PMC11355469__problem_constrained__gaps__s1",
  "auditor": "trapi:gpt-5.6-sol_2026-07-09",
  "claims": [
    {
      "text": "The elevated-temperature wear transition in FeNiCrCoCu coatings is driven by thermally activated dissolution of short-range order.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::008::dde7a81931"
      ],
      "same_system": "no"
    },
    {
      "text": "Screw-dislocation friction decays rapidly with increasing temperature.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::012::288585008c"
      ],
      "same_system": "no"
    },
    {
      "text": "Above approximately 500 K, deformation shifts from TWIP or SRO-strengthened plasticity to TRIP or rapid lattice disorder.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::rubric_gaps::006::27576a7ed5"
      ],
      "same_system": "no"
    },
    {
      "text": "The FeNiCrCoCu coating is elastically isotropic and has a high elastic modulus at 300 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FeNiCrCoCu coating has stable wear resistance at 300 K.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "At 300 K, the coating contains a high density of screw dislocations and significant SRO strengthening.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Increasing temperature causes a rapid decay specifically in screw-dislocation density.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::rubric_gaps::006::27576a7ed5",
        "PMC8357793::rubric_gaps::012::288585008c"
      ],
      "same_system": "no"
    },
    {
      "text": "Increasing temperature removes SRO strengthening barriers.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::008::dde7a81931"
      ],
      "same_system": "no"
    },
    {
      "text": "At room temperature, high lattice friction and SRO pinning stabilize screw dislocations and thereby provide high strength and wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::008::dde7a81931",
        "PMC8357793::rubric_gaps::012::288585008c"
      ],
      "same_system": "no"
    },
    {
      "text": "At high temperature, the entropy contribution to the free-energy barrier significantly diminishes SRO strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::008::dde7a81931"
      ],
      "same_system": "no"
    },
    {
      "text": "The critical stress for screw-dislocation motion decreases more rapidly with temperature than the critical stress for edge-dislocation motion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8357793::rubric_gaps::012::288585008c"
      ],
      "same_system": "no"
    },
    {
      "text": "A temperature-induced decrease in dislocation density shifts deformation from TWIP to TRIP.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8398136::rubric_gaps::006::27576a7ed5"
      ],
      "same_system": "no"
    },
    {
      "text": "The reduction in dislocation density and the TWIP-to-TRIP shift cause loss of load-bearing capacity and a sharp decline in wear resistance.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_gaps::003::aa437305ac"
      ],
      "same_system": "no"
    },
    {
      "text": "Wear resistance and elastic modulus decline sharply once temperature exceeds approximately 500 K.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The wear decline coincides with a measurable decrease in dislocation density and a transition from TWIP to TRIP or disordered slip.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8398136::rubric_gaps::006::27576a7ed5"
      ],
      "same_system": "no"
    },
    {
      "text": "The high-temperature transition produces unstable friction coefficients and accelerated material removal.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC7515071::rubric_gaps::003::aa437305ac",
        "PMC7515071::rubric_gaps::004::230729ac14"
      ],
      "same_system": "no"
    },
    {
      "text": "Protective oxide layers can mitigate high-temperature wear, while interrupted oxide layers can make the coefficient of friction highly variable.",
      "field": "boundary",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC7515071::rubric_gaps::004::230729ac14"
      ],
      "same_system": "no"
    },
    {
      "text": "The critical temperature and Cu-matrix interface kinetics are not established directly for the FeNiCrCoCu coating system.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
  ],
