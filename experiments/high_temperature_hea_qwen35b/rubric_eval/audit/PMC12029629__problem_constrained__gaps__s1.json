  "claims": [
    {
      "text": "The initial single-crystal FeNiCrMn alloy has an FCC lattice.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The FeNiCrMn alloy contains significant atomic-scale chemical disorder and short-range order.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial FeNiCrMn material has not undergone an FCC-to-BCC transformation.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Short-range order and chemical disorder produce elevated local lattice friction or a Peierls barrier in FeNiCrMn.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
