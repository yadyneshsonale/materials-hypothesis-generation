      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "no"
    },
    {
      "text": "The transformed structure produces a more homogeneous strain distribution between the FCC and B2 phases.",
