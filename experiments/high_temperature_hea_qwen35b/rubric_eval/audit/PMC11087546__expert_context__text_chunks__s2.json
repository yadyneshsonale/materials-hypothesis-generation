      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed HPHT treatment will replace the incoherent FCC/B2 boundaries with coherent interfaces.",
