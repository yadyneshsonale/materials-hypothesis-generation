      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "no"
    },
    {
      "text": "Dislocation transfer across coherent interfaces alleviates local stress concentrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10213035::chunk::003::discussion::98e65aafcb"
      ],
      "same_system": "no"
    },
    {
      "text": "The transformed structure activates dislocation slip, stacking faults, and twinning.",
