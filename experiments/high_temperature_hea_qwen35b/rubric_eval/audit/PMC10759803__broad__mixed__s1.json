        "PMC5995863::rubric_mechanisms::003::4992b97321"
      ],
      "same_system": "no"
    },
    {
      "text": "Using Hf, Ti, and Zr will lower density relative to W/V-based RHEAs because these elements have lower atomic mass than W and V.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
