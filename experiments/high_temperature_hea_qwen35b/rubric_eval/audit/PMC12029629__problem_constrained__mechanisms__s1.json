      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Traditional FCC Ni and Cu are ordinarily strain-rate sensitive because phonon drag or athermal forest hardening dominates.",
