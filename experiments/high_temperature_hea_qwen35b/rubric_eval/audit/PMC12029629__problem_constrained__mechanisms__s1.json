      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_mechanisms::003::c51e52b4f9"
      ],
      "same_system": "no"
    },
    {
      "text": "Yield strength should remain nearly constant from quasi-static through high strain rates.",
