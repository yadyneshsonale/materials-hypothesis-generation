      "supporting_ids": [
        "PMC8357793::rubric_mechanisms::003::c51e52b4f9"
      ],
      "same_system": "no"
    },
    {
      "text": "Kink-pair migration contributes to screw-dislocation motion in the low-to-middle temperature and stress regime.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_mechanisms::003::c51e52b4f9"
      ],
      "same_system": "no"
    },
    {
      "text": "The lattice-distortion-induced kink-formation barrier dominates over phonon drag below very high strain rates.",
