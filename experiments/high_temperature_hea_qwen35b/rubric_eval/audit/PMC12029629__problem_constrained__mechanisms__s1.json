      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8357793::rubric_mechanisms::003::c51e52b4f9"
      ],
      "same_system": "no"
    },
    {
      "text": "The proposed kink-pair mechanism makes yield strength largely insensitive to strain rate.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Yield strength should decrease strongly as temperature increases.",
