      ],
      "same_system": "no"
    },
    {
      "text": "The interfacial distortion and strain restrict rotation of magnetic moments.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The coherent interface enhances spin-orbit coupling and restores the suppressed orbital magnetic moment.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
