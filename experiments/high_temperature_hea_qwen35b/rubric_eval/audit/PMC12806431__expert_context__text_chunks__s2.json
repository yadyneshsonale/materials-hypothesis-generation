  "claims": [
    {
      "text": "The as-cast AlCoCrFeNi2.1 alloy is ductile.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast AlCoCrFeNi2.1 alloy contains an FCC matrix and a B2 phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy has no significant L12 ordering.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The as-cast alloy has smooth phase boundaries.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging AlCoCrFeNi2.1 at about 600°C induces L12-ordered domains or precipitates in the FCC matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Aging at about 600°C produces jagged or serrated B2/FCC phase boundaries.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The L12 domains formed at 600°C approach a stoichiometric Ni3Al composition.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Greater L12 chemical ordering increases the antiphase-boundary energy of the ordered precipitates.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC5627260::chunk::000::abstract::23a6b4d060"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High antiphase-boundary energy suppresses dislocation cross-slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Suppressed cross-slip forces dislocations into planar slip.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Jagged B2/FCC interfaces act as geometric stress concentrators at boundary serrations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The combination of planar slip and stress concentration at jagged boundaries causes localized stress accumulation and brittle fracture at 600°C aging conditions.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 600°C causes a significant reduction in elongation.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 750°C reduces the degree of L12 chemical ordering relative to aging at 600°C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Aging at 750°C forms ductile transition zones along the phase boundaries.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Reduced ordering and boundary transition zones mitigate the APBE effect, permit cross-slip, and restore ductility at 750°C.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The brittle transition requires both L12 ordering near a stoichiometric Ni3Al ratio and phase boundaries that are sufficiently jagged to induce planar slip.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed critical combined ordering-and-jaggedness condition is met near 600°C but not near 750°C.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Superlattice streak intensity in selected-area diffraction patterns can be used to estimate antiphase-boundary energy.",
      "field": "falsification_experiment.measurements",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "A lack of correlation between L12 ordering and the planar-to-wavy slip transition would falsify the proposed ordering-mediated mechanism.",
      "field": "falsification_experiment.falsification_rule",
      "needs_support": false,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
