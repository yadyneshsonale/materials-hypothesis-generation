      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The local chemical environment of L12-(Ni,Fe)3Ti breaks the symmetry responsible for orbital-moment suppression in the fcc matrix.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
