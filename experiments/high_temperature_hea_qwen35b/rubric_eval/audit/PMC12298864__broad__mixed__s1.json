  "claims": [
    {
      "text": "Adding 4.2 at% Cr to cast HfMoTaTiZr forms a (Cr,Mo)2(Hf,Ti,Zr) Laves phase.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43",
        "PMC10759803::rubric_effects::011::08692f2988"
      ],
      "same_system": "yes"
    },
    {
      "text": "The cast HfMoTaTiZr-Cr baseline has grains approximately 200–400 μm or larger.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cast HfMoTaTiZr-Cr has limited ductility.",
      "field": "baseline",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Cr addition substantially increases the hardness of cast HfMoTaTiZr.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::011::08692f2988",
        "PMC10759803::rubric_mechanisms::001::c5ecc883c0"
      ],
      "same_system": "yes"
    },
    {
      "text": "Dissolved Cr strengthens the BCC phase through atomic-size mismatch, lattice distortion, and associated dislocations.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_mechanisms::000::0942e87b64"
      ],
      "same_system": "yes"
    },
    {
      "text": "HPHT treatment at 6 GPa and 1473 K for 2 hours can create a coherent-interface microstructure.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::rubric_effects::000::ee17613f08",
        "PMC11087546::rubric_mechanisms::006::575393bd5a"
      ],
      "same_system": "no"
    },
    {
      "text": "HPHT treatment at the proposed conditions will refine HfMoTaTiZr-Cr to a grain size below 50 nm.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "HPHT-treated HfMoTaTiZr-Cr will have a dual-phase BCC matrix plus coherent nanoscale secondary phase.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "High pressure suppresses nucleation of coarse (Cr,Mo)2(Hf,Ti,Zr) Laves intermetallics in HfMoTaTiZr-Cr.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Coherent interfaces relieve stress concentrations and support a strength–ductility synergy.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::rubric_effects::000::ee17613f08",
        "PMC11087546::rubric_mechanisms::006::575393bd5a"
      ],
      "same_system": "no"
    },
    {
      "text": "Reticulated Laves-phase networks in cast HfMoTaTiZr-Cr are brittle networks that facilitate ductility loss.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Nanoscale secondary particles provide dispersion strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_mechanisms::001::c5ecc883c0"
      ],
      "same_system": "yes"
    },
    {
      "text": "The proposed HPHT microstructure will have higher hardness and yield strength than the cast baseline.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10759803::rubric_effects::011::08692f2988",
        "PMC11087546::rubric_effects::000::ee17613f08"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The proposed HPHT microstructure will maintain or improve ductility relative to cast material containing coarse Laves phases.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11087546::rubric_effects::000::ee17613f08"
      ],
      "same_system": "no"
    },
    {
      "text": "Pressure above 5 GPa is required, and pressures below approximately 4 GPa are insufficient to suppress Laves-phase formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Temperatures above an unspecified coherent-interface stability limit cause phase separation into coarse brittle intermetallics.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen contents above approximately 0.8 wt% cause HfO2-associated hardening and embrittlement.",
      "field": "boundary",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC6926650::rubric_mechanisms::001::511eefbe2c"
      ],
      "same_system": "no"
    },
    {
      "text": "Cr readily forms Laves phases with constituents of HfMoTaTiZr under conventional cast processing.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_effects::009::8ddbbedd43",
        "PMC10759803::rubric_effects::011::08692f2988"
      ],
      "same_system": "yes"
    },
    {
      "text": "A reticulated Laves morphology hinders crack propagation in as-cast HfMoTaTiZr-Cr.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC10759803::rubric_mechanisms::002::4472eb0f59"
      ],
      "same_system": "yes"
    },
    {
      "text": "Holding the alloy at 1473 K for 2 hours may destabilize the intended nanocrystalline grain structure through grain growth.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    }
