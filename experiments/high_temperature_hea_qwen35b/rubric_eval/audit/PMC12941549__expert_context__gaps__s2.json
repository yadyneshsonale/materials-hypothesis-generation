  "claims": [
    {
      "text": "The ball-milled Mg-Al-Ti-V-Fe-Co powder is a metastable BCC solid solution.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The ball-milled powder has a high defect density.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The powder may have surface-oxide contamination.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_gaps::001::9bcf662201"
      ],
      "same_system": "no"
    },
    {
      "text": "Sintering at 900–950 °C optimizes the trade-off between diffusion and Mg volatility.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::rubric_gaps::002::d558b4ce74",
        "PMC7475834::rubric_gaps::006::c1f2b6baf4"
      ],
      "same_system": "no"
    },
    {
      "text": "Sintering at 900–950 °C precipitates a Ti/V-enriched secondary BCC2 phase.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_gaps::005::d4b1142336"
      ],
      "same_system": "no"
    },
    {
      "text": "The BCC2 phase forms a continuous, percolating network at grain boundaries.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Above 800 °C, atomic diffusion becomes sufficient to overcome the kinetic barrier to phase separation.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::rubric_gaps::002::d558b4ce74",
        "PMC7475834::rubric_gaps::006::c1f2b6baf4"
      ],
      "same_system": "no"
    },
    {
      "text": "Below approximately 1000 °C, Mg diffusion is suppressed relative to Ti, V, Fe, and Co.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The BCC2 network slows both outward Mg diffusion and inward oxygen diffusion.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Restricted Mg and oxygen diffusion promotes a stable, protective TiO2-rich passive film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "MgO or Mn-depleted oxides would be non-protective alternatives to the proposed TiO2-rich film.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC10384371::rubric_gaps::003::b31adae04d"
      ],
      "same_system": "no"
    },
    {
      "text": "Intermediate-temperature sintering densifies the alloy through grain-boundary sliding and pore elimination.",
      "field": "mechanism",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::rubric_gaps::002::d558b4ce74"
      ],
      "same_system": "no"
    },
    {
      "text": "Keeping the sintering temperature below the Mg-volatility threshold preserves the alloy composition.",
      "field": "mechanism",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The optimized process will produce a bulk alloy with greater than 98% theoretical density.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The BCC2 network will significantly increase hardness.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxidation resistance will peak near 950 °C relative to samples sintered at 800 °C and 1050 °C.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The proposed BCC2-mediated structure will improve corrosion resistance.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Sintering below 800 °C produces high porosity because diffusion is insufficient.",
      "field": "baseline",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC12298864::rubric_gaps::002::d558b4ce74"
      ],
      "same_system": "no"
    },
    {
      "text": "Sintering above approximately 1000 °C causes Mg loss, composition deviation, and non-protective oxide formation.",
      "field": "boundary",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Oxygen contamination during milling may alter the nucleation kinetics of the secondary phase.",
      "field": "uncertainty",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC11077685::rubric_gaps::001::9bcf662201"
      ],
      "same_system": "no"
    }
