  "claims": [
    {
      "text": "The targeted material family is face-centered-cubic high-entropy alloys derived from the Fe-Co-Ni system.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The specific property targeted for improvement is high-temperature strength.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::42d146c611fa5cfc"
      ],
      "same_system": "unclear"
    },
    {
      "text": "High-temperature strength is to be improved through precipitation hardening.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::42d146c611fa5cfc",
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "The primary scientific challenge is understanding how orbital-moment or spin-orbit-coupling contributions affect order-disorder transition kinetics and precipitate stability.",
      "field": "hypothesis",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The initial material is an Fe-Co-Ni-based fcc HEA containing a disordered solid-solution matrix.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "Al or Ti may be added as lightweight elements to enable precipitation hardening.",
      "field": "material_initial_state",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "High-throughput screening, multiscale modeling, and experimental validation can accelerate discovery of precipitation-strengthened HEAs.",
      "field": "intervention",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::42d146c611fa5cfc"
      ],
      "same_system": "unclear"
    },
    {
      "text": "The screening is intended to identify compositions containing ordered L12 or B2 precipitates within an fcc matrix.",
      "field": "intervention",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "High-pressure, high-temperature treatment stabilizes the ordered precipitates.",
      "field": "intervention",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "An HPHT condition of 6 GPa and 1473 K is a relevant processing condition for an Al-containing Co-Cr-Fe-Ni HEA.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC11087546::hypothesis_evidence_v2::63b6e9b7a0873c3b"
      ],
      "same_system": "no"
    },
    {
      "text": "Arc melting and repeated remelting can be used to fabricate chemically homogeneous screened HEA ingots.",
      "field": "conditions",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::a6156199653d9a9a"
      ],
      "same_system": "unclear"
    },
    {
      "text": "Laser cladding is an applicable processing route for the proposed Fe-Co-Ni-based fcc HEAs.",
      "field": "conditions",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The structural mediator consists of ordered L12 or B2 precipitates in the fcc matrix.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "Lattice distortion and mixing entropy are associated structural or thermodynamic mediators of precipitate formation and strengthening.",
      "field": "structural_mediator",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "Severe local lattice distortion impedes dislocation motion and produces solid-solution strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "Ordered precipitates provide precipitation strengthening.",
      "field": "mechanism",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::42d146c611fa5cfc",
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
    },
    {
      "text": "Accounting for orbital moments in theoretical models will optimize precipitate stability and produce a higher number density of stable precipitates.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "unsupported",
      "supporting_ids": [],
      "same_system": "na"
    },
    {
      "text": "The resulting fcc Fe-Co-Ni-based HEA will have greater high-temperature strength than conventional ferritic superalloys.",
      "field": "predicted_outcome",
      "needs_support": true,
      "support": "partial",
      "supporting_ids": [
