      ],
      "same_system": "unclear"
    },
    {
      "text": "Currently developed ferritic superalloys have insufficient high-temperature strength and can be degraded by brittle C14 Laves phases.",
      "field": "baseline",
      "needs_support": true,
      "support": "entailed",
      "supporting_ids": [
        "PMC8282813::hypothesis_evidence_v2::42d146c611fa5cfc",
        "PMC8282813::hypothesis_evidence_v2::d32229df8f44afd7"
      ],
      "same_system": "no"
